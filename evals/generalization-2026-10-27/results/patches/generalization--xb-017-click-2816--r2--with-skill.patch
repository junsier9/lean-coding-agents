+@pytest.mark.parametrize("flag", ["--on", "--off", "-f", "-vv"])
+@pytest.mark.parametrize("option", ["-c", "--choice"])
+@pytest.mark.parametrize("nargs", [2, 3])
+def test_option_nargs_after_flag(flag, option, nargs):
+    cli = Command(
+        "cli",
+        params=[
+            Option(["--on/--off"]),
+            Option(["-f"], is_flag=True),
+            Option(["-v"], count=True),
+            Option(["-c", "--choice"], type=Choice(["a", "b"]), nargs=nargs),
+            Argument(["value"], type=Choice(["argument"])),
+        ],
+    )
+    args = [flag, option]
+
+    for _ in range(nargs):
+        assert _get_words(cli, args, "") == ["a", "b"]
+        assert _get_words(cli, args, "a") == ["a"]
+        args.append("a")
+
+    assert _get_words(cli, args, "") == ["argument"]
+    args.append(flag)
+    assert _get_words(cli, args, "") == ["argument"]
+
