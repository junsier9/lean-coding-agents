diff --git a/tests/test_arrays.py b/tests/test_arrays.py
index dea72cf..3616acf 100644
--- a/tests/test_arrays.py
+++ b/tests/test_arrays.py
@@ -817,6 +817,39 @@ def test_uniq(case, expected):
     assert _.uniq(case) == expected
 
 
+@parametrize("as_iterator", [False, True])
+@parametrize(
+    "case,expected_indexes",
+    [
+        ([{1}, {1}, {2}, {2}], [0, 2]),
+        ([{1}, frozenset({1}), frozenset({2}), {2}, {3}, frozenset({3})], [0, 2, 4]),
+        ([frozenset({1}), {1}, {2}, frozenset({2}), frozenset({3}), {3}], [0, 2, 4]),
+        ([set(), frozenset(), {1}, frozenset({1})], [0, 2]),
+        ([frozenset(), set(), frozenset({1}), {1}], [0, 2]),
+        ([b"a", bytearray(b"a"), bytearray(b"b"), b"b"], [0, 2]),
+        ([bytearray(b"a"), b"a", b"b", bytearray(b"b")], [0, 2]),
+    ],
+)
+def test_uniq_preserves_first_object(case, expected_indexes, as_iterator):
+    actual = _.uniq(iter(case) if as_iterator else case)
+    expected = [case[index] for index in expected_indexes]
+
+    assert actual == expected
+    assert all(item is first for item, first in zip(actual, expected))
+
+
+def test_uniq_comparison_error_propagates():
+    class FailingEquality:
+        def __hash__(self):
+            return 0
+
+        def __eq__(self, other):
+            raise TypeError("comparison failed")
+
+    with pytest.raises(TypeError, match="comparison failed"):
+        _.uniq([FailingEquality(), FailingEquality()])
+
+
