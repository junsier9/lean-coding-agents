+@pytest.mark.parametrize("update_min_steps", [1, 2, 4])
+@pytest.mark.parametrize("length_known", [True, False])
+@pytest.mark.parametrize("items", [[], [0], [0, None, False, "last", 5]])
+def test_progressbar_item_show_func_during_iteration(
+    runner, monkeypatch, update_min_steps, length_known, items
+):
+    shown = []
+
+    def item_show_func(item):
+        shown.append((item, progress.pos))
+        return f"Custom {item}"
+
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: True)
+
+    with runner.isolation() as (stdout, _):
+        progress = click.progressbar(
+            items if length_known else iter(items),
+            item_show_func=item_show_func,
+            update_min_steps=update_min_steps,
+        )
+        with progress:
+            for index, item in enumerate(progress):
+                batch_start = index - index % update_min_steps
+                assert item is items[index]
+                assert progress.current_item is item
+                assert shown[-1] == (items[batch_start], batch_start)
+
+            assert progress.finished
+            assert progress.current_item is None
+            assert progress.pos == len(items) - len(items) % update_min_steps
+            assert progress._completed_intervals == len(items) % update_min_steps
+            assert shown[-1] == (None, progress.pos)
+
+        assert stdout.getvalue().endswith(b"\n")
+
+    assert all(pos % update_min_steps == 0 for _, pos in shown)
+
+
+def test_progressbar_item_show_func_with_next(runner, monkeypatch):
+    shown = []
+
+    def item_show_func(item):
+        shown.append(item)
+        return f"Custom {item}"
+
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: True)
+
+    with runner.isolation():
+        with click.progressbar([0, None, "last"], item_show_func=item_show_func) as progress:
+            for item in [0, None, "last"]:
+                assert next(progress) == item
+                assert shown[-1] == item
+
+            with pytest.raises(StopIteration):
+                next(progress)
+
+            assert progress.finished
+            assert progress.current_item is None
+            assert shown[-1] is None
 
 
