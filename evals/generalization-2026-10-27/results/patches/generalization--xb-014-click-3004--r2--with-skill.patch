+import enum
 import os
 import re
 
@@ -363,6 +364,91 @@ def test_show_default_default_map(runner):
     assert "[default: b]" in result.output
 
 
+@pytest.mark.parametrize("enum_type", [enum.Enum, enum.IntEnum, enum.Flag, enum.IntFlag])
+@pytest.mark.parametrize("case_sensitive", [True, False])
+@pytest.mark.parametrize("use_default_map", [False, True])
+def test_enum_choice_default_help(runner, enum_type, case_sensitive, use_default_map):
+    class Value(enum_type):
+        FOO = 1
+        BAR = 2
+
+    expected = Value.BAR if use_default_map else Value.FOO
+
+    @click.command()
+    @click.option(
+        "--value",
+        type=click.Choice(Value, case_sensitive=case_sensitive),
+        default=Value.FOO,
+        show_default=True,
+    )
+    def cmd(value):
+        assert value is expected
+        click.echo(value.name)
+
+    kwargs = {"default_map": {"value": Value.BAR}} if use_default_map else {}
+    result = runner.invoke(cmd, ["--help"], **kwargs)
+    assert result.exit_code == 0
+    names = "FOO|BAR" if case_sensitive else "foo|bar"
+    default_name = expected.name if case_sensitive else expected.name.lower()
+    assert f"--value [{names}]" in result.output
+    assert f"[default: {default_name}]" in result.output
+
+    result = runner.invoke(cmd, [], **kwargs)
+    assert result.exit_code == 0
+    assert result.output == f"{expected.name}\n"
+
+
+@pytest.mark.parametrize("enum_type", [enum.Enum, enum.IntEnum, enum.Flag, enum.IntFlag])
+@pytest.mark.parametrize(
+    ("multiple", "nargs", "container"),
+    [(True, 1, list), (True, 1, tuple), (False, 2, list), (False, 2, tuple)],
+)
+def test_enum_choice_multiple_default_help(runner, enum_type, multiple, nargs, container):
+    class Value(enum_type):
+        FOO = 1
+        BAR = 2
+
+    @click.command()
+    @click.option(
+        "--values",
+        type=click.Choice(Value, case_sensitive=False),
+        default=container((Value.FOO, Value.BAR)),
+        show_default=True,
+        multiple=multiple,
+        nargs=nargs,
+    )
+    def cmd(values):
+        assert values[0] is Value.FOO
+        assert values[1] is Value.BAR
+
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    assert "[default: foo, bar]" in result.output
+
+    result = runner.invoke(cmd)
+    assert result.exit_code == 0
+
+
+@pytest.mark.parametrize("token_normalize_func", [None, str.lower])
+def test_string_enum_choice_default_help(runner, token_normalize_func):
+    class Value(str, enum.Enum):
+        FOO = ""
+        BAR = "bar-value"
+
+    @click.command(context_settings={"token_normalize_func": token_normalize_func})
+    @click.option("--value", type=click.Choice(Value), default=Value.FOO, show_default=True)
+    def cmd(value):
+        assert value is Value.FOO
+
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    expected = "foo" if token_normalize_func else "FOO"
+    assert f"[default: {expected}]" in result.output
+
+    result = runner.invoke(cmd)
+    assert result.exit_code == 0
+
+
 def test_multiple_default_type():
     opt = click.Option(["-a"], multiple=True, default=(1, 2))
     assert opt.nargs == 1
