+@pytest.mark.parametrize("enum_type", [enum.Enum, enum.IntEnum, enum.Flag, enum.IntFlag])
+@pytest.mark.parametrize("multiple", [False, True])
+@pytest.mark.parametrize("use_default_map", [False, True])
+def test_choice_enum_default_help(runner, enum_type, multiple, use_default_map):
+    class Selection(enum_type):
+        FIRST = 1
+        SECOND = 2
+
+    default = (Selection.FIRST, Selection.SECOND) if multiple else Selection.FIRST
+    expected = "FIRST, SECOND" if multiple else "FIRST"
+
+    @click.command()
+    @click.option(
+        "--selection",
+        type=click.Choice(Selection),
+        default=None if use_default_map else default,
+        multiple=multiple,
+        show_default=True,
+    )
+    def cmd(selection):
+        assert selection == default
+        if not multiple:
+            assert selection is Selection.FIRST
+
+    invoke_args = {"default_map": {"selection": default}} if use_default_map else {}
+    result = runner.invoke(cmd, ["--help"], **invoke_args)
+    assert result.exit_code == 0
+    assert "--selection [FIRST|SECOND]" in result.output
+    assert f"[default: {expected}]" in result.output
+
+    result = runner.invoke(cmd, [], **invoke_args)
+    assert result.exit_code == 0
+    args = ["--selection", "FIRST"]
+    if multiple:
+        args.extend(["--selection", "SECOND"])
+    result = runner.invoke(cmd, args, **invoke_args)
+    assert result.exit_code == 0
+
+    result = runner.invoke(cmd, ["--selection", "invalid"], **invoke_args)
+    assert result.exit_code == 2
+    assert "'invalid' is not one of 'FIRST', 'SECOND'." in result.output
+
+
+@pytest.mark.parametrize("multiple", [False, True])
+def test_choice_string_enum_default_help(runner, multiple):
+    class Selection(str, enum.Enum):
+        EMPTY = ""
+        VALUE = "value"
+
+    @click.command()
+    @click.option(
+        "--selection",
+        type=click.Choice(Selection),
+        default=[Selection.EMPTY, Selection.VALUE] if multiple else Selection.EMPTY,
+        multiple=multiple,
+        show_default=True,
+    )
+    def cmd(selection):
+        pass
+
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    assert "--selection [EMPTY|VALUE]" in result.output
+    expected = "EMPTY, VALUE" if multiple else "EMPTY"
+    assert f"[default: {expected}]" in result.output
+
