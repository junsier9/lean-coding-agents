diff --git a/tests/test_options.py b/tests/test_options.py
index ab230c4..3043c60 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -118,6 +118,62 @@ def test_multiple_required(runner):
     assert "Error: Missing option '-m' / '--message'." in result.output
 
 
+@pytest.mark.parametrize(
+    ("declaration", "args", "expect"),
+    [
+        ("--flag", [], None),
+        ("--flag", ["--flag"], True),
+        ("--flag/--no-flag", [], None),
+        ("--flag/--no-flag", ["--flag"], True),
+        ("--flag/--no-flag", ["--no-flag"], False),
+    ],
+)
+def test_required_boolean_flag(runner, declaration, args, expect):
+    @click.command()
+    @click.option(declaration, is_flag=True, required=True)
+    def cli(flag):
+        click.echo(flag)
+
+    result = runner.invoke(cli, args)
+
+    if expect is None:
+        assert result.exit_code == 2
+        assert "Error: Missing option '--flag'." in result.output
+    else:
+        assert result.exit_code == 0
+        assert result.output == f"{expect}\n"
+
+
+@pytest.mark.parametrize("default", [True, False, lambda: True, lambda: False])
+def test_required_boolean_flag_default(runner, default):
+    @click.command()
+    @click.option("--flag/--no-flag", required=True, default=default)
+    def cli(flag):
+        click.echo(flag)
+
+    result = runner.invoke(cli)
+    expect = default() if callable(default) else default
+    assert result.exit_code == 0
+    assert result.output == f"{expect}\n"
+
+
+@pytest.mark.parametrize("value", [True, False])
+@pytest.mark.parametrize("source", ["envvar", "default_map"])
+def test_required_boolean_flag_value_source(runner, value, source):
+    @click.command()
+    @click.option("--flag/--no-flag", required=True, envvar="FLAG")
+    def cli(flag):
+        click.echo(flag)
+
+    if source == "envvar":
+        result = runner.invoke(cli, env={"FLAG": str(value)})
+    else:
+        result = runner.invoke(cli, default_map={"flag": value})
+
+    assert result.exit_code == 0
+    assert result.output == f"{value}\n"
+
+
