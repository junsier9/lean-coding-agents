+@pytest.mark.parametrize("flag", ["--flag", "--no-flag", "-f", "-v"])
+@pytest.mark.parametrize("option", ["-c", "--choice"])
+@pytest.mark.parametrize("nargs", [2, 3])
+def test_option_nargs_after_flag(flag, option, nargs):
+    cli = Command(
+        "cli",
+        params=[
+            Option(["--flag/--no-flag", "-f"]),
+            Option(["-v"], count=True),
+            Option(["-c", "--choice"], type=Choice(["a", "b"]), nargs=nargs),
+            Argument(["arg"], type=Choice(["other"])),
+        ],
+    )
+    args = [flag, option]
+
+    for _ in range(nargs):
+        assert _get_words(cli, args, "") == ["a", "b"]
+        assert _get_words(cli, args, "b") == ["b"]
+        args.append("a")
+
+    assert _get_words(cli, args, "") == ["other"]
+    assert _get_words(cli, [*args, flag], "") == ["other"]
+
+
