diff --git a/tests/test_options.py b/tests/test_options.py
index ab230c4..f4595a7 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -658,6 +658,63 @@ def test_bool_flag_with_type(runner):
     assert not result.exception
 
 
+@pytest.mark.parametrize(
+    ("declaration", "is_flag"), [("--shout", True), ("--shout/--no-shout", None)]
+)
+def test_required_bool_flag(runner, declaration, is_flag):
+    @click.command()
+    @click.option(declaration, is_flag=is_flag, required=True)
+    def cli(shout):
+        click.echo(f"shout={shout}")
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 2
+    assert "Error: Missing option '--shout'." in result.output
+    assert "shout=" not in result.output
+
+    result = runner.invoke(cli, ["--shout"])
+    assert result.exit_code == 0
+    assert result.output == "shout=True\n"
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert "[required]" in result.output
+
+
+@pytest.mark.parametrize(
+    "invoke_args",
+    [
+        {"args": ["--no-shout"]},
+        {"env": {"SHOUT": "false"}},
+        {"default_map": {"shout": False}},
+        {"input": "n\n"},
+    ],
+)
+def test_required_bool_flag_false(runner, invoke_args):
+    @click.command()
+    @click.option("--shout/--no-shout", required=True, envvar="SHOUT", prompt=True)
+    def cli(shout):
+        click.echo(f"shout={shout}")
+
+    result = runner.invoke(cli, **invoke_args)
+    assert result.exit_code == 0
+    assert result.output.endswith("shout=False\n")
+
+
+@pytest.mark.parametrize("required", [False, True])
+@pytest.mark.parametrize("default", [False, True, lambda: False, lambda: True])
+def test_bool_flag_explicit_default(runner, required, default):
+    @click.command()
+    @click.option("--shout/--no-shout", required=required, default=default)
+    def cli(shout):
+        click.echo(shout)
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 0
+    expect = default() if callable(default) else default
+    assert result.output == f"{expect}\n"
+
+
