+@pytest.mark.parametrize("enum_type", [enum.Enum, enum.IntEnum, enum.Flag, enum.IntFlag])
+@pytest.mark.parametrize("case_sensitive", [True, False])
+@pytest.mark.parametrize("option_kwargs", [{}, {"multiple": True}, {"nargs": 2}])
+def test_enum_choice_default_help(runner, enum_type, case_sensitive, option_kwargs):
+    class Color(enum_type):
+        Red = 1
+        Blue = 2
+
+    if option_kwargs.get("multiple"):
+        default = [Color.Red, Color.Blue]
+    elif option_kwargs.get("nargs"):
+        default = (Color.Red, Color.Blue)
+    else:
+        default = Color.Red
+
+    @click.command()
+    @click.option(
+        "--color",
+        type=click.Choice(Color, case_sensitive=case_sensitive),
+        default=default,
+        show_default=True,
+        **option_kwargs,
+    )
+    def cmd(color):
+        return color
+
+    names = ["Red", "Blue"] if case_sensitive else ["red", "blue"]
+    expected_default = ", ".join(names) if option_kwargs else names[0]
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    assert f"[{'|'.join(names)}]" in result.output
+    assert f"[default: {expected_default}]" in result.output
+
+    result = runner.invoke(cmd, standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value == (tuple(default) if option_kwargs else default)
+
+
+def test_enum_choice_default_map_help(runner):
+    class Color(enum.Enum):
+        Red = 1
+        Blue = 2
+
+    @click.command(
+        context_settings={
+            "default_map": {"color": Color.Blue},
+            "token_normalize_func": str.lower,
+        }
+    )
+    @click.option("--color", type=click.Choice(Color), default=Color.Red, show_default=True)
+    def cmd(color):
+        return color
+
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    assert "[red|blue]" in result.output
+    assert "[default: blue]" in result.output
+
+    result = runner.invoke(cmd, standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value is Color.Blue
+
+
 def test_multiple_default_type():
     opt = click.Option(["-a"], multiple=True, default=(1, 2))
     assert opt.nargs == 1
