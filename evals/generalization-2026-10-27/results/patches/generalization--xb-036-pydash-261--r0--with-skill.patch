+@parametrize("make_collection", [iter, lambda values: (value for value in values)])
+def test_mean_by_iterator(values, iteratee, make_collection):
+    assert _.mean_by(make_collection(values), iteratee) == _.mean_by(values, iteratee)
+
+
+@parametrize("make_collection", [list, iter, lambda values: (value for value in values)])
+def test_mean_by_iteratee_context(make_collection):
+    collection = make_collection([1, 2, 3])
+    calls = []
+
+    def iteratee(value, index, source):
+        assert source is collection
+        calls.append((value, index))
+        return value + index
+
+    assert _.mean_by(collection, iteratee) == 3
+    assert calls == [(1, 0), (2, 1), (3, 2)]
+
+
+def test_mean_by_iteratee_error():
+    def iteratee(value):
+        raise ValueError("invalid value")
+
+    with pytest.raises(ValueError, match="invalid value"):
+        _.mean_by(iter([1, 2, 3]), iteratee)
+
