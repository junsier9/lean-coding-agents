diff --git a/tests/test_options.py b/tests/test_options.py
index ab230c4..73e2e7d 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -118,6 +118,69 @@ def test_multiple_required(runner):
     assert "Error: Missing option '-m' / '--message'." in result.output
 
 
+@pytest.mark.parametrize(
+    ("option", "args", "expect"),
+    [
+        ("--on/--off", [], None),
+        ("--on/--off", ["--on"], True),
+        ("--on/--off", ["--off"], False),
+        ("--on", [], None),
+        ("--on", ["--on"], True),
+    ],
+)
+def test_required_boolean_flag(runner, option, args, expect):
+    @click.command()
+    @click.option(option, is_flag=True, required=True)
+    def cli(on):
+        click.echo(f"on={on!r}")
+
+    result = runner.invoke(cli, args)
+
+    if expect is None:
+        assert result.exit_code == 2
+        assert "Error: Missing option '--on'." in result.output
+        assert "on=" not in result.output
+    else:
+        assert result.exit_code == 0
+        assert result.output == f"on={expect!r}\n"
+
+
+@pytest.mark.parametrize("default", [None, False, True, lambda: False])
+def test_required_boolean_flag_default(runner, default):
+    @click.command()
+    @click.option("--on/--off", required=True, default=default)
+    def cli(on):
+        click.echo(f"on={on!r}")
+
+    result = runner.invoke(cli, [])
+
+    if default is None:
+        assert result.exit_code == 2
+        assert "Error: Missing option '--on'." in result.output
+    else:
+        expect = default() if callable(default) else default
+        assert result.exit_code == 0
+        assert result.output == f"on={expect!r}\n"
+
+
+@pytest.mark.parametrize("source", ["env", "default_map"])
+@pytest.mark.parametrize("value", [False, True])
+def test_required_boolean_flag_value_source(runner, source, value):
+    @click.command()
+    @click.option("--on/--off", required=True, envvar="REQUIRED_ON")
+    def cli(on):
+        click.echo(f"on={on!r}")
+
+    if source == "env":
+        kwargs = {"env": {"REQUIRED_ON": str(value)}}
+    else:
+        kwargs = {"default_map": {"on": value}}
+
+    result = runner.invoke(cli, [], **kwargs)
+    assert result.exit_code == 0
+    assert result.output == f"on={value!r}\n"
+
+
