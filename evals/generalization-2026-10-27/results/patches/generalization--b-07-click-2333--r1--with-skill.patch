+@pytest.mark.parametrize(
+    ("entry_point", "expected"),
+    [
+        ("script", "example.py"),
+        ("example.pyz", "example.pyz"),
+        ("example.pex", "example.pex"),
+        ("example.shiv", "example.shiv"),
+        ("module", "python -m example"),
+        ("package", "python -m example"),
+        ("submodule", "python -m example.cli"),
+    ],
+)
+@pytest.mark.parametrize(("arg", "exit_code"), [("--help", 0), ("--unknown", 2)])
+def test_program_name_usage(tmp_path, entry_point, expected, arg, exit_code):
+    source = "import click\n@click.command()\ndef cli():\n    pass\ncli()\n"
+
+    if entry_point in {"package", "submodule"}:
+        package = tmp_path / "example"
+        package.mkdir()
+        (package / "__init__.py").touch()
+        name = "__main__.py" if entry_point == "package" else "cli.py"
+        (package / name).write_text(source, encoding="utf-8")
+        module = "example" if entry_point == "package" else "example.cli"
+        command = ["-m", module]
+    elif entry_point in {"script", "module"}:
+        (tmp_path / "example.py").write_text(source, encoding="utf-8")
+        command = ["example.py"] if entry_point == "script" else ["-m", "example"]
+    else:
+        with ZipFile(tmp_path / entry_point, "w") as archive:
+            archive.writestr("__main__.py", source)
+
+        command = [entry_point]
+
+    result = subprocess.run(
+        [sys.executable, *command, arg],
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+    output = result.stdout + result.stderr
+    assert result.returncode == exit_code, output
+    assert output.splitlines()[0] == f"Usage: {expected} [OPTIONS]"
+
+    if exit_code:
+        assert "Error: No such option: --unknown" in output
+
+
