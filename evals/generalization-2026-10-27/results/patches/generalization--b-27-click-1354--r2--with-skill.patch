+@pytest.mark.parametrize("length", [0, 1, 5])
+@pytest.mark.parametrize("update_min_steps", [1, 2, 4])
+def test_progressbar_item_show_func_during_iteration(
+    monkeypatch, length, update_min_steps
+):
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: True)
+    output = io.StringIO()
+
+    with click.progressbar(
+        range(length),
+        file=output,
+        item_show_func=lambda item: f"Item {item}",
+        update_min_steps=update_min_steps,
+        show_pos=True,
+        show_eta=False,
+    ) as progress:
+        for item in progress:
+            position = item // update_min_steps * update_min_steps
+            assert progress.current_item == item
+            assert progress.pos == position
+            line = click.unstyle(output.getvalue()).splitlines()[-1].rstrip()
+            assert line.endswith(f"{position}/{length}  Item {position}")
+
