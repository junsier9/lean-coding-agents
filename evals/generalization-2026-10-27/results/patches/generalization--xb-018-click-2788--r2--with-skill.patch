diff --git a/tests/test_arguments.py b/tests/test_arguments.py
index 825bcc4..f69577d 100644
--- a/tests/test_arguments.py
+++ b/tests/test_arguments.py
@@ -211,6 +211,84 @@ def test_nargs_envvar_only_if_values_empty(runner):
     assert result.return_value == ("a",)
 
 
+@pytest.mark.parametrize("flag_value", ["upper", "two words", "", 42, 0, 2.5])
+@pytest.mark.parametrize("multiple", [False, True])
+@pytest.mark.parametrize(
+    ("envvar", "env"),
+    [
+        ("X", {"X": "false"}),
+        (["UNSET", "X"], {"UNSET": None, "X": "arbitrary text"}),
+        (None, {"TEST_ARG": "1"}),
+    ],
+)
+def test_flag_value_envvar(runner, flag_value, multiple, envvar, env):
+    @click.command()
+    @click.option("--arg", flag_value=flag_value, multiple=multiple, envvar=envvar)
+    def cmd(arg):
+        return arg
+
+    explicit = runner.invoke(cmd, ["--arg"], standalone_mode=False)
+    assert explicit.exception is None
+    assert explicit.return_value == ((flag_value,) if multiple else flag_value)
+
+    result = runner.invoke(
+        cmd, env=env, auto_envvar_prefix="TEST", standalone_mode=False
+    )
+    assert result.exception is None
+    assert result.return_value == explicit.return_value
+
+
+@pytest.mark.parametrize(
+    ("option_kwargs", "value", "expect"),
+    [
+        ({"flag_value": "flag"}, None, None),
+        ({"flag_value": "flag"}, "", None),
+        ({"flag_value": "flag", "default": True}, "", "flag"),
+        ({"is_flag": True}, "false", False),
+        ({"is_flag": True}, "true", True),
+        ({"is_flag": False, "flag_value": "flag"}, "custom", "custom"),
+    ],
+)
+def test_envvar_option_values(runner, option_kwargs, value, expect):
+    @click.command()
+    @click.option("--arg", envvar="X", **option_kwargs)
+    def cmd(arg):
+        return arg
+
+    result = runner.invoke(cmd, env={"X": value}, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == expect
+
+
+def test_flag_value_envvar_commandline_priority(runner):
+    @click.command()
+    @click.option("--upper", "case", flag_value="upper", envvar="X")
+    @click.option("--lower", "case", flag_value="lower")
+    def cmd(case):
+        return case
+
+    result = runner.invoke(cmd, ["--lower"], env={"X": "1"}, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == "lower"
+
+
+@pytest.mark.parametrize("flag_value", ["42", "invalid"])
+def test_flag_value_envvar_type_validation(runner, flag_value):
+    @click.command()
+    @click.option("--arg", flag_value=flag_value, type=int, envvar="X")
+    def cmd(arg):
+        return arg
+
+    result = runner.invoke(cmd, env={"X": "1"}, standalone_mode=False)
+
+    if flag_value == "invalid":
+        assert isinstance(result.exception, click.BadParameter)
+        assert "'invalid' is not a valid integer." in str(result.exception)
+    else:
+        assert result.exception is None
+        assert result.return_value == 42
+
+
