+@pytest.mark.parametrize("filename", ["example.pyz", "example.pex", "example"])
+@pytest.mark.parametrize(("args", "exit_code"), [(["--help"], 0), ([], 2)])
+def test_zipapp_program_name(tmp_path, monkeypatch, filename, args, exit_code):
+    monkeypatch.setenv("PYTHONPATH", os.pathsep.join(sys.path))
+    archive = tmp_path / filename
+
+    with zipfile.ZipFile(archive, "w") as zf:
+        zf.writestr(
+            "__main__.py",
+            "import click\n"
+            "@click.command()\n"
+            "@click.argument('value')\n"
+            "def cli(value):\n"
+            "    pass\n"
+            "cli()\n",
+        )
+
+    result = subprocess.run(
+        [sys.executable, str(archive), *args],
+        capture_output=True,
+        text=True,
+        timeout=20,
+    )
+    assert result.returncode == exit_code
+    output = result.stdout if exit_code == 0 else result.stderr
+    assert output.startswith(f"Usage: {filename} [OPTIONS] VALUE\n")
+
+    if exit_code:
+        assert f"Try '{filename} --help' for help." in output
+        assert "Error: Missing argument 'VALUE'." in output
+
+
+@pytest.mark.parametrize(
+    ("module", "path"),
+    [
+        ("example", "example.py"),
+        ("example", "example/__main__.py"),
+        ("example.cli", "example/cli.py"),
+    ],
+)
+@pytest.mark.parametrize(("args", "exit_code"), [(["--help"], 0), ([], 2)])
+def test_module_program_name(tmp_path, monkeypatch, module, path, args, exit_code):
+    monkeypatch.setenv("PYTHONPATH", os.pathsep.join(sys.path))
+    script = tmp_path / path
+    script.parent.mkdir(parents=True, exist_ok=True)
+
+    if script.parent != tmp_path:
+        (script.parent / "__init__.py").write_text("", encoding="utf-8")
+
+    script.write_text(
+        "import click\n"
+        "@click.command()\n"
+        "@click.argument('value')\n"
+        "def cli(value):\n"
+        "    pass\n"
+        "cli()\n",
+        encoding="utf-8",
+    )
+    result = subprocess.run(
+        [sys.executable, "-m", module, *args],
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        timeout=20,
+    )
+    assert result.returncode == exit_code
+    output = result.stdout if exit_code == 0 else result.stderr
+    assert output.startswith(f"Usage: python -m {module} [OPTIONS] VALUE\n")
+
+    if exit_code:
+        assert f"Try 'python -m {module} --help' for help." in output
+        assert "Error: Missing argument 'VALUE'." in output
+
+
