+@pytest.mark.parametrize("env_key", ["X", "AUTO_ARG"])
+@pytest.mark.parametrize("multiple", [False, True])
+@pytest.mark.parametrize(
+    ("flag_value", "type", "expected"),
+    [
+        ("configured", None, "configured"),
+        ("two words", None, "two words"),
+        (0, None, 0),
+        ("", None, ""),
+        ("42", int, 42),
+        (("fixed", 42), (str, int), ("fixed", 42)),
+    ],
+)
+def test_flag_value_from_envvar(runner, env_key, multiple, flag_value, type, expected):
+    @click.command()
+    @click.option(
+        "--arg", envvar="X", flag_value=flag_value, type=type, multiple=multiple
+    )
+    @click.pass_context
+    def cli(ctx, arg):
+        return arg, ctx.get_parameter_source("arg")
+
+    if multiple:
+        expected = (expected,)
+
+    result = runner.invoke(cli, ["--arg"], standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == (expected, ParameterSource.COMMANDLINE)
+
+    result = runner.invoke(
+        cli,
+        env={env_key: "environment text"},
+        auto_envvar_prefix="AUTO",
+        standalone_mode=False,
+    )
+    assert result.exception is None
+    assert result.return_value == (expected, ParameterSource.ENVIRONMENT)
+
+
+@pytest.mark.parametrize("env_key", ["X", "AUTO_ARG"])
+@pytest.mark.parametrize("env_value", [None, ""])
+@pytest.mark.parametrize("default", [False, True])
+def test_flag_value_from_empty_envvar(runner, env_key, env_value, default):
+    @click.command()
+    @click.option("--arg", flag_value="configured", envvar="X", default=default)
+    def cli(arg):
+        return arg
+
+    result = runner.invoke(
+        cli,
+        env={env_key: env_value},
+        auto_envvar_prefix="AUTO",
+        standalone_mode=False,
+    )
+    assert result.exception is None
+    assert result.return_value == ("configured" if default else None)
+
+
+def test_flag_value_envvar_commandline_override(runner):
+    @click.command()
+    @click.option("--upper", "case", flag_value="upper", envvar="CASE")
+    @click.option("--lower", "case", flag_value="lower")
+    def cli(case):
+        return case
+
+    result = runner.invoke(
+        cli, ["--lower"], env={"CASE": "enabled"}, standalone_mode=False
+    )
+    assert result.exception is None
+    assert result.return_value == "lower"
+
+
+@pytest.mark.parametrize("multiple", [False, True])
+def test_non_flag_value_from_envvar(runner, multiple):
+    @click.command()
+    @click.option(
+        "--arg", is_flag=False, flag_value="configured", envvar="X", multiple=multiple
+    )
+    def cli(arg):
+        return arg
+
+    result = runner.invoke(cli, env={"X": "environment text"}, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == (
+        ("environment", "text") if multiple else "environment text"
+    )
+
+
+@pytest.mark.parametrize("env_value", ["true", "false", "invalid"])
+def test_boolean_flag_value_from_envvar(runner, env_value):
+    @click.command()
+    @click.option("--arg/--no-arg", envvar="X")
+    def cli(arg):
+        return arg
+
+    result = runner.invoke(cli, env={"X": env_value}, standalone_mode=False)
+    if env_value == "invalid":
+        assert isinstance(result.exception, click.BadParameter)
+        assert "'invalid' is not a valid boolean." in str(result.exception)
+    else:
+        assert result.exception is None
+        assert result.return_value is (env_value == "true")
+
+
