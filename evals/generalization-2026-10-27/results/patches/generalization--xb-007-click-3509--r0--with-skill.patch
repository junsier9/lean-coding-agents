+@pytest.mark.parametrize("deprecated", [True, "USE OTHER COMMAND INSTEAD"])
+def test_deprecated_short_help(runner, doc, help_field, deprecated):
+    command = click.Command("cli", deprecated=deprecated, **{help_field: doc})
+    label = f"(DEPRECATED: {deprecated})" if isinstance(deprecated, str) else "(DEPRECATED)"
+    text = f"CLI HELP {label}" if doc == "CLI HELP" else label
+    assert command.get_short_help_str() == text
+
+    group = click.Group("group", commands=[command])
+    result = runner.invoke(group, ["--help"])
+    assert result.exit_code == 0
+    assert result.output == (
+        "Usage: group [OPTIONS] COMMAND [ARGS]...\n\n"
+        "Options:\n  --help  Show this message and exit.\n\n"
+        f"Commands:\n  cli  {text}\n"
+    )
