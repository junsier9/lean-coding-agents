+@pytest.mark.parametrize("flag", ["--on", "--off", "-v"])
+@pytest.mark.parametrize("option", ["-c", "--choice"])
+@pytest.mark.parametrize("nargs", [2, 3])
+def test_option_nargs_after_flag(flag, option, nargs):
+    cli = Command(
+        "cli",
+        params=[
+            Option(["--on/--off"]),
+            Option(["-v"], count=True),
+            Option(["-c", "--choice"], type=Choice(["a1", "a2", "b"]), nargs=nargs),
+            Argument(["rest"], type=Choice(["c", "d"])),
+        ],
+    )
+    assert _get_words(cli, [flag], "") == ["c", "d"]
+
+    for count in range(nargs):
+        args = [flag, option, *(["a1"] * count)]
+        assert _get_words(cli, args, "") == ["a1", "a2", "b"]
+        assert _get_words(cli, args, "a") == ["a1", "a2"]
+
+    args = [flag, option, *(["a1"] * nargs)]
+    assert _get_words(cli, args, "") == ["c", "d"]
+    assert _get_words(cli, [*args, flag], "") == ["c", "d"]
+
