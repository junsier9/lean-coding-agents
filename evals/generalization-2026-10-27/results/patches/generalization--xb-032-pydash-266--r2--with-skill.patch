@@ -817,6 +817,44 @@ def test_uniq(case, expected):
     assert _.uniq(case) == expected
 
 
+@parametrize("deduplicate", [_.uniq, _.uniq_with])
+@parametrize("as_iterable", [list, tuple, iter])
+@parametrize(
+    "case,indices",
+    [
+        (
+            [set(), frozenset(), set(), frozenset({1}), {1}, {2}, frozenset({2})],
+            [0, 3, 5],
+        ),
+        (
+            [frozenset(), set(), frozenset({1}), {1}, {2}, frozenset({2})],
+            [0, 2, 4],
+        ),
+        ([{1}, {2}, {1}, {2}], [0, 1]),
+    ],
+)
+def test_uniq_mixed_hashability(deduplicate, as_iterable, case, indices):
+    result = deduplicate(as_iterable(case))
+
+    assert len(result) == len(indices)
+    assert all(item is case[index] for item, index in zip(result, indices))
+
+
+@parametrize("hashable_first", [True, False])
+def test_uniq_equal_objects_with_different_hashability(hashable_first):
+    class UnhashableInt(int):
+        __hash__ = None
+
+    types = (int, UnhashableInt) if hashable_first else (UnhashableInt, int)
+    case = [value_type(value) for value in (1, 2, 1) for value_type in types]
+
+    result = _.uniq(case)
+
+    assert len(result) == 2
+    assert result[0] is case[0]
+    assert result[1] is case[2]
+
+
