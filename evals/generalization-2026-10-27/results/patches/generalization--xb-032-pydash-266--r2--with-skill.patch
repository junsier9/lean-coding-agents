+        {"key": second_type({1}), "name": "duplicate"},
+        {"key": second_type({2}), "name": "second"},
+        {"key": first_type({2}), "name": "duplicate"},
+    ]
+
+    result = _.uniq_by(iter(case), iteratee)
+
+    assert len(result) == 2
+    assert result[0] is case[0]
+    assert result[1] is case[2]
