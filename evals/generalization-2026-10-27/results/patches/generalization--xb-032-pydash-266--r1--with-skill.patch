+@parametrize("uniq", [_.uniq, _.uniq_with])
+@parametrize(
+    "case,indices",
+    [
+        ([{1}], [0]),
+        ([{1}, frozenset({1}), {1}], [0]),
+        ([frozenset({1}), {1}, frozenset({1})], [0]),
+        ([set(), frozenset(), set()], [0]),
+        ([frozenset(), set(), frozenset()], [0]),
+        ([{1}, frozenset({2}), frozenset({1}), {2}, {3}, frozenset({3})], [0, 1, 4]),
+        ([frozenset({1}), {2}, {1}, frozenset({2}), frozenset({3}), {3}], [0, 1, 4]),
+    ],
+)
+def test_uniq_mixed_hashability(uniq, case, indices):
+    result = uniq(iter(case))
+    expected = [case[index] for index in indices]
+
+    assert result == expected
+    assert all(item is first for item, first in zip(result, expected))
+
