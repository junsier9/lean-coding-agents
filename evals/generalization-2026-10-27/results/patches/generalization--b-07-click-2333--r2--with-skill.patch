+@pytest.mark.parametrize(
+    ("entry_point", "expected"),
+    [
+        ("example", "example"),
+        ("example.pyz", "example.pyz"),
+        ("example.pex", "example.pex"),
+        ("example.py", "python -m example"),
+    ],
+)
+@pytest.mark.parametrize(("arg", "exit_code"), [("--help", 0), ("--invalid", 2)])
+def test_detect_program_name_entry_point(
+    tmp_path, monkeypatch, entry_point, expected, arg, exit_code
+):
+    source = "import click\n@click.command()\ndef cli():\n    pass\ncli()\n"
+    path = tmp_path / entry_point
+
+    if path.suffix == ".py":
+        path.write_text(source, encoding="utf-8")
+        command = [sys.executable, "-m", path.stem, arg]
+    else:
+        with zipfile.ZipFile(path, "w") as archive:
+            archive.writestr("__main__.py", source)
+
+        command = [sys.executable, str(path), arg]
+
+    monkeypatch.setenv("PYTHONPATH", str(pathlib.Path(click.__file__).parent.parent))
+    result = subprocess.run(
+        command, cwd=tmp_path, capture_output=True, text=True, timeout=30
+    )
+    assert result.returncode == exit_code
+    output = result.stdout if exit_code == 0 else result.stderr
+    assert output.startswith(f"Usage: {expected} [OPTIONS]\n")
+
+    if exit_code:
+        assert f"Try '{expected} --help' for help." in output
+        assert "Error: No such option: --invalid" in output
+
+
 def test_expand_args(monkeypatch):
     user = os.path.expanduser("~")
     assert user in click.utils._expand_args(["~"])
