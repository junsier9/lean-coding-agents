+@pytest.mark.parametrize("envvar", ["X", ["EMPTY", "X"], None])
+@pytest.mark.parametrize("env_value", ["enabled", "0"])
+@pytest.mark.parametrize(
+    ("flag_value", "option_kwargs", "expected"),
+    [
+        ("upper", {}, "upper"),
+        (42, {}, 42),
+        ("two words", {"multiple": True}, ("two words",)),
+        (42, {"multiple": True}, (42,)),
+        (("upper", 42), {"type": (str, int)}, ("upper", 42)),
+        (
+            ("upper", 42),
+            {"type": (str, int), "multiple": True},
+            (("upper", 42),),
+        ),
+    ],
+)
+def test_flag_value_envvar(runner, envvar, env_value, flag_value, option_kwargs, expected):
+    @click.command()
+    @click.option("--arg", flag_value=flag_value, envvar=envvar, **option_kwargs)
+    @click.pass_context
+    def cli(ctx, arg):
+        return arg, ctx.get_parameter_source("arg")
+
+    env_key = "AUTO_ARG" if envvar is None else "X"
+    env = {"EMPTY": "", env_key: env_value}
+    result = runner.invoke(
+        cli, env=env, auto_envvar_prefix="AUTO", standalone_mode=False
+    )
+    assert result.exception is None
+    assert result.return_value == (expected, ParameterSource.ENVIRONMENT)
+
+    result = runner.invoke(
+        cli, ["--arg"], env=env, auto_envvar_prefix="AUTO", standalone_mode=False
+    )
+    assert result.exception is None
+    assert result.return_value == (expected, ParameterSource.COMMANDLINE)
+
+
+@pytest.mark.parametrize("env_value", [None, ""])
+@pytest.mark.parametrize("default_map", [None, {"arg": 7}])
+def test_flag_value_envvar_empty(runner, env_value, default_map):
+    @click.command()
+    @click.option("--arg", flag_value=42, envvar="X", default=True)
+    @click.pass_context
+    def cli(ctx, arg):
+        return arg, ctx.get_parameter_source("arg")
+
+    result = runner.invoke(
+        cli, env={"X": env_value}, default_map=default_map, standalone_mode=False
+    )
+    assert result.exception is None
+    if default_map is None:
+        assert result.return_value == (42, ParameterSource.DEFAULT)
+    else:
+        assert result.return_value == (7, ParameterSource.DEFAULT_MAP)
+
+
+@pytest.mark.parametrize(
+    ("option_kwargs", "env_value", "expected"),
+    [
+        ({"is_flag": True}, "true", True),
+        ({"is_flag": True}, "false", False),
+        ({"is_flag": False, "flag_value": "flag"}, "value", "value"),
+        ({"type": int}, "42", 42),
+    ],
+)
+def test_envvar_option_value(runner, option_kwargs, env_value, expected):
+    @click.command()
+    @click.option("--arg", envvar="X", **option_kwargs)
+    def cli(arg):
+        return arg
+
+    result = runner.invoke(cli, env={"X": env_value}, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == expected
+
+
+@pytest.mark.parametrize("option_kwargs", [{"is_flag": True}, {"type": int}])
+def test_envvar_option_invalid_value(runner, option_kwargs):
+    @click.command()
+    @click.option("--arg", envvar="X", **option_kwargs)
+    def cli(arg):
+        return arg
+
+    result = runner.invoke(cli, env={"X": "invalid"}, standalone_mode=False)
+    assert isinstance(result.exception, click.BadParameter)
+
+
