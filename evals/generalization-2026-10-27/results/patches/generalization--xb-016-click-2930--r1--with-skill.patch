diff --git a/tests/test_options.py b/tests/test_options.py
index dd87bc8..33b2560 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -773,6 +773,65 @@ def test_bool_flag_with_type(runner):
     assert not result.exception
 
 
+@pytest.mark.parametrize("type", [bool, click.BOOL])
+@pytest.mark.parametrize(
+    ("kwargs", "default", "flag_value"),
+    [
+        ({}, False, True),
+        ({"default": False}, False, True),
+        ({"default": True}, True, False),
+        ({"default": None}, None, True),
+        ({"default": False, "flag_value": False}, False, False),
+        ({"default": True, "flag_value": True}, True, True),
+    ],
+)
+def test_bool_flag_with_explicit_type(runner, type, kwargs, default, flag_value):
+    @click.command()
+    @click.option("--shout", is_flag=True, type=type, **kwargs)
+    def cmd(shout):
+        return shout
+
+    result = runner.invoke(cmd, [], standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    assert result.return_value is default
+
+    result = runner.invoke(cmd, ["--shout"], standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    assert result.return_value is flag_value
+
+
+@pytest.mark.parametrize("type", [bool, click.BOOL])
+def test_multiple_bool_flag_with_explicit_type(runner, type):
+    @click.command()
+    @click.option("--shout", is_flag=True, type=type, multiple=True)
+    def cmd(shout):
+        return shout
+
+    result = runner.invoke(cmd, [], standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    assert result.return_value == ()
+
+    result = runner.invoke(cmd, ["--shout", "--shout"], standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    assert result.return_value == (True, True)
+
+
+@pytest.mark.parametrize("type", [bool, click.BOOL])
+def test_required_bool_flag_with_explicit_type(runner, type):
+    @click.command()
+    @click.option("--shout", is_flag=True, type=type, required=True)
+    def cmd(shout):
+        return shout
+
+    result = runner.invoke(cmd, [])
+    assert result.exit_code == 2
+    assert "Missing option '--shout'." in result.output
+
+    result = runner.invoke(cmd, ["--shout"], standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    assert result.return_value is True
+
+
