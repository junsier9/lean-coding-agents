--- a/src/cachetools/_descriptor.py
+++ b/src/cachetools/_descriptor.py
@@ -3,6 +3,7 @@
 __all__ = ()
 
 import functools
+import types
 import warnings
 
 
@@ -96,14 +97,14 @@ class _MethodDescriptor:
         # Created once and shared by all class accesses; objtype is not
         # used for instance lookups, so it need not be bound here.
         if self.__unbound is None:
-            descriptor = self
 
-            # As in the previous function wrapper, the receiver is named self.
             @functools.wraps(self.__wrapped__)  # type: ignore
-            def unbound(self, *args, **kwargs):
+            def unbound(descriptor, /, self, *args, **kwargs):
                 return descriptor.__get__(self)(*args, **kwargs)
 
-            self.__unbound = unbound  # type: ignore
+            # Binding the descriptor lets autospec skip the wrapped receiver,
+            # while class calls still pass the actual instance explicitly.
+            self.__unbound = types.MethodType(unbound, self)  # type: ignore
         return self.__unbound
 
 
