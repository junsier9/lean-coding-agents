         self.assertEqual(len(w), 0)
+
+    def test_autospec_calls(self):
+        import unittest.mock
+
+        names = (
+            "get",
+            "get_typed",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        )
+        for instance in (False, True):
+            mock = unittest.mock.create_autospec(Cached, instance=instance)
+            if not instance:
+                mock = mock(Cache(2))
+            for name in names:
+                with self.subTest(instance=instance, method=name):
+                    method = getattr(mock, name)
+                    method.return_value = 42
+                    self.assertEqual(method(1), 42)
+                    method.assert_called_once_with(1)
+                    method.reset_mock()
+                    self.assertEqual(method(value=1), 42)
+                    method.assert_called_once_with(value=1)
+                    with self.assertRaises(TypeError):
+                        method()
+                    with self.assertRaises(TypeError):
+                        method(1, 2)
+                    with self.assertRaises(TypeError):
+                        method(1, unexpected=2)
+
+    def test_autospec_parameter_kinds(self):
+        import unittest.mock
+
+        class Cached:
+            def __init__(self):
+                self.cache = {}
+
+            @cachedmethod(lambda self: self.cache)
+            def get(self, value, /, scale=1, *, offset):
+                return value * scale + offset
+
+        cached = Cached()
+        self.assertEqual(Cached.get(cached, 2, offset=3), 5)
+        self.assertEqual(cached.get(2, offset=3), 5)
+        self.assertEqual(len(cached.cache), 1)
+
+        mock = unittest.mock.create_autospec(Cached, instance=True)
+        mock.get.return_value = 42
+        self.assertEqual(mock.get(2, offset=3), 42)
+        mock.get.assert_called_once_with(2, offset=3)
+        self.assertEqual(mock.get(2, 4, offset=3), 42)
+        self.assertEqual(mock.get(2, scale=4, offset=3), 42)
+        with self.assertRaises(TypeError):
+            mock.get(2)
+        with self.assertRaises(TypeError):
+            mock.get(value=2, offset=3)
+        with self.assertRaises(TypeError):
+            mock.get(2, 4, 3)
+
+    def test_class_call_variants(self):
+        for name in (
+            "get",
+            "get_typed",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        ):
+            with self.subTest(method=name):
+                cached = Cached(Cache(2))
+                method = getattr(Cached, name)
+                self.assertEqual(method(cached, 1), 0)
+                self.assertEqual(getattr(cached, name)(1), 0)
+                self.assertEqual(cached.count, 1)
+                self.assertEqual(method(self=cached, value=2), 1)
+                self.assertEqual(method(self=cached, value=2), 1)
+                self.assertEqual(cached.count, 2)
