+@pytest.mark.parametrize('method_kind', ['instance', 'class'])
+def test_decorator_access_bound_method_posonly(method_kind):
+    @decorator
+    def read_args(call):
+        return (call.x, call.y, call.rest, call.flag, call.extras), call()
+
+    class A(object):
+        def method(receiver, x=10, /, y=11, *rest, flag=12, **extras):
+            return x, y, rest, flag, extras
+
+        def required(receiver, x, /):
+            return x
+
+    if method_kind == 'class':
+        A.method = classmethod(A.method)
+        A.required = classmethod(A.required)
+
+    instance = A()
+    wrapped = read_args(instance.method)
+    expected = (10, 11, (), 12, {})
+    assert wrapped() == (expected, expected)
+    expected = (20, 30, (40,), 50, {'other': 60})
+    assert wrapped(20, 30, 40, flag=50, other=60) == (expected, expected)
+    expected = (10, 30, (), 50, {'x': 20, 'receiver': 60})
+    assert wrapped(x=20, y=30, flag=50, receiver=60) == (expected, expected)
+
+    @decorator
+    def read_x(call):
+        return call.x
+
+    with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+        read_x(instance.required)(x=20)
