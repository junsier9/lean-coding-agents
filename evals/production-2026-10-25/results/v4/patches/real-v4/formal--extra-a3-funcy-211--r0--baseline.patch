+@pytest.mark.parametrize('method_kind', ['instance', 'class'])
+@pytest.mark.parametrize('wrapping', ['plain', 'functools', 'funcy'])
+def test_decorator_access_bound_method_args(method_kind, wrapping):
+    @decorator
+    def noop(call):
+        return call()
+
+    def passthrough(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            return func(*args, **kwargs)
+        return wrapper
+
+    @decorator
+    def read_args(call):
+        return (call.x, call.y, call.rest, call.flag, call.extras), call()
+
+    class A(object):
+        def method(receiver, x, y=11, *rest, flag=12, **extras):
+            return x, y, rest, flag, extras
+
+    if wrapping == 'functools':
+        A.method = passthrough(A.method)
+    elif wrapping == 'funcy':
+        A.method = noop(A.method)
+    if method_kind == 'class':
+        A.method = classmethod(A.method)
+
+    method = A().method
+    # Also check binding survives wrappers applied after the method is bound.
+    for target in (method, noop(noop(method)), passthrough(method)):
+        wrapped = read_args(target)
+        expected = (10, 11, (), 12, {})
+        assert wrapped(10) == (expected, expected)
+        expected = (10, 20, (30, 40), 50, {'other': 60, 'extras': 70})
+        assert wrapped(10, 20, 30, 40, flag=50, other=60, extras=70) == (expected, expected)
+        expected = (10, 20, (), 50, {'other': 60})
+        assert wrapped(x=10, y=20, flag=50, other=60) == (expected, expected)
+        with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+            wrapped()
+
+
+@pytest.mark.parametrize('method_kind', ['instance', 'class'])
+def test_decorator_access_bound_method_defaults(method_kind):
+    @decorator
+    def read_x(call):
+        return call.x
+
+    class A(object):
+        def method(receiver=None, x=11):
+            return x
+
+    if method_kind == 'class':
+        A.method = classmethod(A.method)
+
+    wrapped = read_x(A().method)
+    assert wrapped() == 11
+    assert wrapped(20) == 20
+    assert wrapped(x=30) == 30
+
+    @decorator
+    def read_missing(call):
+        return call.missing
+
+    with pytest.raises(AttributeError, match="doesn't have argument named missing"):
+        read_missing(A().method)()
+
+
+@pytest.mark.parametrize('method_kind', ['instance', 'class'])
+def test_decorator_access_bound_method_varargs(method_kind):
+    @decorator
+    def read_args(call):
+        return (call.values, call.options), call()
+
+    class A(object):
+        def method(*values, **options):
+            return values, options
+
+    if method_kind == 'class':
+        A.method = classmethod(A.method)
+
+    instance = A()
+    receiver = A if method_kind == 'class' else instance
+    wrapped = read_args(instance.method)
+    expected = ((receiver,), {})
+    assert wrapped() == (expected, expected)
+    expected = ((receiver, 10, 20), {'other': 30})
+    assert wrapped(10, 20, other=30) == (expected, expected)
+
+
