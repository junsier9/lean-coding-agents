+@pytest.mark.parametrize('class_method', [False, True])
+def test_decorator_bound_method_posonly_args(class_method):
+    class A:
+        def method(receiver, x=10, /, y=11, *rest, flag=12, **options):
+            return receiver, x, y, rest, flag, options
+
+    if class_method:
+        A.method = classmethod(A.method)
+    instance = A()
+    receiver = A if class_method else instance
+
+    @decorator
+    def read_args(call):
+        values = call.receiver, call.x, call.y, call.rest, call.flag, call.options
+        assert values == call()
+        return values
+
+    wrapped = read_args(instance.method)
+    assert wrapped() == (receiver, 10, 11, (), 12, {})
+    assert wrapped(x=20, receiver=21) == (receiver, 10, 11, (), 12, {'x': 20, 'receiver': 21})
+    assert wrapped(30, 31, 32, flag=33, x=34) == (receiver, 30, 31, (32,), 33, {'x': 34})
+
+    @decorator
+    def return_x(call):
+        return call.x
+
+    class Required:
+        def method(receiver, x, /):
+            return x
+
+    if class_method:
+        Required.method = classmethod(Required.method)
+    with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+        return_x(Required().method)(x=10)
