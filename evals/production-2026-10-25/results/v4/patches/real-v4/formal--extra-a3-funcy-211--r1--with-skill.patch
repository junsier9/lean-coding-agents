+@pytest.mark.parametrize('class_method', [False, True])
+@pytest.mark.parametrize('wrap', [None, functools.wraps, wraps])
+def test_decorator_bound_method_args(class_method, wrap):
+    def passthrough(func):
+        if wrap is None:
+            return func
+
+        @wrap(func)
+        def wrapper(*args, **kwargs):
+            return func(*args, **kwargs)
+        return wrapper
+
+    class A:
+        @passthrough
+        def method(receiver, x, y=11, *rest, flag=12, **options):
+            return receiver, x, y, rest, flag, options
+
+    if class_method:
+        A.method = classmethod(A.method)
+    instance = A()
+    receiver = A if class_method else instance
+    method = instance.method
+
+    @decorator
+    def read_args(call):
+        values = call.receiver, call.x, call.y, call.rest, call.flag, call.options
+        assert values == call()
+        return values
+
+    wrapped = read_args(method)
+    assert wrapped(10) == (receiver, 10, 11, (), 12, {})
+    assert wrapped(x=20, y=21, flag=22, extra=23) == (receiver, 20, 21, (), 22, {'extra': 23})
+    assert wrapped(30, 31, 32, 33, flag=34, rest=35) == (
+        receiver, 30, 31, (32, 33), 34, {'rest': 35})
+    assert wrapped.__wrapped__ is method
+    assert wrapped.__name__ == method.__name__
+
+    # Unwrapping another layer must retain the receiver of the bound method.
+    assert read_args(wrapped)(40) == (receiver, 40, 11, (), 12, {})
+
+    with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+        wrapped()
+    with pytest.raises(TypeError):
+        wrapped(10, receiver=object())
+
+    @decorator
+    def read_missing(call):
+        return call.missing
+
+    with pytest.raises(AttributeError, match="doesn't have argument named missing"):
+        read_missing(method)(10)
+
+
+@pytest.mark.parametrize('class_method', [False, True])
+def test_decorator_bound_variadic_method(class_method):
+    class A:
+        def method(*values, **options):
+            return values, options
+
+    if class_method:
+        A.method = classmethod(A.method)
+    instance = A()
+    receiver = A if class_method else instance
+
+    @decorator
+    def read_args(call):
+        assert (call.values, call.options) == call()
+        return call.values, call.options
+
+    wrapped = read_args(instance.method)
+    assert wrapped() == ((receiver,), {})
+    assert wrapped(1, 2, values=3) == ((receiver, 1, 2), {'values': 3})
+
+
+def test_decorator_method_receiver_by_keyword():
+    class A:
+        def method(target, x=10):
+            return target, x
+
+    instance = A()
+
+    @decorator
+    def read_args(call):
+        assert (call.target, call.x) == call()
+        return call.target, call.x
+
+    A.method = read_args(A.method)
+    assert instance.method() == (instance, 10)
+    assert A.method(instance, 20) == (instance, 20)
+    assert A.method(target=instance, x=30) == (instance, 30)
+    assert read_args(instance.method)(40) == (instance, 40)
+
