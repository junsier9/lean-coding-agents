+@pytest.mark.parametrize("option_name", ["--opt", "-o"])
+@pytest.mark.parametrize(
+    ("option_type", "default", "flag_value", "explicit_value"),
+    [
+        (str, UNSET, "flag", "value"),
+        (str, None, "flag", "value"),
+        (str, "default", "flag", "value"),
+        (str, "default", "", "value"),
+        (int, UNSET, 2, 3),
+        (int, None, 2, 3),
+        (int, 0, 2, 3),
+        (int, 1, 0, 3),
+    ],
+)
+def test_option_with_optional_value_defaults(
+    runner, option_name, option_type, default, flag_value, explicit_value
+):
+    @click.command()
+    @click.option(
+        "-o",
+        "--opt",
+        is_flag=False,
+        type=option_type,
+        default=default,
+        flag_value=flag_value,
+    )
+    def cli(opt):
+        return opt
+
+    for args, expected in (
+        ([], None if default is UNSET else default),
+        ([option_name], flag_value),
+        ([option_name, str(explicit_value)], explicit_value),
+    ):
+        result = runner.invoke(cli, args, standalone_mode=False, catch_exceptions=False)
+        assert result.exit_code == 0, result.output
+        assert result.return_value == expected
+
+
+@pytest.mark.parametrize("default", [UNSET, None, "default", 42])
+def test_non_flag_option_without_flag_value_requires_value(runner, default):
+    @click.command()
+    @click.option("--opt", is_flag=False, default=default)
+    def cli(opt):
+        pass
+
+    result = runner.invoke(cli, ["--opt"])
+    assert result.exit_code == 2
+    assert "Option '--opt' requires an argument." in result.output
+
+
+@pytest.mark.parametrize("args", [["--opt", "invalid"], ["--opt=invalid"]])
+def test_option_with_optional_integer_value_invalid(runner, args):
+    @click.command()
+    @click.option("--opt", is_flag=False, type=int, default=1, flag_value=2)
+    def cli(opt):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 2
+    assert "'invalid' is not a valid integer." in result.output
+
+
