 import click
 
 
@@ -142,6 +144,29 @@ def test_formatting_empty_help_lines(runner):
     ]
 
 
+@pytest.mark.parametrize(
+    "doc", [None, "", "   ", "\n    \f\n    Hidden documentation."]
+)
+@pytest.mark.parametrize("deprecated", [False, True])
+def test_formatting_empty_help(runner, doc, deprecated):
+    def cli():
+        pass
+
+    cli.__doc__ = doc
+    cli = click.command(deprecated=deprecated)(cli)
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.exception is None
+    expected = ["Usage: cli [OPTIONS]", ""]
+
+    if deprecated:
+        expected.extend(["  (Deprecated)", ""])
+
+    expected.extend(["Options:", "  --help  Show this message and exit."])
+    assert result.output == "\n".join(expected) + "\n"
+
+
