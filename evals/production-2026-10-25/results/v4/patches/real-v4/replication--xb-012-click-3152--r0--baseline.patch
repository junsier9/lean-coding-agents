+@pytest.mark.parametrize(
+    ("option_type", "default", "flag_value", "explicit_value"),
+    [
+        (None, "default", "flag", "42"),
+        (str, "default", "flag", "42"),
+        (str, None, "flag", "42"),
+        (str, "", "", "42"),
+        (str, "default", None, "42"),
+        (None, 1, 2, 42),
+        (int, 1, 2, 42),
+        (int, 0, 0, 42),
+        (int, None, 0, 42),
+        (int, UNSET, 0, 42),
+    ],
+)
+@pytest.mark.parametrize("option", ["-o", "--opt"])
+@pytest.mark.parametrize("usage", ["omitted", "flag", "value", "joined", "next_option"])
+def test_option_with_optional_value_and_default(
+    runner, option_type, default, flag_value, explicit_value, option, usage
+):
+    @click.command()
+    @click.option(
+        "-o", "--opt", is_flag=False, flag_value=flag_value, default=default, type=option_type
+    )
+    @click.option("--other", is_flag=True)
+    def cli(opt, other):
+        return opt, other
+
+    args, expected = {
+        "omitted": ([], (None if default is UNSET else default, False)),
+        "flag": ([option], (flag_value, False)),
+        "value": ([option, "42"], (explicit_value, False)),
+        "joined": (
+            [f"{option}{'=' if option.startswith('--') else ''}42"],
+            (explicit_value, False),
+        ),
+        "next_option": ([option, "--other"], (flag_value, True)),
+    }[usage]
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exception is None, result.output
+    assert result.return_value == expected
+    assert type(result.return_value[0]) is type(expected[0])
+
+
+@pytest.mark.parametrize("default", [UNSET, None, "default"])
+def test_non_flag_without_flag_value_requires_value(runner, default):
+    @click.command()
+    @click.option("--opt", is_flag=False, default=default)
+    def cli(opt):
+        pass
+
+    result = runner.invoke(cli, ["--opt"])
+    assert result.exit_code == 2
+    assert "Option '--opt' requires an argument." in result.output
+
