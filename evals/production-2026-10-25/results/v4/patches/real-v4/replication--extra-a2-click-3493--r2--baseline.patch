+@pytest.mark.parametrize("message", [b"", b"\xff\x1b[31mx\x1b[39m"])
+@pytest.mark.parametrize("nl", [False, True])
+@pytest.mark.parametrize("wrapped", [False, True])
+def test_echo_binary_file(message, nl, wrapped):
+    binary_file = BytesIO()
+    file = TextIOWrapper(binary_file, encoding="utf-8") if wrapped else binary_file
+    click.echo(message, file=file, nl=nl)
+    assert binary_file.getvalue() == message + (b"\n" if nl else b"")
+
+
+@pytest.mark.parametrize(
+    ("message", "expected"),
+    [
+        ("", ""),
+        ("hello", "hello"),
+        ("\x1b[31mx\x1b[39m", "x"),
+        (None, ""),
+        (bytearray(), ""),
+    ],
+)
+@pytest.mark.parametrize("nl", [False, True])
+def test_echo_text_file(message, expected, nl):
+    file = StringIO()
+    click.echo(message, file=file, nl=nl)
+    assert file.getvalue() == expected + ("\n" if nl else "")
+
+
+@pytest.mark.parametrize("nl", [False, True])
+def test_echo_bytearray_file(nl):
+    message = bytearray(b"\x1b[31mx\x1b[39m")
+    file = BytesIO()
+    click.echo(message, file=file, nl=nl)
+    expected = b"\x1b[31mx\x1b[39m" + (b"\n" if nl else b"")
+    assert file.getvalue() == expected
+    assert message == expected
+
+
+@pytest.mark.parametrize("text", ["", "\x1b[31mx\x1b[39m"])
+@pytest.mark.parametrize("nl", [False, True])
+def test_echo_custom_object(text, nl):
+    class Message:
+        def __str__(self):
+            return text
+
+        def __bool__(self):
+            raise AssertionError("The message should be converted to text first.")
+
+    file = StringIO()
+    click.echo(Message(), file=file, nl=nl)
+    assert file.getvalue() == click.unstyle(text) + ("\n" if nl else "")
+
