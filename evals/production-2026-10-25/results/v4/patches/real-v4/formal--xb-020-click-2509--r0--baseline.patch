diff --git a/tests/test_termui.py b/tests/test_termui.py
index 7cfa939..4f394af 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -234,6 +234,49 @@ def test_file_prompt_default_format(runner, file_kwargs):
     assert result.output == f"file [{__file__}]: \n{__file__}\n"
 
 
+@pytest.mark.parametrize("show_default", [None, True, False, "custom default", ""])
+@pytest.mark.parametrize("default", ["secret", lambda: "secret"])
+@pytest.mark.parametrize("hide_input", [False, True])
+def test_option_prompt_show_default(runner, show_default, default, hide_input):
+    @click.command()
+    @click.option(
+        "--value",
+        default=default,
+        prompt=True,
+        show_default=show_default,
+        hide_input=hide_input,
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == "secret"
+    if show_default is False:
+        assert result.output == "Value: \n"
+    else:
+        assert result.output == "Value [secret]: \n"
+
+
+@pytest.mark.parametrize("show_default", [None, True, False, "custom default", ""])
+@pytest.mark.parametrize("default", [False, True])
+def test_boolean_option_prompt_show_default(runner, show_default, default):
+    @click.command()
+    @click.option(
+        "--value/--no-value", default=default, prompt=True, show_default=show_default
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value is default
+    if show_default is False:
+        assert result.output == "Value: \n"
+    else:
+        assert result.output == f"Value [{'Y/n' if default else 'y/N'}]: \n"
+
+
 def test_secho(runner):
     with runner.isolation() as outstreams:
         click.secho(None, nl=False)
