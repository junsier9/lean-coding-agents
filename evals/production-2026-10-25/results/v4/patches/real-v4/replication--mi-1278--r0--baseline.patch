+    def test_one_shot_iterables(self):
+        class OneShotIterable:
+            def __init__(self, values):
+                self.values = values
+                self.iterated = False
+
+            def __iter__(self):
+                if self.iterated:
+                    raise RuntimeError('iterator already requested')
+                self.iterated = True
+                return iter(self.values)
+
+        for strict in (False, True):
+            for objects, expected, equal_lengths in [
+                ([[]], [], True),
+                ([[1]], [(1,)], True),
+                ([[1, 2]], [(1,), (2,)], True),
+                ([[], None, 'ab'], [], True),
+                ([None, [], b'ab'], [], True),
+                ([None, b'ab', []], [], True),
+                (
+                    [None, [1, 2], 'ab'],
+                    [(None, 1, 'ab'), (None, 2, 'ab')],
+                    True,
+                ),
+                ([[1, 2], 3, [4, 5]], [(1, 3, 4), (2, 3, 5)], True),
+                ([[], []], [], True),
+                ([[], [1]], [], False),
+                ([[1], []], [], False),
+                ([[1], [2, 3]], [(1, 2)], False),
+                ([[1, 2], [3]], [(1, 3)], False),
+            ]:
+                with self.subTest(objects=objects, strict=strict):
+                    inputs = [
+                        OneShotIterable(obj) if isinstance(obj, list) else obj
+                        for obj in objects
+                    ]
+                    result = mi.zip_broadcast(*inputs, strict=strict)
+                    if strict and not equal_lengths:
+                        with self.assertRaises(ValueError):
+                            list(result)
+                    else:
+                        self.assertEqual(list(result), expected)
+
