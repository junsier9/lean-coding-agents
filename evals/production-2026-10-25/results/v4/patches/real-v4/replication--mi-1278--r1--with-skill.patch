 class ZipBroadcastTests(TestCase):
+    def test_single_use_iterables(self):
+        class SingleUseIterable:
+            def __init__(self, items):
+                self.items = items
+                self.iter_calls = 0
+
+            def __iter__(self):
+                self.iter_calls += 1
+                if self.iter_calls > 1:
+                    raise RuntimeError('iter() called more than once')
+                return iter(self.items)
+
+        for objects, expected, strict_ok in [
+            ([[]], [], True),
+            ([[], 1], [], True),
+            ([1, []], [], True),
+            ([[], []], [], True),
+            ([[1, 2]], [(1,), (2,)], True),
+            ([[1, 2], [3, 4]], [(1, 3), (2, 4)], True),
+            (
+                ['ab', [1, 2], 3, [4, 5], b'cd'],
+                [('ab', 1, 3, 4, b'cd'), ('ab', 2, 3, 5, b'cd')],
+                True,
+            ),
+            ([[], [1]], [], False),
+            ([[1], []], [], False),
+            ([[1], 2, [3, 4]], [(1, 2, 3)], False),
+            ([[1, 2], 3, [4]], [(1, 3, 4)], False),
+        ]:
+            for strict in (False, True):
+                with self.subTest(objects=objects, strict=strict):
+                    inputs = [
+                        SingleUseIterable(obj) if isinstance(obj, list) else obj
+                        for obj in objects
+                    ]
+                    if strict and not strict_ok:
+                        with self.assertRaises(ValueError):
+                            list(mi.zip_broadcast(*inputs, strict=strict))
+                    else:
+                        self.assertEqual(
+                            list(mi.zip_broadcast(*inputs, strict=strict)),
+                            expected,
+                        )
+
+    def test_scalar_type_not_iterated(self):
+        class Scalar:
+            def __iter__(self):
+                raise AssertionError('scalar must not be iterated')
+
+        scalar = Scalar()
+        for strict in (False, True):
+            with self.subTest(strict=strict):
+                self.assertEqual(
+                    list(
+                        mi.zip_broadcast(
+                            scalar, [1, 2], scalar_types=Scalar, strict=strict
+                        )
+                    ),
+                    [(scalar, 1), (scalar, 2)],
+                )
+
+    def test_iteration_error(self):
+        class BrokenIterable:
+            def __iter__(self):
+                raise RuntimeError('cannot acquire iterator')
+
+        for strict in (False, True):
+            with self.subTest(strict=strict):
+                with self.assertRaisesRegex(
+                    RuntimeError, 'cannot acquire iterator'
+                ):
+                    list(mi.zip_broadcast(BrokenIterable(), strict=strict))
