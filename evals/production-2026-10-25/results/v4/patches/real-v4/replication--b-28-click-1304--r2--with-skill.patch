+@pytest.mark.parametrize('envvar', ['X', ['X', 'Y'], ('X', 'Y'), None])
+@pytest.mark.parametrize('default,default_map,expected', [
+    (None, None, 'None\n'),
+    ('.', None, "'.'\n"),
+    (None, {'arg': '.'}, "'.'\n"),
+])
+def test_empty_path_envvar(runner, envvar, default, default_map, expected):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar=envvar,
+                  default=default)
+    def cmd(arg):
+        click.echo(repr(arg))
+
+    for value in (None, ''):
+        result = runner.invoke(cmd, [], auto_envvar_prefix='TEST',
+                               default_map=default_map,
+                               env={'X': value, 'Y': value, 'TEST_ARG': value})
+        assert result.exit_code == 0
+        assert result.output == expected
+
+
+@pytest.mark.parametrize('envvar,env', [
+    ('X', {'X': '', 'TEST_ARG': '.'}),
+    (['X', 'Y'], {'X': '', 'Y': '.', 'TEST_ARG': 'missing-path'}),
+    (('X', 'Y'), {'X': '', 'Y': '.', 'TEST_ARG': 'missing-path'}),
+    (['X', 'Y'], {'X': '.', 'Y': 'missing-path',
+                  'TEST_ARG': 'missing-path'}),
+])
+def test_path_envvar_fallback(runner, envvar, env):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar=envvar)
+    def cmd(arg):
+        click.echo(arg)
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST', env=env)
+    assert result.exit_code == 0
+    assert result.output == '.\n'
+
+
+@pytest.mark.parametrize('envvar', ['X', ['X', 'Y'], ('X', 'Y'), None])
+def test_empty_path_envvar_required(runner, envvar):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar=envvar,
+                  required=True)
+    def cmd(arg):
+        click.echo(arg)
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST',
+                           env={'X': '', 'Y': '', 'TEST_ARG': ''})
+    assert result.exit_code == 2
+    assert 'Missing option "--arg".' in result.output
+
+
+@pytest.mark.parametrize('envvar', ['X', ['X', 'Y'], ('X', 'Y'), None])
+@pytest.mark.parametrize('value', ['missing-path', ' '])
+def test_invalid_path_envvar(runner, envvar, value):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar=envvar,
+                  default='.')
+    def cmd(arg):
+        click.echo(arg)
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST',
+                           env={'X': value, 'Y': '.', 'TEST_ARG': value})
+    assert result.exit_code == 2
+    assert 'Invalid value for "--arg"' in result.output
+    assert 'does not exist.' in result.output
+
+
+def test_empty_path_option(runner):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar='X', default='.')
+    def cmd(arg):
+        click.echo(arg)
+
+    result = runner.invoke(cmd, ['--arg', ''], env={'X': '.'})
+    assert result.exit_code == 2
+    assert 'Path "" does not exist.' in result.output
+
+
