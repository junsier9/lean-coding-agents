--- a/src/cachetools/_descriptor.py
+++ b/src/cachetools/_descriptor.py
@@ -103,7 +103,11 @@ class _MethodDescriptor:
             def unbound(self, *args, **kwargs):
                 return descriptor.__get__(self)(*args, **kwargs)
 
-            self.__unbound = unbound  # type: ignore
+            # A callable object avoids autospec treating this descriptor as a
+            # function whose self argument still needs to be supplied.
+            self.__unbound = functools.update_wrapper(
+                functools.partial(unbound), self.__wrapped__  # type: ignore
+            )
         return self.__unbound
 
 
