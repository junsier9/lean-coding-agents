diff --git a/tests/test_termui.py b/tests/test_termui.py
index 7cfa939..0bfdb49 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -234,6 +234,66 @@ def test_file_prompt_default_format(runner, file_kwargs):
     assert result.output == f"file [{__file__}]: \n{__file__}\n"
 
 
+@pytest.mark.parametrize(
+    ("show_default", "suffix"),
+    [
+        (False, ""),
+        (None, " [secret]"),
+        (True, " [secret]"),
+        ("description", " [secret]"),
+        ("", " [secret]"),
+    ],
+)
+@pytest.mark.parametrize("hide_input", [False, True])
+def test_prompt_show_default(runner, show_default, suffix, hide_input):
+    @click.command()
+    @click.option(
+        "--value",
+        default="secret",
+        prompt=True,
+        show_default=show_default,
+        hide_input=hide_input,
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value == "secret"
+    assert result.output == f"Value{suffix}: \n"
+
+
+@pytest.mark.parametrize("show_default", [False, None, True, "description", ""])
+@pytest.mark.parametrize(("default", "hint"), [(True, "Y/n"), (False, "y/N")])
+def test_confirm_show_default(runner, show_default, default, hint):
+    @click.command()
+    @click.option(
+        "--value", is_flag=True, default=default, prompt=True, show_default=show_default
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value is default
+    suffix = "" if show_default is False else f" [{hint}]"
+    assert result.output == f"Value{suffix}: \n"
+
+
+def test_prompt_hidden_default_retry(runner):
+    @click.command()
+    @click.option("--value", default=42, prompt=True, show_default=False)
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="invalid\n\n", standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value == 42
+    assert result.output == (
+        "Value: invalid\nError: 'invalid' is not a valid integer.\nValue: \n"
+    )
+
+
 def test_secho(runner):
     with runner.isolation() as outstreams:
         click.secho(None, nl=False)
