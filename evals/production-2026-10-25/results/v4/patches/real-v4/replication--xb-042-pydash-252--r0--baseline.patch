diff --git a/src/pydash/arrays.py b/src/pydash/arrays.py
index 36cf0ef..e049031 100644
--- a/src/pydash/arrays.py
+++ b/src/pydash/arrays.py
@@ -111,7 +111,8 @@ MutableSequenceT = t.TypeVar("MutableSequenceT", bound=t.MutableSequence[t.Any])
 def chunk(array: t.Sequence[T], size: int = 1) -> t.List[t.Sequence[T]]:
     """
     Creates a list of elements split into groups the length of `size`. If `array` can't be split
-    evenly, the final chunk will be the remaining elements.
+    evenly, the final chunk will be the remaining elements. Returns an empty list if `array` is
+    empty or `size` is less than ``1``.
 
     Args:
         array: List to chunk.
@@ -127,6 +128,9 @@ def chunk(array: t.Sequence[T], size: int = 1) -> t.List[t.Sequence[T]]:
 
     .. versionadded:: 1.1.0
     """
+    if size < 1 or not array:
+        return []
+
     chunks = int(ceil(len(array) / float(size)))
     return [array[i * size : (i + 1) * size] for i in range(chunks)]
 
