+@parametrize("iteratee,key", [("", ""), (0, "0"), (False, "False")])
+def test_duplicates_falsey_property_iteratee(iteratee, key):
+    array = [
+        {key: "a", "id": 1},
+        {key: "b", "id": 2},
+        {key: "b", "id": 3},
+        {key: "a", "id": 4},
+        {key: "b", "id": 5},
+        {key: "b", "id": 3},
+    ]
+
+    result = _.duplicates(array, iteratee)
+
+    assert len(result) == 3
+    assert all(item is array[index] for item, index in zip(result, [2, 3, 4]))
+
+
+@parametrize("iteratee", [{}, ()])
+def test_duplicates_empty_matcher_iteratee(iteratee):
+    array = [{"id": 1}, {"id": 2}, {"id": 3}, {"id": 2}, {"id": 4}]
+
+    result = _.duplicates(array, iteratee)
+
+    assert len(result) == 3
+    assert all(item is array[index] for item, index in zip(result, [1, 2, 4]))
+
+
+@parametrize("raise_on_bool", [False, True])
+def test_duplicates_callable_does_not_evaluate_truthiness(raise_on_bool):
+    class Iteratee:
+        def __call__(self, item):
+            return item["group"]
+
+        def __bool__(self):
+            if raise_on_bool:
+                raise AssertionError("Iteratee truthiness must not be evaluated")
+            return False
+
+    array = [{"group": "a"}, {"group": "b"}, {"group": "b", "id": 1}, {"group": "a", "id": 2}]
+
+    result = _.duplicates(array, Iteratee())
+
+    assert len(result) == 2
+    assert result[0] is array[2]
+    assert result[1] is array[3]
+
