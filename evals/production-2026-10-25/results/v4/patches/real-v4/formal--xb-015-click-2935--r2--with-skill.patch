+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        (["outer", "inner"], "", ["leaf", "list"]),
+        (["outer", "inner"], "l", ["leaf", "list"]),
+        (["outer", "inner"], "--", ["--inner", "--help"]),
+        (["outer", "inner", "leaf"], "--", ["--leaf", "--help"]),
+        (["outer", "inner", "leaf", "--leaf"], "a", ["alpha"]),
+        (
+            ["outer", "--outer", "value", "inner", "--inner", "value", "leaf"],
+            "--",
+            ["--leaf", "--help"],
+        ),
+        (["outer", "inner", "missing"], "", ["leaf", "list"]),
+    ],
+)
+def test_nested_group(args, incomplete, expect):
+    inner = Group(
+        "inner",
+        params=[Option(["--inner"])],
+        commands=[
+            Command(
+                "leaf", params=[Option(["--leaf"], type=Choice(["alpha", "beta"]))]
+            ),
+            Command("list"),
+        ],
+    )
+    outer = Group("outer", params=[Option(["--outer"])], commands=[inner])
+    cli = Group("cli", params=[Option(["--root"])], commands=[outer])
+    assert _get_words(cli, args, incomplete) == expect
+
+
+@pytest.mark.parametrize("nested", [False, True])
+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        (["set"], "--", ["--set", "--help"]),
+        (["set", "--set", "value", "start"], "--", ["--start", "--help"]),
+        (["set", "--set", "value", "start", "--start"], "a", ["alpha"]),
+        (["set", "start", "finish"], "--", ["--finish", "--help"]),
+    ],
+)
+def test_chained_context(args, incomplete, expect, nested):
+    cli = Group(
+        "chain",
+        chain=True,
+        commands=[
+            Command("set", params=[Option(["--set"])]),
+            Command(
+                "start", params=[Option(["--start"], type=Choice(["alpha", "beta"]))]
+            ),
+            Command("finish", params=[Option(["--finish"])]),
+        ],
+    )
+    if nested:
+        cli = Group("cli", commands=[Group("outer", commands=[cli])])
+        args = ["outer", "chain", *args]
+
+    assert _get_words(cli, args, incomplete) == expect
+
