     def test_iter(self):
         """Make sure iter works as expected"""
-        self.spooled_flo.write(self.test_str)
+        self.spooled_flo.write(self.test_str_lines)
         self.spooled_flo.seek(0)
-        self.assertEqual([x for x in self.spooled_flo][0], self.test_str)
-        self.assertEqual([x for x in self.spooled_flo][0], self.data_type())
+        self.assertTrue(iter(self.spooled_flo) is self.spooled_flo)
+        self.assertEqual([x for x in self.spooled_flo],
+                         self.test_str_lines.splitlines(True))
+        self.assertEqual([x for x in self.spooled_flo], [])
+
+    def test_iter_empty(self):
+        """Empty streams stop immediately, in memory and on disk."""
+        for rolled in (False, True):
+            with type(self.spooled_flo)() as flo:
+                if rolled:
+                    flo.rollover()
+                self.assertEqual([line for line in flo], [])
+                self.assertRaises(StopIteration, next, flo)
+                self.assertRaises(StopIteration, flo.next)
+
+    def test_iter_lines(self):
+        """Keep blank lines and accept a final line without a newline."""
+        for rolled in (False, True):
+            for final_line in (self.test_str, self.test_str + self.linesep):
+                lines = [self.test_str + self.linesep,
+                         self.linesep, final_line]
+                with type(self.spooled_flo)() as flo:
+                    flo.write(self.data_type().join(lines))
+                    if rolled:
+                        flo.rollover()
+                    flo.seek(0)
+                    self.assertEqual([line for line in flo], lines)
+                    self.assertEqual([line for line in flo], [])
+
+    def test_iter_read_seek(self):
+        """Iteration shares the read cursor and remains usable after seek."""
+        first_line = self.test_str + self.linesep
+        for rolled in (False, True):
+            with type(self.spooled_flo)() as flo:
+                flo.write(first_line * 2 + self.test_str)
+                if rolled:
+                    flo.rollover()
+                flo.seek(0)
+                iterator = iter(flo)
+                self.assertEqual(next(iterator), first_line)
+                self.assertEqual(flo.tell(), len(first_line))
+                self.assertEqual(flo.read(1), self.test_str[:1])
+                self.assertEqual(flo.next(), first_line[1:])
+                self.assertEqual(flo.read(), self.test_str)
+                self.assertRaises(StopIteration, next, iterator)
+                flo.seek(0)
+                self.assertEqual(next(iterator), first_line)
+                self.assertEqual(flo.read(), first_line + self.test_str)
+            self.assertTrue(flo.closed)
+            self.assertRaises(ValueError, next, iterator)
 
