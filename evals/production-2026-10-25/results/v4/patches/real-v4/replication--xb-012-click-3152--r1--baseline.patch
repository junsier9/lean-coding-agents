+@pytest.mark.parametrize(
+    ("option_type", "default", "flag_value"),
+    [
+        (str, "default", "flag"),
+        (str, "default", ""),
+        (str, "", "flag"),
+        (str, None, "flag"),
+        (int, 42, 1),
+        (int, 42, 0),
+        (int, 0, 1),
+        (int, None, 1),
+        (int, UNSET, 1),
+    ],
+)
+@pytest.mark.parametrize(
+    ("args", "value_source"),
+    [
+        ([], "default"),
+        (["--opt"], "flag"),
+        (["-o"], "flag"),
+        (["--opt", "--other"], "flag"),
+        (["--opt", "2"], "explicit"),
+        (["--opt=2"], "explicit"),
+        (["-o2"], "explicit"),
+    ],
+)
+def test_option_with_optional_value_default(
+    runner, option_type, default, flag_value, args, value_source
+):
+    @click.command()
+    @click.option(
+        "-o",
+        "--opt",
+        is_flag=False,
+        flag_value=flag_value,
+        default=default,
+        type=option_type,
+    )
+    @click.option("--other", is_flag=True)
+    def cli(opt, other):
+        return opt
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    expected = {
+        "default": None if default is UNSET else default,
+        "flag": flag_value,
+        "explicit": option_type("2"),
+    }[value_source]
+    assert result.return_value == expected
+    assert type(result.return_value) is type(expected)
+
+
