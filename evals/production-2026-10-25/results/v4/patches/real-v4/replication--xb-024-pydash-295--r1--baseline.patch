+@parametrize("mapping_type", [dict, MappingProxyType])
+def test_reduce_mapping_without_accumulator(mapping_type):
+    collection = mapping_type({"a": 10, "b": 3, "c": 2})
+    calls = []
+
+    def subtract(accumulator, value, key):
+        calls.append((accumulator, value, key))
+        return accumulator - value
+
+    assert _.reduce_(collection, subtract) == 5
+    assert calls == [(10, 3, "b"), (7, 2, "c")]
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+@parametrize("value", [0, None, object()])
+def test_reduce_mapping_single_value(mapping_type, value):
+    def iteratee(*args):
+        pytest.fail("A singleton mapping must not call the iteratee")
+
+    assert _.reduce_(mapping_type({"only": value}), iteratee) is value
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+def test_reduce_empty_mapping(mapping_type):
+    collection = mapping_type({})
+
+    with pytest.raises(TypeError, match=r"^reduce_\(\) of empty sequence with no initial value$"):
+        _.reduce_(collection)
+
+    assert _.reduce_(collection, helpers.reduce_iteratee0, 0) == 0
+
