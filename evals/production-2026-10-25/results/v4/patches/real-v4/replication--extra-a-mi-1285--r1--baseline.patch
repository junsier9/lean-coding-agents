+    def test_missing_getitem(self):
+        for iterable in ([], [10, 20, 11]):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: 10 * (x // 10))
+                expected_keys = {10 * (x // 10) for x in iterable}
+                for value in (30, 40, 30):
+                    self.assertEqual(list(D[value]), [])
+                    self.assertEqual(set(D), expected_keys)
+
+                self.assertEqual(list(D[10]), [x for x in iterable if x < 20])
+                self.assertEqual(list(D[20]), [x for x in iterable if x >= 20])
+                self.assertEqual(set(D), expected_keys)
+
+    def test_missing_contains(self):
+        for iterable in ([], [10, 20, 11]):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: 10 * (x // 10))
+                expected_keys = {10 * (x // 10) for x in iterable}
+                for value in (30, 40, 30):
+                    self.assertNotIn(value, D)
+                    self.assertEqual(set(D), expected_keys)
+
+                self.assertEqual(list(D[10]), [x for x in iterable if x < 20])
+                self.assertEqual(list(D[20]), [x for x in iterable if x >= 20])
+                self.assertEqual(set(D), expected_keys)
+
+    def test_empty_buckets_remain(self):
+        D = mi.bucket([10, 20, 11, 21], key=lambda x: 10 * (x // 10))
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertEqual(list(D[20]), [20, 21])
+        for value in (10, 20):
+            self.assertNotIn(value, D)
+            self.assertEqual(list(D[value]), [])
+        self.assertEqual(set(D), {10, 20})
+
+    def test_partially_consumed_bucket(self):
+        D = mi.bucket([10, 20, 11], key=lambda x: 10 * (x // 10))
+        values = D[10]
+        self.assertEqual(next(values), 10)
+        self.assertEqual(list(D), [10, 20])
+        self.assertEqual(list(values), [11])
+        self.assertEqual(list(D[20]), [20])
+        self.assertEqual(list(D), [10, 20])
+
+    def test_repeated_contains_preserves_values(self):
+        D = mi.bucket([10, 20, 11], key=lambda x: 10 * (x // 10))
+        self.assertIn(10, D)
+        self.assertIn(10, D)
+        self.assertNotIn(30, D)
+        self.assertIn(10, D)
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertEqual(list(D[20]), [20])
+        self.assertEqual(set(D), {10, 20})
+
