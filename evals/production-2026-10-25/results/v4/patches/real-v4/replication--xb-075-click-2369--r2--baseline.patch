diff --git a/tests/test_commands.py b/tests/test_commands.py
index 3a0d4b9..e6de1bd 100644
--- a/tests/test_commands.py
+++ b/tests/test_commands.py
@@ -109,6 +109,25 @@ def test_help_truncation(runner):
     assert "This is a command with truncated help." in result.output
 
 
+@pytest.mark.parametrize("deprecated", [False, True])
+def test_help_truncation_empty_docstring(runner, deprecated):
+    @click.command(deprecated=deprecated)
+    def cli():
+        """\f
+        This text should be truncated.
+        """
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    expected = "Usage: cli [OPTIONS]\n\n"
+
+    if deprecated:
+        expected += "  (Deprecated)\n\n"
+
+    expected += "Options:\n  --help  Show this message and exit.\n"
+    assert result.output == expected
+
+
