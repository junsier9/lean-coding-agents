         # Checking in-ness shouldn't advance the iterator
         self.assertEqual(next(D[10]), 10)
 
+    def test_missing_lookup_does_not_add_key(self):
+        for iterable in ([], [10, 20, 11, 21]):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: 10 * (x // 10))
+                expected = {10 * (x // 10) for x in iterable}
+
+                for value in (30, 30, 40):
+                    self.assertEqual(list(D[value]), [])
+                    self.assertEqual(set(D), expected)
+
+                self.assertEqual(list(D[10]), [x for x in iterable if x < 20])
+                self.assertEqual(set(D), expected)
+
+    def test_missing_membership_does_not_add_key(self):
+        for iterable in ([], [10, 20, 11, 21]):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: 10 * (x // 10))
+                expected = {10 * (x // 10) for x in iterable}
+
+                for value in (30, 30, 40):
+                    self.assertNotIn(value, D)
+                    self.assertEqual(set(D), expected)
+
+                self.assertEqual(list(D[20]), [x for x in iterable if x >= 20])
+                self.assertEqual(set(D), expected)
+
+    def test_keys_after_partial_consumption(self):
+        D = mi.bucket([10, 20, 21], key=lambda x: 10 * (x // 10))
+
+        self.assertEqual(next(D[10]), 10)
+        self.assertEqual(set(D), {10, 20})
+        self.assertEqual(list(D[10]), [])
+        self.assertNotIn(10, D)
+        self.assertEqual(list(D[20]), [20, 21])
+        self.assertNotIn(20, D)
+        self.assertEqual(set(D), {10, 20})
+
+    def test_missing_keys_with_validator(self):
+        D = mi.bucket(
+            [10, 20, 11, 21],
+            key=lambda x: 10 * (x // 10),
+            validator=lambda x: x != 20,
+        )
+
+        self.assertEqual(list(D[30]), [])
+        self.assertNotIn(40, D)
+        self.assertEqual(set(D), {10})
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertNotIn(10, D)
+        self.assertEqual(set(D), {10})
+
+    def test_invalid_keys_do_not_advance_iterable(self):
+        iterable = iter([10, 20, 30])
+        D = mi.bucket(
+            iterable,
+            key=lambda x: 10 * (x // 10),
+            validator=lambda x: x != 20,
+        )
+
+        self.assertEqual(list(D[20]), [])
+        self.assertNotIn(20, D)
+        self.assertEqual(next(iterable), 10)
+        self.assertEqual(set(D), {30})
+
