+++ b/tests/test_funcutils_fb_py3.py
@@ -9,6 +9,32 @@ from boltons.funcutils import wraps, FunctionBuilder, update_wrapper
 import boltons.funcutils as funcutils
 
 
+@pytest.mark.parametrize('copy_dict', (True, False))
+def test_copy_function_kwonly_defaults(copy_dict):
+    func = lambda x, *, y=2: x * y
+    func_copy = funcutils.copy_function(func, copy_dict=copy_dict)
+
+    assert func_copy is not func
+    assert func_copy(21) == func(21) == 42
+    assert func_copy(21, y=3) == func(21, y=3) == 63
+    with pytest.raises(TypeError):
+        func_copy(21, 2)
+
+
+def test_copy_function_required_kwonly_arg():
+    default = []
+
+    def func(x=21, *, required, y=2, optional=None, shared=default):
+        return x * y, required, optional, shared
+
+    func_copy = funcutils.copy_function(func)
+
+    assert func_copy(required='value') == func(required='value')
+    assert func_copy(required='value')[3] is default
+    with pytest.raises(TypeError):
+        func_copy()
+
+
