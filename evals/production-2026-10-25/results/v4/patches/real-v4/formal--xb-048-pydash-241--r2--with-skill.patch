+from collections import deque
 import math
 
 import pytest
@@ -110,6 +111,89 @@ def test_drop_while(case, expected):
     assert _.drop_while(*case) == expected
 
 
+@parametrize("func", [_.take_while, _.drop_while])
+@parametrize("factory", [iter, lambda values: (value for value in values), deque])
+@parametrize("values", [[], [1, 2], [3, 1, 2], [1, 2, 3, 1]])
+def test_while_unsliceable_iterables(func, factory, values):
+    def predicate(value):
+        return value < 3
+
+    assert func(factory(values), predicate) == func(values, predicate)
+
+
+@parametrize("func,expected", [(_.take_while, [1, 2]), (_.drop_while, [3, 1])])
+def test_while_iterator_predicate_context(func, expected):
+    array = iter([1, 2, 3, 1])
+    calls = []
+
+    def predicate(value, index, collection):
+        assert collection is array
+        calls.append((value, index))
+        return value < 3
+
+    assert func(array=array, predicate=predicate) == expected
+    assert calls == [(1, 0), (2, 1), (3, 2)]
+
+
+def test_take_while_does_not_consume_remaining_iterator():
+    array = iter([1, 2, 3, 4])
+    assert _.take_while(array, lambda value: value < 3) == [1, 2]
+    assert list(array) == [4]
+
+
+@parametrize("func", [_.take_while, _.drop_while])
+def test_while_predicate_errors_propagate(func):
+    def predicate(value):
+        raise TypeError("predicate failed")
+
+    with pytest.raises(TypeError, match="predicate failed"):
+        func(iter([1]), predicate)
+
+
+@parametrize("func", [_.take_while, _.drop_while])
+def test_while_iterator_errors_propagate(func):
+    def values():
+        yield 1
+        raise RuntimeError("iterator failed")
+
+    with pytest.raises(RuntimeError, match="iterator failed"):
+        func(values(), lambda value: value < 3)
+
+
+def test_drop_while_remaining_iterator_errors_propagate():
+    def values():
+        yield 1
+        yield 3
+        raise TypeError("remaining iterator failed")
+
+    with pytest.raises(TypeError, match="remaining iterator failed"):
+        _.drop_while(values(), lambda value: value < 3)
+
+
+@parametrize("func", [_.take_while, _.drop_while])
+@parametrize("case", [([1, 2, 0, 3],), ([{"active": True}, {"active": False}], "active")])
+def test_while_iterator_predicate_forms(func, case):
+    values, *args = case
+    expected = func(values, *args)
+    assert func(iter(values), *args) == expected
+    assert getattr(_.chain(iter(values)), func.__name__)(*args).value() == expected
+
+
+@parametrize("func", [_.take_while, _.drop_while])
+@parametrize("array", [None, 1])
+def test_while_invalid_input(func, array):
+    with pytest.raises(TypeError):
+        func(array)
+
+
+@parametrize("func,start,end", [(_.take_while, 0, 2), (_.drop_while, 2, None)])
+@parametrize("array", [[1, 2, 3, 4], (1, 2, 3, 4), "1234", range(1, 5)])
+def test_while_preserves_slice_type(func, start, end, array):
+    result = func(array, lambda value, index: index < 2)
+    assert result == array[start:end]
+    assert type(result) is type(array)
+
