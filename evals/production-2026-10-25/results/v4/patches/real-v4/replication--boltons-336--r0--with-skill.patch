+@pytest.mark.parametrize('copy_dict', (True, False))
+def test_copy_function_kwonly_defaults(copy_dict):
+    callee = lambda x, *, y=2: x * y
+    callee.custom = 'attribute'
+
+    callee_copy = funcutils.copy_function(callee, copy_dict=copy_dict)
+
+    assert callee_copy is not callee
+    assert inspect.signature(callee_copy) == inspect.signature(callee)
+    assert callee_copy(21) == callee(21) == 42
+    assert callee_copy(x=21) == callee(x=21) == 42
+    assert callee_copy(21, y=3) == callee(21, y=3) == 63
+    assert callee_copy.__dict__ == (callee.__dict__ if copy_dict else {})
+
+    with pytest.raises(TypeError):
+        callee_copy(21, 3)
+
+
+@pytest.mark.parametrize('optional_default', (False, True))
+def test_copy_function_required_kwonly(optional_default):
+    if optional_default:
+        def callee(x=21, *, y, z=2):
+            return x * y * z
+    else:
+        def callee(x=21, *, y):
+            return x * y
+
+    callee_copy = funcutils.copy_function(callee)
+
+    assert inspect.signature(callee_copy) == inspect.signature(callee)
+    assert callee_copy(y=2) == callee(y=2)
+    with pytest.raises(TypeError):
+        callee_copy()
+
+
+def test_copy_function_method_kwonly_defaults():
+    class Multiplier:
+        factor = 1
+
+        def multiply(instance, x=21, *, y=2):
+            return instance.factor * x * y
+
+        multiply_copy = funcutils.copy_function(multiply)
+
+    multiplier = Multiplier()
+    assert multiplier.multiply_copy() == multiplier.multiply() == 42
+    assert multiplier.multiply_copy(y=3) == multiplier.multiply(y=3) == 63
+    assert Multiplier.multiply_copy(instance=multiplier) == 42
+
