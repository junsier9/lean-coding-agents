 from boltons import ioutils
 
@@ -449,6 +452,151 @@ class TestSpooledStringIO(TestCase, BaseTestMixin, AssertionsMixin):
         self.assertEqual(self.spooled_flo.getvalue(), expected)
 
 
+@pytest.mark.parametrize('max_size', [1, 100])
+@pytest.mark.parametrize('stream_type, value', [
+    (ioutils.SpooledBytesIO, b'abc'),
+    (ioutils.SpooledStringIO, 'a\u4e2d\U0001f600'),
+])
+def test_spooled_write_counts(stream_type, value, max_size):
+    with stream_type(max_size=max_size) as stream:
+        assert stream.write(value) == len(value)
+        assert stream.tell() == len(value)
+        assert stream_type.write(self=stream, s=value) == len(value)
+        assert stream.write(value[:0]) == 0
+        assert stream.tell() == 2 * len(value)
+        assert stream.getvalue() == value * 2
+        assert stream._rolled == (max_size == 1)
+    with pytest.raises(ValueError):
+        stream.write(value)
+
+
+def test_spooled_string_rollover_uses_encoded_bytes():
+    with ioutils.SpooledStringIO(max_size=7) as stream:
+        assert stream.write('\u4e2d') == 1
+        assert not stream._rolled
+        assert stream.write('\U0001f600') == 1
+        assert stream._rolled
+        assert stream.tell() == 2
+        assert stream.getvalue() == '\u4e2d\U0001f600'
+
+
+@pytest.mark.parametrize('max_size', [1, 100])
+@pytest.mark.parametrize('value', [
+    bytearray(b'abcd'),
+    memoryview(b'abcd'),
+    array('I', [1, 2]),
+    memoryview(array('I', [1, 2])),
+    memoryview(b'abcd').cast('B', shape=[2, 2]),
+    memoryview(b'abcd')[1:3],
+])
+def test_spooled_bytes_write_buffers(value, max_size):
+    expected = memoryview(value).tobytes()
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        assert stream.write(value) == len(expected)
+        assert stream.write(value) == len(expected)
+        assert stream.tell() == 2 * len(expected)
+        assert stream.getvalue() == expected * 2
+        assert stream._rolled == (max_size == 1)
+
+
+def test_spooled_bytes_rollover_uses_buffer_nbytes():
+    value = memoryview(array('I', [1, 2]))
+    with ioutils.SpooledBytesIO(max_size=1 + value.nbytes) as stream:
+        assert stream.write(b'x') == 1
+        assert not stream._rolled
+        assert stream.write(value) == value.nbytes
+        assert stream._rolled
+        assert stream.getvalue() == b'x' + value.tobytes()
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('value, error', [
+    ('text', TypeError),
+    (123, TypeError),
+    ([1, 2], TypeError),
+    (memoryview(b'abcd')[::2], BufferError),
+])
+def test_spooled_bytes_invalid_write_preserves_state(value, error, rolled):
+    with ioutils.SpooledBytesIO(max_size=5) as stream:
+        stream.write(b'abcd')
+        if rolled:
+            stream.rollover()
+        with pytest.raises(error):
+            stream.write(value)
+        assert stream.tell() == 4
+        assert stream.getvalue() == b'abcd'
+        assert stream._rolled == rolled
+
+
+@pytest.mark.parametrize('max_size', [1, 100])
+def test_spooled_bytes_buffered_writer(max_size):
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        with io.BufferedWriter(stream, buffer_size=16) as writer:
+            assert writer.write(b'abcd') == 4
+            writer.flush()
+            assert stream.getvalue() == b'abcd'
+            assert writer.write(bytearray(b'ef')) == 2
+            writer.flush()
+            assert stream.getvalue() == b'abcdef'
+            assert stream._rolled == (max_size == 1)
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('repeats', [1, ioutils.READ_CHUNK_SIZE // 5 + 2])
+def test_spooled_string_seek_codepoints(rolled, repeats):
+    value = 'a\u4e2d\U0001f600\u00e9z' * repeats
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(value)
+        if rolled:
+            stream.rollover()
+        assert stream.seek(len(value)) == len(value)
+        assert stream.seek(-3, os.SEEK_CUR) == len(value) - 3
+        assert stream.read(2) == value[-3:-1]
+        assert stream.seek(1) == 1
+        assert stream.read(1) == value[1]
+        assert stream.seek(1, os.SEEK_CUR) == 3
+        assert stream.read(1) == value[3]
+        assert stream.seek(-2, os.SEEK_END) == len(value) - 2
+        assert stream.read() == value[-2:]
+        assert stream.seek(2, os.SEEK_END) == len(value) + 2
+        assert stream.read() == ''
+        assert stream.tell() == len(value) + 2
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('offset, whence', [
+    (-1, os.SEEK_SET), (-3, os.SEEK_CUR), (-6, os.SEEK_END), (0, 99),
+])
+def test_spooled_string_invalid_seek_preserves_state(rolled, offset, whence):
+    value = '\U0001f600x\u4e2dy\u00e9'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(value)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(2) == value[:2]
+        byte_position = stream.buffer.tell()
+        with pytest.raises(ValueError):
+            stream.seek(offset, whence)
+        assert stream.tell() == 2
+        assert stream.buffer.tell() == byte_position
+        assert stream.read() == value[2:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_string_length_preserves_position(rolled):
+    value = '\U0001f600x\u4e2dy\u00e9'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(value)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(2) == value[:2]
+        assert len(stream) == len(value)
+        assert stream.tell() == 2
+        assert stream.read() == value[2:]
+
+
