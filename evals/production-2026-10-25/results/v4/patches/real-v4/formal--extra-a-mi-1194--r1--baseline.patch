diff --git a/tests/test_recipes.py b/tests/test_recipes.py
index 15d54fc..b8b626f 100644
--- a/tests/test_recipes.py
+++ b/tests/test_recipes.py
@@ -72,6 +72,28 @@ class TabulateTests(TestCase):
 class TailTests(TestCase):
     """Tests for ``tail()``"""
 
+    def test_negative(self):
+        """Negative tail lengths are invalid for every input type."""
+        for n in (-1, -3):
+            for seq in ('', 'ABCDEFG', [], list(range(7)), range(7)):
+                for iterable in (seq, iter(seq)):
+                    with self.subTest(n=n, iterable=iterable):
+                        self.assertRaises(ValueError, mi.tail, n, iterable)
+
+    def test_zero(self):
+        """A zero-length tail is empty for sized inputs and iterators."""
+        for seq in ('', 'ABCDEFG', [], list(range(7)), range(7)):
+            for iterable in (seq, iter(seq)):
+                with self.subTest(iterable=iterable):
+                    self.assertEqual(list(mi.tail(0, iterable)), [])
+
+    def test_empty(self):
+        """Positive tail lengths preserve empty input results."""
+        for seq in ('', [], (), range(0)):
+            for iterable in (seq, iter(seq)):
+                with self.subTest(iterable=iterable):
+                    self.assertEqual(list(mi.tail(3, iterable)), [])
+
     def test_iterator_greater(self):
         """Length of iterator is greater than requested tail"""
         self.assertEqual(list(mi.tail(3, iter('ABCDEFG'))), list('EFG'))
