     assert _get_words(cli, [], "-") == ["-a", "--help"]
 
 
+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        (["outer"], "", ["inner", "other"]),
+        (["outer"], "--", ["--outer", "--help"]),
+        (["outer", "inner"], "", ["run"]),
+        (["outer", "inner"], "--", ["--inner", "--help"]),
+        (["outer", "--outer", "x", "inner"], "--", ["--inner", "--help"]),
+        (["outer", "inner", "--inner", "x", "run"], "--", ["--format", "--help"]),
+        (["outer", "inner", "run", "--format"], "j", ["json"]),
+        (["outer", "inner", "run", "--format=json"], "--", ["--help"]),
+        (["outer", "inner", "run"], "", ["all", "selected"]),
+    ],
+)
+def test_nested_group(args, incomplete, expect):
+    cli = Group(
+        "cli",
+        params=[Option(["--root"])],
+        commands=[
+            Group(
+                "outer",
+                params=[Option(["--outer"])],
+                commands=[
+                    Group(
+                        "inner",
+                        params=[Option(["--inner"])],
+                        commands=[
+                            Command(
+                                "run",
+                                params=[
+                                    Option(["--format"], type=Choice(["text", "json"])),
+                                    Argument(["target"], type=Choice(["all", "selected"])),
+                                ],
+                            )
+                        ],
+                    ),
+                    Command("other"),
+                ],
+            ),
+            Command("root-command"),
+        ],
+    )
+    assert _get_words(cli, args, incomplete) == expect
+
+
