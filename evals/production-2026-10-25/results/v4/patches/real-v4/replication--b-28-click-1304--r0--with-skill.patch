+@pytest.mark.parametrize('envvar', [
+    'TEST_PATH', ['TEST_PATH'], ('TEST_PATH',), None,
+])
+@pytest.mark.parametrize('value, exit_code, output', [
+    (None, 0, 'path=None\n'),
+    ('', 0, 'path=None\n'),
+    ('.', 0, 'path=.\n'),
+    ('missing-path', 2,
+     'Error: Invalid value for "--path": Path "missing-path" does not exist.\n'),
+    (' ', 2,
+     'Error: Invalid value for "--path": Path " " does not exist.\n'),
+])
+def test_path_envvar(runner, envvar, value, exit_code, output):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar)
+    def cmd(path):
+        click.echo('path=%s' % path)
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST',
+                           env={'TEST_PATH': value})
+    assert result.exit_code == exit_code
+    assert result.output.endswith(output)
+
+
+@pytest.mark.parametrize('envvar', [
+    'TEST_PATH', ['TEST_PATH'], ('TEST_PATH',), None,
+])
+@pytest.mark.parametrize('option_kwargs, expected', [
+    ({'default': '.'}, '.'),
+    ({'default': ('.',), 'multiple': True}, "('.',)"),
+    ({'default': ('.', 'click'), 'nargs': 2}, "('.', 'click')"),
+])
+def test_empty_path_envvar_default(runner, envvar, option_kwargs, expected):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar,
+                  **option_kwargs)
+    def cmd(path):
+        click.echo(path)
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST',
+                           env={'TEST_PATH': ''})
+    assert result.exit_code == 0
+    assert result.output == expected + '\n'
+
+
+@pytest.mark.parametrize('envvar, expected', [
+    ('EMPTY_PATH', 'click'),
+    (['EMPTY_PATH', 'FALLBACK_PATH'], '.'),
+    (('EMPTY_PATH', 'FALLBACK_PATH'), '.'),
+])
+def test_empty_path_envvar_fallback(runner, envvar, expected):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar)
+    def cmd(path):
+        click.echo(path)
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST', env={
+        'EMPTY_PATH': '', 'FALLBACK_PATH': '.', 'TEST_PATH': 'click',
+    })
+    assert result.exit_code == 0
+    assert result.output == expected + '\n'
+
+
+def test_empty_path_envvar_required(runner):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar='TEST_PATH',
+                  required=True)
+    def cmd(path):
+        pytest.fail('A required path was not provided.')
+
+    result = runner.invoke(cmd, [], env={'TEST_PATH': ''})
+    assert result.exit_code == 2
+    assert 'Missing option "--path".' in result.output
+
+
