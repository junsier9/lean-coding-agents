@@ -215,6 +215,86 @@ def test_toupper_envvar_prefix(runner):
     assert result.output == 'foo\n'
 
 
+@pytest.mark.parametrize('envvar', [
+    'TEST_ARG', ['TEST_ARG', 'TEST_OTHER'],
+    ('TEST_ARG', 'TEST_OTHER'), None,
+])
+@pytest.mark.parametrize('default', [None, '.'])
+def test_empty_envvar_path(runner, envvar, default):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar=envvar,
+                  default=default)
+    def cmd(arg):
+        click.echo(repr(arg))
+
+    for value in (None, ''):
+        result = runner.invoke(cmd, [], auto_envvar_prefix='TEST',
+                               env={'TEST_ARG': value, 'TEST_OTHER': value})
+        assert result.exit_code == 0
+        assert result.output == '%r\n' % default
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST',
+                           env={'TEST_ARG': '', 'TEST_OTHER': ''},
+                           default_map={'arg': '.'})
+    assert result.exit_code == 0
+    assert result.output == "'.'\n"
+
+
+@pytest.mark.parametrize('envvar,env', [
+    (['TEST_ARG', 'TEST_OTHER'], {'TEST_ARG': '', 'TEST_OTHER': '.'}),
+    (('TEST_ARG', 'TEST_OTHER'), {'TEST_ARG': '', 'TEST_OTHER': '.'}),
+    ('TEST_EXPLICIT', {'TEST_EXPLICIT': '', 'TEST_ARG': '.'}),
+    (['TEST_FIRST', 'TEST_OTHER'],
+     {'TEST_FIRST': '', 'TEST_OTHER': '', 'TEST_ARG': '.'}),
+])
+def test_empty_envvar_path_fallback(runner, envvar, env):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar=envvar)
+    def cmd(arg):
+        click.echo(arg)
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST', env=env)
+    assert result.exit_code == 0
+    assert result.output == '.\n'
+
+
+@pytest.mark.parametrize('envvar', [
+    'TEST_ARG', ['TEST_ARG', 'TEST_OTHER'], None,
+])
+@pytest.mark.parametrize('args,value', [
+    ([], 'missing-envvar-path'), ([], ' '), ([], '0'),
+    (['--arg', ''], '.'),
+])
+def test_envvar_path_validation(runner, envvar, args, value):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar=envvar)
+    def cmd(arg):
+        pytest.fail('Invalid paths must not reach the command.')
+
+    result = runner.invoke(cmd, args, auto_envvar_prefix='TEST',
+                           env={'TEST_ARG': value, 'TEST_OTHER': '.'})
+    assert result.exit_code == 2
+    assert 'Invalid value for "--arg"' in result.output
+    assert 'does not exist' in result.output
+
+
+@pytest.mark.parametrize('prompt', [False, True])
+def test_empty_envvar_required_path(runner, prompt):
+    @click.command()
+    @click.option('--arg', type=click.Path(exists=True), envvar='TEST_ARG',
+                  required=True, prompt=prompt)
+    def cmd(arg):
+        click.echo(arg)
+
+    result = runner.invoke(cmd, [], env={'TEST_ARG': ''}, input='.\n')
+    if prompt:
+        assert result.exit_code == 0
+        assert result.output == 'Arg: .\n.\n'
+    else:
+        assert result.exit_code == 2
+        assert 'Missing option "--arg"' in result.output
+
+
