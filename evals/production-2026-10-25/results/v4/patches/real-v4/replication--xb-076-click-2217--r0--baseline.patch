+@pytest.mark.parametrize("chain", [False, True])
+@pytest.mark.parametrize("group_result", [None, 42, 0, False, "", [], {}])
+def test_no_command_result_callback_return_value(runner, chain, group_result):
+    @click.group(invoke_without_command=True, chain=chain)
+    @click.option("--value", type=int)
+    def cli(value):
+        assert value == 23
+        return group_result
+
+    @cli.result_callback()
+    def process_result(result, value):
+        assert value == 23
+        if chain:
+            assert result == []
+        else:
+            assert result is group_result
+        click.echo(str(result), nl=False)
+        return "processed"
+
+    result = runner.invoke(cli, ["--value", "23"], standalone_mode=False)
+    assert result.exception is None
+    assert result.output == str([] if chain else group_result)
+    assert result.return_value == "processed"
+
+
+@pytest.mark.parametrize("chain", [False, True])
+def test_no_command_return_value(runner, chain):
+    group_result = object()
+
+    @click.group(invoke_without_command=True, chain=chain)
+    def cli():
+        return group_result
+
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert result.exception is None
+    if chain:
+        assert result.return_value == []
+    else:
+        assert result.return_value is group_result
+
+
+@pytest.mark.parametrize(
+    ("chain", "args", "expect"),
+    [(False, ["first"], 1), (True, ["first", "second"], [1, 2])],
+)
+def test_subcommand_result_callback(runner, chain, args, expect):
+    @click.group(invoke_without_command=True, chain=chain)
+    def cli():
+        return "group result"
+
+    @cli.command()
+    def first():
+        return 1
+
+    @cli.command()
+    def second():
+        return 2
+
+    @cli.result_callback()
+    def process_result(result):
+        assert result == expect
+        return "processed", result
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == ("processed", expect)
+
+
