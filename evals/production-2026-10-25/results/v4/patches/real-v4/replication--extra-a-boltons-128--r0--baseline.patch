diff --git a/tests/test_mathutils.py b/tests/test_mathutils.py
index e5b536d..6d2ca19 100644
--- a/tests/test_mathutils.py
+++ b/tests/test_mathutils.py
@@ -1,6 +1,78 @@
 
-from pytest import raises
-from boltons.mathutils import ceil, floor
+from math import isnan
+
+from pytest import mark, raises
+from boltons.mathutils import ceil, clamp, floor
+
+
+@mark.parametrize('x', [-5, 0, 5, float('-inf'), float('inf'), 10 ** 1000])
+def test_clamp_unbounded(x):
+    assert clamp(x) is x
+    assert clamp(x, None, None) is x
+
+
+@mark.parametrize('x, expected', [(-5, 0), (0, 0), (5, 5)])
+def test_clamp_lower_only(x, expected):
+    assert clamp(x, 0) == expected
+    assert clamp(x, lower=0, upper=None) == expected
+
+
+@mark.parametrize('x, expected', [(-5, -5), (0, 0), (5, 0)])
+def test_clamp_upper_only(x, expected):
+    assert clamp(x, upper=0) == expected
+    assert clamp(x, None, 0) == expected
+
+
+@mark.parametrize('x, expected', [(-5, 0), (0, 0), (2.5, 2.5),
+                                 (5, 5), (10, 5)])
+def test_clamp_bounded(x, expected):
+    assert clamp(x, 0, 5) == expected
+    assert clamp(x, 3, 3) == 3
+
+
+def test_clamp_invalid_bounds():
+    with raises(ValueError):
+        clamp(2, 5, 0)
+
+
+def test_clamp_infinities():
+    pos_inf, neg_inf = float('inf'), float('-inf')
+    assert clamp(pos_inf, lower=0) == pos_inf
+    assert clamp(neg_inf, upper=0) == neg_inf
+    assert clamp(neg_inf, lower=0) == 0
+    assert clamp(pos_inf, upper=0) == 0
+    assert clamp(neg_inf, 0, 5) == 0
+    assert clamp(pos_inf, 0, 5) == 5
+    assert clamp(2.5, neg_inf, pos_inf) == 2.5
+    assert clamp(pos_inf, pos_inf, pos_inf) == pos_inf
+    assert clamp(neg_inf, neg_inf, neg_inf) == neg_inf
+    with raises(ValueError):
+        clamp(0, pos_inf, neg_inf)
+
+
+@mark.parametrize('x', [10 ** 1000, -(10 ** 1000)])
+def test_clamp_large_integers(x):
+    assert clamp(x, lower=x - 1) is x
+    assert clamp(x, upper=x + 1) is x
+    assert clamp(x, x - 1, x + 1) is x
+    assert clamp(x, lower=x + 1) == x + 1
+    assert clamp(x, upper=x - 1) == x - 1
+    assert clamp(x, float('-inf'), float('inf')) is x
+
+
+@mark.parametrize('bounds', [{}, {'lower': 0}, {'upper': 5},
+                             {'lower': 0, 'upper': 5}])
+def test_clamp_nan_value(bounds):
+    assert isnan(clamp(float('nan'), **bounds))
+
+
+def test_clamp_nan_bounds():
+    nan = float('nan')
+    assert clamp(2.5, lower=nan) == 2.5
+    assert clamp(2.5, upper=nan) == 2.5
+    assert clamp(2.5, nan, nan) == 2.5
+    assert clamp(10, nan, 5) == 5
+    assert clamp(-5, 0, nan) == 0
 
 
