+@pytest.mark.parametrize('stream_type', [ioutils.SpooledBytesIO,
+                                       ioutils.SpooledStringIO])
+@pytest.mark.parametrize('rolled', [False, True], ids=['memory', 'disk'])
+@pytest.mark.parametrize('text', [u'', u'\n', u'\nfirst\n\nlast\n',
+                                 u'first\r\n\nlast', u'\u4e2d\u6587\n\n\u2014\u00e9'],
+                         ids=['empty', 'newline', 'blank-lines',
+                              'unterminated', 'unicode'])
+def test_spooled_line_iteration(stream_type, rolled, text):
+    content = (text.encode('utf-8')
+               if stream_type is ioutils.SpooledBytesIO else text)
+    expected = content.splitlines(True)
+    with stream_type() as stream:
+        stream.write(content)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert iter(stream) is stream
+        assert list(stream) == expected
+        assert list(stream) == []
+        with pytest.raises(StopIteration):
+            next(stream)
+        with pytest.raises(StopIteration):
+            stream.next()
+        assert stream.readline() == content[:0]
+        assert stream.read() == content[:0]
+        stream.seek(0)
+        assert list(stream) == expected
+    assert stream.closed
+
+
+@pytest.mark.parametrize('stream_type', [ioutils.SpooledBytesIO,
+                                       ioutils.SpooledStringIO])
+@pytest.mark.parametrize('rolled', [False, True], ids=['memory', 'disk'])
+def test_spooled_iteration_shares_read_seek_position(stream_type, rolled):
+    text = u'\u2014abc\n\nsecond\nlast'
+    content = (text.encode('utf-8')
+               if stream_type is ioutils.SpooledBytesIO else text)
+    lines = content.splitlines(True)
+    with stream_type() as stream:
+        stream.write(content)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        iterator = iter(stream)
+        assert stream.read(1) == content[:1]
+        assert next(iterator) == lines[0][1:]
+        assert stream.tell() == len(lines[0])
+        assert stream.next() == lines[1]
+        assert stream.readline() == lines[2]
+        assert next(stream) == lines[3]
+        assert stream.tell() == len(content)
+        with pytest.raises(StopIteration):
+            next(iterator)
+        with pytest.raises(StopIteration):
+            stream.next()
+        stream.seek(1)
+        assert next(iterator) == lines[0][1:]
+        stream.seek(0)
+        assert stream.read() == content
+    assert stream.closed
+
+
