 class ZipBroadcastTests(TestCase):
+    class OneShotIterable:
+        def __init__(self, iterable):
+            self.iterator = iter(iterable)
+            self.iter_calls = 0
+
+        def __iter__(self):
+            self.iter_calls += 1
+            if self.iter_calls > 1:
+                raise RuntimeError('Iterator already requested')
+            return self.iterator
+
+    class OneShotIterator(OneShotIterable):
+        def __iter__(self):
+            super().__iter__()
+            return self
+
+        def __next__(self):
+            return next(self.iterator)
+
+    def test_one_shot_iterables(self):
+        for cls, values, strict in product(
+            (self.OneShotIterable, self.OneShotIterator),
+            ([], [1], [1, 2, 3]),
+            (False, True),
+        ):
+            with self.subTest(cls=cls, values=values, strict=strict):
+                expected = list(zip(cls(values), strict=strict))
+                obj = cls(values)
+                self.assertEqual(
+                    list(mi.zip_broadcast(obj, strict=strict)), expected
+                )
+                self.assertEqual(obj.iter_calls, 1)
+
+    def test_one_shot_iterables_with_scalars(self):
+        for cls, values, strict in product(
+            (self.OneShotIterable, self.OneShotIterator),
+            ([], [1], [1, 2, 3]),
+            (False, True),
+        ):
+            with self.subTest(cls=cls, values=values, strict=strict):
+                left, right = cls(values), cls(values)
+                expected = [
+                    (0, x, 'ab', b'ab', y, None) for x, y in zip(values, values)
+                ]
+                self.assertEqual(
+                    list(
+                        mi.zip_broadcast(
+                            0, left, 'ab', b'ab', right, None, strict=strict
+                        )
+                    ),
+                    expected,
+                )
+                self.assertEqual(left.iter_calls, 1)
+                self.assertEqual(right.iter_calls, 1)
+
+    def test_one_shot_iterables_unequal_lengths(self):
+        for cls, values, strict in product(
+            (self.OneShotIterable, self.OneShotIterator),
+            (([], [1]), ([1], []), ([1], [2, 3]), ([1, 2], [3])),
+            (False, True),
+        ):
+            with self.subTest(cls=cls, values=values, strict=strict):
+                left, right = map(cls, values)
+                result = mi.zip_broadcast(left, '_', right, strict=strict)
+                for x, y in zip(*values):
+                    self.assertEqual(next(result), (x, '_', y))
+                if strict:
+                    with self.assertRaises(ValueError):
+                        next(result)
+                else:
+                    self.assertEqual(list(result), [])
+                self.assertEqual(left.iter_calls, 1)
+                self.assertEqual(right.iter_calls, 1)
+
+    def test_one_shot_scalar_type(self):
+        for cls, values, strict in product(
+            (self.OneShotIterable, self.OneShotIterator),
+            ([], [1, 2]),
+            (False, True),
+        ):
+            with self.subTest(cls=cls, values=values, strict=strict):
+                obj = cls(values)
+                self.assertEqual(
+                    list(
+                        mi.zip_broadcast(
+                            obj, [3, 4], scalar_types=cls, strict=strict
+                        )
+                    ),
+                    [(obj, 3), (obj, 4)],
+                )
+                self.assertEqual(obj.iter_calls, 0)
+
