--- a/src/pydash/helpers.py
+++ b/src/pydash/helpers.py
@@ -61,6 +61,12 @@ def getargcount(iteratee, maxargs):
     if isinstance(iteratee, type) or pyd.is_builtin(iteratee):
         # Only pass single argument to type iteratees or builtins.
         argcount = 1
+    elif maxargs is not None and any(
+        iteratee is func for func in (pyd.ceil, pyd.floor, pyd.round_)
+    ):
+        # Use default precision for rounding iteratees, but keep the full argument
+        # count when function wrappers inspect them without a callback argument limit.
+        argcount = 1
     else:
         argcount = 1
 
