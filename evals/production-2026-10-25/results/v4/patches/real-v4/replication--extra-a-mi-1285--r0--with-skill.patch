+    def test_missing_bucket_does_not_add_key(self):
+        for iterable, keys in (([], []), ([10, 20, 11], [10, 20])):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: 10 * (x // 10))
+                self.assertEqual(list(D[40]), [])
+                self.assertEqual(list(D), keys)
+                self.assertEqual(list(D[50]), [])
+                self.assertEqual(list(D), keys)
+                self.assertEqual(list(D[10]), iterable[::2])
+                self.assertEqual(list(D[20]), iterable[1::2])
+                self.assertEqual(list(D), keys)
+
+    def test_missing_membership_does_not_add_key(self):
+        for iterable, keys in (([], []), ([10, 20, 11], [10, 20])):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: 10 * (x // 10))
