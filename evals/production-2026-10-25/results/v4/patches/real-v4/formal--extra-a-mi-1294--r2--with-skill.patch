+    def test_maxlen_zero_peek(self):
+        iterable = [None, False, 0, [], object()]
+        s = mi.seekable(iterable, maxlen=0)
+        elements = s.elements()
+        for item in iterable:
+            self.assertTrue(s)
+            self.assertIs(s.peek(), item)
+            self.assertIs(s.peek(), item)
+            self.assertEqual(list(elements), [])
+            with self.assertRaises(IndexError):
+                s[0]
+            self.assertIs(next(s), item)
+            self.assertEqual(list(elements), [])
+
+        self.assertFalse(s)
+        default = object()
+        self.assertIs(s.peek(default), default)
+        with self.assertRaises(StopIteration):
+            s.peek()
+        self.assertEqual(list(elements), [])
+
+    def test_maxlen_zero_peek_bounded_memory(self):
+        item = object()
+        s = mi.seekable([item], maxlen=0)
+        for _ in range(100):
+            self.assertIs(s.peek(), item)
+            self.assertTrue(s)
+
+        tracemalloc.start()
+        try:
+            before = tracemalloc.get_traced_memory()[0]
+            for _ in range(10000):
+                self.assertIs(s.peek(), item)
+                self.assertTrue(s)
+            growth = tracemalloc.get_traced_memory()[0] - before
+        finally:
+            tracemalloc.stop()
+
+        # Allow allocator noise, but reject storage growing with every call.
+        self.assertLess(growth, 64 * 1024)
+        self.assertEqual(list(s), [item])
+        self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_seek_after_peek(self):
+        iterable = list(range(5))
+        for method in ('seek', 'relative_seek'):
+            for offset in (0, 1, 3, 10):
+                with self.subTest(method=method, offset=offset):
+                    s = mi.seekable(iterable, maxlen=0)
+                    self.assertEqual(s.peek(), 0)
+                    getattr(s, method)(offset)
+                    self.assertEqual(list(s), iterable[offset:])
+                    self.assertEqual(list(s.elements()), [])
+
+        s = mi.seekable(iterable, maxlen=0)
+        self.assertEqual(s.peek(), 0)
+        s.relative_seek(1)
+        s.relative_seek(1)
+        self.assertEqual(list(s), iterable[2:])
+        s.relative_seek(-10)
+        self.assertEqual(list(s), [])
+
+    def test_maxlen_zero_peek_source_error(self):
+        def source():
+            yield 1
+            raise RuntimeError('source failed')
+
+        for operation in (mi.seekable.peek, bool, next):
+            with self.subTest(operation=operation):
+                s = mi.seekable(source(), maxlen=0)
+                self.assertEqual(s.peek(), 1)
+                self.assertEqual(next(s), 1)
+                with self.assertRaisesRegex(RuntimeError, 'source failed'):
+                    operation(s)
+                self.assertFalse(s)
+
