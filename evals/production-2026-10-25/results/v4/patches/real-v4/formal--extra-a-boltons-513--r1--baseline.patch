+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('stream_type, values', [
+    (ioutils.SpooledBytesIO, [b'a\x00b', b'', b'cd']),
+    (ioutils.SpooledStringIO, ['a\u2014\U0001f642', '', '\u00e9\n']),
+])
+def test_spooled_write_counts(rolled, stream_type, values):
+    with stream_type() as stream:
+        if rolled:
+            stream.rollover()
+        for value in values:
+            assert stream.write(value) == len(value)
+        assert stream.tell() == sum(map(len, values))
+        assert stream.getvalue() == values[0][:0].join(values)
+
+
+@pytest.mark.parametrize('stream_type, value', [
+    (ioutils.SpooledBytesIO, b'abcd'),
+    (ioutils.SpooledStringIO, '\u2014\U0001f642'),
+])
+def test_spooled_write_count_on_rollover(stream_type, value):
+    with stream_type(max_size=4) as stream:
+        assert stream.write(value) == len(value)
+        assert stream._rolled
+        assert stream.getvalue() == value
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('value', [
+    b'abcd',
+    bytearray(b'abcd'),
+    memoryview(b'abcd'),
+    array('I', [1, 2]),
+    memoryview(array('I', [1, 2])),
+    memoryview(b'abcdefgh').cast('B', (2, 4)),
+])
+def test_spooled_bytes_write_buffers(rolled, value):
+    expected = io.BytesIO()
+    count = expected.write(value)
+    with ioutils.SpooledBytesIO() as stream:
+        if rolled:
+            stream.rollover()
+        assert stream.write(value) == count
+        assert stream.tell() == count
+        assert stream.getvalue() == expected.getvalue()
+
+
+@pytest.mark.parametrize('extra_space', [0, 1])
+@pytest.mark.parametrize('value', [
+    memoryview(array('I', [1, 2])),
+    memoryview(b'abcdefgh').cast('B', (2, 4)),
+])
+def test_spooled_bytes_buffer_rollover_uses_byte_count(extra_space, value):
+    with ioutils.SpooledBytesIO(max_size=1 + value.nbytes + extra_space) as stream:
+        stream.write(b'x')
+        assert not stream._rolled
+        assert stream.write(value) == value.nbytes
+        assert stream._rolled == (extra_space == 0)
+        assert stream.getvalue() == b'x' + value.tobytes()
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('value, error', [
+    ('not bytes', TypeError),
+    (123, TypeError),
+    (None, TypeError),
+    ([1, 2], TypeError),
+    (memoryview(b'0123456789' * 4)[::2], BufferError),
+])
+def test_spooled_bytes_rejects_invalid_buffers_without_changes(rolled, value, error):
+    with ioutils.SpooledBytesIO(max_size=8) as stream:
+        stream.write(b'seed')
+        if rolled:
+            stream.rollover()
+        stream.seek(1)
+        with pytest.raises(error):
+            stream.write(value)
+        assert stream.tell() == 1
+        assert stream._rolled == rolled
+        assert stream.getvalue() == b'seed'
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('max_size', [8, 1024])
+def test_spooled_bytes_buffered_writer_flush(rolled, max_size):
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        if rolled:
+            stream.rollover()
+        with io.BufferedWriter(stream, buffer_size=8) as writer:
+            assert writer.write(b'abc') == 3
+            writer.flush()
+            assert stream.getvalue() == b'abc'
+            assert writer.write(b'defghijklmnop') == 13
+            writer.flush()
+            assert stream.getvalue() == b'abcdefghijklmnop'
+            assert stream._rolled == (rolled or max_size == 8)
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('text', [
+    pytest.param('abcdefg', id='ascii'),
+    pytest.param('a\u2014\U0001f642bc\u00e9z', id='unicode'),
+    pytest.param('a\u2014\U0001f642\u00e9z' * ioutils.READ_CHUNK_SIZE,
+                 id='multiple-chunks'),
+])
+def test_spooled_text_backward_relative_seek(rolled, text):
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(1)
+        assert stream.read(1) == text[1]
+        assert stream.seek(-1, os.SEEK_CUR) == 1
+        assert stream.read(3) == text[1:4]
+        stream.seek(len(text))
+        target = len(text) // 2
+        assert stream.seek(target - len(text), os.SEEK_CUR) == target
+        assert stream.tell() == target
+        assert stream.read() == text[target:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('mode', [os.SEEK_SET, os.SEEK_CUR, os.SEEK_END, 99])
+def test_spooled_text_invalid_seek_preserves_position(rolled, mode):
+    text = 'a\u2014\U0001f642bc\u00e9z'
+    offsets = {os.SEEK_SET: -1, os.SEEK_CUR: -3,
+               os.SEEK_END: len(text) + 1, 99: 0}
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(1)
+        assert stream.read(1) == text[1]
+        with pytest.raises(ValueError):
+            stream.seek(offsets[mode], mode)
+        assert stream.tell() == 2
+        assert stream.read() == text[2:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_text_length_preserves_position(rolled):
+    text = 'a\u2014\U0001f642bc\u00e9z'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(1)
+        stream.read(1)
+        assert stream.len == len(text)
+        assert len(stream) == len(text)
+        assert stream.tell() == 2
+        assert stream.read() == text[2:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_text_seek_back_from_end(rolled):
+    text = 'a\u2014\U0001f642bc\u00e9z'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        # SpooledStringIO has historically counted SEEK_END offsets backwards.
+        assert stream.seek(2, os.SEEK_END) == len(text) - 2
+        assert stream.read() == text[-2:]
+
