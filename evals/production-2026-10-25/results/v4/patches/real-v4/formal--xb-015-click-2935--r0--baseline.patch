+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        (["set", "start"], "--", ["--start", "--help"]),
+        (["start", "set"], "--", ["--mode", "--help"]),
+        (["start", "set", "--mode"], "", ["alpha", "beta"]),
+        (["set", "--mode", "alpha", "start"], "--", ["--start", "--help"]),
+        (["set", "start", "--start"], "--", ["--help"]),
+    ],
+)
+def test_chained_command_options(args, incomplete, expect):
+    cli = Group(
+        "cli",
+        chain=True,
+        commands=[
+            Command("set", params=[Option(["--mode"], type=Choice(["alpha", "beta"]))]),
+            Command("start", params=[Option(["--start"], is_flag=True)]),
+        ],
+    )
+    assert _get_words(cli, args, incomplete) == expect
+
+
