diff --git a/tests/test_shell_completion.py b/tests/test_shell_completion.py
index 3511f07..ff83dd6 100644
--- a/tests/test_shell_completion.py
+++ b/tests/test_shell_completion.py
@@ -50,6 +50,52 @@ def test_group_command_same_option():
     assert _get_words(cli, ["-a", "a", "x", "-a", "a"], "-") == ["--help"]
 
 
+@pytest.mark.parametrize("chain", [False, True])
+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        (["nested"], "", ["deep"]),
+        (["nested"], "--", ["--nested", "--help"]),
+        (["nested", "deep"], "", ["leaf"]),
+        (["nested", "deep"], "l", ["leaf"]),
+        (["nested", "deep"], "--", ["--deep", "--help"]),
+        (["nested", "deep", "leaf"], "--", ["--mode", "--help"]),
+        (["nested", "deep", "leaf", "--mode"], "", ["alpha", "beta"]),
+        (["nested", "deep", "leaf", "--mode"], "a", ["alpha"]),
+        (["nested", "deep", "leaf", "--mode", "alpha"], "--", ["--help"]),
+        (["nested", "--nested", "deep", "--deep"], "", ["leaf"]),
+        (["nested", "deep", "unknown"], "--", ["--deep", "--help"]),
+    ],
+)
+def test_nested_group(chain, args, incomplete, expect):
+    cli = Group(
+        "cli",
+        params=[Option(["--root"], is_flag=True)],
+        commands=[
+            Group(
+                "nested",
+                params=[Option(["--nested"], is_flag=True)],
+                commands=[
+                    Group(
+                        "deep",
+                        chain=chain,
+                        params=[Option(["--deep"], is_flag=True)],
+                        commands=[
+                            Command(
+                                "leaf",
+                                params=[
+                                    Option(["--mode"], type=Choice(["alpha", "beta"]))
+                                ],
+                            )
+                        ],
+                    )
+                ],
+            )
+        ],
+    )
+    assert _get_words(cli, args, incomplete) == expect
+
+
