index 8662316..e9715a7 100644
--- a/CHANGES.rst
+++ b/CHANGES.rst
@@ -3,6 +3,9 @@
 Version 8.1.0
 -------------
 
+-   Fix non-chained groups with ``invoke_without_command=True`` passing
+    ``None`` instead of the group callback's return value to the result
+    callback when no subcommand is invoked.
 -   Drop support for Python 3.6. :pr:`2129`
 -   Remove previously deprecated code. :pr:`2130`
 
diff --git a/src/click/core.py b/src/click/core.py
index 9ba738b..0c3e6cc 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -1552,6 +1552,11 @@ class MultiCommand(Command):
         :param replace: if set to `True` an already existing result
                         callback will be removed.
 
+        .. versionchanged:: 8.1
+            When ``invoke_without_command`` is enabled and no subcommand
+            is invoked, a non-chained group passes its callback's return
+            value to the result callback. A chained group passes ``[]``.
+
         .. versionchanged:: 8.0
             Renamed from ``resultcallback``.
 
@@ -1626,11 +1631,11 @@ class MultiCommand(Command):
         if not ctx.protected_args:
             if self.invoke_without_command:
                 # No subcommand was invoked, so the result callback is
-                # invoked with None for regular groups, or an empty list
-                # for chained groups.
+                # invoked with the group return value for regular
+                # groups, or an empty list for chained groups.
                 with ctx:
-                    super().invoke(ctx)
-                    return _process_result([] if self.chain else None)
+                    rv = super().invoke(ctx)
+                    return _process_result([] if self.chain else rv)
             ctx.fail(_("Missing command."))
 
         # Fetch args back out
