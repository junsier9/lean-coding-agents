+@pytest.mark.parametrize("chain", [False, True])
+@pytest.mark.parametrize("with_result_callback", [False, True])
+@pytest.mark.parametrize("value", [None, 42, 0, False, "", [], {"answer": 42}])
+def test_no_command_return_value(runner, chain, with_result_callback, value):
+    @click.group(invoke_without_command=True, chain=chain)
+    @click.option("--count", type=int)
+    def cli(count):
+        assert count == 23
+        return value
+
+    expected = [] if chain else value
+
+    if with_result_callback:
+
+        @cli.result_callback()
+        def process_result(result, count):
+            if chain:
+                assert result == []
+            else:
+                assert result is value
+            return result, count
+
+        expected = expected, 23
+
+    result = runner.invoke(cli, ["--count", "23"], standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == expected
+
+
