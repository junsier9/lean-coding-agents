+@parametrize(
+    "collection",
+    [
+        [4.3, 6.6, 6.9, -1.3],
+        (4.3, 6.6, 6.9, -1.3),
+        {-2: 4.3, 0: 6.6, 1: 6.9, 3: -1.3},
+        {"a": 4.3, "b": 6.6, "c": 6.9, "d": -1.3},
+    ],
+)
+@parametrize(
+    "iteratee,counts,mapped",
+    [
+        (_.floor, {4: 1, 6: 2, -2: 1}, [4, 6, 6, -2]),
+        (_.ceil, {5: 1, 7: 2, -1: 1}, [5, 7, 7, -1]),
+        (_.round_, {4: 1, 7: 2, -1: 1}, [4, 7, 7, -1]),
+    ],
+)
+def test_rounding_iteratees(collection, iteratee, counts, mapped):
+    assert _.count_by(collection, iteratee) == counts
+    assert _.map_(collection, iteratee) == mapped
+
+
+@parametrize("iteratee", [_.floor, _.ceil, _.round_])
+def test_rounding_iteratee_errors(iteratee):
+    with pytest.raises(OverflowError):
+        _.map_([1.2, float("inf")], iteratee)
+
+
