+    def test_repeat_iterator_input(self):
+        for iterables in (('ba',), ('ba', (2, 0, 1))):
+            for repeat in (2, 3):
+                products = list(product(*iterables, repeat=repeat))
+                for index, expected in enumerate(products):
+                    with self.subTest(
+                        iterables=iterables, repeat=repeat, index=index
+                    ):
+                        self.assertEqual(
+                            mi.nth_product(
+                                index, *map(iter, iterables), repeat=repeat
+                            ),
+                            expected,
+                        )
+                        self.assertEqual(
+                            mi.nth_product(
+                                index - len(products),
+                                *((item for item in pool) for pool in iterables),
+                                repeat=repeat,
+                            ),
+                            expected,
+                        )
+
+    def test_repeat_iterator_invalid_index(self):
+        for iterable in ('abc', ''):
+            size = len(list(product(iterable, repeat=2)))
+            for index in (size, -size - 1):
+                with self.subTest(iterable=iterable, index=index):
+                    with self.assertRaises(IndexError):
+                        mi.nth_product(index, iter(iterable), repeat=2)
