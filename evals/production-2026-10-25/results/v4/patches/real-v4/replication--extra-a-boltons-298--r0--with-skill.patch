@@ -313,6 +313,37 @@ def test_navigate():
     assert navd.to_text() == _dest_text
 
 
+@pytest.mark.parametrize('dest_type', [unicode, URL])
+@pytest.mark.parametrize('destinations, expected', [
+    (('dd', 'next'), 'http://a.b/c/next'),
+    (('dd/', 'next'), 'http://a.b/c/dd/next'),
+    (('/C', 'next'), 'http://a.b/next'),
+    (('/C/', '../next/'), 'http://a.b/next/'),
+    (('', 'next'), 'http://a.b/c/next'),
+    (('dd/', ''), 'http://a.b/c/dd/'),
+    (('', ''), 'http://a.b/c/d?e'),
+    (('?x=1', '#part', ''), 'http://a.b/c/d?x=1'),
+    (('#part', 'next'), 'http://a.b/c/next'),
+    (('dd/', '../', 'next/', ''), 'http://a.b/c/next/'),
+    (('/', '..', 'next'), 'http://a.b/next'),
+    (('http://other.example/a/', 'next', 'last'),
+     'http://other.example/a/last'),
+])
+def test_chained_navigate(dest_type, destinations, expected):
+    orig_text = u'http://a.b/c/d?e#f'
+    orig = URL(orig_text)
+    chained = rebuilt = orig
+    for destination in destinations:
+        dest = dest_type(destination)
+        rebuilt = URL(rebuilt.to_text()).navigate(dest)
+        chained = chained.navigate(dest)
+        assert chained == rebuilt
+
+    assert chained.to_text() == expected
+    assert isinstance(chained.path_parts, tuple)
+    assert orig.to_text() == orig_text
+
+
