+@pytest.mark.parametrize('with_case', [False, True])
+@pytest.mark.parametrize('path, expected_parts', [
+    ('/a/../b', ('', 'b')),
+    ('/a/./', ('', 'a', '')),
+    ('a/b/..', ('a', '')),
+    ('/a//b', ('', 'a', '', 'b')),
+    ('', ('',)),
+])
+def test_normalize_path_parts(path, expected_parts, with_case):
+    url = URL(path)
+    url.normalize(with_case=with_case)
+    assert url.path_parts == expected_parts
+    url.normalize(with_case=with_case)
+    assert url.path_parts == expected_parts
+
