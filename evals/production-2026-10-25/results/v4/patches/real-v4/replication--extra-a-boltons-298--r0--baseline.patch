+@pytest.mark.parametrize('as_url', [False, True])
+@pytest.mark.parametrize('destinations, expected', [
+    (('dd', 'next'), 'http://a.b/c/next'),
+    (('dd/', 'next'), 'http://a.b/c/dd/next'),
+    (('/C', 'next'), 'http://a.b/next'),
+    (('/C/', 'next/'), 'http://a.b/C/next/'),
+    (('', 'next'), 'http://a.b/c/next'),
+    (('dd/', '', '../next/'), 'http://a.b/c/next/'),
+    (('dd', '/root/', 'next'), 'http://a.b/root/next'),
+    (('dd/', '../', './next/'), 'http://a.b/c/next/'),
+    (('?e=E&ee=EE', '#FFF', ''), 'http://a.b/c/d?e=E&ee=EE'),
+    (('/root/?x=1#old', '', 'next'), 'http://a.b/root/next'),
+    (('https://other.example/dir/', 'child', '../next/'),
+     'https://other.example/next/'),
+])
+def test_chained_navigate(destinations, expected, as_url):
+    original_text = 'http://a.b/c/d?e#f'
+    original = URL(original_text)
+    chained = rebuilt = original
+
+    for destination in destinations:
+        dest = URL(destination) if as_url else destination
+        previous_text = chained.to_text()
+        rebuilt = URL(rebuilt.to_text()).navigate(dest)
+        next_url = chained.navigate(dest)
+        assert next_url is not chained
+        assert chained.to_text() == previous_text
+        assert next_url.to_text() == rebuilt.to_text()
+        if as_url:
+            assert dest.to_text() == destination
+        chained = next_url
+
+    assert chained.to_text() == expected
+    assert original.to_text() == original_text
+
+
