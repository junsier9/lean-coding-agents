+    def test_repeat_iterator_input(self):
+        for make_iter in (iter, lambda items: (x for x in items)):
+            for iterables in [('ba',), ('ba', (2, 1, 2))]:
+                for repeat in (2, 3):
+                    products = list(product(*iterables, repeat=repeat))
+                    for index in range(-len(products), len(products)):
+                        with self.subTest(
+                            make_iter=make_iter,
+                            iterables=iterables,
+                            repeat=repeat,
+                            index=index,
+                        ):
+                            actual = mi.nth_product(
+                                index, *map(make_iter, iterables), repeat=repeat
+                            )
+                            self.assertEqual(actual, products[index])
+
+    def test_repeat_iterator_invalid_index(self):
+        for iterables in [('',), ('ba',), ('ba', (2, 1, 2))]:
+            size = len(list(product(*iterables, repeat=2)))
+            for index in (-size - 1, size):
+                with self.subTest(iterables=iterables, index=index):
+                    with self.assertRaises(IndexError):
+                        mi.nth_product(index, *map(iter, iterables), repeat=2)
+
 
