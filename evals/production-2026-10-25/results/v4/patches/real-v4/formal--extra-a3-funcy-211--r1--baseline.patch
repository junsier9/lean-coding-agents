+@pytest.mark.parametrize('method_name', ['method', 'class_method'])
+@pytest.mark.parametrize('wrapper_kind', ['plain', 'funcy', 'functools'])
+def test_decorator_access_bound_method_args(method_name, wrapper_kind):
+    @decorator
+    def check_args(call):
+        values = (call.receiver, call.x, call.y, call.args,
+                  call.required, call.flag, call.kwargs)
+        assert values == call()
+        return values
+
+    @decorator
+    def noop(call):
+        return call()
+
+    def passthrough(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            return func(*args, **kwargs)
+        return wrapper
+
+    wrappers = {'plain': lambda func: func, 'funcy': noop, 'functools': passthrough}
+
+    class A(object):
+        def method(receiver, x, y=11, *args, required, flag=12, **kwargs):
+            return receiver, x, y, args, required, flag, kwargs
+
+        method = wrappers[wrapper_kind](method)
+        class_method = classmethod(method)
+
+    method = getattr(A(), method_name)
+    receiver = method.__self__
+    decorated = check_args(method)
+    for _ in range(2):
+        assert decorated(10, required=30) == (receiver, 10, 11, (), 30, 12, {})
+        assert decorated(x=10, y=20, required=30, flag=40, extra=50) == (
+            receiver, 10, 20, (), 30, 40, {'extra': 50})
+        assert decorated(10, 20, 21, 22, required=30) == (
+            receiver, 10, 20, (21, 22), 30, 12, {})
+        assert decorated(10, required=30, args=1, kwargs=2) == (
+            receiver, 10, 11, (), 30, 12, {'args': 1, 'kwargs': 2})
+        decorated = check_args(decorated)
+
+
+@pytest.mark.parametrize('method_name', ['method', 'class_method'])
+@pytest.mark.parametrize('name, args, kwargs, message', [
+    ('x', (), {}, "missing required argument: 'x'"),
+    ('required', (10,), {}, "missing required argument: 'required'"),
+    ('unknown', (10,), {'required': 20}, "doesn't have argument named unknown"),
+])
+def test_decorator_access_bound_method_missing_args(method_name, name, args, kwargs, message):
+    @decorator
+    def lookup(call):
+        return getattr(call, name)
+
+    class A(object):
+        def method(receiver, x, *, required):
+            pass
+
+        class_method = classmethod(method)
+
+    method = getattr(A(), method_name)
+    with pytest.raises(AttributeError, match=message):
+        lookup(method)(*args, **kwargs)
+
+
