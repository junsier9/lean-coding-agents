 class ZipBroadcastTests(TestCase):
+    def test_single_use_iterables(self):
+        class SingleUseIterable:
+            def __init__(self, items):
+                self.items = items
+                self.used = False
+
+            def __iter__(self):
+                if self.used:
+                    raise RuntimeError('iterator already requested')
+                self.used = True
+                return iter(self.items)
+
+        for strict in (False, True):
+            for left, right in [
+                ([], []),
+                ([1], [2]),
+                ([1, 2], [3, 4]),
+                ([], [1]),
+                ([1], []),
+                ([1], [2, 3]),
+                ([1, 2], [3]),
+            ]:
+                with self.subTest(strict=strict, left=left, right=right):
+                    actual = mi.zip_broadcast(
+                        0,
+                        SingleUseIterable(left),
+                        '_',
+                        SingleUseIterable(right),
+                        strict=strict,
+                    )
+                    if strict and len(left) != len(right):
+                        with self.assertRaises(ValueError):
+                            list(actual)
+                    else:
+                        expected = [
+                            (0, a, '_', b) for a, b in zip(left, right)
+                        ]
+                        self.assertEqual(list(actual), expected)
+
+    def test_iter_error(self):
+        class BrokenIterable:
+            def __iter__(self):
