+@pytest.mark.parametrize("nested", [False, True])
+def test_chained_current_command(nested):
+    cli = Group(
+        "cli",
+        chain=True,
+        commands=[
+            Command("first", params=[Option(["--first"])]),
+            Command("second", params=[Option(["--second"], type=Choice(["value"]))]),
+            Command("third", params=[Option(["--third"])]),
+        ],
+    )
+    prefix = []
+
+    if nested:
+        cli = Group("cli", commands=[Group("outer", commands={"chain": cli})])
+        prefix = ["outer", "chain"]
+
+    assert _get_words(cli, [*prefix, "first", "second"], "--") == [
+        "--second",
+        "--help",
+    ]
+    assert _get_words(cli, [*prefix, "first", "second", "--second"], "") == ["value"]
+    assert _get_words(
+        cli, [*prefix, "first", "--first", "value", "second"], "--"
+    ) == ["--second", "--help"]
+    assert _get_words(cli, [*prefix, "first", "second", "third"], "--") == [
+        "--third",
+        "--help",
+    ]
+    assert _get_words(cli, [*prefix, "first", "second"], "") == ["third"]
+
+
 def test_help_option():
     cli = Group("cli", commands=[Command("with"), Command("no", add_help_option=False)])
