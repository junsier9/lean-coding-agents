     assert _get_words(cli, ["-a", "a", "x", "-a", "a"], "-") == ["--help"]
 
 
+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        (["outer"], "", ["inner", "sibling"]),
+        (["outer", "inner"], "", ["leaf", "list"]),
+        (["outer", "inner"], "li", ["list"]),
+        (["outer", "inner"], "--", ["--inner", "--help"]),
+        (["outer", "inner", "--inner", "value"], "--", ["--help"]),
+        (["outer", "inner", "leaf"], "--", ["--leaf", "--help"]),
+        (["outer", "inner", "leaf", "--leaf"], "o", ["one"]),
+        (["outer", "inner", "leaf", "--leaf", "one"], "--", ["--help"]),
+    ],
+)
+def test_nested_group(args, incomplete, expect):
+    cli = Group(
+        "cli",
+        params=[Option(["--root"])],
+        commands=[
+            Group(
+                "outer",
+                params=[Option(["--outer"])],
+                commands=[
+                    Command("sibling"),
+                    Group(
+                        "inner",
+                        params=[Option(["--inner"])],
+                        commands=[
+                            Command(
+                                "leaf",
+                                params=[
+                                    Option(["--leaf"], type=Choice(["one", "two"]))
+                                ],
+                            ),
+                            Command("list"),
+                        ],
+                    ),
+                ],
+            )
+        ],
+    )
+    assert _get_words(cli, args, incomplete) == expect
+
+
+def test_nested_group_context():
+    def callback(*args, **kwargs):
+        pytest.fail("Completion must not invoke callbacks.")
+
+    def complete(ctx, param, incomplete):
+        assert ctx.command is leaf
+        assert ctx.parent.command is inner
+        assert ctx.parent.params == {"name": "inner-value"}
+        assert ctx.parent.parent.command is cli
+        assert ctx.parent.parent.params == {"name": "root-value"}
+        return [ctx.command_path]
+
+    leaf = Command(
+        "leaf",
+        callback=callback,
+        params=[Option(["--name"], shell_complete=complete)],
+    )
+    inner = Group(
+        "inner", callback=callback, params=[Option(["--name"])], commands=[leaf]
+    )
+    cli = Group("cli", callback=callback, params=[Option(["--name"])], commands=[inner])
+    args = ["--name", "root-value", "inner", "--name", "inner-value", "leaf", "--name"]
+    original_args = args.copy()
+    assert _get_words(cli, args, "") == ["cli inner leaf"]
+    assert args == original_args
+
+
