diff --git a/more_itertools/recipes.py b/more_itertools/recipes.py
index ce22bdc..078a471 100644
--- a/more_itertools/recipes.py
+++ b/more_itertools/recipes.py
@@ -151,12 +151,16 @@ def tail(n, iterable):
     >>> list(t)
     ['E', 'F', 'G']
 
+    If *n* is negative, raise :exc:`ValueError`.
+
     """
     try:
         size = len(iterable)
     except TypeError:
         return iter(deque(iterable, maxlen=n))
     else:
+        if n < 0:
+            raise ValueError('n must be >= 0')
         return islice(iterable, max(0, size - n), None)
 
 
diff --git a/tests/test_recipes.py b/tests/test_recipes.py
index 15d54fc..550ac4d 100644
--- a/tests/test_recipes.py
+++ b/tests/test_recipes.py
@@ -72,6 +72,28 @@ class TabulateTests(TestCase):
 class TailTests(TestCase):
     """Tests for ``tail()``"""
 
+    def test_negative(self):
+        for n in (-1, -3):
+            for iterable in ('', 'ABCDEFG', iter(''), iter('ABCDEFG')):
+                with self.subTest(n=n, iterable=iterable):
+                    self.assertRaises(ValueError, mi.tail, n, iterable)
+
+    def test_negative_does_not_consume(self):
+        iterable = iter('ABCDEFG')
+        self.assertRaises(ValueError, mi.tail, -1, iterable)
+        self.assertEqual(list(iterable), list('ABCDEFG'))
+
+    def test_zero(self):
+        for iterable in ('ABCDEFG', iter('ABCDEFG')):
+            with self.subTest(iterable=iterable):
+                self.assertEqual(list(mi.tail(0, iterable)), [])
+
+    def test_empty(self):
+        for n in (0, 3):
+            for iterable in ('', iter('')):
+                with self.subTest(n=n, iterable=iterable):
+                    self.assertEqual(list(mi.tail(n, iterable)), [])
+
     def test_iterator_greater(self):
         """Length of iterator is greater than requested tail"""
         self.assertEqual(list(mi.tail(3, iter('ABCDEFG'))), list('EFG'))
