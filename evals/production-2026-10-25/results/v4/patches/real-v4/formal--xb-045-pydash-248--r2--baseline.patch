+@parametrize(
+    "collection",
+    [
+        pytest.param([4.3, 6.1, 6.4, -2.3], id="list"),
+        pytest.param((4.3, 6.1, 6.4, -2.3), id="tuple"),
+        pytest.param({"a": 4.3, "b": 6.1, "c": 6.4, "d": -2.3}, id="string-keys"),
+        pytest.param({-2: 4.3, 1: 6.1, 7: 6.4, 0: -2.3}, id="integer-keys"),
+    ],
+)
+@parametrize(
+    "operation,iteratee,expected",
+    [
+        (_.count_by, _.floor, {4: 1, 6: 2, -3: 1}),
+        (_.count_by, _.ceil, {5: 1, 7: 2, -2: 1}),
+        (_.count_by, _.round_, {4: 1, 6: 2, -2: 1}),
+        (_.map_, _.floor, [4, 6, 6, -3]),
+        (_.map_, _.ceil, [5, 7, 7, -2]),
+        (_.map_, _.round_, [4, 6, 6, -2]),
+    ],
+)
+def test_rounding_iteratees_use_default_precision(collection, operation, iteratee, expected):
+    assert operation(collection, iteratee) == expected
+
+
+@parametrize("collection_type", [list, tuple])
+@parametrize(
+    "operation,iteratee,expected",
+    [
+        (_.group_by, _.floor, {4: [4.3], 6: [6.1, 6.4], -3: [-2.3]}),
+        (_.group_by, _.ceil, {5: [4.3], 7: [6.1, 6.4], -2: [-2.3]}),
+        (_.group_by, _.round_, {4: [4.3], 6: [6.1, 6.4], -2: [-2.3]}),
+        (_.key_by, _.floor, {4: 4.3, 6: 6.4, -3: -2.3}),
+        (_.key_by, _.ceil, {5: 4.3, 7: 6.4, -2: -2.3}),
+        (_.key_by, _.round_, {4: 4.3, 6: 6.4, -2: -2.3}),
+    ],
+)
+def test_rounding_iteratees_with_single_argument(collection_type, operation, iteratee, expected):
+    assert operation(collection_type([4.3, 6.1, 6.4, -2.3]), iteratee) == expected
+
+
+@parametrize(
