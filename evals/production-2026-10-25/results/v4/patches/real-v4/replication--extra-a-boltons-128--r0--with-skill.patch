diff --git a/tests/test_mathutils.py b/tests/test_mathutils.py
index e5b536d..fbb70b5 100644
--- a/tests/test_mathutils.py
+++ b/tests/test_mathutils.py
@@ -1,6 +1,77 @@
 
-from pytest import raises
-from boltons.mathutils import ceil, floor
+from math import isnan
+
+from pytest import mark, raises
+from boltons.mathutils import ceil, clamp, floor
+
+
+@mark.parametrize('x', [-float('inf'), -1, 0, 1, float('inf')])
+def test_clamp_no_bounds(x):
+    assert clamp(x) == x
+    assert clamp(x, None, None) == x
+
+
+@mark.parametrize('x, expected', [
+    (-float('inf'), 0), (-1, 0), (0, 0), (1, 1),
+    (float('inf'), float('inf')),
+])
+def test_clamp_lower_only(x, expected):
+    assert clamp(x, 0) == expected
+    assert clamp(x, lower=0) == expected
+
+
+@mark.parametrize('x, expected', [
+    (-float('inf'), -float('inf')), (-1, -1), (0, 0), (1, 0),
+    (float('inf'), 0),
+])
+def test_clamp_upper_only(x, expected):
+    assert clamp(x, None, 0) == expected
+    assert clamp(x, upper=0) == expected
+
+
+@mark.parametrize('x, lower, upper, expected', [
+    (-1.0, 0, 5, 0), (0, 0, 5, 0), (1.0, 0, 5, 1.0),
+    (5, 0, 5, 5), (101.0, 0, 5, 5), (1, 0, 0, 0),
+    (-float('inf'), 0, 5, 0), (float('inf'), 0, 5, 5),
+    (-float('inf'), -float('inf'), float('inf'), -float('inf')),
+    (float('inf'), -float('inf'), float('inf'), float('inf')),
+])
+def test_clamp_both_bounds(x, lower, upper, expected):
+    assert clamp(x, lower, upper) == expected
+
+
+def test_clamp_inverted_bounds():
+    with raises(ValueError) as exc_info:
+        clamp(1, 5, 0)
+    assert str(exc_info.value) == 'expected upper bound (0) >= lower bound (5)'
+
+
+def test_clamp_large_int():
+    x = 10 ** 1000
+    assert clamp(x) == x
+    assert clamp(-x) == -x
+    assert clamp(x, lower=0) == x
+    assert clamp(-x, upper=0) == -x
+    assert clamp(x, 0, x + 1) == x
+    assert clamp(-x, -x - 1, 0) == -x
+    assert clamp(x + 1, upper=x) == x
+    assert clamp(-x - 1, lower=-x) == -x
+
+
+@mark.parametrize('lower, upper', [
+    (None, None), (0, None), (None, 1), (0, 1),
+])
+def test_clamp_nan_value(lower, upper):
+    assert isnan(clamp(float('nan'), lower, upper))
+
+
+def test_clamp_nan_bounds():
+    nan = float('nan')
+    assert clamp(-1, lower=nan) == -1
+    assert clamp(2, upper=nan) == 2
+    assert clamp(2, nan, 1) == 1
+    assert clamp(-1, 0, nan) == 0
+    assert clamp(1, nan, nan) == 1
 
 
