+def test_once_per_args_keyword_only():
+    calls = []
+
+    @once_per_args
+    def call(n=1, *, required, flag=True):
+        calls.append((n, required, flag))
+        return 'called'
+
+    with pytest.raises(TypeError):
+        call()
+    assert call(required='x') == 'called'
+    assert call(1, flag=True, required='x') is None
+    assert call(n=1, required='x', flag=False) == 'called'
+    assert call(required='y') == 'called'
+    assert call(required='y', n=1, flag=True) is None
+    with pytest.raises(TypeError):
+        call()
+    assert calls == [(1, 'x', True), (1, 'x', False), (1, 'y', True)]
+
+
+def test_once_per_args_varargs():
+    calls = []
+
+    @once_per_args
+    def call(n=1, *items):
+        calls.append((n, items))
+        return 'called'
+
+    assert call() == 'called'
+    assert call(n=1) is None
+    assert call(1, 2) == 'called'
+    assert call(1, 2) is None
+    assert call(1, 2, 3) == 'called'
+    assert call(1, 3, 2) == 'called'
+    assert calls == [(1, ()), (1, (2,)), (1, (2, 3)), (1, (3, 2))]
+
+
+def test_once_per_args_varkwargs():
+    calls = []
+
+    @once_per_args
+    def call(n=1, **options):
+        calls.append((n, options))
+        return 'called'
+
+    assert call() == 'called'
+    assert call(n=1) is None
+    assert call(a=2, b=3) == 'called'
+    assert call(1, b=3, a=2) is None
+    assert call(a=2, b=4) == 'called'
+    assert call(options='value') == 'called'
+    assert call(n=1, options='value') is None
+    assert calls == [(1, {}), (1, {'a': 2, 'b': 3}),
+                     (1, {'a': 2, 'b': 4}), (1, {'options': 'value'})]
+
+
+@pytest.mark.parametrize('invoke', [
+    lambda call, value: call(flag=value),
+    lambda call, value: call(1, value),
+    lambda call, value: call(extra=value),
+])
+@pytest.mark.parametrize('make_value', [list, dict, set, lambda: ([],)])
+def test_once_per_args_unhashable_parameter_kinds(invoke, make_value):
+    calls = []
+
+    @once_per_args
+    def call(n=1, *items, flag=None, **options):
+        calls.append('called')
+        return 'called'
+
+    assert invoke(call, make_value()) == 'called'
+    assert invoke(call, make_value()) is None
+    assert invoke(call, 'other') == 'called'
+    assert invoke(call, 'other') is None
+    assert calls == ['called', 'called']
+
+
+def test_once_per_args_methods():
+    calls = []
+
+    class Initializer:
+        @once_per_args
+        def initialize(receiver, n=1, *, flag=True):
+            """Initialize once per combination of arguments."""
+            calls.append((receiver, n, flag))
+            return 'called'
+
+    first, second = Initializer(), Initializer()
+    assert first.initialize() == 'called'
+    assert Initializer.initialize(receiver=first, n=1, flag=True) is None
+    assert Initializer.initialize(receiver=first, flag=False) == 'called'
+    assert first.initialize(flag=False) is None
+    assert second.initialize() == 'called'
+    assert calls == [(first, 1, True), (first, 1, False), (second, 1, True)]
+    assert Initializer.initialize.__name__ == 'initialize'
+    assert Initializer.initialize.__doc__ == 'Initialize once per combination of arguments.'
+    assert Initializer.initialize.__original__ is Initializer.initialize.__wrapped__
+
