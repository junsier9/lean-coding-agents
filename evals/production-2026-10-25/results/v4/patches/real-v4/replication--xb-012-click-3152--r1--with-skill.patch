+@pytest.mark.parametrize(
+    ("option_type", "default", "flag_value", "value"),
+    [
+        (str, UNSET, "flag", "value"),
+        (int, UNSET, 2, 3),
+        (str, "default", "flag", "value"),
+        (int, 1, 2, 3),
+        (str, None, "flag", "value"),
+        (int, None, 2, 3),
+        (str, "", "flag", "value"),
+        (int, 0, 2, 3),
+    ],
+)
+def test_option_with_optional_value_and_default(
+    runner, option_type, default, flag_value, value
+):
+    @click.command()
+    @click.option(
+        "-o",
+        "--opt",
+        is_flag=False,
+        flag_value=flag_value,
+        default=default,
+        type=option_type,
+    )
+    @click.option("--other", is_flag=True)
+    def cli(opt, other):
+        return opt
+
+    for args, expected in (
+        ([], None if default is UNSET else default),
+        (["--opt"], flag_value),
+        (["--opt", str(value)], value),
+        ([f"--opt={value}"], value),
+        (["-o"], flag_value),
+        ([f"-o{value}"], value),
+        (["--opt", "--other"], flag_value),
+    ):
+        result = runner.invoke(cli, args, standalone_mode=False)
+        assert result.exit_code == 0, (args, result.output)
+        assert result.return_value == expected
+
+
+@pytest.mark.parametrize("args", [["--opt", "invalid"], ["--opt=invalid"]])
+def test_option_with_optional_value_invalid_int(runner, args):
+    @click.command()
+    @click.option("--opt", is_flag=False, flag_value=2, default=1, type=int)
+    def cli(opt):
+        pytest.fail("Invalid integer must not reach the command callback.")
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 2
+    assert "'invalid' is not a valid integer" in result.output
+
