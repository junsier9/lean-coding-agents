@@ -9,6 +9,37 @@ from boltons.funcutils import wraps, FunctionBuilder, update_wrapper
 import boltons.funcutils as funcutils
 
 
+@pytest.mark.parametrize('copy_dict', (True, False))
+def test_copy_function_kwonly_defaults(copy_dict):
+    func = lambda x, *, y=2: x * y
+    func_copy = funcutils.copy_function(func, copy_dict=copy_dict)
+
+    assert func_copy is not func
+    assert func_copy(21) == func(21) == 42
+    assert func_copy(x=21) == func(x=21) == 42
+    assert func_copy(14, y=3) == func(14, y=3) == 42
+
+    with pytest.raises(TypeError):
+        func_copy(21, 2)
+
+
+@pytest.mark.parametrize('copy_dict', (True, False))
+def test_copy_function_kwonly_method(copy_dict):
+    class Multiplier:
+        def multiply(instance, x=21, *, y=2, offset):
+            return x * y + offset
+
+        multiply_copy = funcutils.copy_function(multiply, copy_dict=copy_dict)
+
+    obj = Multiplier()
+    assert obj.multiply_copy(offset=0) == obj.multiply(offset=0) == 42
+    assert obj.multiply_copy(14, y=3, offset=1) == obj.multiply(14, y=3, offset=1) == 43
+    assert Multiplier.multiply_copy(instance=obj, offset=0) == 42
+
+    with pytest.raises(TypeError):
+        obj.multiply_copy()
+
+
