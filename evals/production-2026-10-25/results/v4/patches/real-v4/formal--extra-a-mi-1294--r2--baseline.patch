+    def test_maxlen_zero_peek(self):
+        iterable = [None, False, 0, '', object()]
+        s = mi.seekable(iterable, maxlen=0)
+        elements = s.elements()
+        for expected in iterable:
+            for _ in range(10):
+                self.assertIs(s.peek(), expected)
+                self.assertTrue(s)
+                self.assertEqual(list(elements), [])
+            self.assertIs(next(s), expected)
+            self.assertEqual(list(elements), [])
+
+        default = object()
+        for _ in range(10):
+            self.assertFalse(s)
+            self.assertIs(s.peek(default), default)
+            self.assertRaises(StopIteration, s.peek)
+            self.assertRaises(StopIteration, next, s)
+        self.assertEqual(list(elements), [])
+
+    def test_maxlen_zero_peek_then_iterate(self):
+        source = iter(range(5))
+        s = mi.seekable(source, maxlen=0)
+        for _ in range(10):
+            self.assertTrue(s)
+            self.assertEqual(s.peek(), 0)
+        self.assertEqual(list(source), [1, 2, 3, 4])
+        self.assertEqual(list(s), [0])
+        self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_peek_seek(self):
+        for method, offset, expected in [
+            ('seek', 0, [0, 1, 2, 3, 4]),
+            ('seek', 2, [2, 3, 4]),
+            ('seek', 10, []),
+            ('relative_seek', 0, [0, 1, 2, 3, 4]),
+            ('relative_seek', -2, [0, 1, 2, 3, 4]),
+            ('relative_seek', 2, [2, 3, 4]),
+        ]:
+            with self.subTest(method=method, offset=offset):
+                s = mi.seekable(range(5), maxlen=0)
+                self.assertEqual(s.peek(), 0)
+                getattr(s, method)(offset)
+                self.assertEqual(list(s), expected)
+                s.seek(0)
+                self.assertEqual(list(s), [])
+                self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_peek_releases_consumed_items(self):
+        source = IteratorWithWeakReferences.FROM_SIZE(3)
+        s = mi.seekable(source, maxlen=0)
+        for reference in source._weakReferences:
+            self.assertIs(s.peek(), reference())
+            self.assertTrue(s)
+            self.assertIs(next(s), reference())
+            gc.collect()
+            self.assertIsNone(reference())
+
+    def test_maxlen_zero_observation_memory(self):
+        if platform.python_implementation() != 'CPython':
+            self.skipTest('Requires CPython memory tracing')
+        import tracemalloc
+
+        s = mi.seekable(repeat(None), maxlen=0)
+        was_tracing = tracemalloc.is_tracing()
+        if not was_tracing:
+            tracemalloc.start()
+        try:
+            for _ in range(100):
+                s.peek()
+                bool(s)
+            gc.collect()
+            before = tracemalloc.get_traced_memory()[0]
+            for _ in range(10000):
+                s.peek()
+                bool(s)
+            gc.collect()
+            after = tracemalloc.get_traced_memory()[0]
+        finally:
+            if not was_tracing:
+                tracemalloc.stop()
+
+        # Allow allocator noise, but reject per-observation storage growth.
+        self.assertLess(after - before, 64 * 1024)
+
