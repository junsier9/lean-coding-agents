diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index a8e1539..31749d8 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -313,6 +313,55 @@ def test_navigate():
     assert navd.to_text() == _dest_text
 
 
+@pytest.mark.parametrize('as_url', [False, True])
+@pytest.mark.parametrize('first, second, expected', [
+    ('dd', 'ee', 'http://a.b/c/ee'),
+    ('dd/', 'ee', 'http://a.b/c/dd/ee'),
+    ('/C', 'ee', 'http://a.b/ee'),
+    ('/C/', 'ee/', 'http://a.b/C/ee/'),
+    ('dd', '/C', 'http://a.b/C'),
+    ('dd/', '/C/', 'http://a.b/C/'),
+    ('dd?g=1#middle', '', 'http://a.b/c/dd?g=1'),
+    ('', 'ee', 'http://a.b/c/ee'),
+    ('', '', 'http://a.b/c/d?e'),
+    ('dd/', '../ee', 'http://a.b/c/ee'),
+    ('../', './ee/', 'http://a.b/ee/'),
+    ('https://newhost/x/y', '../z/', 'https://newhost/z/'),
+])
+def test_chained_navigate(first, second, expected, as_url):
+    orig_text = 'http://a.b/c/d?e#f'
+    orig = URL(orig_text)
+    if as_url:
+        first, second = URL(first), URL(second)
+
+    intermediate = orig.navigate(first)
+    intermediate_text = intermediate.to_text()
+    chained = intermediate.navigate(second)
+    reconstructed = URL(intermediate_text).navigate(second)
+
+    assert chained.to_text() == reconstructed.to_text() == expected
+    assert isinstance(chained.path_parts, tuple)
+    assert orig.to_text() == orig_text
+    assert intermediate.to_text() == intermediate_text
+    assert chained is not intermediate
+    chained.query_params['new'] = 'value'
+    assert intermediate.to_text() == intermediate_text
+
+
+def test_normalized_navigate():
+    orig = URL('http://a.b/c/./d')
+    dest = URL('../e/')
+    assert orig.normalize() is None
+    dest.normalize()
+
+    assert isinstance(orig.path_parts, tuple)
+    assert isinstance(dest.path_parts, tuple)
+    assert orig.navigate(dest).to_text() == 'http://a.b/c/e/'
+    assert URL.navigate(self=orig, dest=dest).to_text() == 'http://a.b/c/e/'
+    assert orig.to_text() == 'http://a.b/c/d'
+    assert dest.to_text() == 'e/'
+
+
