+@pytest.mark.parametrize('method_name', [
+    'method', 'class_method', 'wrapped_method', 'wrapped_class_method',
+    'decorated_method', 'decorated_class_method',
+])
+@pytest.mark.parametrize('rewrapped', [False, True])
+def test_decorator_access_bound_method_args(method_name, rewrapped):
+    @decorator
+    def inspect_args(call):
+        return (call.x, call.y, call.items, call.flag, call.options), call()
+
+    @decorator
+    def noop(call):
+        return call()
+
+    def passthrough(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            return func(*args, **kwargs)
+        return wrapper
+
+    class A(object):
+        def method(receiver, x, y=20, *items, flag=30, **options):
+            return x, y, items, flag, options
+
+        class_method = classmethod(method)
+        wrapped_method = passthrough(method)
+        wrapped_class_method = classmethod(passthrough(method))
+        decorated_method = noop(method)
+        decorated_class_method = classmethod(noop(method))
+
+    method = getattr(A(), method_name)
+    if rewrapped:
+        method = noop(noop(method))
+    wrapped = inspect_args(method)
+
+    expected = (10, 20, (), 30, {})
+    assert wrapped(10) == (expected, expected)
+    expected = (11, 22, (), 33, {'extra': 44})
+    assert wrapped(x=11, y=22, flag=33, extra=44) == (expected, expected)
+    expected = (1, 2, (3, 4), 5, {'extra': 6})
+    assert wrapped(1, 2, 3, 4, flag=5, extra=6) == (expected, expected)
+    with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+        wrapped()
+
+
+@pytest.mark.parametrize('method_name', ['method', 'class_method'])
+def test_decorator_access_bound_variadic_method_args(method_name):
+    @decorator
+    def inspect_args(call):
+        return (call.args, call.flag, call.kwargs), call()
+
+    class A(object):
+        def method(*args, flag=10, **kwargs):
+            return args, flag, kwargs
+
+        class_method = classmethod(method)
+
+    instance = A()
+    receiver = A if method_name == 'class_method' else instance
+    wrapped = inspect_args(getattr(instance, method_name))
+    expected = ((receiver,), 10, {})
+    assert wrapped() == (expected, expected)
+    expected = ((receiver, 1, 2), 3, {'extra': 4})
+    assert wrapped(1, 2, flag=3, extra=4) == (expected, expected)
+
+
