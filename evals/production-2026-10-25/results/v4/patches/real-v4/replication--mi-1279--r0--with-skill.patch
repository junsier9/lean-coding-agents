+class OneAndOnlyExceptionTests(TestCase):
+    def test_too_long_falsy_exception(self):
+        class FalsyError(Exception):
+            def __bool__(self):
+                return False
+
+        for func in (mi.one, mi.only):
+            with self.subTest(func=func.__name__):
+                error = FalsyError('too long')
+                iterator = iter([1, 2, 3])
+                with self.assertRaises(FalsyError) as caught:
+                    func(iterator, too_long=error)
+                self.assertIs(caught.exception, error)
+                self.assertEqual(next(iterator), 3)
+
+    def test_custom_exception_skips_repr(self):
+        class BadRepr:
+            def __repr__(self):
+                raise AssertionError('repr should not be called')
+
+        for func in (mi.one, mi.only):
+            for index in (0, 1):
+                with self.subTest(func=func.__name__, index=index):
+                    items = [1, 2]
+                    items[index] = BadRepr()
+                    error = RuntimeError('too long')
+                    with self.assertRaises(RuntimeError) as caught:
+                        func(items, too_long=error)
+                    self.assertIs(caught.exception, error)
+                    with self.assertRaises(RuntimeError):
+                        func(items, too_long=RuntimeError)
+
+    def test_default_exception_preserves_repr_failure(self):
+        error = RuntimeError('repr failed')
+
+        class BadRepr:
+            def __repr__(self):
+                raise error
+
+        for func in (mi.one, mi.only):
+            for index in (0, 1):
+                with self.subTest(func=func.__name__, index=index):
+                    items = [1, 2]
+                    items[index] = BadRepr()
+                    with self.assertRaises(RuntimeError) as caught:
+                        func(items, too_long=None)
+                    self.assertIs(caught.exception, error)
+
+
