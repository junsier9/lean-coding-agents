+    def test_autospec_method_calls(self):
+        import unittest.mock
+
+        for cls in (Cached, Unhashable):
+            for instance in (False, True):
+                spec = unittest.mock.create_autospec(cls, instance=instance)
+                cached = spec if instance else spec(Cache(2))
+                for name in (
+                    "get",
+                    "get_typed",
+                    "get_info",
+                    "get_lock",
+                    "get_lock_info",
+                    "get_cond",
+                    "get_cond_info",
+                    "get_lock_cond",
+                    "get_lock_cond_info",
+                ):
+                    with self.subTest(cls=cls, instance=instance, method=name):
+                        method = getattr(cached, name)
+                        self.assertIs(method(1), method.return_value)
+                        method.assert_called_once_with(1)
+                        method.reset_mock()
+                        self.assertIs(method(value=2), method.return_value)
+                        method.assert_called_once_with(value=2)
+                        method.reset_mock()
+                        with self.assertRaises(TypeError):
+                            method()
+                        with self.assertRaises(TypeError):
+                            method(cached, 1)
+                        with self.assertRaises(TypeError):
+                            method(1, unexpected=2)
+                        method.assert_not_called()
