+@pytest.mark.parametrize("use_default_map", [False, True])
+def test_show_default_with_non_string_equality(runner, use_default_map):
+    class Value:
+        def __eq__(self, other):
+            if isinstance(other, str):
+                raise ValueError("Cannot compare Value with str.")
+
+            return NotImplemented
+
+        def __str__(self):
+            return "special value"
+
+    default = Value()
+    opt = click.Option(
+        ["--value"],
+        default="fallback" if use_default_map else default,
+        show_default=True,
+    )
+    cli = click.Command("cli", params=[opt])
+    default_map = {"value": default} if use_default_map else None
+    ctx = click.Context(cli, default_map=default_map)
+    assert opt.get_help_extra(ctx) == {"default": "special value"}
+
+    result = runner.invoke(cli, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    assert "[default: special value]" in result.output
+
+
 def test_do_not_show_no_default(runner):
     """When show_default is True and no default is set do not show None."""
     opt = click.Option(["--limit"], show_default=True)
