+@pytest.mark.parametrize('cache_type', [LRI, LRU])
+@pytest.mark.parametrize('max_size', [1, 2])
+def test_cache_overwrite_mapping_views(cache_type, max_size):
+    cache = cache_type(max_size=max_size, values={'key': 'old'})
+    values = cache.values()
+    items = cache.items()
+
+    for value in ('new', 'newest'):
+        cache['key'] = value
+        assert cache['key'] == value
+        assert dict(cache) == {'key': value}
+        assert list(values) == [value]
+        assert list(items) == [('key', value)]
+        assert len(cache) == 1
+
+    assert cache.pop('key') == 'newest'
+    assert not cache
+
+
+@pytest.mark.parametrize('cache_type', [LRI, LRU])
+def test_cache_overwrite_eviction(cache_type):
+    cache = cache_type(max_size=2, values=[('a', 1), ('b', 2)])
+    cache['a'] = 3
+    assert dict(cache) == {'a': 3, 'b': 2}
+
+    cache['c'] = 4
+    assert dict(cache) == {'a': 3, 'c': 4}
+    assert len(cache) == cache.max_size
+    assert 'b' not in cache
+
+
+@pytest.mark.parametrize('cache_type', [LRI, LRU])
+def test_cache_update_mapping_views(cache_type):
+    cache = cache_type(max_size=1, values={'key': 'old'})
+    cache.update({'key': 'mapping'})
+    assert dict(cache) == {'key': 'mapping'}
+    cache.update([('key', 'pair'), ('key', 'last pair')])
+    assert dict(cache) == {'key': 'last pair'}
+    cache.update({}, key='keyword')
+    assert cache['key'] == 'keyword'
+    assert list(cache.values()) == ['keyword']
+    assert dict(cache) == {'key': 'keyword'}
+
+
