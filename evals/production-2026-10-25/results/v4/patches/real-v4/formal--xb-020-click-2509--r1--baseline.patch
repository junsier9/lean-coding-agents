diff --git a/tests/test_termui.py b/tests/test_termui.py
index 7cfa939..1b61478 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -234,6 +234,76 @@ def test_file_prompt_default_format(runner, file_kwargs):
     assert result.output == f"file [{__file__}]: \n{__file__}\n"
 
 
+@pytest.mark.parametrize(
+    ("show_default", "expected_prompt"),
+    [
+        (False, "Value"),
+        (True, "Value [secret]"),
+        (None, "Value [secret]"),
+        ("help description", "Value [secret]"),
+        ("", "Value [secret]"),
+    ],
+)
+@pytest.mark.parametrize(
+    "default", ["secret", pytest.param(lambda: "secret", id="callable")]
+)
+@pytest.mark.parametrize(
+    ("input", "expected_value"), [("\n", "secret"), ("new\n", "new")]
+)
+def test_option_prompt_show_default(
+    runner, show_default, expected_prompt, default, input, expected_value
+):
+    @click.command()
+    @click.option("--value", prompt=True, default=default, show_default=show_default)
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input=input, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == expected_value
+    assert result.output == f"{expected_prompt}: {input}"
+
+
+def test_hidden_option_prompt_show_default(runner):
+    @click.command(context_settings={"show_default": True})
+    @click.option(
+        "--password",
+        prompt=True,
+        default="secret",
+        show_default=False,
+        hide_input=True,
+        confirmation_prompt=True,
+    )
+    def cli(password):
+        return password
+
+    result = runner.invoke(cli, input="new\nnew\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == "new"
+    assert result.output == "Password: \nRepeat for confirmation: \n"
+
+
+@pytest.mark.parametrize("show_default", [False, True, None])
+@pytest.mark.parametrize("default", [False, True])
+def test_bool_option_prompt_show_default(runner, show_default, default):
+    @click.command()
+    @click.option(
+        "--value/--no-value", prompt=True, default=default, show_default=show_default
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value is default
+    expected_prompt = "Value"
+
+    if show_default is not False:
+        expected_prompt += " [Y/n]" if default else " [y/N]"
+
+    assert result.output == f"{expected_prompt}: \n"
+
+
 def test_secho(runner):
