+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        (["parent", "child"], "", ["leaf", "other"]),
+        (["parent", "child"], "l", ["leaf"]),
+        (["parent", "child"], "--", ["--child", "--help"]),
+        (
+            ["--root", "r", "parent", "--parent", "p", "child", "--child", "c"],
+            "--",
+            ["--help"],
+        ),
+        (["parent", "child", "leaf"], "--", ["--leaf", "--help"]),
+        (["parent", "child", "leaf", "--leaf"], "", ["one", "two"]),
+        (["parent", "child", "missing"], "", ["leaf", "other"]),
+    ],
+)
+def test_nested_group(args, incomplete, expect):
+    cli = Group(
+        "cli",
+        params=[Option(["--root"])],
+        commands=[
+            Group(
+                "parent",
+                params=[Option(["--parent"])],
+                commands=[
+                    Group(
+                        "child",
+                        params=[Option(["--child"])],
+                        commands=[
+                            Command(
+                                "leaf",
+                                params=[Option(["--leaf"], type=Choice(["one", "two"]))],
+                            ),
+                            Command("other"),
+                        ],
+                    ),
+                    Command("sibling"),
+                ],
+            ),
+            Command("root"),
+        ],
+    )
+    assert _get_words(cli, args, incomplete) == expect
+
