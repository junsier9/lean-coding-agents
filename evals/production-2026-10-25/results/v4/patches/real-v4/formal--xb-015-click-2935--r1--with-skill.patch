+@pytest.mark.parametrize("nested", [False, True])
+def test_chained_last_command(nested):
+    cli = Group(
+        "cli",
+        chain=True,
+        commands=[
+            Command("first", params=[Option(["--first"])]),
+            Command("second", params=[Option(["--second"], type=Choice(["a", "b"]))]),
+            Command("third"),
+        ],
+    )
+    args = ["first", "--first", "value", "second"]
+
+    if nested:
+        cli = Group("root", commands=[cli])
+        args.insert(0, "cli")
+
+    assert _get_words(cli, args, "--") == ["--second", "--help"]
+    assert _get_words(cli, args + ["--second"], "") == ["a", "b"]
+    assert _get_words(cli, args + ["--second", "a"], "--") == ["--help"]
+    assert _get_words(cli, args + ["--second", "a"], "") == ["third"]
+
+
 def test_help_option():
     cli = Group("cli", commands=[Command("with"), Command("no", add_help_option=False)])
