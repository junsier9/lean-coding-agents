 import boltons.funcutils as funcutils
 
 
+@pytest.mark.parametrize('copy_dict', [True, False])
+def test_copy_function_kwonly_defaults(copy_dict):
+    func = lambda x, *, y=2: x * y
+    func.custom = object()
+    func_copy = funcutils.copy_function(func, copy_dict=copy_dict)
+
+    assert func_copy is not func
+    assert func_copy(21) == func(21) == 42
+    assert func_copy(x=21) == func(x=21) == 42
+    assert func_copy(21, y=3) == func(21, y=3) == 63
+    assert hasattr(func_copy, 'custom') == copy_dict
+    if copy_dict:
+        assert func_copy.custom is func.custom
+    with pytest.raises(TypeError):
+        func_copy(21, 2)
+
+
+@pytest.mark.parametrize('copy_dict', [True, False])
+def test_copy_function_required_kwonly(copy_dict):
+    def func(x=21, *, y=2, required):
+        return x * y, required
+
+    func_copy = funcutils.copy_function(func, copy_dict=copy_dict)
+    assert func_copy(required=None) == func(required=None) == (42, None)
+    assert func_copy(7, y=3, required=1) == func(7, y=3, required=1) == (21, 1)
+    for callee in (func, func_copy):
+        with pytest.raises(TypeError):
+            callee(y=2)
+
+
+@pytest.mark.parametrize('copy_dict', [True, False])
+def test_copy_function_kwonly_method(copy_dict):
+    class Multiplier:
+        def multiply(self, x, *, y=2):
+            return x * y
+
+        multiply_copy = funcutils.copy_function(multiply, copy_dict=copy_dict)
+
+    obj = Multiplier()
+    assert obj.multiply_copy(21) == obj.multiply(21) == 42
+    assert Multiplier.multiply_copy(self=obj, x=21) == 42
+
+
