+@pytest.mark.parametrize("show_default", [True, None])
+def test_show_default_with_non_string_comparable_value(runner, show_default):
+    class Value:
+        def __eq__(self, other):
+            if isinstance(other, str):
+                raise ValueError("Cannot compare Value to str.")
+
+            return NotImplemented
+
+        def __str__(self):
+            return "custom value"
+
+    @click.command(context_settings={"show_default": True})
+    @click.option("--value", default=Value(), show_default=show_default)
+    def cli(value):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert "[default: custom value]" in result.output
+
+
