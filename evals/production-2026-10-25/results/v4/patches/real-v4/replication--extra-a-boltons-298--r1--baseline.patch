@@ -313,6 +313,59 @@ def test_navigate():
     assert navd.to_text() == _dest_text
 
 
+@pytest.mark.parametrize('as_url', [False, True])
+@pytest.mark.parametrize('destinations, expected', [
+    (('dd', 'ee'), 'http://a.b/c/ee'),
+    (('dd/', 'ee'), 'http://a.b/c/dd/ee'),
+    (('/C', 'ee'), 'http://a.b/ee'),
+    (('/C/', 'ee'), 'http://a.b/C/ee'),
+    (('/', 'ee'), 'http://a.b/ee'),
+    (('', 'ee'), 'http://a.b/c/ee'),
+    (('dd', '/C'), 'http://a.b/C'),
+    (('dd', '/C/'), 'http://a.b/C/'),
+    (('dd?k=v#frag', ''), 'http://a.b/c/dd?k=v'),
+    (('dd/', ''), 'http://a.b/c/dd/'),
+    (('?k=v#frag', ''), 'http://a.b/c/d?k=v'),
+    (('dd/', '../ee/', './ff', ''), 'http://a.b/c/ee/ff'),
+    (('http://other/x/', 'y', 'z'), 'http://other/x/z'),
+])
+def test_navigate_chained(destinations, expected, as_url):
+    original_text = 'http://a.b/c/d?e#f'
+    chained = URL(original_text)
+    rebuilt = URL(original_text)
+
+    for destination in destinations:
+        dest = URL(destination) if as_url else destination
+        previous = chained
+        previous_text = previous.to_text()
+        rebuilt = URL(rebuilt).navigate(dest)
+        chained = chained.navigate(dest)
+
+        assert chained == rebuilt
+        assert chained is not previous
+        assert previous.to_text() == previous_text
+        if as_url:
+            assert dest.to_text() == destination
+
+    assert chained.to_text() == expected
+
+
+@pytest.mark.parametrize('normalize_base', [False, True])
+@pytest.mark.parametrize('normalize_dest', [False, True])
+def test_navigate_normalized(normalize_base, normalize_dest):
+    base = URL('http://a.b/c/./d')
+    dest = URL('ee/./ff/../gg/')
+    if normalize_base:
+        base.normalize()
+    if normalize_dest:
+        dest.normalize()
+
+    result = base.navigate(dest)
+
+    assert result.to_text() == 'http://a.b/c/ee/gg/'
+    assert isinstance(result.path_parts, tuple)
+
+
