+class CachedMethodInspectionTest(unittest.TestCase):
+    def test_autospec(self):
+        for instance in (False, True):
+            with self.subTest(instance=instance):
+                with warnings.catch_warnings():
+                    warnings.simplefilter("error")
+                    cached = mock.create_autospec(Cached, instance=instance)
+                    self.assertIsInstance(cached.get, mock.Mock)
+                    self.assertIsInstance(cached.get_info, mock.Mock)
+
+    def test_class_access(self):
+        for name in (
+            "get",
+            "get_typed",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        ):
+            with self.subTest(method=name):
+                with warnings.catch_warnings():
+                    warnings.simplefilter("error")
+                    method = getattr(Cached, name)
+                    self.assertEqual(str(inspect.signature(method)), "(self, value)")
+                    self.assertEqual(method.__name__, name)
+                    self.assertEqual(method(Cached({}), 42), 0)
+                    self.assertEqual(method(self=Cached({}), value=42), 0)
+                    with self.assertRaises(TypeError):
+                        method(value=42)
+
+        self.assertEqual(Cached.get.__doc__.strip(), "docstring")
+        with self.assertRaisesRegex(ValueError, "test error"):
+            Cached.get_cond_error(self=Cached({}), _value=42)
+
