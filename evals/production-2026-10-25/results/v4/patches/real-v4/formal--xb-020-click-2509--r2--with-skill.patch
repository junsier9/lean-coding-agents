diff --git a/tests/test_termui.py b/tests/test_termui.py
index 7cfa939..de94d73 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -221,6 +221,84 @@ def test_choices_list_in_prompt(runner, monkeypatch):
     assert "(none, day, week, month)" not in result.output
 
 
+@pytest.mark.parametrize(
+    ("show_default", "default_text"),
+    [
+        (False, ""),
+        (True, " [secret]"),
+        (None, " [secret]"),
+        ("custom default", " [secret]"),
+        ("", " [secret]"),
+    ],
+)
+@pytest.mark.parametrize(("input", "expect"), [("\n", "secret"), ("new\n", "new")])
+def test_option_prompt_show_default(runner, show_default, default_text, input, expect):
+    @click.command()
+    @click.option("--value", default="secret", prompt=True, show_default=show_default)
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input=input, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == expect
+    assert result.output == f"Value{default_text}: {input}"
+
+
+@pytest.mark.parametrize("show_default", [False, True, None])
+@pytest.mark.parametrize("default", [False, True])
+def test_boolean_option_prompt_show_default(runner, show_default, default):
+    @click.command()
+    @click.option(
+        "--value/--no-value", default=default, prompt=True, show_default=show_default
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value is default
+    default_text = ""
+
+    if show_default is not False:
+        default_text = " [Y/n]" if default else " [y/N]"
+
+    assert result.output == f"Value{default_text}: \n"
+
+
+def test_hidden_option_prompt_default(runner):
+    @click.command()
+    @click.option(
+        "--value",
+        default=lambda: "secret",
+        prompt=True,
+        prompt_required=False,
+        hide_input=True,
+        confirmation_prompt=True,
+        show_default=False,
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, ["--value"], input="\nsecret\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == "secret"
+    assert result.output == "Value: \nRepeat for confirmation: \n"
+
+
+def test_option_prompt_hidden_default_retry(runner):
+    @click.command()
+    @click.option("--value", default=42, prompt=True, show_default=False)
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="invalid\n\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == 42
+    assert result.output == (
+        "Value: invalid\nError: 'invalid' is not a valid integer.\nValue: \n"
+    )
+
+
 @pytest.mark.parametrize(
     "file_kwargs", [{"mode": "rt"}, {"mode": "rb"}, {"lazy": True}]
 )
