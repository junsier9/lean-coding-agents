+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('max_size', [1, 1000])
+@pytest.mark.parametrize('stream_type, data', [
+    (ioutils.SpooledBytesIO, b'hello'),
+    (ioutils.SpooledStringIO, 'a\u00e9\u4e2d\U0001f642'),
+])
+def test_spooled_write_counts(stream_type, data, max_size, rolled):
+    with stream_type(max_size=max_size) as stream:
+        if rolled:
+            stream.rollover()
+        assert stream.write(data) == len(data)
+        assert stream.write(data[:0]) == 0
+        assert stream.tell() == len(data)
+        assert stream.getvalue() == data
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('data', [
+    b'abcd',
+    bytearray(b'abcd'),
+    memoryview(b'abcd'),
+    array('H', [0x1234, 0x5678]),
+    memoryview(array('H', [0x1234, 0x5678])),
+    memoryview(b'abcd').cast('B', shape=(2, 2)),
+])
+def test_spooled_bytes_write_buffers(data, rolled):
+    expected = memoryview(data).tobytes()
+    with ioutils.SpooledBytesIO() as stream:
+        if rolled:
+            stream.rollover()
+        assert stream.write(b'!') == 1
+        assert stream.write(data) == len(expected)
+        assert stream.tell() == 1 + len(expected)
+        assert stream.getvalue() == b'!' + expected
+
+
+@pytest.mark.parametrize('data', [
+    array('H', [0x1234, 0x5678]),
+    memoryview(array('H', [0x1234, 0x5678])),
+    memoryview(b'abcd').cast('B', shape=(2, 2)),
+])
+@pytest.mark.parametrize('max_size', [4, 5, 6])
+def test_spooled_bytes_buffer_rollover_uses_byte_size(data, max_size):
+    expected = memoryview(data).tobytes()
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        stream.write(b'!')
+        assert stream.write(data) == len(expected)
+        assert stream._rolled == (1 + len(expected) >= max_size)
+        assert stream.getvalue() == b'!' + expected
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('max_size', [1, 1000])
+def test_spooled_bytes_buffered_writer(max_size, rolled):
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        if rolled:
+            stream.rollover()
+        with io.BufferedWriter(stream, buffer_size=8) as writer:
+            assert writer.write(b'abc') == 3
+            writer.flush()
+            assert stream.getvalue() == b'abc'
+            assert writer.write(b'defghijkl') == 9
+            writer.flush()
+            assert stream.tell() == 12
+            assert stream.getvalue() == b'abcdefghijkl'
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_bytes_rejects_invalid_buffers_without_moving(rolled):
+    with ioutils.SpooledBytesIO(max_size=4) as stream:
+        stream.write(b'abc')
+        if rolled:
+            stream.rollover()
+        for data, error in [('text', TypeError), ([1, 2], TypeError),
+                            (memoryview(b'abcdef')[::2], BufferError)]:
+            with pytest.raises(error):
+                stream.write(data)
+            assert stream.tell() == 3
+            assert stream._rolled == rolled
+            assert stream.getvalue() == b'abc'
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_string_backward_seek_codepoints(rolled):
+    data = 'a\u00e9\u4e2d\U0001f642bc\u5c3e'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(data)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == data[:3]
+        assert stream.seek(-2, os.SEEK_CUR) == 1
+        assert stream.read(3) == data[1:4]
+        assert stream.tell() == 4
+        assert stream.seek(-4, os.SEEK_CUR) == 0
+        assert stream.read() == data
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_string_seek_across_chunks(rolled):
+    data = 'a\u00e9\u4e2d\U0001f642' * (ioutils.READ_CHUNK_SIZE + 1)
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(data)
+        if rolled:
+            stream.rollover()
+        position = ioutils.READ_CHUNK_SIZE + 2
+        assert stream.seek(position) == position
+        assert stream.read(5) == data[position:position + 5]
+        assert stream.seek(-ioutils.READ_CHUNK_SIZE, os.SEEK_CUR) == 7
+        assert stream.read(5) == data[7:12]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('offset', [-3, -1, 0, 2])
+def test_spooled_string_seek_from_end(rolled, offset):
+    data = 'a\u00e9\u4e2d\U0001f642bc\u5c3e'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(data)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        stream.read(3)
+        position = len(data) + offset
+        assert stream.seek(offset, os.SEEK_END) == position
+        assert stream.tell() == position
+        assert stream.read() == data[position:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('offset, whence, error', [
+    (-1, os.SEEK_SET, ValueError),
+    (-4, os.SEEK_CUR, ValueError),
+    (-8, os.SEEK_END, ValueError),
+    (0, 3, ValueError),
+    (1.5, os.SEEK_SET, TypeError),
+])
+def test_spooled_string_invalid_seek_preserves_position(rolled, offset, whence, error):
+    data = 'a\u00e9\u4e2d\U0001f642bc\u5c3e'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(data)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == data[:3]
+        with pytest.raises(error):
+            stream.seek(offset, whence)
+        assert stream.tell() == 3
+        assert stream.read() == data[3:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_string_length_preserves_position(rolled):
+    data = '\u00e9abc\u4e2d\U0001f642\u5c3e'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(data)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == data[:3]
+        assert len(stream) == len(data)
+        assert stream.tell() == 3
+        assert stream.read() == data[3:]
+
