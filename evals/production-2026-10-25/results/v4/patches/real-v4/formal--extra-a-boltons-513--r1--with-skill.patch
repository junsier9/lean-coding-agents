+@pytest.mark.parametrize('io_type, data', [
+    (ioutils.SpooledBytesIO, b'hello'),
+    (ioutils.SpooledStringIO, 'a\u00e9\u4e2d\U0001f600'),
+])
+@pytest.mark.parametrize('max_size', [1, 1024])
+def test_spooled_write_count(io_type, data, max_size):
+    with io_type(max_size=max_size) as stream:
+        assert stream.write(data) == len(data)
+        assert io_type.write(self=stream, s=data) == len(data)
+        assert stream.write(data[:0]) == 0
+        assert stream.tell() == 2 * len(data)
+        assert stream.getvalue() == data * 2
+        assert stream.tell() == 2 * len(data)
+
+
+@pytest.mark.parametrize('data', [
+    bytearray(b'abcd'),
+    memoryview(b'_abcd_')[1:-1],
+    array('I', [1, 2, 3]),
+    memoryview(array('I', [1, 2, 3])),
+    memoryview(b'abcd').cast('B', shape=(2, 2)),
+])
+@pytest.mark.parametrize('max_size', [1, 1024])
+def test_spooled_bytes_write_buffer(data, max_size):
+    expected = memoryview(data).tobytes()
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        assert stream.write(data) == len(expected)
+        assert stream.tell() == len(expected)
+        assert stream.getvalue() == expected
+        assert stream._rolled == (max_size == 1)
+
+
+def test_spooled_bytes_buffer_rollover_uses_nbytes():
+    data = memoryview(array('I', [1, 2, 3]))
+    with ioutils.SpooledBytesIO(max_size=1 + data.nbytes) as stream:
+        assert stream.write(b'x') == 1
+        assert stream.write(data[:-1]) == data[:-1].nbytes
+        assert not stream._rolled
+        assert stream.write(data[-1:]) == data[-1:].nbytes
+        assert stream._rolled
+        assert stream.getvalue() == b'x' + data.tobytes()
+
+
+@pytest.mark.parametrize('max_size', [1, 1024])
+def test_spooled_bytes_buffered_writer(max_size):
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        with io.BufferedWriter(stream, buffer_size=16) as writer:
+            assert writer.write(b'hello') == 5
+            writer.flush()
+            assert stream.tell() == 5
+            assert stream.getvalue() == b'hello'
+            assert writer.write(b' world') == 6
+            writer.flush()
+            assert stream.getvalue() == b'hello world'
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('text', [
+    'a\u00e9\u4e2d\U0001f600b\u00e7\u5c3e',
+    'a\u00e9\u4e2d\U0001f600' * (ioutils.READ_CHUNK_SIZE // 4 + 3),
+], ids=['short', 'chunked'])
+def test_spooled_string_seek_backward(text, rolled):
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(2)
+        assert stream.read(3) == text[2:5]
+        assert stream.seek(-3, os.SEEK_CUR) == 2
+        assert stream.read(2) == text[2:4]
+        stream.seek(0, os.SEEK_END)
+        assert stream.seek(-len(text) + 1, os.SEEK_CUR) == 1
+        assert stream.read() == text[1:]
+        assert stream.seek(-2, os.SEEK_END) == len(text) - 2
+        assert stream.read() == text[-2:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('mode', [os.SEEK_SET, os.SEEK_CUR, os.SEEK_END])
+def test_spooled_string_negative_seek_preserves_position(mode, rolled):
+    text = 'a\u00e9\u4e2d\U0001f600b\u00e7\u5c3e'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == text[:3]
+        offset = {os.SEEK_SET: -1, os.SEEK_CUR: -4,
+                  os.SEEK_END: -len(text) - 1}[mode]
+        with pytest.raises(ValueError):
+            stream.seek(offset, mode)
+        assert stream.tell() == 3
+        assert stream.read() == text[3:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_string_length_preserves_position(rolled):
+    text = 'a\u00e9\u4e2d\U0001f600b\u00e7\u5c3e'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == text[:3]
+        assert len(stream) == len(text)
+        assert stream.tell() == 3
+        assert stream.read() == text[3:]
+
+
