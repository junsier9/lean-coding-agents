+@pytest.mark.parametrize('timeout, duration', [
+    pytest.param(0.5, timedelta(seconds=0.5), id='float'),
+    pytest.param(timedelta(seconds=0.5), timedelta(seconds=0.5), id='timedelta'),
+    pytest.param(1, timedelta(seconds=1), id='int'),
+])
+def test_limit_error_rate_timeout(monkeypatch, timeout, duration):
+    now = datetime(2026, 1, 1)
+
+    class Clock:
+        @staticmethod
+        def now():
+            return now
+
+    monkeypatch.setattr('funcy.flow.datetime', Clock)
+    calls = []
+
+    @limit_error_rate(2, timeout)
+    def limited(value):
+        calls.append(value)
+        if value < 0:
+            raise MyError
+        return value
+
+    assert limited(0) == 0
+    with pytest.raises(MyError): limited(-1)
+    assert limited.blocked is None
+    with pytest.raises(MyError): limited(-2)
+
+    blocked_at = now
+    for elapsed in (timedelta(0), duration - timedelta(microseconds=1)):
+        now = blocked_at + elapsed
+        with pytest.raises(ErrorRateExceeded): limited(1)
+        assert calls == [0, -1, -2]
+
+    now = blocked_at + duration
+    assert limited(2) == 2
+    assert calls == [0, -1, -2, 2]
+    assert limited.fails == 0
+    assert limited.blocked is None
+
+
