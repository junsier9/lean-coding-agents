+@pytest.mark.parametrize('is_classmethod', [False, True])
+def test_decorator_access_bound_method_posonly(is_classmethod):
+    @decorator
+    def access_args(call):
+        values = call.receiver, call.x, call.y, call.args, call.kwargs
+        assert values == call()
+        return values
+
+    class A:
+        def method(receiver, x, /, y=11, *args, **kwargs):
+            return receiver, x, y, args, kwargs
+
+        def default(receiver, x=11, /, **kwargs):
+            return x
+
+        if is_classmethod:
+            method = classmethod(method)
+            default = classmethod(default)
+
+    instance = A()
+    receiver = A if is_classmethod else instance
+    decorated = access_args(instance.method)
+    assert decorated(10) == (receiver, 10, 11, (), {})
+    assert decorated(10, 20, 30, x=40, receiver=50, extra=60) == (
+        receiver, 10, 20, (30,), {'x': 40, 'receiver': 50, 'extra': 60})
+    assert decorated(10, y=20) == (receiver, 10, 20, (), {})
+    with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+        decorated(x=10)
+
+    @decorator
+    def return_x(call):
+        assert call.x == call()
+        return call.x
+
+    default = return_x(instance.default)
+    assert default() == 11
+    assert default(x=20) == 11
