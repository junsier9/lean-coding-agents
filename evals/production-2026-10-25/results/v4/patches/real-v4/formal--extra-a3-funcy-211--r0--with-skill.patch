+@pytest.mark.parametrize('is_classmethod', [False, True])
+@pytest.mark.parametrize('inner_decorated', [False, True])
+@pytest.mark.parametrize('outer_decorated', [False, True])
+def test_decorator_access_bound_method_args(is_classmethod, inner_decorated, outer_decorated):
+    @decorator
+    def noop(call):
+        return call()
+
+    @decorator
+    def access_args(call):
+        values = (call.receiver, call.x, call.y, call.args,
+                  call.required, call.optional, call.kwargs)
+        assert values == call()
+        return values
+
+    class A:
+        def method(receiver, x, y=11, *args, required, optional=12, **kwargs):
+            return receiver, x, y, args, required, optional, kwargs
+
+        if inner_decorated:
+            method = noop(method)
+        if is_classmethod:
+            method = classmethod(method)
+
+    instance = A()
+    receiver = A if is_classmethod else instance
+    method = instance.method
+    if outer_decorated:
+        method = noop(method)
+    decorated = access_args(method)
+
+    assert decorated(10, required=13) == (receiver, 10, 11, (), 13, 12, {})
+    assert decorated(x=10, y=20, required=30, optional=40, extra=50) == (
+        receiver, 10, 20, (), 30, 40, {'extra': 50})
+    assert decorated(10, 20, 30, 40, required=50, args=60, kwargs=70) == (
+        receiver, 10, 20, (30, 40), 50, 12, {'args': 60, 'kwargs': 70})
+
+    with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+        decorated(required=13)
+    with pytest.raises(AttributeError, match="missing required argument: 'required'"):
+        decorated(10)
+    with pytest.raises(TypeError, match="multiple values for argument 'x'"):
+        decorated(10, x=20, required=13)
+
+
+def test_decorator_method_receiver_keyword():
+    @decorator
+    def access_args(call):
+        return call.receiver, call.x, call()
+
+    class A:
+        @access_args
+        def method(receiver, x):
+            return receiver, x
+
+    instance = A()
+    expected = (instance, 10, (instance, 10))
+    assert instance.method(x=10) == expected
+    assert A.method(receiver=instance, x=10) == expected
+
+
+@pytest.mark.parametrize('is_classmethod', [False, True])
+def test_decorator_bound_method_variadic_receiver(is_classmethod):
+    @decorator
+    def access_args(call):
+        assert call.args == call()
+        return call.args
+
+    class A:
+        def method(*args):
+            return args
+
+        if is_classmethod:
+            method = classmethod(method)
+
+    instance = A()
+    receiver = A if is_classmethod else instance
+    decorated = access_args(instance.method)
+    assert decorated() == (receiver,)
+    assert decorated(1, 2) == (receiver, 1, 2)
+
+
