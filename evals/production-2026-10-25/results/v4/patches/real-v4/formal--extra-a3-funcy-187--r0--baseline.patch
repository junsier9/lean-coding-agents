 from threading import Thread
 import pytest
 from funcy.flow import *
@@ -154,6 +154,47 @@ def test_limit_error_rate():
     assert calls == [1, 2]
 
 
+@pytest.mark.parametrize('timeout, seconds', [
+    (0.5, 0.5), (timedelta(seconds=0.5), 0.5),
+    (1, 1), (timedelta(seconds=1), 1),
+])
+@pytest.mark.parametrize('exception', [ErrorRateExceeded, MyError])
+def test_limit_error_rate_timeout(monkeypatch, timeout, seconds, exception):
+    class Clock:
+        current = datetime(2026, 1, 1)
+
+        @classmethod
+        def now(cls):
+            return cls.current
+
+    monkeypatch.setattr('funcy.flow.datetime', Clock)
+    calls = []
+
+    @limit_error_rate(2, timeout, exception)
+    def limited(x):
+        calls.append(x)
+        if x < 3:
+            raise ValueError
+        return x
+
+    with pytest.raises(ValueError): limited(1)
+    with pytest.raises(ValueError): limited(2)
+
+    blocked_at = Clock.current
+    duration = timedelta(seconds=seconds)
+    for elapsed in (timedelta(0), duration - timedelta(microseconds=1)):
+        Clock.current = blocked_at + elapsed
+        with pytest.raises(exception): limited(3)
+        assert calls == [1, 2]
+
+    Clock.current = blocked_at + duration
+    assert limited(3) == 3
+    assert limited.fails == 0
+    assert limited.blocked is None
+    assert limited(4) == 4
+    assert calls == [1, 2, 3, 4]
+
+
