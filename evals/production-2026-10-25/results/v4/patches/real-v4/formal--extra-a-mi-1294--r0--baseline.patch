+    def test_maxlen_zero_observations(self):
+        values = [None, False, 0, '', object()]
+        pulled = []
+
+        def source():
+            for value in values:
+                pulled.append(value)
+                yield value
+
+        s = mi.seekable(source(), maxlen=0)
+        elements = s.elements()
+        for index, value in enumerate(values):
+            for _ in range(10):
+                self.assertIs(s.peek(), value)
+                self.assertTrue(s)
+                self.assertEqual(list(elements), [])
+            self.assertEqual(len(pulled), index + 1)
+            with self.assertRaises(IndexError):
+                s[0]
+            self.assertIs(next(s), value)
+            self.assertEqual(list(elements), [])
+
+        default = object()
+        for _ in range(3):
+            self.assertFalse(s)
+            self.assertIs(s.peek(default), default)
+            self.assertRaises(StopIteration, s.peek)
+            self.assertRaises(StopIteration, next, s)
+        self.assertEqual(list(elements), [])
+
+    def test_maxlen_zero_peek_then_iterate(self):
+        s = mi.seekable(range(5), maxlen=0)
+        self.assertEqual(next(s), 0)
+        self.assertTrue(s)
+        self.assertEqual(s.peek(), 1)
+        self.assertEqual(s.peek(), 1)
+        self.assertEqual(list(s), [1, 2, 3, 4])
+        self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_peek_then_seek(self):
+        cases = [
+            ('seek', 0, [1, 2, 3, 4]),
+            ('seek', 2, [3, 4]),
+            ('seek', 10, []),
+            ('relative_seek', 0, [1, 2, 3, 4]),
+            ('relative_seek', -2, [1, 2, 3, 4]),
+            ('relative_seek', 2, [3, 4]),
+            ('relative_seek', 10, []),
+        ]
+        for method, index, expected in cases:
+            with self.subTest(method=method, index=index):
+                s = mi.seekable(range(5), maxlen=0)
+                elements = s.elements()
+                self.assertEqual(next(s), 0)
+                self.assertEqual(s.peek(), 1)
+                self.assertTrue(s)
+                getattr(s, method)(index)
+                self.assertEqual(list(elements), [])
+                self.assertEqual(s.peek(None), next(iter(expected), None))
+                self.assertEqual(list(s), expected)
+                self.assertEqual(list(elements), [])
+
+    def test_maxlen_zero_observation_memory(self):
+        if not tracemalloc.is_tracing():
+            tracemalloc.start()
+            self.addCleanup(tracemalloc.stop)
+
+        for advance in (False, True):
+            with self.subTest(advance=advance):
+                s = mi.seekable(repeat(None), maxlen=0)
+
+                def observe(times):
+                    for _ in range(times):
+                        s.peek()
+                        bool(s)
+                        if advance:
+                            next(s)
+
+                observe(100)
+                gc.collect()
+                before = tracemalloc.get_traced_memory()[0]
+                observe(10_000)
+                gc.collect()
+                retained = tracemalloc.get_traced_memory()[0] - before
+                # Allow allocator noise, but reject accumulating wrappers.
+                self.assertLess(retained, 32 * 1024)
+                self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_releases_peeked_item(self):
+        class Item:
+            def __init__(self, value):
+                self.value = value
+
+        s = mi.seekable(map(Item, range(2)), maxlen=0)
+        ref = weakref.ref(s.peek())
+        gc.collect()
+        self.assertIsNotNone(ref())
+        self.assertTrue(s)
+        next(s)
+        gc.collect()
+        self.assertIsNone(ref())
+        self.assertEqual(list(s.elements()), [])
+
