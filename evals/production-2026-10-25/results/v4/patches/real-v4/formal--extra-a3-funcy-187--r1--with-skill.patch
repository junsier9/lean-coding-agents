+@pytest.mark.parametrize('seconds', [0.5, 1])
+@pytest.mark.parametrize('typ', [
+    pytest.param(lambda s: s, id='seconds'),
+    pytest.param(lambda s: timedelta(seconds=s), id='timedelta'),
+])
+def test_limit_error_rate_timeout(monkeypatch, seconds, typ):
+    now = datetime(2026, 1, 1)
+
+    class Clock:
+        @staticmethod
+        def now():
+            return now
+
+    monkeypatch.setattr('funcy.flow.datetime', Clock)
+    calls = []
+
+    class Service:
+        @limit_error_rate(2, typ(seconds))
+        def limited(self, fail):
+            calls.append(fail)
+            if fail:
+                raise MyError
+            return 42
+
+    service = Service()
+    with pytest.raises(MyError):
+        service.limited(True)
+    assert service.limited(False) == 42
+
+    for _ in range(2):
+        with pytest.raises(MyError):
+            service.limited(True)
+
+    with pytest.raises(ErrorRateExceeded):
+        Service.limited(self=service, fail=False)
+    now += timedelta(seconds=seconds) - timedelta(microseconds=1)
+    with pytest.raises(ErrorRateExceeded):
+        service.limited(False)
+    assert calls == [True, False, True, True]
+
+    now += timedelta(microseconds=1)
+    assert Service.limited(self=service, fail=False) == 42
+    assert service.limited.blocked is None
+    assert service.limited.fails == 0
+
+    with pytest.raises(MyError):
+        service.limited(True)
+    assert service.limited(False) == 42
+    assert calls == [True, False, True, True, False, True, False]
+
+
