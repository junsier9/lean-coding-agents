+class MethodDescriptorTest(unittest.TestCase):
+
+    def test_class_access(self):
+        for owner in (Cached, Unhashable):
+            for name in (
+                "get",
+                "get_typed",
+                "get_info",
+                "get_lock",
+                "get_lock_info",
+                "get_cond",
+                "get_cond_error",
+                "get_cond_info",
+                "get_lock_cond",
+                "get_lock_cond_info",
+            ):
+                with self.subTest(owner=owner, method=name):
+                    with warnings.catch_warnings():
+                        warnings.simplefilter("error")
+                        descriptor = Cached.__dict__[name]
+                        self.assertIs(getattr(owner, name), descriptor)
+                        self.assertIs(descriptor.__get__(None), descriptor)
+
+    def test_autospec(self):
+        for owner in (Cached, Unhashable):
+            for instance in (False, True):
+                with self.subTest(owner=owner, instance=instance):
+                    with warnings.catch_warnings():
+                        warnings.simplefilter("error")
+                        mocked = create_autospec(owner, instance=instance)
+                        if not instance:
+                            mocked = mocked({})
+                        mocked.get(42)
+                        mocked.get.assert_called_once_with(42)
+
