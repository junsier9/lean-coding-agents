     assert bl3[6] == -3  # some truly tricky stepping/slicing works
 
+
+def test_barrel_list_sort_after_split_and_deletion():
+    expected = list(range(100000, 0, -1))
+    bl = BarrelList(expected)
+    assert bl.pop(50000) == expected.pop(50000)
+    assert len(bl.lists) > 1
+
+    del bl[10:5000]
+    del expected[10:5000]
+    expected.sort()
+    lists = bl.lists
+
+    assert bl.sort() is None
+    assert bl.lists is lists
+    assert list(bl) == expected
+    assert len(bl) == len(expected)
+    assert bl[0] == expected[0]
+    assert bl[-1] == expected[-1]
+    assert len(bl.lists) > 1
+    assert all(0 < len(part) <= bl._cur_size_limit for part in bl.lists)
+
