+@pytest.fixture
+def socket_pair():
+    x, y = socket.socketpair()
+    try:
+        yield x, y
+    finally:
+        x.close()
+        y.close()
+
+
+class _OneByteSocket(object):
+    """Record actual socket timeouts while forcing fragmented reads."""
+    def __init__(self, sock):
+        self.sock = sock
+        self.timeouts = []
+
+    def __getattr__(self, name):
+        return getattr(self.sock, name)
+
+    def recv(self, size):
+        self.timeouts.append(self.sock.gettimeout())
+        return self.sock.recv(min(size, 1))
+
+
+@pytest.mark.parametrize('timeout', [None, 0, 0.5])
+@pytest.mark.parametrize('use_default', [False, True])
+def test_netstring_read_timeout(socket_pair, timeout, use_default):
+    x, y = socket_pair
+    sock = _OneByteSocket(x)
+    client = NetstringSocket(sock, timeout=2)
+    if use_default:
+        client.settimeout(timeout)
+        kwargs = {}
+    else:
+        kwargs = {'timeout': timeout}
+
+    y.sendall(b'1:a,')
+    assert client.read_ns(**kwargs) == b'a'
+    # Both prefix bytes, the payload, and the comma require socket reads.
+    assert len(sock.timeouts) == 4
+    for actual in sock.timeouts:
+        if timeout:
+            assert 0 < actual <= timeout
+        else:
+            assert actual == timeout
+    assert client.timeout == (timeout if use_default else 2)
+
+
+@pytest.mark.parametrize('default_maxsize, maxsize',
+                         [(1, 100), (100, 3), (10, 0), (0, 1)])
+def test_netstring_read_maxsize_override(socket_pair, default_maxsize, maxsize):
+    x, y = socket_pair
+    client = NetstringSocket(x, maxsize=default_maxsize)
+    payload = b'a' * maxsize
+    y.sendall(str(len(payload)).encode('ascii') + b':' + payload + b',')
+    assert client.read_ns(maxsize=maxsize) == payload
+    assert client.maxsize == default_maxsize
+
+    # The override must not change the limit (or prefix limit) of later reads.
+    payload = b'b' * default_maxsize
+    y.sendall(str(len(payload)).encode('ascii') + b':' + payload + b',')
+    assert client.read_ns() == payload
+
+
+@pytest.mark.parametrize('default_maxsize, maxsize',
+                         [(100, 3), (100, 0), (1, 100)])
+def test_netstring_read_maxsize_rejects(socket_pair, default_maxsize, maxsize):
+    x, y = socket_pair
+    client = NetstringSocket(x, maxsize=default_maxsize)
+    # Reject an oversized declaration without waiting for its payload.
+    y.sendall(str(maxsize + 1).encode('ascii') + b':')
+    y.shutdown(socket.SHUT_WR)
+    with pytest.raises(NetstringMessageTooLong) as exc_info:
+        client.read_ns(maxsize=maxsize)
+    assert '%s > %s' % (maxsize + 1, maxsize) in str(exc_info.value)
+    assert client.maxsize == default_maxsize
+
+
+@pytest.mark.parametrize('kwargs', [{}, {'maxsize': 1}, {'maxsize': 1000}])
+def test_netstring_read_prefix_limit(socket_pair, kwargs):
+    x, y = socket_pair
+    client = NetstringSocket(x, maxsize=10)
+    maxsize = kwargs.get('maxsize', client.maxsize)
+    y.sendall(b'0' * (len(str(maxsize)) + 1) + b':')
+    y.shutdown(socket.SHUT_WR)
+    with pytest.raises(MessageTooLong):
+        client.read_ns(**kwargs)
+
+
+@pytest.mark.parametrize('wire, error', [(b'x:a,', NetstringInvalidSize),
+                                         (b'1:a;', NetstringProtocolError)])
+def test_netstring_read_protocol_errors(socket_pair, wire, error):
+    x, y = socket_pair
+    client = NetstringSocket(x, maxsize=1)
+    y.sendall(wire)
+    with pytest.raises(error):
+        client.read_ns(timeout=None, maxsize=100)
+
+
