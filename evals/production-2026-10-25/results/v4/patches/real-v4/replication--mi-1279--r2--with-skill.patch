+class OneOnlyExceptionTests(TestCase):
+    def test_custom_exception_instances(self):
+        class FalsyError(Exception):
+            def __bool__(self):
+                return False
+
+        for func, values, keyword in (
+            (mi.one, [], 'too_short'),
+            (mi.one, [1, 2], 'too_long'),
+            (mi.only, [1, 2], 'too_long'),
+        ):
+            for error in (RuntimeError('custom'), FalsyError('custom')):
+                with self.subTest(func=func, keyword=keyword, error=error):
+                    with self.assertRaises(type(error)) as caught:
+                        func(iter(values), **{keyword: error})
+                    self.assertIs(caught.exception, error)
+
+    def test_custom_exception_does_not_format_items(self):
+        class BrokenRepr:
+            def __repr__(self):
+                raise RuntimeError('repr failed')
+
+        item = BrokenRepr()
+        for func in (mi.one, mi.only):
+            for values in ([item, 2, 3], [1, item, 3]):
+                for error in (OverflowError, OverflowError('custom')):
+                    with self.subTest(func=func, error=error):
+                        iterator = iter(values)
+                        with self.assertRaises(OverflowError) as caught:
+                            func(iterator, too_long=error)
+                        if isinstance(error, BaseException):
+                            self.assertIs(caught.exception, error)
+                        self.assertEqual(next(iterator), 3)
+
+    def test_default_exception_messages(self):
+        too_long_message = (
+            'Expected exactly one item in iterable, '
+            "but got 'foo', 'bar', and perhaps more."
+        )
+        for func, values, keyword, message in (
+            (
+                mi.one,
+                [],
+                'too_short',
+                'too few items in iterable (expected 1)',
+            ),
+            (mi.one, ['foo', 'bar', 'baz'], 'too_long', too_long_message),
+            (mi.only, ['foo', 'bar', 'baz'], 'too_long', too_long_message),
+        ):
+            for kwargs in ({}, {keyword: None}):
+                with self.subTest(func=func, kwargs=kwargs):
+                    with self.assertRaises(ValueError) as caught:
+                        func(values, **kwargs)
+                    self.assertEqual(str(caught.exception), message)
+
+    def test_default_exception_preserves_repr_failure(self):
+        class BrokenRepr:
+            def __repr__(self):
+                raise RuntimeError('repr failed')
+
+        item = BrokenRepr()
+        for func in (mi.one, mi.only):
+            for values in ([item, 2], [1, item]):
+                with self.subTest(func=func):
+                    with self.assertRaisesRegex(RuntimeError, 'repr failed'):
+                        func(values)
+
+
