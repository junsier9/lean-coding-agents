+    def test_maxlen_zero_peek(self):
+        iterable = [None, False, [], object()]
+        s = mi.seekable(iterable, maxlen=0)
+        elements = s.elements()
+        for item in iterable:
+            for _ in range(5):
+                self.assertIs(s.peek(), item)
+                self.assertIs(mi.seekable.peek(self=s), item)
+                self.assertTrue(s)
+                self.assertEqual(list(elements), [])
+                self.assertEqual(list(s.elements()), [])
+            with self.assertRaises(IndexError):
+                s[0]
+            self.assertIs(next(s), item)
+
+        self.assertFalse(s)
+        default = object()
+        self.assertIs(mi.seekable.peek(self=s, default=default), default)
+        with self.assertRaises(StopIteration):
+            s.peek()
+
+    def test_maxlen_zero_observation_storage(self):
+        s = mi.seekable(repeat(None), maxlen=0)
+        tracemalloc.start()
+        try:
+            for _ in range(100):
+                s.peek()
+                bool(s)
+            before = tracemalloc.get_traced_memory()[0]
+            for _ in range(10000):
+                s.peek()
+                bool(s)
+            after = tracemalloc.get_traced_memory()[0]
+        finally:
+            tracemalloc.stop()
+
+        self.assertLess(after - before, 16 * 1024)
+        self.assertIsNone(next(s))
+        self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_peek_iteration(self):
+        for observe in (lambda s: s.peek(), bool):
+            with self.subTest(observe=observe):
+                s = mi.seekable(range(5), maxlen=0)
+                for _ in range(100):
+                    observe(s)
+                self.assertEqual(list(s), list(range(5)))
+                self.assertEqual(list(s.elements()), [])
+                self.assertFalse(s)
+
+    def test_maxlen_zero_peek_seek(self):
+        for method, offset, start in (
+            ('seek', 0, 0),
+            ('seek', 2, 2),
+            ('seek', 20, 5),
+            ('relative_seek', -3, 0),
+            ('relative_seek', 0, 0),
+            ('relative_seek', 2, 2),
+            ('relative_seek', 20, 5),
+        ):
+            with self.subTest(method=method, offset=offset):
+                s = mi.seekable(range(5), maxlen=0)
+                self.assertEqual(s.peek(), 0)
+                getattr(s, method)(offset)
+                self.assertEqual(list(s), list(range(start, 5)))
+                s.seek(0)
+                self.assertEqual(list(s), [])
+                self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_peek_errors(self):
+        def source():
+            yield 0
+            raise ValueError('source failed')
+
+        for observe in (lambda s: s.peek(default=None), bool, next):
+            with self.subTest(observe=observe):
+                s = mi.seekable(source(), maxlen=0)
+                self.assertEqual(s.peek(), 0)
+                self.assertEqual(next(s), 0)
+                with self.assertRaisesRegex(ValueError, 'source failed'):
+                    observe(s)
+
+    def test_maxlen_zero_releases_consumed_items(self):
+        source = IteratorWithWeakReferences.FROM_SIZE(3)
+        s = mi.seekable(source, maxlen=0)
+        for i in range(3):
+            self.assertIs(s.peek(), s.peek())
+            next(s)
+            gc.collect()
+            self.assertEqual(
+                source.weakReferencesState(),
+                [False] * (i + 1) + [True] * (2 - i),
+            )
+
