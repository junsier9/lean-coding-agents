+@pytest.mark.parametrize("opt", ["-o", "--opt"])
+@pytest.mark.parametrize(
+    ("type", "default", "flag_value", "value"),
+    [
+        (str, "default", "flag", "value"),
+        (str, None, "flag", "value"),
+        (str, "default", "", "value"),
+        (str, "default", None, "value"),
+        (int, 1, 2, 3),
+        (int, None, 2, 3),
+        (int, 1, 0, 3),
+    ],
+)
+def test_option_with_optional_value_and_default(
+    runner, opt, type, default, flag_value, value
+):
+    @click.command()
+    @click.option(
+        "-o", "--opt", is_flag=False, flag_value=flag_value, default=default, type=type
+    )
+    def cli(opt):
+        return opt
+
+    for args, expected in [([], default), ([opt], flag_value), ([opt, str(value)], value)]:
+        result = runner.invoke(cli, args, standalone_mode=False)
+        assert result.exception is None, result.output
+        assert result.return_value == expected
+
+
+@pytest.mark.parametrize("default", [UNSET, None, "default"])
+def test_non_flag_option_requires_value(runner, default):
+    @click.command()
+    @click.option("--opt", is_flag=False, default=default)
+    def cli(opt):
+        pytest.fail("A missing option value must not invoke the command.")
+
+    result = runner.invoke(cli, ["--opt"])
+    assert result.exit_code == 2
+    assert "Option '--opt' requires an argument." in result.output
+
+
+def test_option_with_optional_value_invalid_integer(runner):
+    @click.command()
+    @click.option("--opt", is_flag=False, flag_value=2, default=1, type=int)
+    def cli(opt):
+        pytest.fail("An invalid integer must not invoke the command.")
+
+    result = runner.invoke(cli, ["--opt", "invalid"])
+    assert result.exit_code == 2
+    assert "'invalid' is not a valid integer." in result.output
+
