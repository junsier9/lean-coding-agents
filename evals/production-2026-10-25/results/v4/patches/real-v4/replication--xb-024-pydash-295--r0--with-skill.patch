 import pytest
 
@@ -823,6 +824,43 @@ def test_reduce_(case, expected):
     assert _.reduce_(*case) == expected
 
 
+@parametrize("mapping_type", [dict, MappingProxyType])
+@parametrize(
+    "data,expected",
+    [({}, None), ({"a": 7}, 7), ({"a": 1, "b": 2, "c": 3}, 6)],
+)
+def test_reduce_mapping_without_accumulator(mapping_type, data, expected):
+    collection = mapping_type(data)
+    calls = []
+
+    def iteratee(total, value, key):
+        calls.append((key, value))
+        return total + value
+
+    if not data:
+        with pytest.raises(
+            TypeError, match=r"^reduce_\(\) of empty sequence with no initial value$"
+        ):
+            _.reduce_(collection, iteratee)
+    else:
+        assert _.reduce_(collection, iteratee) == expected
+
+    assert calls == list(data.items())[1:]
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+@parametrize("data,expected", [({}, 10), ({"a": 1, "b": 2, "c": 3}, 16)])
+def test_reduce_mapping_with_accumulator(mapping_type, data, expected):
+    calls = []
+
+    def iteratee(total, value, key):
+        calls.append((key, value))
+        return total + value
+
+    assert _.reduce_(mapping_type(data), iteratee, 10) == expected
+    assert calls == list(data.items())
+
