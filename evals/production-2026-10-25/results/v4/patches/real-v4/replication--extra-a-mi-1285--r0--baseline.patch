+    def test_missing_getitem_does_not_add_keys(self):
+        for iterable in ('', 'abac'):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: x)
+                for missing in 'xyx':
+                    self.assertEqual(list(D[missing]), [])
+                    self.assertEqual(set(D), set(iterable))
+
+                for key in set(iterable):
+                    self.assertEqual(list(D[key]), [key] * iterable.count(key))
+
+    def test_missing_contains_does_not_add_keys(self):
+        for iterable in ('', 'abac'):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: x)
+                for missing in 'xyx':
+                    self.assertNotIn(missing, D)
+                    self.assertEqual(set(D), set(iterable))
+
+                for key in set(iterable):
+                    self.assertEqual(list(D[key]), [key] * iterable.count(key))
+
+    def test_consumed_key_is_retained(self):
+        D = mi.bucket(['a1'], key=lambda x: x[0])
+        values = D['a']
+        self.assertEqual(next(values), 'a1')
+        self.assertEqual(list(D), ['a'])
+        self.assertEqual(list(values), [])
+        self.assertNotIn('a', D)
+        self.assertEqual(list(D['a']), [])
+        self.assertEqual(list(D), ['a'])
+
+    def test_missing_key_with_validator(self):
+        D = mi.bucket('abac', key=lambda x: x, validator=lambda x: x != 'b')
+        self.assertEqual(list(D['x']), [])
+        self.assertNotIn('y', D)
+        self.assertEqual(set(D), {'a', 'c'})
+        self.assertEqual(list(D['a']), ['a', 'a'])
+        self.assertEqual(list(D['c']), ['c'])
+        self.assertEqual(list(D['b']), [])
+        self.assertEqual(set(D), {'a', 'c'})
+
+    def test_rejected_key_does_not_advance(self):
+        iterable = iter('ab')
+        D = mi.bucket(iterable, key=lambda x: x, validator=lambda x: x != 'b')
+        self.assertEqual(list(D['b']), [])
+        self.assertNotIn('b', D)
+        self.assertEqual(next(iterable), 'a')
+        self.assertEqual(list(D), [])
+
