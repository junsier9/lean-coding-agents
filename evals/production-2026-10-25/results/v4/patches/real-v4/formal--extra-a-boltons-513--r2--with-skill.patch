 import io
 import os
 import codecs
+import array
 import random
 import string
 
+import pytest
+
 from tempfile import mkdtemp
 from unittest import TestCase
 from zipfile import ZipFile, ZIP_DEFLATED
@@ -449,6 +452,159 @@ class TestSpooledStringIO(TestCase, BaseTestMixin, AssertionsMixin):
         self.assertEqual(self.spooled_flo.getvalue(), expected)
 
 
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('stream_type, data', [
+    (ioutils.SpooledBytesIO, b'binary data'),
+    (ioutils.SpooledStringIO, 'a\u00e9\u4e2d\U0001f642z'),
+])
+def test_spooled_write_count(stream_type, data, rolled):
+    with stream_type() as stream:
+        if rolled:
+            stream.rollover()
+        assert stream.write(data) == len(data)
+        assert stream.write(data[:0]) == 0
+        assert stream.tell() == len(data)
+        stream.seek(0)
+        assert stream_type.write(self=stream, s=data) == len(data)
+        assert stream.getvalue() == data
+        stream.close()
+        with pytest.raises(ValueError):
+            stream.write(data)
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('make_data', [
+    lambda: bytearray(b'buffer data'),
+    lambda: memoryview(b'buffer data'),
+    lambda: array.array('I', [1, 2, 3]),
+    lambda: memoryview(array.array('I', [1, 2, 3])),
+    lambda: memoryview(b'abcdef').cast('B', shape=[2, 3]),
+])
+def test_spooled_bytes_write_buffer(make_data, rolled):
+    data = make_data()
+    expected = memoryview(data).tobytes()
+    with ioutils.SpooledBytesIO() as stream:
+        if rolled:
+            stream.rollover()
+        assert stream.write(data) == len(expected)
+        assert stream.tell() == len(expected)
+        assert stream.getvalue() == expected
+
+
+@pytest.mark.parametrize('extra_capacity', [0, 1])
+@pytest.mark.parametrize('use_view', [False, True])
+def test_spooled_bytes_buffer_rollover_size(extra_capacity, use_view):
+    data = array.array('I', [1, 2, 3])
+    if use_view:
+        data = memoryview(data)
+    expected = b'xy' + memoryview(data).tobytes()
+    with ioutils.SpooledBytesIO(max_size=len(expected) + extra_capacity) as stream:
+        stream.write(b'xy')
+        assert not stream._rolled
+        assert stream.write(data) == len(expected) - 2
+        assert stream._rolled == (extra_capacity == 0)
+        assert stream.getvalue() == expected
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('max_size', [8, 1000])
+def test_spooled_bytes_buffered_writer(rolled, max_size):
+    data = b'buffered bytes'
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        if rolled:
+            stream.rollover()
+        with io.BufferedWriter(stream, buffer_size=32) as writer:
+            assert writer.write(data) == len(data)
+            assert stream.getvalue() == b''
+            writer.flush()
+            assert stream.getvalue() == data
+            assert stream._rolled == (rolled or max_size <= len(data))
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('stream_type, data, invalid', [
+    (ioutils.SpooledBytesIO, b'abc', 'text'),
+    (ioutils.SpooledBytesIO, b'abc', [1, 2, 3]),
+    (ioutils.SpooledBytesIO, b'abc', memoryview(b'abcd')[::2]),
+    (ioutils.SpooledStringIO, 'abc', b'bytes'),
+])
+def test_spooled_write_invalid_data(stream_type, data, invalid, rolled):
+    with stream_type() as stream:
+        stream.write(data)
+        if rolled:
+            stream.rollover()
+        stream.seek(1)
+        with pytest.raises((TypeError, BufferError)):
+            stream.write(invalid)
+        assert stream.tell() == 1
+        assert stream.getvalue() == data
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('text', [
+    'a\u00e9\u4e2d\U0001f642z',
+    'a\u00e9\u4e2d\U0001f642z' * ioutils.READ_CHUNK_SIZE,
+], ids=['short', 'chunked'])
+def test_spooled_string_seek_backwards(text, rolled):
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        start = len(text) // 2
+        stream.seek(0)
+        assert stream.read(start) == text[:start]
+        assert stream.seek(-start + 1, os.SEEK_CUR) == 1
+        assert stream.read(2) == text[1:3]
+        assert stream.tell() == 3
+        assert stream.read() == text[3:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('mode, offset', [
+    (os.SEEK_SET, -1),
+    (os.SEEK_CUR, -4),
+    (os.SEEK_END, -8),
+])
+def test_spooled_string_negative_seek_preserves_position(rolled, mode, offset):
+    text = '\u00e9ab\u4e2dxyz'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == text[:3]
+        with pytest.raises(ValueError):
+            stream.seek(offset, mode)
+        assert stream.tell() == 3
+        assert stream.read() == text[3:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('offset', [-3, -1, 0, 2])
+def test_spooled_string_seek_end_offsets(rolled, offset):
+    text = 'a\u00e9\u4e2d\U0001f642z'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        assert stream.seek(offset, os.SEEK_END) == len(text) + offset
+        assert stream.read() == text[len(text) + offset:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_string_len_preserves_position(rolled):
+    text = '\u00e9ab\u4e2dxyz'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == text[:3]
+        assert len(stream) == len(text)
+        assert stream.tell() == 3
+        assert stream.read() == text[3:]
+
+
