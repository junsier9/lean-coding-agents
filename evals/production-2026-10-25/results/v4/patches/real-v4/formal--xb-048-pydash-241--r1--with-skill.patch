 import pytest
@@ -110,6 +111,89 @@ def test_drop_while(case, expected):
     assert _.drop_while(*case) == expected
 
 
+@parametrize("factory", [list, iter, lambda values: (value for value in values), deque])
+@parametrize(
+    "values,predicate,taken,dropped",
+    [
+        ([], lambda value: value < 3, [], []),
+        ([1, 2, 3, 1], lambda value: value < 3, [1, 2], [3, 1]),
+        ([3, 1, 2], lambda value: value < 3, [], [3, 1, 2]),
+        ([1, 2], lambda value: value < 3, [1, 2], []),
+        ([1, 2, 0, 3], None, [1, 2], [0, 3]),
+        ([1, 2, 3, 4], lambda value, index: index < 2, [1, 2], [3, 4]),
+        (
+            [{"active": True}, {"active": False}],
+            "active",
+            [{"active": True}],
+            [{"active": False}],
+        ),
+        (
+            [{"active": True}, {"active": False}],
+            {"active": True},
+            [{"active": True}],
+            [{"active": False}],
+        ),
+    ],
+)
+def test_while_iterables(factory, values, predicate, taken, dropped):
+    assert _.take_while(factory(values), predicate) == taken
+    assert _.drop_while(factory(values), predicate) == dropped
+
+
+@parametrize("method,expected", [(_.take_while, [1, 2]), (_.drop_while, [3, 1])])
+@parametrize("factory", [list, iter])
+def test_while_predicate_arguments_and_short_circuit(method, expected, factory):
+    array = factory([1, 2, 3, 1])
+    calls = []
+
+    def predicate(value, index, collection):
+        assert collection is array
+        calls.append((value, index))
+        if index > 2:
+            raise RuntimeError("predicate called after boundary")
+        return value < 3
+
+    assert method(array=array, predicate=predicate) == expected
+    assert calls == [(1, 0), (2, 1), (3, 2)]
+
+
+def test_take_while_leaves_remaining_iterator():
+    array = iter([1, 2, 3, 4, 5])
+    assert _.take_while(array, lambda value: value < 3) == [1, 2]
+    assert list(array) == [4, 5]
+
+
+@parametrize("method,expected", [("take_while", [1, 2]), ("drop_while", [0, 3])])
+def test_while_iterators_default_predicate_and_chaining(method, expected):
+    assert getattr(_, method)(iter([1, 2, 0, 3])) == expected
+    assert getattr(_.chain(iter([1, 2, 0, 3])), method)().value() == expected
+
+
+@parametrize("method", [_.take_while, _.drop_while])
+def test_while_predicate_error_propagates(method):
+    error = ValueError("predicate failed")
+
+    def predicate(value):
+        raise error
+
+    with pytest.raises(ValueError) as exc_info:
+        method(iter([1, 2, 3]), predicate)
+    assert exc_info.value is error
+
+
+@parametrize("method", [_.take_while, _.drop_while])
+def test_while_iterator_error_propagates(method):
+    error = RuntimeError("iterator failed")
+
+    def values():
+        yield 1
+        raise error
+
+    with pytest.raises(RuntimeError) as exc_info:
+        method(values(), lambda value: True)
+    assert exc_info.value is error
+
