+class CachedMethodIntrospectionTest(unittest.TestCase):
+
+    def test_class_access(self):
+        for name, descriptor in vars(Cached).items():
+            if not name.startswith("get"):
+                continue
+            with self.subTest(method=name), warnings.catch_warnings():
+                warnings.simplefilter("error")
+                self.assertIs(getattr(Cached, name), descriptor)
+                self.assertIs(getattr(Unhashable, name), descriptor)
+
+    def test_autospec(self):
+        for cls in (Cached, Unhashable):
+            for instance in (False, True):
+                with self.subTest(cls=cls, instance=instance):
+                    with warnings.catch_warnings():
+                        warnings.simplefilter("error")
+                        mock = create_autospec(cls, instance=instance)
+                        if not instance:
+                            mock = mock({})
+                        mock.get(42)
+                        mock.get.assert_called_once_with(42)
