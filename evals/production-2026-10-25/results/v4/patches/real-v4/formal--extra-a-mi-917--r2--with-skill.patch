+    def test_lt_only(self):
+        class LtOnly:
+            def __init__(self, value):
+                self.value = value
+
+            def __lt__(self, other):
+                return self.value < other.value
+
+        values = [LtOnly(i) for i in range(3)]
+        cases = [
+            [],
+            [0],
+            [0, 1, 2],
+            [2, 1, 0],
+            [0, 2, 1],
+            [2, 0, 1],
+            [0, 0, 1],
+            [2, 2, 1],
+            [1, 1],
+        ]
+        for indices, reverse, strict, use_key in product(
+            cases, (False, True), (False, True), (False, True)
+        ):
+            items = [values[i] for i in indices]
+            if use_key:
+                items = [{'value': item} for item in items]
+                key = itemgetter('value')
+            else:
+                key = None
+
+            with self.subTest(
+                indices=indices, reverse=reverse, strict=strict, key=key
+            ):
+                expected = items == sorted(items, key=key, reverse=reverse)
+                if strict and len(set(indices)) != len(indices):
+                    expected = False
+                self.assertEqual(
+                    mi.is_sorted(
+                        iter(items), key=key, reverse=reverse, strict=strict
+                    ),
+                    expected,
+                )
+
+    def test_comparison_error(self):
+        class BrokenOrder:
+            def __lt__(self, other):
+                raise RuntimeError('comparison failed')
+
+        for reverse, strict, key in product(
+            (False, True), (False, True), (None, lambda x: x)
+        ):
+            with self.subTest(reverse=reverse, strict=strict, key=key):
+                with self.assertRaisesRegex(RuntimeError, 'comparison failed'):
+                    mi.is_sorted(
+                        [BrokenOrder(), BrokenOrder()],
+                        key=key,
+                        reverse=reverse,
+                        strict=strict,
+                    )
+
+    def test_equal_keys(self):
+        for reverse, strict in product((False, True), repeat=2):
+            with self.subTest(reverse=reverse, strict=strict):
+                self.assertEqual(
+                    mi.is_sorted(
+                        ['1', '01'], key=int, reverse=reverse, strict=strict
+                    ),
+                    not strict,
+                )
+
 
