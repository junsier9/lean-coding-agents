+@parametrize("mapping_type", [dict, MappingProxyType])
+@parametrize(
+    "case,expected",
+    [
+        (({"a": 1, "b": 2, "c": 3}, helpers.reduce_iteratee0), 6),
+        (({"a": 1, "b": 2, "c": 3},), 1),
+        (({"only": 7}, helpers.reduce_iteratee0), 7),
+        (({"a": 1, "b": 2, "c": 3}, helpers.reduce_iteratee1, {}), {"a": 3, "b": 6, "c": 9}),
+        (({}, helpers.reduce_iteratee0, 0), 0),
+    ],
+)
+def test_reduce_mapping(mapping_type, case, expected):
+    collection, *args = case
+    assert _.reduce_(mapping_type(collection), *args) == expected
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+def test_reduce_mapping_keys(mapping_type):
+    calls = []
+
+    def subtract(total, value, key):
+        calls.append((total, value, key))
+        return total - value
+
+    collection = mapping_type({"a": 10, "b": 2, "c": 3})
+    assert _.reduce_(collection=collection, iteratee=subtract) == 5
+    assert calls == [(10, 2, "b"), (8, 3, "c")]
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+def test_reduce_empty_mapping(mapping_type):
+    with pytest.raises(TypeError, match=r"^reduce_\(\) of empty sequence with no initial value$"):
+        _.reduce_(mapping_type({}))
+
