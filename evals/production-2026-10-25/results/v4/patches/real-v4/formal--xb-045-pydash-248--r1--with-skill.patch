@@ -37,6 +37,44 @@ def test_count_by(case, expected):
     assert _.count_by(*case) == expected
 
 
+@parametrize(
+    "collection",
+    [
+        [4.3, 6.1, 6.4, -4.3],
+        (4.3, 6.1, 6.4, -4.3),
+        {0: 4.3, 1: 6.1, 2: 6.4, 3: -4.3},
+        {"a": 4.3, "b": 6.1, "c": 6.4, "d": -4.3},
+    ],
+)
+@parametrize(
+    "iteratee,first,second,last",
+    [(_.floor, 4.0, 6.0, -5.0), (_.ceil, 5.0, 7.0, -4.0), (_.round_, 4.0, 6.0, -4.0)],
+)
+def test_rounding_iteratees_use_default_precision(collection, iteratee, first, second, last):
+    assert _.count_by(collection, iteratee) == {first: 1, second: 2, last: 1}
+    values = collection.values() if isinstance(collection, dict) else collection
+    assert _.group_by(values, iteratee) == {
+        first: [4.3],
+        second: [6.1, 6.4],
+        last: [-4.3],
+    }
+    assert _.map_(collection, iteratee) == [first, second, second, last]
+
+
+@parametrize("partial", [_.partial, _.partial_right])
+@parametrize("func,expected", [(_.floor, 6.04), (_.ceil, 6.05), (_.round_, 6.05)])
+def test_rounding_iteratees_with_explicit_precision(partial, func, expected):
+    iteratee = partial(func, precision=2)
+    assert _.map_([6.049, 6.049], iteratee) == [expected, expected]
+
+
+@parametrize("func", [_.floor, _.ceil, _.round_])
+@parametrize("value,error", [(float("nan"), ValueError), (float("inf"), OverflowError)])
+def test_rounding_iteratees_propagate_numeric_errors(func, value, error):
+    with pytest.raises(error):
+        _.map_([1.2, value], func)
+
+
