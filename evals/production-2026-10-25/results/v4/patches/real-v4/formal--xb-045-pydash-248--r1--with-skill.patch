+@parametrize("func,expected", [(_.floor, 6.04), (_.ceil, 6.05), (_.round_, 6.05)])
+def test_rounding_iteratee_preserves_call_contract(func, expected):
+    iteratee = _.iteratee(func)
+    assert iteratee.__name__ == func.__name__
+    assert iteratee.__doc__ == func.__doc__
+    assert inspect.signature(iteratee) == inspect.signature(func)
+    assert func(6.049, 2) == expected
+    assert func(x=6.049, precision=2) == expected
+    assert iteratee(x=6.049, precision=2) == expected
+    assert iteratee(6.049, "ignored", [6.049]) == func(6.049)
+
+    with pytest.raises(TypeError):
+        iteratee(x=6.049, precision="invalid")
+
