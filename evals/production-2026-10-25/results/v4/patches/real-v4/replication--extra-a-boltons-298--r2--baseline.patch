+def test_navigate_normalized_urls():
+    url = URL('http://hatnote.com/a/./b/c')
+    dest = URL('./d/../e/')
+    url.normalize()
+    dest.normalize()
+
+    assert url.navigate('f').to_text() == 'http://hatnote.com/a/b/f'
+    assert URL('http://hatnote.com/a/b/c').navigate(dest).to_text() == (
+        'http://hatnote.com/a/b/e/')
+    assert url.navigate(dest).navigate('f').to_text() == (
+        'http://hatnote.com/a/b/e/f')
+
