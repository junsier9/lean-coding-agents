diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index a8e1539..25dbddb 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -313,6 +313,34 @@ def test_navigate():
     assert navd.to_text() == _dest_text
 
 
+@pytest.mark.parametrize('dest_type', [str, URL])
+@pytest.mark.parametrize('first, second, expected', [
+    ('g', 'h', 'http://a/b/c/h'),
+    ('g/', 'h', 'http://a/b/c/g/h'),
+    ('/g', 'h', 'http://a/h'),
+    ('/g/', 'h/', 'http://a/g/h/'),
+    ('g/', '../h/', 'http://a/b/c/h/'),
+    ('g/', '/h/', 'http://a/h/'),
+    ('', 'h', 'http://a/b/c/h'),
+    ('g', '', 'http://a/b/c/g'),
+    ('g/', '', 'http://a/b/c/g/'),
+    ('', '', 'http://a/b/c/d;p?q'),
+    ('?x=1#frag', 'h', 'http://a/b/c/h'),
+    ('#frag', '', 'http://a/b/c/d;p?q'),
+])
+def test_chained_navigate(dest_type, first, second, expected):
+    original = URL(REL_URL_BASE)
+    first_url = original.navigate(dest_type(first))
+    first_text = first_url.to_text()
+    reconstructed = URL(first_text).navigate(dest_type(second))
+
+    chained = first_url.navigate(dest_type(second))
+
+    assert chained.to_text() == reconstructed.to_text() == expected
+    assert first_url.to_text() == first_text
+    assert original.to_text() == REL_URL_BASE
+
+
