@@ -69,6 +104,36 @@ def test_chained():
     assert _get_words(cli, ["get"], "s") == ["set", "start"]
 
 
+@pytest.mark.parametrize("nested", [False, True])
+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        ([], "", ["first", "second", "third"]),
+        (["first"], "", ["second", "third"]),
+        (["first", "second"], "", ["third"]),
+        (["first", "second"], "--", ["--mode", "--help"]),
+        (["first", "second", "--mode"], "", ["a", "b"]),
+        (["first", "second", "--mode", "a"], "--", ["--help"]),
+    ],
+)
+def test_chained_command_context(nested, args, incomplete, expect):
+    cli = Group(
+        "chain",
+        chain=True,
+        commands=[
+            Command("first"),
+            Command("second", params=[Option(["--mode"], type=Choice(["a", "b"]))]),
+            Command("third"),
+        ],
+    )
+
+    if nested:
+        cli = Group("cli", commands=[Group("nested", commands=[cli])])
+        args = ["nested", "chain", *args]
+
+    assert _get_words(cli, args, incomplete) == expect
+
+
 def test_help_option():
     cli = Group("cli", commands=[Command("with"), Command("no", add_help_option=False)])
