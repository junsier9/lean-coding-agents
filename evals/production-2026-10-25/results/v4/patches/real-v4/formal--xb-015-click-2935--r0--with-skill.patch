diff --git a/tests/test_shell_completion.py b/tests/test_shell_completion.py
index 3511f07..67ff33b 100644
--- a/tests/test_shell_completion.py
+++ b/tests/test_shell_completion.py
@@ -50,6 +50,41 @@ def test_group_command_same_option():
     assert _get_words(cli, ["-a", "a", "x", "-a", "a"], "-") == ["--help"]
 
 
+@pytest.mark.parametrize("depth", [1, 2, 3])
+@pytest.mark.parametrize(
+    ("args", "incomplete", "expect"),
+    [
+        ([], "", ["leaf"]),
+        ([], "l", ["leaf"]),
+        ([], "--", ["--group-option", "--help"]),
+        (["--group-option", "value"], "--", ["--help"]),
+        (["leaf"], "--", ["--leaf-option", "--help"]),
+        (["leaf", "--leaf-option"], "", ["a", "b"]),
+        (["leaf", "--leaf-option", "a"], "--", ["--help"]),
+        (["missing"], "", ["leaf"]),
+    ],
+)
+def test_nested_group(depth, args, incomplete, expect):
+    cli = Group(
+        "nested",
+        params=[Option(["--group-option"])],
+        commands=[
+            Command("leaf", params=[Option(["--leaf-option"], type=Choice(["a", "b"]))])
+        ],
+    )
+    path = []
+
+    for level in range(depth):
+        path.insert(0, cli.name)
+        cli = Group(
+            f"group-{level}",
+            params=[Option([f"--parent-{level}"])],
+            commands=[cli, Command("other")],
+        )
+
+    assert _get_words(cli, path + args, incomplete) == expect
+
+
