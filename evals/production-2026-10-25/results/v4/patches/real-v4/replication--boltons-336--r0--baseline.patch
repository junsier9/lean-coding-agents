@@ -9,6 +9,37 @@ from boltons.funcutils import wraps, FunctionBuilder, update_wrapper
 import boltons.funcutils as funcutils
 
 
+@pytest.mark.parametrize('copy_dict', [True, False])
+def test_copy_function_kwonly_defaults(copy_dict):
+    func = lambda x, *, y=2: x * y
+    func.custom_attr = 'copied'
+
+    func_copy = funcutils.copy_function(func, copy_dict=copy_dict)
+
+    assert func_copy(21) == func(21) == 42
+    assert func_copy(21, y=3) == func(21, y=3) == 63
+    assert inspect.signature(func_copy) == inspect.signature(func)
+    assert hasattr(func_copy, 'custom_attr') == copy_dict
+    with pytest.raises(TypeError):
+        func_copy(21, 3)
+
+
+@pytest.mark.parametrize('copy_dict', [True, False])
+def test_copy_function_mixed_defaults(copy_dict):
+    default_items = []
+
+    def func(x=21, *, required, y=2, optional=None, items=default_items):
+        return x * y, required, optional, items
+
+    func_copy = funcutils.copy_function(func, copy_dict=copy_dict)
+
+    assert func_copy(required='value') == func(required='value')
+    assert func_copy(required='value')[-1] is default_items
+    assert inspect.signature(func_copy) == inspect.signature(func)
+    with pytest.raises(TypeError):
+        func_copy()
+
+
