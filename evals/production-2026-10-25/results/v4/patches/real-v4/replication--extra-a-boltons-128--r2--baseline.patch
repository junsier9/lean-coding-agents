diff --git a/tests/test_mathutils.py b/tests/test_mathutils.py
index e5b536d..2b3375d 100644
--- a/tests/test_mathutils.py
+++ b/tests/test_mathutils.py
@@ -1,6 +1,82 @@
 
-from pytest import raises
-from boltons.mathutils import ceil, floor
+from math import isnan
+
+from pytest import mark, raises
+from boltons.mathutils import ceil, clamp, floor
+
+
+@mark.parametrize('value', [
+    -float('inf'), -10 ** 1000, -1.5, 0, 1.5, 10 ** 1000, float('inf'),
+])
+def test_clamp_unbounded(value):
+    assert clamp(value) is value
+    assert clamp(value, None, None) is value
+
+
+@mark.parametrize('value, expected_lower, expected_upper', [
+    (-float('inf'), 0, -float('inf')),
+    (-10 ** 1000, 0, -10 ** 1000),
+    (-1.5, 0, -1.5),
+    (0, 0, 0),
+    (1.5, 1.5, 0),
+    (10 ** 1000, 10 ** 1000, 0),
+    (float('inf'), float('inf'), 0),
+])
+def test_clamp_one_bound(value, expected_lower, expected_upper):
+    assert clamp(value, lower=0) == expected_lower
+    assert clamp(value, 0, None) == expected_lower
+    assert clamp(value, upper=0) == expected_upper
+    assert clamp(value, None, 0) == expected_upper
+
+
+@mark.parametrize('value, lower, upper, expected', [
+    (-1.0, 0, 5, 0),
+    (0, 0, 5, 0),
+    (1.0, 0, 5, 1.0),
+    (5, 0, 5, 5),
+    (101.0, 0, 5, 5),
+    (-1, 0, 0, 0),
+    (1, 0, 0, 0),
+    (-float('inf'), 0, 5, 0),
+    (float('inf'), 0, 5, 5),
+    (-float('inf'), -float('inf'), float('inf'), -float('inf')),
+    (float('inf'), -float('inf'), float('inf'), float('inf')),
+    (-10 ** 1000, -float('inf'), float('inf'), -10 ** 1000),
+    (10 ** 1000, -float('inf'), float('inf'), 10 ** 1000),
+    (-10 ** 1000, -10 ** 999, 10 ** 999, -10 ** 999),
+    (10 ** 1000, -10 ** 999, 10 ** 999, 10 ** 999),
+    (10 ** 1000, 10 ** 999, None, 10 ** 1000),
+    (-10 ** 1000, None, -10 ** 999, -10 ** 1000),
+    (-float('inf'), float('inf'), None, float('inf')),
+    (float('inf'), None, -float('inf'), -float('inf')),
+])
+def test_clamp_bounds(value, lower, upper, expected):
+    assert clamp(value, lower, upper) == expected
+
+
+@mark.parametrize('lower, upper', [(1, 0), (float('inf'), -float('inf'))])
+def test_clamp_reversed_bounds(lower, upper):
+    with raises(ValueError):
+        clamp(0, lower, upper)
+
+
+@mark.parametrize('lower, upper', [
+    (None, None), (0, None), (None, 5), (0, 5),
+    (-float('inf'), float('inf')),
+])
+def test_clamp_nan_value(lower, upper):
+    assert isnan(clamp(float('nan'), lower, upper))
+
+
+@mark.parametrize('lower, upper, expected', [
+    (float('nan'), None, 1),
+    (None, float('nan'), 1),
+    (float('nan'), 0, 0),
+    (2, float('nan'), 2),
+    (float('nan'), float('nan'), 1),
+])
+def test_clamp_nan_bounds(lower, upper, expected):
+    assert clamp(1, lower, upper) == expected
 
 
