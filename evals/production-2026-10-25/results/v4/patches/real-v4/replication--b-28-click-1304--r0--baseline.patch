+@pytest.mark.parametrize('envvar', [
+    None, 'CLICK_TEST_EXPLICIT_PATH', ['CLICK_TEST_EXPLICIT_PATH'],
+    ('CLICK_TEST_EXPLICIT_PATH',),
+], ids=['auto', 'single', 'list', 'tuple'])
+@pytest.mark.parametrize('default_source', ['none', 'option', 'context'])
+def test_empty_path_envvar(runner, envvar, default_source):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar,
+                  default='.' if default_source == 'option' else None)
+    def cmd(path):
+        click.echo('path=%s' % path)
+
+    default_map = {'path': '.'} if default_source == 'context' else None
+    expected = 'path=None\n' if default_source == 'none' else 'path=.\n'
+
+    for value in (None, ''):
+        result = runner.invoke(
+            cmd, [], auto_envvar_prefix='CLICK_TEST', default_map=default_map,
+            env={'CLICK_TEST_EXPLICIT_PATH': value, 'CLICK_TEST_PATH': value})
+        assert result.exit_code == 0
+        assert result.output == expected
+
+
+@pytest.mark.parametrize('envvar, auto_value', [
+    ('CLICK_TEST_EXPLICIT_PATH', '.'),
+    (['CLICK_TEST_EXPLICIT_PATH', 'CLICK_TEST_FALLBACK_PATH'], None),
+    (('CLICK_TEST_EXPLICIT_PATH', 'CLICK_TEST_FALLBACK_PATH'), None),
+])
+def test_empty_path_envvar_fallback(runner, envvar, auto_value):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar)
+    def cmd(path):
+        click.echo(path)
+
+    result = runner.invoke(
+        cmd, [], auto_envvar_prefix='CLICK_TEST',
+        env={'CLICK_TEST_EXPLICIT_PATH': '', 'CLICK_TEST_FALLBACK_PATH': '.',
+             'CLICK_TEST_PATH': auto_value})
+    assert result.exit_code == 0
+    assert result.output == '.\n'
+
+
+@pytest.mark.parametrize('envvar', [None, 'CLICK_TEST_EXPLICIT_PATH'])
+def test_empty_path_envvar_required(runner, envvar):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar,
+                  required=True)
+    def cmd(path):
+        pass
+
+    result = runner.invoke(
+        cmd, [], auto_envvar_prefix='CLICK_TEST',
+        env={'CLICK_TEST_EXPLICIT_PATH': '', 'CLICK_TEST_PATH': ''})
+    assert result.exit_code == 2
+    assert 'Missing option "--path".' in result.output
+
+
+@pytest.mark.parametrize('envvar', [None, 'CLICK_TEST_VALUE'])
+@pytest.mark.parametrize('value', ['0', 'false', ' '])
+def test_nonempty_envvar_preserved(runner, envvar, value):
+    @click.command()
+    @click.option('--arg', envvar=envvar)
+    def cmd(arg):
+        click.echo(arg)
+
+    result = runner.invoke(
+        cmd, [], auto_envvar_prefix='CLICK_TEST',
+        env={'CLICK_TEST_VALUE': value, 'CLICK_TEST_ARG': value})
+    assert result.exit_code == 0
+    assert result.output == value + '\n'
+
+
+def test_empty_path_option_value(runner):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True))
+    def cmd(path):
+        pass
+
+    result = runner.invoke(cmd, ['--path', ''])
+    assert result.exit_code == 2
+    assert 'Path "" does not exist.' in result.output
+
+
