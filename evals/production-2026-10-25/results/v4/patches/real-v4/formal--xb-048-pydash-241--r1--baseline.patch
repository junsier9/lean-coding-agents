+@parametrize("function,result_index", [(_.take_while, 0), (_.drop_while, 1)])
+@parametrize(
+    "factory",
+    [iter, deque, lambda values: (value for value in values)],
+    ids=["iterator", "deque", "generator"],
+)
+@parametrize(
+    "values,predicate,expected",
+    [
+        ([], lambda value: value < 3, ([], [])),
+        ([1, 2], lambda value: value < 3, ([1, 2], [])),
+        ([3, 1, 2], lambda value: value < 3, ([], [3, 1, 2])),
+        ([1, 2, 3, 1], lambda value: value < 3, ([1, 2], [3, 1])),
+        ([1, 2, 3, 1], lambda value, index: index < 2, ([1, 2], [3, 1])),
+        ([1, 2, 0, 3], None, ([1, 2], [0, 3])),
+        (
+            [{"active": True}, {"active": False}, {"active": True}],
+            "active",
+            ([{"active": True}], [{"active": False}, {"active": True}]),
+        ),
+        (
+            [{"active": True}, {"active": False}, {"active": True}],
+            {"active": True},
+            ([{"active": True}], [{"active": False}, {"active": True}]),
+        ),
+    ],
+)
+def test_while_iterables(function, result_index, factory, values, predicate, expected):
+    assert function(factory(values), predicate) == expected[result_index]
+
+
+@parametrize("function,expected", [(_.take_while, [1]), (_.drop_while, [0, 2])])
+def test_while_iterator_default_predicate(function, expected):
+    assert function(iter([1, 0, 2])) == expected
+
+
+@parametrize("function,expected", [(_.take_while, [1, 2]), (_.drop_while, [3, 1])])
+@parametrize("factory", [list, iter])
+def test_while_predicate_arguments_and_short_circuit(function, expected, factory):
+    values = factory([1, 2, 3, 1])
+    calls = []
+
+    def predicate(value, index, collection):
+        assert collection is values
+        calls.append((value, index))
+        return index < 2
+
+    assert function(values, predicate) == expected
+    assert calls == [(1, 0), (2, 1), (3, 2)]
+
+
+def test_take_while_does_not_consume_iterator_tail():
+    values = iter([1, 2, 3, 4])
+    assert _.take_while(values, lambda value: value < 3) == [1, 2]
+    assert list(values) == [4]
+
+
+@parametrize("function,result_index", [(_.take_while, 0), (_.drop_while, 1)])
+@parametrize(
+    "values,expected",
+    [
+        ((1, 2, 3, 1), ((1, 2), (3, 1))),
+        ("1231", ("12", "31")),
+        (range(4), (range(2), range(2, 4))),
+    ],
+)
+def test_while_preserves_sequence_type(function, result_index, values, expected):
+    assert function(values, lambda value, index: index < 2) == expected[result_index]
+
+
+@parametrize("function,expected", [(_.take_while, [10]), (_.drop_while, [20, 3])])
+def test_while_predicate_modifies_list(function, expected):
+    values = [1, 2, 3]
+
+    def predicate(value, index, collection):
+        collection[index] = value * 10
+        return index < 1
+
+    assert function(values, predicate) == expected
+    assert values == [10, 20, 3]
+
