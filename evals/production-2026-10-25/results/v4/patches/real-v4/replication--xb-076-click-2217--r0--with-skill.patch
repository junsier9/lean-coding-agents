+@pytest.mark.parametrize("chain", [False, True])
+@pytest.mark.parametrize("value", [None, 42, 0, False, "", [], {}])
+def test_no_command_result_callback_return_value(runner, chain, value):
+    processed = object()
+
+    @click.group(invoke_without_command=True, chain=chain)
+    def cli():
+        return value
+
+    @cli.result_callback()
+    def process_result(result):
+        if chain:
+            assert result == []
+        else:
+            assert result is value
+        return processed
+
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert not result.exception
+    assert result.return_value is processed
+
+
+@pytest.mark.parametrize("chain", [False, True])
+@pytest.mark.parametrize("value", [None, 42, 0, False, "", [], {}])
+def test_no_command_return_value(runner, chain, value):
+    @click.group(invoke_without_command=True, chain=chain)
+    def cli():
+        return value
+
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert not result.exception
+    if chain:
+        assert result.return_value == []
+    else:
+        assert result.return_value is value
+
