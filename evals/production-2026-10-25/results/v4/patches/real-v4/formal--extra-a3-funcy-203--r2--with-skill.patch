+def test_once_per_args_keyword_only():
+    calls = []
+
+    @once_per_args
+    def call(n=1, *, mode='default'):
+        calls.append((n, mode))
+        return 'called'
+
+    assert call() == 'called'
+    assert call(n=1, mode='default') is None
+    assert call(1, mode='other') == 'called'
+    assert call(mode='other', n=1) is None
+    assert calls == [(1, 'default'), (1, 'other')]
+
+
+def test_once_per_args_varargs():
+    calls = []
+
+    @once_per_args
+    def call(n=1, *args):
+        calls.append((n, args))
+        return 'called'
+
+    assert call() == 'called'
+    assert call(n=1) is None
+    assert call(1, 2) == 'called'
+    assert call(1, 2) is None
+    assert call(1, 2, 3) == 'called'
+    assert call(1, 3, 2) == 'called'
+    assert calls == [(1, ()), (1, (2,)), (1, (2, 3)), (1, (3, 2))]
+
+
+def test_once_per_args_kwargs():
+    calls = []
+
+    @once_per_args
+    def call(n=1, **kwargs):
+        calls.append((n, kwargs))
+        return 'called'
+
+    assert call() == 'called'
+    assert call(n=1) is None
+    assert call(1, a=2, b=3) == 'called'
+    assert call(b=3, n=1, a=2) is None
+    assert call(a=3, b=3) == 'called'
+    assert call(a=2, c=3) == 'called'
+    assert calls == [(1, {}), (1, {'a': 2, 'b': 3}),
+                     (1, {'a': 3, 'b': 3}), (1, {'a': 2, 'c': 3})]
+
+
+@pytest.mark.parametrize('make_value', [list, dict, set, lambda: ([],)])
+def test_once_per_args_unhashable_keyword_and_variadic_arguments(make_value):
+    calls = []
+
+    @once_per_args
+    def call(*args, kwonly=None, **kwargs):
+        calls.append((args, kwonly, kwargs))
+        return 'called'
+
+    assert call(make_value()) == 'called'
+    assert call(make_value()) is None
+    assert call(kwonly=make_value()) == 'called'
+    assert call(kwonly=make_value()) is None
+    assert call(extra=make_value()) == 'called'
+    assert call(extra=make_value()) is None
+    assert calls == [((make_value(),), None, {}), ((), make_value(), {}),
+                     ((), None, {'extra': make_value()})]
+
+
+def test_once_per_args_method_call_forms():
+    calls = []
+
+    class Initializer:
+        @once_per_args
+        def initialize(receiver, n=1, *, mode='default'):
+            """Initialize this instance."""
+            calls.append((receiver, n, mode))
+            return 'called'
+
+    first, second = Initializer(), Initializer()
+    assert first.initialize() == 'called'
+    assert Initializer.initialize(receiver=first, n=1, mode='default') is None
+    assert Initializer.initialize(receiver=first, mode='other') == 'called'
+    assert first.initialize(1, mode='other') is None
+    assert second.initialize() == 'called'
+    assert calls == [(first, 1, 'default'), (first, 1, 'other'), (second, 1, 'default')]
+
+    method = Initializer.initialize
+    assert method.__name__ == 'initialize'
+    assert method.__doc__ == 'Initialize this instance.'
+    assert method.__original__ is method.__wrapped__
+    assert signature(method) == signature(method.__wrapped__)
+
+
+def test_once_per_args_required_keyword_only():
+    @once_per_args
+    def call(n, *, mode):
+        return n, mode
+
+    for _ in range(2):
+        with pytest.raises(TypeError):
+            call(1)
+    assert call(1, mode='default') == (1, 'default')
+    assert call(n=1, mode='default') is None
+
+
+def test_once_per_args_propagates_errors():
+    calls = []
+
+    @once_per_args
+    def call(*, mode='default'):
+        calls.append(mode)
+        raise MyError(mode)
+
+    with pytest.raises(MyError, match='default'):
+        call()
+    assert call(mode='default') is None
+    with pytest.raises(MyError, match='other'):
+        call(mode='other')
+    assert calls == ['default', 'other']
+
