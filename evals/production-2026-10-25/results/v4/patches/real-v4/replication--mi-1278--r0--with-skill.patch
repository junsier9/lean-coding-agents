 class ZipBroadcastTests(TestCase):
+    class OnceIterable:
+        def __init__(self, values):
+            self.values = values
+            self.iterated = False
+
+        def __iter__(self):
+            if self.iterated:
+                raise RuntimeError('iterator already requested')
+            self.iterated = True
+            return iter(self.values)
+
+    def test_single_use_iterables(self):
+        for values in ([], [1], [1, 2]):
+            for strict in (False, True):
+                with self.subTest(values=values, strict=strict):
+                    self.assertEqual(
+                        list(
+                            mi.zip_broadcast(
+                                self.OnceIterable(values), strict=strict
+                            )
+                        ),
+                        list(zip(self.OnceIterable(values), strict=strict)),
+                    )
+                    self.assertEqual(
+                        list(
+                            mi.zip_broadcast(
+                                0,
+                                self.OnceIterable(values),
+                                'ab',
+                                self.OnceIterable(values),
+                                b'cd',
+                                strict=strict,
+                            )
+                        ),
+                        [(0, x, 'ab', x, b'cd') for x in values],
+                    )
+
+    def test_single_use_iterables_different_lengths(self):
+        for left, right in (
+            ([], [1]),
+            ([1], []),
+            ([1], [2, 3]),
+            ([1, 2], [3]),
+        ):
+            for strict in (False, True):
+                with self.subTest(left=left, right=right, strict=strict):
+                    actual = mi.zip_broadcast(
+                        '_',
+                        self.OnceIterable(left),
+                        0,
+                        self.OnceIterable(right),
+                        strict=strict,
+                    )
+                    for a, b in zip(left, right):
+                        self.assertEqual(next(actual), ('_', a, 0, b))
+                    if strict:
+                        with self.assertRaises(ValueError):
+                            next(actual)
+                    else:
+                        self.assertEqual(list(actual), [])
+
+    def test_iter_error(self):
+        obj = self.OnceIterable([1, 2])
+        iter(obj)
+        with self.assertRaisesRegex(RuntimeError, 'iterator already requested'):
+            list(mi.zip_broadcast(obj))
+
