+    def test_lt_only(self):
+        class LtOnly:
+            def __init__(self, value):
+                self.value = value
+
+            def __lt__(self, other):
+                return self.value < other.value
+
+        items = [LtOnly(value) for value in range(3)]
+        for values in ([], [0], [0, 1, 2], [2, 1, 0], [0, 2, 1], [0, 0, 1]):
+            for reverse, strict, use_key in product((False, True), repeat=3):
+                with self.subTest(
+                    values=values,
+                    reverse=reverse,
+                    strict=strict,
+                    use_key=use_key,
+                ):
+                    if use_key:
+                        iterable = iter(values)
+                        key = items.__getitem__
+                    else:
+                        iterable = (items[value] for value in values)
+                        key = None
+                    expected = values == sorted(values, reverse=reverse)
+                    if strict:
+                        expected = expected and len(values) == len(set(values))
+                    self.assertEqual(
+                        mi.is_sorted(
+                            iterable, key=key, reverse=reverse, strict=strict
+                        ),
+                        expected,
+                    )
+
+    def test_equal_keys(self):
+        for reverse, strict in product((False, True), repeat=2):
+            values = [1, -1, 2]
+            if reverse:
+                values.reverse()
+            with self.subTest(reverse=reverse, strict=strict):
+                self.assertEqual(
+                    mi.is_sorted(
+                        values, key=abs, reverse=reverse, strict=strict
+                    ),
+                    not strict,
+                )
+
+    def test_short_circuit(self):
+        for reverse, strict in product((False, True), repeat=2):
+
+            def values():
+                yield from ([0, 1] if reverse else [1, 0])
+                self.fail('consumed past the first out-of-order item')
+
+            with self.subTest(reverse=reverse, strict=strict):
+                self.assertFalse(
+                    mi.is_sorted(values(), reverse=reverse, strict=strict)
+                )
+
+    def test_comparison_error(self):
+        class BrokenOrder:
+            def __lt__(self, other):
+                raise RuntimeError('comparison failed')
+
+        for reverse, strict in product((False, True), repeat=2):
+            with self.subTest(reverse=reverse, strict=strict):
+                with self.assertRaisesRegex(RuntimeError, 'comparison failed'):
+                    mi.is_sorted(
+                        [BrokenOrder(), BrokenOrder()],
+                        reverse=reverse,
+                        strict=strict,
+                    )
+
+    def test_key_error(self):
+        def key(value):
+            raise ValueError('key failed')
+
+        for reverse, strict in product((False, True), repeat=2):
+            with self.subTest(reverse=reverse, strict=strict):
+                with self.assertRaisesRegex(ValueError, 'key failed'):
+                    mi.is_sorted([1, 2], key=key, reverse=reverse, strict=strict)
+
 
