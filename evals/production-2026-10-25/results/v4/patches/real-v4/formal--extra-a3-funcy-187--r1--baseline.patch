@@ -154,6 +154,49 @@ def test_limit_error_rate():
     assert calls == [1, 2]
 
 
+@pytest.mark.parametrize('timeout, seconds', [
+    pytest.param(0.5, 0.5, id='float'),
+    pytest.param(timedelta(seconds=0.5), 0.5, id='fractional-timedelta'),
+    pytest.param(1, 1, id='int'),
+    pytest.param(timedelta(seconds=1), 1, id='integer-timedelta'),
+])
+def test_limit_error_rate_timeout(monkeypatch, timeout, seconds):
+    now = datetime(2026, 1, 1)
+
+    class Clock:
+        @staticmethod
+        def now():
+            return now
+
+    monkeypatch.setattr('funcy.flow.datetime', Clock)
+    calls = []
+
+    @limit_error_rate(2, timeout)
+    def limited(fail=False):
+        calls.append(fail)
+        if fail:
+            raise MyError
+        return 'ok'
+
+    with pytest.raises(MyError): limited(True)
+    with pytest.raises(MyError): limited(True)
+    with pytest.raises(ErrorRateExceeded): limited()
+    assert calls == [True, True]
+
+    now += timedelta(seconds=seconds) - timedelta(microseconds=1)
+    with pytest.raises(ErrorRateExceeded): limited()
+    assert calls == [True, True]
+
+    now += timedelta(microseconds=1)
+    assert limited() == 'ok'
+    assert limited.fails == 0
+    assert limited.blocked is None
+
+    with pytest.raises(MyError): limited(True)
+    assert limited() == 'ok'
+    assert calls == [True, True, False, True, False]
+
+
