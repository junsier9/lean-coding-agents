+@pytest.mark.parametrize("use_default_map", [False, True])
+def test_show_default_with_string_comparison_error(runner, use_default_map):
+    class Value:
+        def __eq__(self, other):
+            if isinstance(other, str):
+                raise ValueError("cannot compare with strings")
+            return NotImplemented
+
+        def __str__(self):
+            return "special value"
+
+    value = Value()
+    opt = click.Option(
+        ["--value"], default="fallback" if use_default_map else value, show_default=True
+    )
+    cmd = click.Command("cli", params=[opt])
+    default_map = {"value": value} if use_default_map else None
+    ctx = click.Context(cmd, default_map=default_map)
+    assert opt.get_help_extra(ctx) == {"default": "special value"}
+
+    result = runner.invoke(cmd, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    assert "[default: special value]" in result.output
+
+
