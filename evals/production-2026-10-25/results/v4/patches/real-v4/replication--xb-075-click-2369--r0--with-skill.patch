 import click
 
 
@@ -296,6 +298,41 @@ def test_truncating_docstring(runner):
     ]
 
 
+@pytest.mark.parametrize("deprecated", [False, True])
+def test_truncating_empty_docstring(runner, deprecated):
+    @click.command(deprecated=deprecated)
+    def cli():
+        """\f
+        This text should be truncated.
+        """
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    expected = ["Usage: cli [OPTIONS]", ""]
+
+    if deprecated:
+        expected.extend(["  (Deprecated)", ""])
+
+    expected.extend(["Options:", "  --help  Show this message and exit."])
+    assert result.output.splitlines() == expected
+
+
+@pytest.mark.parametrize("help_text", [None, "", " \n\t ", "\f", "\n  \f\n  Hidden."])
+@pytest.mark.parametrize("deprecated", [False, True])
+def test_formatting_empty_help_text(runner, help_text, deprecated):
+    cli = click.Command("cli", help=help_text, deprecated=deprecated)
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    expected = ["Usage: cli [OPTIONS]", ""]
+
+    if deprecated:
+        expected.extend(["  (Deprecated)", ""])
+
+    expected.extend(["Options:", "  --help  Show this message and exit."])
+    assert result.output.splitlines() == expected
+    assert cli.help == help_text
+
+
