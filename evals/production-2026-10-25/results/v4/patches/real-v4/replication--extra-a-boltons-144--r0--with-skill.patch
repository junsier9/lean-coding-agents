+@pytest.mark.parametrize('spooled_type', [ioutils.SpooledBytesIO,
+                                        ioutils.SpooledStringIO])
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('text', [u'', u'\n', u'\u2014first\n\nlast',
+                                 u'\u2014first\n\nlast\n'])
+def test_spooled_iteration(spooled_type, rolled, text):
+    content = (text.encode('utf-8')
+               if spooled_type is ioutils.SpooledBytesIO else text)
+    expected = content.splitlines(True)
+    with spooled_type() as stream:
+        stream.write(content)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+
+        assert iter(stream) is stream
+        assert list(stream) == expected
+        assert list(stream) == []
+        for advance in (stream.__next__, stream.next):
+            stream.seek(0)
+            for line in expected:
+                assert advance() == line
+            for _ in range(2):
+                with pytest.raises(StopIteration):
+                    advance()
+            assert next(stream, None) is None
+            assert stream.read() == content[:0]
+
+
+@pytest.mark.parametrize('spooled_type', [ioutils.SpooledBytesIO,
+                                        ioutils.SpooledStringIO])
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_iteration_read_seek_and_close(spooled_type, rolled):
+    text = u'\u2014first\n\nlast'
+    content = (text.encode('utf-8')
+               if spooled_type is ioutils.SpooledBytesIO else text)
+    first, blank, last = content.splitlines(True)
+    with spooled_type() as stream:
+        stream.write(content)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+
+        iterator = iter(stream)
+        assert stream.read(1) == content[:1]
+        assert next(iterator) == first[1:]
+        assert stream.tell() == len(first)
+        assert stream.readline() == blank
+        assert stream.next() == last
+        assert stream.tell() == len(content)
+        with pytest.raises(StopIteration):
+            next(iterator)
+        stream.seek(0)
+        assert next(iterator) == first
+        stream.seek(0)
+        assert spooled_type.next(self=stream) == first
+        stream.seek(0)
+        assert spooled_type.__next__(self=stream) == first
+        stream.seek(0)
+
+    assert stream.closed
+    with pytest.raises(ValueError):
+        next(stream)
+    with pytest.raises(ValueError):
+        stream.next()
+
+
