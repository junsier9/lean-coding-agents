+    def test_repeat_iterator_input(self):
+        for iterables, repeat in [(('ab',), 3), (('ab', 'cde'), 2)]:
+            expected = list(product(*iterables, repeat=repeat))
+            for index, element in enumerate(expected):
+                for position in (index, index - len(expected)):
+                    with self.subTest(iterables=iterables, index=position):
+                        self.assertEqual(
+                            mi.nth_product(
+                                position, *map(iter, iterables), repeat=repeat
+                            ),
+                            element,
+                        )
+
+    def test_repeat_iterator_invalid_index(self):
+        for index in (-5, 4):
+            with self.subTest(index=index), self.assertRaises(IndexError):
+                mi.nth_product(index, iter('ab'), repeat=2)
+        with self.assertRaises(IndexError):
+            mi.nth_product(0, iter(''), repeat=2)
+
+    def test_repeat_without_consuming_input(self):
+        for repeat in (0, -1, 1.5):
+            with self.subTest(repeat=repeat):
+                source = iter('ab')
+                with self.assertRaises(TypeError):
+                    mi.nth_product(0, source, repeat=repeat)
