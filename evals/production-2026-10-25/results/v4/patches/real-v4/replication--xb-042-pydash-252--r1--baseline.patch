@@ -118,7 +118,8 @@ def chunk(array: t.Sequence[T], size: int = 1) -> t.List[t.Sequence[T]]:
         size: Chunk size. Defaults to ``1``.
 
     Returns:
-        New list containing chunks of `array`.
+        New list containing chunks of `array`, or an empty list if `size` is less than ``1`` or
+        `array` is empty.
 
     Example:
 
@@ -127,6 +128,9 @@ def chunk(array: t.Sequence[T], size: int = 1) -> t.List[t.Sequence[T]]:
 
     .. versionadded:: 1.1.0
     """
+    if size < 1 or not array:
+        return []
+
     chunks = int(ceil(len(array) / float(size)))
     return [array[i * size : (i + 1) * size] for i in range(chunks)]
 
