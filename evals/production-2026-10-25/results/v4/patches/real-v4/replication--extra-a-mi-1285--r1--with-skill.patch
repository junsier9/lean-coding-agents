+    def test_missing_bucket_does_not_add_key(self):
+        D = mi.bucket([10, 20, 11], key=lambda x: 10 * (x // 10))
+
+        self.assertEqual(list(D[30]), [])
+        self.assertEqual(set(D), {10, 20})
+        self.assertEqual(list(D[40]), [])
+        self.assertEqual(set(D), {10, 20})
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertEqual(list(D[20]), [20])
+
+    def test_missing_membership_does_not_add_key(self):
+        D = mi.bucket([10, 20, 11], key=lambda x: 10 * (x // 10))
+
+        self.assertNotIn(30, D)
+        self.assertEqual(set(D), {10, 20})
+        self.assertNotIn(40, D)
+        self.assertEqual(set(D), {10, 20})
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertEqual(list(D[20]), [20])
+
+    def test_empty_does_not_add_keys(self):
+        D = mi.bucket([], key=lambda x: x)
+
+        self.assertEqual(list(D['a']), [])
+        self.assertNotIn('b', D)
+        self.assertEqual(list(D), [])
+
+    def test_direct_match_retains_key(self):
+        D = mi.bucket(['a1'], key=lambda x: x[0])
+        child = D['a']
+
+        self.assertEqual(next(child), 'a1')
+        self.assertEqual(list(D), ['a'])
+        self.assertEqual(list(child), [])
+        self.assertNotIn('a', D)
+        self.assertEqual(list(D), ['a'])
+
+    def test_interleaved_children(self):
+        D = mi.bucket(['a1', 'b1', 'a2', 'b2', 'a3'], key=lambda x: x[0])
+        a = D['a']
+        b = D['b']
+
+        self.assertEqual(next(a), 'a1')
+        self.assertIn('b', D)
+        self.assertEqual(next(b), 'b1')
+        self.assertEqual(next(a), 'a2')
+        self.assertEqual(list(b), ['b2'])
+        self.assertEqual(list(a), ['a3'])
+        self.assertNotIn('a', D)
+        self.assertNotIn('b', D)
+        self.assertEqual(set(D), {'a', 'b'})
+
