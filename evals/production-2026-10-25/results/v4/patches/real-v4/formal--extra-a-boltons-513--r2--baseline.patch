@@ -449,6 +452,169 @@ class TestSpooledStringIO(TestCase, BaseTestMixin, AssertionsMixin):
         self.assertEqual(self.spooled_flo.getvalue(), expected)
 
 
+@pytest.mark.parametrize('stream_type, value', [
+    (ioutils.SpooledBytesIO, b'hello'),
+    (ioutils.SpooledStringIO, 'a\u2014\U0001f600e\u0301'),
+])
+@pytest.mark.parametrize('max_size, rolled', [(1000, False), (1000, True), (1, False)])
+def test_spooled_write_count(stream_type, value, max_size, rolled):
+    with stream_type(max_size=max_size) as stream:
+        if rolled:
+            stream.rollover()
+        assert stream.write(value) == len(value)
+        assert stream.write(value[:0]) == 0
+        assert stream.tell() == len(value)
+        assert stream.getvalue() == value
+
+
+@pytest.mark.parametrize('data', [
+    b'abc',
+    bytearray(b'abc'),
+    memoryview(b'abc'),
+    array('I', [1, 2]),
+    memoryview(array('I', [1, 2])),
+    memoryview(b'abcdef').cast('B', shape=[2, 3]),
+])
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_bytes_write_buffers(data, rolled):
+    with memoryview(data) as view:
+        expected = view.tobytes()
+    with ioutils.SpooledBytesIO() as stream:
+        if rolled:
+            stream.rollover()
+        assert stream.write(b'x') == 1
+        assert stream.write(data) == len(expected)
+        assert stream.tell() == len(expected) + 1
+        assert stream.getvalue() == b'x' + expected
+
+
+@pytest.mark.parametrize('data', [
+    array('I', [1, 2]),
+    memoryview(array('I', [1, 2])),
+    memoryview(b'abcdef').cast('B', shape=[2, 3]),
+])
+@pytest.mark.parametrize('extra_space', [0, 1])
+def test_spooled_bytes_buffer_rollover_uses_byte_count(data, extra_space):
+    with memoryview(data) as view:
+        expected = view.tobytes()
+    with ioutils.SpooledBytesIO(max_size=1 + len(expected) + extra_space) as stream:
+        stream.write(b'x')
+        assert not stream._rolled
+        assert stream.write(data) == len(expected)
+        assert stream._rolled == (extra_space == 0)
+        assert stream.getvalue() == b'x' + expected
+
+
+@pytest.mark.parametrize('data, error', [
+    (None, TypeError),
+    (1, TypeError),
+    ('abc', TypeError),
+    (memoryview(b'abcdef')[::2], BufferError),
+])
+def test_spooled_bytes_invalid_buffer_preserves_state(data, error):
+    with ioutils.SpooledBytesIO(max_size=4) as stream:
+        stream.write(b'x')
+        with pytest.raises(error):
+            stream.write(data)
+        assert not stream._rolled
+        assert stream.tell() == 1
+        assert stream.getvalue() == b'x'
+
+
+@pytest.mark.parametrize('max_size, rolled', [(1000, False), (1000, True), (4, False)])
+def test_spooled_bytes_buffered_writer(max_size, rolled):
+    with ioutils.SpooledBytesIO(max_size=max_size) as stream:
+        if rolled:
+            stream.rollover()
+        with io.BufferedWriter(stream, buffer_size=8) as writer:
+            assert writer.write(b'abc') == 3
+            writer.flush()
+            assert stream.getvalue() == b'abc'
+            assert writer.write(b'defghijkl') == 9
+            writer.flush()
+            assert stream.getvalue() == b'abcdefghijkl'
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('repeats', [1, ioutils.READ_CHUNK_SIZE])
+def test_spooled_text_relative_seek_codepoints(rolled, repeats):
+    text = 'a\u2014\U0001f600e\u0301z' * repeats
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        assert stream.seek(len(text) - 1) == len(text) - 1
+        assert stream.seek(3 - len(text), os.SEEK_CUR) == 2
+        assert stream.read(3) == text[2:5]
+        assert stream.tell() == 5
+        assert stream.seek(-4, os.SEEK_CUR) == 1
+        assert stream.seek(len(text) - 2, os.SEEK_CUR) == len(text) - 1
+        assert stream.read() == text[-1:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('offset', [-2, 0, 2])
+def test_spooled_text_seek_from_end(rolled, offset):
+    text = 'a\u2014\U0001f600e\u0301z'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(1)
+        target = len(text) + offset
+        assert stream.seek(offset, os.SEEK_END) == target
+        assert stream.tell() == target
+        assert stream.read() == text[target:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+@pytest.mark.parametrize('offset, whence', [
+    (-1, os.SEEK_SET),
+    (-4, os.SEEK_CUR),
+    (-7, os.SEEK_END),
+    (0, 42),
+])
+def test_spooled_text_invalid_seek_preserves_position(rolled, offset, whence):
+    text = 'a\u2014\U0001f600e\u0301z'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == text[:3]
+        with pytest.raises(ValueError):
+            stream.seek(offset, whence)
+        assert stream.tell() == 3
+        assert stream.read() == text[3:]
+
+
+@pytest.mark.parametrize('rolled', [False, True])
+def test_spooled_text_length_preserves_position(rolled):
+    text = 'a\u2014\U0001f600e\u0301z'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        if rolled:
+            stream.rollover()
+        stream.seek(0)
+        assert stream.read(3) == text[:3]
+        assert stream.len == len(text)
+        assert len(stream) == len(text)
+        assert stream.getvalue() == text
+        assert stream.tell() == 3
+        assert stream.read() == text[3:]
+
+
+def test_spooled_text_rollover_preserves_read_position():
+    text = 'a\u2014\U0001f600e\u0301z'
+    with ioutils.SpooledStringIO() as stream:
+        stream.write(text)
+        stream.seek(0)
+        assert stream.read(3) == text[:3]
+        stream.rollover()
+        assert stream.tell() == 3
+        assert stream.read() == text[3:]
+
