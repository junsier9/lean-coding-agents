+@parametrize(
+    "func,rule_keyword,rule",
+    [
+        (_.xor_by, "iteratee", math.floor),
+        (_.xor_with, "comparator", lambda a, b: math.floor(a) == math.floor(b)),
+    ],
+)
+@parametrize("use_keyword", [False, True])
+@parametrize(
+    "case,expected",
+    [
+        (([1.1, 2.1], [2.2, 3.1], [1.2, 4.1]), [3.1, 4.1]),
+        (([1.1, 2.1], [2.2, 3.1], [1.2, 4.1], [3.2, 5.1]), [4.1, 5.1]),
+        (([1.1, 2.1], [], [1.2, 3.1]), [2.1, 3.1]),
+        (([1.1], [1.2], [1.3]), [1.3]),
+        (([1.1], [2.1], [1.2, 2.2]), []),
+    ],
+)
+def test_xor_multiple_arrays_comparison_rules(func, rule_keyword, rule, use_keyword, case, expected):
+    original = [array[:] for array in case]
+    if use_keyword:
+        result = func(*case, **{rule_keyword: rule})
+    else:
+        result = func(*case, rule)
+
+    assert result == expected
+    assert list(case) == original
+
+
+@parametrize(
+    "func,rule_keyword,rule",
