+        (_.xor_by, "iteratee", "x"),
+        (_.xor_with, "comparator", lambda a, b: a["x"] == b["x"]),
+    ],
+)
+@parametrize("use_keyword", [False, True])
+def test_xor_multiple_arrays_objects(func, rule_keyword, rule, use_keyword):
+    arrays = [
+        [{"x": 1, "source": "a"}, {"x": 2, "source": "a"}],
+        [{"x": 2, "source": "b"}, {"x": 3, "source": "b"}],
+        [{"x": 1, "source": "c"}, {"x": 4, "source": "c"}],
+        [{"x": 3, "source": "d"}, {"x": 5, "source": "d"}],
+    ]
+    original = [[item.copy() for item in array] for array in arrays]
+    if use_keyword:
+        result = func(*arrays, **{rule_keyword: rule})
+    else:
+        result = func(*arrays, rule)
+
+    assert result == [{"x": 4, "source": "c"}, {"x": 5, "source": "d"}]
+    assert result[0] is arrays[2][1]
+    assert result[1] is arrays[3][1]
+    assert arrays == original
