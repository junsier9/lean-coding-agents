+@pytest.mark.parametrize('cache_type', [LRI, LRU])
+@pytest.mark.parametrize('max_size', [1, 3])
+def test_cache_overwrite_mapping_views(cache_type, max_size):
+    cache = cache_type(max_size=max_size, values=[('key', 'old')])
+
+    for value in ('new', None, 'newest'):
+        cache['key'] = value
+        assert cache['key'] == value
+        assert dict(cache) == {'key': value}
+        assert list(cache.values()) == [value]
+        assert list(cache.items()) == [('key', value)]
+        assert cache.copy() == cache
+        assert len(cache) == 1
+
+    assert cache.pop('key') == 'newest'
+    assert not cache
+
+
+@pytest.mark.parametrize('cache_type', [LRI, LRU])
+def test_cache_update_overwrites(cache_type):
+    cache = cache_type(max_size=2, values=[('key', 'old'), ('key', 'initial')])
+    assert dict(cache) == {'key': 'initial'}
+
+    cache.update({'key': 'mapping'})
+    assert dict(cache) == {'key': 'mapping'}
+
+    cache.update([('key', 'pair'), ('key', 'last pair')], key='keyword')
+    assert cache['key'] == 'keyword'
+    assert dict(cache) == {'key': 'keyword'}
+    assert list(cache.values()) == ['keyword']
+    assert cache.popitem() == ('key', 'keyword')
+    assert not cache
+
+
+@pytest.mark.parametrize('cache_type', [LRI, LRU])
+def test_cache_overwrite_eviction(cache_type):
+    cache = cache_type(max_size=2, values=[('a', 1), ('b', 2)])
+    cache['a'] = 3
+    assert dict(cache) == {'a': 3, 'b': 2}
+    assert len(cache) == 2
+
+    cache['c'] = 4
+    assert dict(cache) == {'a': 3, 'c': 4}
+    assert len(cache) == 2
+
+    # Reading 'a' refreshes only LRU's eviction order.
+    assert cache['a'] == 3
+    cache['d'] = 5
+    expected = {'c': 4, 'd': 5} if cache_type is LRI else {'a': 3, 'd': 5}
+    assert dict(cache) == expected
+    assert len(cache) == 2
+
+
