 import sys
 
+import pytest
+
 from boltons.listutils import SplayList, BarrelList
 
 
@@ -51,6 +53,34 @@ def test_barrel_list():
     bl3[:20:2] = range(0, -10, -1)
     assert bl3[6] == -3  # some truly tricky stepping/slicing works
 
+
+@pytest.mark.parametrize('use_class_call', [False, True])
+def test_barrel_list_sort_after_delete_and_split(use_class_call):
+    expected = [i % 1000 - 500 for i in range(100000, 0, -1)]
+    bl = BarrelList(expected)
+    del bl[10:5000]
+    del expected[10:5000]
+    middle = len(expected) // 2
+    assert bl.pop(middle) == expected.pop(middle)
+    assert len(bl.lists) > 1
+    del bl[5]
+    del expected[5]
+
+    expected.sort()
+    if use_class_call:
+        result = BarrelList.sort(self=bl)
+    else:
+        result = bl.sort()
+
+    assert result is None
+    assert list(bl) == expected
+    assert len(bl) == len(expected)
+    assert bl[0] == expected[0]
+    assert bl[-1] == expected[-1]
+    assert len(bl.lists) > 1
+    assert all(len(part) <= bl._cur_size_limit for part in bl.lists)
+
+
