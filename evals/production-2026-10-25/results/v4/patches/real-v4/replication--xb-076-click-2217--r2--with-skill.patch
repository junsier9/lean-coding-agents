@@ -1552,6 +1552,11 @@ class MultiCommand(Command):
         :param replace: if set to `True` an already existing result
                         callback will be removed.
 
+        .. versionchanged:: 8.1
+            The group callback's return value is passed if no subcommand
+            is invoked, ``invoke_without_command`` is enabled, and
+            chaining is disabled.
+
         .. versionchanged:: 8.0
             Renamed from ``resultcallback``.
 
@@ -1626,11 +1631,11 @@ class MultiCommand(Command):
         if not ctx.protected_args:
             if self.invoke_without_command:
                 # No subcommand was invoked, so the result callback is
-                # invoked with None for regular groups, or an empty list
-                # for chained groups.
+                # invoked with the group return value for regular
+                # groups, or an empty list for chained groups.
                 with ctx:
-                    super().invoke(ctx)
-                    return _process_result([] if self.chain else None)
+                    rv = super().invoke(ctx)
