+    def test_lt_only(self):
+        class LtOnly:
+            def __init__(self, value):
+                self.value = value
+
+            def __lt__(self, other):
+                return self.value < other.value
+
+        for reverse, strict, use_key in product([False, True], repeat=3):
+            for values, expected in [
+                ([], True),
+                ([1], True),
+                ([1, 2, 3], True),
+                ([1, 1, 2, 3], not strict),
+                ([1, 3, 2], False),
+            ]:
+                if reverse:
+                    values = values[::-1]
+                key = LtOnly if use_key else None
+                iterable = values if use_key else list(map(LtOnly, values))
+                with self.subTest(
+                    values=values, reverse=reverse, strict=strict, key=key
+                ):
+                    self.assertEqual(
+                        mi.is_sorted(
+                            iter(iterable),
+                            key=key,
+                            reverse=reverse,
+                            strict=strict,
+                        ),
+                        expected,
+                    )
+                    if expected:
+                        self.assertEqual(
+                            sorted(iterable, key=key, reverse=reverse),
+                            iterable,
+                        )
+
+    def test_strict_incomparable(self):
+        for reverse in [False, True]:
+            for values in [[0, 'nan', 0, 'nan'], ['nan', 0, 'nan', 0]]:
+                for key in [None, float]:
+                    iterable = (
+                        list(map(float, values)) if key is None else values
+                    )
+                    with self.subTest(
+                        values=values, reverse=reverse, key=key
+                    ):
+                        self.assertFalse(
+                            mi.is_sorted(
+                                iterable, key=key, reverse=reverse, strict=True
+                            )
+                        )
+
+    def test_short_circuit(self):
+        for reverse, strict in product([False, True], repeat=2):
+            values = [1, 2, 0] if reverse else [2, 1, 3]
+            iterator = iter(values)
+            seen = []
+
+            def key(value):
+                seen.append(value)
+                return value
+
+            with self.subTest(reverse=reverse, strict=strict):
+                self.assertFalse(
+                    mi.is_sorted(
+                        iterator, key=key, reverse=reverse, strict=strict
+                    )
+                )
+                self.assertEqual(seen, values[:2])
+                self.assertEqual(list(iterator), values[2:])
+
+    def test_comparison_error(self):
+        class BrokenComparison:
+            def __lt__(self, other):
+                raise RuntimeError('comparison failed')
+
+        for reverse, strict in product([False, True], repeat=2):
+            with self.subTest(reverse=reverse, strict=strict):
+                with self.assertRaisesRegex(
+                    RuntimeError, 'comparison failed'
+                ):
+                    mi.is_sorted(
+                        [BrokenComparison(), BrokenComparison()],
+                        reverse=reverse,
+                        strict=strict,
+                    )
