+@parametrize(
+    "factory",
+    [list, iter, lambda values: (value for value in values), lambda values: map(_.identity, values)],
+    ids=["list", "iterator", "generator", "map"],
+)
+@parametrize("function", [_.take_while, _.drop_while])
+@parametrize(
+    "values,predicate,taken,dropped",
+    [
+        ([], None, [], []),
+        ([1, 2, 3, 4, 5], lambda value: value < 3, [1, 2], [3, 4, 5]),
+        ([1, 2, 3], lambda value: True, [1, 2, 3], []),
+        ([1, 2, 3], lambda value: False, [], [1, 2, 3]),
+        ([1, 2, 0, 3], None, [1, 2], [0, 3]),
+        ([0, 1, 2], None, [], [0, 1, 2]),
+        ([1, 1, 1, 1], lambda value, index: index < 2, [1, 1], [1, 1]),
+        (
+            [{"active": True}, {"active": False}, {"active": True}],
+            "active",
+            [{"active": True}],
+            [{"active": False}, {"active": True}],
+        ),
+        (
+            [{"active": True}, {"active": False}, {"active": True}],
+            {"active": True},
+            [{"active": True}],
+            [{"active": False}, {"active": True}],
+        ),
+    ],
+)
+def test_while_iterables(factory, function, values, predicate, taken, dropped):
+    expected = taken if function is _.take_while else dropped
+    assert function(factory(values), predicate) == expected
+
+
+@parametrize("factory", [list, iter, lambda values: (value for value in values)])
+@parametrize("function,expected", [(_.take_while, [1, 2]), (_.drop_while, [3, 4, 5])])
+def test_while_predicate_arguments_and_short_circuit(factory, function, expected):
+    array = factory([1, 2, 3, 4, 5])
+    calls = []
+
+    def predicate(value, index, collection):
+        assert collection is array
+        calls.append((value, index))
+        return value < 3
+
+    assert function(array, predicate) == expected
+    assert calls == [(1, 0), (2, 1), (3, 2)]
+
+
+def test_take_while_does_not_consume_remaining_items():
+    array = (value for value in [1, 2, 3, 4, 5])
+    assert _.take_while(array, lambda value: value < 3) == [1, 2]
+    assert list(array) == [4, 5]
+
+
+@parametrize("method,expected", [("take_while", [1, 2]), ("drop_while", [3, 4, 5])])
+def test_while_reiterable_and_chaining(method, expected):
+    class IterableOnly:
+        def __iter__(self):
+            return iter([1, 2, 3, 4, 5])
+
+    def predicate(value):
+        return value < 3
+
+    assert getattr(_, method)(IterableOnly(), predicate) == expected
+    assert getattr(_.chain(IterableOnly()), method)(predicate).value() == expected
+
