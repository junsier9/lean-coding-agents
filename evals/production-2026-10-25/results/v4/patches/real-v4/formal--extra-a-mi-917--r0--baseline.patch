+    def test_comparison_protocol(self):
+        class LtOnly:
+            def __init__(self, value):
+                self.value = value
+
+            def __lt__(self, other):
+                return self.value < other.value
+
+        class LtAndEq(LtOnly):
+            def __eq__(self, other):
+                return self.value == other.value
+
+        pool = [LtOnly(value) for value in range(3)]
+        for item_type, reverse, strict, use_key in product(
