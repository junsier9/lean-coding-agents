+        ):
+            for size in range(4):
+                for values in product(range(3), repeat=size):
+                    # Reuse objects for identity equality; also test distinct
+                    # objects that compare equal by value.
+                    items = [
+                        pool[value]
+                        if item_type is LtOnly
+                        else item_type(value)
+                        for value in values
+                    ]
+                    sorted_values = [
+                        item.value for item in sorted(items, reverse=reverse)
+                    ]
+                    self.assertEqual(
+                        sorted_values, sorted(values, reverse=reverse)
+                    )
