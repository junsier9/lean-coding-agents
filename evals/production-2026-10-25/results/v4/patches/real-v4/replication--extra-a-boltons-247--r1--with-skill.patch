+@pytest.mark.parametrize('default_maxsize, maxsize, size', [
+    (8, 10, 10),
+    (8, 100, 100),
+    (100, 3, 3),
+    (100, 0, 0),
+])
+def test_netstring_maxsize_override(default_maxsize, maxsize, size):
+    x, y = socket.socketpair()
+    try:
+        client = NetstringSocket(x, maxsize=default_maxsize)
+        payload = b'a' * size
+        y.sendall(str(size).encode('ascii') + b':' + payload + b',')
+        assert client.read_ns(maxsize=maxsize) == payload
+        assert client.maxsize == default_maxsize
+
+        size = default_maxsize + 1
+        y.sendall(str(size).encode('ascii') + b':')
+        with pytest.raises(NetstringMessageTooLong,
+                           match='%s > %s' % (size, default_maxsize)):
+            client.read_ns()
+    finally:
+        x.close()
+        y.close()
+
+
+@pytest.mark.parametrize('default_maxsize, maxsize, size', [
+    (100, 3, 4),
+    (100, 0, 1),
+    (9, 10, 11),
+])
+def test_netstring_maxsize_override_rejects(default_maxsize, maxsize, size):
+    x, y = socket.socketpair()
+    try:
+        client = NetstringSocket(x, maxsize=default_maxsize)
+        y.sendall(str(size).encode('ascii') + b':')
+        y.shutdown(socket.SHUT_WR)
+        with pytest.raises(NetstringMessageTooLong,
+                           match='%s > %s' % (size, maxsize)):
+            client.read_ns(maxsize=maxsize)
+    finally:
+        x.close()
+        y.close()
+
+
+@pytest.mark.parametrize('data', [b'', b'1:', b'1:a'])
+@pytest.mark.parametrize('timeout, default_timeout, error_type', [
+    (0, 0.1, socket.error),
+    (0.01, 0, Timeout),
+])
+def test_netstring_timeout_override(data, timeout, default_timeout, error_type):
+    x, y = socket.socketpair()
+    try:
+        x.settimeout(default_timeout)
+        client = NetstringSocket(x, timeout=default_timeout)
+        y.sendall(data)
+        with pytest.raises(error_type) as exc:
+            client.read_ns(timeout)
+        if timeout == 0:
+            assert exc.value.errno == errno.EWOULDBLOCK
+        assert client.timeout == default_timeout
+        assert client.bsock.gettimeout() == default_timeout
+    finally:
+        x.close()
+        y.close()
+
+
+@pytest.mark.parametrize('data', [b'', b'1:', b'1:a'])
+def test_netstring_default_timeout(data):
+    x, y = socket.socketpair()
+    try:
+        x.setblocking(False)
+        client = NetstringSocket(x)
+        client.settimeout(0.01)
+        y.sendall(data)
+        with pytest.raises(Timeout):
+            client.read_ns()
+    finally:
+        x.close()
+        y.close()
+
+
+def test_netstring_timeout_none():
+    x, y = socket.socketpair()
+    try:
+        x.setblocking(False)
+        client = NetstringSocket(x, timeout=0.1)
+        y.sendall(b'1:a,')
+        assert NetstringSocket.read_ns(self=client, timeout=None) == b'a'
+        assert x.gettimeout() is None
+        assert client.timeout == 0.1
+        assert client.bsock.gettimeout() == 0
+    finally:
+        x.close()
+        y.close()
+
+
+@pytest.mark.parametrize('data, error_type', [
+    (b'x:', NetstringInvalidSize),
+    (b'123:', MessageTooLong),
+    (b'1:ax', NetstringProtocolError),
+    (b'1:a', NetstringProtocolError),
+    (b'2:a', ConnectionClosed),
+])
+def test_netstring_protocol_errors_with_overrides(data, error_type):
+    x, y = socket.socketpair()
+    try:
+        client = NetstringSocket(x, maxsize=100)
+        y.sendall(data)
+        y.shutdown(socket.SHUT_WR)
+        with pytest.raises(error_type) as exc:
+            client.read_ns(timeout=0.1, maxsize=9)
+        assert type(exc.value) is error_type
+    finally:
+        x.close()
+        y.close()
+
+
