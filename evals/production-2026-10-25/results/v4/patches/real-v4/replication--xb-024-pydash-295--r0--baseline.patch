+@parametrize("mapping_type", [dict, MappingProxyType])
+@parametrize(
+    "case,expected",
+    [
+        (({"a": 1, "b": 2, "c": 3}, helpers.reduce_iteratee0), 6),
+        (({"a": 1, "b": 2, "c": 3},), 1),
+        (({"a": 7}, helpers.noop), 7),
+        (({"a": 1, "b": 2, "c": 3}, helpers.reduce_iteratee0, 0), 6),
+        (({}, helpers.reduce_iteratee0, 0), 0),
+    ],
+)
+def test_reduce_mapping(mapping_type, case, expected):
+    collection = mapping_type(case[0])
+    assert _.reduce_(collection, *case[1:]) == expected
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+def test_reduce_mapping_callback_order(mapping_type):
+    collection = mapping_type({"c": 10, "a": 3, "b": 2})
+    calls = []
+
+    def iteratee(total, value, key):
+        calls.append((total, value, key))
+        return total - value
+
+    assert _.reduce_(collection, iteratee) == 5
+    assert calls == [(10, 3, "a"), (7, 2, "b")]
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+def test_reduce_empty_mapping_raise(mapping_type):
+    with pytest.raises(TypeError, match=r"^reduce_\(\) of empty sequence with no initial value$"):
+        _.reduce_(mapping_type({}))
+
