+    def test_decorator_class_access(self):
+        for name in ("get", "get_info"):
+            with self.subTest(method=name):
+                cached = Cached(self.cache(2))
+                with warnings.catch_warnings():
+                    warnings.simplefilter("error")
+                    method = getattr(Cached, name)
+                    self.assertEqual(method.__name__, name)
+                    self.assertEqual(method(cached, 0), 0)
+                    self.assertEqual(method(self=cached, value=1), 1)
