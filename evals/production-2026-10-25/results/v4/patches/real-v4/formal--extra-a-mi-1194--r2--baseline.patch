     """Return an iterator over the last *n* items of *iterable*.
 
+    If *n* is negative, raise :exc:`ValueError`.
+
     >>> t = tail(3, 'ABCDEFG')
     >>> list(t)
     ['E', 'F', 'G']
 
     """
+    if n < 0:
+        raise ValueError('n must be >= 0')
     try:
         size = len(iterable)
