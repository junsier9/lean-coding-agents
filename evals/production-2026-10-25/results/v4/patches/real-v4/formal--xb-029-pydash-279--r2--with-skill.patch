+def test_duplicates_falsey_iteratee(array, iteratee, expected_indices):
+    for result in (
+        _.duplicates(array, iteratee),
+        _.duplicates(array=array, iteratee=iteratee),
+        _.chain(array).duplicates(iteratee).value(),
+    ):
+        assert len(result) == len(expected_indices)
+        assert all(item is array[index] for item, index in zip(result, expected_indices))
+
+
+@parametrize("truth_value", [False, True, None])
+def test_duplicates_callable_without_truth_testing(truth_value):
+    calls = []
+
+    class Key:
+        def __bool__(self):
+            if truth_value is None:
+                raise AssertionError("iteratee truth value must not be tested")
+            return truth_value
+
+        def __call__(self, item):
+            calls.append(item)
+            return item[0]
+
+    array = [[1, "a"], [2, "b"], [1, "c"], [2, "d"], [1, "c"]]
+    result = _.duplicates(array, Key())
+
+    assert calls == array
+    assert len(result) == 2
+    assert result[0] is array[2]
+    assert result[1] is array[3]
+
+
+def test_duplicates_iteratee_error_propagates():
+    error = ValueError("iteratee failed")
+
+    def fail(item):
+        raise error
+
+    with pytest.raises(ValueError) as exc_info:
+        _.duplicates([1, 1], fail)
+
+    assert exc_info.value is error
+
