+    def test_missing_lookup_does_not_add_keys(self):
+        for iterable in ([], ['a1', 'b1', 'a2']):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: x[0])
+                expected = {item[0] for item in iterable}
+
+                self.assertEqual(list(D['missing']), [])
+                self.assertEqual(set(D), expected)
+                self.assertEqual(list(D['missing']), [])
+                self.assertEqual(set(D), expected)
+                self.assertEqual(
+                    list(D['a']), [x for x in iterable if x[0] == 'a']
+                )
+
+    def test_missing_membership_does_not_add_keys(self):
+        for iterable in ([], ['a1', 'b1', 'a2']):
+            with self.subTest(iterable=iterable):
+                D = mi.bucket(iterable, key=lambda x: x[0])
+                expected = {item[0] for item in iterable}
+
+                self.assertNotIn('missing', D)
+                self.assertEqual(set(D), expected)
+                self.assertNotIn('missing', D)
+                self.assertEqual(set(D), expected)
+                self.assertEqual(
+                    list(D['a']), [x for x in iterable if x[0] == 'a']
+                )
+
+    def test_drained_buckets_keep_keys(self):
+        D = mi.bucket(['a1', 'b1', 'a2'], key=lambda x: x[0])
+        a_items = D['a']
+        self.assertEqual(next(a_items), 'a1')
+        self.assertEqual(list(D), ['a', 'b'])
+        self.assertEqual(list(a_items), ['a2'])
+        self.assertNotIn('a', D)
+        self.assertEqual(list(D['b']), ['b1'])
+        self.assertNotIn('b', D)
+        self.assertEqual(list(D), ['a', 'b'])
+
