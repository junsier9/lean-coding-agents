diff --git a/tests/test_namedutils.py b/tests/test_namedutils.py
index e2230a7..bc28eca 100644
--- a/tests/test_namedutils.py
+++ b/tests/test_namedutils.py
@@ -1,5 +1,7 @@
 from pickle import loads, dumps
 
+import pytest
+
 from boltons.namedutils import namedlist, namedtuple
 
 Point = namedtuple('Point', 'x, y', rename=True)
@@ -24,3 +26,51 @@ def test_namedlist_pickle():
 def test_namedtuple_pickle():
     p = Point(x=10, y=20)
     assert p == loads(dumps(p))
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+@pytest.mark.parametrize('rename', [False, True])
+@pytest.mark.parametrize('typename', ['', 'Bad-Name', 'Bad Name'])
+def test_invalid_typename(factory, rename, typename):
+    with pytest.raises(ValueError):
+        factory(typename, ['x', 'y'], rename=rename)
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+@pytest.mark.parametrize('field_names', [
+    [''], ['', 'y'], ['x', ''], ['x', '', 'z'], ['bad-name'], ['bad name'],
+])
+def test_invalid_field_names(factory, field_names):
+    with pytest.raises(ValueError):
+        factory('Point', field_names)
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+def test_rename_invalid_field_names(factory):
+    point_type = factory('Point', ['', 'bad-name', 'x'], rename=True)
+    point = point_type(10, 20, x=30)
+
+    assert point_type._fields == ('_0', '_1', 'x')
+    assert (point._0, point._1, point.x) == (10, 20, 30)
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+@pytest.mark.parametrize('rename', [False, True])
+@pytest.mark.parametrize('field_names', ['x, y', ['x', 'y']])
+def test_valid_names(factory, rename, field_names):
+    point_type = factory('Point', field_names, rename=rename)
+    point = point_type(10, y=20)
+
+    assert point_type.__name__ == 'Point'
+    assert point_type._fields == ('x', 'y')
+    assert tuple(point) == (10, 20)
+    assert (point.x, point.y) == (10, 20)
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+@pytest.mark.parametrize('field_names', ['', []])
+def test_no_fields(factory, field_names):
+    empty_type = factory('Empty', field_names)
+
+    assert empty_type._fields == ()
+    assert tuple(empty_type()) == ()
