+@mark.parametrize('value, bounds, expected', [
+    (3, {}, 3),
+    (3, {'lower': None, 'upper': None}, 3),
+    (-3, {'lower': 0}, 0),
+    (3, {'lower': 0}, 3),
+    (-3, {'upper': 0}, -3),
+    (3, {'upper': 0}, 0),
+    (-3, {'lower': 0, 'upper': None}, 0),
+    (3, {'lower': None, 'upper': 0}, 0),
+    (-1.0, {'lower': 0, 'upper': 5}, 0),
+    (1.0, {'lower': 0, 'upper': 5}, 1.0),
+    (101.0, {'lower': 0, 'upper': 5}, 5),
+    (0, {'lower': 0, 'upper': 5}, 0),
+    (5, {'lower': 0, 'upper': 5}, 5),
+    (3, {'lower': 2, 'upper': 2}, 2),
+    (float('inf'), {}, float('inf')),
+    (float('-inf'), {}, float('-inf')),
+    (float('inf'), {'lower': 0}, float('inf')),
+    (float('-inf'), {'lower': 0}, 0),
+    (float('inf'), {'upper': 0}, 0),
+    (float('-inf'), {'upper': 0}, float('-inf')),
+    (3, {'lower': float('-inf'), 'upper': float('inf')}, 3),
+    (10 ** 1000, {}, 10 ** 1000),
+    (10 ** 1000, {'lower': 0}, 10 ** 1000),
+    (-10 ** 1000, {'upper': 0}, -10 ** 1000),
+    (10 ** 1000, {'upper': 10 ** 999}, 10 ** 999),
+    (-10 ** 1000, {'lower': -10 ** 999}, -10 ** 999),
+    (3, {'lower': float('nan')}, 3),
+    (3, {'upper': float('nan')}, 3),
+    (3, {'lower': float('nan'), 'upper': 2}, 2),
+    (3, {'lower': 4, 'upper': float('nan')}, 4),
+])
+def test_clamp(value, bounds, expected):
+    assert clamp(value, **bounds) == expected
+
+
+@mark.parametrize('bounds', [
+    {},
+    {'lower': None, 'upper': None},
+    {'lower': 0},
+    {'upper': 5},
+    {'lower': 0, 'upper': 5},
+])
+def test_clamp_nan(bounds):
+    assert isnan(clamp(float('nan'), **bounds))
+
+
