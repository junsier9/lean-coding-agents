+    def test_maxlen_zero_observations(self):
+        iterable = [None, False, 0, object()]
+        source = iter(iterable)
+        s = mi.seekable(source, maxlen=0)
+        elements = s.elements()
+        for expected in iterable:
+            for _ in range(10):
+                self.assertIs(s.peek(), expected)
+                self.assertTrue(s)
+                self.assertEqual(list(elements), [])
+            self.assertIs(next(s), expected)
+            self.assertEqual(list(elements), [])
+
+        default = object()
+        for _ in range(10):
+            self.assertFalse(s)
+            self.assertIs(s.peek(default), default)
+            with self.assertRaises(StopIteration):
+                s.peek()
+            with self.assertRaises(StopIteration):
+                next(s)
+        self.assertEqual(list(elements), [])
+
+    def test_maxlen_zero_observations_memory(self):
+        s = mi.seekable(repeat(None), maxlen=0)
+        was_tracing = tracemalloc.is_tracing()
+        if not was_tracing:
+            tracemalloc.start()
+        try:
+            for _ in range(100):
+                s.peek()
+                bool(s)
+            before = tracemalloc.get_traced_memory()[0]
+            for _ in range(20_000):
+                s.peek()
+                bool(s)
+            growth = tracemalloc.get_traced_memory()[0] - before
+            self.assertLess(growth, 64 * 1024)
+        finally:
+            if not was_tracing:
+                tracemalloc.stop()
+
+    def test_maxlen_zero_seek_after_peek(self):
+        for method in ('seek', 'relative_seek'):
+            for offset in (-2, 0, 1, 3, 10):
+                with self.subTest(method=method, offset=offset):
+                    s = mi.seekable(range(6), maxlen=0)
+                    self.assertEqual(next(s), 0)
+                    self.assertEqual(s.peek(), 1)
+                    self.assertTrue(s)
+                    getattr(s, method)(offset)
+                    expected = list(range(1, 6))[max(offset, 0) :]
+                    self.assertEqual(list(s), expected)
+                    self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_releases_peeked_item(self):
+        class Item:
+            pass
+
+        s = mi.seekable(map(lambda _: Item(), range(2)), maxlen=0)
+        reference = weakref.ref(s.peek())
+        self.assertIsNotNone(reference())
+        next(s)
+        gc.collect()
+        self.assertIsNone(reference())
+        self.assertEqual(list(s.elements()), [])
+
