+@pytest.mark.parametrize('envvar', [
+    'TEST_PATH', ['TEST_PATH', 'TEST_OTHER_PATH'], None,
+])
+@pytest.mark.parametrize('option_kwargs, invoke_kwargs, expected', [
+    ({}, {}, None),
+    ({'default': '.'}, {}, '.'),
+    ({}, {'default_map': {'path': '.'}}, '.'),
+    ({'multiple': True}, {}, ()),
+    ({'multiple': True, 'default': ('.',)}, {}, ('.',)),
+    ({'nargs': 2, 'default': ('.', '.')}, {}, ('.', '.')),
+])
+def test_empty_envvar_path(runner, envvar, option_kwargs, invoke_kwargs,
+                           expected):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar,
+                  **option_kwargs)
+    def cmd(path):
+        click.echo(repr(path))
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST',
+                           env={'TEST_PATH': '', 'TEST_OTHER_PATH': ''},
+                           **invoke_kwargs)
+    assert result.exit_code == 0
+    assert result.output == repr(expected) + '\n'
+
+
+@pytest.mark.parametrize('envvar', [
+    ['PRIMARY_PATH', 'SECONDARY_PATH'],
+    ('PRIMARY_PATH', 'SECONDARY_PATH'),
+])
+@pytest.mark.parametrize('env', [
+    {'PRIMARY_PATH': '', 'SECONDARY_PATH': '.', 'TEST_PATH': 'missing'},
+    {'PRIMARY_PATH': '', 'SECONDARY_PATH': '', 'TEST_PATH': '.'},
+    {'PRIMARY_PATH': '.', 'SECONDARY_PATH': 'missing', 'TEST_PATH': 'missing'},
+])
+def test_envvar_path_precedence(runner, envvar, env):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar)
+    def cmd(path):
+        click.echo(path)
+
+    result = runner.invoke(cmd, [], auto_envvar_prefix='TEST', env=env)
+    assert result.exit_code == 0
+    assert result.output == '.\n'
+
+
+@pytest.mark.parametrize('env_value, args, exit_code', [
+    ('.', [], 0),
+    (' ', [], 2),
+    ('0', [], 2),
+    ('missing', ['--path', '.'], 0),
+    ('.', ['--path', ''], 2),
+])
+def test_envvar_path_validation(runner, env_value, args, exit_code):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar='TEST_PATH')
+    def cmd(path):
+        click.echo(path)
+
+    result = runner.invoke(cmd, args, env={'TEST_PATH': env_value})
+    assert result.exit_code == exit_code
+    if exit_code == 0:
+        assert result.output == '.\n'
+    else:
+        assert 'Invalid value for "--path"' in result.output
+
+
