+@pytest.mark.parametrize('envvar', ['TEST_PATH', ['TEST_PATH', 'OTHER_PATH']])
+def test_empty_envvar_path(runner, envvar):
+    @click.command()
+    @click.argument('path', type=click.Path(exists=True), envvar=envvar,
+                    default='.')
+    def cmd(path):
+        click.echo(path)
+
+    result = runner.invoke(cmd, [], env={'TEST_PATH': '', 'OTHER_PATH': ''})
+    assert result.exit_code == 0
+    assert result.output == '.\n'
+
