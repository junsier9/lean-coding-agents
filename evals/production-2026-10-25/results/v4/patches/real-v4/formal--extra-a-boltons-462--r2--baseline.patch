diff --git a/tests/test_namedutils.py b/tests/test_namedutils.py
index e2230a7..ad95290 100644
--- a/tests/test_namedutils.py
+++ b/tests/test_namedutils.py
@@ -1,5 +1,7 @@
 from pickle import loads, dumps
 
+import pytest
+
 from boltons.namedutils import namedlist, namedtuple
 
 Point = namedtuple('Point', 'x, y', rename=True)
@@ -24,3 +26,50 @@ def test_namedlist_pickle():
 def test_namedtuple_pickle():
     p = Point(x=10, y=20)
     assert p == loads(dumps(p))
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+@pytest.mark.parametrize('rename', [False, True])
+def test_empty_typename(factory, rename):
+    with pytest.raises(ValueError):
+        factory('', ['x'], rename=rename)
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+@pytest.mark.parametrize('field_names', [[''], ['', 'x'], ['x', ''], ['x', '', 'y']])
+def test_empty_fieldname(factory, field_names):
+    with pytest.raises(ValueError):
+        factory('Record', field_names)
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+def test_rename_empty_fieldnames(factory):
+    record_type = factory('Record', ['', 'x', ''], rename=True)
+    record = record_type(10, x=20, _2=30)
+
+    assert record_type._fields == ('_0', 'x', '_2')
+    assert (record._0, record.x, record._2) == (10, 20, 30)
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+@pytest.mark.parametrize('invalid_name', ['bad-name', 'bad name', 'name!'])
+@pytest.mark.parametrize('is_typename', [False, True])
+def test_invalid_name_characters(factory, invalid_name, is_typename):
+    typename = invalid_name if is_typename else 'Record'
+    field_names = ['x'] if is_typename else [invalid_name]
+
+    with pytest.raises(ValueError):
+        factory(typename, field_names)
+
+
+@pytest.mark.parametrize('factory', [namedtuple, namedlist])
+@pytest.mark.parametrize('rename', [False, True])
+@pytest.mark.parametrize('field_names', [['field_1', 'field2'], 'field_1, field2'])
+def test_valid_names(factory, rename, field_names):
+    record_type = factory('Record1', field_names, rename=rename)
+    record = record_type(10, field2=20)
+
+    assert record_type.__name__ == 'Record1'
+    assert record_type._fields == ('field_1', 'field2')
+    assert (record.field_1, record.field2) == (10, 20)
+    assert list(record) == [10, 20]
