+@parametrize(
+    "xor_func,rule,keyword",
+    [
+        (_.xor_by, lambda item: item["x"], "iteratee"),
+        (_.xor_by, "x", "iteratee"),
+        (_.xor_with, lambda left, right: left["x"] == right["x"], "comparator"),
+    ],
+)
+@parametrize("use_keyword", [False, True])
+@parametrize(
+    "arrays,expected",
+    [
+        (
+            ([{"x": 1}, {"x": 4}], [{"x": 2}], [{"x": 1, "other": True}, {"x": 3}]),
+            [{"x": 4}, {"x": 2}, {"x": 3}],
+        ),
+        (
+            (
+                [{"x": 1}, {"x": 4}],
+                [{"x": 2}],
+                [{"x": 1, "other": True}, {"x": 3}],
+                [{"x": 2, "other": True}, {"x": 5}],
+            ),
+            [{"x": 4}, {"x": 3}, {"x": 5}],
+        ),
+    ],
+)
+def test_xor_multiple_arrays_preserves_comparison_rule(
+    xor_func, rule, keyword, use_keyword, arrays, expected
+):
+    original_arrays = tuple(array[:] for array in arrays)
+
+    if use_keyword:
+        result = xor_func(*arrays, **{keyword: rule})
+    else:
+        result = xor_func(*arrays, rule)
+
+    assert result == expected
+    assert arrays == original_arrays
+
