+class OneOnlyExceptionTests(TestCase):
+    def test_custom_exception_instances(self):
+        class FalsyError(Exception):
+            def __bool__(self):
+                return False
+
+        class EmptyError(Exception):
+            def __len__(self):
+                return 0
+
+        class NoBoolError(Exception):
+            def __bool__(self):
+                raise AssertionError('exception truthiness was evaluated')
+
+        cases = (
+            (mi.one, [], 'too_short'),
+            (mi.one, [1, 2, 3], 'too_long'),
+            (mi.only, [1, 2, 3], 'too_long'),
+        )
+        for function, items, keyword in cases:
+            for error_type in (
+                RuntimeError,
+                FalsyError,
+                EmptyError,
+                NoBoolError,
+            ):
+                with self.subTest(
+                    function=function.__name__,
+                    keyword=keyword,
+                    error_type=error_type,
+                ):
+                    error = error_type('custom error')
+                    iterator = iter(items)
+                    with self.assertRaises(error_type) as raised:
+                        function(iterator, **{keyword: error})
+                    self.assertIs(raised.exception, error)
+                    self.assertEqual(list(iterator), items[2:])
+
+    def test_too_long_repr(self):
+        class BadRepr:
+            def __repr__(self):
+                raise AssertionError('item repr was evaluated')
+
+        for function in (mi.one, mi.only):
+            for position in (0, 1):
+                for error in (None, RuntimeError, RuntimeError('custom')):
+                    with self.subTest(
+                        function=function.__name__,
+                        position=position,
+                        error=error,
+                    ):
+                        items = [0, 1, 2]
+                        items[position] = BadRepr()
+                        iterator = iter(items)
+                        expected = (
+                            AssertionError if error is None else RuntimeError
+                        )
+                        with self.assertRaises(expected) as raised:
+                            function(iterator, too_long=error)
+                        if isinstance(error, BaseException):
+                            self.assertIs(raised.exception, error)
+                        self.assertEqual(list(iterator), [2])
+
+    def test_explicit_none_uses_default_exception(self):
+        message = (
+            "Expected exactly one item in iterable, but got 'foo', "
+            "'bar', and perhaps more."
+        )
+        cases = (
+            (
+                mi.one,
+                [],
+                'too_short',
+                'too few items in iterable (expected 1)',
+            ),
+            (mi.one, ['foo', 'bar', 'baz'], 'too_long', message),
+            (mi.only, ['foo', 'bar', 'baz'], 'too_long', message),
+        )
+        for function, items, keyword, expected in cases:
+            with self.subTest(function=function.__name__, keyword=keyword):
+                iterator = iter(items)
+                with self.assertRaises(ValueError) as raised:
+                    function(iterator, **{keyword: None})
+                self.assertEqual(str(raised.exception), expected)
+                self.assertEqual(list(iterator), items[2:])
+
+
 class IntersperseTest(TestCase):
