@@ -154,6 +154,48 @@ def test_limit_error_rate():
     assert calls == [1, 2]
 
 
+@pytest.mark.parametrize('seconds', [0.5, 1])
+@pytest.mark.parametrize('as_timedelta', [False, True], ids=['seconds', 'timedelta'])
+def test_limit_error_rate_timeout(monkeypatch, seconds, as_timedelta):
+    start = datetime(2020, 1, 1)
+    now = [start]
+
+    class MockDatetime:
+        @staticmethod
+        def now():
+            return now[0]
+
+    monkeypatch.setattr('funcy.flow.datetime', MockDatetime)
+    duration = timedelta(seconds=seconds)
+    timeout = duration if as_timedelta else seconds
+    calls = []
+
+    @limit_error_rate(2, timeout)
+    def limited(value):
+        calls.append(value)
+        if value < 0:
+            raise MyError
+        return value
+
+    with pytest.raises(MyError): limited(-1)
+    with pytest.raises(MyError): limited(-2)
+    with pytest.raises(ErrorRateExceeded): limited(3)
+    assert calls == [-1, -2]
+
+    now[0] = start + duration - timedelta(microseconds=1)
+    with pytest.raises(ErrorRateExceeded): limited(4)
+    assert calls == [-1, -2]
+
+    now[0] = start + duration
+    assert limited(5) == 5
+    assert calls == [-1, -2, 5]
+
+    # A successful call after expiry resets the consecutive failure count.
+    with pytest.raises(MyError): limited(-6)
+    assert limited(7) == 7
+    assert calls == [-1, -2, 5, -6, 7]
+
+
