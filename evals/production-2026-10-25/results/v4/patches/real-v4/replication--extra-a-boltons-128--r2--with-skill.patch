-from pytest import raises
-from boltons.mathutils import ceil, floor
+from math import isnan
+
+from pytest import mark, raises
+from boltons.mathutils import ceil, clamp, floor
 
 
 OPTIONS = [1618, 1378, 166, 1521, 2347, 2016, 879, 2123,
@@ -14,6 +16,73 @@ VALID_UPPER = 2314
 VALID_BETWEEN = 248.5
 
 
+@mark.parametrize('x, lower, upper, expected', [
+    (-1.0, 0, 5, 0),
+    (1.0, 0, 5, 1.0),
+    (101.0, 0, 5, 5),
+    (0, 0, 5, 0),
+    (5, 0, 5, 5),
+    (-1, 2, 2, 2),
+    (3, 2, 2, 2),
+    (-1, 0, None, 0),
+    (0, 0, None, 0),
+    (10, 0, None, 10),
+    (-1, None, 5, -1),
+    (5, None, 5, 5),
+    (10, None, 5, 5),
+    (float('-inf'), 0, 5, 0),
+    (float('inf'), 0, 5, 5),
+    (float('-inf'), 0, None, 0),
+    (float('inf'), None, 5, 5),
+    (float('inf'), 0, None, float('inf')),
+    (float('-inf'), None, 5, float('-inf')),
+    (10 ** 1000, 0, None, 10 ** 1000),
+    (-10 ** 1000, None, 0, -10 ** 1000),
+    (10 ** 1000, -float('inf'), float('inf'), 10 ** 1000),
+    (-10 ** 1000, -float('inf'), float('inf'), -10 ** 1000),
+])
+def test_clamp(x, lower, upper, expected):
+    assert clamp(x, lower, upper) == expected
+    assert clamp(x=x, lower=lower, upper=upper) == expected
+    if upper is None:
+        assert clamp(x, lower) == expected
+    if lower is None:
+        assert clamp(x, upper=upper) == expected
+
+
+@mark.parametrize('x', [0, 1.5, 10 ** 1000, -10 ** 1000,
+                       float('inf'), float('-inf')])
+def test_clamp_unbounded(x):
+    assert clamp(x) is x
+    assert clamp(x, None, None) is x
+
+
+@mark.parametrize('lower, upper', [(None, None), (0, None), (None, 5),
+                                 (0, 5), (-float('inf'), float('inf'))])
+def test_clamp_nan_value(lower, upper):
+    assert isnan(clamp(float('nan'), lower, upper))
+
+
+@mark.parametrize('lower, upper, expected', [
+    (float('nan'), 1, 1),
+    (3, float('nan'), 3),
+    (float('nan'), float('nan'), 2),
+    (float('nan'), None, 2),
+    (None, float('nan'), 2),
+])
+def test_clamp_nan_bounds(lower, upper, expected):
+    assert clamp(2, lower, upper) == expected
+
+
+@mark.parametrize('lower, upper', [(5, 0), (1.5, -1.5),
+                                 (float('inf'), float('-inf'))])
+def test_clamp_reversed_bounds(lower, upper):
+    with raises(ValueError) as exc_info:
+        clamp(2, lower, upper)
+    assert str(exc_info.value) == (
+        'expected upper bound (%r) >= lower bound (%r)' % (upper, lower))
+
+
 def test_ceil_basic():
     assert ceil(VALID_LOWER, OPTIONS) == VALID_LOWER
     assert ceil(VALID_UPPER, OPTIONS) == VALID_UPPER
