+@pytest.mark.parametrize('as_classmethod', [False, True])
+@pytest.mark.parametrize('prewrapped', [False, True])
+def test_decorator_bound_method_arguments(as_classmethod, prewrapped):
+    @decorator
+    def noop(call):
+        return call()
+
+    @decorator
+    def read(call):
+        values = call.receiver, call.x, call.y, call.args, call.z, call.kwargs
+        assert values == call()
+        return values
+
+    class A:
+        def method(receiver, x, y=11, *args, z=12, **kwargs):
+            return receiver, x, y, args, z, kwargs
+
+    if prewrapped:
+        A.method = noop(A.method)
+    if as_classmethod:
+        A.method = classmethod(A.method)
+    receiver = A if as_classmethod else A()
+    bound = receiver.method
+    wrapped = read(read(bound))
+
+    assert wrapped(1) == (receiver, 1, 11, (), 12, {})
+    assert wrapped(1, 2, 3, 4, z=5, extra=6) == (receiver, 1, 2, (3, 4), 5, {'extra': 6})
+    assert wrapped(x=7, y=8, z=9, extra=10) == (receiver, 7, 8, (), 9, {'extra': 10})
+    with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+        wrapped()
+    with pytest.raises(TypeError):
+        noop(bound)()
+
+    @decorator
+    def read_missing(call):
+        return call.missing
+
+    with pytest.raises(AttributeError, match="doesn't have argument named missing"):
+        read_missing(bound)(1)
+
+
+@pytest.mark.parametrize('as_classmethod', [False, True])
+def test_decorator_bound_variadic_method(as_classmethod):
+    @decorator
+    def read(call):
+        assert call.args == call()
+        return call.args
+
+    class A:
+        def method(*args):
+            return args
+
+    if as_classmethod:
+        A.method = classmethod(A.method)
+    receiver = A if as_classmethod else A()
+    wrapped = read(receiver.method)
+    assert wrapped() == (receiver,)
+    assert wrapped(1, 2) == (receiver, 1, 2)
+
+
+def test_decorator_method_receiver_keywords():
+    @decorator
+    def read(call):
+        return call.x, call()
+
+    class A:
+        @read
+        def method(self, x=11):
+            return self, x
+
+        @classmethod
+        @read
+        def class_method(cls, x=11):
+            return cls, x
+
+    a = A()
+    assert a.method() == (11, (a, 11))
+    assert A.method(self=a, x=2) == (2, (a, 2))
+    assert A.class_method(x=3) == (3, (A, 3))
+    assert A.class_method.__func__(cls=A, x=4) == (4, (A, 4))
+
+
