+@pytest.mark.parametrize('as_classmethod', [False, True])
+def test_decorator_bound_posonly_method(as_classmethod):
+    @decorator
+    def read(call):
+        values = call.receiver, call.x, call.args, call.y, call.kwargs
+        assert values == call()
+        return values
+
+    class A:
+        def method(receiver, x=11, /, *args, y=12, **kwargs):
+            return receiver, x, args, y, kwargs
+
+        def required(receiver, x, /):
+            return x
+
+    if as_classmethod:
+        A.method = classmethod(A.method)
+        A.required = classmethod(A.required)
+    receiver = A if as_classmethod else A()
+    wrapped = read(receiver.method)
+    assert wrapped() == (receiver, 11, (), 12, {})
+    assert wrapped(1, 2, y=3) == (receiver, 1, (2,), 3, {})
+    assert wrapped(x=4, receiver=5) == (receiver, 11, (), 12, {'x': 4, 'receiver': 5})
+
+    @decorator
+    def read_x(call):
+        return call.x
+
+    required = read_x(receiver.required)
+    assert required(6) == 6
+    with pytest.raises(AttributeError, match="missing required argument: 'x'"):
+        required(x=6)
