diff --git a/tests/test_termui.py b/tests/test_termui.py
index 7cfa939..9dac38d 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -221,6 +221,55 @@ def test_choices_list_in_prompt(runner, monkeypatch):
     assert "(none, day, week, month)" not in result.output
 
 
+@pytest.mark.parametrize(
+    ("show_default", "expected"),
+    [
+        (None, " [secret-default]"),
+        (True, " [secret-default]"),
+        (False, ""),
+        ("description", " [secret-default]"),
+        ("", " [secret-default]"),
+    ],
+)
+@pytest.mark.parametrize(
+    "default", ["secret-default", lambda: "secret-default"], ids=["static", "callable"]
+)
+@pytest.mark.parametrize("hide_input", [False, True])
+def test_prompt_show_default(runner, show_default, expected, default, hide_input):
+    @click.command()
+    @click.option(
+        "--value",
+        prompt=True,
+        default=default,
+        show_default=show_default,
+        hide_input=hide_input,
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == "secret-default"
+    assert result.output == f"Value{expected}: \n"
+
+
+@pytest.mark.parametrize("show_default", [None, True, False, "description", ""])
+@pytest.mark.parametrize("default", [False, True])
+def test_flag_prompt_show_default(runner, show_default, default):
+    @click.command()
+    @click.option(
+        "--value/--no-value", prompt=True, default=default, show_default=show_default
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value is default
+    expected = "" if show_default is False else f" [{'Y/n' if default else 'y/N'}]"
+    assert result.output == f"Value{expected}: \n"
+
+
 @pytest.mark.parametrize(
     "file_kwargs", [{"mode": "rt"}, {"mode": "rb"}, {"lazy": True}]
 )
