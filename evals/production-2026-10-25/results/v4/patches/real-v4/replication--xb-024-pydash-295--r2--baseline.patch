+@parametrize("mapping_type", [dict, MappingProxyType])
+@parametrize(
+    "data,expected,expected_calls",
+    [
+        ({"a": 10, "b": 3, "c": 2}, 5, [(10, 3, "b"), (7, 2, "c")]),
+        ({"a": 10}, 10, []),
+    ],
+)
+def test_reduce_mapping_without_accumulator(mapping_type, data, expected, expected_calls):
+    calls = []
+
+    def subtract(total, value, key):
+        calls.append((total, value, key))
+        return total - value
+
+    assert _.reduce_(mapping_type(data), subtract) == expected
+    assert calls == expected_calls
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+def test_reduce_mapping_default_iteratee(mapping_type):
+    assert _.reduce_(mapping_type({"b": 2, "a": 1})) == 2
+
+
+@parametrize("mapping_type", [dict, MappingProxyType])
+def test_reduce_empty_mapping_without_accumulator(mapping_type):
+    with pytest.raises(TypeError, match=r"^reduce_\(\) of empty sequence with no initial value$"):
+        _.reduce_(mapping_type({}))
+
