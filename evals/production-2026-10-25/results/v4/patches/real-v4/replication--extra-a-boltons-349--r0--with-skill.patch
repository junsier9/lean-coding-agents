+@pytest.mark.parametrize('cache_type', (LRI, LRU))
+@pytest.mark.parametrize('max_size', (1, 3))
+def test_cache_overwrite_mapping_views(cache_type, max_size):
+    cache = cache_type(max_size=max_size, values=[('key', 'old')])
+
+    for value in ('new', None, object()):
+        cache['key'] = value
+        assert cache['key'] is value
+        assert dict(cache) == {'key': value}
+        assert list(cache.values()) == [value]
+        assert list(cache.items()) == [('key', value)]
+        assert len(cache) == 1
+
+    assert cache.copy()['key'] is value
+    assert cache.pop('key') is value
+    assert not cache
+    with pytest.raises(KeyError):
+        cache['key']
+
+
+@pytest.mark.parametrize('cache_type', (LRI, LRU))
+def test_cache_overwrite_preserves_eviction(cache_type):
+    cache = cache_type(max_size=3,
+                       values=[('a', 'old'), ('b', 'B'), ('c', 'C')])
+    cache['a'] = 'new'
+    assert len(cache) == 3
+    assert dict(cache) == {'a': 'new', 'b': 'B', 'c': 'C'}
+
+    assert cache['b'] == 'B'
+    cache['d'] = 'D'
+    if cache_type is LRI:
+        expected = {'a': 'new', 'c': 'C', 'd': 'D'}
+    else:
+        expected = {'a': 'new', 'b': 'B', 'd': 'D'}
+    assert dict(cache) == expected
+    assert sorted(cache.values()) == sorted(expected.values())
+
+
