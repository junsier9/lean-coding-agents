+        ([3, 1, 2], lambda value: value < 3, ([], [3, 1, 2])),
+        ([1, 2], lambda value: value < 3, ([1, 2], [])),
+        ([1, 2, 0, 3], None, ([1, 2], [0, 3])),
+        ([0, 1], None, ([], [0, 1])),
+        ([1, 2, 3], lambda value, index: index < 2, ([1, 2], [3])),
+        (
+            [{"active": True}, {"active": False}, {"active": True}],
+            "active",
+            ([{"active": True}], [{"active": False}, {"active": True}]),
+        ),
+    ],
+)
+def test_while_non_sliceable_iterables(func, result_index, make_iterable, values, predicate, expected):
+    assert func(make_iterable(values), predicate) == expected[result_index]
+
+
+@parametrize("func,expected", [(_.take_while, [1, 2]), (_.drop_while, [3, 1])])
+def test_while_iterable_predicate_arguments(func, expected):
+    values = iter([1, 2, 3, 1])
+    calls = []
+
+    def predicate(value, index, array):
+        assert array is values
+        calls.append((value, index))
+        return value < 3
+
+    assert func(values, predicate) == expected
+    assert calls == [(1, 0), (2, 1), (3, 2)]
+
+
+def test_take_while_stops_consuming_at_first_false():
+    def values():
+        yield 1
+        yield 2
+        yield 3
+        pytest.fail("take_while consumed beyond the first false predicate")
+
+    assert _.take_while(values(), lambda value: value < 3) == [1, 2]
+
+
+@parametrize("func,expected", [(_.take_while, [1, 2]), (_.drop_while, [3, 1])])
+def test_while_iterates_input_once(func, expected):
+    class IterableOnce:
+        def __init__(self):
+            self.iterated = False
+
+        def __iter__(self):
+            assert not self.iterated
+            self.iterated = True
+            return iter([1, 2, 3, 1])
+
+    assert func(IterableOnce(), lambda value: value < 3) == expected
+
+
+@parametrize("func,expected", [(_.take_while, (1, 2)), (_.drop_while, (3, 1))])
+def test_while_preserves_sequence_type(func, expected):
+    assert func((1, 2, 3, 1), lambda value: value < 3) == expected
+
