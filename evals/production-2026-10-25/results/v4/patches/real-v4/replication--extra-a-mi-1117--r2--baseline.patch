             mi.nth_product(123, 'AB', 'CD', 'EFG', 'AB', 'CD', 'EFG'),
         )
 
+    def test_repeat_iterator_input(self):
+        factories = (iter, lambda pool: (item for item in pool))
+        for iterables, repeat in ((('ab',), 3), (('ab', 'cde'), 2)):
+            expected = list(product(*iterables, repeat=repeat))
+            for factory in factories:
+                for index in range(-len(expected), len(expected)):
+                    with self.subTest(
+                        iterables=iterables,
+                        repeat=repeat,
+                        index=index,
+                        factory=factory,
+                    ):
+                        self.assertEqual(
+                            mi.nth_product(
+                                index, *map(factory, iterables), repeat=repeat
+                            ),
+                            expected[index],
+                        )
+
+    def test_repeat_iterator_invalid_index(self):
+        for index in (-37, 36):
+            with self.subTest(index=index), self.assertRaises(IndexError):
+                mi.nth_product(index, iter('ab'), iter('cde'), repeat=2)
+
+    def test_repeat_empty_iterator(self):
+        for iterables in (('', 'ab'), ('ab', '')):
+            with self.subTest(iterables=iterables):
+                with self.assertRaises(IndexError):
+                    mi.nth_product(0, *map(iter, iterables), repeat=2)
