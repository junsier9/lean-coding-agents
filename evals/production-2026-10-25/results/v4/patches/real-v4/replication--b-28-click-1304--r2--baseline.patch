+@pytest.mark.parametrize('envvar', [
+    'PATH_FROM_ENV', ['PATH_FROM_ENV'], ('PATH_FROM_ENV',), None,
+])
+@pytest.mark.parametrize('attrs, default_map, expected', [
+    ({}, None, None),
+    ({'default': '.'}, None, '.'),
+    ({}, {'path': '.'}, '.'),
+    ({'multiple': True}, None, ()),
+    ({'multiple': True, 'default': ('.',)}, None, ('.',)),
+    ({'nargs': 2, 'default': ('.', '..')}, None, ('.', '..')),
+])
+def test_empty_envvar(runner, envvar, attrs, default_map, expected):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar,
+                  **attrs)
+    def cmd(path):
+        click.echo(repr(path))
+
+    for value in (None, ''):
+        result = runner.invoke(
+            cmd, [], env={'PATH_FROM_ENV': value, 'TEST_PATH': value},
+            auto_envvar_prefix='TEST', default_map=default_map)
+        assert result.exit_code == 0
+        assert not result.exception
+        assert result.output == repr(expected) + '\n'
+
+
+@pytest.mark.parametrize('envvar, expected', [
+    ('PATH_FROM_ENV', 'tests'),
+    (['PATH_FROM_ENV', 'OTHER_PATH'], 'click'),
+    (('PATH_FROM_ENV', 'OTHER_PATH'), 'click'),
+])
+def test_empty_envvar_fallback(runner, envvar, expected):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar)
+    def cmd(path):
+        click.echo(path)
+
+    with runner.isolated_filesystem():
+        os.mkdir('click')
+        os.mkdir('tests')
+        env = {'PATH_FROM_ENV': '', 'OTHER_PATH': 'click', 'TEST_PATH': 'tests'}
+        result = runner.invoke(cmd, [], env=env, auto_envvar_prefix='TEST')
+        assert result.exit_code == 0
+        assert result.output == expected + '\n'
+
+        env['OTHER_PATH'] = ''
+        result = runner.invoke(cmd, [], env=env, auto_envvar_prefix='TEST')
+        assert result.exit_code == 0
+        assert result.output == 'tests\n'
+
+        env['PATH_FROM_ENV'] = '.'
+        result = runner.invoke(cmd, [], env=env, auto_envvar_prefix='TEST')
+        assert result.exit_code == 0
+        assert result.output == '.\n'
+
+        env['PATH_FROM_ENV'] = 'missing'
+        result = runner.invoke(cmd, [], env=env, auto_envvar_prefix='TEST')
+        assert result.exit_code == 2
+        assert 'Path "missing" does not exist.' in result.output
+
+        result = runner.invoke(cmd, ['--path', '.'], env=env,
+                               auto_envvar_prefix='TEST')
+        assert result.exit_code == 0
+        assert result.output == '.\n'
+
+        result = runner.invoke(cmd, ['--path', ''], env=env,
+                               auto_envvar_prefix='TEST')
+        assert result.exit_code == 2
+        assert 'Path "" does not exist.' in result.output
+
+
+@pytest.mark.parametrize('envvar', ['PATH_FROM_ENV', None])
+def test_empty_envvar_required(runner, envvar):
+    @click.command()
+    @click.option('--path', type=click.Path(exists=True), envvar=envvar,
+                  required=True)
+    def cmd(path):
+        pass
+
+    result = runner.invoke(cmd, [],
+                           env={'PATH_FROM_ENV': '', 'TEST_PATH': ''},
+                           auto_envvar_prefix='TEST')
+    assert result.exit_code == 2
+    assert 'Missing option "--path".' in result.output
+
+
