+@pytest.mark.parametrize('envvar, expected', [
+    ('PATH_FROM_ENV', '.'),
+    (['PATH_FROM_ENV', 'OTHER_PATH'], '..'),
+    (('PATH_FROM_ENV', 'OTHER_PATH'), '..'),
+])
+def test_empty_envvar(runner, envvar, expected):
+    @click.command()
+    @click.argument('path', type=click.Path(exists=True), envvar=envvar,
+                    default='.')
+    def cmd(path):
+        click.echo(path)
+
+    result = runner.invoke(cmd, [],
+                           env={'PATH_FROM_ENV': '', 'OTHER_PATH': '..'})
+    assert result.exit_code == 0
+    assert not result.exception
+    assert result.output == expected + '\n'
+
