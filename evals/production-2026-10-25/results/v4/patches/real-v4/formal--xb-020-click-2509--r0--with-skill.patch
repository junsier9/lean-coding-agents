diff --git a/tests/test_termui.py b/tests/test_termui.py
index 7cfa939..1fc01ac 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -234,6 +234,93 @@ def test_file_prompt_default_format(runner, file_kwargs):
     assert result.output == f"file [{__file__}]: \n{__file__}\n"
 
 
+@pytest.mark.parametrize(
+    ("show_default", "display"),
+    [
+        (None, " [default]"),
+        (True, " [default]"),
+        (False, ""),
+        ("label", " [default]"),
+        ("", " [default]"),
+    ],
+)
+@pytest.mark.parametrize("prompt_required", [True, False])
+@pytest.mark.parametrize(("input", "expect"), [("\n", "default"), ("other\n", "other")])
+def test_prompt_show_default(
+    runner, show_default, display, prompt_required, input, expect
+):
+    @click.command()
+    @click.option(
+        "--value",
+        default="default",
+        prompt=True,
+        prompt_required=prompt_required,
+        show_default=show_default,
+    )
+    def cli(value):
+        return value
+
+    args = [] if prompt_required else ["--value"]
+    result = runner.invoke(cli, args, input=input, standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value == expect
+    assert result.output == f"Value{display}: {input}"
+
+
+@pytest.mark.parametrize("show_default", [None, True, False])
+@pytest.mark.parametrize(("default", "display"), [(True, "Y/n"), (False, "y/N")])
+def test_bool_prompt_show_default(runner, show_default, default, display):
+    @click.command()
+    @click.option(
+        "--value/--no-value", default=default, prompt=True, show_default=show_default
+    )
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="\n", standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value is default
+    suffix = f" [{display}]" if show_default is not False else ""
+    assert result.output == f"Value{suffix}: \n"
+
+
+@pytest.mark.parametrize("confirmation_prompt", [False, True])
+def test_prompt_hidden_dynamic_default(runner, confirmation_prompt):
+    @click.command()
+    @click.option(
+        "--password",
+        default=lambda: "secret",
+        prompt=True,
+        hide_input=True,
+        show_default=False,
+        confirmation_prompt=confirmation_prompt,
+    )
+    def cli(password):
+        return password
+
+    result = runner.invoke(cli, input="\nsecret\n", standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value == "secret"
+    expected = "Password: \n"
+    if confirmation_prompt:
+        expected += "Repeat for confirmation: \n"
+    assert result.output == expected
+
+
+def test_prompt_hidden_default_retry(runner):
+    @click.command()
+    @click.option("--value", default=42, prompt=True, show_default=False)
+    def cli(value):
+        return value
+
+    result = runner.invoke(cli, input="invalid\n\n", standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value == 42
+    assert result.output == (
+        "Value: invalid\nError: 'invalid' is not a valid integer.\nValue: \n"
+    )
+
+
 def test_secho(runner):
     with runner.isolation() as outstreams:
         click.secho(None, nl=False)
