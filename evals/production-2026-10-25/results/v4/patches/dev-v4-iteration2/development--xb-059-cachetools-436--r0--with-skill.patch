+class UnboundMethodTest(unittest.TestCase):
+    def test_unbound(self):
+        for name in (
+            "get",
+            "get_typed",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        ):
+            with self.subTest(method=name):
+                first = Unhashable({})
+                second = Unhashable({}, count=10)
+                unbound = getattr(Unhashable, name)
+
+                self.assertEqual(unbound(first, value=0), 0)
+                bound = getattr(first, name)
+                self.assertEqual(bound(value=0), 0)
+                self.assertEqual(unbound(first, value=0), 0)
+                self.assertEqual(unbound(self=first, value=0), 0)
+                self.assertEqual(unbound(second, value=0), 10)
+                other = getattr(second, name)
+                self.assertIsNot(bound, other)
+                self.assertIs(bound.cache, first.cache)
+                self.assertIs(other.cache, second.cache)
+                self.assertEqual((first.count, second.count), (1, 11))
+
+                if name.endswith("info"):
+                    self.assertEqual(bound.cache_info(), (3, 1, None, 1))
+                    self.assertEqual(other.cache_info(), (0, 1, None, 1))
+
+                bound.cache_clear()
+                self.assertEqual(first.cache, {})
+                self.assertEqual(unbound(second, value=0), 10)
+                self.assertEqual(unbound(first, value=0), 1)
+                if name.endswith("info"):
+                    self.assertEqual(bound.cache_info(), (0, 1, None, 1))
+                    self.assertEqual(other.cache_info(), (1, 1, None, 1))
+
+    def test_unbound_keywords(self):
+        for info in (False, True):
+            for lock, condition in (
+                (False, False),
+                (True, False),
+                (False, True),
+                (True, True),
+            ):
+                with self.subTest(info=info, lock=lock, condition=condition):
+
+                    class Keywords(Cached):
+                        @cachedmethod(
+                            lambda obj: obj.cache,
+                            key=lambda _, **kwargs: keys.hashkey(**kwargs),
+                            lock=(lambda obj: obj.lock) if lock else None,
+                            condition=(lambda obj: obj.cond) if condition else None,
+                            info=info,
+                        )
+                        def get(receiver, /, **kwargs):
+                            receiver.count += 1
+                            return kwargs
+
+                    cached = Keywords({})
+                    kwargs = {"self": 1, "obj": 2, "pending": 3}
+                    self.assertEqual(Keywords.get(cached, **kwargs), kwargs)  # type: ignore
+                    self.assertEqual(cached.get(**kwargs), kwargs)
+                    self.assertEqual(cached.count, 1)
+                    with self.assertRaises(TypeError):
+                        Keywords.get(receiver=cached, **kwargs)
+
+    def test_unbound_receiver_keyword(self):
+        class Renamed(Cached):
+            @cachedmethod(lambda obj: obj.cache, info=True)
+            def get(obj, value):
+                obj.count += 1
+                return value
+
+        cached = Renamed({})
+        self.assertEqual(Renamed.get(obj=cached, value=42), 42)  # type: ignore
+        self.assertEqual(cached.get(value=42), 42)
+        self.assertEqual(cached.count, 1)
+        self.assertEqual(cached.get.cache_info(), (1, 1, None, 1))
+        with self.assertRaises(TypeError):
+            Renamed.get(value=42)
+        with self.assertRaises(TypeError):
+            Renamed.get(obj=cached)  # type: ignore
+
+    def test_unbound_wrapped(self):
+        import inspect
+
+        unbound = getattr(Cached, "get")
+        self.assertIs(unbound.__wrapped__, Cached.__dict__["get"].__wrapped__)
+        self.assertEqual(unbound.__name__, "get")
+        self.assertEqual((unbound.__doc__ or "").strip(), "docstring")
+        self.assertEqual(
+            inspect.signature(unbound), inspect.signature(unbound.__wrapped__)
+        )
+
+    def test_unbound_error(self):
+        cached = Cached({})
+        for _ in range(2):
+            with self.assertRaisesRegex(ValueError, "test error"):
+                Cached.get_cond_error(cached, 0)  # type: ignore
+        with self.assertRaisesRegex(ValueError, "test error"):
+            cached.get_cond_error(0)
+        self.assertEqual(cached.cache, {})
+        self.assertEqual(cached.cond.notify_count, 3)
 
 
