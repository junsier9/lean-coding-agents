+
+                    cached = Cached()
+                    kwargs = {"value": 1, "self": 2, "obj": 3, "pending": 4}
+                    self.assertEqual(Cached.get(cached, **kwargs), (1, 2, 3, 4))
+                    self.assertEqual(cached.get(**kwargs), (1, 2, 3, 4))
+                    self.assertEqual(
