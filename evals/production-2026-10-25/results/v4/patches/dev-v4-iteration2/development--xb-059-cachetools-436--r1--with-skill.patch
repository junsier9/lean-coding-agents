+                {},
+                {"lock": True},
+                {"condition": True},
+                {"lock": True, "condition": True},
+            ):
+                with self.subTest(info=info, synchronization=synchronization):
+
+                    class Cached:
+                        def __init__(self):
+                            self.cache = {}
+                            self.lock = CountedLock()
