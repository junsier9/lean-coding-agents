+class UnboundMethodTest(unittest.TestCase):
+    def test_calls_share_instance_wrapper(self):
+        for name in (
+            "get",
+            "get_typed",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        ):
+            with self.subTest(method=name):
+                method = getattr(Cached, name)
+                cached = Cached(Cache(2))
+                other = Unhashable(Cache(2), count=10)
+                self.assertEqual(
+                    inspect.signature(method), inspect.signature(method.__wrapped__)
+                )
+                self.assertEqual(method.__doc__, method.__wrapped__.__doc__)
+
+                self.assertEqual(method(cached, 0), 0)
+                bound = getattr(cached, name)
+                self.assertIs(bound, cached.__dict__[name])
+                self.assertEqual(bound(0), 0)
+                self.assertEqual(method(cached, value=1), 1)
+                self.assertEqual(bound(value=1), 1)
+                other_bound = getattr(other, name)
+                self.assertEqual(method(other, 0), 10)
+                self.assertEqual(other_bound(0), 10)
+                self.assertIsNot(bound, other_bound)
+                self.assertIs(bound.__wrapped__, method.__wrapped__)
+                self.assertEqual(bound.__name__, method.__name__)
+
+                if name.endswith("info"):
+                    self.assertEqual(bound.cache_info(), (2, 2, 2, 2))
+                    self.assertEqual(other_bound.cache_info(), (1, 1, 2, 1))
+
+                bound.cache_clear()
+                self.assertEqual(len(cached.cache), 0)
+                self.assertEqual(len(other.cache), 1)
+                self.assertEqual(method(cached, 0), 2)
+                self.assertEqual(getattr(Cached, name)(other, 0), 10)
+                if name.endswith("info"):
+                    self.assertEqual(bound.cache_info(), (0, 1, 2, 1))
+                    self.assertEqual(other_bound.cache_info(), (2, 1, 2, 1))
+
+    def test_receiver_keywords(self):
+        for info in (False, True):
