+class UnboundMethodTest(unittest.TestCase):
+    methods = (
+        "get",
+        "get_typed",
+        "get_info",
+        "get_lock",
+        "get_lock_info",
+        "get_cond",
+        "get_cond_info",
+        "get_lock_cond",
+        "get_lock_cond_info",
+    )
+
+    def test_unbound_calls(self):
+        for name in self.methods:
+            with self.subTest(method=name):
+                method = getattr(Cached, name)
+                first = Cached(Cache(2))
+                second = Unhashable(Cache(2), count=10)
+
+                self.assertEqual(method(first, 0), 0)
+                bound = getattr(first, name)
+                self.assertEqual(bound(0), 0)
+                self.assertEqual(method(first, 0), 0)
+                self.assertIs(getattr(first, name), bound)
+                self.assertEqual(method(second, 0), 10)
+                self.assertEqual(getattr(second, name)(0), 10)
+                self.assertEqual(method(first, value=1), 1)
+                self.assertEqual(bound(value=1), 1)
+                self.assertEqual((first.count, second.count), (2, 11))
+                self.assertIsNot(first.cache, second.cache)
+
+                self.assertIs(method.__wrapped__, bound.__wrapped__)
+                self.assertEqual(method.__name__, bound.__name__)
+                self.assertEqual(method.__doc__, bound.__doc__)
+
+    def test_unbound_info(self):
+        for name in self.methods:
+            if not name.endswith("_info"):
+                continue
+            with self.subTest(method=name):
+                method = getattr(Cached, name)
+                first = Cached(Cache(2))
+                second = Cached(Cache(2), count=10)
+
+                self.assertEqual(method(first, 0), 0)
+                bound = getattr(first, name)
+                self.assertEqual(bound(0), 0)
+                self.assertEqual(method(first, 0), 0)
+                self.assertEqual(method(second, 0), 10)
+                self.assertEqual(bound.cache_info(), (2, 1, 2, 1))
+                self.assertEqual(getattr(second, name).cache_info(), (0, 1, 2, 1))
+
+                bound.cache_clear()
+                self.assertEqual(bound.cache_info(), (0, 0, 2, 0))
+                self.assertEqual(getattr(second, name).cache_info(), (0, 1, 2, 1))
+                self.assertEqual(method(first, 0), 1)
+                self.assertEqual(bound.cache_info(), (0, 1, 2, 1))
+
+    def test_unbound_cond_error(self):
+        cached = Cached(Cache(2))
+
+        for _ in range(2):
+            with self.assertRaisesRegex(ValueError, "test error"):
+                Cached.get_cond_error(cached, 0)
+        with self.assertRaisesRegex(ValueError, "test error"):
+            cached.get_cond_error(0)
+        self.assertEqual(len(cached.cache), 0)
+        self.assertEqual(cached.cond.notify_count, 3)
+
+    def test_keyword_forwarding(self):
+        for info in (False, True):
+            for synchronization in (
+                {},
+                {"lock": lambda obj: obj.lock},
+                {"condition": lambda obj: obj.cond},
+                {"lock": lambda obj: obj.lock, "condition": lambda obj: obj.cond},
+            ):
+                with self.subTest(info=info, synchronization=synchronization):
+
+                    class KeywordCached(Cached):
+                        @cachedmethod(
+                            lambda obj: obj.cache,
+                            key=keys.hashkey,
+                            info=info,
+                            **synchronization,
+                        )
+                        def get(instance, /, *, self, obj, pending):
+                            instance.count += 1
+                            return self, obj, pending
+
+                    cached = KeywordCached(Cache(2))
+                    kwargs = {"self": 1, "obj": 2, "pending": 3}
+                    self.assertEqual(KeywordCached.get(cached, **kwargs), (1, 2, 3))
+                    self.assertEqual(cached.get(**kwargs), (1, 2, 3))
+                    self.assertEqual(cached.count, 1)
+
