+    def test_decorator_class_call(self):
+        for name in (
+            "get",
+            "get_typed",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        ):
+            with self.subTest(method=name):
+                first = Unhashable(self.cache(2))
+                second = Unhashable(self.cache(2), count=10)
+                unbound = getattr(Cached, name)
+
+                self.assertEqual(unbound(first, 0), 0)
+                self.assertEqual(getattr(first, name)(0), 0)
+                self.assertEqual(unbound(first, 0), 0)
+                self.assertEqual(unbound(second, 0), 10)
+                self.assertEqual(getattr(second, name)(0), 10)
+                self.assertEqual(first.count, 1)
+                self.assertEqual(second.count, 11)
+
+                bound = getattr(first, name)
+                other = getattr(second, name)
+                self.assertIs(bound.cache, first.cache)
+                self.assertIs(other.cache, second.cache)
+                self.assertIsNot(bound, other)
+                if name.endswith("_info"):
+                    maxsize = (
+                        first.cache.maxsize if isinstance(first.cache, Cache) else None
+                    )
+                    self.assertEqual(bound.cache_info(), (2, 1, maxsize, 1))
+                    self.assertEqual(other.cache_info(), (1, 1, maxsize, 1))
+
+                bound.cache_clear()
+                self.assertEqual(len(first.cache), 0)
+                self.assertEqual(len(second.cache), 1)
+                if name.endswith("_info"):
+                    self.assertEqual(bound.cache_info(), (0, 0, maxsize, 0))
+                    self.assertEqual(other.cache_info(), (1, 1, maxsize, 1))
