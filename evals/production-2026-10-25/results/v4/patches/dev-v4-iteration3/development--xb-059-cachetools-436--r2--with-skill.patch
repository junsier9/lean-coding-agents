+class UnboundMethodTest(unittest.TestCase):
+    def test_calls_share_instance_wrapper(self):
+        for name in (
+            "get",
+            "get_typed",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        ):
+            for cls in (Cached, Unhashable):
+                with self.subTest(method=name, cls=cls):
+                    first = cls(Cache(2))
+                    second = cls(Cache(2), count=10)
+                    unbound = getattr(cls, name)
+
+                    self.assertEqual(
+                        inspect.signature(unbound),
+                        inspect.signature(unbound.__wrapped__),
+                    )
+                    self.assertEqual(unbound.__name__, name)
+                    self.assertEqual(unbound.__doc__, unbound.__wrapped__.__doc__)
+                    self.assertNotIn(name, first.__dict__)
+                    self.assertEqual(unbound(first, 0), 0)
+                    bound = getattr(first, name)
+                    self.assertIs(first.__dict__[name], bound)
+                    self.assertEqual(bound(0), 0)
+                    self.assertEqual(unbound(first, 0), 0)
+                    self.assertEqual(unbound(second, 0), 10)
+                    self.assertEqual(first.count, 1)
+                    self.assertEqual(second.count, 11)
+
+                    if name.endswith("_info"):
+                        self.assertEqual(bound.cache_info(), (2, 1, 2, 1))
+                        self.assertEqual(
+                            getattr(second, name).cache_info(), (0, 1, 2, 1)
+                        )
+
+                    bound.cache_clear()
+                    if name.endswith("_info"):
+                        self.assertEqual(bound.cache_info(), (0, 0, 2, 0))
+                    self.assertEqual(unbound(first, 0), 1)
+                    self.assertEqual(bound(0), 1)
+                    self.assertEqual(getattr(second, name)(0), 10)
+                    if name.endswith("_info"):
+                        self.assertEqual(bound.cache_info(), (1, 1, 2, 1))
+                        self.assertEqual(
+                            getattr(second, name).cache_info(), (1, 1, 2, 1)
+                        )
+
+                    bound.cache_clear()
+                    self.assertEqual(unbound(self=first, value=0), 2)
+                    self.assertEqual(bound(value=0), 2)
+                    if name.endswith("_info"):
+                        self.assertEqual(bound.cache_info(), (1, 1, 2, 1))
+
+    def test_receiver_keyword_binding(self):
+        for info in (False, True):
+            for locked, conditioned in (
+                (False, False),
+                (True, False),
+                (False, True),
+                (True, True),
+            ):
+                with self.subTest(info=info, lock=locked, condition=conditioned):
+
+                    class Renamed:
+                        def __init__(self):
+                            self.cache = {}
+                            self.lock = CountedLock()
+                            self.cond = CountedCondition()
+
+                        @cachedmethod(
+                            lambda obj: obj.cache,
+                            key=lambda _, *args, **kwargs: keys.hashkey(*args, **kwargs),
+                            lock=(lambda obj: obj.lock) if locked else None,
+                            condition=(lambda obj: obj.cond) if conditioned else None,
+                            info=info,
+                        )
+                        def get(receiver, value, self):
+                            return value, self
+
+                        @cachedmethod(lambda obj: obj.cache, info=info)
+                        def positional(receiver, /, value):
+                            return value
+
+                    cached = Renamed()
+                    self.assertEqual(
+                        Renamed.get(receiver=cached, value=42, self="payload"),
+                        (42, "payload"),
+                    )
+                    self.assertEqual(
+                        cached.get(value=42, self="payload"), (42, "payload")
+                    )
+                    self.assertEqual(
+                        Renamed.get(cached, value=42, self="payload"), (42, "payload")
+                    )
+                    self.assertEqual(len(cached.cache), 1)
+                    if info:
+                        self.assertEqual(cached.get.cache_info(), (2, 1, None, 1))
+                    with self.assertRaises(TypeError):
+                        Renamed.get(cached, receiver=cached, value=42, self="payload")
+                    with self.assertRaises(TypeError):
+                        Renamed.get(value=42, self="payload")
+                    with self.assertRaises(TypeError):
+                        Renamed.positional(receiver=cached, value=42)
+                    self.assertEqual(Renamed.positional(cached, 42), 42)
+                    self.assertEqual(cached.positional(42), 42)
+
+    def test_condition_error_cleanup(self):
+        cached = Cached(Cache(2))
+        for call in (
