diff --git a/tests/test_cachedmethod.py b/tests/test_cachedmethod.py
index 8d519f6..8421de0 100644
--- a/tests/test_cachedmethod.py
+++ b/tests/test_cachedmethod.py
@@ -1,7 +1,10 @@
+import inspect
 import unittest
 import unittest.mock
 import warnings
 
+import pytest
+
 from cachetools import Cache, cachedmethod, keys
 
 from . import CountedCondition, CountedLock, _TestCaseProtocol
@@ -77,6 +80,114 @@ class Unhashable(Cached):
         raise TypeError("unhashable type")
 
 
+@pytest.mark.parametrize(
+    "name",
+    [
+        "get",
+        "get_typed",
+        "get_info",
+        "get_lock",
+        "get_lock_info",
+        "get_cond",
+        "get_cond_info",
+        "get_lock_cond",
+        "get_lock_cond_info",
+    ],
+)
+@pytest.mark.parametrize("cls", [Cached, Unhashable])
+def test_class_call(name, cls):
+    first = cls(Cache(2))
+    second = cls(Cache(2), count=100)
+    method = getattr(cls, name)
+
+    assert method.__name__ == name
+    assert inspect.signature(method) == inspect.signature(method.__wrapped__)
+    assert method(first, 0) == 0
+    bound = getattr(first, name)
+    assert getattr(first, name) is bound
+    assert bound(0) == 0
+    assert method(first, 0) == 0
+    assert method(self=first, value=1) == 1
+    assert bound(value=1) == 1
+
+    assert method(second, 0) == 100
+    assert method(self=second, value=1) == 101
+    other = getattr(second, name)
+    assert first.count == 2
+    assert second.count == 102
+    assert bound.cache is first.cache
+    assert other.cache is second.cache
+    if name.endswith("_info"):
+        assert bound.cache_info() == (3, 2, 2, 2)
+        assert other.cache_info() == (0, 2, 2, 2)
+
+    bound.cache_clear()
+    assert len(first.cache) == 0
+    assert len(second.cache) == 2
+    if name.endswith("_info"):
+        assert bound.cache_info() == (0, 0, 2, 0)
+        assert other.cache_info() == (0, 2, 2, 2)
+    assert method(first, 0) == 2
+    assert other(0) == 100
+
+
+@pytest.mark.parametrize("info", [False, True])
+@pytest.mark.parametrize("mode", ["unlocked", "locked", "condition", "locked_condition"])
+def test_class_call_keyword_receiver(info, mode):
+    class KeywordReceiver:
+        def __init__(self):
+            self.cache = Cache(2)
+            self.lock = CountedLock()
+            self.cond = CountedCondition()
+
+        @cachedmethod(
+            lambda instance: instance.cache,
+            key=lambda instance, *args, **kwargs: keys.hashkey(*args, **kwargs),
+            lock=(lambda instance: instance.lock)
+            if mode in ("locked", "locked_condition")
+            else None,
+            condition=(lambda instance: instance.cond) if "condition" in mode else None,
+            info=info,
+        )
+        def get(instance, value, *, self, pending):
+            return value, self, pending
+
+    cached = KeywordReceiver()
+    method = KeywordReceiver.get
+    assert method(instance=cached, value=1, self=2, pending=3) == (1, 2, 3)
+    assert cached.get(value=1, self=2, pending=3) == (1, 2, 3)
+    assert method(cached, value=1, self=2, pending=3) == (1, 2, 3)
+    if info:
+        assert cached.get.cache_info() == (2, 1, 2, 1)
+
+
+def test_class_call_positional_only_receiver():
+    class PositionalReceiver:
+        def __init__(self):
+            self.cache = Cache(2)
+
+        @cachedmethod(lambda instance: instance.cache)
+        def get(instance, /, value):
+            return value
+
+    cached = PositionalReceiver()
+    with pytest.raises(TypeError):
+        PositionalReceiver.get(instance=cached, value=1)
+    assert len(cached.cache) == 0
+    assert PositionalReceiver.get(cached, 1) == 1
+    assert cached.get(1) == 1
+
+
+def test_class_call_condition_error():
+    cached = Cached(Cache(2))
+    for _ in range(2):
+        with pytest.raises(ValueError, match="test error"):
+            Cached.get_cond_error(cached, 0)
+    assert len(cached.cache) == 0
+    assert cached.cond.wait_count == 2
+    assert cached.cond.notify_count == 2
+
+
 class MethodDecoratorTestMixin(_TestCaseProtocol):
     def cache(self, _minsize, **_kwargs):
         raise NotImplementedError
