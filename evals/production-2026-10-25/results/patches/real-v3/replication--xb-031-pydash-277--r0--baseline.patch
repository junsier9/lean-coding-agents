@@ -1084,6 +1084,80 @@ def test_xor_with_multiple_arrays(arrays, expected):
     assert _.xor_with(*arrays, comparator=comparator) == expected
 
 
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+@parametrize("first_factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize("other_factory", [list, tuple, iter, lambda values: (value for value in values)])
+def test_xor_iterable_inputs(name, first_factory, other_factory):
+    function = getattr(_, name)
+    assert function(first_factory([1, 2, 2, 3]), other_factory([2, 4])) == [1, 3, 4]
+    assert function(
+        first_factory([1, 2, 2, 5]),
+        other_factory([2, 3, 5]),
+        (value for value in [3, 4, 5]),
+    ) == [1, 4, 5]
+
+
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+@parametrize("factory", [list, tuple, iter, lambda values: (value for value in values)])
+def test_xor_single_and_empty_iterables(name, factory):
+    function = getattr(_, name)
+    values = [1, 2, 2]
+    result = function(factory(values))
+    assert isinstance(result, list)
+    assert result == values
+    assert result is not values
+    assert function(factory([])) == []
+    assert function(factory([]), factory([1, 1, 2])) == [1, 2]
+    assert function(factory([1, 1, 2]), factory([])) == [1, 2]
+    assert function(factory([]), factory([]), factory([])) == []
+
+
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+def test_xor_keeps_input_lists_and_item_references(name):
+    first, shared, last = [1], [2], [3]
+    array = [first, shared, first]
+    other = [shared, last, last]
+    result = getattr(_, name)(array, other)
+    assert result == [first, last]
+    assert result[0] is first
+    assert result[1] is last
+    assert array == [[1], [2], [1]]
+    assert other == [[2], [3], [3]]
+    assert result is not array
+    assert result is not other
+
+
+@parametrize(
+    "name,keyword,callback",
+    [
+        ("xor_by", "iteratee", "id"),
+        ("xor_by", "iteratee", lambda value: value["id"]),
+        ("xor_with", "comparator", lambda left, right: left["id"] == right["id"]),
+    ],
+)
+@parametrize("as_keyword", [False, True])
+@parametrize("factory", [list, tuple, iter, lambda values: (value for value in values)])
+def test_xor_iterables_with_callbacks(name, keyword, callback, as_keyword, factory):
+    one, two, three, four, five = ({"id": value} for value in range(1, 6))
+    arrays = [
+        [one, two, one],
+        [{"id": 2, "updated": True}, three, three],
+        [{"id": 1, "updated": True}, four],
+        [{"id": 3, "updated": True}, five],
+    ]
+    originals = [[dict(value) for value in array] for array in arrays]
+    inputs = [factory(array) for array in arrays]
+    function = getattr(_, name)
+    if as_keyword:
+        result = function(*inputs, **{keyword: callback})
+    else:
+        result = function(*inputs, callback)
+    assert result == [four, five]
+    assert result[0] is four
+    assert result[1] is five
+    assert arrays == originals
+
+
 @parametrize(
