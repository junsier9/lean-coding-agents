+@pytest.mark.parametrize("name", [None, "none-plugin"])
+def test_register_none(pm: PluginManager, name: str | None) -> None:
+    plugin_name = name or pm.get_canonical_name(None)
+    for _ in range(2):
+        with pytest.raises(ValueError, match="Plugin cannot be None"):
+            pm.register(None, name=name)
+
+        assert pm.list_name_plugin() == []
+        assert pm.get_plugins() == set()
+        assert not pm.is_registered(None)
+        assert not pm.is_blocked(plugin_name)
+
+    plugin = object()
+    assert pm.register(plugin, name=plugin_name) == plugin_name
+    assert pm.is_registered(plugin)
+    assert pm.get_plugins() == {plugin}
+    assert pm.unregister(name=plugin_name) is plugin
+    assert pm.list_name_plugin() == []
+
+
+@pytest.mark.parametrize("name", ["new", "existing", "blocked"])
+def test_register_none_preserves_registry(he_pm: PluginManager, name: str) -> None:
+    class Plugin:
+        @hookimpl
+        def he_method1(self, arg: int) -> int:
+            return arg + 1
+
+    plugin = Plugin()
+    he_pm.register(plugin, name="existing")
+    he_pm.set_blocked("blocked")
+    registered = he_pm.list_name_plugin()
+    hookimpls = he_pm.hook.he_method1.get_hookimpls()
+
+    with pytest.raises(ValueError, match="Plugin cannot be None"):
+        he_pm.register(None, name=name)
+
+    assert he_pm.list_name_plugin() == registered
+    assert he_pm.get_plugins() == {plugin}
+    assert he_pm.is_registered(plugin)
+    assert he_pm.is_blocked("blocked")
+    assert not he_pm.is_blocked("new")
+    assert he_pm.hook.he_method1.get_hookimpls() == hookimpls
+    assert he_pm.hook.he_method1(arg=1) == [2]
+
+
+@pytest.mark.parametrize("plugin", [False, 0, ""])
+def test_register_falsy_plugin(pm: PluginManager, plugin: object) -> None:
+    assert pm.register(plugin, name="falsy") == "falsy"
+    assert pm.get_plugin("falsy") is plugin
+    assert pm.is_registered(plugin)
+    assert pm.get_plugins() == {plugin}
+    assert not pm.is_blocked("falsy")
+
+
