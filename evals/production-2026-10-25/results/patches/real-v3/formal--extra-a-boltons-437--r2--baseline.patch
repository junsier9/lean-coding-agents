@@ -110,3 +110,28 @@ def test_bits():
             ).as_int()
         ),
         Bits('101'))
+
+
+@mark.parametrize('width', [0, 1, 2, 8, 64])
+def test_bits_overflow(width):
+    for value in (2 ** width, 2 ** width + 1):
+        with raises(ValueError, match='cannot be represented'):
+            Bits(value, width)
+
+
+@mark.parametrize('width', [1, 2, 8, 64])
+def test_bits_max_value(width):
+    value = 2 ** width - 1
+    bits = Bits(value, width)
+    assert bits.as_int() == value
+    assert len(bits) == width
+    assert bits.as_bin() == '1' * width
+
+
+@mark.parametrize('value, binary', [(0, '0'), (1, '1'), (4, '100'),
+                                  (256, '100000000')])
+def test_bits_inferred_width(value, binary):
+    bits = Bits(value)
+    assert bits.as_int() == value
+    assert len(bits) == len(binary)
+    assert bits.as_bin() == binary
