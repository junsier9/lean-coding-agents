+@pytest.mark.parametrize("reverse_order", [False, True])
+@pytest.mark.parametrize(
+    ("args", "env", "default_map", "expected", "expected_source"),
+    [
+        ([], {}, None, True, click.ParameterSource.DEFAULT),
+        ([], {"TEST_XYZ": "0"}, None, False, click.ParameterSource.ENVIRONMENT),
+        (
+            [],
+            {"TEST_XYZ": "1"},
+            {"enable_xyz": False},
+            True,
+            click.ParameterSource.ENVIRONMENT,
+        ),
+        ([], {}, {"enable_xyz": False}, False, click.ParameterSource.DEFAULT_MAP),
+        (
+            ["--without-xyz"],
+            {"TEST_XYZ": "1"},
+            {"enable_xyz": True},
+            False,
+            click.ParameterSource.COMMANDLINE,
+        ),
+    ],
+)
+def test_shared_parameter_source_during_processing(
+    runner, reverse_order, args, env, default_map, expected, expected_source
+):
+    observed = {}
+
+    class SourceAwareBool(click.types.BoolParamType):
+        def convert(self, value, param, ctx):
+            observed.setdefault(param.opts[0], []).append(
+                ctx.get_parameter_source(param.name)
+            )
+            return super().convert(value, param, ctx)
+
+    def callback(ctx, param, value):
+        observed[param.opts[0]].append(ctx.get_parameter_source(param.name))
+        return value
+
+    params = [
+        click.Option(
+            ["--with-xyz", "enable_xyz"],
+            flag_value=True,
+            default=True,
+            envvar="TEST_XYZ",
+            type=SourceAwareBool(),
+            callback=callback,
+        ),
+        click.Option(
+            ["--without-xyz", "enable_xyz"],
+            flag_value=False,
+            type=SourceAwareBool(),
+            callback=callback,
+        ),
+    ]
+    if reverse_order:
+        params.reverse()
+
+    @click.command(params=params)
+    @click.pass_context
+    def cli(ctx, enable_xyz):
+        return enable_xyz, ctx.get_parameter_source("enable_xyz")
+
+    result = runner.invoke(
+        cli, args, env=env, default_map=default_map, standalone_mode=False
+    )
+    assert result.exit_code == 0, result.output
+    assert result.return_value == (expected, expected_source)
+    for param in params:
+        if args:
+            source = click.ParameterSource.COMMANDLINE
+        elif param.envvar in env:
+            source = click.ParameterSource.ENVIRONMENT
+        elif default_map is not None:
+            source = click.ParameterSource.DEFAULT_MAP
+        else:
+            source = click.ParameterSource.DEFAULT
+        assert observed[param.opts[0]] == [source, source]
+
+
