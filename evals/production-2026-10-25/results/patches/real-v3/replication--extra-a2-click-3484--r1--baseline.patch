+@pytest.mark.parametrize("param_cls", [click.Option, click.Argument])
+@pytest.mark.parametrize("is_eager", [False, True])
+@pytest.mark.parametrize(
+    ("input_value", "env", "default_map", "expected_value", "expected_source"),
+    [
+        (None, {}, None, 1, click.ParameterSource.DEFAULT),
+        (None, {}, {"value": "2"}, 2, click.ParameterSource.DEFAULT_MAP),
+        (None, {}, {"value": None}, None, click.ParameterSource.DEFAULT_MAP),
+        (
+            None,
+            {"TEST_SOURCE": "3"},
+            {"value": "2"},
+            3,
+            click.ParameterSource.ENVIRONMENT,
+        ),
+        (
+            "4",
+            {"TEST_SOURCE": "3"},
+            {"value": "2"},
+            4,
+            click.ParameterSource.COMMANDLINE,
+        ),
+    ],
+)
+def test_parameter_source_during_processing(
+    runner,
+    param_cls,
+    is_eager,
+    input_value,
+    env,
+    default_map,
+    expected_value,
+    expected_source,
+):
+    observed = []
+
+    class SourceAwareType(click.types.IntParamType):
+        def convert(self, value, param, ctx):
+            observed.append(("convert", ctx.get_parameter_source(param.name)))
+            return super().convert(value, param, ctx)
+
+    def callback(ctx, param, value):
+        observed.append(("callback", ctx.get_parameter_source(param.name)))
+        return value
+
+    param = param_cls(
+        ["--value"] if param_cls is click.Option else ["value"],
+        default=1,
+        envvar="TEST_SOURCE",
+        type=SourceAwareType(),
+        is_eager=is_eager,
+        callback=callback,
+    )
+
+    @click.command(params=[param])
+    @click.pass_context
+    def cli(ctx, value):
+        return value, ctx.get_parameter_source("value")
+
+    args = []
+    if input_value is not None:
+        args = ["--value", input_value] if param_cls is click.Option else [input_value]
+
+    result = runner.invoke(
+        cli, args, env=env, default_map=default_map, standalone_mode=False
+    )
+    assert result.exit_code == 0, result.output
+    assert result.return_value == (expected_value, expected_source)
+    phases = ["callback"] if expected_value is None else ["convert", "callback"]
+    assert observed == [(phase, expected_source) for phase in phases]
+
+
+@pytest.mark.parametrize("env", [{}, {"TEST_CONFIG": "environment"}])
+def test_eager_callback_only_replaces_default(runner, env):
+    def configure(ctx, param, value):
+        source = ctx.get_parameter_source(param.name)
+        if source is None or source is click.ParameterSource.DEFAULT:
+            return "configured"
+        return value
+
+    @click.command()
+    @click.option(
+        "--config",
+        default="builtin",
+        envvar="TEST_CONFIG",
+        is_eager=True,
+        callback=configure,
+    )
+    def cli(config):
+        return config
+
+    result = runner.invoke(cli, env=env, standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    assert result.return_value == env.get("TEST_CONFIG", "configured")
+
+
