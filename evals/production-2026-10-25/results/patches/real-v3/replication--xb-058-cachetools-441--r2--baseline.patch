+    def test_ttl_datetime_overflow(self):
+        from datetime import datetime, timedelta
+
+        for now, ttl in (
+            (datetime.max, timedelta(days=1)),
+            (datetime.min, timedelta(days=-1)),
+        ):
+            with self.subTest(now=now, ttl=ttl):
+                cache = TTLCache[int, int, datetime](
+                    maxsize=1, ttl=ttl, timer=lambda: now
+                )
+
+                with self.assertRaises(OverflowError):
+                    cache[1] = 1
+
+                self.assertNotIn(1, cache)
+                self.assertIsNone(cache.get(1))
+                with self.assertRaises(KeyError):
+                    cache[1]
+                self.assertEqual(0, len(cache))
+                self.assertEqual(0, cache.currsize)
+                self.assertEqual([], list(cache))
+                self.assertEqual([], cache.expire())
+
+                now = datetime(2000, 1, 1)
+                cache[2] = 2
+                self.assertEqual([(2, 2)], cache.expire(now + ttl))
+                self.assertEqual(0, len(cache))
+
+    def test_ttl_datetime_overflow_preserves_full_cache(self):
+        from datetime import datetime, timedelta
+
+        for key in (1, 3):
+            with self.subTest(key=key):
+                now = datetime.max - timedelta(days=2)
+                cache = TTLCache[int, str, datetime](
+                    maxsize=3, ttl=timedelta(days=2), timer=lambda: now, getsizeof=len
+                )
+                cache[1] = "a"
+                cache[2] = "bb"
+                now += timedelta(microseconds=1)
+
+                with self.assertRaises(OverflowError):
+                    cache[key] = "ccc"
+
+                self.assertNotIn(3, cache)
+                self.assertEqual(2, len(cache))
+                self.assertEqual(3, cache.currsize)
+                self.assertEqual({1, 2}, set(cache))
+                self.assertEqual((1, "a"), cache.popitem())
+                self.assertEqual((2, "bb"), cache.popitem())
+                self.assertEqual(0, len(cache))
+
+    def test_ttl_datetime_overflow_preserves_expiration(self):
+        from datetime import datetime, timedelta
+
+        now = datetime.max - timedelta(days=3)
+        cache = TTLCache[int, str, datetime](
+            maxsize=6, ttl=timedelta(days=2), timer=lambda: now, getsizeof=len
+        )
+        cache[1] = "a"
+        now += timedelta(days=1)
+        cache[2] = "bb"
+        now += timedelta(microseconds=1)
+
+        with self.assertRaises(OverflowError):
+            cache[1] = "ccc"
+
+        self.assertIn(1, cache)
+        self.assertIn(2, cache)
+        self.assertEqual(2, len(cache))
+        self.assertEqual(3, cache.currsize)
+        self.assertEqual([1, 2], list(cache))
+        self.assertEqual([(1, "a")], cache.expire(datetime.max - timedelta(days=1)))
+        self.assertNotIn(1, cache)
+        self.assertEqual("bb", cache[2])
+        self.assertEqual([(2, "bb")], cache.expire(datetime.max))
+        self.assertEqual(0, len(cache))
+        self.assertEqual(0, cache.currsize)
+
