+@pytest.mark.parametrize('text, expected', [
+    ('', []),
+    ('plain text', ['plain text']),
+    ('January 28, 2026', ['January 28, 2026']),
+    ('February 29, 2024', ['February 29, 2024']),
+    (' 28 29 ', [' 28 29 ']),
+    ('2028 2029\t28\t29', ['2028 2029\t28\t29']),
+])
+def test_iter_splitlines_preserves_text(text, expected):
+    lines = strutils.iter_splitlines(text)
+    assert iter(lines) is lines
+    assert list(lines) == expected
+
+
+@pytest.mark.parametrize('separator', [
+    '\r\n', '\n', '\x0b', '\f', '\r', '\x85', '\u2028', '\u2029',
+])
+def test_iter_splitlines_separators(separator):
+    text = separator + 'first' + separator * 2 + 'last' + separator
+    assert list(strutils.iter_splitlines(text)) == ['', 'first', '', 'last', '']
+    assert list(strutils.iter_splitlines(separator)) == ['', '']
+    assert list(strutils.iter_splitlines(separator * 2)) == ['', '', '']
+
+
+def test_iter_splitlines_mixed_endings():
+    text = ('\r\nJanuary 28, 2026\u2028\u2029February 29, 2024\r'
+            'third\nfourth\x85fifth\x0blast\f')
+    assert list(strutils.iter_splitlines(text)) == [
+        '', 'January 28, 2026', '', 'February 29, 2024',
+        'third', 'fourth', 'fifth', 'last', '',
+    ]
+
+
 def test_indent():
     to_indent = '\nabc\ndef\n\nxyz\n'
     ref = '\n  abc\n  def\n\n  xyz\n'
     assert strutils.indent(to_indent, '  ') == ref
 
 
+def test_indent_unicode_and_mixed_endings():
+    text = '\u2028January 28, 2026\r\n\u2029February 29, 2024\x85'
+    expected = '\n  January 28, 2026\n\n  February 29, 2024\n'
+    assert strutils.indent(text, '  ') == expected
+    assert strutils.indent('', '  ') == ''
+
+
+def test_indent_custom_key_and_newline():
+    seen = []
+
+    def key(line):
+        seen.append(line)
+        return not line
+
+    assert strutils.indent('\u2028a\r\n\u2029', '>', newline='|', key=key) == '>|a|>|>'
+    assert seen == ['', 'a', '', '']
+
+
 def test_is_uuid():
     assert strutils.is_uuid(uuid.uuid4()) == True
     assert strutils.is_uuid(uuid.uuid4(), version=1) == False
