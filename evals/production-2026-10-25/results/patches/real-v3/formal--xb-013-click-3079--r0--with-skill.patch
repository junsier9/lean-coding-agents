                 if self.is_flag:
                     raise TypeError("'count' is not valid with 'is_flag'.")
 
+    def get_default(self, ctx: Context, call: bool = True) -> t.Any:
+        if self.is_flag and not self.is_bool_flag and self.default is UNSET:
+            # Flags sharing a name also share the declared default, regardless of
+            # which flag is processed first.
+            for param in ctx.command.params:
+                if (
+                    isinstance(param, Option)
+                    and param.is_flag
+                    and param.name == self.name
+                    and param.default is not UNSET
+                ):
+                    return param.get_default(ctx, call=call)
+
+        return super().get_default(ctx, call=call)
