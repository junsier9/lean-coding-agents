+@pytest.mark.parametrize("reverse", [False, True])
+@pytest.mark.parametrize("use_callback", [False, True])
+@pytest.mark.parametrize(
+    ("default", "expected"),
+    [
+        (True, "upper"),
+        ("upper", "upper"),
+        ("lower", "lower"),
+        ("mixed", "mixed"),
+        (False, "False"),
+        (0, "0"),
+        ("", ""),
+        (None, None),
+        (lambda: "dynamic", "dynamic"),
+    ],
+)
+@pytest.mark.parametrize(
+    ("args", "explicit"),
+    [
+        ([], None),
+        (["--upper"], "upper"),
+        (["--lower"], "lower"),
+        (["--upper", "--lower"], "lower"),
+        (["--lower", "--upper"], "upper"),
+    ],
+)
+def test_shared_flag_default(
+    runner, reverse, use_callback, default, expected, args, explicit
+):
+    def cli(case):
+        return case
+
+    def callback(ctx, param, value):
+        return f"callback: {value!r}"
+
+    options = [
+        click.option(
+            "--upper",
+            "case",
+            flag_value="upper",
+            default=default,
+            callback=callback if use_callback else None,
+        ),
+        click.option(
+            "--lower",
+            "case",
+            flag_value="lower",
+            callback=callback if use_callback else None,
+        ),
+    ]
+    if reverse:
+        options.reverse()
+    for option in options:
+        cli = option(cli)
+    cli = click.command()(cli)
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exit_code == 0
+    expected = explicit if args else expected
+    if use_callback:
+        expected = f"callback: {expected!r}"
+    assert result.return_value == expected
+
+
+@pytest.mark.parametrize("default", ["lower", None, ""])
+@pytest.mark.parametrize("args", [[], ["--upper"]])
+def test_shared_flag_default_map(runner, default, args):
+    @click.command()
+    @click.option("--upper", "case", flag_value="upper")
+    @click.option("--lower", "case", flag_value="lower", default=True)
+    @click.pass_context
+    def cli(ctx, case):
+        return case, ctx.get_parameter_source("case")
+
+    result = runner.invoke(
+        cli, args, default_map={"case": default}, standalone_mode=False
+    )
+    assert result.exit_code == 0
+    assert result.return_value == (
+        ("upper", click.core.ParameterSource.COMMANDLINE)
+        if args
+        else (default, click.core.ParameterSource.DEFAULT_MAP)
+    )
+
+
+def test_shared_flag_dynamic_default_not_called():
+    def default():
+        raise RuntimeError("default failed")
+
+    @click.command()
+    @click.option("--upper", "case", flag_value="upper")
+    @click.option("--lower", "case", flag_value="lower", default=default)
+    def cli(case):
+        pass
+
+    ctx = click.Context(cli)
+    for option in cli.params:
+        assert option.get_default(ctx, call=False) is default
+        with pytest.raises(RuntimeError, match="default failed"):
+            option.get_default(ctx)
+
+
+def test_shared_flag_invalid_default(runner):
+    @click.command()
+    @click.option("--upper", "case", flag_value="upper")
+    @click.option(
+        "--lower",
+        "case",
+        flag_value="lower",
+        default="invalid",
+        type=click.Choice(["upper", "lower"]),
+    )
+    def cli(case):
+        pytest.fail("An invalid default must not reach the command callback.")
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 2
+    assert "'invalid' is not one of 'upper', 'lower'" in result.output
+
