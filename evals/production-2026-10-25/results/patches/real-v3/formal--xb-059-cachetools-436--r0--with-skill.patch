+class ClassAccessTest(unittest.TestCase):
+    def test_class_call(self):
+        methods = (
+            "get",
+            "get_typed",
+            "get_info",
+            "get_lock",
+            "get_lock_info",
+            "get_cond",
+            "get_cond_info",
+            "get_lock_cond",
+            "get_lock_cond_info",
+        )
+        for cls in (Cached, Unhashable):
+            for name in methods:
+                with self.subTest(cls=cls, method=name):
+                    first = cls(Cache(2))
+                    second = cls(Cache(2), count=10)
+                    method = getattr(cls, name)
+
+                    self.assertEqual(method(first, 0), 0)
+                    bound = getattr(first, name)
+                    self.assertEqual(method(first, 0), 0)
+                    self.assertEqual(bound(0), 0)
+                    self.assertIs(getattr(first, name), bound)
+                    self.assertIs(bound.cache, first.cache)
+
+                    other = getattr(second, name)
+                    self.assertEqual(other(0), 10)
+                    self.assertEqual(method(second, 0), 10)
+                    if name.endswith("info"):
+                        self.assertEqual(bound.cache_info(), (2, 1, 2, 1))
+                        self.assertEqual(other.cache_info(), (1, 1, 2, 1))
+
+                    bound.cache_clear()
+                    self.assertEqual(len(first.cache), 0)
+                    self.assertEqual(len(second.cache), 1)
+                    if name.endswith("info"):
+                        self.assertEqual(bound.cache_info(), (0, 0, 2, 0))
+                        self.assertEqual(other.cache_info(), (1, 1, 2, 1))
+                    self.assertEqual(method(first, value=1), 1)
+                    self.assertEqual(bound(value=1), 1)
+
+    def test_class_call_typed_key(self):
+        cached = Cached({})
+        method = Cached.get_typed
+
+        self.assertEqual(method(cached, 1), 0)
+        self.assertEqual(cached.get_typed(1), 0)
+        self.assertEqual(method(cached, 1.0), 1)
+        self.assertEqual(cached.get_typed(1.0), 1)
+
+    def test_class_call_wrapped(self):
+        cached = Cached({})
+        method = Cached.get
+
+        self.assertEqual(method.__name__, "get")
+        self.assertEqual((method.__doc__ or "").strip(), "docstring")
+        self.assertEqual(method.__wrapped__(cached, 0), 0)
+        self.assertEqual(len(cached.cache), 0)
+        self.assertEqual(method(cached, 0), 1)
+        self.assertEqual(cached.get(0), 1)
+
+    def test_class_call_error_cleanup(self):
+        cached = Cached({})
+        method = Cached.get_cond_error
+
+        for _ in range(2):
+            with self.assertRaisesRegex(ValueError, "test error"):
+                method(cached, 0)
+        with self.assertRaisesRegex(ValueError, "test error"):
+            cached.get_cond_error(0)
+        self.assertEqual(cached.cond.wait_count, 3)
+        self.assertEqual(cached.cond.notify_count, 3)
+        self.assertEqual(len(cached.cache), 0)
+
+
