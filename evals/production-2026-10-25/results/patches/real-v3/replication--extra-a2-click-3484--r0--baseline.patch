+@pytest.mark.parametrize(
+    ("option_kwargs", "expected_values", "expected_sources", "winner"),
+    [
+        (
+            [{"envvar": "FIRST"}, {"default": "fallback"}],
+            ["first", "fallback"],
+            ["ENVIRONMENT", "DEFAULT"],
+            0,
+        ),
+        (
+            [{"default": "fallback"}, {"envvar": "FIRST"}],
+            ["fallback", "first"],
+            ["DEFAULT", "ENVIRONMENT"],
+            1,
+        ),
+        (
+            [{"envvar": "FIRST"}, {"default": "fallback"}, {"envvar": "LAST"}],
+            ["first", "fallback", "last"],
+            ["ENVIRONMENT", "DEFAULT", "ENVIRONMENT"],
+            2,
+        ),
+        (
+            [{"is_flag": True, "default": True}, {"is_flag": True}],
+            [True, False],
+            ["DEFAULT", "DEFAULT"],
+            0,
+        ),
+        (
+            [{"default": "first"}, {"default": ""}],
+            ["first", ""],
+            ["DEFAULT", "DEFAULT"],
+            1,
+        ),
+        (
+            [{"default": "first"}, {"default": None}],
+            ["first", None],
+            ["DEFAULT", "DEFAULT"],
+            1,
+        ),
+    ],
+)
+def test_shared_parameter_source_during_processing(
+    runner, option_kwargs, expected_values, expected_sources, winner
+):
+    observed = []
+    final_state = []
+
+    def callback(ctx, param, value):
+        observed.append((value, ctx.get_parameter_source(param.name).name))
+        return value
+
+    def inspect_winner(ctx, param, value):
+        final_state.append(
+            (ctx.params["value"], ctx.get_parameter_source("value").name)
+        )
+
+    params = [
+        click.Option([f"--option-{i}", "value"], callback=callback, **kwargs)
+        for i, kwargs in enumerate(option_kwargs)
+    ]
+    params.append(
+        click.Option(["--inspect"], expose_value=False, callback=inspect_winner)
+    )
+    cli = click.Command("cli", params=params)
+    result = runner.invoke(cli, env={"FIRST": "first", "LAST": "last"})
+
+    assert result.exception is None
+    assert observed == list(zip(expected_values, expected_sources, strict=True))
+    assert final_state == [(expected_values[winner], expected_sources[winner])]
