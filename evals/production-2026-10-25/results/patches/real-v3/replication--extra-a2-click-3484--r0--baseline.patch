+@pytest.mark.parametrize("param_cls", [click.Option, click.Argument])
+@pytest.mark.parametrize("is_eager", [False, True])
+@pytest.mark.parametrize("expose_value", [False, True])
+@pytest.mark.parametrize(
+    ("invoke_kwargs", "expected_value", "expected_source"),
+    [
+        ({}, 1, ParameterSource.DEFAULT),
+        ({"default_map": {"value": "2"}}, 2, ParameterSource.DEFAULT_MAP),
+        (
+            {"env": {"TEST_PARAMETER_SOURCE": "3"}},
+            3,
+            ParameterSource.ENVIRONMENT,
+        ),
+        ({"args": ["4"]}, 4, ParameterSource.COMMANDLINE),
+    ],
+)
+def test_parameter_source_during_processing(
+    runner,
+    param_cls,
+    is_eager,
+    expose_value,
+    invoke_kwargs,
+    expected_value,
+    expected_source,
+):
+    observed = []
+
+    class SourceType(click.types.IntParamType):
+        def convert(self, value, param, ctx):
+            observed.append(("type", ctx.get_parameter_source(param.name)))
+            return super().convert(value, param, ctx)
+
+    def callback(ctx, param, value):
+        observed.append(("callback", ctx.get_parameter_source(param.name)))
+        return value
+
+    @click.pass_context
+    def cli(ctx, **kwargs):
+        return kwargs, ctx.get_parameter_source("value")
+
+    param = param_cls(
+        ["--value" if param_cls is click.Option else "value"],
+        default="1",
+        envvar="TEST_PARAMETER_SOURCE",
+        type=SourceType(),
+        callback=callback,
+        is_eager=is_eager,
+        expose_value=expose_value,
+    )
+    invoke_kwargs = invoke_kwargs.copy()
+    if param_cls is click.Option and "args" in invoke_kwargs:
+        invoke_kwargs["args"] = ["--value", *invoke_kwargs["args"]]
+
+    result = runner.invoke(
+        click.Command("cli", params=[param], callback=cli),
+        standalone_mode=False,
+        **invoke_kwargs,
+    )
+    assert result.exception is None
+    assert observed == [("type", expected_source), ("callback", expected_source)]
+    expected_params = {"value": expected_value} if expose_value else {}
+    assert result.return_value == (expected_params, expected_source)
+
+
