@@ -1018,6 +1057,52 @@ def test_missing_envvar(runner):
     assert "Error: Missing option '--foo'." in result.output
 
 
+@pytest.mark.parametrize("show_envvar", [False, True])
+@pytest.mark.parametrize(
+    ("envvar", "expected"),
+    [
+        (None, None),
+        ("", None),
+        ([], None),
+        ((), None),
+        ("ARG1", "'ARG1'"),
+        (["ARG1"], "'ARG1'"),
+        (("ARG1",), "'ARG1'"),
+        (["ARG1", "ARG2"], "'ARG1', 'ARG2'"),
+        (("ARG1", "ARG2"), "'ARG1', 'ARG2'"),
+    ],
+)
+@pytest.mark.parametrize(
+    ("args", "message"),
+    [
+        ([], "Missing option {hint}."),
+        (
+            ["--foo", "invalid"],
+            "Invalid value for {hint}: 'invalid' is not a valid integer.",
+        ),
+    ],
+)
+def test_show_envvar_errors(runner, envvar, expected, show_envvar, args, message):
+    cli = click.Command(
+        "cli",
+        params=[
+            click.Option(
+                ["--foo"],
+                envvar=envvar,
+                show_envvar=show_envvar,
+                required=True,
+                type=int,
+            )
+        ],
+    )
+    result = runner.invoke(cli, args, env={"ARG1": None, "ARG2": None})
+    assert result.exit_code == 2
+    hint = "'--foo'"
+    if show_envvar and expected is not None:
+        hint += f" (env var: {expected})"
+    assert f"Error: {message.format(hint=hint)}\n" in result.output
+
+
