+def test_surrogates_and_unicode(rootlogger: TagTracer) -> None:
+    text = "caf\u00e9 \u4e2d\u6587 \U0001f600 \ud800 \udfff"
+    escaped = "caf\u00e9 \u4e2d\u6587 \U0001f600 \\ud800 \\udfff"
+    out: list[bytes] = []
+    rootlogger.setwriter(lambda message: out.append(message.encode("utf-8")))
+
+    rootlogger.get(text)(text, {text: text})
+
+    assert out == [f"{escaped} [{escaped}]\n    {escaped}: {escaped}\n".encode()]
+
+
+def test_unprintable_values(rootlogger: TagTracer) -> None:
+    class Unprintable:
+        def __str__(self):
+            raise ValueError("cannot stringify")
+
+        def __repr__(self):
+            raise RuntimeError("cannot represent")
+
+    value = Unprintable()
+    extra = {value: value}
+    out: list[str] = []
+    processed = []
+    rootlogger.setwriter(out.append)
+    rootlogger.setprocessor("test", lambda *args: processed.append(args))
+
+    rootlogger.get("test")(value, [value], extra)
+
+    assert out == [
+        "<unprintable> <unprintable> [test]\n"
+        "    <unprintable>: <unprintable>\n"
+    ]
+    tags, args = processed[0]
+    assert tags == ("test",)
+    assert args[0] is value
+    assert args[1][0] is value
+    assert args[2] is extra
+
+
+def test_processor_without_writer_does_not_stringify(rootlogger: TagTracer) -> None:
+    class Unprintable:
+        def __str__(self):
+            pytest.fail("a processor should receive the original object")
+
+    value = Unprintable()
+    processed = []
+    rootlogger.setprocessor("test", lambda *args: processed.append(args))
+
+    rootlogger.get("test")(value)
+
+    assert processed == [(("test",), (value,))]
+
+
