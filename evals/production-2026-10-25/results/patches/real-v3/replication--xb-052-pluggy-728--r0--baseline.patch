+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize("stage", ["argument", "result"])
+def test_hook_tracing_unprintable_values(pm, firstresult, stage) -> None:
+    class Unprintable:
+        def __str__(self):
+            raise ValueError("cannot stringify")
+
+        def __repr__(self):
+            raise RuntimeError("cannot represent")
+
+    value = Unprintable()
+    argument = value if stage == "argument" else "input"
+    result = value if stage == "result" else "output"
+    received = []
+
+    class Api:
+        @hookspec(firstresult=firstresult)
+        def hello(self, arg):
+            pass
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg):
+            received.append(arg)
+            return result
+
+    pm.add_hookspecs(Api)
+    pm.register(Plugin())
+    out: list[str] = []
+    pm.trace.root.setwriter(out.append)
+    pm.enable_tracing()
+
+    actual = pm.hook.hello(arg=argument)
+
+    assert (actual if firstresult else actual[0]) is result
+    assert received[0] is argument
+    assert len(out) == 2
+    assert "<unprintable>" in out[0 if stage == "argument" else 1]
+    assert pm.trace.root.indent == 0
+
+
+@pytest.mark.parametrize("firstresult", [False, True])
+def test_hook_tracing_surrogates_and_unicode(pm, firstresult) -> None:
+    text = "caf\u00e9 \u4e2d\u6587 \U0001f600 \ud800 \udfff"
+    escaped = "caf\u00e9 \u4e2d\u6587 \U0001f600 \\ud800 \\udfff"
+
+    class Value:
+        def __str__(self):
+            return text
+
+        __repr__ = __str__
+
+    value = Value()
+
+    class Api:
+        @hookspec(firstresult=firstresult)
+        def hello(self, arg):
+            pass
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg):
+            assert arg is text
+            return value
+
+    pm.add_hookspecs(Api)
+    pm.register(Plugin())
+    out: list[bytes] = []
+    pm.trace.root.setwriter(lambda message: out.append(message.encode("utf-8")))
+    pm.enable_tracing()
+
+    actual = pm.hook.hello(arg=text)
+
+    assert (actual if firstresult else actual[0]) is value
+    result_text = escaped if firstresult else f"[{escaped}]"
+    assert out == [
+        f"  hello [hook]\n      arg: {escaped}\n".encode(),
+        f"  finish hello --> {result_text} [hook]\n".encode(),
+    ]
+    assert pm.trace.root.indent == 0
+
+
+@pytest.mark.parametrize("exception", [KeyboardInterrupt, SystemExit, GeneratorExit])
+@pytest.mark.parametrize("stage", ["argument", "result"])
+def test_hook_tracing_preserves_interrupts(he_pm, exception, stage) -> None:
+    interrupt = exception()
+    called = []
+
+    class Interrupted:
+        def __str__(self):
+            raise interrupt
+
+        __repr__ = __str__
+
+    value = Interrupted()
+
+    class Plugin:
+        @hookimpl
+        def he_method1(self, arg):
+            called.append(arg)
+            return value
+
+    he_pm.register(Plugin())
+    out: list[str] = []
+    he_pm.trace.root.setwriter(out.append)
+    he_pm.enable_tracing()
+
+    with pytest.raises(exception) as excinfo:
+        he_pm.hook.he_method1(arg=value if stage == "argument" else 1)
+
+    assert excinfo.value is interrupt
+    assert len(called) == (0 if stage == "argument" else 1)
+    assert he_pm.trace.root.indent == 0
+
+
