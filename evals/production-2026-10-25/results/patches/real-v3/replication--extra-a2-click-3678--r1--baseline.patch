+@pytest.mark.parametrize("help_name", ["--help", "--show-help"])
+def test_help_option_name_does_not_shadow_parameter(help_name):
+    name = help_name[2:].replace("-", "_")
+    cli = click.Command("cli", params=[click.Argument([name])])
+    ctx = click.Context(cli, help_option_names=[help_name])
+    params = cli.to_info_dict(ctx)["params"]
+    assert params[0]["name"] == name
+    assert params[1]["name"] != name
+    assert params[1]["opts"] == [help_name]
+    assert cli.to_info_dict(ctx)["params"] == params
+    assert cli.get_params(ctx)[-1] is cli.get_help_option(ctx)
+
