+@pytest.mark.parametrize("param_type", [click.Argument, click.Option])
+@pytest.mark.parametrize(
+    ("help_names", "param_name"),
+    [
+        (["--help"], "help"),
+        (["-h", "--help"], "help"),
+        (["--assist"], "assist"),
+        (["--show-help"], "show_help"),
+        (["-h"], "h"),
+    ],
+)
+@pytest.mark.parametrize("value", [None, "payload"])
+def test_help_option_name_matches_parameter(
+    runner, param_type, help_names, param_name, value
+):
+    decls = [param_name] if param_type is click.Argument else ["--value", param_name]
+    param = param_type(decls, default="fallback", required=False)
+
+    @click.pass_context
+    def callback(ctx, **values):
+        return values, ctx.get_parameter_source(param_name)
+
+    cli = click.Command(
+        "cli",
+        params=[param],
+        callback=callback,
+        context_settings={"help_option_names": help_names},
+    )
+    args = []
+    if value is not None:
+        args = [value] if param_type is click.Argument else ["--value", value]
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    source = click.core.ParameterSource.DEFAULT
+    if value is not None:
+        source = click.core.ParameterSource.COMMANDLINE
+    assert result.return_value == ({param_name: value or "fallback"}, source)
+    assert result.output == ""
+    assert param.name == param_name
+
+    for help_name in help_names:
+        result = runner.invoke(cli, [*args, help_name])
+        assert result.exit_code == 0, result.output
+        assert "Show this message and exit." in result.output
+
+
+def test_help_option_name_avoids_all_parameters(runner):
+    cli = click.Command(
+        "cli",
+        params=[
+            click.Argument(["help"]),
+            click.Argument(["_help"]),
+            click.Option(["--value", "__help"]),
+        ],
+        callback=lambda **values: values,
+    )
+    ctx = click.Context(cli)
+    help_option = cli.get_help_option(ctx)
+    assert help_option.name not in {param.name for param in cli.params}
+    assert cli.get_help_option(ctx) is help_option
+
+    # A command may gain more parameters after the help option was cached.
+    extra_name = help_option.name
+    cli.params.append(click.Option(["--extra", extra_name]))
+    assert cli.get_help_option(ctx) is help_option
+    assert help_option.name not in {param.name for param in cli.params}
+
+    result = runner.invoke(
+        cli, ["a", "b", "--value", "c", "--extra", "d"], standalone_mode=False
+    )
+    assert result.exit_code == 0, result.output
+    assert result.return_value == {
+        "help": "a",
+        "_help": "b",
+        "__help": "c",
+        extra_name: "d",
+    }
+
+
+@pytest.mark.parametrize("help_names", [["--help"], ["-h", "--help"]])
+def test_explicit_help_option_overrides_automatic_help(runner, help_names):
+    @click.command(context_settings={"help_option_names": help_names})
+    @click.option("--help", default="fallback")
+    def cli(help):
+        click.echo(help)
+
+    result = runner.invoke(cli, ["--help", "payload"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "payload\n"
+
+    if "-h" in help_names:
+        result = runner.invoke(cli, ["-h"])
+        assert result.exit_code == 0, result.output
+        assert "Show this message and exit." in result.output
+
+
+@pytest.mark.parametrize(
+    ("params", "name"),
+    [
+        ([click.Argument(["HELP"]), click.Argument(["help"])], "help"),
+        ([click.Argument(["foo-bar"]), click.Argument(["foo_bar"])], "foo_bar"),
+        ([click.Argument(["help"]), click.Option(["--value", "help"])], "help"),
+    ],
+)
+def test_conflicting_argument_names_warning(params, name):
+    cli = click.Command("cli", params=params)
+    message = f"The parameter {name} is used more than once"
+    with pytest.warns(UserWarning, match=message):
+        cli.get_params(click.Context(cli))
+
+
