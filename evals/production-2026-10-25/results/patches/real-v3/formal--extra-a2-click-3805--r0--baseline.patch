+import copy
+import pickle
 from decimal import Decimal
 from fractions import Fraction
 
+import pytest
+
+import click
+from click._utils import Sentinel
 from click._utils import UNSET
 
 
@@ -50,3 +56,64 @@ def test_unset_sentinel():
         assert value is not real_value
 
     assert value not in real_values
+
+
+@pytest.mark.parametrize("sentinel", Sentinel)
+@pytest.mark.parametrize("copy_func", [copy.copy, copy.deepcopy])
+def test_sentinel_copy(sentinel, copy_func):
+    assert copy_func(sentinel) is sentinel
+
+
+@pytest.mark.parametrize("sentinel", Sentinel)
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_sentinel_pickle(sentinel, protocol):
+    assert pickle.loads(pickle.dumps(sentinel, protocol)) is sentinel
+
+
+def _pickle_roundtrip(value):
+    return pickle.loads(pickle.dumps(value))
+
+
+@pytest.mark.parametrize("copy_func", [copy.copy, copy.deepcopy, _pickle_roundtrip])
+@pytest.mark.parametrize("param_class", [click.Option, click.Argument])
+def test_parameter_copy(param_class, copy_func):
+    decls = ["--example-value"] if param_class is click.Option else ["example-value"]
+    original = param_class(decls, required=False)
+    param = copy_func(original)
+
+    assert param is not original
+    assert param.name == "example_value"
+    assert param.opts == original.opts
+    assert param.default is UNSET
+
+    command = click.Command("cli", params=[param])
+    with command.make_context("cli", []) as ctx:
+        assert ctx.params == {"example_value": None}
+
+
+@pytest.mark.parametrize("copy_func", [copy.copy, copy.deepcopy, _pickle_roundtrip])
+@pytest.mark.parametrize(
+    ("kwargs", "expected_default"),
+    [
+        ({}, None),
+        ({"is_flag": True}, False),
+        ({"is_flag": True, "multiple": True}, ()),
+        ({"default": None}, None),
+        ({"default": 0}, 0),
+        ({"flag_value": "fast", "default": True}, "fast"),
+    ],
+)
+def test_option_copy_defaults(copy_func, kwargs, expected_default):
+    original = click.Option(["-v", "--example-value", "value"], **kwargs)
+    option = copy_func(original)
+
+    assert option is not original
+    assert option.name == "value"
+    assert option.opts == ["-v", "--example-value"]
+    assert option.default is original.default
+    assert option.flag_value == original.flag_value
+    assert option.to_info_dict()["default"] == expected_default
+
+    command = click.Command("cli", params=[option])
+    with command.make_context("cli", []) as ctx:
+        assert ctx.params == {"value": expected_default}
