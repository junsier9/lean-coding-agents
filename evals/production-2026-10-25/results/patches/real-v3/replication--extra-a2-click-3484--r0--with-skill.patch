+@pytest.mark.parametrize("parameter_class", [click.Option, click.Argument])
+@pytest.mark.parametrize("is_eager", [False, True])
+@pytest.mark.parametrize(
+    ("args", "env", "default_map", "expected_value", "expected_source"),
+    [
+        ([], {}, None, 1, click.ParameterSource.DEFAULT),
+        ([], {}, {"number": 0}, 0, click.ParameterSource.DEFAULT_MAP),
+        ([], {"NUMBER": "2"}, {"number": 0}, 2, click.ParameterSource.ENVIRONMENT),
+        (["3"], {"NUMBER": "2"}, {"number": 0}, 3, click.ParameterSource.COMMANDLINE),
+    ],
+)
+def test_parameter_source_during_processing(
+    runner,
+    parameter_class,
+    is_eager,
+    args,
+    env,
+    default_map,
+    expected_value,
+    expected_source,
+):
+    observed = []
+
+    class SourceType(click.ParamType):
+        def convert(self, value, param, ctx):
+            observed.append(("convert", ctx.get_parameter_source(param.name)))
+            return int(value)
+
+    def callback(ctx, param, value):
+        observed.append(("callback", ctx.get_parameter_source(param.name)))
+        return value
+
+    if parameter_class is click.Option:
+        declarations = ["--number"]
+        if args:
+            args = ["--number", *args]
+    else:
+        declarations = ["number"]
+
+    parameter = parameter_class(
+        declarations,
+        type=SourceType(),
+        default=1,
+        envvar="NUMBER",
+        callback=callback,
+        is_eager=is_eager,
+    )
+
+    @click.command(params=[parameter])
+    @click.pass_context
+    def cli(ctx, number):
+        return number, ctx.get_parameter_source("number")
+
+    result = runner.invoke(
+        cli, args, env=env, default_map=default_map, standalone_mode=False
+    )
+    assert result.exception is None
+    assert result.return_value == (expected_value, expected_source)
+    assert observed == [
+        ("convert", expected_source),
+        ("callback", expected_source),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("env", "expected"),
+    [({}, "configured-default"), ({"MODE": "environment"}, "environment")],
+)
+def test_eager_callback_uses_parameter_source(runner, env, expected):
+    def configure(ctx, param, value):
+        if ctx.get_parameter_source(param.name) is click.ParameterSource.DEFAULT:
+            value = "configured-default"
+        click.echo(value)
+        ctx.exit()
+
+    @click.command()
+    @click.option(
+        "--mode",
+        default="original",
+        envvar="MODE",
+        callback=configure,
+        is_eager=True,
+        expose_value=False,
+    )
+    def cli():
+        pytest.fail("The eager callback should exit before invoking the command.")
+
+    result = runner.invoke(cli, env=env)
+    assert result.exit_code == 0
+    assert result.output == f"{expected}\n"
+
+
