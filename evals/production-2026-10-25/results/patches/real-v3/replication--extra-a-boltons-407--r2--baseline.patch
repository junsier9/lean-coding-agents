 import sys
 
+import pytest
+
 from boltons.listutils import SplayList, BarrelList
 
 
@@ -51,6 +53,41 @@ def test_barrel_list():
     bl3[:20:2] = range(0, -10, -1)
     assert bl3[6] == -3  # some truly tricky stepping/slicing works
 
+
+@pytest.mark.parametrize('size', [0, 10, 100000])
+@pytest.mark.parametrize('index', [
+    -sys.maxsize, -100001, -100000, -99999, -11, -10, -1, 0,
+])
+def test_barrel_list_insert_negative_index(size, index):
+    expected = list(range(size))
+    bl = BarrelList(expected)
+    bl._balance_list(0)
+    if size == 100000:
+        assert len(bl.lists) > 1
+
+    item = object()
+    expected.insert(index, item)
+    assert bl.insert(index, item) is None
+    assert list(bl) == expected
+    assert len(bl) == size + 1
+
+
+def test_barrel_list_insert_negative_index_rebalances():
+    expected = list(range(100))
+    bl = BarrelList(expected)
+    bl._size_factor = 2
+    bl._balance_list(0)
+    initial_segments = len(bl.lists)
+    assert initial_segments > 1
+
+    for item in range(-1, -31, -1):
+        expected.insert(-1000000, item)
+        bl.insert(-1000000, item)
+        assert list(bl) == expected
+        assert len(bl) == len(expected)
+    assert len(bl.lists) > initial_segments
+
+
 def test_sort_barrel_list():
