+@pytest.mark.parametrize('delete_error', [None, ValueError('delete failed'),
+                                        AttributeError('delete failed')])
+def test_wrap_prop_delete(delete_error):
+    calls = []
+
+    class Manager:
+        def __enter__(self):
+            calls.append('enter')
+
+        def __exit__(self, exc_type, exc, traceback):
+            calls.append(('exit', exc_type, exc))
+
+    class A(object):
+        def __init__(self):
+            self.value = 1
+
+        @property
+        def prop(self):
+            return self.value
+
+        @prop.deleter
+        def prop(self):
+            calls.append('delete')
+            if delete_error is not None:
+                raise delete_error
+            del self.value
+
+        prop = wrap_prop(Manager())(prop)
+
+    a = A()
+    assert A.prop is A.__dict__['prop']
+    assert calls == []
+
+    if delete_error is None:
+        del a.prop
+        assert 'value' not in a.__dict__
+    else:
+        with pytest.raises(type(delete_error)) as raised:
+            del a.prop
+        assert raised.value is delete_error
+        assert a.value == 1
+
+    exc_type = type(delete_error) if delete_error is not None else None
+    assert calls == ['enter', 'delete', ('exit', exc_type, delete_error)]
+
+
