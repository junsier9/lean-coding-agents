+@parametrize(
+    "iteratee,expected",
+    [
+        (lambda: 0, [2, -3, 4, -5]),
+        (lambda value: value % 2, [-3, 4, -5]),
+        (lambda value, index: abs(value) - index, [2, -3, 4, -5]),
+        (lambda value, index=0: abs(value) - index, [2, -3, 4, -5]),
+        (
+            lambda value, index=None, collection=None: abs(collection[index]) - index,
+            [2, -3, 4, -5],
+        ),
+        (lambda *args: abs(args[2][args[1]]) - args[1], [2, -3, 4, -5]),
+        (abs, []),
+    ],
+)
+def test_duplicates_supports_iteratee_signatures(iteratee, expected):
+    assert _.duplicates([-1, 2, -3, 4, -5], iteratee) == expected
+
+
+@parametrize("sequence_type", [list, tuple])
+@parametrize("chained", [False, True])
+def test_duplicates_passes_original_values_indexes_and_collection(sequence_type, chained):
+    records = sequence_type(
+        [
+            {"id": "first-a"},
+            {"id": "first-b"},
+            {"id": "second-a"},
+            {"id": "second-b"},
+            {"id": "second-a"},
+            {"id": "second-b"},
+        ]
+    )
+    original = [record.copy() for record in records]
+    calls = []
+
+    def iteratee(value, index, collection):
+        assert collection is records
+        assert value is records[index]
+        calls.append(index)
+        return [index % 2]
+
+    if chained:
+        result = _.chain(records).duplicates(iteratee).value()
+    else:
+        result = _.duplicates(records, iteratee)
+
+    assert calls == list(range(len(records)))
+    assert result == [records[2], records[3]]
+    assert result[0] is records[2]
+    assert result[1] is records[3]
+    assert list(records) == original
+
+
