+@pytest.mark.parametrize('n', [1, 2, 3, 4])
+@pytest.mark.parametrize('actual_length, reported_length', [
+    (0, 1), (0, 4), (1, 0), (1, 2), (1, 5),
+    (4, 0), (4, 3), (4, 5), (4, 8),
+    (5, 1), (5, 4), (5, 6), (5, 9),
+])
+def test_partition_all_incorrect_length(n, actual_length, reported_length):
+    class IncorrectLength:
+        def __iter__(self):
+            return iter(range(actual_length))
+
+        def __len__(self):
+            return reported_length
+
+    with pytest.raises(LookupError):
+        list(partition_all(n, IncorrectLength()))
+
+
+@pytest.mark.parametrize('n', [1, 2, 3, 4])
+@pytest.mark.parametrize('length', [0, 1, 4, 5, 8])
+@pytest.mark.parametrize('factory', [list, tuple, iter])
+def test_partition_all_valid_length(n, length, factory):
+    data = list(range(length))
+    expected = [tuple(data[i:i + n]) for i in range(0, length, n)]
+    assert list(partition_all(n, factory(data))) == expected
+
+
+def test_partition_all_sized_iterator():
+    class SizedIterator:
+        def __init__(self):
+            self.items = [1, 2, 3, 4, 5]
+
+        def __iter__(self):
+            return self
+
+        def __len__(self):
+            return len(self.items)
+
+        def __next__(self):
+            if not self.items:
+                raise StopIteration
+            return self.items.pop(0)
+
+    assert list(partition_all(3, SizedIterator())) == [(1, 2, 3), (4, 5)]
+
+
+def test_partition_all_padding_value_in_input():
+    data = [1, 2, no_pad]
+    assert list(partition_all(4, data)) == [(1, 2, no_pad)]
+    assert list(partition_all(4, iter(data))) == [(1, 2, no_pad)]
+
+
 def test_count():
