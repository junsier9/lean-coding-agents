--- a/tests/test_defaults.py
+++ b/tests/test_defaults.py
@@ -1,4 +1,7 @@
+import pytest
+
 import click
+from click._utils import UNSET
 
 
 def test_basic_defaults(runner):
@@ -61,6 +64,49 @@ def test_multiple_flag_default(runner):
     assert result.return_value == ((True, False), (True,), (1, -1))
 
 
+@pytest.mark.parametrize("reverse", [False, True])
+@pytest.mark.parametrize(
+    ("default", "default_expected"),
+    [
+        (True, "upper"),
+        ("fallback", "fallback"),
+        ("", ""),
+        (0, "0"),
+        (False, "False"),
+        (None, None),
+        (lambda: "dynamic", "dynamic"),
+        (UNSET, None),
+    ],
+)
+@pytest.mark.parametrize(
+    ("args", "expected"),
+    [
+        ([], UNSET),
+        (["--upper"], "upper"),
+        (["--lower"], "lower"),
+        (["--auto"], None),
+        (["--upper", "--lower"], "lower"),
+        (["--lower", "--upper"], "upper"),
+        (["--upper", "--auto"], None),
+        (["--auto", "--upper"], "upper"),
+    ],
+)
+def test_shared_flag_default(runner, reverse, default, default_expected, args, expected):
+    @click.command()
+    @click.option("--upper", "case", flag_value="upper", default=default, type=str)
+    @click.option("--lower", "case", flag_value="lower", type=str)
+    @click.option("--auto", "case", flag_value=None, type=str)
+    def cli(case):
+        return case
+
+    if reverse:
+        cli.params.reverse()
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exit_code == 0, result.output
+    assert result.return_value == (default_expected if expected is UNSET else expected)
+
+
 def test_flag_default_map(runner):
     """test flag with default map"""
 
