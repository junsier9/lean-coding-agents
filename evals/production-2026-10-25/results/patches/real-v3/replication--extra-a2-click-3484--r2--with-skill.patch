+@pytest.mark.parametrize("is_eager", [False, True])
+@pytest.mark.parametrize("expose_value", [False, True])
+@pytest.mark.parametrize(
+    ("invoke_kwargs", "expected_value", "expected_source"),
+    [
+        ({}, 42, click.ParameterSource.DEFAULT),
+        ({"default_map": {"number": "43"}}, 43, click.ParameterSource.DEFAULT_MAP),
+        ({"env": {"TEST_NUMBER": "44"}}, 44, click.ParameterSource.ENVIRONMENT),
+        ({"args": ["--number", "45"]}, 45, click.ParameterSource.COMMANDLINE),
+    ],
+)
+def test_parameter_source_during_processing(
+    runner, is_eager, expose_value, invoke_kwargs, expected_value, expected_source
+):
+    sources = []
+
+    class SourceAwareInt(click.ParamType):
+        name = "integer"
+
+        def convert(self, value, param, ctx):
+            sources.append(("convert", ctx.get_parameter_source(param.name)))
+            return click.INT.convert(value, param, ctx)
+
+    def callback(ctx, param, value):
+        sources.append(("callback", ctx.get_parameter_source(param.name)))
+        return value
+
+    @click.command()
+    @click.option(
+        "--number",
+        type=SourceAwareInt(),
+        default=42,
+        envvar="TEST_NUMBER",
+        callback=callback,
+        is_eager=is_eager,
+        expose_value=expose_value,
+    )
+    @click.pass_context
+    def cli(ctx, **params):
+        return params, ctx.get_parameter_source("number")
+
+    result = runner.invoke(cli, standalone_mode=False, **invoke_kwargs)
+    assert result.exception is None
+    assert sources == [("convert", expected_source), ("callback", expected_source)]
+    assert result.return_value == (
+        {"number": expected_value} if expose_value else {},
+        expected_source,
+    )
+
+
+@pytest.mark.parametrize(
+    ("env", "expected"),
+    [
+        ({}, "42:DEFAULT\n"),
+        ({"TEST_NUMBER": "44"}, "44:ENVIRONMENT\n"),
+    ],
+)
+def test_parameter_source_in_exiting_eager_callback(runner, env, expected):
+    def callback(ctx, param, value):
+        source = ctx.get_parameter_source(param.name)
+        click.echo(f"{value}:{source.name}")
+        ctx.exit()
+
+    @click.command()
+    @click.option(
+        "--number",
+        default=42,
+        envvar="TEST_NUMBER",
+        callback=callback,
+        is_eager=True,
+        expose_value=False,
+    )
+    @click.argument("required")
+    def cli(required):
+        pytest.fail("The eager callback should exit before invoking the command.")
+
+    result = runner.invoke(cli, env=env)
+    assert result.exception is None
+    assert result.output == expected
+
+
