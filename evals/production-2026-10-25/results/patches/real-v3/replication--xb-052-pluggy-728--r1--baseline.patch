+@pytest.mark.parametrize("surrogate", ["\ud800", "\udfff"])
+def test_format_message_unicode(rootlogger: TagTracer, surrogate: str) -> None:
+    text = "café 中文 🙂" + surrogate
+    escaped = "café 中文 🙂" + repr(surrogate)[1:-1]
+
+    message = rootlogger._format_message([text], [text, {text: text}])
+
+    assert message == f"{escaped} [{escaped}]\n    {escaped}: {escaped}\n"
+    message.encode("utf-8")
+
+
+class BrokenStr:
+    def __str__(self):
+        raise ValueError("cannot stringify")
+
+
+class BrokenRepr:
+    def __repr__(self):
+        raise ValueError("cannot represent")
+
+
+@pytest.mark.parametrize("value", [BrokenStr(), BrokenRepr(), [BrokenRepr()]])
+def test_format_message_broken_representation(rootlogger: TagTracer, value) -> None:
+    placeholder = f"<unprintable {type(value).__name__} object>"
+
+    assert rootlogger._format_message(["test"], [value]) == f"{placeholder} [test]\n"
+    assert rootlogger._format_message(["test"], ["hello", {"arg": value}]) == (
+        f"hello [test]\n    arg: {placeholder}\n"
+    )
+
+
+def test_format_message_broken_key(rootlogger: TagTracer) -> None:
+    assert rootlogger._format_message(["test"], [{BrokenStr(): "value"}]) == (
+        " [test]\n    <unprintable BrokenStr object>: value\n"
+    )
+
+
+@pytest.mark.parametrize("with_writer", [False, True])
+def test_processor_receives_original_objects(
+    rootlogger: TagTracer, with_writer: bool
+) -> None:
+    value = BrokenStr()
+    extra = {"arg": value}
+    messages = []
+    processed = []
+    if with_writer:
+        rootlogger.setwriter(messages.append)
+    rootlogger.setprocessor("test", lambda tags, args: processed.append((tags, args)))
+
+    rootlogger.get("test")(value, extra)
+
+    assert len(messages) == int(with_writer)
+    assert processed[0][0] == ("test",)
+    assert processed[0][1][0] is value
+    assert processed[0][1][1] is extra
+
+
