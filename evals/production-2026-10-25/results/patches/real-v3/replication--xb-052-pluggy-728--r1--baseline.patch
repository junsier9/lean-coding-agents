+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize("broken_method", ["__str__", "__repr__", None])
+def test_hook_tracing_unprintable_values(
+    pm: PluginManager, firstresult: bool, broken_method: str | None
+) -> None:
+    class Api:
+        @hookspec(firstresult=firstresult)
+        def hello(self, arg): ...
+
+    def broken(self):
+        raise ValueError("cannot format")
+
+    value = (
+        type("Broken", (), {broken_method: broken})()
+        if broken_method is not None
+        else "café 中文 🙂\ud800\udfff"
+    )
+    calls = []
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg):
+            calls.append(arg)
+            return arg
+
+    pm.add_hookspecs(Api)
+    pm.register(Plugin())
+    output = []
+    pm.trace.root.setwriter(lambda message: output.append(message.encode("utf-8")))
+    undo = pm.enable_tracing()
+    try:
+        result = pm.hook.hello(arg=value)
+        assert (result if firstresult else result[0]) is value
+        assert calls == [value]
+        assert pm.trace.root.indent == 0
+        assert len(output) == 2
+        if broken_method is None:
+            assert "café 中文 🙂\\ud800\\udfff" in output[0].decode("utf-8")
+        else:
+            assert b"<unprintable " in b"".join(output)
+    finally:
+        undo()
+    output.clear()
+    pm.hook.hello(arg=value)
+    assert output == []
+
+
+@pytest.mark.parametrize("phase", ["argument", "result", "hook"])
+@pytest.mark.parametrize("exception_type", [KeyboardInterrupt, SystemExit, GeneratorExit])
+def test_hook_tracing_preserves_interrupts(
+    he_pm: PluginManager, phase: str, exception_type: type[BaseException]
+) -> None:
+    interruption = exception_type("stop")
+
+    class InterruptingStr:
+        def __str__(self):
+            raise interruption
+
+    class InterruptingRepr:
+        def __repr__(self):
+            raise interruption
+
+    calls = []
+
+    class Plugin:
+        @hookimpl
+        def he_method1(self, arg):
+            calls.append(arg)
+            if phase == "hook":
+                raise interruption
+            return InterruptingRepr() if phase == "result" else arg
+
+    he_pm.register(Plugin())
+    he_pm.trace.root.setwriter(lambda message: None)
+    he_pm.trace.root.indent = 2
+    undo = he_pm.enable_tracing()
+    try:
+        with pytest.raises(exception_type) as excinfo:
+            he_pm.hook.he_method1(arg=InterruptingStr() if phase == "argument" else 1)
+        assert excinfo.value is interruption
+        assert len(calls) == (0 if phase == "argument" else 1)
+        assert he_pm.trace.root.indent == 2
+    finally:
+        undo()
+
+
