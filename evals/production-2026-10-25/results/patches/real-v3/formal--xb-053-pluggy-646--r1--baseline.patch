--- a/testing/test_pluginmanager.py
+++ b/testing/test_pluginmanager.py
@@ -575,6 +575,127 @@ def test_get_hookcallers(pm: PluginManager) -> None:
     assert pm.get_hookcallers(object()) is None
 
 
+@pytest.mark.parametrize("spec_registration", ["before", "after", "none"])
+def test_get_hookcallers_multiple_implementations(
+    pm: PluginManager, spec_registration: str
+) -> None:
+    class Hooks:
+        @hookspec
+        def he_method1(self): ...
+
+        @hookspec
+        def he_method2(self): ...
+
+    class Plugin:
+        __hash__ = None  # type: ignore[assignment]
+
+        @hookimpl
+        def he_method1(self): ...
+
+        @hookimpl(specname="he_method1")
+        def he_method1_extra(self): ...
+
+        @hookimpl
+        def he_method2(self): ...
+
+    if spec_registration == "before":
+        pm.add_hookspecs(Hooks)
+    plugin = Plugin()
+    pm.register(plugin)
+    if spec_registration == "after":
+        pm.add_hookspecs(Hooks)
+
+    assert len(pm.hook.he_method1.get_hookimpls()) == 2
+    assert pm.get_hookcallers(plugin) == [pm.hook.he_method1, pm.hook.he_method2]
+    empty_plugin = object()
+    pm.register(empty_plugin)
+    assert pm.get_hookcallers(empty_plugin) == []
+
+
+@pytest.mark.parametrize("unregister_by", ["plugin", "name", "blocked"])
+def test_unregister_multiple_implementations(
+    pm: PluginManager, unregister_by: str
+) -> None:
+    class Hooks:
+        @hookspec
+        def he_method1(self): ...
+
+        @hookspec
+        def he_method2(self): ...
+
+    calls = []
+
+    class Plugin:
+        def __init__(self, name: str) -> None:
+            self.name = name
+
+        @hookimpl(tryfirst=True)
+        def he_method1(self):
+            return self.name + "-first"
+
+        @hookimpl(specname="he_method1", trylast=True)
+        def he_method1_last(self):
+            return self.name + "-last"
+
+        @hookimpl(specname="he_method1", hookwrapper=True)
+        def he_method1_old_wrapper(self):
+            calls.append(self.name + "-old-before")
+            yield
+            calls.append(self.name + "-old-after")
+
+        @hookimpl(specname="he_method1", wrapper=True)
+        def he_method1_wrapper(self):
+            calls.append(self.name + "-before")
+            result = yield
+            calls.append(self.name + "-after")
+            return result
+
+        @hookimpl
+        def he_method2(self):
+            return self.name
+
+    pm.add_hookspecs(Hooks)
+    before, plugin, after = Plugin("before"), Plugin("target"), Plugin("after")
+    for item in (before, plugin, after):
+        pm.register(item, item.name)
+
+    assert pm.hook.he_method1() == [
+        "after-first",
+        "target-first",
+        "before-first",
+        "before-last",
+        "target-last",
+        "after-last",
+    ]
+    assert len(calls) == 12
+    remaining_impls = [
+        impl for impl in pm.hook.he_method1.get_hookimpls() if impl.plugin is not plugin
+    ]
+
+    if unregister_by == "plugin":
+        assert pm.unregister(plugin) is plugin
+    elif unregister_by == "name":
+        assert pm.unregister(name="target") is plugin
+    else:
+        pm.set_blocked("target")
+        assert pm.is_blocked("target")
+
+    assert pm.get_hookcallers(plugin) is None
+    assert pm.get_plugin("target") is None
+    assert pm.hook.he_method1.get_hookimpls() == remaining_impls
+    calls.clear()
+    assert pm.hook.he_method1() == [
+        "after-first",
+        "before-first",
+        "before-last",
+        "after-last",
+    ]
+    assert len(calls) == 8
+    assert all(not call.startswith("target-") for call in calls)
+    assert pm.hook.he_method2() == ["after", "before"]
+    assert pm.get_hookcallers(before) == [pm.hook.he_method1, pm.hook.he_method2]
+
+
