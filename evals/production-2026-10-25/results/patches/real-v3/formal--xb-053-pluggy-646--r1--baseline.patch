+def test_remove_plugin_multiple_implementations(hc: HookCaller) -> None:
+    class Plugin:
+        def __eq__(self, other: object) -> bool:
+            return isinstance(other, Plugin)
+
+    @hookimpl
+    def he_method1(): ...
+
+    plugin, other = Plugin(), Plugin()
+    impl = HookImpl(
+        plugin, "target", he_method1, he_method1.example_impl  # type: ignore[attr-defined]
+    )
+    other_impl = HookImpl(
+        other, "other", he_method1, he_method1.example_impl  # type: ignore[attr-defined]
+    )
+    for item in (other_impl, impl, impl, other_impl, impl):
+        hc._add_hookimpl(item)
+
+    hc._remove_plugin(plugin)
+    assert hc.get_hookimpls() == [other_impl, other_impl]
+
+    with pytest.raises(ValueError, match="not found"):
+        hc._remove_plugin(plugin)
+    assert hc.get_hookimpls() == [other_impl, other_impl]
+
+    hc._remove_plugin(other)
+    assert hc.get_hookimpls() == []
+    with pytest.raises(ValueError, match="not found"):
+        hc._remove_plugin(other)
+
