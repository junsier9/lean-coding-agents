+@pytest.mark.parametrize('error', [None, AttributeError('delete failed'), ValueError('delete failed')])
+def test_wrap_prop_delete(error):
+    calls = []
+
+    class Manager:
+        def __enter__(self):
+            calls.append('enter')
+
+        def __exit__(self, exc_type, exc, tb):
+            calls.append(('exit', exc_type, exc))
+
+    class A(object):
+        @property
+        def prop(self):
+            return self.value
+
+        @prop.deleter
+        def prop(self):
+            calls.append('delete')
+            if error is not None:
+                raise error
+            del self.value
+
+        prop = wrap_prop(Manager())(prop)
+
+    a = A()
+    a.value = 1
+    if error is None:
+        del a.prop
+        assert not hasattr(a, 'value')
+    else:
+        with pytest.raises(type(error)) as excinfo:
+            del a.prop
+        assert excinfo.value is error
+        assert a.value == 1
+
+    exc_type = type(error) if error is not None else None
+    assert calls == ['enter', 'delete', ('exit', exc_type, error)]
+
 
