diff --git a/tests/test_strutils.py b/tests/test_strutils.py
index 1da050a..3020957 100644
--- a/tests/test_strutils.py
+++ b/tests/test_strutils.py
@@ -52,6 +52,59 @@ def test_indent():
     assert strutils.indent(to_indent, '  ') == ref
 
 
+@pytest.mark.parametrize('ending', [
+    '\n', '\r\n', '\r', '\v', '\f', '\x85', '\u2028', '\u2029',
+])
+def test_iter_splitlines_line_endings(ending):
+    text = ending + 'first' + ending * 2 + 'last' + ending
+    assert list(strutils.iter_splitlines(text)) == ['', 'first', '', 'last', '']
+    assert strutils.indent(text, '  ') == '\n  first\n\n  last\n'
+
+
+@pytest.mark.parametrize(('text', 'expected'), [
+    ('', []),
+    ('plain', ['plain']),
+    ('\n', ['', '']),
+    ('\r\n', ['', '']),
+    ('\n\n', ['', '', '']),
+    ('\r\n\r\n', ['', '', '']),
+    ('\r\r\n', ['', '', '']),
+    ('first\nlast', ['first', 'last']),
+    ('\r\nfirst\rsecond\n\v\f\x85\u2028last\u2029',
+     ['', 'first', 'second', '', '', '', '', 'last', '']),
+])
+def test_iter_splitlines_boundaries(text, expected):
+    lines = strutils.iter_splitlines(text)
+    assert iter(lines) is lines
+    assert list(lines) == expected
+    assert strutils.indent(text, '') == '\n'.join(expected)
+
+
+@pytest.mark.parametrize('text', [
+    'October 28, 2026', 'October 29, 2026', ' 28 29 280 290 2028 2029 ',
+])
+def test_iter_splitlines_preserves_numbers(text):
+    assert list(strutils.iter_splitlines(text)) == [text]
+    assert strutils.indent(text, '  ') == '  ' + text
+
+
+def test_indent_mixed_line_endings():
+    text = '\r\nOctober 28, 2026\u2028\rOctober 29, 2026\u2029'
+    lines = ['', 'October 28, 2026', '', 'October 29, 2026', '']
+    assert list(strutils.iter_splitlines(text)) == lines
+    assert strutils.indent(text, '  ') == '\n  October 28, 2026\n\n  October 29, 2026\n'
+
+    seen = []
+
+    def key(line):
+        seen.append(line)
+        return True
+
+    assert strutils.indent(text, '> ', newline='|', key=key) == (
+        '> |> October 28, 2026|> |> October 29, 2026|> ')
+    assert seen == lines
+
+
 def test_is_uuid():
     assert strutils.is_uuid(uuid.uuid4()) == True
