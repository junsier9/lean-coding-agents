+class _BeforeAndAfterIterator:
+    def __init__(self, transition, it):
+        self._transition = transition
+        self._it = it
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        if self._transition:
+            return self._transition.pop()
+
+        # Unwrap prior remainders without growing the Python call stack.
+        # Prior first iterators have finished; no new transitions can appear.
+        while isinstance(self._it, _BeforeAndAfterIterator):
+            remainder = self._it
+            self._it = remainder._it
+            if remainder._transition:
+                return remainder._transition.pop()
+        try:
+            return next(self._it)
+        except BaseException:
+            # Like the original generator, stay exhausted after an error.
+            self._it = iter(())
+            raise
+
