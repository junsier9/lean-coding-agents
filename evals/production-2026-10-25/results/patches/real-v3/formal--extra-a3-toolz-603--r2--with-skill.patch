 import itertools
+import pytest
 from itertools import starmap
 from toolz.utils import raises
 from functools import partial
@@ -356,6 +357,65 @@ def test_partition_all():
     assert list(partition_all(4, iter([obj]*7))) == result
 
 
+@pytest.mark.parametrize('n', [1, 2, 4, 10])
+@pytest.mark.parametrize('length', range(9))
+def test_partition_all_lengths(n, length):
+    values = list(range(length))
+    expected = [tuple(values[i:i + n]) for i in range(0, length, n)]
+    assert list(partition_all(n, values)) == expected
+    assert list(partition_all(n, iter(values))) == expected
+    assert list(partition_all(n, (value for value in values))) == expected
+
+
+@pytest.mark.parametrize('n', [1, 2, 4, 10])
+@pytest.mark.parametrize('length, reported_length', [
+    (0, 1), (1, 0), (3, 2), (3, 4), (3, 7), (7, 3), (4, 8), (8, 4),
+])
+def test_partition_all_inconsistent_length(n, length, reported_length):
+    class BadLength:
+        def __len__(self):
+            return reported_length
+
+        def __iter__(self):
+            return iter(range(length))
+
+    with pytest.raises(LookupError):
+        list(partition_all(n, BadLength()))
+
+
+def test_partition_all_infinite_iterator():
+    assert list(take(3, partition_all(2, itertools.count()))) == [
+        (0, 1), (2, 3), (4, 5),
+    ]
+
+
+def test_partition_all_padding_value():
+    from toolz.itertoolz import no_pad
+
+    values = [1, no_pad, no_pad]
+    expected = [(1, no_pad), (no_pad,)]
+    assert list(partition_all(2, values)) == expected
+    assert list(partition_all(2, iter(values))) == expected
+
+
+def test_partition_all_propagates_length_error():
+    class BrokenLength(list):
+        def __len__(self):
+            raise RuntimeError('length failed')
+
+    with pytest.raises(RuntimeError, match='length failed'):
+        list(partition_all(2, BrokenLength([1])))
+
+
+def test_partition_all_propagates_iteration_error():
+    def broken_iterator():
+        yield 1
+        raise TypeError('iteration failed')
+
+    with pytest.raises(TypeError, match='iteration failed'):
+        list(partition_all(2, broken_iterator()))
+
+
 def test_count():
     assert count((1, 2, 3)) == 3
     assert count([]) == 0
