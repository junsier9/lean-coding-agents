+@pytest.mark.parametrize("param_name", ["help", "my_help"])
+def test_help_option_internal_name_does_not_duplicate_user_parameter(param_name):
+    option_name = f"--{param_name.replace('_', '-')}"
+    param = click.Argument([param_name])
+    cli = click.Command("cli", params=[param])
+    ctx = click.Context(cli, help_option_names=[option_name])
+
+    params = cli.to_info_dict(ctx)["params"]
+    assert params[0]["name"] == param_name
+    assert params[1]["name"] != param_name
+    assert params[1]["opts"] == [option_name]
+
+    help_option = cli.get_help_option(ctx)
+    assert cli.get_help_option(ctx) is help_option
+    assert cli.params == [param]
+    assert cli.to_info_dict(ctx)["params"] == params
+
