diff --git a/tests/test_basic.py b/tests/test_basic.py
index 96c1bf2..6b42fbe 100644
--- a/tests/test_basic.py
+++ b/tests/test_basic.py
@@ -28,6 +28,103 @@ def test_basic_functionality(runner):
     assert result.exit_code == 0
 
 
+@pytest.mark.parametrize(
+    ("help_names", "param_name"),
+    [
+        (["--help"], "help"),
+        (["--assist"], "assist"),
+        (["--my-help"], "my_help"),
+        (["-h", "--help"], "help"),
+    ],
+)
+@pytest.mark.parametrize("param_kind", ["argument", "option", "flag"])
+def test_help_option_internal_name_collision(runner, help_names, param_name, param_kind):
+    if param_kind == "argument":
+        param = click.Argument([param_name], required=False, default="default")
+        args = ["value"]
+        value = "value"
+        default = "default"
+    elif param_kind == "option":
+        param = click.Option(["--value", param_name], default="default")
+        args = ["--value", "value"]
+        value = "value"
+        default = "default"
+    else:
+        param = click.Option(["--value", param_name], is_flag=True)
+        args = ["--value"]
+        value = True
+        default = False
+
+    @click.command(params=[param], context_settings={"help_option_names": help_names})
+    @click.pass_context
+    def cli(ctx, **kwargs):
+        return kwargs, ctx.get_parameter_source(param_name)
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exception is None, result.output
+    assert result.return_value == (
+        {param_name: value},
+        click.core.ParameterSource.COMMANDLINE,
+    )
+
+    # Help remains eager even with a conflicting parameter present, and
+    # the command callback must not run when help is requested.
+    for help_name in help_names:
+        for help_args in ([help_name], [help_name, *args], [*args, help_name]):
+            result = runner.invoke(cli, help_args, standalone_mode=False)
+            assert result.exception is None, result.output
+            assert result.return_value == 0
+            assert "Show this message and exit." in result.output
+
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert result.exception is None, result.output
+    assert result.return_value == (
+        {param_name: default},
+        click.core.ParameterSource.DEFAULT,
+    )
+
+
+def test_help_option_internal_name_collision_with_multiple_names(runner):
+    @click.command()
+    @click.argument("help")
+    @click.option("--first", "_help")
+    @click.option("--second", "__help")
+    def cli(**kwargs):
+        return kwargs
+
+    result = runner.invoke(
+        cli, ["value", "--first", "one", "--second", "two"], standalone_mode=False
+    )
+    assert result.exception is None, result.output
+    assert result.return_value == {"help": "value", "_help": "one", "__help": "two"}
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exception is None, result.output
+    assert "Show this message and exit." in result.output
+
+
+@pytest.mark.parametrize("help_names", [["--help"], ["-h", "--help"]])
+def test_explicit_help_option_overrides_automatic_help(runner, help_names):
+    @click.command(context_settings={"help_option_names": help_names})
+    @click.option("--help", default="default")
+    def cli(help):
+        return help
+
+    result = runner.invoke(cli, ["--help", "value"], standalone_mode=False)
+    assert result.exception is None, result.output
+    assert result.return_value == "value"
+
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert result.exception is None, result.output
+    assert result.return_value == "default"
+
+    if "-h" in help_names:
+        result = runner.invoke(cli, ["-h"])
+        assert result.exception is None, result.output
+        assert "--help TEXT" in result.output
+        assert "Show this message and exit." in result.output
+
+
