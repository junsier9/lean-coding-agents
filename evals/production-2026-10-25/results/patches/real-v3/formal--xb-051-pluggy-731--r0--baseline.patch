+@pytest.mark.parametrize("name", [None, "invalid"])
+def test_register_none(pm: PluginManager, name: str | None) -> None:
+    with pytest.raises(ValueError, match="None"):
+        pm.register(None, name=name)
+
+    assert pm.list_name_plugin() == []
+    assert not pm.is_registered(None)
+    assert pm.get_plugins() == set()
+
+    plugin = object()
+    plugin_name = name or pm.get_canonical_name(None)
+    assert not pm.is_blocked(plugin_name)
+    assert pm.register(plugin, name=plugin_name) == plugin_name
+    assert pm.get_plugin(plugin_name) is plugin
+    assert pm.is_registered(plugin)
+    assert pm.get_plugins() == {plugin}
+    assert pm.unregister(plugin) is plugin
+    assert pm.list_name_plugin() == []
+
+
+@pytest.mark.parametrize("name", ["registered", "blocked"])
+def test_register_none_preserves_registry(pm: PluginManager, name: str) -> None:
+    plugin = object()
+    pm.register(plugin, name="registered")
+    pm.set_blocked("blocked")
+    registered = pm.list_name_plugin()
+
+    with pytest.raises(ValueError, match="None"):
+        pm.register(None, name=name)
+
+    assert pm.list_name_plugin() == registered
+    assert pm.get_plugins() == {plugin}
+    assert pm.get_plugin("registered") is plugin
+    assert pm.is_registered(plugin)
+    assert pm.is_blocked("blocked")
+    assert pm.register(object(), name="blocked") is None
+    assert pm.unregister(plugin) is plugin
+    assert pm.unblock("blocked")
+    assert pm.list_name_plugin() == []
+
+
+@pytest.mark.parametrize("plugin", [0, False, ""])
+def test_register_falsy_plugin(pm: PluginManager, plugin: object) -> None:
+    assert pm.register(plugin, name="falsy") == "falsy"
+    assert pm.get_plugin("falsy") is plugin
+    assert pm.is_registered(plugin)
+    assert pm.get_plugins() == {plugin}
+
+
 def test_pm(pm: PluginManager) -> None:
