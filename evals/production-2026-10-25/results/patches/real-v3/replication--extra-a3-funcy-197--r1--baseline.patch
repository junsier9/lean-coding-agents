+@pytest.mark.parametrize('error', [None, ValueError('delete failed'), AttributeError('delete failed')])
+@pytest.mark.parametrize('suppress_error', [False, True])
+def test_wrap_prop_delete(error, suppress_error):
+    calls = []
+
+    @contextmanager
+    def manager():
+        calls.append('enter')
+        try:
+            yield
+        except Exception as exc:
+            calls.append(exc)
+            if not suppress_error:
+                raise
+        finally:
+            calls.append('exit')
+
+    class A(object):
+        @property
+        def prop(self):
+            return self.value
+
+        @prop.deleter
+        def prop(self):
+            calls.append(self)
+            if error is not None:
+                raise error
+            del self.value
+
+        prop = wrap_prop(manager())(prop)
+
+    a = A()
+    a.value = 1
+    if error is None or suppress_error:
+        del a.prop
+    else:
+        with pytest.raises(type(error)) as exc_info:
+            del a.prop
+        assert exc_info.value is error
+
+    assert calls == ['enter', a] + ([] if error is None else [error]) + ['exit']
+    assert ('value' in a.__dict__) == (error is not None)
+
+
+def test_wrap_prop_delete_without_deleter():
+    calls = []
+
+    @contextmanager
+    def manager():
+        calls.append('enter')
+        try:
+            yield
+        finally:
+            calls.append('exit')
+
+    class A(object):
+        @wrap_prop(manager())
+        @property
+        def prop(self):
+            return 1
+
+    a = A()
+    with pytest.raises(AttributeError):
+        del a.prop
+    assert calls == ['enter', 'exit']
 
 
