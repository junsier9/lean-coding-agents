+class UnboundMethodTest(unittest.TestCase):
+    def test_call_forms(self):
+        for cls in (Cached, Unhashable):
+            for name in (
+                "get",
+                "get_typed",
+                "get_info",
+                "get_lock",
+                "get_lock_info",
+                "get_cond",
+                "get_cond_info",
+                "get_lock_cond",
+                "get_lock_cond_info",
+            ):
+                with self.subTest(cls=cls, method=name):
+                    first = cls({})
+                    second = cls({}, count=10)
+                    unbound = getattr(cls, name)
+
+                    self.assertNotIn(name, first.__dict__)
+                    self.assertEqual(unbound(first, value=1), 0)
+                    bound = getattr(first, name)
+                    self.assertIs(first.__dict__[name], bound)
+                    self.assertEqual(bound(value=1), 0)
+                    self.assertEqual(unbound(first, value=1), 0)
+
+                    self.assertEqual(getattr(second, name)(value=1), 10)
+                    self.assertEqual(unbound(second, value=1), 10)
+                    self.assertEqual(first.count, 1)
+                    self.assertEqual(second.count, 11)
+                    self.assertIsNot(first.cache, second.cache)
+                    if name.endswith("_info"):
+                        self.assertEqual(bound.cache_info(), (2, 1, None, 1))
+                        self.assertEqual(
+                            getattr(second, name).cache_info(), (1, 1, None, 1)
+                        )
+
+                    bound.cache_clear()
+                    self.assertEqual(first.cache, {})
+                    self.assertEqual(len(second.cache), 1)
+                    if name.endswith("_info"):
+                        self.assertEqual(bound.cache_info(), (0, 0, None, 0))
+                        self.assertEqual(
+                            getattr(second, name).cache_info(), (1, 1, None, 1)
+                        )
+                    self.assertEqual(unbound(first, value=1), 1)
+                    self.assertIs(getattr(first, name), bound)
+
+    def test_method_error(self):
+        cached = Cached({})
+        unbound = getattr(Cached, "get_cond_error")
+        for call in (
+            lambda: unbound(cached, 0),
+            lambda: cached.get_cond_error(0),
+            lambda: unbound(cached, 0),
+        ):
+            with self.assertRaisesRegex(ValueError, "test error"):
+                call()
+        self.assertEqual(cached.cache, {})
+        self.assertEqual(cached.cond.wait_count, 3)
+        self.assertEqual(cached.cond.notify_count, 3)
+
+    def test_metadata(self):
+        self.assertEqual(Cached.get.__name__, "get")
+        self.assertEqual((Cached.get.__doc__ or "").strip(), "docstring")
+        cached = Cached({})
+        self.assertIs(Cached.get.__wrapped__, cached.get.__wrapped__)
+        self.assertEqual(Cached.get.__wrapped__(cached, 0), 0)
+        self.assertEqual(cached.cache, {})
+
+
