+    def test_negative(self):
+        for seq, n, strict in product(
+            ('ABCDEFG', '', list(range(7)), []), (-1, -3, -10), (False, True)
+        ):
+            with self.subTest(seq=seq, n=n, strict=strict):
+                with self.assertRaisesRegex(ValueError, 'n must be >= 0'):
+                    mi.sliced(seq, n, strict=strict)
+
+    def test_zero(self):
+        for seq, strict in product(
+            ('ABCDEFG', '', list(range(7)), []), (False, True)
+        ):
+            with self.subTest(seq=seq, strict=strict):
+                self.assertEqual(list(mi.sliced(seq, 0, strict=strict)), [])
+
+    def test_positive_sizes(self):
+        for (seq, n, expected), strict in product(
+            (
+                ('ABCDEFG', 1, list('ABCDEFG')),
+                ('ABCDEFG', 7, ['ABCDEFG']),
+                ('', 3, []),
+            ),
+            (False, True),
+        ):
+            with self.subTest(seq=seq, n=n, strict=strict):
+                self.assertEqual(
+                    list(mi.sliced(seq, n, strict=strict)), expected
+                )
+        self.assertEqual(list(mi.sliced('ABCDEFG', 8)), ['ABCDEFG'])
+
+    def test_strict_incomplete_slice(self):
+        slices = mi.sliced('ABCDEFG', 3, strict=True)
+        self.assertEqual(next(slices), 'ABC')
+        self.assertEqual(next(slices), 'DEF')
+        with self.assertRaisesRegex(ValueError, 'seq is not divisible by n'):
+            next(slices)
