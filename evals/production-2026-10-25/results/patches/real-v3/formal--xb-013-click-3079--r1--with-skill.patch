diff --git a/src/click/core.py b/src/click/core.py
index cd8052f..c6f510d 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -2933,6 +2933,29 @@ class Option(Parameter):
                 nargs=self.nargs,
             )
 
+    def get_default(
+        self, ctx: Context, call: bool = True
+    ) -> t.Any | t.Callable[[], t.Any] | None:
+        value = super().get_default(ctx, call=False)
+
+        # Value flags sharing a name also share the explicitly declared default.
+        if value is UNSET and self.is_flag and not self.is_bool_flag:
+            for param in ctx.command.params:
+                if (
+                    isinstance(param, Option)
+                    and param.is_flag
+                    and not param.is_bool_flag
+                    and param.name == self.name
+                    and param.default is not UNSET
+                ):
+                    value = param.default
+                    break
+
+        if call and callable(value):
+            value = value()
+
+        return value
+
     def get_help_record(self, ctx: Context) -> tuple[str, str] | None:
         if self.hidden:
             return None
diff --git a/tests/test_defaults.py b/tests/test_defaults.py
index 3f293e8..2955912 100644
--- a/tests/test_defaults.py
+++ b/tests/test_defaults.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -84,3 +86,101 @@ def test_flag_default_map(runner):
 
     result = runner.invoke(cli, ["foo", "--help"], default_map={"foo": {"name": True}})
     assert "default: name" in result.output
+
+
+@pytest.mark.parametrize("reverse_order", [False, True])
+@pytest.mark.parametrize("with_callback", [False, True])
+@pytest.mark.parametrize(
+    ("default", "expected_default"),
+    [
+        (True, "upper"),
+        ("lower", "lower"),
+        (False, "False"),
+        (None, None),
+        (0, "0"),
+        ("", ""),
+        (lambda: "dynamic", "dynamic"),
+    ],
+)
+@pytest.mark.parametrize(
+    ("args", "selected"),
+    [
+        ([], None),
+        (["--upper"], "upper"),
+        (["--lower"], "lower"),
+        (["--upper", "--lower"], "lower"),
+        (["--lower", "--upper"], "upper"),
+    ],
+)
+def test_shared_flag_default(
+    runner, reverse_order, with_callback, default, expected_default, args, selected
+):
+    def callback(ctx, param, value):
+        return f"callback: {value!r}"
+
+    callback = callback if with_callback else None
+
+    @click.command()
+    @click.option(
+        "--upper", "case", flag_value="upper", default=default, callback=callback
+    )
+    @click.option("--lower", "case", flag_value="lower", callback=callback)
+    def cli(case):
+        return case
+
+    if reverse_order:
+        cli.params.reverse()
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    expected = expected_default if selected is None else selected
+    if with_callback:
+        expected = f"callback: {expected!r}"
+
+    assert result.exception is None
+    assert result.return_value == expected
+
+
+@pytest.mark.parametrize("reverse_order", [False, True])
+def test_shared_flag_default_lookup(reverse_order):
+    def default():
+        return "upper"
+
+    @click.command()
+    @click.option("--upper", "case", flag_value="upper", default=default)
+    @click.option("--lower", "case", flag_value="lower")
+    def cli(case):
+        pass
+
+    if reverse_order:
+        cli.params.reverse()
+
+    ctx = click.Context(cli)
+    for param in cli.params:
+        assert param.get_default(ctx, call=False) is default
+        assert param.get_default(ctx) == "upper"
+
+    ctx.default_map = {"case": "mapped"}
+    for param in cli.params:
+        assert param.get_default(ctx) == "mapped"
+
+
+@pytest.mark.parametrize("reverse_order", [False, True])
+@pytest.mark.parametrize("args", [[], ["--two"]])
+def test_shared_flag_invalid_default(runner, reverse_order, args):
+    @click.command()
+    @click.option("--one", "value", flag_value=1, default="invalid")
+    @click.option("--two", "value", flag_value=2)
+    def cli(value):
+        click.echo(value)
+
+    if reverse_order:
+        cli.params.reverse()
+
+    result = runner.invoke(cli, args)
+    if args:
+        assert result.exit_code == 0
+        assert result.output == "2\n"
+    else:
+        assert result.exit_code == 2
+        assert "Invalid value for" in result.output
+        assert "is not a valid integer" in result.output
