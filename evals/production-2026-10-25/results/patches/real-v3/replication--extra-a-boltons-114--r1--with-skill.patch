+def test_callpoint_to_dict_json():
+    callpoint = Callpoint.from_current()
+    data = json.loads(json.dumps(callpoint.to_dict()))
+
+    assert data == {'func_name': 'test_callpoint_to_dict_json',
+                    'lineno': callpoint.lineno,
+                    'module_name': __name__,
+                    'module_path': __file__,
+                    'lasti': callpoint.lasti,
+                    'line': '    callpoint = Callpoint.from_current()'}
+
+
+@pytest.mark.parametrize('line', [None, '', '    print("hello")',
+                                 u'    name = "\u4e2d\u6587"'])
+def test_callpoint_to_dict_plain_line(line):
+    callpoint = Callpoint('example', 'example.py', 'func', 12, 4, line=line)
+
+    assert json.loads(json.dumps(callpoint.to_dict())) == {
+        'func_name': 'func', 'lineno': 12, 'module_name': 'example',
+        'module_path': 'example.py', 'lasti': 4, 'line': line}
+
+
+def test_callpoint_to_dict_missing_source():
+    namespace = {'Callpoint': Callpoint}
+    exec(compile('callpoint = Callpoint.from_current()',
+                 '<callpoint>', 'exec'), namespace)
+    callpoint = namespace['callpoint']
+
+    assert json.loads(json.dumps(callpoint.to_dict())) == {
+        'func_name': '<module>', 'lineno': 1, 'module_name': '',
+        'module_path': '<callpoint>', 'lasti': callpoint.lasti, 'line': ''}
+
+
+@pytest.mark.parametrize('info_type', [ExceptionInfo, ContextualExceptionInfo])
+def test_exception_info_to_dict_json(info_type):
+    detail = 'diagnostic detail'
+    try:
+        raise ValueError(detail)
+    except ValueError:
+        exc_info = info_type.from_current()
+
+    data = exc_info.to_dict()
+    assert json.loads(json.dumps(data)) == data
+    assert data['exc_type'] == 'ValueError'
+    assert data['exc_msg'] == detail
+    frame = data['exc_tb']['frames'][-1]
+    assert frame['func_name'] == 'test_exception_info_to_dict_json'
+    assert frame['module_name'] == __name__
+    assert frame['module_path'] == __file__
+    assert frame['line'] == '        raise ValueError(detail)'
+    if info_type is ContextualExceptionInfo:
+        assert frame['locals']['detail'] == repr(detail)
+        assert any('try:' in line['line'] for line in frame['pre_lines'])
+        assert any('except ValueError:' in line['line']
+                   for line in frame['post_lines'])
+
+
 
