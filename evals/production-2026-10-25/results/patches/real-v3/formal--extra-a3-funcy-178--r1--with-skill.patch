+@pytest.mark.parametrize('decorate', [once_per('n'), once_per_args],
+                         ids=['once_per', 'once_per_args'])
+@pytest.mark.parametrize('first,equal,different', [
+    ([1], [1], [2]),
+    ({'a': 1, 'b': 2}, {'b': 2, 'a': 1}, {'a': 2, 'b': 2}),
+    ({1, 2}, {2, 1}, {1, 3}),
+    (([1],), ([1],), ([2],)),
+    ((({'items': [1]},),), (({'items': [1]},),), (({'items': [2]},),)),
+], ids=['list', 'dict', 'set', 'tuple', 'nested_tuple'])
+def test_once_per_unhashable_values(decorate, first, equal, different):
+    calls = []
+
+    @decorate
+    def call(n, x=None):
+        calls.append(n)
+        return n
+
+    assert first is not equal
+    assert call(first) is first
+    assert call(n=equal) is None
+    assert call(different) is different
+    assert call(equal) is None
+    assert calls == [first, different]
+
+
+@pytest.mark.parametrize('decorate', [once_per('n'), once_per_args],
+                         ids=['once_per', 'once_per_args'])
+@pytest.mark.parametrize('value', [1, []], ids=['hashable', 'unhashable'])
+def test_once_per_function_error(decorate, value):
+    calls = []
+    error = TypeError('target failed')
+
+    @decorate
+    def call(n):
+        calls.append(n)
+        raise error
+
+    with pytest.raises(TypeError) as exc:
+        call(value)
+    assert exc.value is error
+    assert call(value) is None
+    assert calls == [value]
+
