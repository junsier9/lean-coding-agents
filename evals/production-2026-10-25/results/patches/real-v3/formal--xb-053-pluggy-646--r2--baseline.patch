+@pytest.mark.parametrize("with_specs", [False, True])
+@pytest.mark.parametrize("unregister_by", ["plugin", "name", "blocked"])
+def test_unregister_multiple_hookimpls(
+    pm: PluginManager, with_specs: bool, unregister_by: str
+) -> None:
+    class Hooks:
+        @hookspec
+        def he_method1(self): ...
+
+        @hookspec
+        def he_method2(self): ...
+
+    if with_specs:
+        pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl(specname="he_method1", tryfirst=True)
+        def first(self):
+            return "first"
+
+        @hookimpl(specname="he_method1", trylast=True)
+        def last(self):
+            return "last"
+
+        @hookimpl(specname="he_method1", wrapper=True)
+        def wrapper(self):
+            return (yield)
+
+        @hookimpl(specname="he_method1", hookwrapper=True)
+        def old_wrapper(self):
+            yield
+
+        @hookimpl
+        def he_method2(self):
+            return "target"
+
+    class OtherPlugin:
+        def __init__(self, value: str) -> None:
+            self.value = value
+
+        @hookimpl
+        def he_method1(self):
+            return self.value
+
+        @hookimpl(specname="he_method1", wrapper=True)
+        def wrapper(self):
+            return (yield)
+
+        @hookimpl
+        def he_method2(self):
+            return self.value
+
+    before, plugin, after = OtherPlugin("before"), Plugin(), OtherPlugin("after")
+    pm.register(before)
+    pm.register(plugin, "target")
+    pm.register(after)
+    hookcallers = [pm.hook.he_method1, pm.hook.he_method2]
+    remaining_impls = [
+        [impl for impl in hook.get_hookimpls() if impl.plugin is not plugin]
+        for hook in hookcallers
+    ]
+    assert pm.hook.he_method1() == ["first", "after", "before", "last"]
+    assert pm.hook.he_method2() == ["after", "target", "before"]
+
+    if unregister_by == "plugin":
+        assert pm.unregister(plugin) is plugin
+    elif unregister_by == "name":
+        assert pm.unregister(name="target") is plugin
+    else:
+        pm.set_blocked("target")
+        assert pm.is_blocked("target")
+
+    assert not pm.is_registered(plugin)
+    assert pm.get_plugin("target") is None
+    assert pm.get_hookcallers(plugin) is None
+    for hook, impls in zip(hookcallers, remaining_impls):
+        assert hook.get_hookimpls() == impls
+    assert pm.hook.he_method1() == ["after", "before"]
+    assert pm.hook.he_method2() == ["after", "before"]
+
+    if unregister_by == "blocked":
+        assert pm.unblock("target")
+    assert pm.register(plugin, "target") == "target"
+    assert pm.hook.he_method1() == ["first", "after", "before", "last"]
+    assert pm.hook.he_method2() == ["target", "after", "before"]
+
+
