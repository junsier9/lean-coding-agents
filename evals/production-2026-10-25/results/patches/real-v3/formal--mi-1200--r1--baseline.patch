+                        ):
+                            mi.sliced(seq, n, strict=strict)
+
+    def test_zero_size(self):
+        for seq in ('', 'ABCDEFG', (), (1, 2, 3), [], [1, 2, 3]):
+            for strict in (False, True):
+                with self.subTest(seq=seq, strict=strict):
+                    self.assertEqual(
+                        list(mi.sliced(seq, 0, strict=strict)), []
+                    )
+
+    def test_empty(self):
