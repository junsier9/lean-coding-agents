+    def test_negative_size(self):
+        for seq in ('', 'ABCDEFG'):
+            for n in (-1, -2, -7, -8):
+                for strict in (False, True):
+                    with self.subTest(seq=seq, n=n, strict=strict):
+                        with self.assertRaisesRegex(
