+@pytest.mark.parametrize('key_func, args, kwargs', [
+    (None, (1, 2), {}),
+    (None, (1,), {'y': 2}),
+    (None, (), {'x': 1, 'y': 2}),
+    (lambda x, y: x + y, (1,), {'y': 2}),
+])
+def test_cache_invalidate_idempotent(key_func, args, kwargs):
+    calls = []
+
+    @cache(timeout=60, key_func=key_func)
+    def add(x, y):
+        calls.append((x, y))
+        return x + y
+
+    assert add.invalidate(*args, **kwargs) is None
+    assert add.invalidate(*args, **kwargs) is None
+    assert calls == []
+
+    assert add(*args, **kwargs) == 3
+    assert add(*args, **kwargs) == 3
+    assert add(4, 5) == 9
+    assert calls == [(1, 2), (4, 5)]
+
+    assert add.invalidate(*args, **kwargs) is None
+    assert add.invalidate(*args, **kwargs) is None
+    assert add(4, 5) == 9
+    assert add(*args, **kwargs) == 3
+    assert add(*args, **kwargs) == 3
+    assert calls == [(1, 2), (4, 5), (1, 2)]
+
+
+def test_cache_invalidate_after_invalidate_all():
+    calls = []
+
+    @cache(timeout=60)
+    def inc(x):
+        calls.append(x)
+        return x + 1
+
+    assert inc(0) == 1
+    assert inc(1) == 2
+    inc.invalidate_all()
+    inc.invalidate_all()
+    assert inc.invalidate(0) is None
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert calls == [0, 1, 0, 1]
+
+
+@pytest.mark.parametrize('error', [KeyError('invalid key'), TypeError('invalid key')])
+def test_cache_invalidate_key_func_error(error):
+    def key_func(x):
+        raise error
+
+    @cache(timeout=60, key_func=key_func)
+    def inc(x):
+        return x + 1
+
+    with pytest.raises(type(error)) as exc:
+        inc.invalidate(0)
+    assert exc.value is error
+
+
