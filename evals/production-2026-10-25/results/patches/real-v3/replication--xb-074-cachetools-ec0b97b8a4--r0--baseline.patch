+class InheritedMethodTest(unittest.TestCase):
+    def decorator_options(self):
+        for info in (False, True):
+            for sync in (
+                {},
+                {"lock": lambda self: self.lock},
+                {"condition": lambda self: self.cond},
+                {
+                    "lock": lambda self: self.lock,
+                    "condition": lambda self: self.cond,
+                },
+            ):
+                yield dict(sync, info=info)
+
+    def base_class(self, options):
+        class Base:
+            def __init__(self):
+                self.cache = Cache(2)
+                self.count = 0
+                self.lock = CountedLock()
+                self.cond = CountedCondition()
+
+            @cachedmethod(lambda self: self.cache, **options)
+            def get(self, value):
+                self.count += 1
+                return value
+
+        return Base
+
+    def test_super_override(self):
+        for options in self.decorator_options():
+            with self.subTest(**options):
+                Base = self.base_class(options)
+
+                class Derived(Base):
+                    overrides = 0
+
+                    def get(self, value):
+                        self.overrides += 1
+                        return super().get(value) + 1
+
+                cached = Derived()
+                self.assertEqual(cached.get(1), 2)
+                self.assertEqual(cached.get(1), 2)
+                self.assertEqual(cached.get(2), 3)
+                self.assertEqual(cached.overrides, 3)
+                self.assertEqual(cached.count, 2)
+
+                parent = super(Derived, cached).get
+                self.assertIs(parent, super(Derived, cached).get)
+                self.assertIs(parent.cache, cached.cache)
+                if options["info"]:
+                    self.assertEqual(parent.cache_info(), (1, 2, 2, 2))
+
+                parent.cache_clear()
+                if options["info"]:
+                    self.assertEqual(parent.cache_info(), (0, 0, 2, 0))
+                self.assertEqual(cached.get(1), 2)
+                self.assertEqual(cached.overrides, 4)
+                self.assertEqual(cached.count, 3)
+
+    def test_super_cached_override(self):
+        for options in self.decorator_options():
+            for parent_first in (False, True):
+                with self.subTest(parent_first=parent_first, **options):
+                    Base = self.base_class(options)
+
+                    class Derived(Base):
+                        def __init__(self):
+                            super().__init__()
+                            self.derived_cache = Cache(2)
+                            self.derived_count = 0
+
+                        @cachedmethod(lambda self: self.derived_cache, **options)
+                        def get(self, value):
+                            self.derived_count += 1
+                            return super().get(value) + 1
+
+                    cached = Derived()
+                    if parent_first:
+                        self.assertEqual(Base.get(cached, 1), 1)
+                    self.assertEqual(cached.get(1), 2)
+                    self.assertEqual(cached.get(1), 2)
+                    child = cached.get
+                    parent = super(Derived, cached).get
+                    self.assertIsNot(parent, child)
+                    self.assertIs(parent, super(Derived, cached).get)
+                    self.assertIs(child, cached.get)
+                    self.assertIs(parent.cache, cached.cache)
+                    self.assertIs(child.cache, cached.derived_cache)
+                    self.assertEqual(Base.get(cached, 1), 1)
+                    self.assertEqual(cached.get(2), 3)
+                    self.assertEqual(cached.count, 2)
+                    self.assertEqual(cached.derived_count, 2)
+                    if options["info"]:
+                        self.assertEqual(child.cache_info(), (1, 2, 2, 2))
+                        self.assertEqual(
+                            parent.cache_info(), (1 + parent_first, 2, 2, 2)
+                        )
+
+                    parent.cache_clear()
+                    if options["info"]:
+                        self.assertEqual(parent.cache_info(), (0, 0, 2, 0))
+                        self.assertEqual(child.cache_info(), (1, 2, 2, 2))
+                    self.assertEqual(cached.get(1), 2)
+                    self.assertEqual(cached.count, 2)
+                    child.cache_clear()
+                    if options["info"]:
+                        self.assertEqual(child.cache_info(), (0, 0, 2, 0))
+                    self.assertEqual(cached.get(1), 2)
+                    self.assertEqual(cached.count, 3)
+                    self.assertEqual(cached.derived_count, 3)
+                    if options["info"]:
+                        self.assertEqual(parent.cache_info(), (0, 1, 2, 1))
+                        self.assertEqual(child.cache_info(), (0, 1, 2, 1))
+
