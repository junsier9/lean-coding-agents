@@ -75,13 +75,18 @@ class Callpoint(object):
         self.line = line
 
     def to_dict(self):
-        "Get a :class:`dict` copy of the Callpoint. Useful for serialization."
+        """Get a JSON-serializable :class:`dict` copy of the Callpoint.
+
+        Deferred source lines are resolved to strings in the copy.
+        """
         ret = {}
         for slot in self.__slots__:
             try:
                 ret[slot] = getattr(self, slot)
             except AttributeError:
                 pass
+        if isinstance(ret.get('line'), _DeferredLine):
+            ret['line'] = str(ret['line'])
         return ret
 
     @classmethod
