+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+def test_lookuper_retries_failed_builder(deco):
+    calls = []
+
+    @deco
+    def lookup():
+        calls.append('build')
+        if len(calls) <= 2:
+            raise RuntimeError('build failed')
+        return {'ready': 42}
+
+    assert calls == []
+    for attempt in range(1, 3):
+        with pytest.raises(RuntimeError, match='build failed'):
+            lookup('ready')
+        assert len(calls) == attempt
+
+    assert lookup('ready') == 42
+    assert lookup('ready') == 42
+    assert len(calls) == 3
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('error', [RuntimeError, ValueError])
+def test_lookuper_discards_failed_iterable(deco, error):
+    calls = []
+
+    @deco
+    def lookup():
+        calls.append('build')
+        if len(calls) <= 2:
+            yield 'stale', 1
+            yield 'shared', 'old'
+            if error is RuntimeError:
+                raise RuntimeError('build failed')
+            yield ('invalid',)
+        yield 'shared', 'new'
+        yield 'ready', 42
+
+    for attempt in range(1, 3):
+        with pytest.raises(error):
+            lookup('stale')
+        assert len(calls) == attempt
+
+    assert lookup('ready') == 42
+    assert lookup('shared') == 'new'
+    if deco is silent_lookuper:
+        assert lookup('stale') is None
+    else:
+        with pytest.raises(LookupError):
+            lookup('stale')
+    assert len(calls) == 3
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('empty', [dict, list, lambda: iter(())],
+                         ids=['mapping', 'pairs', 'iterator'])
+def test_lookuper_initializes_empty_table_once(deco, empty):
+    calls = []
+
+    @deco
+    def lookup():
+        calls.append('build')
+        return empty()
+
+    assert calls == []
+    for key in ['missing', 'another', 'missing']:
+        if deco is silent_lookuper:
+            assert lookup(key) is None
+        else:
+            with pytest.raises(LookupError):
+                lookup(key)
+    assert calls == ['build']
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+def test_lookuper_nested_failure_is_isolated(deco):
+    calls = []
+
+    @deco
+    def table(name):
+        calls.append(name)
+        if name == 'retry' and calls.count(name) == 1:
+            raise RuntimeError('build failed')
+        return {'value': name}
+
+    retry = table('retry')
+    stable = table('stable')
+    assert calls == []
+    assert stable('value') == 'stable'
+    with pytest.raises(RuntimeError, match='build failed'):
+        retry('value')
+    assert stable('value') == 'stable'
+    assert table('retry') is retry
+    assert retry('value') == 'retry'
+    assert retry('value') == 'retry'
+    assert calls == ['stable', 'retry', 'retry']
+
+
