+@pytest.mark.parametrize("as_bytes", [False, True])
+@pytest.mark.parametrize(
+    ("url", "output"),
+    [
+        ("http://[::1]", "http://[::1]"),
+        ("http://[::1]:0/", "http://[::1]:0/"),
+        (
+            "http://[2001:DB8:0:0:0:0:0:1]:80/path?key=value#part",
+            "http://[2001:db8:0:0:0:0:0:1]:80/path?key=value#part",
+        ),
+        (
+            "http://[::ffff:192.0.2.1]:65535/path?key=value",
+            "http://[::ffff:192.0.2.1]:65535/path?key=value",
+        ),
+        (
+            "http://[fe80::1%25eth0]:8080/path?key=value",
+            "http://[fe80::1%25eth0]:8080/path?key=value",
+        ),
+        ("//[2001:db8::1]/path?key=value", "//[2001:db8::1]/path?key=value"),
+        (
+            "https://usér:p%40ss@[2001:db8::1]:8443/résumé [x]?q=café#fr ag",
+            "https://us%C3%A9r:p%40ss@[2001:db8::1]:8443/"
+            "r%C3%A9sum%C3%A9%20%5Bx%5D?q=caf%C3%A9#fr%20ag",
+        ),
+    ],
+)
+def test_safe_url_string_ipv6(url: str, output: str, as_bytes: bool) -> None:
+    _test_safe_url_string(url.encode() if as_bytes else url, output=output)
+
+
+@pytest.mark.parametrize(
+    ("quote_path", "path"),
+    [(True, "/%A3%20%5Bx%5D"), (False, "/£ [x]")],
+)
+def test_safe_url_string_ipv6_encoding(quote_path: bool, path: str) -> None:
+    assert (
+        safe_url_string(
+            b"http://[::1]:8080/\xa3 [x]?unit=\xb5",
+            encoding="latin-1",
+            path_encoding="latin-1",
+            quote_path=quote_path,
+        )
+        == f"http://[::1]:8080{path}?unit=%B5"
+    )
+
