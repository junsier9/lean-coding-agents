+def test_wrap_prop_delete():
+    calls = []
+
+    class Manager:
+        def __enter__(self):
+            calls.append('enter')
+
+        def __exit__(self, exc_type, exc_value, traceback):
+            calls.append(('exit', exc_value))
+
+    class A:
+        def __init__(self):
+            self.value = 1
+
+        @property
+        def prop(self):
+            return self.value
+
+        @prop.deleter
+        def prop(self):
+            calls.append('delete')
+            del self.value
+
+        prop = wrap_prop(Manager())(prop)
+
+    a = A()
+    del a.prop
+    assert not hasattr(a, 'value')
+    assert calls == ['enter', 'delete', ('exit', None)]
+
+
+@pytest.mark.parametrize('has_deleter', [False, True])
+def test_wrap_prop_delete_error(has_deleter):
+    calls = []
+    error = RuntimeError('delete failed')
+
+    class Manager:
+        def __enter__(self):
+            calls.append('enter')
+
+        def __exit__(self, exc_type, exc_value, traceback):
+            calls.append(('exit', exc_value))
+
+    class A:
+        def delete_prop(self):
+            raise error
+
+        prop = wrap_prop(Manager())(property(
+            lambda self: 1, fdel=delete_prop if has_deleter else None))
+
+    with pytest.raises(RuntimeError if has_deleter else AttributeError) as exc:
+        del A().prop
+    assert calls == ['enter', ('exit', exc.value)]
+    if has_deleter:
+        assert exc.value is error
+
+
