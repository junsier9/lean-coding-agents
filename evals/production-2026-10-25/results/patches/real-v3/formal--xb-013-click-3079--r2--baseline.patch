diff --git a/src/click/core.py b/src/click/core.py
index cd8052f..5739980 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -2833,6 +2833,30 @@ class Option(Parameter):
         )
         return info_dict
 
+    def get_default(
+        self, ctx: Context, call: bool = True
+    ) -> t.Any | t.Callable[[], t.Any] | None:
+        value = super().get_default(ctx, call=False)
+
+        # Flags sharing a name share the declared default, regardless of order.
+        # False, None, and other false values are valid defaults, so only skip UNSET.
+        if value is UNSET and self.is_flag and not self.is_bool_flag:
+            for param in ctx.command.params:
+                if (
+                    isinstance(param, Option)
+                    and param.is_flag
+                    and not param.is_bool_flag
+                    and param.name == self.name
+                    and param.default is not UNSET
+                ):
+                    value = param.default
+                    break
+
+        if call and callable(value):
+            value = value()
+
+        return value
+
