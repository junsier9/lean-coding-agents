     assert result.return_value == ((True, False), (True,), (1, -1))
 
 
+@pytest.mark.parametrize("reverse", [False, True])
+@pytest.mark.parametrize(
+    ("default", "expected_default"),
+    [
+        (True, "upper"),
+        ("lower", "lower"),
+        (False, "False"),
+        (0, "0"),
+        ("", ""),
+        (None, None),
+        (lambda: "dynamic", "dynamic"),
+    ],
+)
+@pytest.mark.parametrize(
+    ("args", "expected"),
+    [
+        ([], None),
+        (["--upper"], "upper"),
+        (["--lower"], "lower"),
+        (["--upper", "--lower"], "lower"),
+        (["--lower", "--upper"], "upper"),
+    ],
+)
+def test_shared_flag_default(runner, reverse, default, expected_default, args, expected):
+    def cli(case):
+        return case
+
+    options = [
+        click.option("--upper", "case", flag_value="upper", default=default),
+        click.option("--lower", "case", flag_value="lower"),
+    ]
+    if reverse:
+        options.reverse()
+
+    for option in options:
+        cli = option(cli)
+    cli = click.command()(cli)
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == (expected if args else expected_default)
+
+
+@pytest.mark.parametrize("default", ["mapped", None, lambda: "mapped"])
+@pytest.mark.parametrize("args", [[], ["--upper"], ["--lower"]])
+def test_shared_flag_default_map(runner, default, args):
+    @click.command()
+    @click.option("--lower", "case", flag_value="lower")
+    @click.option("--upper", "case", flag_value="upper", default=True)
+    def cli(case):
+        return case
+
+    result = runner.invoke(
+        cli, args, default_map={"case": default}, standalone_mode=False
+    )
+    assert result.exception is None
+    expected = default() if callable(default) else default
+    if args:
+        expected = args[0][2:]
+    assert result.return_value == expected
+
+
+def test_shared_flag_callable_default():
+    calls = []
+
+    def default():
+        calls.append(True)
+        return "upper"
+
+    lower = click.Option(["--lower", "case"], flag_value="lower")
+    upper = click.Option(["--upper", "case"], flag_value="upper", default=default)
+    ctx = click.Context(click.Command("cli", params=[lower, upper]))
+
+    assert lower.get_default(ctx, call=False) is default
+    assert calls == []
+    assert lower.get_default(ctx) == "upper"
+    assert calls == [True]
+
+
 def test_flag_default_map(runner):
     """test flag with default map"""
 
