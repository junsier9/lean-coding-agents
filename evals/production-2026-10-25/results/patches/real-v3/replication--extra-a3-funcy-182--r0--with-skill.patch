+@pytest.mark.parametrize('decorate', [
+    pytest.param(memoize(), id='memoize'),
+    pytest.param(memoize(key_func=lambda x: x), id='memoize-key-func'),
+    pytest.param(cache(60), id='cache'),
+    pytest.param(cache(60, key_func=lambda x: x), id='cache-key-func'),
+    pytest.param(cache(timedelta(seconds=60)), id='cache-timedelta'),
+])
+def test_memory_decorator_reuse(decorate):
+    calls = []
+
+    @decorate
+    def inc(x):
+        calls.append('inc')
+        return x + 1
+
+    assert inc(x=1) == 2
+
+    @decorate
+    def dec(x):
+        calls.append('dec')
+        return x - 1
+
+    assert dec(x=1) == 0
+    assert inc(x=1) == 2
+    assert dec(x=1) == 0
+    assert calls == ['inc', 'dec']
+    assert inc.memory is not dec.memory
+
+    inc.invalidate(x=1)
+    assert dec(x=1) == 0
+    assert inc(x=1) == 2
+    assert calls == ['inc', 'dec', 'inc']
+
+    dec.invalidate_all()
+    assert inc(x=1) == 2
+    assert dec(x=1) == 0
+    assert calls == ['inc', 'dec', 'inc', 'dec']
+
+    inc.memory.clear()
+    assert dec(x=1) == 0
+    assert inc(x=1) == 2
+    assert calls == ['inc', 'dec', 'inc', 'dec', 'inc']
+
+
