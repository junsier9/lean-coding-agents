+@pytest.mark.parametrize('error_type', [None, ValueError, AttributeError])
+def test_wrap_prop_delete(error_type):
+    calls = []
+    error = error_type('cannot delete') if error_type is not None else None
+
+    class Manager:
+        def __enter__(self):
+            calls.append('enter')
+
+        def __exit__(self, exc_type, exc, traceback):
+            calls.append(('exit', exc_type, exc))
+
+    def delete(instance):
+        calls.append(('delete', instance))
+        if error is not None:
+            raise error
+        del instance.value
+
+    class A(object):
+        prop = wrap_prop(Manager())(property(lambda self: self.value, fdel=delete))
+
+    a = A()
+    a.value = 1
+    if error is None:
+        del a.prop
+        assert not hasattr(a, 'value')
+    else:
+        with pytest.raises(error_type) as exc_info:
+            del a.prop
+        assert exc_info.value is error
+        assert a.value == 1
+
+    assert calls == ['enter', ('delete', a), ('exit', error_type, error)]
+
+
+def test_wrap_prop_delete_without_deleter():
+    calls = []
+
+    class Manager:
+        def __enter__(self):
+            calls.append('enter')
+
+        def __exit__(self, exc_type, exc, traceback):
+            calls.append(('exit', exc_type, exc))
+
+    class A(object):
+        @wrap_prop(Manager())
+        @property
+        def prop(self):
+            return 1
+
+    a = A()
+    with pytest.raises(AttributeError) as exc_info:
+        del a.prop
+    assert calls == ['enter', ('exit', AttributeError, exc_info.value)]
+    assert a.prop == 1
+
