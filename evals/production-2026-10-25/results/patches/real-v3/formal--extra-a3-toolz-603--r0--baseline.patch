@@ -1,4 +1,5 @@
 import itertools
+import pytest
 from itertools import starmap
 from toolz.utils import raises
 from functools import partial
@@ -356,6 +357,66 @@ def test_partition_all():
     assert list(partition_all(4, iter([obj]*7))) == result
 
 
+@pytest.mark.parametrize('n', [1, 2, 3, 8])
+@pytest.mark.parametrize('actual_length, reported_length', [
+    (0, 1), (1, 0), (1, 2), (4, 3), (4, 5),
+    (5, 4), (5, 6), (5, 1), (5, 9),
+])
+def test_partition_all_inconsistent_length(n, actual_length, reported_length):
+    class WrongLength:
+        def __iter__(self):
+            return iter(range(actual_length))
+
+        def __len__(self):
+            return reported_length
+
+    with pytest.raises(LookupError):
+        list(partition_all(n, WrongLength()))
+
+
+@pytest.mark.parametrize('n', [1, 2, 3, 8])
+@pytest.mark.parametrize('length', range(9))
+def test_partition_all_valid_lengths(n, length):
+    items = list(range(length))
+    expected = [tuple(items[i:i + n]) for i in range(0, length, n)]
+    assert list(partition_all(n, items)) == expected
+    assert list(partition_all(n, tuple(items))) == expected
+    assert list(partition_all(n, range(length))) == expected
+    assert list(partition_all(n, iter(items))) == expected
+
+    class SizedIterator:
+        def __init__(self):
+            self.items = iter(items)
+            self.remaining = length
+
+        def __iter__(self):
+            return self
+
+        def __len__(self):
+            return self.remaining
+
+        def __next__(self):
+            item = next(self.items)
+            self.remaining -= 1
+            return item
+
+    assert list(partition_all(n, SizedIterator())) == expected
+
+
+def test_partition_all_padding_values():
+    from toolz.itertoolz import no_pad
+
+    items = [None, no_pad, no_pad]
+    expected = [(None, no_pad), (no_pad,)]
+    assert list(partition_all(2, items)) == expected
+    assert list(partition_all(2, iter(items))) == expected
+
+
+def test_partition_all_infinite_iterator():
+    chunks = partition_all(2, itertools.count())
+    assert list(itertools.islice(chunks, 3)) == [(0, 1), (2, 3), (4, 5)]
+
+
 def test_count():
     assert count((1, 2, 3)) == 3
     assert count([]) == 0
