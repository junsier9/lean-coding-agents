@@ -110,3 +110,33 @@ def test_bits():
             ).as_int()
         ),
         Bits('101'))
+
+
+@mark.parametrize('width', [0, 1, 2, 8, 64])
+def test_bits_rejects_overflow(width):
+    for value in (2 ** width, 2 ** width + 1):
+        with raises(ValueError, match=f'value {value} cannot be represented with {width} bits'):
+            Bits(value, width)
+
+
+@mark.parametrize('width', [1, 2, 8, 64])
+def test_bits_accepts_maximum_value(width):
+    value = 2 ** width - 1
+    bits = Bits(value, width)
+    assert bits.as_int() == value
+    assert bits.as_bin() == '1' * width
+    assert len(bits) == len(bits.as_bin()) == width
+
+
+@mark.parametrize('value, expected', [
+    (0, '0'),
+    (1, '1'),
+    (4, '100'),
+    (256, '100000000'),
+    (2 ** 64, '1' + '0' * 64),
+])
+def test_bits_infers_width(value, expected):
+    bits = Bits(value)
+    assert bits.as_int() == value
+    assert bits.as_bin() == expected
+    assert len(bits) == len(expected)
