+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("caf\u00e9 \u4e2d\u6587 \U0001f600", "caf\u00e9 \u4e2d\u6587 \U0001f600"),
+        ("\ud800", r"\ud800"),
+        ("\udfff", r"\udfff"),
+        ("\ud83d\ude00", r"\ud83d\ude00"),
+        (
+            "\u4e2d\u6587\ud800 caf\u00e9\udfff\U0001f600",
+            "\u4e2d\u6587\\ud800 caf\u00e9\\udfff\U0001f600",
+        ),
+    ],
+)
+def test_unicode_output(rootlogger: TagTracer, value: str, expected: str) -> None:
+    out: list[bytes] = []
+    processed = []
+    extra = {value: value}
+    rootlogger.setwriter(lambda message: out.append(message.encode("utf-8")))
+    rootlogger.setprocessor((value,), lambda *args: processed.append(args))
+
+    rootlogger.get(value)(value, extra)
+
+    assert out == [
+        f"{expected} [{expected}]\n    {expected}: {expected}\n".encode("utf-8")
+    ]
+    assert processed == [((value,), (value, extra))]
+    assert processed[0][1][1] is extra
+
+
+@pytest.mark.parametrize("location", ["content", "key", "value", "nested"])
+def test_unprintable_output(rootlogger: TagTracer, location: str) -> None:
+    value = Unprintable()
+    out: list[str] = []
+    rootlogger.setwriter(out.append)
+
+    if location == "content":
+        rootlogger.get("test")(value)
+        expected = "<unprintable> [test]\n"
+    elif location == "key":
+        rootlogger.get("test")("message", {value: 1})
+        expected = "message [test]\n    <unprintable>: 1\n"
+    elif location == "value":
+        rootlogger.get("test")("message", {"key": value})
+        expected = "message [test]\n    key: <unprintable>\n"
+    else:
+        rootlogger.get("test")([value])
+        expected = "<unprintable> [test]\n"
+
+    assert out == [expected]
+
+
+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize("location", ["argument", "result"])
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (
+            "\u4e2d\u6587\ud800 caf\u00e9\udfff\U0001f600",
+            "\u4e2d\u6587\\ud800 caf\u00e9\\udfff\U0001f600",
+        ),
+        pytest.param(Unprintable(), "<unprintable>", id="unprintable"),
+    ],
+)
+def test_plugin_tracing_unsafe_values(
+    pm: PluginManager,
+    firstresult: bool,
+    location: str,
+    value: object,
+    expected: str,
+) -> None:
+    class Api:
+        @hookspec(firstresult=firstresult)
+        def hello(self, arg: object) -> object: ...
+
+    argument = value if location == "argument" else "argument"
+    result_value = value if location == "result" else "result"
+    calls = []
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg: object) -> object:
+            calls.append(arg)
+            return result_value
+
+    pm.add_hookspecs(Api)
+    pm.register(Plugin())
+    trace_out: list[str] = []
+
+    def writer(message: str) -> None:
+        message.encode("utf-8")
+        trace_out.append(message)
+
+    pm.trace.root.setwriter(writer)
+    undo = pm.enable_tracing()
+    try:
+        result = pm.hook.hello(arg=argument)
+        if firstresult:
+            assert result is result_value
+        else:
+            assert len(result) == 1
+            assert result[0] is result_value
+        assert len(calls) == 1
+        assert calls[0] is argument
+        assert len(trace_out) == 2
+        message = trace_out[0 if location == "argument" else 1]
+        assert expected in message
+        assert pm.trace.root.indent == 0
+    finally:
+        undo()
+
+
+@pytest.mark.parametrize(
+    "exception_type", [KeyboardInterrupt, SystemExit, GeneratorExit]
+)
+@pytest.mark.parametrize("location", ["argument", "result", "hook"])
+def test_plugin_tracing_interrupts(
+    pm: PluginManager, exception_type: type[BaseException], location: str
+) -> None:
+    exception = exception_type()
+
+    class Interrupting:
+        def __str__(self) -> str:
+            raise exception
+
+        __repr__ = __str__
+
+    value = Interrupting()
+    calls = []
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg: object) -> object:
+            calls.append(arg)
+            if location == "hook":
+                raise exception
+            return value if location == "result" else arg
+
+    pm.register(Plugin())
+    pm.trace.root.setwriter(lambda message: message.encode("utf-8"))
+    pm.trace.root.indent = 2
+    undo = pm.enable_tracing()
+    try:
+        with pytest.raises(exception_type) as excinfo:
+            pm.hook.hello(arg=value if location == "argument" else "argument")
+        assert excinfo.value is exception
+        assert len(calls) == (0 if location == "argument" else 1)
+        assert pm.trace.root.indent == 2
+    finally:
+        undo()
+
+
