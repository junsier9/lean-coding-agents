+    def test_negative(self):
+        for n, strict, value in product((-1, -3), (False, True), ('', 'ABCDE')):
+            with self.subTest(n=n, strict=strict, value=value):
+                iterable = iter(value)
+                with self.assertRaisesRegex(
+                    ValueError, '^n must be at least 0$'
+                ):
+                    list(mi.chunked(iterable, n, strict=strict))
+                self.assertEqual(list(iterable), list(value))
+
+    def test_zero(self):
+        for strict, value in product((False, True), ('', 'ABCDE')):
+            with self.subTest(strict=strict, value=value):
+                iterable = iter(value)
+                self.assertEqual(
+                    list(mi.chunked(iterable, 0, strict=strict)), []
+                )
+                self.assertEqual(list(iterable), list(value))
