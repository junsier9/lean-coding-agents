+@pytest.mark.parametrize('error', [None, AttributeError('cannot delete'), ValueError('failed')])
+def test_wrap_prop_delete(error):
+    calls = []
+
+    class Manager:
+        def __enter__(self):
+            calls.append('enter')
+
+        def __exit__(self, exc_type, exc, tb):
+            calls.append(('exit', exc))
+
+    class A(object):
+        def __init__(self):
+            self.value = 1
+
+        @property
+        def prop(self):
+            return self.value
+
+        @prop.deleter
+        def prop(self):
+            calls.append('delete')
+            if error is not None:
+                raise error
+            del self.value
+
+        prop = wrap_prop(Manager())(prop)
+
+    a = A()
+    if error is None:
+        del a.prop
+        assert 'value' not in a.__dict__
+    else:
+        with pytest.raises(type(error)) as exc_info:
+            del a.prop
+        assert exc_info.value is error
+        assert a.value == 1
+    assert calls == ['enter', 'delete', ('exit', error)]
+
 
