+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('nested', [False, True])
+@pytest.mark.parametrize('failure', ['builder', 'generator'])
+def test_lookuper_retries_failed_initialization(deco, nested, failure):
+    attempts = []
+    error = RuntimeError('table initialization failed')
+
+    def broken_pairs():
+        yield 'partial', len(attempts)
+        raise error
+
+    def build_table():
+        attempts.append(None)
+        if len(attempts) < 3:
+            if failure == 'builder':
+                raise error
+            return broken_pairs()
+        return {'ready': 42}
+
+    if nested:
+        tables = deco(lambda name: build_table())
+        lookup = tables('example')
+        assert tables('example') is lookup
+    else:
+        lookup = deco(build_table)
+
+    assert attempts == []
+    for attempt in (1, 2):
+        with pytest.raises(RuntimeError) as exc_info:
+            lookup('partial')
+        assert exc_info.value is error
+        assert len(attempts) == attempt
+
+    assert lookup('ready') == 42
+    if deco is silent_lookuper:
+        assert lookup('partial') is None
+    else:
+        with pytest.raises(LookupError):
+            lookup('partial')
+    assert lookup('ready') == 42
+    assert len(attempts) == 3
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('nested', [False, True])
+@pytest.mark.parametrize('empty_table', [dict, lambda: iter(())], ids=['dict', 'iterator'])
+def test_lookuper_initializes_empty_table_once(deco, nested, empty_table):
+    attempts = []
+
+    def build_table():
+        attempts.append(None)
+        return empty_table()
+
+    if nested:
+        tables = deco(lambda name: build_table())
+        lookup = tables('example')
+        assert tables('example') is lookup
+    else:
+        lookup = deco(build_table)
+
+    assert attempts == []
+    for key in ('missing', 'another', 'missing'):
+        if deco is silent_lookuper:
+            assert lookup(key) is None
+        else:
+            with pytest.raises(LookupError):
+                lookup(key)
+    assert len(attempts) == 1
+
+
