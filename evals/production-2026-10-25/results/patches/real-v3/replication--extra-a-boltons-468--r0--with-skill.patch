-from pytest import raises
+from pytest import mark, raises
 from boltons.mathutils import clamp, ceil, floor, Bits
 import math
 
@@ -127,3 +127,89 @@ def test_bits_len_bound():
         Bits(4, 2)
     with raises(ValueError):
         Bits(1, 0)
+
+
+@mark.parametrize('value, width', [('', None), (b'', None), ([], None), (0, 0)])
+def test_bits_empty(value, width):
+    bits = Bits(value, width)
+    assert len(bits) == 0
+    assert bits.as_int() == 0
+    assert bits.as_bin() == ''
+    assert bits.as_hex() == ''
+    assert bits.as_bytes() == b''
+    assert bits.as_list() == []
+    assert list(bits) == []
+    assert repr(bits) == "Bits('')"
+    assert bits != Bits(0)
+    assert Bits.from_int(bits.as_int(), len(bits)) == bits
+    assert Bits.from_bin(bits.as_bin()) == bits
+    assert Bits.from_bin(bits.as_bin().encode('ascii')) == bits
+    assert Bits.from_list(bits.as_list()) == bits
+    assert Bits.from_hex(bits.as_hex()) == bits
+    assert Bits.from_hex(bits.as_hex().encode('ascii')) == bits
+    assert Bits.from_bytes(bits.as_bytes()) == bits
+    for index in (0, -1):
+        with raises(IndexError):
+            bits[index]
+
+
+@mark.parametrize('value, selection', [
+    ('', slice(None)),
+    ('', slice(None, None, -1)),
+    ('101', slice(1, 1)),
+    ('101', slice(3, None)),
+    ('101', slice(2, 0)),
+])
+def test_bits_empty_slice(value, selection):
+    bits = Bits(value)[selection]
+    assert bits == Bits(0, 0)
+    assert bits[:] == bits
+    assert bits.as_bin() == ''
+    assert bits.as_list() == []
+    assert bits.as_hex() == ''
+    assert bits.as_bytes() == b''
+
+
+@mark.parametrize('binary, hex_, bytes_', [
+    ('0', '00', b'\x00'),
+    ('1', '01', b'\x01'),
+    ('0000101', '05', b'\x05'),
+    ('11111111', 'FF', b'\xff'),
+    ('000000000', '0000', b'\x00\x00'),
+    ('100000000', '0100', b'\x01\x00'),
+])
+def test_bits_serialization(binary, hex_, bytes_):
+    bits = Bits(binary)
+    assert len(bits) == len(binary)
+    assert bits.as_bin() == binary
+    assert bits.as_hex() == hex_
+    assert bits.as_bytes() == bytes_
+    assert Bits.from_hex(hex_) == Bits.from_bytes(bytes_)
+    assert Bits.from_hex(hex_).as_int() == bits.as_int()
+
+
+@mark.parametrize('value', ['0x', '0xGG', '102', ' '])
+def test_bits_invalid_string(value):
+    with raises(ValueError):
+        Bits(value)
+
+
+@mark.parametrize('value', ['0x', b'0x', 'GG', ' '])
+def test_bits_invalid_hex(value):
+    with raises(ValueError):
+        Bits.from_hex(value)
+
+
+def test_bits_invalid_conversion_inputs():
+    with raises(ValueError, match='negative values'):
+        Bits(-1)
+    with raises(TypeError, match='initialized with bad type'):
+        Bits(None)
+    with raises(UnicodeDecodeError):
+        Bits(b'\xff')
+    with raises(UnicodeDecodeError):
+        Bits.from_hex(b'\xff')
+    with raises(AttributeError):
+        Bits.from_hex(None)
+    with raises(TypeError):
+        Bits.from_bytes('')
