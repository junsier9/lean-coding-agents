@@ -42,6 +42,29 @@ class RemoveEntitiesTest(unittest.TestCase):
         self.assertEqual(replace_entities('x&#153;y', encoding='cp1252'), u'x\u2122y')
         self.assertEqual(replace_entities('x&#x99;y', encoding='cp1252'), u'x\u2122y')
 
+    def test_invalid_windows1252_entities(self):
+        # These bytes have no character mapping in Windows-1252.
+        for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):
+            for entity in ('&#%d;' % number, '&#x%x;' % number,
+                           '&#X%X;' % number):
+                text = u'\u00a3%s&amp;&#153;' % entity
+                for source in (text, text.encode('utf-8')):
+                    self.assertEqual(replace_entities(source), u'\u00a3&\u2122')
+                    self.assertEqual(replace_entities(source, remove_illegal=True),
+                                     u'\u00a3&\u2122')
+                    self.assertEqual(replace_entities(source, remove_illegal=False),
+                                     u'\u00a3%s&\u2122' % entity)
+
+    def test_invalid_windows1252_entities_without_semicolon(self):
+        for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):
+            for entity in ('&#%d' % number, '&#x%x' % number,
+                           '&#X%X' % number):
+                text = u'x%sy' % entity
+                for source in (text, text.encode('ascii')):
+                    self.assertEqual(replace_entities(source), text)
+                    self.assertEqual(replace_entities(source, remove_illegal=True), text)
+                    self.assertEqual(replace_entities(source, remove_illegal=False), text)
+
