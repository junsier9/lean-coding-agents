+@pytest.mark.parametrize('n', [1, 2, 3, 5])
+@pytest.mark.parametrize('actual_length, reported_length', [
+    (0, 1), (1, 0), (1, 2),
+    (4, 0), (4, 1), (4, 2), (4, 3),
+    (4, 5), (4, 6), (4, 7), (4, 8),
+    (6, 5), (6, 7), (6, 9),
+])
+def test_partition_all_inconsistent_length(n, actual_length, reported_length):
+    class SizedIterable:
+        def __iter__(self):
+            return iter(range(actual_length))
+
+        def __len__(self):
+            return reported_length
+
+    with pytest.raises(LookupError):
+        list(partition_all(n, SizedIterable()))
+
+
+@pytest.mark.parametrize('seq_factory', [
+    list, tuple, iter, lambda seq: (item for item in seq),
+])
+def test_partition_all_valid_lengths(seq_factory):
+    for n in range(1, 7):
+        for length in range(13):
+            values = list(range(length))
+            expected = [tuple(values[i:i + n])
+                        for i in range(0, length, n)]
+            assert list(partition_all(n, seq_factory(values))) == expected
+
+
+def test_partition_all_padding_value_as_data():
+    from toolz.itertoolz import no_pad
+
+    values = [no_pad, no_pad]
+    assert list(partition_all(5, values)) == [(no_pad, no_pad)]
+    assert list(partition_all(5, iter(values))) == [(no_pad, no_pad)]
+
+
+def test_partition_all_infinite_iterator():
+    chunks = partition_all(3, itertools.count())
+    assert next(chunks) == (0, 1, 2)
+    assert next(chunks) == (3, 4, 5)
+
+
+def test_partition_all_inconsistent_length_before_tail():
+    class SizedIterable:
+        def __iter__(self):
+            return iter(range(5))
+
+        def __len__(self):
+            return 4
+
+    chunks = partition_all(2, SizedIterable())
+    assert next(chunks) == (0, 1)
+    assert next(chunks) == (2, 3)
+    with pytest.raises(LookupError):
+        next(chunks)
+
+
 def test_count():
     assert count((1, 2, 3)) == 3
