@@ -105,6 +105,51 @@ def test_memoize_direct_key_func():
     assert calls == [[1, 2], [1, 2]]
 
 
+@pytest.mark.parametrize('make_decorator', [
+    memoize,
+    lambda **kwargs: cache(60, **kwargs),
+    lambda **kwargs: cache(timedelta(seconds=60), **kwargs),
+], ids=['memoize', 'cache-seconds', 'cache-timedelta'])
+@pytest.mark.parametrize('custom_key', [False, True], ids=['default-key', 'custom-key'])
+def test_memory_decorator_reuse(make_decorator, custom_key):
+    key_func = (lambda value, offset=0: (tuple(value), offset)) if custom_key else None
+    decorate = make_decorator(key_func=key_func)
+    calls = []
+
+    @decorate
+    def first(value, offset=0):
+        calls.append('first')
+        return value[0] + offset
+
+    @decorate
+    def second(value, offset=0):
+        calls.append('second')
+        return value[0] * offset
+
+    value = [2] if custom_key else (2,)
+    assert first(value, offset=3) == 5
+    assert second(value, offset=3) == 6
+    assert first(value, offset=3) == 5
+    assert second(value, offset=3) == 6
+    assert calls == ['first', 'second']
+    assert first.memory is not second.memory
+
+    first.invalidate(value, offset=3)
+    assert first(value, offset=3) == 5
+    assert second(value, offset=3) == 6
+    assert calls == ['first', 'second', 'first']
+
+    second.invalidate_all()
+    assert first(value, offset=3) == 5
+    assert second(value, offset=3) == 6
+    assert calls == ['first', 'second', 'first', 'second']
+
+    first.memory.clear()
+    assert second(value, offset=3) == 6
+    assert first(value, offset=3) == 5
+    assert calls == ['first', 'second', 'first', 'second', 'first']
+
+
