+def test_reused_cache_expiration(monkeypatch):
+    now = [0]
+    monkeypatch.setattr('funcy.calc.time.time', lambda: now[0])
+    decorate = cache(10)
+    calls = []
+
+    @decorate
+    def first(key):
+        calls.append('first')
+        return len(calls)
+
+    @decorate
+    def second(key):
+        calls.append('second')
+        return -len(calls)
+
+    assert first('key') == 1
+    now[0] = 5
+    assert second('key') == -2
+
+    now[0] = 10
+    assert first('key') == 3
+    assert second('key') == -2
+
+    now[0] = 15
+    assert first('key') == 3
+    assert second('key') == -4
+    assert calls == ['first', 'second', 'first', 'second']
+
