     assert "ARG1" in result.output
 
 
+@pytest.mark.parametrize(
+    ("envvar", "help_hint", "error_hint"),
+    [
+        (None, None, ""),
+        ("", None, ""),
+        ([], None, ""),
+        ((), None, ""),
+        ("ARG1", "ARG1", " (env var: 'ARG1')"),
+        (["ARG1"], "ARG1", " (env var: 'ARG1')"),
+        (("ARG1",), "ARG1", " (env var: 'ARG1')"),
+        (["ARG1", "ARG2"], "ARG1, ARG2", " (env var: 'ARG1', 'ARG2')"),
+        (("ARG1", "ARG2"), "ARG1, ARG2", " (env var: 'ARG1', 'ARG2')"),
+    ],
+)
+@pytest.mark.parametrize("show_envvar", [True, False])
+def test_show_envvar_hints(runner, monkeypatch, envvar, help_hint, error_hint, show_envvar):
+    monkeypatch.delenv("ARG1", raising=False)
+    monkeypatch.delenv("ARG2", raising=False)
+    option = click.Option(
+        ["--arg1"], envvar=envvar, show_envvar=show_envvar, required=True, type=int
+    )
+    cmd = click.Command("cmd", params=[option])
+
+    if not show_envvar:
+        help_hint = None
+        error_hint = ""
+
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+
+    if help_hint is None:
+        assert "env var:" not in result.output
+        assert "envvars" not in option.get_help_extra(click.Context(cmd))
+    else:
+        assert f"[env var: {help_hint}; required]" in result.output
+
+    assert option.get_error_hint(None) == f"'--arg1'{error_hint}"
+
+    result = runner.invoke(cmd)
+    assert result.exit_code == 2
+    assert f"Error: Missing option '--arg1'{error_hint}.\n" in result.output
+
+    result = runner.invoke(cmd, ["--arg1", "invalid"])
+    assert result.exit_code == 2
+    assert (
+        f"Error: Invalid value for '--arg1'{error_hint}:"
+        " 'invalid' is not a valid integer.\n"
+    ) in result.output
+
+
+@pytest.mark.parametrize("envvar", [None, "", [], ()])
+@pytest.mark.parametrize("allow_from_autoenv", [True, False])
+def test_show_envvar_empty_auto_prefix(runner, envvar, allow_from_autoenv):
+    @click.command()
+    @click.option(
+        "--arg1",
+        envvar=envvar,
+        show_envvar=True,
+        allow_from_autoenv=allow_from_autoenv,
+    )
+    def cmd(arg1):
+        click.echo(arg1)
+
+    ctx = click.Context(cmd, auto_envvar_prefix="TEST")
+    expected = {"envvars": ("TEST_ARG1",)} if allow_from_autoenv else {}
+    assert cmd.params[0].get_help_extra(ctx) == expected
+
+    result = runner.invoke(cmd, ["--help"], auto_envvar_prefix="TEST")
+    assert result.exit_code == 0
+
+    if allow_from_autoenv:
+        assert "[env var: TEST_ARG1]" in result.output
+    else:
+        assert "env var:" not in result.output
+
+    result = runner.invoke(
+        cmd, auto_envvar_prefix="TEST", env={"TEST_ARG1": "auto value"}
+    )
+    assert result.exit_code == 0
+    assert result.output == ("auto value\n" if allow_from_autoenv else "\n")
+
+
