@@ -1018,6 +1049,41 @@ def test_missing_envvar(runner):
     assert "Error: Missing option '--foo'." in result.output
 
 
+@pytest.mark.parametrize(
+    ("envvar", "expected"),
+    [
+        (None, ""),
+        ("", ""),
+        ([], ""),
+        ((), ""),
+        ("bar", " (env var: 'bar')"),
+        (["bar"], " (env var: 'bar')"),
+        (("bar",), " (env var: 'bar')"),
+        (["bar", "baz"], " (env var: 'bar', 'baz')"),
+        (("bar", "baz"), " (env var: 'bar', 'baz')"),
+    ],
+)
+@pytest.mark.parametrize("show_envvar", [False, True])
+@pytest.mark.parametrize("args", [[], ["--foo", "invalid"]])
+def test_envvar_error_hint(runner, envvar, expected, show_envvar, args):
+    option = click.Option(
+        ["--foo"], envvar=envvar, show_envvar=show_envvar, required=True, type=int
+    )
+    hint = "'--foo'" + (expected if show_envvar else "")
+    assert option.get_error_hint(None) == hint
+
+    cli = click.Command("cli", params=[option])
+    result = runner.invoke(cli, args, env={"bar": None, "baz": None})
+    assert result.exit_code == 2
+    if args:
+        assert (
+            f"Error: Invalid value for {hint}: 'invalid' is not a valid integer."
+            in result.output
+        )
+    else:
+        assert f"Error: Missing option {hint}." in result.output
+
+
