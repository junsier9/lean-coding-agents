@@ -52,6 +52,56 @@ def test_indent():
     assert strutils.indent(to_indent, '  ') == ref
 
 
+@pytest.mark.parametrize('text', [
+    '', 'Jan 28, 2024', 'Feb 29, 2024', ' 28 29 2028 2029 ',
+    '\t \u00a0', r'\u2028\u2029',
+])
+def test_line_operations_preserve_plain_text(text):
+    lines = strutils.iter_splitlines(text)
+    assert iter(lines) is lines
+    assert list(lines) == ([text] if text else [])
+    assert strutils.indent(text, '> ') == ('> ' + text if text else '')
+
+
+@pytest.mark.parametrize('separator', [
+    '\r\n', '\n', '\r', '\v', '\f', '\x85', '\u2028', '\u2029',
+])
+@pytest.mark.parametrize(('template', 'expected'), [
+    ('{sep}', ['', '']),
+    ('{sep}{sep}', ['', '', '']),
+    ('a{sep}b', ['a', 'b']),
+    ('{sep}a{sep}{sep}b{sep}', ['', 'a', '', 'b', '']),
+])
+def test_iter_splitlines_separators(separator, template, expected):
+    assert list(strutils.iter_splitlines(template.format(sep=separator))) == expected
+
+
+def test_line_operations_mixed_newlines():
+    text = ('\r\nJan 28, 2024\u2028\u2029Feb 29, 2024\r'
+            'third\nfourth\v\f\x85last\r\n')
+    assert list(strutils.iter_splitlines(text)) == [
+        '', 'Jan 28, 2024', '', 'Feb 29, 2024', 'third', 'fourth',
+        '', '', 'last', '',
+    ]
+    assert strutils.indent(text, '> ') == (
+        '\n> Jan 28, 2024\n\n> Feb 29, 2024\n> third\n> fourth\n\n\n> last\n'
+    )
+
+
+def test_indent_custom_newline_and_key():
+    seen = []
+
+    def should_indent(line):
+        seen.append(line)
+        return line != 'skip'
+
+    text = '\u2028Jan 28, 2024\r\nskip\u2029'
+    assert strutils.indent(text, '> ', newline='|', key=should_indent) == (
+        '> |> Jan 28, 2024|skip|> '
+    )
+    assert seen == ['', 'Jan 28, 2024', 'skip', '']
+
+
 def test_is_uuid():
     assert strutils.is_uuid(uuid.uuid4()) == True
     assert strutils.is_uuid(uuid.uuid4(), version=1) == False
