+@pytest.mark.parametrize("is_eager", [False, True])
+@pytest.mark.parametrize(
+    ("args", "env", "default_map", "expected", "without_source", "with_source"),
+    [
+        (
+            [],
+            {"XYZ": "0"},
+            None,
+            (False, click.ParameterSource.ENVIRONMENT),
+            click.ParameterSource.DEFAULT,
+            click.ParameterSource.ENVIRONMENT,
+        ),
+        (
+            [],
+            {},
+            None,
+            (True, click.ParameterSource.DEFAULT),
+            click.ParameterSource.DEFAULT,
+            click.ParameterSource.DEFAULT,
+        ),
+        (
+            [],
+            {},
+            {"enable_xyz": False},
+            (False, click.ParameterSource.DEFAULT_MAP),
+            click.ParameterSource.DEFAULT_MAP,
+            click.ParameterSource.DEFAULT_MAP,
+        ),
+        (
+            ["--without-xyz"],
+            {"XYZ": "1"},
+            {"enable_xyz": True},
+            (False, click.ParameterSource.COMMANDLINE),
+            click.ParameterSource.COMMANDLINE,
+            click.ParameterSource.COMMANDLINE,
+        ),
+    ],
+)
+def test_flag_group_parameter_source_during_callbacks(
+    runner, is_eager, args, env, default_map, expected, without_source, with_source
+):
+    seen = {}
+
+    def callback(ctx, param, value):
+        seen[param.opts[0]] = ctx.get_parameter_source(param.name)
+        return value
+
+    @click.command()
+    @click.option("--without-xyz", "enable_xyz", flag_value=False, callback=callback)
+    @click.option(
+        "--with-xyz",
+        "enable_xyz",
+        flag_value=True,
+        default=True,
+        envvar="XYZ",
+        is_eager=is_eager,
+        callback=callback,
+    )
+    @click.pass_context
+    def cli(ctx, enable_xyz):
+        return enable_xyz, ctx.get_parameter_source("enable_xyz")
+
+    result = runner.invoke(
+        cli, args, env=env, default_map=default_map, standalone_mode=False
+    )
+    assert result.exception is None
+    assert seen == {"--without-xyz": without_source, "--with-xyz": with_source}
+    assert result.return_value == expected
+
+
+@pytest.mark.parametrize("resilient_parsing", [False, True])
+def test_flag_group_parameter_source_after_callback_error(runner, resilient_parsing):
+    seen = []
+    error = RuntimeError("callback failed")
+
+    def callback(ctx, param, value):
+        seen.append(ctx.get_parameter_source(param.name))
+        raise error
+
+    @click.command()
+    @click.option("--first", "mode", flag_value="first", is_eager=True, envvar="MODE")
+    @click.option("--second", "mode", flag_value="second", callback=callback)
+    @click.pass_context
+    def cli(ctx, mode):
+        return mode, ctx.get_parameter_source("mode")
+
+    result = runner.invoke(
+        cli,
+        env={"MODE": "first"},
+        resilient_parsing=resilient_parsing,
+        standalone_mode=False,
+    )
+    assert seen == [click.ParameterSource.DEFAULT]
+    if resilient_parsing:
+        assert result.exception is None
+        assert result.return_value == ("first", click.ParameterSource.ENVIRONMENT)
+    else:
+        assert result.exception is error
+
+
