+@pytest.mark.parametrize("is_eager", [False, True])
+@pytest.mark.parametrize("expose_value", [False, True])
+@pytest.mark.parametrize(
+    ("args", "env", "default_map", "expected_value", "expected_source"),
+    [
+        (
+            ["--name", "cli"],
+            {"NAME": "environment"},
+            {"name": "mapped"},
+            "cli",
+            click.ParameterSource.COMMANDLINE,
+        ),
+        (
+            [],
+            {"NAME": "environment"},
+            {"name": "mapped"},
+            "environment",
+            click.ParameterSource.ENVIRONMENT,
+        ),
+        (
+            [],
+            {"AUTO_NAME": "environment"},
+            {"name": "mapped"},
+            "environment",
+            click.ParameterSource.ENVIRONMENT,
+        ),
+        ([], {}, {"name": "mapped"}, "mapped", click.ParameterSource.DEFAULT_MAP),
+        ([], {}, None, "original", click.ParameterSource.DEFAULT),
+    ],
+)
+def test_parameter_source_during_processing(
+    runner, is_eager, expose_value, args, env, default_map, expected_value, expected_source
+):
+    seen = []
+
+    class SourceType(click.ParamType):
+        def convert(self, value, param, ctx):
+            seen.append(("type", value, ctx.get_parameter_source(param.name)))
+            return value
+
+    def callback(ctx, param, value):
+        seen.append(("callback", value, ctx.get_parameter_source(param.name)))
+        return value
+
+    @click.command()
+    @click.option(
+        "--name",
+        default="original",
+        envvar="NAME",
+        type=SourceType(),
+        callback=callback,
+        is_eager=is_eager,
+        expose_value=expose_value,
+    )
+    @click.pass_context
+    def cli(ctx, **params):
+        return params, ctx.get_parameter_source("name")
+
+    result = runner.invoke(
+        cli,
+        args,
+        env=env,
+        default_map=default_map,
+        auto_envvar_prefix="AUTO",
+        standalone_mode=False,
+    )
+    assert result.exception is None
+    assert seen == [
+        ("type", expected_value, expected_source),
+        ("callback", expected_value, expected_source),
+    ]
+    assert result.return_value == (
+        {"name": expected_value} if expose_value else {},
+        expected_source,
+    )
+
+
