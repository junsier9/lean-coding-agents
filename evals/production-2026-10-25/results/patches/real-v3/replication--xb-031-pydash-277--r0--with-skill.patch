+@parametrize("name", ["xor", "xor_by", "xor_with"])
+@parametrize("factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize("values", [[], [1, 2, 1]])
+def test_xor_single_iterable(name, factory, values):
+    expected = values[:]
+    array = factory(values)
+    result = getattr(_, name)(array)
+
+    assert isinstance(result, list)
+    assert result == expected
+    assert result is not array
+    if isinstance(array, list):
+        assert array == expected
+    assert values == expected
+
+
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+@parametrize("array_factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize("other_factory", [list, tuple, iter, lambda values: (value for value in values)])
+def test_xor_mixed_iterables(name, array_factory, other_factory):
+    array = [1, 2, 3, 1]
+    other = [5, 2, 1, 4]
+
+    result = getattr(_, name)(
+        array_factory(array), other_factory(other), (value for value in [3, 6, 6])
+    )
+
+    assert result == [5, 4, 6]
+    assert array == [1, 2, 3, 1]
+    assert other == [5, 2, 1, 4]
+
+
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+@parametrize("factory", [list, tuple, iter, lambda values: (value for value in values)])
+def test_xor_empty_iterables(name, factory):
+    function = getattr(_, name)
+
+    assert function(factory([]), factory([1, 1, 2])) == [1, 2]
+    assert function(factory([1, 1, 2]), factory([])) == [1, 2]
+    assert function(factory([]), factory([])) == []
+
+
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+def test_xor_does_not_modify_lists(name):
+    array = [1, 2, 3, 1]
+    other = [2, 4]
+
+    assert getattr(_, name)(array, other) == [1, 3, 4]
+    assert array == [1, 2, 3, 1]
+    assert other == [2, 4]
+
+
+@parametrize(
+    "name,keyword,callback",
+    [
+        ("xor_by", "iteratee", "id"),
+        ("xor_by", "iteratee", lambda value: value["id"]),
+        ("xor_with", "comparator", lambda left, right: left["id"] == right["id"]),
+    ],
+)
+@parametrize("factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize("positional", [False, True])
+def test_xor_iterables_with_callback(name, keyword, callback, factory, positional):
+    first = {"id": 1}
+    last = {"id": 3}
+    array = [first, {"id": 2}]
+    other = [{"id": 2}, last]
+    function = getattr(_, name)
+
+    if positional:
+        result = function(factory(array), factory(other), callback)
+    else:
+        result = function(factory(array), factory(other), **{keyword: callback})
+
+    assert len(result) == 2
+    assert result[0] is first
+    assert result[1] is last
+    assert array == [{"id": 1}, {"id": 2}]
+    assert other == [{"id": 2}, {"id": 3}]
+
+
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+def test_xor_propagates_iterator_errors(name):
+    def broken_values():
+        yield 2
+        raise ValueError("broken iterable")
+
+    with pytest.raises(ValueError, match="broken iterable"):
+        getattr(_, name)([1], broken_values())
+
+
+@parametrize("name", ["xor_by", "xor_with"])
+def test_xor_propagates_callback_errors(name):
+    def broken_callback(*args):
+        raise ValueError("broken callback")
+
+    with pytest.raises(ValueError, match="broken callback"):
+        getattr(_, name)(iter([1]), iter([1]), broken_callback)
+
+
