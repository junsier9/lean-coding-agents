+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+def test_lookuper_retries_failed_builder(deco):
+    calls = []
+    error = RuntimeError('build failed')
+
+    @deco
+    def lookup():
+        calls.append(1)
+        if len(calls) <= 2:
+            raise error
+        return {'ready': 42}
+
+    assert calls == []
+    for _ in range(2):
+        with pytest.raises(RuntimeError) as exc:
+            lookup('ready')
+        assert exc.value is error
+
+    assert lookup('ready') == 42
+    assert lookup('ready') == 42
+    assert len(calls) == 3
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+def test_lookuper_discards_failed_generator(deco):
+    calls = []
+    error = RuntimeError('iteration failed')
+
+    @deco
+    def lookup():
+        calls.append(1)
+        if len(calls) == 1:
+            yield 'stale', 1
+            raise error
+        yield 'ready', 42
+
+    with pytest.raises(RuntimeError) as exc:
+        lookup('stale')
+    assert exc.value is error
+
+    assert lookup('ready') == 42
+    if deco is silent_lookuper:
+        assert lookup('stale') is None
+    else:
+        with pytest.raises(LookupError, match=r'Failed to look up lookup\(stale\)'):
+            lookup('stale')
+    assert lookup('ready') == 42
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('empty_table', [dict, lambda: iter(())], ids=['dict', 'iterator'])
+def test_lookuper_builds_empty_table_once(deco, empty_table):
+    calls = []
+
+    @deco
+    def lookup():
+        calls.append(1)
+        return empty_table()
+
+    assert calls == []
+    for key in ['missing', 'another']:
+        if deco is silent_lookuper:
+            assert lookup(key) is None
+        else:
+            with pytest.raises(LookupError):
+                lookup(key)
+    assert calls == [1]
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+def test_lookuper_nested_retries_independently(deco):
+    calls = []
+
+    @deco
+    def lookup(group):
+        calls.append(group)
+        if calls == ['first']:
+            raise RuntimeError('build failed')
+        return {'key': group}
+
+    first = lookup('first')
+    second = lookup('second')
+    assert calls == []
+    with pytest.raises(RuntimeError, match='build failed'):
+        first('key')
+
+    assert second('key') == 'second'
+    assert lookup('first') is first
+    assert first('key') == 'first'
+    assert lookup('second') is second
+    assert second('key') == 'second'
+    assert calls == ['first', 'second', 'first']
+
+
