+@pytest.mark.parametrize("unregister_by", ["plugin", "name", "blocked"])
+def test_unregister_multiple_implementations(
+    pm: PluginManager, unregister_by: str
+) -> None:
+    class Plugin:
+        def __init__(self, value):
+            self.value = value
+
+        @hookimpl
+        def he_method1(self):
+            return self.value
+
+        @hookimpl(specname="he_method1")
+        def another_method1(self):
+            return self.value + 1
+
+        @hookimpl(specname="he_method1", wrapper=True)
+        def wrap_method1(self):
+            return (yield)
+
+        @hookimpl(specname="he_method1", hookwrapper=True)
+        def old_wrap_method1(self):
+            yield
+
+        @hookimpl
+        def he_method2(self):
+            return self.value + 2
+
+    plugin, other = Plugin(10), Plugin(20)
+    pm.register(plugin, "plugin")
+    pm.register(other, "other")
+    assert pm.hook.he_method1() == [20, 21, 10, 11]
+    assert pm.hook.he_method2() == [22, 12]
+    other_impls = [
+        impl for impl in pm.hook.he_method1.get_hookimpls() if impl.plugin is other
+    ]
+
+    if unregister_by == "plugin":
+        assert pm.unregister(plugin) is plugin
+    elif unregister_by == "name":
+        assert pm.unregister(name="plugin") is plugin
+    else:
+        pm.set_blocked("plugin")
+        assert pm.is_blocked("plugin")
+        assert pm.register(plugin, "plugin") is None
+
+    assert not pm.is_registered(plugin)
+    assert pm.get_hookcallers(plugin) is None
+    assert pm.get_plugin("plugin") is None
+    assert pm.get_plugin("other") is other
+    assert pm.hook.he_method1.get_hookimpls() == other_impls
+    assert pm.hook.he_method1() == [20, 21]
+    assert pm.hook.he_method2() == [22]
+    with pytest.raises(ValueError, match="not found"):
+        pm.hook.he_method1._remove_plugin(plugin)
+    assert pm.hook.he_method1.get_hookimpls() == other_impls
+
+
