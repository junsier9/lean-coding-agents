+def test_duplicates_passes_index_to_iteratee():
+    assert _.duplicates(["a", "b", "c", "d", "e", "c"], lambda value, index: index % 2) == [
+        "c",
+        "d",
+        "e",
+    ]
+
+
+@parametrize("sequence_type", [list, tuple])
+def test_duplicates_passes_original_values_and_collection_to_iteratee(sequence_type):
+    records = sequence_type(
+        [
+            {"group": ["a"], "id": "first-a"},
+            {"group": ["b"], "id": "first-b"},
+            {"group": ["a"], "id": "second-a"},
+            {"group": ["b"], "id": "second-b"},
+        ]
+    )
+    calls = []
+
+    def iteratee(value, index, collection):
+        assert collection is records
+        assert value is records[index]
+        calls.append(index)
+        return value["group"]
+
+    result = _.duplicates(records, iteratee)
+
+    assert calls == [0, 1, 2, 3]
+    assert result == [records[2], records[3]]
+    assert result[0] is records[2]
+    assert result[1] is records[3]
+
+
+def test_duplicates_supports_zero_argument_iteratee():
+    assert _.duplicates([1, 2, 1, 3], lambda: "same") == [2, 1, 3]
+
+
+def test_duplicates_passes_all_arguments_to_variadic_iteratee():
+    records = [1, 2, 3, 4]
+    calls = []
+
+    def iteratee(*args):
+        calls.append(args)
+        return args[0] % 2
+
+    assert _.duplicates(records, iteratee) == [3, 4]
+    assert len(calls) == len(records)
+    for index, (value, key, collection) in enumerate(calls):
+        assert value == records[index]
+        assert key == index
+        assert collection is records
+
+
+def test_duplicates_propagates_iteratee_errors_without_retry():
+    calls = []
+    error = TypeError("iteratee failed")
+
+    def iteratee(value, index, collection):
+        calls.append(index)
+        raise error
+
+    with pytest.raises(TypeError) as exc_info:
+        _.duplicates([1, 2, 3], iteratee)
+
+    assert exc_info.value is error
+    assert calls == [0]
+
+
