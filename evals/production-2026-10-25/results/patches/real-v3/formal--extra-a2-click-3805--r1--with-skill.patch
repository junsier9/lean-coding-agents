@@ -1,6 +1,12 @@
+import copy
+import pickle
 from decimal import Decimal
 from fractions import Fraction
 
+import pytest
+
+import click
+from click._utils import Sentinel
 from click._utils import UNSET
 
 
@@ -50,3 +56,48 @@ def test_unset_sentinel():
         assert value is not real_value
 
     assert value not in real_values
+
+
+@pytest.mark.parametrize("sentinel", Sentinel)
+@pytest.mark.parametrize("copier", [copy.copy, copy.deepcopy])
+def test_sentinel_copy(sentinel, copier):
+    assert copier(sentinel) is sentinel
+
+
+@pytest.mark.parametrize("sentinel", Sentinel)
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_sentinel_pickle(sentinel, protocol):
+    assert pickle.loads(pickle.dumps(sentinel, protocol=protocol)) is sentinel
+
+
+@pytest.mark.parametrize(
+    "round_trip",
+    [
+        pytest.param(copy.copy, id="copy"),
+        pytest.param(copy.deepcopy, id="deepcopy"),
+        pytest.param(lambda value: pickle.loads(pickle.dumps(value)), id="pickle"),
+    ],
+)
+@pytest.mark.parametrize(
+    ("attrs", "expected"),
+    [
+        ({}, None),
+        ({"is_flag": True}, False),
+        ({"is_flag": True, "multiple": True}, ()),
+        ({"default": "default"}, "default"),
+    ],
+)
+def test_option_round_trip(round_trip, attrs, expected):
+    option = click.Option(["--value"], **attrs)
+    restored = round_trip(option)
+
+    assert restored is not option
+    assert restored.name == option.name == "value"
+    assert restored.opts == ["--value"]
+    assert restored.default == option.default
+    assert restored.flag_value is UNSET
+
+    command = click.Command("cli", params=[restored])
+
+    with command.make_context("cli", []) as ctx:
+        assert ctx.params == {"value": expected}
