diff --git a/tests/test_arrays.py b/tests/test_arrays.py
index b618b3c..033b305 100644
--- a/tests/test_arrays.py
+++ b/tests/test_arrays.py
@@ -1084,6 +1084,75 @@ def test_xor_with_multiple_arrays(arrays, expected):
     assert _.xor_with(*arrays, comparator=comparator) == expected
 
 
+XOR_ITERABLE_FACTORIES = [list, tuple, iter, lambda values: (value for value in values)]
+
+
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+@parametrize("factory", XOR_ITERABLE_FACTORIES, ids=["list", "tuple", "iterator", "generator"])
+@parametrize("values", [[], [3, 1, 3]])
+def test_xor_single_iterable_returns_new_list(name, factory, values):
+    array = factory(values)
+    result = getattr(_, name)(array)
+
+    assert result == values
+    assert isinstance(result, list)
+    assert result is not array
+    if isinstance(array, list):
+        assert array == values
+
+
+@parametrize("name", ["xor", "xor_by", "xor_with"])
+@parametrize("first_factory", XOR_ITERABLE_FACTORIES)
+@parametrize("other_factory", XOR_ITERABLE_FACTORIES)
+@parametrize(
+    "arrays,expected",
+    [
+        (([1, 2, 2, 3], [2, 4, 4]), [1, 3, 4]),
+        (([1, 2, 5], [2, 3, 5], [3, 4, 5]), [1, 4, 5]),
+        (([], [3, 1, 3]), [3, 1]),
+        (([3, 1, 3], []), [3, 1]),
+        (([], []), []),
+    ],
+)
+def test_xor_accepts_mixed_iterables(name, first_factory, other_factory, arrays, expected):
+    sources = [first_factory(arrays[0])] + [other_factory(values) for values in arrays[1:]]
+
+    assert getattr(_, name)(*sources) == expected
+    for source, values in zip(sources, arrays):
+        if isinstance(source, list):
+            assert source == values
+
+
+@parametrize(
+    "name,keyword,callback",
+    [
+        ("xor_by", "iteratee", "id"),
+        ("xor_by", "iteratee", lambda value: value["id"]),
+        ("xor_with", "comparator", lambda left, right: left["id"] == right["id"]),
+    ],
+)
+@parametrize("factory", XOR_ITERABLE_FACTORIES, ids=["list", "tuple", "iterator", "generator"])
+@parametrize("positional", [False, True])
+def test_xor_iterables_preserve_callbacks_and_references(name, keyword, callback, factory, positional):
+    first = {"id": 1}
+    second = {"id": 2}
+    third = {"id": 3}
+    arrays = [[first, second, first], [{"id": 2, "name": "updated"}, third], [{"id": 1}]]
+    sources = [factory(values) for values in arrays]
+    function = getattr(_, name)
+
+    if positional:
+        result = function(*sources, callback)
+    else:
+        result = function(*sources, **{keyword: callback})
+
+    assert result == [third]
+    assert result[0] is third
+    for source, values in zip(sources, arrays):
+        if isinstance(source, list):
+            assert source == values
+
+
