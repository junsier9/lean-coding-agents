+@pytest.mark.parametrize('callpoint_type', [Callpoint, ContextualCallpoint])
+def test_callpoint_to_dict_json(callpoint_type):
+    marker = 'diagnostic value'
+    callpoint = callpoint_type.from_current()
+    deferred_line = callpoint.line
+    assert not hasattr(deferred_line, '_line')
+
+    data = callpoint.to_dict()
+
+    assert json.loads(json.dumps(data)) == data
+    assert data['line'] == '    callpoint = callpoint_type.from_current()'
+    assert callpoint.line is deferred_line
+    for field in ('func_name', 'lineno', 'module_name', 'module_path', 'lasti'):
+        assert data[field] == getattr(callpoint, field)
+    if callpoint_type is ContextualCallpoint:
+        assert data['locals']['marker'] == repr(marker)
+        assert data['pre_lines'][-1]['line'] == "    marker = 'diagnostic value'"
+        assert data['post_lines'][0]['line'] == '    deferred_line = callpoint.line'
+
+
+@pytest.mark.parametrize('line', [None, '', u'    print("源码")'])
+def test_callpoint_to_dict_explicit_line(line):
+    callpoint = Callpoint('example', 'example.py', 'func', 3, 12, line=line)
+    data = callpoint.to_dict()
+
+    assert data == {'module_name': 'example', 'module_path': 'example.py',
+                    'func_name': 'func', 'lineno': 3, 'lasti': 12, 'line': line}
+    assert json.loads(json.dumps(data)) == data
+    assert callpoint.line == line
+
+
+@pytest.mark.parametrize('info_type', [ExceptionInfo, ContextualExceptionInfo])
+def test_exception_info_to_dict_json(info_type):
+    try:
+        raise ValueError('diagnostic failure')
+    except ValueError:
+        info = info_type.from_current()
+
+    data = info.to_dict()
+
+    assert json.loads(json.dumps(data)) == data
+    assert data['exc_type'] == 'ValueError'
+    assert data['exc_msg'] == 'diagnostic failure'
+    assert len(data['exc_tb']['frames']) == 1
+    assert data['exc_tb']['frames'][0]['line'] == (
+        "        raise ValueError('diagnostic failure')")
+
+
+def test_callpoint_to_dict_missing_source():
+    namespace = {'Callpoint': Callpoint}
+    code = compile('callpoint = Callpoint.from_current()',
+                   '<missing-source>', 'exec')
+    exec(code, namespace)
+    data = namespace['callpoint'].to_dict()
+
+    assert data['line'] == ''
+    assert data['module_path'] == '<missing-source>'
+    assert json.loads(json.dumps(data)) == data
+
+
+def test_callpoint_to_dict_source_error(monkeypatch):
+    def fail_getline(*args):
+        raise RuntimeError('source lookup failed')
+
+    callpoint = Callpoint.from_current()
+    with monkeypatch.context() as patch:
+        patch.setattr('linecache.getline', fail_getline)
+        with pytest.raises(RuntimeError, match='source lookup failed'):
+            callpoint.to_dict()
+
+
 
