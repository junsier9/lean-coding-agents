+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('nested', [False, True], ids=['direct', 'nested'])
+def test_lookuper_retries_failed_build(deco, nested):
+    calls = []
+    error = RuntimeError('lookup table unavailable')
+
+    def build():
+        calls.append(None)
+        if len(calls) < 3:
+            raise error
+        return {'ready': 42, 'none': None}
+
+    lookup = deco(lambda group: build())('group') if nested else deco(build)
+    assert calls == []
+
+    for attempt in range(1, 3):
+        with pytest.raises(RuntimeError) as raised:
+            lookup('ready')
+        assert raised.value is error
+        assert len(calls) == attempt
+
+    assert lookup('ready') == 42
+    assert lookup('ready') == 42
+    assert lookup('none') is None
+    assert len(calls) == 3
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('nested', [False, True], ids=['direct', 'nested'])
+def test_lookuper_discards_failed_build(deco, nested):
+    calls = []
+    error = RuntimeError('lookup table interrupted')
+
+    def build():
+        calls.append(None)
+        if len(calls) == 1:
+            yield 'stale', 1
+            raise error
+        yield 'fresh', 2
+
+    lookup = deco(lambda group: build())('group') if nested else deco(build)
+    with pytest.raises(RuntimeError) as raised:
+        lookup('stale')
+    assert raised.value is error
+    assert len(calls) == 1
+
+    # Looking up a partially yielded key must retry, then use only the new table.
+    if deco is silent_lookuper:
+        assert lookup('stale') is None
+    else:
+        with pytest.raises(LookupError):
+            lookup('stale')
+    assert lookup('fresh') == 2
+    assert lookup('fresh') == 2
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('nested', [False, True], ids=['direct', 'nested'])
+@pytest.mark.parametrize('empty_table', [dict, lambda: iter(())], ids=['dict', 'iterator'])
+def test_lookuper_empty_table_initialized_once(deco, nested, empty_table):
+    calls = []
+
+    def build():
+        calls.append(None)
+        return empty_table()
+
+    lookup = deco(lambda group: build())('group') if nested else deco(build)
+    assert calls == []
+    for key in ['missing', 'other', 'missing']:
+        if deco is silent_lookuper:
+            assert lookup(key) is None
+        else:
+            with pytest.raises(LookupError):
+                lookup(key)
+    assert len(calls) == 1
+
+
