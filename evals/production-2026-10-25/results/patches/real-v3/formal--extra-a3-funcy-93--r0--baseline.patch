+def test_cache_invalidate_idempotent():
+    calls = []
+
+    @cache(timeout=60)
+    def inc(x):
+        calls.append(x)
+        return x + 1
+
+    assert inc.invalidate(0) is None
+    assert inc.invalidate(0) is None
+    assert calls == []
+
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert inc.invalidate(0) is None
+    assert inc.invalidate(0) is None
+    assert calls == [0, 1]
+    assert inc(1) == 2
+    assert inc(0) == 1
+    assert inc(0) == 1
+    assert calls == [0, 1, 0]
+
+
+def test_cache_invalidate_key_func():
+    calls = []
+
+    @cache(timeout=60, key_func=lambda x, by=1: x)
+    def mul(x, by=1):
+        calls.append((x, by))
+        return x * by
+
+    assert mul(2, by=3) == 6
+    assert mul(2, by=4) == 6
+    assert mul.invalidate(x=2, by=4) is None
+    assert mul.invalidate(x=2, by=4) is None
+    assert mul(2, by=4) == 8
+    assert mul(2, by=4) == 8
+    assert calls == [(2, 3), (2, 4)]
+
+
+def test_cache_invalidate_all():
+    calls = []
+
+    @cache(timeout=60)
+    def inc(x):
+        calls.append(x)
+        return x + 1
+
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert inc.invalidate_all() is None
+    assert inc.invalidate_all() is None
+    assert inc.invalidate(0) is None
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert calls == [0, 1, 0, 1]
+
+
