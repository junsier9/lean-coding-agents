+@pytest.mark.parametrize('args, kwargs', [
+    ((1, 2), {}),
+    ((1,), {'y': 2}),
+    ((), {'x': 1, 'y': 2}),
+])
+@pytest.mark.parametrize('key_func', [None, lambda x, y: x + y])
+def test_cache_invalidate_idempotent(args, kwargs, key_func):
+    calls = []
+
+    @cache(timeout=60, key_func=key_func)
+    def add(x, y):
+        calls.append((x, y))
+        return x + y
+
+    assert add.invalidate(*args, **kwargs) is None
+    assert add.invalidate(*args, **kwargs) is None
+    assert calls == []
+
+    assert add(3, 4) == 7
+    assert add(*args, **kwargs) == 3
+    assert add(*args, **kwargs) == 3
+    assert calls == [(3, 4), (1, 2)]
+
+    assert add.invalidate(*args, **kwargs) is None
+    assert add.invalidate(*args, **kwargs) is None
+    assert calls == [(3, 4), (1, 2)]
+    assert add(3, 4) == 7
+    assert add(*args, **kwargs) == 3
+    assert add(*args, **kwargs) == 3
+    assert calls == [(3, 4), (1, 2), (1, 2)]
+
+
+def test_cache_invalidate_all():
+    calls = []
+
+    @cache(timeout=60)
+    def inc(x):
+        calls.append(x)
+        return x + 1
+
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert inc.invalidate_all() is None
+    assert inc.invalidate_all() is None
+    assert inc.invalidate(0) is None
+    assert calls == [0, 1]
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert calls == [0, 1, 0, 1]
+
+
