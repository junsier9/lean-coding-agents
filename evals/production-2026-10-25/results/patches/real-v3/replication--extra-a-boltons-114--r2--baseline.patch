+@pytest.mark.parametrize('callpoint_type', [Callpoint, ContextualCallpoint])
+def test_callpoint_to_dict_json(callpoint_type):
+    def capture():
+        return callpoint_type.from_current()
+
+    callpoint = capture()
+    deferred_line = callpoint.line
+    assert not hasattr(deferred_line, '_line')
+
+    result = callpoint.to_dict()
+    assert json.loads(json.dumps(result)) == result
+    assert result['line'] == '        return callpoint_type.from_current()'
+    for field in ('func_name', 'lineno', 'module_name', 'module_path', 'lasti'):
+        assert result[field] == getattr(callpoint, field)
+    assert callpoint.line is deferred_line
+
+    if callpoint_type is ContextualCallpoint:
+        assert result['locals'] == callpoint.local_reprs
+        assert result['pre_lines']
+        assert result['post_lines']
+
+
+@pytest.mark.parametrize('line', [None, '', u'    return "caf\u00e9"'])
+def test_callpoint_to_dict_explicit_line(line):
+    callpoint = Callpoint('example', 'example.py', 'example', 1, 0, line=line)
+
+    result = callpoint.to_dict()
+    assert result == {'module_name': 'example', 'module_path': 'example.py',
+                      'func_name': 'example', 'lineno': 1, 'lasti': 0,
+                      'line': line}
+    assert json.loads(json.dumps(result)) == result
+
+
+@pytest.mark.parametrize('exception_info_type',
+                         [ExceptionInfo, ContextualExceptionInfo])
+def test_exception_info_to_dict_json(exception_info_type):
+    def fail():
+        raise ValueError('serialization test')
+
+    try:
+        fail()
+    except ValueError:
+        exc_info = exception_info_type.from_current()
+
+    result = exc_info.to_dict()
+    assert json.loads(json.dumps(result)) == result
+    assert result['exc_type'] == 'ValueError'
+    assert result['exc_msg'] == 'serialization test'
+    frames = result['exc_tb']['frames']
+    assert len(frames) == 2
+    assert frames[0]['line'] == '        fail()'
+    assert frames[1]['line'] == "        raise ValueError('serialization test')"
+    assert frames[1]['func_name'] == 'fail'
+    assert json.loads(json.dumps(exc_info.tb_info.to_dict())) == result['exc_tb']
+
+
 
