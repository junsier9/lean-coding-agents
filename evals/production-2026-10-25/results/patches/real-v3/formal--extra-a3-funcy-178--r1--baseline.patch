+@pytest.mark.parametrize('deco', [once_per('value'), once_per_args],
+                         ids=['once_per', 'once_per_args'])
+@pytest.mark.parametrize('value, equal, different', [
+    ([], [], [1]),
+    ([1, 2], [1, 2], [2, 1]),
+    ({'a': 1, 'b': 2}, {'b': 2, 'a': 1}, {'a': 2, 'b': 2}),
+    ({1, 2}, {2, 1}, {1, 3}),
+    (([1],), ([1],), ([2],)),
+    (({'a': [1]}, {2}), ({'a': [1]}, {2}), ({'a': [2]}, {2})),
+], ids=['empty_list', 'list', 'dict', 'set', 'tuple', 'nested_tuple'])
+def test_once_per_unhashable(deco, value, equal, different):
+    calls = []
+
+    @deco
+    def call(value):
+        calls.append(value)
+        return value
+
+    assert call(value) is value
+    assert call(equal) is None
+    assert call(value=equal) is None
+    assert call(different) is different
+    assert call(value=different) is None
+    assert calls == [value, different]
+
+
+@pytest.mark.parametrize('deco', [once_per('value', 'mode'), once_per_args],
+                         ids=['once_per', 'once_per_args'])
+def test_once_per_unhashable_combinations(deco):
+    calls = []
+
+    @deco
+    def call(value, mode=None):
+        calls.append((value, mode))
+        return len(calls)
+
+    assert call([1]) == 1
+    assert call(mode=None, value=[1]) is None
+    assert call([1], mode={'enabled': True}) == 2
+    assert call(mode={'enabled': True}, value=[1]) is None
+    assert call([2], mode={'enabled': True}) == 3
+    assert call(1) == 4
+    assert call(value=1, mode=None) is None
+    assert calls == [([1], None), ([1], {'enabled': True}),
+                     ([2], {'enabled': True}), (1, None)]
+
+
+@pytest.mark.parametrize('deco', [once_per('value'), once_per_args],
+                         ids=['once_per', 'once_per_args'])
+@pytest.mark.parametrize('value', [1, [1]], ids=['hashable', 'unhashable'])
+def test_once_per_function_type_error(deco, value):
+    calls = []
+
+    @deco
+    def call(value):
+        calls.append(value)
+        raise TypeError('target failure')
+
+    with pytest.raises(TypeError, match='target failure'):
+        call(value)
+    assert call(value) is None
+    assert calls == [value]
+
