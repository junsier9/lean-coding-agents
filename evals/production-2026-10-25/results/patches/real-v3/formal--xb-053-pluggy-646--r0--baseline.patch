+@pytest.mark.parametrize("unregister_by", ["plugin", "name", "blocked"])
+def test_unregister_multiple_implementations(
+    he_pm: PluginManager, unregister_by: str
+) -> None:
+    class Plugin:
+        @hookimpl
+        def he_method1(self):
+            return "target"
+
+        @hookimpl(specname="he_method1")
+        def he_method1_again(self):
+            return "alias"
+
+        @hookimpl(specname="he_method1", hookwrapper=True)
+        def he_method1_hookwrapper(self):
+            yield
+
+        @hookimpl(specname="he_method1", wrapper=True)
+        def he_method1_wrapper(self):
+            return (yield)
+
+    class OtherPlugin:
+        def __init__(self, value: str) -> None:
+            self.value = value
+
+        @hookimpl
+        def he_method1(self):
+            return self.value
+
+    before, after = OtherPlugin("before"), OtherPlugin("after")
+    plugin = Plugin()
+    he_pm.register(before)
+    he_pm.register(plugin, "target")
+    he_pm.register(after)
+    hookcaller = he_pm.hook.he_method1
+    assert hookcaller(arg=1) == ["after", "alias", "target", "before"]
+
+    if unregister_by == "plugin":
+        assert he_pm.unregister(plugin) is plugin
+    elif unregister_by == "name":
+        assert he_pm.unregister(name="target") is plugin
+    else:
+        he_pm.set_blocked("target")
+        assert he_pm.is_blocked("target")
+        assert he_pm.register(plugin, "target") is None
+
+    assert he_pm.get_hookcallers(plugin) is None
+    assert he_pm.get_plugin("target") is None
+    assert not he_pm.is_registered(plugin)
+    assert [impl.plugin for impl in hookcaller.get_hookimpls()] == [before, after]
+    assert hookcaller(arg=1) == ["after", "before"]
+    assert he_pm.get_hookcallers(before) == [hookcaller]
+    assert he_pm.get_hookcallers(after) == [hookcaller]
+
+    with pytest.raises(ValueError, match="not found"):
+        hookcaller._remove_plugin(plugin)
+    assert hookcaller(arg=1) == ["after", "before"]
+
+    if unregister_by == "blocked":
+        assert he_pm.unblock("target")
+    assert he_pm.register(plugin, "target") == "target"
+    assert he_pm.get_hookcallers(plugin) == [hookcaller]
+    assert hookcaller(arg=1) == ["alias", "target", "after", "before"]
+
+
