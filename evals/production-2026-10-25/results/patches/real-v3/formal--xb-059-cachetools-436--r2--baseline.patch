+class ClassAccessTest(unittest.TestCase):
+    def test_class_call(self):
+        for cls in (Cached, Unhashable):
+            for name in (
+                "get",
+                "get_typed",
+                "get_info",
+                "get_lock",
+                "get_lock_info",
+                "get_cond",
+                "get_cond_info",
+                "get_lock_cond",
+                "get_lock_cond_info",
+            ):
+                with self.subTest(cls=cls, method=name):
+                    first = cls(Cache(2))
+                    second = cls(Cache(2), count=10)
+
+                    with warnings.catch_warnings():
+                        warnings.simplefilter("error")
+                        method = getattr(cls, name)
+                        self.assertNotIn(name, first.__dict__)
+                        self.assertEqual(method.__name__, name)
+
+                        # Class access must initialize the same per-instance
+                        # wrapper that subsequent instance access uses.
+                        self.assertEqual(method(first, 0), 0)
+                        bound = getattr(first, name)
+                        self.assertIs(method.__wrapped__, bound.__wrapped__)
+                        self.assertEqual(bound(0), 0)
+                        self.assertEqual(getattr(cls, name)(first, 0), 0)
+                        self.assertEqual(bound(value=1), 1)
+                        self.assertEqual(method(first, value=1), 1)
+
+                        # The same unbound callable can serve another instance,
+                        # including one whose bound wrapper already exists.
+                        other = getattr(second, name)
+                        self.assertEqual(other(0), 10)
+                        self.assertEqual(method(second, 0), 10)
+                        self.assertEqual(method(second, 1), 11)
+                        self.assertEqual(first.count, 2)
+                        self.assertEqual(second.count, 12)
+                        self.assertIsNot(first.cache, second.cache)
+
+                        if name.endswith("_info"):
+                            self.assertEqual(bound.cache_info(), (3, 2, 2, 2))
+                            self.assertEqual(other.cache_info(), (1, 2, 2, 2))
+
+                        bound.cache_clear()
+                        self.assertEqual(len(first.cache), 0)
+                        self.assertEqual(len(second.cache), 2)
+                        if name.endswith("_info"):
+                            self.assertEqual(bound.cache_info(), (0, 0, 2, 0))
+                            self.assertEqual(other.cache_info(), (1, 2, 2, 2))
+
+                        self.assertEqual(method(first, 0), 2)
+                        self.assertEqual(bound(0), 2)
+                        self.assertEqual(method(second, 0), 10)
+                        if name.endswith("_info"):
+                            self.assertEqual(bound.cache_info(), (1, 1, 2, 1))
+                            self.assertEqual(other.cache_info(), (2, 2, 2, 2))
+
+    def test_class_call_typed(self):
+        cached = Cached(Cache(2))
+        method = getattr(Cached, "get_typed")
+
+        self.assertEqual(method(cached, 1), 0)
+        self.assertEqual(cached.get_typed(1), 0)
+        self.assertEqual(method(cached, 1.0), 1)
+        self.assertEqual(cached.get_typed(1.0), 1)
+        self.assertEqual(cached.count, 2)
+
