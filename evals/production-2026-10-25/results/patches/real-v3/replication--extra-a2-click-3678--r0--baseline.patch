+@pytest.mark.parametrize("help_name", ["--help", "--my-help"])
+@pytest.mark.parametrize("param_kind", ["argument", "option", "flag"])
+@pytest.mark.parametrize("value", [0, 42])
+def test_help_option_internal_name_collision(runner, help_name, param_kind, value):
+    name = help_name[2:].replace("-", "_")
+    if param_kind == "argument":
+        param = click.Argument([name], type=int)
+        args = [str(value)]
+        expected = value
+    else:
+        is_flag = param_kind == "flag"
+        param = click.Option(
+            ["--value/--no-value" if is_flag else "--value", name],
+            is_flag=is_flag,
+            type=bool if is_flag else int,
+        )
+        expected = bool(value) if is_flag else value
+        args = (
+            ["--value" if expected else "--no-value"]
+            if is_flag
+            else ["--value", str(value)]
+        )
+
+    @click.command(params=[param], context_settings={"help_option_names": [help_name]})
+    @click.pass_context
+    def cli(ctx, **values):
+        assert values == {name: expected}
+        assert ctx.get_parameter_source(name) is click.core.ParameterSource.COMMANDLINE
+        click.echo("executed")
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0, result.output
+    assert result.output == "executed\n"
+
+    for help_args in ([help_name], [*args, help_name], [help_name, *args]):
+        result = runner.invoke(cli, help_args)
+        assert result.exit_code == 0, result.output
+        assert "Show this message and exit." in result.output
+        assert "executed" not in result.output
+
+
+def test_help_option_multiple_internal_name_collisions(runner):
+    @click.command()
+    @click.argument("help", type=int)
+    @click.option("--one", "_help", type=int)
+    @click.option("--two", "__help", type=int)
+    def cli(help, _help, __help):
+        click.echo(f"{help}, {_help}, {__help}")
+
+    result = runner.invoke(cli, ["42", "--one", "1", "--two", "2"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "42, 1, 2\n"
+
+
+def test_help_option_cached_name_collision(runner):
+    @click.command()
+    def cli(**values):
+        click.echo(values["help"])
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    cli.params.append(click.Option(["--value", "help"], type=int))
+
+    result = runner.invoke(cli, ["--value", "42"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "42\n"
+
+
+@pytest.mark.parametrize("help_names", [["--help"], ["-h", "--help"]])
+def test_explicit_help_option_overrides_default(runner, help_names):
+    @click.command(context_settings={"help_option_names": help_names})
+    @click.option("--help", type=int)
+    def cli(help):
+        click.echo(help)
+
+    result = runner.invoke(cli, ["--help", "42"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "42\n"
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 2
+    assert "Option '--help' requires an argument." in result.output
+
+    if "-h" in help_names:
+        result = runner.invoke(cli, ["-h"])
+        assert result.exit_code == 0, result.output
+        assert "Show this message and exit." in result.output
+        assert "--help INTEGER" in result.output
+
+
