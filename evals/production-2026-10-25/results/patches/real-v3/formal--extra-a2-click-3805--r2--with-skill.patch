+import copy
+import pickle
 from decimal import Decimal
 from fractions import Fraction
 
+import pytest
+
+import click
+from click._utils import Sentinel
 from click._utils import UNSET
 
 
@@ -50,3 +56,50 @@ def test_unset_sentinel():
         assert value is not real_value
 
     assert value not in real_values
+
+
+@pytest.mark.parametrize("sentinel", Sentinel)
+@pytest.mark.parametrize("copy_func", [copy.copy, copy.deepcopy])
+def test_sentinel_copy(sentinel, copy_func):
+    assert copy_func(sentinel) is sentinel
+
+
+@pytest.mark.parametrize("sentinel", Sentinel)
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_sentinel_pickle(sentinel, protocol):
+    assert pickle.loads(pickle.dumps(sentinel, protocol)) is sentinel
+
+
+@pytest.fixture(
+    params=[
+        click.Option(["--value"]),
+        click.Option(["--flag"], is_flag=True),
+        click.Option(["--flags"], is_flag=True, multiple=True),
+        click.Argument(["value"]),
+    ],
+    ids=["option", "flag", "multiple-flag", "argument"],
+)
+def parameter(request):
+    return request.param
+
+
+@pytest.mark.parametrize("copy_func", [copy.copy, copy.deepcopy])
+def test_parameter_copy(parameter, copy_func):
+    copied = copy_func(parameter)
+
+    assert copied is not parameter
+    assert copied.name == parameter.name
+    assert copied.default is UNSET
+    ctx = click.Context(click.Command("cli"))
+    assert copied.get_default(ctx) == parameter.get_default(ctx)
+
+
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_parameter_pickle(parameter, protocol):
+    restored = pickle.loads(pickle.dumps(parameter, protocol))
+
+    assert restored is not parameter
+    assert restored.name == parameter.name
+    assert restored.default is UNSET
+    ctx = click.Context(click.Command("cli"))
+    assert restored.get_default(ctx) == parameter.get_default(ctx)
