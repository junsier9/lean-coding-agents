+@pytest.mark.parametrize('decorate', [
+    pytest.param(memoize(), id='memoize'),
+    pytest.param(memoize(key_func=lambda x: x), id='memoize-key-func'),
+    pytest.param(cache(60), id='cache'),
+    pytest.param(cache(60, key_func=lambda x: x), id='cache-key-func'),
+    pytest.param(cache(timedelta(seconds=60)), id='cache-timedelta'),
+])
+def test_reused_memory_decorator(decorate):
+    calls = []
+
+    @decorate
+    def inc(x):
+        calls.append(('inc', x))
+        return x + 1
+
+    @decorate
+    def double(x):
+        calls.append(('double', x))
+        return x * 2
+
+    assert inc(2) == 3
+    assert double(2) == 4
+    assert inc(2) == 3
+    assert double(2) == 4
+    assert inc(x=3) == 4
+    assert double(x=3) == 6
+    assert inc(x=3) == 4
+    assert double(x=3) == 6
+    assert calls == [('inc', 2), ('double', 2), ('inc', 3), ('double', 3)]
+    assert inc.memory is not double.memory
+
+    inc.invalidate(2)
+    assert double(2) == 4
+    assert inc(x=3) == 4
+    assert inc(2) == 3
+    assert calls[4:] == [('inc', 2)]
+
+    double.invalidate_all()
+    assert inc(2) == 3
+    assert inc(x=3) == 4
+    assert double(2) == 4
+    assert double(x=3) == 6
+    assert calls[5:] == [('double', 2), ('double', 3)]
+
