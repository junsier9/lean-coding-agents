+    def test_pickle(self):
+        for key in (cachetools.keys.hashkey, cachetools.keys.typedkey):
+            for args, kwargs in (((), {}), ((1, 'value'), {}),
+                                 ((), {'x': 'value', 'y': 2}),
+                                 ((1, 'value'), {'x': 2, 'y': 'other'})):
+                for hashed in (False, True):
+                    for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+                        source = key(*args, **kwargs)
+                        if hashed:
+                            hash(source)
+                        restored = pickle.loads(pickle.dumps(source, protocol))
+                        expected = key(*args, **kwargs)
+                        self.assertIs(type(restored), type(source))
+                        self.assertEqual(restored, expected)
+                        self.assertEqual(expected, restored)
+                        self.assertEqual(hash(restored), hash(expected))
+                        self.assertEqual(hash(restored), hash(tuple(restored)))
+                        self.assertEqual({restored: 'value'}[expected], 'value')
+
+    def test_copy(self):
+        for key in (cachetools.keys.hashkey, cachetools.keys.typedkey):
+            for clone in (copy.copy, copy.deepcopy):
+                source = key('value', x=1)
+                hash(source)
+                restored = clone(source)
+                self.assertEqual(restored, source)
+                self.assertEqual(hash(restored), hash(source))
+                self.assertEqual({restored: 'value'}[source], 'value')
+
+    def test_pickle_hash_seed(self):
+        script = textwrap.dedent('''\
+            import pickle
+            import sys
+
+            import cachetools
+            from cachetools import keys
+
+            if sys.argv[1] == 'dump':
+                records = []
+                for key in (keys.hashkey, keys.typedkey):
+                    for args, kwargs in ((('value',), {}),
+                                         ((), {'x': 'value', 'y': 2}),
+                                         (('value',), {'x': 1, 'y': 'other'})):
+                        for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+                            source = key(*args, **kwargs)
+                            cache = cachetools.LRUCache(maxsize=2)
+                            cache[source] = 'cached'
+                            records.append((key.__name__, args, kwargs,
+                                            pickle.dumps(source, protocol),
+                                            pickle.dumps(cache, protocol)))
+                pickle.dump(records, getattr(sys.stdout, 'buffer', sys.stdout))
+            else:
+                records = pickle.load(getattr(sys.stdin, 'buffer', sys.stdin))
+                for name, args, kwargs, key_data, cache_data in records:
+                    key = getattr(keys, name)
+                    expected = key(*args, **kwargs)
+                    restored = pickle.loads(key_data)
+                    assert restored == expected
+                    assert expected == restored
+                    assert hash(restored) == hash(expected)
+                    assert hash(restored) == hash(tuple(restored))
+                    cache = pickle.loads(cache_data)
+                    assert cache[expected] == 'cached'
+                    def miss(*args, **kwargs):
+                        raise AssertionError('restored cache missed')
+                    wrapper = cachetools.cached(cache, key=key)(miss)
+                    assert wrapper(*args, **kwargs) == 'cached'
+            ''')
+        env = os.environ.copy()
+        cwd = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+        env['PYTHONHASHSEED'] = '1'
+        payload = subprocess.check_output(
+            [sys.executable, '-c', script, 'dump'], env=env, cwd=cwd)
+        env['PYTHONHASHSEED'] = '2'
+        process = subprocess.Popen(
+            [sys.executable, '-c', script, 'load'], env=env, cwd=cwd,
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE)
+        stdout, stderr = process.communicate(payload)
+        self.assertEqual(process.returncode, 0, (stdout, stderr))
