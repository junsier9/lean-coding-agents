 import sys
 
+import pytest
+
 from boltons.listutils import SplayList, BarrelList
 
 
@@ -59,6 +61,27 @@ def test_sort_barrel_list():
     assert bl[0] == 0
     assert bl[-1] == 99999
 
+
+@pytest.mark.parametrize('split', [False, True])
+@pytest.mark.parametrize('index', [
+    -sys.maxsize, -100001, -100000, -99999, -1,
+    0, 1, 50000, 99999, 100000, 100001, sys.maxsize,
+])
+def test_barrel_list_insert_bounds(split, index):
+    expected = list(range(100000))
+    bl = BarrelList(expected)
+    if split:
+        bl._balance_list(0)
+        assert len(bl.lists) > 1
+    else:
+        assert len(bl.lists) == 1
+
+    expected.insert(index, 'inserted')
+    assert bl.insert(index, 'inserted') is None
+    assert list(bl) == expected
+    assert len(bl) == len(expected)
+
+
