+    def test_decorator_class_call(self):
+        methods = (
+            "get",
+            "get_typed",
+            "get_lock",
+            "get_cond",
+            "get_lock_cond",
+            "get_info",
+            "get_lock_info",
+            "get_cond_info",
+            "get_lock_cond_info",
+        )
+        for cls in (Cached, Unhashable):
+            for name in methods:
+                for bound_first in (False, True):
+                    with self.subTest(cls=cls, method=name, bound_first=bound_first):
+                        first = cls(self.cache(2))
+                        second = cls(self.cache(2), count=100)
+                        unbound = getattr(cls, name)
+                        with warnings.catch_warnings():
+                            warnings.simplefilter("error", DeprecationWarning)
+                            if bound_first:
+                                self.assertEqual(getattr(first, name)(0), 0)
+                            self.assertEqual(unbound(first, 0), 0)
+                            bound = getattr(first, name)
+                            self.assertEqual(bound(0), 0)
+                            self.assertEqual(unbound(first, value=1), 1)
+                            self.assertEqual(bound(value=1), 1)
+                            self.assertIs(getattr(first, name), bound)
+
+                            # One class callable must dispatch to each instance.
+                            self.assertEqual(unbound(second, 0), 100)
+                            self.assertEqual(getattr(second, name)(0), 100)
+                            self.assertEqual(first.count, 2)
+                            self.assertEqual(second.count, 101)
+
+    def test_decorator_class_call_info(self):
+        for name in (
+            "get_info",
+            "get_lock_info",
+            "get_cond_info",
+            "get_lock_cond_info",
+        ):
+            with self.subTest(method=name):
+                cache = self.cache(2)
+                first = Cached(cache)
+                second = Cached(self.cache(2), count=100)
+                maxsize = cache.maxsize if isinstance(cache, Cache) else None
+                unbound = getattr(Cached, name)
+
+                self.assertEqual(unbound(first, 0), 0)
+                self.assertEqual(unbound(first, 0), 0)
+                bound = getattr(first, name)
+                self.assertEqual(bound.cache_info(), (1, 1, maxsize, 1))
+                self.assertEqual(unbound(second, 0), 100)
+                other = getattr(second, name)
+                self.assertEqual(other.cache_info(), (0, 1, maxsize, 1))
+
+                self.assertEqual(bound(1), 1)
+                self.assertEqual(unbound(first, 1), 1)
+                self.assertEqual(bound.cache_info(), (2, 2, maxsize, 2))
+                self.assertEqual(other.cache_info(), (0, 1, maxsize, 1))
+                bound.cache_clear()
+                self.assertEqual(bound.cache_info(), (0, 0, maxsize, 0))
+                self.assertEqual(other.cache_info(), (0, 1, maxsize, 1))
+                self.assertEqual(unbound(first, 0), 2)
+                self.assertEqual(bound(0), 2)
+                self.assertEqual(bound.cache_info(), (1, 1, maxsize, 1))
+                self.assertIs(getattr(first, name), bound)
