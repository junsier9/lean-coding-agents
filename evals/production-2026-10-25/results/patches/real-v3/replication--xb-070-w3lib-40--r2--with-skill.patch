+    def test_illegal_browser_hack(self):
+        for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):
+            for entity in ('&#%d;' % number, '&#x%x;' % number,
+                           '&#X%X;' % number):
+                text = u'x%s &amp; &#153;y' % entity
+                for value in (text, text.encode('ascii')):
+                    self.assertEqual(replace_entities(value), u'x & \u2122y')
+                    self.assertEqual(
+                        replace_entities(value, remove_illegal=True),
+                        u'x & \u2122y')
+                    self.assertEqual(
+                        replace_entities(value, remove_illegal=False),
+                        u'x%s & \u2122y' % entity)
+
+    def test_illegal_browser_hack_without_semicolon(self):
+        for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):
+            for entity in ('&#%d' % number, '&#x%x' % number,
+                           '&#X%X' % number):
+                text = u'x%sy' % entity
+                self.assertEqual(replace_entities(text), text)
+                self.assertEqual(
+                    replace_entities(text, remove_illegal=False), text)
