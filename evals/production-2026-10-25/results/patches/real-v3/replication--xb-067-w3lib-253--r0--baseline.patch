+@pytest.mark.parametrize("as_bytes", [False, True])
+@pytest.mark.parametrize(
+    ("url", "output"),
+    [
+        ("http://[::1]", "http://[::1]"),
+        ("http://[::]/", "http://[::]/"),
+        ("http://[2001:db8::1]:8080", "http://[2001:db8::1]:8080"),
+        (
+            "http://[2001:db8:0:0:0:0:0:1]/path",
+            "http://[2001:db8:0:0:0:0:0:1]/path",
+        ),
+        (
+            "http://[::ffff:192.0.2.1]:80/path?key=value#fragment",
+            "http://[::ffff:192.0.2.1]:80/path?key=value#fragment",
+        ),
+        (
+            "//[2001:db8::1]:8080/path?key=value",
+            "//[2001:db8::1]:8080/path?key=value",
+        ),
+        (
+            "http://user:pass@[2001:db8::1]:8080/path?key=value",
+            "http://user:pass@[2001:db8::1]:8080/path?key=value",
+        ),
+        (
+            "http://[fe80::1%25eth0]:8080/path?key=value",
+            "http://[fe80::1%25eth0]:8080/path?key=value",
+        ),
+        (
+            "https://[2001:db8::1]:443/résumé?unit=µ#café",
+            "https://[2001:db8::1]:443/r%C3%A9sum%C3%A9?unit=%C2%B5#caf%C3%A9",
+        ),
+        (
+            "http://[2001:db8::1]/a[b]?q=[c]#d[e]",
+            "http://[2001:db8::1]/a%5Bb%5D?q=%5Bc%5D#d%5Be%5D",
+        ),
+    ],
+)
+def test_safe_url_string_ipv6(url: str, output: str, as_bytes: bool) -> None:
+    _test_safe_url_string(url.encode() if as_bytes else url, output=output)
