+@pytest.mark.parametrize('index', [
+    -1000000, -100001, -100000, -99999, -1,
+    0, 1, 99999, 100000, 100001, 1000000,
+])
+def test_barrel_list_insert_bounds(index):
+    expected = list(range(100000))
+    bl = BarrelList(expected)
+    bl._balance_list(0)
+    assert len(bl.lists) > 1
+
+    item = object()
+    expected.insert(index, item)
+    assert bl.insert(index, item) is None
+
+    assert list(bl) == expected
+    assert len(bl) == len(expected)
+
+
+@pytest.mark.parametrize('index', [-1000000.0, 0.5, 100001.0])
+def test_barrel_list_insert_invalid_index(index):
+    expected = list(range(100000))
+    bl = BarrelList(expected)
+    bl._balance_list(0)
+    assert len(bl.lists) > 1
+
+    with pytest.raises(TypeError):
+        bl.insert(index, object())
+
+    assert list(bl) == expected
+    assert len(bl) == len(expected)
+
+
