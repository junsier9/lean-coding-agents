+
+    def test_pickle(self):
+        cases = (
+            ((), {}),
+            ((1, 'value'), {}),
+            ((), {'x': 0, 'y': 'value'}),
+            ((1, 'value'), {'y': 0, 'x': 'keyword'}),
+        )
+        for key in (cachetools.keys.hashkey, cachetools.keys.typedkey):
+            for args, kwargs in cases:
+                for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+                    for hashed in (False, True):
+                        original = key(*args, **kwargs)
+                        if hashed:
+                            hash(original)
+                        restored = pickle.loads(
+                            pickle.dumps(original, protocol))
+                        self.assertIs(type(restored), type(original))
+                        self.assertEqual(restored, original)
+                        self.assertEqual(hash(restored), hash(original))
+                        self.assertEqual(hash(restored), hash(tuple(restored)))
+                        self.assertEqual({restored: 'value'}[original], 'value')
+
+    def test_pickle_unhashable(self):
+        for key in (cachetools.keys.hashkey, cachetools.keys.typedkey):
+            for original in (key([]), key(value=[])):
+                for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+                    restored = pickle.loads(pickle.dumps(original, protocol))
+                    with self.assertRaises(TypeError):
+                        hash(restored)
+
+    def test_pickle_cache_in_another_interpreter(self):
+        cache = cachetools.Cache(maxsize=4)
+        for key in (cachetools.keys.hashkey, cachetools.keys.typedkey):
+            cache[key('argument')] = 'positional'
+            cache[key('argument', option='value')] = 'keyword'
+        payload = base64.b64encode(pickle.dumps(cache)).decode('ascii')
+        script = '''
+import base64
+import pickle
+import sys
+import unittest
+
+import cachetools
+from cachetools.keys import hashkey, typedkey
+
+cache = pickle.loads(base64.b64decode(sys.argv[1]))
+test = unittest.TestCase()
+
+def fail(*args, **kwargs):
+    raise AssertionError('cache miss after unpickling')
+
+for key in (hashkey, typedkey):
+    wrapper = cachetools.cached(cache, key=key)(fail)
+    test.assertEqual(wrapper('argument'), 'positional')
+    test.assertEqual(wrapper('argument', option='value'), 'keyword')
+'''
+        for seed in ('1', '2'):
+            env = dict(os.environ, PYTHONHASHSEED=seed)
+            returncode = subprocess.call([sys.executable, '-c', script, payload],
