 import sys
 
+import pytest
+
 from boltons.listutils import SplayList, BarrelList
 
 
@@ -59,6 +61,43 @@ def test_sort_barrel_list():
     assert bl[0] == 0
     assert bl[-1] == 99999
 
+
+@pytest.mark.parametrize('size, fragmented', [(0, False), (100, False), (100, True)])
+@pytest.mark.parametrize('index', [
+    -1000000, -101, -100, -99, -50, -1, 0, 1, 50, 99, 100, 101, 1000000,
+])
+def test_barrel_list_insert_bounds(size, fragmented, index):
+    expected = list(range(size))
+    bl = BarrelList(expected)
+    if fragmented:
+        bl._size_factor = 4
+        bl._balance_list(0)
+        assert len(bl.lists) > 1
+
+    item = object()
+    expected.insert(index, item)
+    assert bl.insert(index, item) is None
+    assert list(bl) == expected
+    assert len(bl) == len(expected)
+
+
+def test_barrel_list_insert_negative_overflow_rebalances():
+    expected = list(range(100))
+    bl = BarrelList(expected)
+    bl._size_factor = 4
+    bl._balance_list(0)
+    initial_segments = len(bl.lists)
+    assert initial_segments > 1
+
+    for item in range(-50, 0):
+        expected.insert(-1000000, item)
+        assert bl.insert(-1000000, item) is None
+        assert list(bl) == expected
+        assert len(bl) == len(expected)
+
+    assert len(bl.lists) > initial_segments
+
+
