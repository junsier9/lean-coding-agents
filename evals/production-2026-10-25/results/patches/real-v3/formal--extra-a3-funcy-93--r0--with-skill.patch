+def test_cache_invalidate_all():
+    calls = []
+
+    @cache(timeout=60)
+    def inc(x):
+        calls.append(x)
+        return x + 1
+
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert inc.invalidate_all() is None
+    assert inc.invalidate_all() is None
+    assert inc.invalidate(0) is None
+    assert inc.invalidate(1) is None
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert calls == [0, 1, 0, 1]
+
+
+def test_cache_invalidate_key_func():
+    calls = []
+
+    @cache(timeout=60, key_func=lambda x, by=1: x)
+    def mul(x, by=1):
+        calls.append((x, by))
+        return x * by
+
+    assert mul(2, by=3) == 6
+    assert mul(2, by=4) == 6
+    assert mul.invalidate(2, by=5) is None
+    assert mul.invalidate(2, by=5) is None
+    assert mul(2, by=4) == 8
+    assert calls == [(2, 3), (2, 4)]
+
+
+@pytest.mark.parametrize('error', [KeyError, TypeError, ValueError])
+def test_cache_invalidate_key_func_error(error):
+    def key_func(x):
+        raise error('invalid cache key')
+
+    @cache(timeout=60, key_func=key_func)
+    def inc(x):
+        pytest.fail('Invalidation must not call the cached function')
+
+    with pytest.raises(error, match='invalid cache key'):
+        inc.invalidate(0)
+
