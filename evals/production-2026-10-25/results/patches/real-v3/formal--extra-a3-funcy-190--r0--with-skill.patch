+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+def test_lookuper_retries_failed_builder(deco):
+    calls = []
+    error = RuntimeError('Failed to build table')
+
+    @deco
+    def table():
+        calls.append(None)
+        if len(calls) < 3:
+            raise error
+        return {'ready': 42}
+
+    assert calls == []
+    for _ in range(2):
+        with pytest.raises(RuntimeError) as exc:
+            table('ready')
+        assert exc.value is error
+
+    assert table('ready') == 42
+    assert table('ready') == 42
+    assert len(calls) == 3
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+def test_lookuper_discards_failed_generator(deco):
+    calls = []
+
+    @deco
+    def table():
+        calls.append(None)
+        if len(calls) == 1:
+            yield 'partial', -1
+            raise RuntimeError('Failed while building table')
+        yield 'ready', 42
+
+    with pytest.raises(RuntimeError, match='Failed while building table'):
+        table('partial')
+    assert table('ready') == 42
+    if deco is silent_lookuper:
+        assert table('partial') is None
+    else:
+        with pytest.raises(LookupError, match=r'Failed to look up table\(partial\)'):
+            table('partial')
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+@pytest.mark.parametrize('factory', [dict, iter])
+def test_lookuper_caches_empty_table(deco, factory):
+    calls = []
+
+    @deco
+    def table():
+        calls.append(None)
+        return factory(())
+
+    assert calls == []
+    for key in ('missing', 'other', 'missing'):
+        if deco is silent_lookuper:
+            assert table(key) is None
+        else:
+            with pytest.raises(LookupError):
+                table(key)
+    assert len(calls) == 1
+
+
+@pytest.mark.parametrize('deco', [make_lookuper, silent_lookuper])
+def test_lookuper_nested_retries_independently(deco):
+    calls = []
+
+    @deco
+    def table(group):
+        calls.append(group)
+        if calls == ['first']:
+            yield 'partial', -1
+            raise RuntimeError('Failed while building table')
+        yield 'ready', group
+
+    first = table('first')
+    assert first is table('first')
+    assert calls == []
+    with pytest.raises(RuntimeError, match='Failed while building table'):
+        first('ready')
+    assert table('second')('ready') == 'second'
+    assert table('first')('ready') == 'first'
+    assert table('second')('ready') == 'second'
+    assert first('ready') == 'first'
+    assert calls == ['first', 'second', 'first']
+
+
