+    def test_counts_strict(self):
+        for data, counts in [
+            ('ab', (4, 2)),
+            ('abc', (2, 0, 1)),
+            ('ab', (0, 0)),
+            ('', ()),
+        ]:
+            with self.subTest(data=data, counts=counts):
+                expanded = list(
+                    chain.from_iterable(
+                        repeat(item, n) for item, n in zip(data, counts)
+                    )
+                )
+                self.assertCountEqual(
+                    mi.sample(
+                        iter(data),
+                        len(expanded) + 1,
+                        counts=iter(counts),
+                        strict=False,
+                    ),
+                    expanded,
+                )
+                self.assertCountEqual(
+                    mi.sample(
+                        iter(data),
+                        len(expanded),
+                        counts=iter(counts),
+                        strict=True,
+                    ),
+                    expanded,
+                )
+                with self.assertRaisesRegex(
+                    ValueError, '^Sample larger than population$'
+                ):
+                    mi.sample(
+                        iter(data),
+                        len(expanded) + 1,
+                        counts=iter(counts),
+                        strict=True,
+                    )
+
+    def test_weights_strict(self):
+        for data, weights, k in [
+            ('ab', (1, 2), 3),
+            ('ab', (1,), 2),
+            ('ab', (), 1),
+            ('', (), 1),
+        ]:
+            with self.subTest(data=data, weights=weights, k=k):
+                with self.assertRaisesRegex(
+                    ValueError, '^Sample larger than population$'
+                ):
+                    mi.sample(
+                        iter(data), k, weights=iter(weights), strict=True
+                    )
+
+    def test_weights_and_counts_mutually_exclusive(self):
