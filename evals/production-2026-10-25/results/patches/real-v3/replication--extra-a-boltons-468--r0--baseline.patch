+from pytest import mark, raises
 from boltons.mathutils import clamp, ceil, floor, Bits
 import math
 
@@ -127,3 +127,111 @@ def test_bits_len_bound():
         Bits(4, 2)
     with raises(ValueError):
         Bits(1, 0)
+
+
+@mark.parametrize('factory, args', [
+    (Bits, ('',)),
+    (Bits, (b'',)),
+    (Bits, ([],)),
+    (Bits, (0, 0)),
+    (Bits, ('0x',)),
+    (Bits, (b'0x',)),
+    (Bits.from_bin, ('',)),
+    (Bits.from_bin, (b'',)),
+    (Bits.from_list, ([],)),
+    (Bits.from_int, (0, 0)),
+    (Bits.from_hex, ('',)),
+    (Bits.from_hex, (b'',)),
+    (Bits.from_hex, ('0x',)),
+    (Bits.from_hex, (b'0x',)),
+    (Bits.from_bytes, (b'',)),
+])
+def test_bits_empty_conversions(factory, args):
+    bits = factory(*args)
+    assert len(bits) == 0
+    assert bits.as_int() == 0
+    assert bits.as_bin() == ''
+    assert bits.as_hex() == ''
+    assert bits.as_bytes() == b''
+    assert bits.as_list() == []
+    assert repr(bits) == "Bits('')"
+    assert Bits.from_bin(bits.as_bin()) == bits
+    assert Bits.from_hex(bits.as_hex()) == bits
+    assert Bits.from_bytes(bits.as_bytes()) == bits
+    assert Bits.from_list(bits.as_list()) == bits
+    assert Bits.from_int(bits.as_int(), len(bits)) == bits
+    for index in (0, -1):
+        with raises(IndexError):
+            bits[index]
+
+
+@mark.parametrize('binary', ['', '0', '1010'])
+@mark.parametrize('key', [slice(None), slice(None, None, -1),
+                         slice(0, 0), slice(1, 1), slice(3, 1),
+                         slice(10, None)])
+def test_bits_slices_match_binary(binary, key):
+    sliced = Bits(binary)[key]
+    expected = binary[key]
+    assert sliced == Bits(expected)
+    assert len(sliced) == len(expected)
+    assert sliced.as_bin() == expected
+    assert sliced.as_list() == [bit == '1' for bit in expected]
+    if not expected:
+        assert sliced.as_hex() == ''
+        assert sliced.as_bytes() == b''
+
+
+@mark.parametrize('binary, hex_, bytes_', [
+    ('0', '00', b'\x00'),
+    ('0000', '00', b'\x00'),
+    ('00000000', '00', b'\x00'),
+    ('000000000', '0000', b'\x00\x00'),
+    ('1', '01', b'\x01'),
+    ('1111', '0F', b'\x0f'),
+    ('000000001', '0001', b'\x00\x01'),
+    ('10101010', 'AA', b'\xaa'),
+])
+def test_bits_nonempty_conversions(binary, hex_, bytes_):
+    bits = Bits(binary)
+    assert bits.as_bin() == binary
+    assert bits.as_list() == [bit == '1' for bit in binary]
+    assert bits.as_hex() == hex_
+    assert bits.as_bytes() == bytes_
+    padded = Bits(binary.zfill(len(bytes_) * 8))
+    assert Bits.from_hex(hex_) == padded
+    assert Bits.from_bytes(bytes_) == padded
+
+
+def test_bits_empty_and_zero_are_distinct():
+    empty = Bits('')
+    assert empty != Bits()
+    assert Bits() == Bits('0')
+    assert Bits('', 3) == Bits('000')
+    assert Bits('0x', 3) == Bits('000')
+    assert Bits('1') >> 1 == empty
+    assert empty << 0 == empty
+    assert empty | empty == empty
+    assert empty & empty == empty
+
+
+@mark.parametrize('factory, args, error', [
+    (Bits, (-1,), ValueError),
+    (Bits, (1, 0), ValueError),
+    (Bits, (4, 2), ValueError),
+    (Bits, ('0x1', 0), ValueError),
+    (Bits, ('2',), ValueError),
+    (Bits, ('0xg',), ValueError),
+    (Bits, ('0x ',), ValueError),
+    (Bits, (None,), TypeError),
+    (Bits, ((),), TypeError),
+    (Bits, (0.0,), TypeError),
+    (Bits.from_bin, ('102',), ValueError),
+    (Bits.from_hex, ('g',), ValueError),
+    (Bits.from_hex, (' ',), ValueError),
+    (Bits.from_hex, ('0x0x',), ValueError),
+    (Bits.from_hex, (b'\xff',), UnicodeDecodeError),
+    (Bits.from_bytes, ('',), TypeError),
+])
+def test_bits_invalid_inputs(factory, args, error):
+    with raises(error):
+        factory(*args)
