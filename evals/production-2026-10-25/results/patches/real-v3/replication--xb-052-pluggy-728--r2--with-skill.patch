+def test_unicode_output(rootlogger: TagTracer) -> None:
+    buffer = io.BytesIO()
+    stream = io.TextIOWrapper(
+        buffer, encoding="utf-8", newline="\n", write_through=True
+    )
+    rootlogger.setwriter(stream.write)
+    log = rootlogger.get("test\ud800")
+    text = "caf\u00e9 \u4e2d\u6587 \U0001f600"
+
+    log(text + "\ud800", {"key\udfff": text + "\udfff"})
+
+    assert buffer.getvalue().decode("utf-8") == (
+        f"{text}\\ud800 [test\\ud800]\n    key\\udfff: {text}\\udfff\n"
+    )
+
+
+def test_unprintable_output(rootlogger: TagTracer) -> None:
+    class Unprintable:
+        def __str__(self) -> str:
+            raise ValueError("broken str")
+
+        def __repr__(self) -> str:
+            raise RuntimeError("broken repr")
+
+    value = Unprintable()
+    details = {value: value}
+    out: list[str] = []
+    processed = []
+    rootlogger.setwriter(out.append)
+    rootlogger.setprocessor("test", lambda tags, args: processed.append(args))
+
+    rootlogger.get("test")(value, [value], details)
+
+    assert out == [
+        "<unprintable Unprintable object> <unprintable list object> [test]\n"
+        "    <unprintable Unprintable object>: <unprintable Unprintable object>\n"
+    ]
+    assert processed[0][0] is value
+    assert processed[0][1][0] is value
+    assert processed[0][2] is details
+
+
+@pytest.mark.parametrize("exception", [KeyboardInterrupt, SystemExit, GeneratorExit])
+@pytest.mark.parametrize("in_container", [False, True])
+@pytest.mark.parametrize("in_details", [False, True])
+def test_formatting_interrupts(
+    rootlogger: TagTracer, exception, in_container: bool, in_details: bool
+) -> None:
+    error = exception()
+
+    class Interrupted:
+        def __str__(self) -> str:
+            raise error
+
+        def __repr__(self) -> str:
+            raise error
+
+    value: object = Interrupted()
+    if in_container:
+        value = [value]
+    if in_details:
+        value = {"value": value}
+    rootlogger.setwriter(lambda message: None)
+
+    with pytest.raises(exception) as excinfo:
+        rootlogger.get("test")(value)
+    assert excinfo.value is error
+
+
+def test_writer_failure(rootlogger: TagTracer) -> None:
+    error = OSError("writer failed")
+
+    def writer(message: str) -> None:
+        raise error
+
+    rootlogger.setwriter(writer)
+    with pytest.raises(OSError) as excinfo:
+        rootlogger.get("test")("message")
+    assert excinfo.value is error
+
+
