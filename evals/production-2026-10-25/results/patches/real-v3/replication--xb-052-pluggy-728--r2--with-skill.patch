+@pytest.mark.parametrize("firstresult", [False, True])
+def test_hook_tracing_unprintable(pm: PluginManager, firstresult: bool) -> None:
+    class Api:
+        @hookspec(firstresult=firstresult)
+        def hello(self, arg: object) -> object: ...
+
+    class Unprintable:
+        def __str__(self) -> str:
+            raise ValueError("broken str")
+
+        def __repr__(self) -> str:
+            raise RuntimeError("broken repr")
+
+    calls = []
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg: object) -> object:
+            calls.append(arg)
+            return arg
+
+    pm.add_hookspecs(Api)
+    pm.register(Plugin())
+    trace: list[str] = []
+    pm.trace.root.setwriter(trace.append)
+    undo = pm.enable_tracing()
+    try:
+        for value in (Unprintable(), "caf\u00e9 \u4e2d\u6587 \U0001f600\ud800\udfff"):
+            result = pm.hook.hello(arg=value)
+            assert (result if firstresult else result[0]) is value
+            assert calls[-1] is value
+            assert pm.trace.root.indent == 0
+        assert len(calls) == 2
+        assert len(trace) == 4
+        assert "unprintable" in trace[0]
+        assert "unprintable" in trace[1]
+        assert "caf\u00e9 \u4e2d\u6587 \U0001f600\\ud800\\udfff" in trace[2]
+        for message in trace:
+            message.encode("utf-8")
+    finally:
+        undo()
+
+
