diff --git a/tests/test_rr.py b/tests/test_rr.py
index 43917d7..f21e60a 100644
--- a/tests/test_rr.py
+++ b/tests/test_rr.py
@@ -1,5 +1,6 @@
 import random
 import unittest
+import unittest.mock
 
 from cachetools import RRCache
 
@@ -83,6 +84,42 @@ class RRCacheTest(unittest.TestCase, CacheTestMixin):
         self.assertIn(2, cache)
         self.assertNotIn(3, cache)
 
+    def test_rr_popitem_empty(self):
+        for choice in (random.choice, min, max, lambda seq: next(iter(seq))):
+            with self.subTest(choice=choice):
+                selector = unittest.mock.Mock(wraps=choice)
+                cache = RRCache[int, int](maxsize=2, choice=selector)
+
+                with self.assertRaises(KeyError) as cm:
+                    cache.popitem()
+                self.assertEqual(("RRCache is empty",), cm.exception.args)
+                self.assertIsNone(cm.exception.__cause__)
+                self.assertTrue(cm.exception.__suppress_context__)
+                selector.assert_not_called()
+
+                cache[1] = 1
+                self.assertEqual((1, 1), cache.popitem())
+                with self.assertRaises(KeyError):
+                    cache.popitem()
+                self.assertEqual(1, selector.call_count)
+
+    def test_rr_popitem_choice_error(self):
+        for error in (IndexError("test"), ValueError("test"), StopIteration("test")):
+            with self.subTest(error=type(error)):
+                cache = RRCache[int, int](
+                    maxsize=2, choice=unittest.mock.Mock(side_effect=error)
+                )
+                cache.update({1: 1, 2: 2})
+
+                with self.assertRaises(type(error)) as cm:
+                    cache.popitem()
+                self.assertIs(error, cm.exception)
+                with self.assertRaises(type(error)) as cm:
+                    cache[3] = 3
+                self.assertIs(error, cm.exception)
+                self.assertEqual({1: 1, 2: 2}, dict(cache))
+                self.assertEqual(2, cache.currsize)
+
     def test_rr_default_choice(self):
         cache = RRCache[int, int](maxsize=2)
         self.assertIs(cache.choice, random.choice)
