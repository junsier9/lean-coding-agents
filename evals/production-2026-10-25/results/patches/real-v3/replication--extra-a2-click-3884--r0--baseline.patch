+@pytest.mark.parametrize("envvar", [None, "", [], ()])
+@pytest.mark.parametrize("allow_from_autoenv", [False, True])
+@pytest.mark.parametrize("show_envvar", [False, True])
+def test_show_envvar_empty_auto_prefix(runner, envvar, allow_from_autoenv, show_envvar):
+    @click.command()
+    @click.option(
+        "--arg1",
+        type=int,
+        required=True,
+        envvar=envvar,
+        allow_from_autoenv=allow_from_autoenv,
+        show_envvar=show_envvar,
+    )
+    def cmd(arg1):
+        click.echo(arg1)
+
+    result = runner.invoke(cmd, ["--help"], auto_envvar_prefix="TEST")
+    assert result.exit_code == 0
+    if show_envvar and allow_from_autoenv:
+        assert "[env var: TEST_ARG1; required]" in result.output
+    else:
+        assert "env var:" not in result.output
+        assert "[required]" in result.output
+
+    result = runner.invoke(cmd, env={"TEST_ARG1": "42"}, auto_envvar_prefix="TEST")
+    if allow_from_autoenv:
+        assert result.exit_code == 0
+        assert result.output == "42\n"
+    else:
+        assert result.exit_code == 2
+        assert "Error: Missing option '--arg1'." in result.output
+
