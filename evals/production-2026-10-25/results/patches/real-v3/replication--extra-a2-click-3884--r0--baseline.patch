+@pytest.mark.parametrize("show_envvar", [False, True])
+@pytest.mark.parametrize(
+    ("envvar", "help_envvars", "error_envvars"),
+    [
+        (None, "", ""),
+        ("", "", ""),
+        ([], "", ""),
+        ((), "", ""),
+        ("ARG1", "ARG1", "'ARG1'"),
+        (["ARG1"], "ARG1", "'ARG1'"),
+        (("ARG1",), "ARG1", "'ARG1'"),
+        (["ARG1", "ARG2"], "ARG1, ARG2", "'ARG1', 'ARG2'"),
+        (("ARG1", "ARG2"), "ARG1, ARG2", "'ARG1', 'ARG2'"),
+    ],
+)
+def test_show_envvar_configuration(
+    runner, monkeypatch, show_envvar, envvar, help_envvars, error_envvars
+):
+    monkeypatch.delenv("ARG1", raising=False)
+    monkeypatch.delenv("ARG2", raising=False)
+
+    @click.command()
+    @click.option(
+        "--arg1", type=int, required=True, envvar=envvar, show_envvar=show_envvar
+    )
+    def cmd(arg1):
+        pass
+
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    if show_envvar and help_envvars:
+        assert f"[env var: {help_envvars}; required]" in result.output
+    else:
+        assert "env var:" not in result.output
+        assert "[required]" in result.output
+
+    hint = "'--arg1'"
+    if show_envvar and error_envvars:
+        hint += f" (env var: {error_envvars})"
+    assert cmd.params[0].get_error_hint(None) == hint
+
+    result = runner.invoke(cmd)
+    assert result.exit_code == 2
+    assert f"Error: Missing option {hint}." in result.output
+
+    result = runner.invoke(cmd, ["--arg1=bad"])
+    assert result.exit_code == 2
+    assert (
+        f"Error: Invalid value for {hint}: 'bad' is not a valid integer."
+        in result.output
+    )
+
+
