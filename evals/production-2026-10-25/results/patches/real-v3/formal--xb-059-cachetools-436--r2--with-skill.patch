diff --git a/tests/test_cachedmethod.py b/tests/test_cachedmethod.py
index 8d519f6..515dc4b 100644
--- a/tests/test_cachedmethod.py
+++ b/tests/test_cachedmethod.py
@@ -93,6 +93,65 @@ class MethodDecoratorTestMixin(_TestCaseProtocol):
         cached.cache.clear()
         self.assertEqual(cached.get(1), 2)
 
+    def test_decorator_unbound(self):
+        for cls in (Cached, Unhashable):
+            for name in (
+                "get",
+                "get_typed",
+                "get_info",
+                "get_lock",
+                "get_lock_info",
+                "get_cond",
+                "get_cond_info",
+                "get_lock_cond",
+                "get_lock_cond_info",
+            ):
+                cache = self.cache(2)
+                cached = cls(cache)
+                other = cls(self.cache(2), count=10)
+                unbound = getattr(cls, name)
+
+                with warnings.catch_warnings():
+                    warnings.simplefilter("error", DeprecationWarning)
+                    self.assertEqual(unbound(cached, value=0), 0)
+                    bound = getattr(cached, name)
+                    self.assertEqual(bound(value=0), 0)
+                    self.assertEqual(unbound(other, value=0), 10)
+                    self.assertEqual(bound(1), 1)
+                    self.assertEqual(unbound(cached, 1), 1)
+
+                self.assertIs(getattr(cached, name), bound)
+                self.assertIs(bound.cache, cache)
+                self.assertEqual(cached.count, 2)
+                self.assertEqual(other.count, 11)
+                other_bound = getattr(other, name)
+                maxsize = cache.maxsize if isinstance(cache, Cache) else None
+                if name.endswith("_info"):
+                    self.assertEqual(bound.cache_info(), (2, 2, maxsize, 2))
+                    self.assertEqual(other_bound.cache_info(), (0, 1, maxsize, 1))
+
+                bound.cache_clear()
+                self.assertEqual(len(cached.cache), 0)
+                self.assertEqual(len(other.cache), 1)
+                if name.endswith("_info"):
+                    self.assertEqual(bound.cache_info(), (0, 0, maxsize, 0))
+                    self.assertEqual(other_bound.cache_info(), (0, 1, maxsize, 1))
+                self.assertEqual(unbound(cached, value=0), 2)
+                self.assertEqual(unbound(other, value=0), 10)
+
+    def test_decorator_unbound_cond_error(self):
+        cached = Cached(self.cache(2))
+        unbound = getattr(Cached, "get_cond_error")
+
+        with self.assertRaisesRegex(ValueError, "test error"):
+            unbound(cached, 0)
+        with self.assertRaisesRegex(ValueError, "test error"):
+            cached.get_cond_error(0)
+        self.assertEqual(cached.cond.count, 4)
+        self.assertEqual(cached.cond.wait_count, 2)
+        self.assertEqual(cached.cond.notify_count, 2)
+        self.assertEqual(len(cached.cache), 0)
+
