+@parametrize("function", [_.xor, _.xor_by, _.xor_with])
+@parametrize(
+    "factory",
+    [list, tuple, iter, lambda values: (value for value in values)],
+    ids=["list", "tuple", "iterator", "generator"],
+)
+@parametrize("values", [[], [1, 2, 1]])
+def test_xor_single_iterable(function, factory, values):
+    array = factory(values)
+    result = function(array)
+    assert isinstance(result, list)
+    assert result == values
+    assert result is not array
+
+
+@parametrize("function", [_.xor, _.xor_by, _.xor_with])
+@parametrize("left_factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize("right_factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize(
+    "arrays,expected",
+    [
+        (([1, 2, 3, 1], [5, 2, 1, 4, 5]), [3, 5, 4]),
+        (([], [1, 1, 2]), [1, 2]),
+        (([1, 1, 2], []), [1, 2]),
+        (([], []), []),
+        (([1, 2, 5], [2, 3, 5], [3, 4, 5]), [1, 4, 5]),
+    ],
+)
+def test_xor_mixed_iterables(function, left_factory, right_factory, arrays, expected):
+    inputs = [left_factory(arrays[0]), *(right_factory(array) for array in arrays[1:])]
+    assert function(*inputs) == expected
+
+
+@parametrize("factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize("keyword", [False, True])
+@parametrize("name", ["xor_by", "xor_with"])
+def test_xor_iterables_with_callback(factory, keyword, name):
+    first = {"id": 1}
+    second = {"id": 2}
+    third = {"id": 3}
+    fourth = {"id": 4}
+    arrays = [[first, second, second], [{"id": 2}, third], [{"id": 1}, fourth]]
+    inputs = [factory(array) for array in arrays]
+    snapshots = [array[:] for array in arrays]
+    if name == "xor_by":
+        callback = "id"
+        callback_name = "iteratee"
+    else:
+        callback = lambda left, right: left["id"] == right["id"]
+        callback_name = "comparator"
+
+    function = getattr(_, name)
+    if keyword:
+        result = function(*inputs, **{callback_name: callback})
+    else:
+        result = function(*inputs, callback)
+    assert result == [third, fourth]
+    assert result[0] is third
+    assert result[1] is fourth
+    assert arrays == snapshots
+    for array, snapshot in zip(inputs, snapshots):
+        if isinstance(array, list):
+            assert array == snapshot
+
+
+@parametrize("factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize("keyword", [False, True])
+@parametrize(
