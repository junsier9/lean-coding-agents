+        (_.xor_by, "iteratee", "id"),
+        (_.xor_by, "iteratee", lambda value: value["id"]),
+        (_.xor_with, "comparator", lambda left, right: left["id"] == right["id"]),
+    ],
+)
+def test_xor_single_iterable_with_callback(factory, keyword, function, callback_name, callback):
+    values = [{"id": 1}, {"id": 2}, {"id": 1}]
+    array = factory(values)
+    result = function(array, **{callback_name: callback}) if keyword else function(array, callback)
+    assert isinstance(result, list)
+    assert result == values
+    assert result is not array
+
