+    def test_counts_strict(self):
+        for iterable, counts in [
+            ('', ()),
+            ('ab', (0, 0)),
+            ('abc', (0, 2, 1)),
+            ('ab', (4, 2)),
+        ]:
+            with self.subTest(iterable=iterable, counts=counts):
+                k = sum(counts) + 1
+                with self.assertRaisesRegex(
+                    ValueError, '^Sample larger than population$'
+                ):
+                    mi.sample(
+                        iter(iterable), k, counts=iter(counts), strict=True
+                    )
+                actual = mi.sample(
+                    iter(iterable), k, counts=iter(counts), strict=False
+                )
+                expected = chain.from_iterable(
+                    repeat(item, count) for item, count in zip(iterable, counts)
+                )
+                self.assertCountEqual(actual, expected)
+
+    def test_counts_strict_length(self):
+        for k in (0, 3, 6):
+            with self.subTest(k=k):
+                actual = mi.sample(
+                    iter('abc'), k, counts=iter((4, 0, 2)), strict=True
+                )
+                self.assertEqual(len(actual), k)
+                self.assertFalse(Counter(actual) - Counter('aaaacc'))
+
