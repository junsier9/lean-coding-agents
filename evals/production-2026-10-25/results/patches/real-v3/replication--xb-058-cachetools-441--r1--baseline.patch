+    def test_ttl_datetime_overflow(self):
+        from datetime import datetime, timedelta
+
+        now = datetime.max
+        ttl = timedelta(days=1)
+        cache = TTLCache[int, int, datetime](maxsize=1, ttl=ttl, timer=lambda: now)
+
+        with self.assertRaises(OverflowError):
+            cache[1] = 1
+
+        self.assertNotIn(1, cache)
+        with self.assertRaises(KeyError):
+            cache[1]
+        self.assertEqual(0, len(cache))
+        self.assertEqual(0, cache.currsize)
+        self.assertEqual([], list(cache))
+        self.assertEqual([], cache.expire())
+
+        # A valid insertion must still work after the rejected one.
+        now = datetime(2000, 1, 1)
+        cache[1] = 2
+        self.assertEqual(2, cache[1])
+        self.assertEqual(1, cache.currsize)
+        now += ttl
+        self.assertEqual([(1, 2)], cache.expire())
+        self.assertEqual(0, len(cache))
+        self.assertEqual(0, cache.currsize)
+
+    def test_ttl_datetime_overflow_existing(self):
+        from datetime import datetime, timedelta
+
+        # Exercise both eviction of a full cache and replacement without eviction.
+        for key, value, maxsize in [(3, 3, 3), (1, 2, 4)]:
+            with self.subTest(key=key):
+                now = datetime.max - timedelta(days=3)
+                cache = TTLCache[int, int, datetime](
+                    maxsize=maxsize,
+                    ttl=timedelta(days=2),
+                    timer=lambda: now,
+                    getsizeof=lambda value: value,
+                )
+                cache[1] = 1
+                cache[2] = 2
+                now += timedelta(days=1, hours=12)
+
+                with self.assertRaises(OverflowError):
+                    cache[key] = value
+
+                self.assertNotIn(3, cache)
+                self.assertEqual([1, 2], list(cache))
+                self.assertEqual(2, len(cache))
+                self.assertEqual(3, cache.currsize)
+                # Rejection must preserve the old values and LRU order.
+                self.assertEqual((1, 1), cache.popitem())
+                self.assertEqual(2, cache[2])
+                now = datetime.max - timedelta(days=1)
+                self.assertEqual([(2, 2)], cache.expire())
+                self.assertEqual(0, len(cache))
+                self.assertEqual(0, cache.currsize)
+
