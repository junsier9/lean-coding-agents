+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize("unprintable", [False, True])
+def test_hook_tracing_unusual_values(
+    pm: PluginManager, firstresult: bool, unprintable: bool
+) -> None:
+    class Api:
+        @hookspec(firstresult=firstresult)
+        def hello(self, arg): ...
+
+    class Unprintable:
+        def __str__(self):
+            raise ValueError("cannot stringify")
+
+        def __repr__(self):
+            raise ValueError("cannot represent")
+
+    calls = []
+    error = ValueError("hook failed")
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg):
+            calls.append(arg)
+            if len(calls) == 2:
+                raise error
+            return arg
+
+    pm.add_hookspecs(Api)
+    pm.register(Plugin())
+    messages = []
+    pm.trace.root.setwriter(lambda message: messages.append(message.encode("utf-8")))
+    undo = pm.enable_tracing()
+    value = Unprintable() if unprintable else "café 中文 😀\ud800\udfff"
+    try:
+        result = pm.hook.hello(arg=value)
+        assert (result if firstresult else result[0]) is value
+        assert len(messages) == 2
+        assert b"finish hello -->" in messages[1]
+        if unprintable:
+            assert all(b"<unprintable " in m for m in messages)
+        else:
+            assert "café 中文 😀\\ud800\\udfff" in messages[0].decode("utf-8")
+        with pytest.raises(ValueError) as excinfo:
+            pm.hook.hello(arg=value)
+        assert excinfo.value is error
+        assert pm.trace.root.indent == 0
+    finally:
+        undo()
+
+    assert calls[0] is value
+    assert calls[1] is value
+    result = pm.hook.hello(arg=value)
+    assert (result if firstresult else result[0]) is value
+    assert len(messages) == 3
+
+
+@pytest.mark.parametrize("error_type", [KeyboardInterrupt, SystemExit, GeneratorExit])
+@pytest.mark.parametrize("stage", ["argument", "result", "hook"])
+def test_hook_tracing_interruptions(
+    pm: PluginManager, error_type: type[BaseException], stage: str
+) -> None:
+    error = error_type("interrupted")
+
+    class Interrupting:
+        def __str__(self):
+            raise error
+
+        def __repr__(self):
+            raise error
+
+    calls = []
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg):
+            calls.append(arg)
+            if stage == "hook":
+                raise error
+            return Interrupting()
+
+    pm.register(Plugin())
+    pm.trace.root.setwriter(lambda message: None)
+    undo = pm.enable_tracing()
+    try:
+        with pytest.raises(error_type) as excinfo:
+            pm.hook.hello(arg=Interrupting() if stage == "argument" else 1)
+        assert excinfo.value is error
+        assert len(calls) == (0 if stage == "argument" else 1)
+        assert pm.trace.root.indent == 0
+    finally:
+        undo()
+
+
