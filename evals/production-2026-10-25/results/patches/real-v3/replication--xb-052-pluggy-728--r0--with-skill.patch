+@pytest.mark.parametrize(
+    ("text", "escaped"),
+    [
+        ("caf\u00e9 \u4e2d\u6587 \U0001f600", "caf\u00e9 \u4e2d\u6587 \U0001f600"),
+        ("\u4e2d\ud800\u6587", "\u4e2d\\ud800\u6587"),
+        ("\u4e2d\udfff\u6587", "\u4e2d\\udfff\u6587"),
+    ],
+)
+def test_unicode_output(rootlogger: TagTracer, text: str, escaped: str) -> None:
+    messages = []
+    rootlogger.setwriter(lambda message: messages.append(message.encode("utf-8")))
+    rootlogger.get(text)(text, {text: text})
+
+    assert messages == [f"{escaped} [{escaped}]\n    {escaped}: {escaped}\n".encode()]
+
+
+@pytest.mark.parametrize("location", ["argument", "nested", "key", "value"])
+def test_unprintable_output(rootlogger: TagTracer, location: str) -> None:
+    class Unprintable:
+        def __str__(self):
+            raise ValueError("cannot stringify")
+
+        def __repr__(self):
+            raise ValueError("cannot represent")
+
+    value = Unprintable()
+    args = {
+        "argument": (value,),
+        "nested": ([value],),
+        "key": ({value: "ok"},),
+        "value": ({"arg": value},),
+    }[location]
+    messages = []
+    processed = []
+    rootlogger.setwriter(messages.append)
+    rootlogger.setprocessor("test", lambda *args: processed.append(args))
+    rootlogger.get("test")(*args)
+
+    assert len(messages) == 1
+    type_name = "list" if location == "nested" else "Unprintable"
+    assert f"<unprintable {type_name} object>" in messages[0]
+    assert processed == [(("test",), args)]
+
+
