+@parametrize("length", [-100, -1, 0, 1, 2, 3])
+@parametrize("omission", ["...", " [truncated]"])
+@parametrize("separator", [None, " ", "missing", "", re.compile(r"\s+"), re.compile("")])
+def test_truncate_length_at_most_omission(length, omission, separator):
+    assert _.truncate("one two three four five", length, omission, separator) == omission
+
+
+@parametrize("length", [-100, -1, 0])
+@parametrize("separator", [None, " ", "", re.compile(r"\s+"), re.compile("")])
+def test_truncate_nonpositive_length_without_omission(length, separator):
+    assert _.truncate("one two three four five", length, "", separator) == ""
+
+
+@parametrize(
+    "case,expected",
+    [
+        (("abcdefghi", 7, "...", None), "abcd..."),
