+        (("abcdefghi", 7, "...", ""), "abcd..."),
+        (("abcdefghi", 7, "...", re.compile("missing")), "abcd..."),
+        (("abcdefghi", 7, "...", re.compile("")), "abcd..."),
+        (("one two three four", 13, "...", " "), "one two..."),
+        (("one two three four", 13, "...", re.compile(r"\s+")), "one two..."),
+        (("one--two--three", 12, "...", "--"), "one..."),
+        (("one--two--three", 12, "...", re.compile("--")), "one..."),
+        (("oneXXtwoXXthree", 13, "...", re.compile("xx", re.I)), "oneXXtwo..."),
+        ((" abcdefghi", 7, "...", " "), "..."),
+        ((" abcdefghi", 7, "...", re.compile(r"\s+")), "..."),
