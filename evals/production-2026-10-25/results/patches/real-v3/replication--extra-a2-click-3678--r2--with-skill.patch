+@pytest.mark.parametrize("help_name,name", [("--help", "help"), ("--my-help", "my_help")])
+@pytest.mark.parametrize("kind", ["argument", "option", "flag"])
+def test_help_option_internal_name_collision(runner, help_name, name, kind):
+    if kind == "argument":
+        param = click.Argument([name])
+        args = ["value"]
+        expected = "value"
+    else:
+        param = click.Option(["--value", name], is_flag=kind == "flag")
+        args = ["--value"]
+        expected = True if kind == "flag" else "value"
+        if kind == "option":
+            args.append("value")
+
+    @click.command(params=[param], context_settings={"help_option_names": [help_name]})
+    @click.pass_context
+    def cli(ctx, **values):
+        assert values == {name: expected}
+        assert ctx.get_parameter_source(name) is click.core.ParameterSource.COMMANDLINE
+        click.echo("executed")
+
+    for _ in range(2):
+        result = runner.invoke(cli, args)
+        assert result.exit_code == 0, result.output
+        assert result.output == "executed\n"
+
+        result = runner.invoke(cli, [*args, help_name])
+        assert result.exit_code == 0, result.output
+        assert "Show this message and exit." in result.output
+        assert "executed" not in result.output
+
+    result = runner.invoke(cli, [help_name])
+    assert result.exit_code == 0, result.output
+    assert "Show this message and exit." in result.output
+    assert cli.params == [param]
+
+
+def test_help_option_avoids_multiple_internal_names(runner):
+    @click.command()
+    @click.option("--first", "help")
+    @click.option("--second", "help_")
+    def cli(help, help_):
+        click.echo(f"{help}:{help_}")
+
+    result = runner.invoke(cli, ["--first", "one", "--second", "two"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "one:two\n"
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert "Show this message and exit." in result.output
+
+
+@pytest.mark.parametrize("help_names", [["--help"], ["-h", "--help"]])
+def test_user_help_option_overrides_automatic_help(runner, help_names):
+    @click.command(context_settings={"help_option_names": help_names})
+    @click.option("--help", "value", required=True)
+    def cli(value):
+        click.echo(value)
+
+    result = runner.invoke(cli, ["--help", "value"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "value\n"
+
+    if "-h" in help_names:
+        result = runner.invoke(cli, ["-h"])
+        assert result.exit_code == 0, result.output
+        assert "-h" in result.output
+        assert "Show this message and exit." in result.output
+
+
