+@pytest.mark.parametrize(('text', 'expected'), [
+    ('', []),
+    ('January 28, February 29, 2028 2029',
+     ['January 28, February 29, 2028 2029']),
+    (' \t28 29 2028 2029\t ', [' \t28 29 2028 2029\t ']),
+])
+def test_iter_splitlines_without_line_endings(text, expected):
+    lines = strutils.iter_splitlines(text)
+    assert iter(lines) is lines
+    assert list(lines) == expected
+    assert strutils.indent(text, '>') == ('>' + text if text else '')
+
+
+@pytest.mark.parametrize('separator', [
+    '\r\n', '\n', '\x0b', '\f', '\r', '\x85', '\u2028', '\u2029',
+])
+def test_iter_splitlines_line_endings(separator):
+    assert list(strutils.iter_splitlines(separator)) == ['', '']
+    assert list(strutils.iter_splitlines(separator * 2)) == ['', '', '']
+    assert list(strutils.iter_splitlines('first' + separator + 'last')) == [
+        'first', 'last',
+    ]
+    text = separator + 'January 28' + separator * 2 + 'February 29' + separator
+    assert list(strutils.iter_splitlines(text)) == [
+        '', 'January 28', '', 'February 29', '',
+    ]
+    assert strutils.indent(text, '>') == '\n>January 28\n\n>February 29\n'
+    assert strutils.indent(text, '>', newline='|', key=lambda line: True) == (
+        '>|>January 28|>|>February 29|>'
+    )
+
+
+def test_iter_splitlines_mixed_line_endings():
+    text = '\r\nJanuary 28\u2028\u2029February 29\rMarch 28\n2028\x85\x0b\f2029\r\n'
+    expected = ['', 'January 28', '', 'February 29', 'March 28', '2028', '', '', '2029', '']
+    assert list(strutils.iter_splitlines(text)) == expected
+    assert strutils.indent(text, '  ', newline='\r\n') == (
+        '\r\n  January 28\r\n\r\n  February 29\r\n  March 28\r\n'
+        '  2028\r\n\r\n\r\n  2029\r\n'
+    )
+
+
 def test_is_uuid():
