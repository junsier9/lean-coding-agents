+@pytest.mark.parametrize('deco', [once_per('n'), once_per_args])
+@pytest.mark.parametrize('first,equal,other', [
+    ([1], [1], [2]),
+    ({'a': 1, 'b': 2}, {'b': 2, 'a': 1}, {'a': 2, 'b': 2}),
+    ({1, 2}, {2, 1}, {2, 3}),
+    (([1],), ([1],), ([2],)),
+    (({'a': [{1, 2}]},), ({'a': [{2, 1}]},), ({'a': [{2, 3}]},)),
+])
+def test_once_per_unhashable(deco, first, equal, other):
+    calls = []
+
+    @deco
+    def call(n, x=None):
+        calls.append(n)
+        return len(calls)
+
+    assert call(first) == 1
+    assert call(n=equal) is None
+    assert call(other) == 2
+    assert call(n=other) is None
+    assert call(equal) is None
+    assert calls == [first, other]
+
+
+@pytest.mark.parametrize('deco', [once_per('n'), once_per_args])
+def test_once_per_unhashable_default(deco):
+    calls = []
+
+    @deco
+    def call(n=[1]):
+        calls.append(n)
+        return len(calls)
+
+    assert call() == 1
+    assert call([1]) is None
+    assert call(n=[1]) is None
+    assert calls == [[1]]
+
+
+@pytest.mark.parametrize('deco', [once_per('n'), once_per_args])
+@pytest.mark.parametrize('value', [1, [1]])
+def test_once_per_target_error(deco, value):
+    calls = []
+
+    @deco
+    def call(n):
+        calls.append(n)
+        raise TypeError('target failed')
+
+    with pytest.raises(TypeError, match='target failed'):
+        call(value)
+    assert call(value) is None
+    assert calls == [value]
+
+
+@pytest.mark.parametrize('deco', [once_per('n'), once_per_args])
