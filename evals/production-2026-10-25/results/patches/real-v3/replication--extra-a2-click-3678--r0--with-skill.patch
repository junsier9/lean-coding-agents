+def test_cached_help_option_name_collision(runner):
+    cmd = click.Command("cli", callback=lambda **kwargs: kwargs)
+    ctx = click.Context(cmd)
+    help_option = cmd.get_help_option(ctx)
+    cmd.params.extend(
+        [
+            click.Argument(["help"]),
+            click.Option(["--private", "_help"]),
+            click.Option(["--other-private", "__help"]),
+        ]
+    )
+
+    info = cmd.to_info_dict(ctx)
+    cli_names = [p["name"] for p in info["params"][:3]]
+    assert cli_names == ["help", "_help", "__help"]
+    assert info["params"][-1]["name"] not in cli_names
+    assert info["params"][-1]["opts"] == ["--help"]
+    assert cmd.get_help_option(ctx) is help_option
+
+    result = runner.invoke(
+        cmd,
+        ["value", "--private", "one", "--other-private", "two"],
+        standalone_mode=False,
+    )
+    assert result.exit_code == 0, result.output
+    assert result.return_value == {"help": "value", "_help": "one", "__help": "two"}
+
+
