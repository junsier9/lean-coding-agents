+@pytest.mark.parametrize(
+    ("help_names", "name"),
+    [(["--help"], "help"), (["--show-help"], "show_help"), (["-h"], "h")],
+)
+@pytest.mark.parametrize("kind", ["argument", "option", "flag"])
+def test_help_option_internal_name_collision(runner, help_names, name, kind):
+    if kind == "argument":
+        param = click.Argument([name])
+        args = ["value"]
+        expected = "value"
+    elif kind == "option":
+        param = click.Option(["--value", name], required=True)
+        args = ["--value", "value"]
+        expected = "value"
+    else:
+        param = click.Option(["--value", name], is_flag=True)
+        args = ["--value"]
+        expected = True
+
+    @click.command(context_settings={"help_option_names": help_names}, params=[param])
+    @click.pass_context
+    def cli(ctx, **kwargs):
+        assert ctx.params == {name: expected}
+        assert ctx.get_parameter_source(name) is click.core.ParameterSource.COMMANDLINE
+        click.echo(repr(kwargs[name]))
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0, result.output
+    assert result.output == f"{expected!r}\n"
+
+    for help_args in ([help_names[0]], [*args, help_names[0]]):
+        result = runner.invoke(cli, help_args)
+        assert result.exit_code == 0, result.output
+        assert "Show this message and exit." in result.output
+        assert f"{expected!r}\n" not in result.output
+
+    if kind != "flag":
+        result = runner.invoke(cli, [])
+        assert result.exit_code == 2
+        assert f"Missing {kind}" in result.output
+
+
+@pytest.mark.parametrize("help_names", [["--help"], ["-h", "--help"]])
+def test_explicit_help_option_overrides_automatic_help(runner, help_names):
+    @click.command(context_settings={"help_option_names": help_names})
+    @click.option("--help", "value", required=True)
+    def cli(value):
+        click.echo(value)
+
+    result = runner.invoke(cli, ["--help", "value"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "value\n"
+
+    ctx = click.Context(cli, help_option_names=help_names)
+    assert cli.get_help_option_names(ctx) == [n for n in help_names if n != "--help"]
+
+    if "-h" in help_names:
+        result = runner.invoke(cli, ["-h"])
+        assert result.exit_code == 0, result.output
+        assert "Show this message and exit." in result.output
+    else:
+        assert cli.get_help_option(ctx) is None
+
+
