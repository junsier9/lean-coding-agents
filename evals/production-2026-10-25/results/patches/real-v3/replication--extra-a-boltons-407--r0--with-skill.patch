+@pytest.mark.parametrize('segmented', [False, True])
+@pytest.mark.parametrize('index', [-1000000, -101, -100, -99, -50, -1, 0])
+def test_barrel_list_insert_negative_indices(index, segmented):
+    expected = list(range(100))
+    bl = BarrelList(expected)
+    if segmented:
+        bl._size_factor = 4
+        bl._balance_list(0)
+        assert len(bl.lists) > 1
+
+    expected.insert(index, 'inserted')
+    assert bl.insert(index, 'inserted') is None
+    assert list(bl) == expected
+    assert len(bl) == len(expected)
+
+
+def test_barrel_list_repeated_insert_before_start():
+    expected = list(range(100))
+    bl = BarrelList(expected)
+    bl._size_factor = 4
+    bl._balance_list(0)
+    initial_segments = len(bl.lists)
+    assert initial_segments > 1
+
+    for item in range(-1, -101, -1):
+        index = -10 * len(expected)
+        expected.insert(index, item)
+        bl.insert(index, item)
+        assert list(bl) == expected
+        assert len(bl) == len(expected)
+
+    assert len(bl.lists) > initial_segments
+    with pytest.raises(IndexError):
+        bl[index]
+    with pytest.raises(IndexError):
+        bl[index] = None
+    with pytest.raises(IndexError):
+        del bl[index]
+    with pytest.raises(IndexError):
+        bl.pop(index)
+    assert list(bl) == expected
+
+
