+@pytest.mark.parametrize("unregister_by", ["plugin", "name", "block"])
+def test_unregister_multiple_implementations(
+    pm: PluginManager, unregister_by: str
+) -> None:
+    wrappers = []
+
+    class Plugin:
+        @hookimpl
+        def he_method1(self):
+            return 1
+
+        @hookimpl(specname="he_method1", tryfirst=True)
+        def first(self):
+            return 2
+
+        @hookimpl(specname="he_method1", trylast=True)
+        def last(self):
+            return 3
+
+        @hookimpl(specname="he_method1", wrapper=True)
+        def new_wrapper(self):
+            wrappers.append("new-before")
+            result = yield
+            wrappers.append("new-after")
+            return result
+
+        @hookimpl(specname="he_method1", hookwrapper=True)
+        def old_wrapper(self):
+            wrappers.append("old-before")
+            yield
+            wrappers.append("old-after")
+
+        @hookimpl
+        def he_method2(self):
+            return 4
+
+    class OtherPlugin:
+        @hookimpl
+        def he_method1(self):
+            return 5
+
+        @hookimpl
+        def he_method2(self):
+            return 6
+
+    plugin, other = Plugin(), OtherPlugin()
+    pm.register(plugin, "multiple")
+    pm.register(other, "other")
+    assert pm.hook.he_method1() == [2, 5, 1, 3]
+    assert wrappers == ["old-before", "new-before", "new-after", "old-after"]
+    assert pm.hook.he_method2() == [6, 4]
+
+    if unregister_by == "plugin":
+        assert pm.unregister(plugin) is plugin
+    elif unregister_by == "name":
+        assert pm.unregister(name="multiple") is plugin
+    else:
+        pm.set_blocked("multiple")
+        assert pm.is_blocked("multiple")
+
+    assert pm.get_hookcallers(plugin) is None
+    assert not pm.is_registered(plugin)
+    assert pm.get_hookcallers(other) == [pm.hook.he_method1, pm.hook.he_method2]
+    for hookcaller in (pm.hook.he_method1, pm.hook.he_method2):
+        assert [impl.plugin for impl in hookcaller.get_hookimpls()] == [other]
+    wrappers.clear()
+    assert pm.hook.he_method1() == [5]
+    assert pm.hook.he_method2() == [6]
+    assert wrappers == []
+    assert pm.unregister(name="multiple") is None
+
+
