diff --git a/boltons/mathutils.py b/boltons/mathutils.py
index 668cda6..9188349 100644
--- a/boltons/mathutils.py
+++ b/boltons/mathutils.py
@@ -208,9 +208,13 @@ class Bits:
         return [c == '1' for c in self.as_bin()]
 
     def as_bin(self):
+        if self.len == 0:
+            return ''
         return f'{{0:0{self.len}b}}'.format(self.val)
 
     def as_hex(self):
+        if self.len == 0:
+            return ''
         # make template to pad out to number of bytes necessary to represent bits
         tmpl = f'%0{2 * (self.len // 8 + ((self.len % 8) != 0))}X'
         ret = tmpl % self.val
@@ -234,7 +238,7 @@ class Bits:
     def from_hex(cls, hex):
         if isinstance(hex, bytes):
             hex = hex.decode('ascii')
-        if not hex.startswith('0x'):
+        if not hex.startswith('0x') and hex:
             hex = '0x' + hex
         return cls(hex)
 
