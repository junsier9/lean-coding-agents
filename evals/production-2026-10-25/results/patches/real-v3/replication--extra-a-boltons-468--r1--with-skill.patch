@@ -1,4 +1,4 @@
-from pytest import raises
+from pytest import mark, raises
 from boltons.mathutils import clamp, ceil, floor, Bits
 import math
 
@@ -127,3 +127,70 @@ def test_bits_len_bound():
         Bits(4, 2)
     with raises(ValueError):
         Bits(1, 0)
+
+
+@mark.parametrize('bits', [
+    Bits(''), Bits(b''), Bits([]), Bits(0, 0), Bits('')[:],
+    Bits('101')[:0], Bits('101')[1:1], Bits('101')[3:],
+    Bits('101')[2:1], Bits('1') >> 1,
+])
+def test_bits_empty(bits):
+    assert len(bits) == 0
+    assert bits == Bits('', 0)
+    assert bits != Bits(0)
+    assert bits.as_bin() == ''
+    assert bits.as_hex() == ''
+    assert bits.as_bytes() == b''
+    assert bits.as_list() == []
+    assert bits.as_int() == 0
+    assert repr(bits) == "Bits('')"
+    assert Bits.from_bin(bits.as_bin()) == bits
+    assert Bits.from_hex(bits.as_hex()) == bits
+    assert Bits.from_hex(bits.as_hex().encode('ascii')) == bits
+    assert Bits.from_bytes(bits.as_bytes()) == bits
+    assert Bits.from_list(bits.as_list()) == bits
+    assert Bits.from_int(bits.as_int(), len(bits)) == bits
+    assert bits[:] == bits
+    for index in (0, -1):
+        with raises(IndexError):
+            bits[index]
+
+
+@mark.parametrize('binary, hexadecimal, bytes_', [
+    ('0', '00', b'\x00'),
+    ('0000', '00', b'\x00'),
+    ('00000000', '00', b'\x00'),
+    ('000000000', '0000', b'\x00\x00'),
+    ('1', '01', b'\x01'),
+    ('000000001', '0001', b'\x00\x01'),
+])
+def test_bits_serialization_padding(binary, hexadecimal, bytes_):
+    bits = Bits(binary)
+    assert bits.as_bin() == binary
+    assert bits.as_hex() == hexadecimal
+    assert bits.as_bytes() == bytes_
+    assert Bits.from_hex(hexadecimal) == Bits.from_bytes(bytes_)
+    assert Bits.from_bytes(bytes_).as_bytes() == bytes_
+    assert Bits().as_bin() == Bits(0).as_bin() == '0'
+
+
+@mark.parametrize('value, error', [
+    ('0x', ValueError),
+    (b'0x', ValueError),
+    (' ', ValueError),
+    ('GG', ValueError),
+    (b'\xff', UnicodeDecodeError),
+    (None, AttributeError),
+    (0, AttributeError),
+    (False, AttributeError),
+    ([], AttributeError),
+])
+def test_bits_from_hex_invalid(value, error):
+    with raises(error):
+        Bits.from_hex(value)
+
+
+@mark.parametrize('value', ['', None, 0])
+def test_bits_from_bytes_invalid(value):
+    with raises(TypeError):
+        Bits.from_bytes(value)
