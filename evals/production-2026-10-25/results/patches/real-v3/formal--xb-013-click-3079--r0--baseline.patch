--- a/CHANGES.rst
+++ b/CHANGES.rst
@@ -5,6 +5,8 @@ Version 8.3.x
 
 Unreleased
 
+-   Use the declared default for flags sharing a parameter name regardless of
+    declaration order, while preserving explicitly passed flag values.
 -   Don't discard pager arguments by correctly using ``subprocess.Popen``. :issue:`3039`
     :pr:`3055`
 -   Replace ``Sentinel.UNSET`` default values by ``None`` as they're passed through
diff --git a/src/click/core.py b/src/click/core.py
index cd8052f..f11a763 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -1226,6 +1226,12 @@ class Command:
         for param in iter_params_for_processing(param_order, self.get_params(ctx)):
             _, args = param.handle_parse_result(ctx, opts, args)
 
+        # Shared parameters may replace an unset value with a later default.
+        # Normalize only after all parameters have been processed.
+        for name, value in ctx.params.items():
+            if value is UNSET:
+                ctx.params[name] = None
+
         if args and not ctx.allow_extra_args and not ctx.resilient_parsing:
             ctx.fail(
                 ngettext(
@@ -2535,20 +2541,17 @@ class Parameter:
         # Add parameter's value to the context.
         if (
             self.expose_value
-            # We skip adding the value if it was previously set by another parameter
-            # targeting the same variable name. This prevents parameters competing for
-            # the same name to override each other.
-            and self.name not in ctx.params
+            # A parameter with a shared name may have already been processed.
+            # Allow a later default to replace an unset value, but preserve
+            # any value already set by the command line or an earlier default.
+            and (self.name not in ctx.params or ctx.params[self.name] is UNSET)
         ):
             # Click is logically enforcing that the name is None if the parameter is
             # not to be exposed. We still assert it here to please the type checker.
             assert self.name is not None, (
                 f"{self!r} parameter's name should not be None when exposing value."
             )
-            # Normalize UNSET values to None, as we're about to pass them to the
-            # command function and move them to the pure-Python realm of user-written
-            # code.
-            ctx.params[self.name] = value if value is not UNSET else None
+            ctx.params[self.name] = value
 
         return value, args
 
diff --git a/tests/test_defaults.py b/tests/test_defaults.py
index 3f293e8..a4576b1 100644
--- a/tests/test_defaults.py
+++ b/tests/test_defaults.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -61,6 +63,79 @@ def test_multiple_flag_default(runner):
     assert result.return_value == ((True, False), (True,), (1, -1))
 
 
+@pytest.mark.parametrize("reverse", [False, True])
+@pytest.mark.parametrize(
+    ("default", "expected"),
+    [
+        (True, "upper"),
+        ("lower", "lower"),
+        ("custom", "custom"),
+        (False, "False"),
+        (0, "0"),
+        ("", ""),
+        (None, None),
+        (lambda: "dynamic", "dynamic"),
+    ],
+)
+@pytest.mark.parametrize(
+    "args",
+    [[], ["--upper"], ["--lower"], ["--upper", "--lower"], ["--lower", "--upper"]],
+)
+def test_shared_flag_default(runner, reverse, default, expected, args):
+    def cli(case):
+        return case
+
+    options = [
+        click.option("--upper", "case", flag_value="upper", default=default),
+        click.option("--lower", "case", flag_value="lower"),
+    ]
+
+    if reverse:
+        options.reverse()
+
+    for option in options:
+        cli = option(cli)
+
+    cli = click.command()(cli)
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == (args[-1][2:] if args else expected)
+
+
+def test_shared_flag_default_callback(runner):
+    received = []
+
+    def callback(ctx, param, value):
+        received.append(value)
+        return value.upper()
+
+    @click.command()
+    @click.option("--lower", "case", flag_value="lower")
+    @click.option("--upper", "case", flag_value="upper", default=True, callback=callback)
+    def cli(case):
+        return case
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert result.exception is None
+    assert received == ["upper"]
+    assert result.return_value == "UPPER"
+
+
+@pytest.mark.parametrize(
+    ("default", "expected"), [(None, None), (False, "False"), (0, "0"), ("", "")]
+)
+def test_shared_flag_preserves_first_default(runner, default, expected):
+    @click.command()
+    @click.option("--upper", "case", flag_value="upper", default=default)
+    @click.option("--lower", "case", flag_value="lower", default=True)
+    def cli(case):
+        return case
+
+    result = runner.invoke(cli, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == expected
+
+
