+    def test_illegal_browser_entities(self):
+        for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):
+            for entity in ('&#%d;' % number, '&#x%x;' % number,
+                           '&#X%X;' % number):
+                text = u'x%sy' % entity
+                for source in (text, text.encode('ascii')):
+                    self.assertEqual(replace_entities(source), u'xy')
+                    self.assertEqual(
+                        replace_entities(source, remove_illegal=True), u'xy')
+                    self.assertEqual(
+                        replace_entities(source, remove_illegal=False), text)
+
+    def test_illegal_browser_entities_without_semicolon(self):
+        for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):
+            for entity in ('&#%d' % number, '&#x%x' % number,
+                           '&#X%X' % number):
+                text = u'x%s!' % entity
+                for source in (text, text.encode('ascii')):
+                    for remove_illegal in (True, False):
+                        self.assertEqual(
+                            replace_entities(source,
+                                             remove_illegal=remove_illegal),
+                            text)
+
