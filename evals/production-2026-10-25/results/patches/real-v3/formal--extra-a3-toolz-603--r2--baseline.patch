+class IterableWithLength:
+    def __init__(self, items, length):
+        self.items = items
+        self.length = length
+
+    def __iter__(self):
+        return iter(self.items)
+
+    def __len__(self):
+        return self.length
+
+
+@pytest.mark.parametrize('n', [1, 2, 3, 4, 8])
+@pytest.mark.parametrize('actual, reported', [
+    (0, 1), (0, 4),
+    (1, 0), (1, 2), (1, 5),
+    (4, 0), (4, 3), (4, 5), (4, 8),
+    (5, 1), (5, 4), (5, 6), (5, 9),
+])
+def test_partition_all_incorrect_length(n, actual, reported):
+    seq = IterableWithLength(range(actual), reported)
+    with pytest.raises(LookupError):
+        list(partition_all(n, seq))
+
+
+@pytest.mark.parametrize('n', [1, 2, 3, 4, 8])
+@pytest.mark.parametrize('length', [0, 1, 3, 4, 5, 8, 9])
+def test_partition_all_correct_lengths(n, length):
+    items = list(range(length))
+    expected = [tuple(items[i:i + n]) for i in range(0, length, n)]
+    for seq in (items, tuple(items), IterableWithLength(items, length),
+                iter(items)):
+        assert list(partition_all(n, seq)) == expected
+
+
+def test_partition_all_consumable_sized_iterable():
+    class Consumable(list):
+        def __iter__(self):
+            while self:
+                yield self.pop(0)
+
+    assert list(partition_all(2, Consumable(range(5)))) == [
+        (0, 1), (2, 3), (4,)]
+
+
+def test_partition_all_infinite_iterator():
+    chunks = partition_all(2, itertools.count())
+    assert list(take(3, chunks)) == [(0, 1), (2, 3), (4, 5)]
+
+
 def test_count():
     assert count((1, 2, 3)) == 3
     assert count([]) == 0
