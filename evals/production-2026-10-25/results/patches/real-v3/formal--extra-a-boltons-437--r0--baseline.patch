@@ -110,3 +110,34 @@ def test_bits():
             ).as_int()
         ),
         Bits('101'))
+
+
+@mark.parametrize('constructor', [Bits, Bits.from_int])
+@mark.parametrize('width', [0, 1, 2, 8, 64])
+def test_bits_reject_overflow(constructor, width):
+    for value in (2 ** width, 2 ** width + 1):
+        with raises(ValueError, match='cannot be represented'):
+            constructor(value, width)
+
+
+@mark.parametrize('width', [1, 2, 8, 64])
+def test_bits_maximum_value(width):
+    value = 2 ** width - 1
+    bits = Bits(value, width)
+    assert bits.as_int() == value
+    assert len(bits) == width
+    assert bits.as_bin() == '1' * width
+
+
+@mark.parametrize('value', [0, 1, 2, 4, 256, 2 ** 64])
+def test_bits_inferred_width(value):
+    bits = Bits(value)
+    assert bits.as_int() == value
+    assert bits.as_bin() == format(value, 'b')
+    assert len(bits) == len(bits.as_bin())
+
+
+@mark.parametrize('value', ['100', b'100', '0x4', [True, False, False]])
+def test_bits_reject_converted_overflow(value):
+    with raises(ValueError, match='cannot be represented'):
+        Bits(value, 2)
