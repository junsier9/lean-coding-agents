diff --git a/boltons/mathutils.py b/boltons/mathutils.py
index 668cda6..24a8d72 100644
--- a/boltons/mathutils.py
+++ b/boltons/mathutils.py
@@ -134,6 +134,12 @@ class Bits:
     * list of bools -- good for iterating over or treating as flags
     * hex/bin string -- good for human readability
 
+    Empty values have length zero and serialize to empty strings or bytes.
+
+    >>> empty = Bits('')
+    >>> len(empty), empty.as_bin(), empty.as_hex(), empty.as_bytes()
+    (0, '', '', b'')
+
     '''
     __slots__ = ('val', 'len')
 
@@ -208,9 +214,13 @@ class Bits:
         return [c == '1' for c in self.as_bin()]
 
     def as_bin(self):
+        if self.len == 0:
+            return ''
         return f'{{0:0{self.len}b}}'.format(self.val)
 
     def as_hex(self):
+        if self.len == 0:
+            return ''
         # make template to pad out to number of bytes necessary to represent bits
         tmpl = f'%0{2 * (self.len // 8 + ((self.len % 8) != 0))}X'
         ret = tmpl % self.val
@@ -234,6 +244,8 @@ class Bits:
     def from_hex(cls, hex):
         if isinstance(hex, bytes):
             hex = hex.decode('ascii')
+        if hex == '':
+            return cls(0, 0)
         if not hex.startswith('0x'):
             hex = '0x' + hex
         return cls(hex)
diff --git a/tests/test_mathutils.py b/tests/test_mathutils.py
index 01fcaf2..4a967fa 100644
--- a/tests/test_mathutils.py
+++ b/tests/test_mathutils.py
@@ -1,4 +1,4 @@
-from pytest import raises
+from pytest import mark, raises
 from boltons.mathutils import clamp, ceil, floor, Bits
 import math
 
@@ -127,3 +127,90 @@ def test_bits_len_bound():
         Bits(4, 2)
     with raises(ValueError):
         Bits(1, 0)
+
+
+@mark.parametrize('factory, args', [
+    (Bits, ('',)),
+    (Bits, (b'',)),
+    (Bits, ([],)),
+    (Bits, (0, 0)),
+    (Bits.from_bin, ('',)),
+    (Bits.from_bin, (b'',)),
+    (Bits.from_list, ([],)),
+    (Bits.from_int, (0, 0)),
+    (Bits.from_hex, ('',)),
+    (Bits.from_hex, (b'',)),
+    (Bits.from_bytes, (b'',)),
+    (Bits.from_bytes, (bytearray(),)),
+    (Bits.from_bytes, (memoryview(b''),)),
+])
+def test_bits_empty_conversions(factory, args):
+    bits = factory(*args)
+    assert bits == Bits('', 0)
+    assert bits != Bits('0')
+    assert len(bits) == 0
+    assert bits.as_int() == 0
+    assert bits.as_bin() == ''
+    assert bits.as_hex() == ''
+    assert bits.as_bytes() == b''
+    assert bits.as_list() == []
+    assert repr(bits) == "Bits('')"
+    assert Bits.from_bin(bits.as_bin()) == bits
+    assert Bits.from_hex(bits.as_hex()) == bits
+    assert Bits.from_bytes(bits.as_bytes()) == bits
+    assert Bits.from_list(bits.as_list()) == bits
+    assert Bits.from_int(bits.as_int(), len(bits)) == bits
+    with raises(IndexError):
+        bits[0]
+    with raises(IndexError):
+        bits[-1]
+
+
+@mark.parametrize('source', ['', '0', '1010'])
+@mark.parametrize('key', [
+    slice(None, 0), slice(1, 1), slice(10, None), slice(0, 2, -1),
+])
+def test_bits_empty_slice(source, key):
+    bits = Bits(source)[key]
+    assert bits == Bits('')
+    assert bits.as_bin() == ''
+    assert bits[:] == bits[::-1] == bits
+    assert list(bits) == []
+
+
+@mark.parametrize('width', [1, 4, 8, 9, 16])
+def test_bits_zero_width_preserved(width):
+    bits = Bits(0, width)
+    byte_count = (width + 7) // 8
+    assert len(bits) == width
+    assert bits.as_bin() == '0' * width
+    assert bits.as_list() == [False] * width
+    assert bits.as_hex() == '00' * byte_count
+    assert bits.as_bytes() == b'\x00' * byte_count
+    assert Bits.from_bin(bits.as_bin()) == bits
+    assert Bits.from_hex(bits.as_hex()) == Bits(0, byte_count * 8)
+    assert Bits.from_bytes(bits.as_bytes()) == Bits(0, byte_count * 8)
+    assert Bits() == Bits.from_int(0) == Bits('0')
+
+
+@mark.parametrize('factory, args, error', [
+    (Bits, (-1,), ValueError),
+    (Bits, (1, 0), ValueError),
+    (Bits, ('1', 0), ValueError),
+    (Bits, ('0x',), ValueError),
+    (Bits.from_bin, ('102',), ValueError),
+    (Bits.from_hex, ('0x',), ValueError),
+    (Bits.from_hex, (b'0x',), ValueError),
+    (Bits.from_hex, ('xyz',), ValueError),
+    (Bits.from_hex, (' ',), ValueError),
+    (Bits, (None,), TypeError),
+    (Bits, ((),), TypeError),
+    (Bits.from_hex, (None,), AttributeError),
+    (Bits.from_hex, (0,), AttributeError),
+    (Bits.from_hex, ([],), AttributeError),
+    (Bits.from_bytes, ('',), TypeError),
+    (Bits.from_hex, (b'\xff',), UnicodeDecodeError),
+])
+def test_bits_invalid_inputs(factory, args, error):
+    with raises(error):
+        factory(*args)
