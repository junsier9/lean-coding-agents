+@pytest.mark.parametrize('decorator, same_key', [
+    pytest.param(memoize(), 0, id='memoize'),
+    pytest.param(memoize(key_func=lambda x: x % 2), 2, id='memoize-key-func'),
+    pytest.param(cache(60), 0, id='cache'),
+    pytest.param(cache(timedelta(minutes=1)), 0, id='cache-timedelta'),
+    pytest.param(cache(60, key_func=lambda x: x % 2), 2, id='cache-key-func'),
+])
+def test_memory_decorator_reuse(decorator, same_key):
+    calls = []
+
+    @decorator
+    def inc(x):
+        calls.append(('inc', x))
+        return x + 1
+
+    @decorator
+    def dec(x):
+        calls.append(('dec', x))
+        return x - 1
+
+    for _ in range(2):
+        assert inc(0) == 1
+        assert dec(0) == -1
+        assert inc(1) == 2
+        assert dec(1) == 0
+    assert inc(same_key) == 1
+    assert dec(same_key) == -1
+    assert calls == [('inc', 0), ('dec', 0), ('inc', 1), ('dec', 1)]
+    assert inc.memory is not dec.memory
+
+    inc.invalidate(same_key)
+    inc.invalidate(same_key)
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert dec(0) == -1
+    assert dec(1) == 0
+    assert calls[-1:] == [('inc', 0)]
+    assert len(calls) == 5
+
+    dec.invalidate_all()
+    assert inc(0) == 1
+    assert inc(1) == 2
+    assert dec(0) == -1
+    assert dec(1) == 0
+    assert calls[-2:] == [('dec', 0), ('dec', 1)]
+    assert len(calls) == 7
+
+
