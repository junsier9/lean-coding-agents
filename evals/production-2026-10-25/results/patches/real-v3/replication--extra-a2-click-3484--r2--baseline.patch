+@pytest.mark.parametrize(
+    ("env", "default_map", "args", "expected_value", "expected_sources"),
+    [
+        ({}, None, [], "second", ["DEFAULT", "DEFAULT"]),
+        ({"CLICK_TEST_FIRST": "env"}, None, [], "env", ["ENVIRONMENT", "DEFAULT"]),
+        ({"CLICK_TEST_SECOND": "env"}, None, [], "env", ["DEFAULT", "ENVIRONMENT"]),
+        (
+            {"CLICK_TEST_FIRST": "env"},
+            {"value": "mapped"},
+            [],
+            "env",
+            ["ENVIRONMENT", "DEFAULT_MAP"],
+        ),
+        ({}, {"value": "mapped"}, [], "mapped", ["DEFAULT_MAP", "DEFAULT_MAP"]),
+        (
+            {"CLICK_TEST_SECOND": "env"},
+            None,
+            ["--first", "cli"],
+            "cli",
+            ["COMMANDLINE", "COMMANDLINE"],
+        ),
+    ],
+)
+def test_shared_parameter_source_during_processing(
+    runner, env, default_map, args, expected_value, expected_sources
+):
+    """Each option sees its own source; the final source belongs to the winner."""
+    seen = []
+
+    class SourceType(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            seen.append(("convert", ctx.get_parameter_source(param.name)))
+            return value
+
+    def callback(ctx, param, value):
+        seen.append(("callback", ctx.get_parameter_source(param.name)))
+        return value
+
+    @click.command()
+    @click.option(
+        "--first",
+        "value",
+        default="first",
+        envvar="CLICK_TEST_FIRST",
+        type=SourceType(),
+        callback=callback,
+    )
+    @click.option(
+        "--second",
+        "value",
+        default="second",
+        envvar="CLICK_TEST_SECOND",
+        type=SourceType(),
+        callback=callback,
+    )
+    @click.pass_context
+    def cli(ctx, value):
+        return value, ctx.get_parameter_source("value")
+
+    result = runner.invoke(
+        cli, args, env=env, default_map=default_map, standalone_mode=False
+    )
+    assert result.exception is None
+    sources = [click.ParameterSource[name] for name in expected_sources]
+    assert seen == [
+        (stage, source) for source in sources for stage in ("convert", "callback")
+    ]
+    assert result.return_value == (expected_value, min(sources))
+
