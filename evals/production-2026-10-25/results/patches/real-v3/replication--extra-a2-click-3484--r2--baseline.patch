+@pytest.mark.parametrize("param_cls", [click.Option, click.Argument])
+@pytest.mark.parametrize(
+    ("args", "env", "default_map", "expected_value", "expected_source"),
+    [
+        (
+            ["cli"],
+            {"CLICK_TEST_VALUE": "env"},
+            {"value": "mapped"},
+            "cli",
+            "COMMANDLINE",
+        ),
+        ([], {"CLICK_TEST_VALUE": "env"}, {"value": "mapped"}, "env", "ENVIRONMENT"),
+        ([], {}, {"value": "mapped"}, "mapped", "DEFAULT_MAP"),
+        ([], {}, {"value": ""}, "", "DEFAULT_MAP"),
+        ([], {}, {"value": None}, None, "DEFAULT_MAP"),
+        ([], {}, None, "original", "DEFAULT"),
+    ],
+)
+def test_parameter_source_during_processing(
+    runner, param_cls, args, env, default_map, expected_value, expected_source
+):
+    """Conversion and eager callbacks can inspect their value's source."""
+    seen = []
+
+    class SourceType(click.ParamType):
+        name = "source"
+
+        def convert(self, value, param, ctx):
+            seen.append(("convert", ctx.get_parameter_source(param.name)))
+            return value
+
+    def callback(ctx, param, value):
+        source = ctx.get_parameter_source(param.name)
+        seen.append(("callback", source))
+        # Configuration should only replace a value that used the default.
+        if source in (None, click.ParameterSource.DEFAULT):
+            return "configured"
+        return value
+
+    declarations = ["value"]
+    if param_cls is click.Option:
+        declarations = ["--value"]
+        if args:
+            args = ["--value", *args]
+
+    @click.command()
+    @click.pass_context
+    def cli(ctx, value):
+        return value, ctx.get_parameter_source("value")
+
+    cli.params.append(
+        param_cls(
+            declarations,
+            type=SourceType(),
+            default="original",
+            envvar="CLICK_TEST_VALUE",
+            callback=callback,
+            is_eager=True,
+        )
+    )
+    result = runner.invoke(
+        cli, args, env=env, default_map=default_map, standalone_mode=False
+    )
+    assert result.exception is None
+    source = click.ParameterSource[expected_source]
+    expected_seen = []
+    if expected_value is not None:
+        expected_seen.append(("convert", source))
+    expected_seen.append(("callback", source))
+    assert seen == expected_seen
+    if source is click.ParameterSource.DEFAULT:
+        expected_value = "configured"
+    assert result.return_value == (expected_value, source)
+
+
