+@pytest.fixture(params=[copy.copy, copy.deepcopy, *range(pickle.HIGHEST_PROTOCOL + 1)])
+def roundtrip(request):
+    if callable(request.param):
+        return request.param
+
+    protocol = request.param
+    return lambda value: pickle.loads(pickle.dumps(value, protocol=protocol))
+
+
+@pytest.mark.parametrize("sentinel", Sentinel)
+def test_sentinel_roundtrip(roundtrip, sentinel):
+    restored = roundtrip(sentinel)
+
+    assert restored is sentinel
+    assert restored.name == sentinel.name
+    assert repr(restored) == repr(sentinel)
+    assert str(restored) == str(sentinel)
+
+
+@pytest.mark.parametrize("sentinel", Sentinel)
+@pytest.mark.parametrize("copy_method", [copy.copy, copy.deepcopy])
+def test_sentinel_copy_without_enum_hooks(monkeypatch, sentinel, copy_method):
+    # Older Python versions copy Enum members through the pickle protocol.
+    monkeypatch.delattr(enum.Enum, "__copy__", raising=False)
+    monkeypatch.delattr(enum.Enum, "__deepcopy__", raising=False)
+
+    assert copy_method(sentinel) is sentinel
+
+
+@pytest.mark.parametrize(
+    ("parameter", "effective_default", "runtime_default"),
+    [
+        (click.Option(["--value"]), UNSET, None),
+        (click.Option(["--value/--no-value"]), False, False),
+        (click.Option(["--value"], is_flag=True, multiple=True), (), ()),
+        (click.Argument(["value"], required=False), UNSET, None),
+        (click.Option(["--value"], default=None), None, None),
+        (click.Option(["--value"], default=""), "", ""),
+        (click.Option(["--value"], default=0), 0, 0),
+        (click.Option(["--value"], is_flag=True, default=True), True, True),
+    ],
+)
+def test_parameter_roundtrip(
+    runner, roundtrip, parameter, effective_default, runtime_default
+):
+    restored = roundtrip(parameter)
+
+    assert restored is not parameter
+    assert type(restored) is type(parameter)
+    assert restored.name == parameter.name == "value"
+    assert restored.opts == parameter.opts
+    assert restored.secondary_opts == parameter.secondary_opts
+    assert restored.default == parameter.default
+    if parameter.default is UNSET:
+        assert restored.default is UNSET
+    if isinstance(parameter, click.Option):
+        assert restored.flag_value is parameter.flag_value
+    assert restored.to_info_dict() == parameter.to_info_dict()
+
+    command = click.Command(
+        "test", params=[restored], callback=lambda value: click.echo(repr(value))
+    )
+    with click.Context(command) as ctx:
+        assert restored.get_default(ctx) == effective_default
+
+    result = runner.invoke(command, [])
+    assert result.exit_code == 0
+    assert result.output == f"{runtime_default!r}\n"
