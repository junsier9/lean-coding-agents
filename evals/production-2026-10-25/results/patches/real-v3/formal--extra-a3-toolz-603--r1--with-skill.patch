 from itertools import starmap
 from toolz.utils import raises
 from functools import partial
@@ -356,6 +357,43 @@ def test_partition_all():
     assert list(partition_all(4, iter([obj]*7))) == result
 
 
+@pytest.mark.parametrize('actual_length, reported_length', [
+    (0, 1), (0, 3),
+    (1, 0), (1, 2), (1, 3), (1, 4),
+    (2, 1), (2, 3),
+    (3, 0), (3, 2), (3, 4), (3, 6),
+    (5, 1), (5, 4), (5, 6), (5, 8),
+    (6, 3), (6, 5), (6, 7),
+])
+def test_partition_all_incorrect_length(actual_length, reported_length):
+    class IncorrectLength:
+        def __len__(self):
+            return reported_length
+
+        def __iter__(self):
+            return iter(range(actual_length))
+
+    with pytest.raises(LookupError):
+        list(partition_all(3, IncorrectLength()))
+
+
+@pytest.mark.parametrize('n', [1, 2, 3, 4, 8])
+@pytest.mark.parametrize('data', [[], [1], [1, 2, 3, 4, 5, 6, 7]])
+def test_partition_all_sized_and_unsized(n, data):
+    expected = [tuple(data[i:i + n]) for i in range(0, len(data), n)]
+    assert list(partition_all(n, data)) == expected
+    assert list(partition_all(n, iter(data))) == expected
+
+
+def test_partition_all_padding_value():
+    from toolz.itertoolz import no_pad
+
+    data = [1, no_pad, no_pad]
+    expected = [(1, no_pad), (no_pad,)]
+    assert list(partition_all(2, data)) == expected
+    assert list(partition_all(2, iter(data))) == expected
+
+
 def test_count():
