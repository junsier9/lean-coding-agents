+    def test_negative_size(self):
+        for seq, n, strict in product(
+            ('', 'ABCDEFG'), (-1, -2, -8), (False, True)
+        ):
+            with self.subTest(seq=seq, n=n, strict=strict):
+                with self.assertRaisesRegex(ValueError, 'n must be >= 0'):
+                    mi.sliced(seq, n, strict=strict)
+
+    def test_zero_size(self):
+        for seq, strict in product(('', 'ABCDEFG'), (False, True)):
+            with self.subTest(seq=seq, strict=strict):
+                self.assertEqual(list(mi.sliced(seq, 0, strict=strict)), [])
+
+    def test_empty(self):
+        for strict in (False, True):
+            with self.subTest(strict=strict):
+                self.assertEqual(list(mi.sliced('', 3, strict=strict)), [])
+
+    def test_even_and_strict(self):
+        self.assertEqual(
+            list(mi.sliced('ABCDEFGHI', 3, strict=True)), ['ABC', 'DEF', 'GHI']
+        )
