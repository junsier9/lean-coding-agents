+
+@mark.parametrize('val, len_', [
+    (1, 0), (2, 1), (4, 2), (5, 2), (256, 8), (2 ** 64, 64),
+])
+def test_bits_rejects_length_overflow(val, len_):
+    message = f'value {val} cannot be represented with {len_} bits'
+    with raises(ValueError, match=message):
+        Bits(val, len_)
+    with raises(ValueError, match=message):
+        Bits.from_int(val, len_)
+
+
+@mark.parametrize('val', ['100', b'100', [True, False, False], '0x4'])
+def test_bits_rejects_converted_length_overflow(val):
+    with raises(ValueError, match='value 4 cannot be represented with 2 bits'):
+        Bits(val, 2)
+
+
+@mark.parametrize('len_', [1, 2, 8, 64])
+def test_bits_maximum_value(len_):
+    val = 2 ** len_ - 1
+    bits = Bits(val, len_)
+    assert bits.as_int() == val
+    assert len(bits) == len_
+    assert bits.as_bin() == '1' * len_
+
+
+@mark.parametrize('val', [0, 1, 4, 256, 2 ** 64])
+def test_bits_inferred_length(val):
+    bits = Bits(val)
+    expected = f'{val:b}'
+    assert bits.as_int() == val
+    assert bits.as_bin() == expected
+    assert len(bits) == len(expected)
