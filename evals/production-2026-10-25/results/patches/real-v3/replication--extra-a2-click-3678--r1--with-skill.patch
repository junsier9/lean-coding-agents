+def test_help_option_name_avoids_user_parameters():
+    params = [click.Argument(["help"]), click.Option(["--other", "_help"])]
+    command = click.Command("cli", params=params)
+    ctx = click.Context(command)
+
+    info = command.to_info_dict(ctx)
+    assert [param["name"] for param in info["params"][:2]] == ["help", "_help"]
+    help_info = info["params"][-1]
+    assert help_info["name"] not in {"help", "_help"}
+    assert help_info["opts"] == ["--help"]
+    assert help_info["help"] == "Show this message and exit."
+
+    # Keep the cached object's identity, even if a later parameter uses its name.
+    help_option = command.get_help_option(ctx)
+    command.params.append(click.Option(["--another", help_info["name"]]))
+    assert command.get_help_option(ctx) is help_option
+    assert help_option.name not in {param.name for param in command.params}
+
+
