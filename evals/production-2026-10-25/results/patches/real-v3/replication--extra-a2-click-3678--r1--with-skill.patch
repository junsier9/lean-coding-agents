+@pytest.mark.parametrize("help_name", ["--help", "--my-help"])
+@pytest.mark.parametrize("kind", ["argument", "option", "flag"])
+def test_parameter_name_matches_help_option(runner, help_name, kind):
+    name = help_name[2:].replace("-", "_")
+    if kind == "argument":
+        param = click.Argument([name])
+        args = ["value"]
+        expected = "value"
+    else:
+        param = click.Option(["--value", name], is_flag=kind == "flag")
+        args = ["--value"]
+        expected = True if kind == "flag" else "value"
+        if kind == "option":
+            args.append("value")
+
+    def callback(**kwargs):
+        ctx = click.get_current_context()
+        assert ctx.get_parameter_source(name) is click.core.ParameterSource.COMMANDLINE
+        click.echo(repr(kwargs))
+
+    cli = click.Command(
+        "cli",
+        params=[param],
+        callback=callback,
+        context_settings={"help_option_names": [help_name]},
+    )
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0, result.output
+    assert result.output == repr({name: expected}) + "\n"
+
+    # Help must still bypass required parameters and the command callback.
+    result = runner.invoke(cli, [help_name])
+    assert result.exit_code == 0, result.output
+    assert "Show this message and exit." in result.output
+
+    if kind == "argument":
+        result = runner.invoke(cli, [])
+        assert result.exit_code == 2
+        assert "Missing argument" in result.output
+
+
+@pytest.mark.parametrize("help_name", ["--help", "--my-help"])
+@pytest.mark.parametrize(
+    ("kwargs", "invoke_kwargs", "expected"),
+    [
+        ({}, {}, None),
+        ({"default": "default"}, {}, "default"),
+        ({}, {"default_map": {"help": "mapped", "my_help": "mapped"}}, "mapped"),
+        ({"envvar": "VALUE"}, {"env": {"VALUE": "environment"}}, "environment"),
+    ],
+)
+def test_parameter_name_matches_help_option_defaults(
+    runner, help_name, kwargs, invoke_kwargs, expected
+):
+    name = help_name[2:].replace("-", "_")
+    cli = click.Command(
+        "cli",
+        params=[click.Option(["--value", name], **kwargs)],
+        callback=lambda **values: click.echo(repr(values)),
+        context_settings={"help_option_names": [help_name]},
+    )
+    result = runner.invoke(cli, [], **invoke_kwargs)
+    assert result.exit_code == 0, result.output
+    assert result.output == repr({name: expected}) + "\n"
+
+
+@pytest.mark.parametrize("help_names", [["--help"], ["--help", "-h"]])
+def test_explicit_help_option_overrides_automatic_help(runner, help_names):
+    @click.command(context_settings={"help_option_names": help_names})
+    @click.option("--help", default="default")
+    def cli(help):
+        click.echo(help)
+
+    result = runner.invoke(cli, ["--help", "value"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "value\n"
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0, result.output
+    assert result.output == "default\n"
+
+    if "-h" in help_names:
+        result = runner.invoke(cli, ["-h"])
+        assert result.exit_code == 0, result.output
+        assert "Show this message and exit." in result.output
+
+
