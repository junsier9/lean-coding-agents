         self.assertEqual(replace_entities('x&#153;y', encoding='cp1252'), u'x\u2122y')
         self.assertEqual(replace_entities('x&#x99;y', encoding='cp1252'), u'x\u2122y')
 
+    def test_browser_hack_illegal_entities(self):
+        # These five code points have no Windows-1252 character mapping.
+        for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):
+            for template in (u'&#%d;', u'&#x%x;', u'&#X%X;'):
+                entity = template % number
+                text = u'x%s&#153;&amp;y' % entity
+                for value in (text, text.encode('ascii')):
+                    self.assertEqual(replace_entities(value), u'x\u2122&y')
+                    self.assertEqual(replace_entities(value, remove_illegal=True),
+                                     u'x\u2122&y')
+                    self.assertEqual(replace_entities(value, remove_illegal=False),
+                                     u'x%s\u2122&y' % entity)
+
+    def test_browser_hack_illegal_entities_without_semicolon(self):
+        # Keep invalid references without a semicolon, like other illegal entities.
+        for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):
+            for template in (u'&#%d', u'&#x%x', u'&#X%X'):
+                entity = template % number
+                text = u'x%s!&#153;&amp;y' % entity
+                expected = u'x%s!\u2122&y' % entity
+                for value in (text, text.encode('ascii')):
+                    self.assertEqual(replace_entities(value), expected)
+                    self.assertEqual(replace_entities(value, remove_illegal=True),
+                                     expected)
+                    self.assertEqual(replace_entities(value, remove_illegal=False),
+                                     expected)
+
