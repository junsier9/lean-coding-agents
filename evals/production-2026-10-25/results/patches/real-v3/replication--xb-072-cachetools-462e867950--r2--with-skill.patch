+
+    def test_pickle(self):
+        for key in (cachetools.keys.hashkey, cachetools.keys.typedkey):
+            for args, kwargs in [((), {}), (('value',), {}),
+                                 ((), {'x': 'value', 'y': 1}),
+                                 (('value',), {'x': 'other', 'y': 1})]:
+                expected = key(*args, **kwargs)
+                for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+                    for hashed in (False, True):
+                        source = key(*args, **kwargs)
+                        if hashed:
+                            hash(source)
+                        restored = pickle.loads(pickle.dumps(source, protocol))
+                        self.assertIs(type(restored), type(source))
+                        self.assertEqual(restored, expected)
+                        self.assertEqual(hash(restored), hash(expected))
+                        self.assertEqual(hash(restored), hash(tuple(restored)))
+                        self.assertEqual({restored: 'hit'}[expected], 'hit')
+
+    def test_pickle_unhashable(self):
+        for key in (cachetools.keys.hashkey, cachetools.keys.typedkey):
+            for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+                source = key([], x={})
+                restored = pickle.loads(pickle.dumps(source, protocol))
+                self.assertEqual(restored, source)
+                with self.assertRaises(TypeError):
+                    hash(restored)
+
+    def test_pickle_other_interpreter(self):
+        code = '''
+import base64
+import pickle
+import sys
+
+from cachetools import Cache
+from cachetools.keys import hashkey, typedkey
+
+cache = Cache(maxsize=4)
+for key in (hashkey, typedkey):
+    cache[key('value')] = 'positional'
+    cache[key('value', x='other')] = 'keyword'
+sys.stdout.write(base64.b64encode(pickle.dumps(cache)).decode('ascii'))
+'''
+        for seed in ('1', '2'):
+            env = os.environ.copy()
+            env['PYTHONHASHSEED'] = seed
+            data = subprocess.check_output([sys.executable, '-c', code], env=env)
+            cache = pickle.loads(base64.b64decode(data))
+            for stored in cache:
+                self.assertEqual(hash(stored), hash(tuple(stored)))
+            for key in (cachetools.keys.hashkey, cachetools.keys.typedkey):
+                self.assertEqual(cache[key('value')], 'positional')
+                self.assertEqual(cache[key('value', x='other')], 'keyword')
