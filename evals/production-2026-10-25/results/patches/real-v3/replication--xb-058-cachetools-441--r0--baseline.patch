+    def test_ttl_datetime_overflow(self):
+        from datetime import datetime, timedelta
+
+        now = datetime.max
+        cache = TTLCache[int, int, datetime](
+            maxsize=1, ttl=timedelta(days=1), timer=lambda: now
+        )
+
+        with self.assertRaises(OverflowError):
+            cache[1] = 1
+
+        self.assertNotIn(1, cache)
+        with self.assertRaises(KeyError):
+            cache[1]
+        self.assertIsNone(cache.get(1))
+        self.assertEqual(0, len(cache))
+        self.assertEqual(0, cache.currsize)
+        self.assertEqual([], list(cache))
+        self.assertEqual([], cache.expire())
+
+        now = datetime(2026, 1, 1)
+        cache[1] = 1
+        self.assertEqual(1, cache[1])
+        cache[2] = 2
+        self.assertNotIn(1, cache)
+        self.assertEqual((2, 2), cache.popitem())
+
+    def test_ttl_datetime_overflow_no_eviction(self):
+        from datetime import datetime, timedelta
+
+        now = datetime.max - timedelta(days=2)
+        cache = TTLCache[int, str, datetime](
+            maxsize=3, ttl=timedelta(days=2), timer=lambda: now, getsizeof=len
+        )
+        cache[1] = "a"
+        cache[2] = "bb"
+        now += timedelta(days=1)
+
+        with self.assertRaises(OverflowError):
+            cache[3] = "cc"
+
+        self.assertNotIn(3, cache)
+        self.assertIn(1, cache)
+        self.assertIn(2, cache)
+        self.assertEqual(2, len(cache))
+        self.assertEqual(3, cache.currsize)
+        self.assertEqual([1, 2], list(cache))
+        self.assertEqual((1, "a"), cache.popitem())
+        self.assertEqual((2, "bb"), cache.popitem())
+        self.assertEqual(0, cache.currsize)
+
+    def test_ttl_datetime_overflow_overwrite(self):
+        from datetime import datetime, timedelta
+
+        now = datetime.max - timedelta(days=2)
+        cache = TTLCache[int, str, datetime](
+            maxsize=4, ttl=timedelta(days=2), timer=lambda: now, getsizeof=len
+        )
+        cache[1] = "a"
+        cache[2] = "bb"
+        now += timedelta(days=1)
+
+        with self.assertRaises(OverflowError):
+            cache[1] = "cc"
+
+        self.assertEqual(2, len(cache))
+        self.assertEqual(3, cache.currsize)
+        self.assertEqual([1, 2], list(cache))
+        self.assertEqual((1, "a"), cache.popitem())
+        self.assertEqual("bb", cache[2])
+        self.assertEqual([(2, "bb")], cache.expire(datetime.max))
+        self.assertEqual(0, len(cache))
+        self.assertEqual(0, cache.currsize)
+
