+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize("error_type", [None, ValueError, KeyboardInterrupt, SystemExit])
+def test_plugin_tracing_unprintable(
+    pm: PluginManager, firstresult: bool, error_type: type[BaseException] | None
+) -> None:
+    class Unprintable:
+        def __str__(self) -> str:
+            raise ValueError("cannot stringify")
+
+        def __repr__(self) -> str:
+            raise RuntimeError("cannot represent")
+
+    class Api:
+        @hookspec(firstresult=firstresult)
+        def hello(self, arg: object) -> object: ...
+
+    value = Unprintable()
+    seen = []
+    error = error_type() if error_type is not None else None
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg: object) -> object:
+            seen.append(arg)
+            if error is not None:
+                raise error
+            return arg
+
+    pm.add_hookspecs(Api)
+    pm.register(Plugin())
+    trace_out: list[str] = []
+    pm.trace.root.setwriter(trace_out.append)
+    processed = []
+    pm.trace.root.setprocessor("hook", lambda tags, args: processed.append(args))
+    pm.enable_tracing()
+
+    if error_type is not None:
+        with pytest.raises(error_type) as excinfo:
+            pm.hook.hello(arg=value)
+        assert excinfo.value is error
+        assert len(trace_out) == 1
+    else:
+        result = pm.hook.hello(arg=value)
+        assert (result if firstresult else result[0]) is value
+        result_type = "Unprintable" if firstresult else "list"
+        assert trace_out[1] == (
+            f"  finish hello --> <unprintable {result_type} object> [hook]\n"
+        )
+        assert processed[1][-1] is result
+    assert len(seen) == 1 and seen[0] is value
+    assert processed[0][-1]["arg"] is value
+    assert trace_out[0] == (
+        "  hello [hook]\n      arg: <unprintable Unprintable object>\n"
+    )
+    assert pm.trace.root.indent == 0
+
+
+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize("custom_representation", [False, True])
+def test_plugin_tracing_unicode(
+    pm: PluginManager, firstresult: bool, custom_representation: bool
+) -> None:
+    text = "caf\u00e9 \u4e2d\u6587 \U0001f680\ud800\udfff"
+    escaped = "caf\u00e9 \u4e2d\u6587 \U0001f680\\ud800\\udfff"
+
+    class UnicodeRepresentation:
+        def __str__(self) -> str:
+            return text
+
+        def __repr__(self) -> str:
+            return text
+
+    class Api:
+        @hookspec(firstresult=firstresult)
+        def hello(self, arg: object) -> object: ...
+
+    class Plugin:
+        @hookimpl
+        def hello(self, arg: object) -> object:
+            return arg
+
+    value = UnicodeRepresentation() if custom_representation else text
+    expected_result = escaped
+    if not firstresult:
+        expected_result = f"[{escaped if custom_representation else repr(text)}]"
+    pm.add_hookspecs(Api)
+    pm.register(Plugin())
+    pm.enable_tracing()
+    buffer = io.BytesIO()
+    with io.TextIOWrapper(buffer, encoding="utf-8", newline="\n") as writer:
+        pm.trace.root.setwriter(writer.write)
+        result = pm.hook.hello(arg=value)
+        assert (result if firstresult else result[0]) is value
+        writer.flush()
+        assert buffer.getvalue().decode("utf-8") == (
+            f"  hello [hook]\n      arg: {escaped}\n"
+            f"  finish hello --> {expected_result} [hook]\n"
+        )
+    assert pm.trace.root.indent == 0
+
+
