+def test_unicode_output(rootlogger: TagTracer, text: str, escaped: str) -> None:
+    buffer = io.BytesIO()
+    with io.TextIOWrapper(buffer, encoding="utf-8", newline="\n") as writer:
+        rootlogger.setwriter(writer.write)
+        rootlogger.get(text)(text, {text: text})
+        writer.flush()
+        assert buffer.getvalue().decode("utf-8") == (
+            f"{escaped} [{escaped}]\n    {escaped}: {escaped}\n"
+        )
