+@pytest.mark.parametrize("name", [None, "invalid"])
+def test_register_none(pm: PluginManager, name: str | None) -> None:
+    with pytest.raises(ValueError, match="None"):
+        pm.register(None, name=name)
+
+    assert pm.list_name_plugin() == []
+    assert pm.get_plugins() == set()
+    assert not pm.is_registered(None)
+    assert not pm.is_blocked(name or pm.get_canonical_name(None))
+
+    plugin = object()
+    registered_name = pm.register(plugin, name=name)
+    assert registered_name is not None
+    assert pm.get_plugin(registered_name) is plugin
+    assert pm.is_registered(plugin)
+    assert pm.get_plugins() == {plugin}
+
+
+@pytest.mark.parametrize("blocked", [False, True])
+def test_register_none_existing_name(pm: PluginManager, blocked: bool) -> None:
+    plugin = object()
+    pm.register(plugin, name="existing")
+    if blocked:
+        pm.set_blocked("existing")
+    registrations = pm.list_name_plugin()
+    plugins = pm.get_plugins()
+
+    with pytest.raises(ValueError, match="None"):
+        pm.register(None, name="existing")
+
+    assert pm.list_name_plugin() == registrations
+    assert pm.get_plugins() == plugins
+    assert pm.is_blocked("existing") is blocked
+
+
+@pytest.mark.parametrize("plugin", [False, 0, "", ()])
+def test_register_falsy_plugin(pm: PluginManager, plugin: object) -> None:
+    name = pm.register(plugin)
+    assert name is not None
+    assert pm.get_plugin(name) is plugin
+    assert pm.get_plugins() == {plugin}
+
+
 def test_pm(pm: PluginManager) -> None:
