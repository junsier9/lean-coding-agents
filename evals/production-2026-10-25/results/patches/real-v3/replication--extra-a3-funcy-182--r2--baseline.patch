+@pytest.mark.parametrize('decorator_factory', [
+    memoize,
+    lambda **kwargs: cache(60, **kwargs),
+    lambda **kwargs: cache(timedelta(seconds=60), **kwargs),
+], ids=['memoize', 'cache-seconds', 'cache-timedelta'])
+@pytest.mark.parametrize('key_func, matching_arg', [
+    (None, 1),
+    (lambda x: x % 2, 3),
+], ids=['default-key', 'custom-key'])
+def test_memory_decorator_reuse(decorator_factory, key_func, matching_arg):
+    decorate = decorator_factory(key_func=key_func)
+    calls = []
+
+    @decorate
+    def first(x):
+        calls.append(('first', x))
+        return x + 1
+
+    @decorate
+    def second(x):
+        calls.append(('second', x))
+        return x + 2
+
+    assert first(x=1) == 2
+    assert second(x=1) == 3
+    assert first(x=matching_arg) == 2
+    assert second(x=matching_arg) == 3
+    assert calls == [('first', 1), ('second', 1)]
+    assert first.memory is not second.memory
+
+    first.invalidate(x=matching_arg)
+    assert first(x=1) == 2
+    assert second(x=1) == 3
+    assert calls == [('first', 1), ('second', 1), ('first', 1)]
+
+    second.invalidate_all()
+    assert first(x=1) == 2
+    assert second(x=1) == 3
+    assert calls == [('first', 1), ('second', 1), ('first', 1), ('second', 1)]
+
+    first.memory.clear()
+    assert first(x=1) == 2
+    assert second(x=1) == 3
+    assert calls == [('first', 1), ('second', 1), ('first', 1), ('second', 1), ('first', 1)]
+
