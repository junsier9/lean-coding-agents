         assert value is not real_value
 
     assert value not in real_values
+
+
+@pytest.mark.parametrize("sentinel", list(Sentinel))
+@pytest.mark.parametrize("copy_func", [copy.copy, copy.deepcopy])
+def test_copy_sentinel(sentinel, copy_func):
+    assert copy_func(sentinel) is sentinel
+
+
+@pytest.mark.parametrize("sentinel", list(Sentinel))
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_pickle_sentinel(sentinel, protocol):
+    assert pickle.loads(pickle.dumps(sentinel, protocol=protocol)) is sentinel
+
+
+@pytest.mark.parametrize(
+    "copy_func",
+    [
+        copy.copy,
+        copy.deepcopy,
+        pytest.param(lambda value: pickle.loads(pickle.dumps(value)), id="pickle"),
+    ],
+)
+@pytest.mark.parametrize(
+    ("kwargs", "expected_default", "expected_value"),
+    [
+        ({}, UNSET, None),
+        ({"is_flag": True}, False, False),
+        ({"is_flag": True, "multiple": True}, (), ()),
+    ],
+)
+def test_copy_option(copy_func, kwargs, expected_default, expected_value):
+    option = click.Option(["--value"], **kwargs)
+    restored = copy_func(option)
+
+    assert restored is not option
+    assert restored.name == option.name == "value"
+    assert restored.opts == option.opts == ["--value"]
+    assert restored.default is UNSET
+    assert restored.flag_value is UNSET
+
+    command = click.Command("test", params=[restored])
+
+    with command.make_context("test", []) as ctx:
+        assert restored.get_default(ctx) == expected_default
+        assert ctx.params == {"value": expected_value}
