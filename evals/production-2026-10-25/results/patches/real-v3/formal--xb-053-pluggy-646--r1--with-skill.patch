+@pytest.mark.parametrize("action", ["plugin", "name", "block"])
+def test_unregister_multiple_implementations(he_pm: PluginManager, action: str) -> None:
+    class Plugin:
+        @hookimpl(trylast=True)
+        def he_method1(self, arg):
+            return arg + 1
+
+        @hookimpl(specname="he_method1", tryfirst=True)
+        def another_method(self, arg):
+            return arg + 2
+
+        @hookimpl(specname="he_method1", wrapper=True)
+        def wrap_method(self):
+            return (yield)
+
+        @hookimpl(specname="he_method1", hookwrapper=True)
+        def old_wrap_method(self):
+            yield
+
+    class OtherPlugin:
+        @hookimpl
+        def he_method1(self, arg):
+            return arg * 10
+
+        @hookimpl(specname="he_method1", tryfirst=True)
+        def another_method(self, arg):
+            return arg * 100
+
+    plugin, other_plugin = Plugin(), OtherPlugin()
+    he_pm.register(plugin, "multiple")
+    he_pm.register(other_plugin)
+    hook = he_pm.hook.he_method1
+    remaining_impls = [
+        impl for impl in hook.get_hookimpls() if impl.plugin is other_plugin
+    ]
+    assert hook(arg=1) == [100, 3, 10, 2]
+
+    if action == "plugin":
+        assert he_pm.unregister(plugin) is plugin
+    elif action == "name":
+        assert he_pm.unregister(name="multiple") is plugin
+    else:
+        he_pm.set_blocked("multiple")
+        assert he_pm.is_blocked("multiple")
+
+    assert not he_pm.is_registered(plugin)
+    assert he_pm.get_hookcallers(plugin) is None
+    assert hook.get_hookimpls() == remaining_impls
+    assert hook(arg=1) == [100, 10]
+
+    with pytest.raises(ValueError, match="not found"):
+        hook._remove_plugin(plugin)
+    assert hook.get_hookimpls() == remaining_impls
+
+    assert he_pm.unregister(other_plugin) is other_plugin
+    assert hook.get_hookimpls() == []
+    assert hook(arg=1) == []
+
+
