+@parametrize("function", [_.xor, _.xor_by, _.xor_with])
+@parametrize("factory", [tuple, iter, lambda values: (value for value in values)])
+@parametrize("position", [0, 1, 2])
+def test_xor_mixed_iterables(function, factory, position):
+    arrays = [[1, 2, 5, 5], [2, 3, 5], [3, 4, 5]]
+    inputs = arrays[:]
+    inputs[position] = factory(inputs[position])
+
+    assert function(*inputs) == [1, 4, 5]
+    assert arrays == [[1, 2, 5, 5], [2, 3, 5], [3, 4, 5]]
+
+
+@parametrize("function", [_.xor, _.xor_by, _.xor_with])
+@parametrize("factory", [list, tuple, iter, lambda values: (value for value in values)])
+@parametrize("values", [[], [3, 1, 3, 2]])
+def test_xor_single_iterable(function, factory, values):
+    expected = values[:]
+    array = factory(values)
+    result = function(array)
+
+    assert isinstance(result, list)
+    assert result == expected
+    assert result is not array
+    assert values == expected
+
+
+@parametrize(
+    "function,keyword,rule",
+    [
+        (_.xor_by, "iteratee", "id"),
+        (_.xor_with, "comparator", lambda left, right: left["id"] == right["id"]),
+    ],
+)
+@parametrize("factory", [tuple, iter, lambda values: (value for value in values)])
+@parametrize("as_keyword", [False, True])
+def test_xor_rules_iterables(function, keyword, rule, factory, as_keyword):
+    arrays = [[{"id": 1}], [{"id": 2}], [{"id": 1, "name": "updated"}]]
+    inputs = [factory(array) for array in arrays]
+
+    if as_keyword:
+        result = function(*inputs, **{keyword: rule})
+    else:
+        result = function(*inputs, rule)
+
+    assert result == [{"id": 2}]
+    assert result[0] is arrays[1][0]
+    assert arrays == [[{"id": 1}], [{"id": 2}], [{"id": 1, "name": "updated"}]]
+
+
+@parametrize("function", [_.xor, _.xor_by, _.xor_with])
+@parametrize("position", [0, 1])
+def test_xor_iteration_error(function, position):
+    def broken_values():
+        yield 1
+        raise ValueError("iteration failed")
+
+    inputs = [[1, 2], [2, 3]]
+    inputs[position] = broken_values()
+
+    with pytest.raises(ValueError, match="iteration failed"):
+        function(*inputs)
+
