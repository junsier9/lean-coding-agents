    "correction": "The initial probe wrongly assumed dict.pop on an empty dictionary must hash an unhashable key. All three variants failed that probe assumption. It was corrected to seed a nonempty dictionary for the hashability-error check; empty-cache behavior is recorded separately as an unspecified-input observation, not a candidate defect. No candidate bytes changed.",
    "source_sha256": "B8B75C8E21287C08886F8BC0B2747DB9F8D63D5150D51925782A8579649FBFFA",
    "source": "import gc\nimport json\nfrom pathlib import Path\nimport sys\nimport weakref\n\nsys.dont_write_bytecode = True\nsys.path.insert(0, str(Path(sys.argv[1]).resolve()))\nfrom funcy import cache\n\n\ndef require(condition, message):\n    if not condition:\n        raise AssertionError(message)\n\n\ndef missing_no_evaluation():\n    calls = []\n    @cache(60)\n    def value(key):\n        calls.append(key)\n        return key\n    first = value.invalidate('missing')\n    second = value.invalidate('missing')\n    require(first is None and second is None, 'invalidate return contract')\n    require(calls == [], 'invalidation evaluated the cached function')\n    return {'returns_none_twice': True, 'function_calls': calls}\n\n\ndef recompute_and_preserve_other_key():\n    calls = []\n    @cache(60)\n    def value(key):\n        calls.append(key)\n        return key + str(calls.count(key))\n    require(value('a') == 'a1' and value('b') == 'b1', 'first computation')\n    require(value.invalidate('a') is None, 'hit invalidate return')\n    require(value.invalidate('a') is None, 'repeat invalidate return')\n    require(value('b') == 'b1', 'unrelated key changed')\n    require(value('a') == 'a2' and value('a') == 'a2', 'invalidated key not recomputed then cached')\n    require(calls == ['a', 'b', 'a'], 'unexpected calculation count')\n    return {'calls': calls, 'unrelated_key_retained': True}\n\n\ndef custom_key_keyword_arguments():\n    calls = []\n    @cache(60, key_func=lambda x, by=1: x)\n    def multiply(x, by=1):\n        calls.append([x, by])\n        return x * by\n    require(multiply(2, by=3) == 6, 'initial value')\n    require(multiply(2, by=4) == 6, 'custom cache key not honored')\n    require(multiply.invalidate(x=2, by=4) is None, 'keyword invalidation')\n    require(multiply.invalidate(2, by=5) is None, 'equivalent repeat invalidation')\n    require(multiply(2, by=4) == 8, 'custom key not invalidated')\n    require(calls == [[2, 3], [2, 4]], 'unexpected calculation count')\n    return {'calls': calls, 'positional_and_keyword_invalidation': True}\n\n\ndef clearing_all_and_then_invalidating():\n    calls = []\n    @cache(60)\n    def value(key):\n        calls.append(key)\n        return key\n    value('a')\n    value('b')\n    require(value.invalidate_all() is None and value.invalidate_all() is None, 'clear return')\n    require(value.invalidate('a') is None and value.invalidate('b') is None, 'already-cleared keys')\n    value('a')\n    value('b')\n    require(calls == ['a', 'b', 'a', 'b'], 'all-key cleanup failed')\n    return {'calls': calls}\n\n\ndef key_errors_remain_errors():\n    observed = []\n    for error_type in (KeyError, TypeError, ValueError, RuntimeError):\n        failure = error_type('key failed')\n        calls = []\n        def key_func(*args, **kwargs):\n            raise failure\n        @cache(60, key_func=key_func)\n        def value(key):\n            calls.append(key)\n            return key\n        caught = None\n        try:\n            value.invalidate('a')\n        except BaseException as error:\n            caught = error\n        require(caught is failure, 'key_func exception was swallowed or replaced')\n        require(calls == [], 'invalidation evaluated value function')\n        observed.append(error_type.__name__)\n    @cache(60, key_func=lambda key: key)\n    def unhashable(key):\n        return key\n    unhashable('existing')\n    caught = None\n    try:\n        unhashable.invalidate([])\n    except BaseException as error:\n        caught = error\n    require(isinstance(caught, TypeError), 'unhashable key should still fail')\n    return {'key_func_exceptions_preserved': observed, 'unhashable_key_type_error': True}\n\n\ndef expiration_then_calculation_failure():\n    calls = []\n    failure = RuntimeError('fresh calculation failed')\n    @cache(0)\n    def value(key):\n        calls.append(key)\n        if len(calls) > 1:\n            raise failure\n        return 'old'\n    require(value('a') == 'old', 'initial cache value')\n    caught = None\n    try:\n        value('a')\n    except BaseException as error:\n        caught = error\n    require(caught is failure, 'fresh calculation exception changed')\n    require(value.invalidate('a') is None, 'expired entry not safely absent')\n    require(value.invalidate('a') is None, 'repeated expired invalidation')\n    return {'function_calls': calls, 'fresh_error_propagated': True}\n\n\ndef release_cached_references():\n    released = []\n    class Value:\n        def __init__(self, key):\n            self.key = key\n        def __del__(self):\n            released.append(self.key)\n    @cache(60)\n    def value(key):\n        return Value(key)\n    first, second = value('a'), value('b')\n    first_ref, second_ref = weakref.ref(first), weakref.ref(second)\n    del first\n    value.invalidate('a')\n    gc.collect()\n    require(first_ref() is None, 'single-key invalidation retained cache value')\n    require(second_ref() is second, 'unrelated cached reference released')\n    del second\n    value.invalidate_all()\n    gc.collect()\n    require(second_ref() is None, 'all-key invalidation retained cache value')\n    require(sorted(released) == ['a', 'b'], 'cleanup observations differ')\n    return {'released': sorted(released), 'single_key_and_all_key_release': True}\n\n\ndef cached_none_is_removed():\n    calls = []\n    @cache(60)\n    def value(key):\n        calls.append(key)\n        return None\n    require(value('a') is None and value('a') is None, 'cached None result')\n    require(calls == ['a'], 'None was not cached')\n    value.invalidate('a')\n    value.invalidate('a')\n    require(value('a') is None and calls == ['a', 'a'], 'None cache entry not invalidated')\n    return {'calls': calls}\n\n\nresults = {}\nfor function in (missing_no_evaluation, recompute_and_preserve_other_key,\n                 custom_key_keyword_arguments, clearing_all_and_then_invalidating,\n                 key_errors_remain_errors, expiration_then_calculation_failure,\n                 release_cached_references, cached_none_is_removed):\n    try:\n        results[function.__name__] = {'passed': True, 'observed': function()}\n    except BaseException as error:\n        results[function.__name__] = {'passed': False, 'exception': type(error).__name__,\n                                    'message': str(error)}\n@cache(60, key_func=lambda key: [])\ndef empty_unhashable(key):\n    return key\ntry:\n    value = empty_unhashable.invalidate('a')\n    empty_observation = {'return': value, 'exception': None}\nexcept BaseException as error:\n    empty_observation = {'return': None, 'exception': type(error).__name__}\nprint(json.dumps({'package_path': str(Path(sys.modules['funcy'].__file__).resolve()),\n                  'results': results, 'passed': sum(item['passed'] for item in results.values()),\n                  'total': len(results), 'out_of_contract_observation_empty_unhashable': empty_observation}))\n",
    "temporary_work_directory_removed": true
