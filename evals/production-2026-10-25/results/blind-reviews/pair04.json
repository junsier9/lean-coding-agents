    "source_sha256": "69C28A84E1A8F2056BFEFC485B6CADC413FCBE05E66B34A4697DCB48AA183C63",
    "source": "import json\nfrom pathlib import Path\nimport sys\n\nsys.dont_write_bytecode = True\nsys.path.insert(0, str(Path(sys.argv[1]).resolve()))\nimport pluggy\n\nhookspec = pluggy.HookspecMarker('review')\nhookimpl = pluggy.HookimplMarker('review')\n\n\ndef require(condition, message):\n    if not condition:\n        raise AssertionError(message)\n\n\nclass Spec:\n    @hookspec\n    def process(self, value):\n        pass\n    @hookspec\n    def secondary(self, value):\n        pass\n\n\nclass Plugin:\n    def __init__(self, label, events):\n        self.label, self.events, self.failure = label, events, None\n    @hookimpl\n    def process(self, value):\n        self.events.append(self.label + ':main')\n        if self.failure is not None:\n            raise self.failure\n        return self.label + ':main'\n    @hookimpl(specname='process')\n    def alias(self, value):\n        self.events.append(self.label + ':alias')\n        return self.label + ':alias'\n    @hookimpl(specname='process', wrapper=True)\n    def modern(self, value):\n        self.events.append(self.label + ':modern-enter')\n        try:\n            result = yield\n            return result\n        finally:\n            self.events.append(self.label + ':modern-exit')\n    @hookimpl(specname='process', hookwrapper=True)\n    def legacy(self, value):\n        self.events.append(self.label + ':legacy-enter')\n        try:\n            yield\n        finally:\n            self.events.append(self.label + ':legacy-exit')\n    @hookimpl\n    def secondary(self, value):\n        return self.label + ':secondary'\n\n\ndef setup():\n    manager = pluggy.PluginManager('review')\n    manager.add_hookspecs(Spec)\n    events = []\n    target, other = Plugin('target', events), Plugin('other', events)\n    manager.register(target, 'target')\n    manager.register(other, 'other')\n    return manager, target, other, events\n\n\ndef query_once_per_caller():\n    manager, target, other, events = setup()\n    callers = manager.get_hookcallers(target)\n    require(len(callers) == len({id(caller) for caller in callers}) == 2, 'duplicate hook callers')\n    require({caller.name for caller in callers} == {'process', 'secondary'}, 'missing caller')\n    return {'names': [caller.name for caller in callers], 'unique_callers': True}\n\n\ndef unregister_variant(mode):\n    manager, target, other, events = setup()\n    hook = manager.hook.process\n    live_list = hook._hookimpls\n    before = hook(value=1)\n    other_impls = [impl for impl in hook.get_hookimpls() if impl.plugin is other]\n    expected = [value for value in before if value.startswith('other:')]\n    events.clear()\n    if mode == 'object':\n        require(manager.unregister(target) is target, 'object unregister return')\n    elif mode == 'name':\n        require(manager.unregister(name='target') is target, 'name unregister return')\n    else:\n        manager.set_blocked('target')\n        require(manager.is_blocked('target'), 'name not blocked')\n        require(manager.register(target, 'target') is None, 'blocked registration accepted')\n    require(not manager.is_registered(target), 'target still registered')\n    require(manager.get_hookcallers(target) is None and manager.get_plugin('target') is None, 'public query stale')\n    remaining = hook.get_hookimpls()\n    require(len(remaining) == len(other_impls) and all(a is b for a, b in zip(remaining, other_impls)), 'unrelated implementation/order changed')\n    require(hook._hookimpls is live_list, 'internal list identity changed')\n    after = hook(value=1)\n    require(after == expected, 'remaining dispatch changed')\n    require(manager.hook.secondary(value=1) == ['other:secondary'], 'second caller not cleaned')\n    require(not any(event.startswith('target:') for event in events), 'target wrapper or implementation remains')\n    for suffix in ['modern-enter', 'modern-exit', 'legacy-enter', 'legacy-exit']:\n        require(events.count('other:' + suffix) == 1, 'other wrapper behavior changed')\n    if mode == 'blocked':\n        require(manager.unblock('target') is True, 'unblock failed')\n        require(manager.register(target, 'target') == 'target', 'reregister failed')\n        callers = manager.get_hookcallers(target)\n        require(len(callers) == len({id(caller) for caller in callers}) == 2, 'reregister query duplicates')\n    return {'mode': mode, 'before': before, 'remaining': after, 'unrelated_order_and_wrappers_preserved': True}\n\n\ndef unregister_object():\n    return unregister_variant('object')\n\n\ndef unregister_name():\n    return unregister_variant('name')\n\n\ndef block_and_reregister():\n    return unregister_variant('blocked')\n\n\ndef empty_and_absent_plugins():\n    manager, target, other, events = setup()\n    empty = object()\n    manager.register(empty, 'empty')\n    require(manager.get_hookcallers(empty) == [], 'registered empty plugin contract')\n    require(manager.get_hookcallers(object()) is None, 'unregistered plugin contract')\n    require(manager.get_plugin('empty') is empty, 'query mutated registration')\n    return {'registered_empty': [], 'unregistered': None}\n\n\ndef absent_private_remove_preserves_state():\n    manager, target, other, events = setup()\n    hook = manager.hook.process\n    live = hook._hookimpls\n    before = hook.get_hookimpls()\n    caught = None\n    try:\n        hook._remove_plugin(object())\n    except BaseException as error:\n        caught = error\n    require(isinstance(caught, ValueError), 'not-found error missing')\n    require(hook._hookimpls is live and hook.get_hookimpls() == before, 'failed removal changed state')\n    output = hook.get_hookimpls()\n    output.clear()\n    require(hook.get_hookimpls() == before, 'get_hookimpls no longer returns a copy')\n    return {'not_found_value_error': True, 'list_identity_and_contents_preserved': True, 'public_snapshot_copy_preserved': True}\n\n\ndef remaining_hook_failure_propagates():\n    manager, target, other, events = setup()\n    manager.unregister(target)\n    failure = RuntimeError('other hook failed')\n    other.failure = failure\n    caught = None\n    try:\n        manager.hook.process(value=1)\n    except BaseException as error:\n        caught = error\n    require(caught is failure, 'hook failure swallowed or replaced')\n    for suffix in ['modern-exit', 'legacy-exit']:\n        require(events.count('other:' + suffix) == 1, 'remaining wrapper cleanup did not execute')\n    require(not any(event.startswith('target:') for event in events), 'removed target still executed')\n    return {'original_failure_propagated': True, 'wrapper_cleanup': True}\n\n\ndef unregister_during_dispatch_keeps_inflight_snapshot():\n    manager = pluggy.PluginManager('review')\n    manager.add_hookspecs(Spec)\n    events = []\n    class SelfRemoving:\n        @hookimpl(specname='process')\n        def alias(self, value):\n            events.append('alias')\n            return 'alias'\n        @hookimpl(specname='process')\n        def z_remove(self, value):\n            events.append('remove')\n            manager.unregister(self)\n            return 'remove'\n    plugin = SelfRemoving()\n    manager.register(plugin, 'self-removing')\n    result = manager.hook.process(value=1)\n    require(result == ['remove', 'alias'] and events == ['remove', 'alias'], 'in-flight callback snapshot changed')\n    require(manager.get_hookcallers(plugin) is None, 'self-removal incomplete')\n    require(manager.hook.process(value=1) == [], 'removed hooks executed next time')\n    return {'first_dispatch': result, 'events': events, 'next_dispatch': []}\n\n\nresults = {}\nfor function in [query_once_per_caller, unregister_object, unregister_name, block_and_reregister,\n                 empty_and_absent_plugins, absent_private_remove_preserves_state,\n                 remaining_hook_failure_propagates, unregister_during_dispatch_keeps_inflight_snapshot]:\n    try:\n        results[function.__name__] = {'passed': True, 'observed': function()}\n    except BaseException as error:\n        results[function.__name__] = {'passed': False, 'exception': type(error).__name__, 'message': str(error)}\nprint(json.dumps({'module_file': str(Path(pluggy.__file__).resolve()),\n                  'passed': sum(result['passed'] for result in results.values()),\n                  'total': len(results), 'results': results}))\n",
    "temporary_work_directory_removed": true
