    "checks_are_behavioral_not_loc_or_test_count": true,
    "source": "import json\nimport os\nfrom pathlib import Path\nfrom w3lib import html\n\nassert Path(html.__file__).resolve().is_relative_to(Path(os.environ['PROBE_COPY']).resolve())\nresults = []\n\n\ndef check(name, function):\n    try:\n        detail = function()\n        results.append({'id': name, 'status': 'pass', 'detail': detail})\n    except Exception as exc:\n        results.append({'id': name, 'status': 'fail', 'error': type(exc).__name__, 'message': str(exc)})\n\n\ndef eq(actual, expected):\n    assert actual == expected, (repr(actual), repr(expected))\n\n\ndef illegal_entities():\n    count = 0\n    for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):\n        for entity in (f'&#{number};', f'&#x{number:x};', f'&#X{number:X};'):\n            source = 'x' + entity + 'y'\n            for value in (source, source.encode('ascii')):\n                eq(html.replace_entities(value), 'xy')\n                eq(html.replace_entities(value, remove_illegal=True), 'xy')\n                eq(html.replace_entities(value, remove_illegal=False), source)\n                count += 3\n    return {'assertions': count}\n\n\ndef no_semicolon():\n    count = 0\n    for number in (0x81, 0x8d, 0x8f, 0x90, 0x9d):\n        for entity in (f'&#{number}', f'&#x{number:x}', f'&#X{number:X}'):\n            source = 'x' + entity + 'z'\n            for value in (source, source.encode('ascii')):\n                for policy in (True, False):\n                    eq(html.replace_entities(value, remove_illegal=policy), source)\n                    count += 1\n    return {'assertions': count}\n\n\ndef valid_entities():\n    for value in ('x&#128;&#x99;&amp;&#x1F642;y', b'x&#128;&#x99;&amp;&#x1F642;y'):\n        eq(html.replace_entities(value), 'x\\u20ac\\u2122&\\U0001f642y')\n    eq(html.replace_entities('&amp;&gt;&pound;', keep=('amp', 'gt')), '&amp;&gt;\\u00a3')\n    eq(html.replace_entities('\\u00a3&#153;'.encode('cp1252'), encoding='cp1252'), '\\u00a3\\u2122')\n\n\ndef existing_invalid_entity_fallback():\n    for source in ('x&#x110000;y', 'x&nosuchentity;y'):\n        eq(html.replace_entities(source), 'xy')\n        eq(html.replace_entities(source, remove_illegal=False), source)\n\n\ndef invalid_original_bytes():\n    for policy in (True, False):\n        try:\n            html.replace_entities(b'x\\x81&#129;y', encoding='cp1252', remove_illegal=policy)\n        except UnicodeDecodeError as exc:\n            eq(exc.encoding, 'charmap')\n            eq(exc.object, b'x\\x81&#129;y')\n        else:\n            raise AssertionError('source decoding error was swallowed')\n\n\ndef inheritance_and_scope():\n    assert issubclass(UnicodeDecodeError, ValueError)\n    failure = RuntimeError('unexpected decoder failure')\n    original = html.six.int2byte\n    def broken(number):\n        raise failure\n    html.six.int2byte = broken\n    try:\n        try:\n            html.replace_entities('&#128;')\n        except RuntimeError as exc:\n            assert exc is failure\n        else:\n            raise AssertionError('unexpected error was swallowed')\n    finally:\n        html.six.int2byte = original\n\n\ncheck('undefined_cp1252_remove_keep', illegal_entities)\ncheck('missing_semicolon_existing_policy', no_semicolon)\ncheck('valid_numeric_named_keep_and_input_encoding', valid_entities)\ncheck('existing_invalid_entity_fallback', existing_invalid_entity_fallback)\ncheck('source_decode_error_propagates', invalid_original_bytes)\ncheck('narrow_failure_scope_and_inheritance', inheritance_and_scope)\nprint(json.dumps({'module': html.__file__, 'results': results}, ensure_ascii=True))\n",
    "source_sha256": "d1f8e46f804370aee219a6eafe3eec97a64ca6a766547ea6533e0b7b1bba6f0b",
