    "source_sha256": "F1C90AB31B3EADD97BACB3F640C2A980943AD0AEF4B53AE42BF86911B4670A65",
    "source": "from collections import Counter\nimport json\nfrom pathlib import Path\nimport random\nimport sys\n\nsys.dont_write_bytecode = True\nsys.path.insert(0, str(Path(sys.argv[1]).resolve()))\nfrom more_itertools import sample\n\n\ndef require(condition, message):\n    if not condition:\n        raise AssertionError(message)\n\n\ndef expect_error(kind, function):\n    try:\n        function()\n    except BaseException as error:\n        require(isinstance(error, kind), 'wrong exception: ' + type(error).__name__)\n        return error\n    raise AssertionError('expected ' + kind.__name__)\n\n\nCOUNTED = [('ab', [2, 1]), ('abc', [2, 0, 1]), ('ab', [0, 0]), ('', []), ('ab', [2]), ('a', [2, 3])]\n\n\ndef expanded(data, counts):\n    return [value for value, count in zip(data, counts) for unused in range(count)]\n\n\ndef counted_oversized_strict():\n    observed = []\n    for data, counts in COUNTED:\n        k = len(expanded(data, counts)) + 1\n        error = expect_error(ValueError, lambda: sample(iter(data), k, counts=iter(counts), strict=True))\n        require(str(error) == 'Sample larger than population', 'strict error interface changed')\n        observed.append({'data': data, 'counts': counts, 'k': k, 'exception': type(error).__name__})\n    return observed\n\n\ndef counted_non_strict():\n    observed = []\n    for data, counts in COUNTED:\n        expected = expanded(data, counts)\n        result = sample(iter(data), len(expected) + 1, counts=iter(counts), strict=False)\n        require(Counter(result) == Counter(expected), 'non-strict counted population changed')\n        observed.append({'data': data, 'counts': counts, 'result_counts': dict(Counter(result))})\n    return observed\n\n\ndef counted_exact_strict():\n    observed = []\n    for data, counts in COUNTED:\n        expected = expanded(data, counts)\n        result = sample(iter(data), len(expected), counts=iter(counts), strict=True)\n        require(Counter(result) == Counter(expected), 'exact counted population changed')\n        observed.append({'data': data, 'counts': counts, 'result_counts': dict(Counter(result))})\n    return observed\n\n\ndef weighted_strict_checks():\n    failures = []\n    for data, weights, k in [('', [], 1), ('ab', [1], 2), ('a', [1, 2], 2), ('ab', [], 1), ('ab', [1, 2], 3)]:\n        error = expect_error(ValueError, lambda: sample(iter(data), k, weights=iter(weights), strict=True))\n        require(str(error) == 'Sample larger than population', 'weighted strict error changed')\n        failures.append([data, weights, k])\n    require(Counter(sample('ab', 2, weights=iter([1, 2]), strict=True)) == Counter('ab'), 'weighted exact sample')\n    return {'strict_rejections': failures, 'exact_weighted_population': ['a', 'b']}\n\n\ndef mutual_exclusion():\n    cases = []\n    for strict in [False, True]:\n        for weights, counts in [([], []), ([1], [1])]:\n            error = expect_error(TypeError, lambda: sample('a', 1, weights=weights, counts=counts, strict=strict))\n            cases.append({'strict': strict, 'weights': weights, 'counts': counts, 'error': type(error).__name__})\n    return cases\n\n\ndef unexpected_iterator_errors():\n    observations = []\n    for broken_part in ['population', 'counts']:\n        failure = RuntimeError(broken_part + ' failure')\n        def broken(first):\n            yield first\n            raise failure\n        population = broken('a') if broken_part == 'population' else iter('ab')\n        counts = broken(1) if broken_part == 'counts' else iter([1, 1])\n        error = expect_error(RuntimeError, lambda: sample(population, 2, counts=counts, strict=True))\n        require(error is failure, 'unexpected source failure was replaced')\n        observations.append({'source': broken_part, 'original_exception_identity': True})\n    return observations\n\n\ndef zero_and_negative_k():\n    visited = []\n    def source(label, value):\n        visited.append(label)\n        yield value\n    require(sample(source('population', 'a'), 0, counts=source('counts', 1), strict=True) == [], 'zero size')\n    error = expect_error(ValueError, lambda: sample(source('population', 'a'), -1, counts=source('counts', 1)))\n    require(str(error) == 'k must be non-negative', 'negative size error changed')\n    require(visited == [], 'empty/invalid request consumed data')\n    return {'visited': visited, 'zero_result': [], 'negative_exception': type(error).__name__}\n\n\ndef seeded_in_range_samples():\n    rows = []\n    population, counts = list('abcd'), [3, 2, 0, 4]\n    maximum = Counter(expanded(population, counts))\n    for seed in range(16):\n        random.seed(seed)\n        result = sample(iter(population), 4, counts=iter(counts), strict=True)\n        require(len(result) == 4 and not (Counter(result) - maximum), 'in-range sample violates counts')\n        rows.append(result)\n    require(population == list('abcd') and counts == [3, 2, 0, 4], 'input mutation')\n    return rows\n\n\nresults = {}\nfor function in [counted_oversized_strict, counted_non_strict, counted_exact_strict,\n                 weighted_strict_checks, mutual_exclusion, unexpected_iterator_errors,\n                 zero_and_negative_k, seeded_in_range_samples]:\n    try:\n        results[function.__name__] = {'passed': True, 'observed': function()}\n    except BaseException as error:\n        results[function.__name__] = {'passed': False, 'exception': type(error).__name__, 'message': str(error)}\nprint(json.dumps({'module_file': str(Path(sys.modules['more_itertools'].__file__).resolve()),\n                  'passed': sum(result['passed'] for result in results.values()),\n                  'total': len(results), 'results': results}))\n",
    "temporary_work_directory_removed": true
