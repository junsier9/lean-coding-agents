diff --git a/tests/test_context.py b/tests/test_context.py
index c1be8f3..951ed1f 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -6,6 +6,52 @@ import click
 from click.core import ParameterSource
 
 
+@pytest.mark.parametrize("chain", [False, True])
+@pytest.mark.parametrize(
+    ("parent_default", "child_default", "expected"),
+    [
+        (None, None, False),
+        (False, None, False),
+        (True, None, True),
+        (True, False, False),
+        (False, True, True),
+    ],
+)
+def test_show_default_inheritance(runner, chain, parent_default, child_default, expected):
+    @click.group(context_settings={"show_default": parent_default}, chain=chain)
+    def cli():
+        pass
+
+    @cli.command(context_settings={"show_default": child_default})
+    @click.option("--value", default=42)
+    def child(value):
+        pass
+
+    result = runner.invoke(cli, ["child", "--help"])
+    assert result.exit_code == 0
+    assert ("[default: 42]" in result.output) is expected
+
+
+@pytest.mark.parametrize("show_default", [None, False])
+def test_show_default_nested_group(runner, show_default):
+    @click.group(context_settings={"show_default": True})
+    def cli():
+        pass
+
+    @cli.group(context_settings={"show_default": show_default})
+    def nested():
+        pass
+
+    @nested.command()
+    @click.option("--value", default=42, show_default=False)
+    def child(value):
+        pass
+
+    result = runner.invoke(cli, ["nested", "child", "--help"])
+    assert result.exit_code == 0
+    assert ("[default: 42]" in result.output) is (show_default is None)
+
+
