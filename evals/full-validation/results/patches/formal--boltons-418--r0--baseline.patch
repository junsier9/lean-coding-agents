diff --git a/tests/test_strutils.py b/tests/test_strutils.py
index b46081e..c22a664 100644
--- a/tests/test_strutils.py
+++ b/tests/test_strutils.py
@@ -2,9 +2,48 @@ import re
 import uuid
 from unittest import TestCase
 
+import pytest
+
 from boltons import strutils
 
 
+@pytest.mark.parametrize('word', [
+    'glass', 'boss', 'address', 'class', 'grass', 'dress', 'business',
+    'success', 'loss', 'mass', 'ss', 'Glass', 'BOSS', 'aDdReSs', 'sS',
+    ' glass ',
+])
+def test_singularize_double_s_singular(word):
+    result = word
+    for _ in range(3):
+        result = strutils.singularize(result)
+        assert result == word
+
+
+@pytest.mark.parametrize('plural, singular', [
+    ('glasses', 'glass'), ('bosses', 'boss'), ('addresses', 'address'),
+    ('classes', 'class'), ('grasses', 'grass'), ('dresses', 'dress'),
+    ('businesses', 'business'), ('successes', 'success'), ('losses', 'loss'),
+    ('masses', 'mass'), ('Glasses', 'Glass'), ('BOSSES', 'BOSS'),
+    ('Addresses', 'Address'),
+])
+def test_singularize_double_s_plural(plural, singular):
+    result = strutils.singularize(plural)
+    assert result == singular
+    assert strutils.singularize(result) == singular
+    assert strutils.pluralize(result) == plural
+
+
+@pytest.mark.parametrize('word, singular', [
+    ('', ''), ('cat', 'cat'), ('cats', 'cat'), ('friends', 'friend'),
+    ('chances', 'chance'), ('Activities', 'Activity'), ('toys', 'toy'),
+    ('days', 'day'), ('FEET', 'FOOT'), ('children', 'child'),
+    ('analyses', 'analysis'), ('sheep', 'sheep'), ('series', 'series'),
+    ('species', 'species'), ('as', 'a'),
+])
+def test_singularize_existing_rules(word, singular):
+    assert strutils.singularize(word) == singular
+
+
 def test_strip_ansi():
     assert strutils.strip_ansi(
         '\x1b[0m\x1b[1;36mart\x1b[46;34m\xdc') == 'art\xdc'
