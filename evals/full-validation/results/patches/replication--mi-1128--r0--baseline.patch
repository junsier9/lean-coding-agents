+    def test_slice_matches_range(self):
+        bounds = (None, -10, -6, -5, -1, 0, 1, 4, 5, 6, 10)
+        steps = (None, -3, -2, -1, 1, 2, 3)
+        for args in [
+            (0, 10, 2),
+            (0, 11, 2),
+            (10, 0, -2),
+            (11, 0, -2),
+            (0, 1),
+            (1, 0, -1),
+            (0,),
+            (1, 0),
+            (0, 1, -1),
+        ]:
+            numeric = mi.numeric_range(*args)
+            builtin = range(*args)
+            for slice_args in product(bounds, bounds, steps):
+                sl = slice(*slice_args)
+                with self.subTest(args=args, slice_args=slice_args):
+                    actual = numeric[sl]
+                    expected = builtin[sl]
+                    self.assertIsInstance(actual, mi.numeric_range)
+                    self.assertEqual(list(actual), list(expected))
+                    self.assertEqual(len(actual), len(expected))
+
+    def test_slice_numeric_types(self):
+        for args in [
+            (1.0, 9.0, 1.5),
+            (9.0, 1.0, -1.5),
+            (Decimal('1.0'), Decimal('9.0'), Decimal('1.5')),
+            (Decimal('9.0'), Decimal('1.0'), Decimal('-1.5')),
+            (Fraction(1), Fraction(5), Fraction(3, 2)),
+            (Fraction(5), Fraction(1), Fraction(-3, 2)),
+            (
+                datetime(2019, 3, 29),
+                datetime(2019, 3, 30),
+                timedelta(hours=10),
+            ),
+            (
+                datetime(2019, 3, 30),
+                datetime(2019, 3, 29),
+                timedelta(hours=-10),
+            ),
+        ]:
+            numeric = mi.numeric_range(*args)
+            values = list(numeric)
+            bounds = (None, -10, -1, 0, 1, 10)
+            for slice_args in product(bounds, bounds, (None, -2, -1, 1, 2)):
+                sl = slice(*slice_args)
+                with self.subTest(args=args, slice_args=slice_args):
+                    actual = numeric[sl]
+                    expected = values[sl]
+                    self.assertIsInstance(actual, mi.numeric_range)
+                    self.assertEqual(list(actual), expected)
+                    self.assertEqual(len(actual), len(expected))
+                    self.assertEqual(
+                        [type(value) for value in actual],
+                        [type(value) for value in expected],
+                    )
+
+    def test_slice_index_protocol(self):
+        class Index:
+            def __init__(self, value):
+                self.value = value
+
+            def __index__(self):
+                return self.value
+
+        for sl in [
+            slice(Index(-1), None, Index(-1)),
+            slice(None, Index(0), Index(-2)),
