+@mark.parametrize('set_type', (set, frozenset))
+@mark.parametrize('left_items, right_items, subset, superset', [
+    ('', '', True, True),
+    ('', 'a', False, True),
+    ('a', '', True, False),
+    ('ab', 'ab', True, True),
+    ('ab', 'a', True, False),
+    ('a', 'ab', False, True),
+    ('ab', 'ac', False, False),
+    ('a', 'b', False, False),
+])
+def test_complement_set_inclusion(set_type, left_items, right_items, subset, superset):
+    left = complement(set_type(left_items))
+    right = complement(set_type(right_items))
+
+    assert left <= left
+    assert left >= left
+    assert not left < left
+    assert not left > left
+    # Complementing both sets reverses their containment relation.
+    assert (left <= right) is subset
+    assert (right >= left) is subset
+    assert (left >= right) is superset
+    assert (right <= left) is superset
+    assert left.issubset(right) is subset
+    assert left.issuperset(right) is superset
+
+
+@mark.parametrize('set_type', (set, frozenset))
+@mark.parametrize('left_items, right_items, subset, superset', [
+    ('', '', True, True),
+    ('', 'a', True, False),
+    ('a', '', False, True),
+    ('ab', 'ab', True, True),
+    ('ab', 'a', False, True),
+    ('a', 'ab', True, False),
+    ('ab', 'ac', False, False),
+    ('a', 'b', False, False),
+])
+def test_double_complement_set_inclusion(set_type, left_items, right_items, subset, superset):
+    left = complement(complement(set_type(left_items)))
+    right_set = set_type(right_items)
+
+    assert left <= left
+    assert left >= left
+    assert not left < left
+    assert not left > left
+    for right in (right_set, complement(complement(right_set))):
+        assert (left <= right) is subset
+        assert (right >= left) is subset
+        assert (left >= right) is superset
+        assert (right <= left) is superset
+        assert left.issubset(right) is subset
+        assert left.issuperset(right) is superset
+
+
