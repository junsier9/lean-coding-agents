+@pytest.mark.parametrize('dict_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('copy_func', [copy.copy, copy.deepcopy])
+@pytest.mark.parametrize('itemset', _ITEMSETS)
+def test_omd_copy_protocol(dict_type, copy_func, itemset):
+    omd = dict_type(itemset)
+    copied = copy_func(omd)
+
+    assert type(copied) is dict_type
+    assert copied is not omd
+    assert copied.items(multi=True) == itemset
+    for key in omd:
+        assert copied.getlist(key) == omd.getlist(key)
+
+    if itemset:
+        copied.poplast(itemset[0][0])
+    copied.add('extra', [])
+    assert omd.items(multi=True) == itemset
+    copied.clear()
+    assert omd.items(multi=True) == itemset
+
+
+def test_omd_shallow_copy_values():
+    early = [0]
+    shared = {'nested': [1]}
+    omd = OMD([('a', early), ('b', shared), ('a', shared)])
+    copied = copy.copy(omd)
+
+    assert copied.getlist('a')[0] is early
+    assert copied['a'] is copied['b'] is shared
+    copied.getlist('a')[0].append(2)
+    copied['b']['nested'].append(3)
+    assert omd.getlist('a') == [[0, 2], {'nested': [1, 3]}]
+    copied.poplast('a')
+    assert len(omd.getlist('a')) == 2
+
+
+def test_omd_deepcopy_values():
+    early = [0]
+    shared = {'nested': [1]}
+    omd = OMD([('a', early), ('b', shared), ('a', shared)])
+    copied = copy.deepcopy(omd)
+
+    assert copied.items(multi=True) == omd.items(multi=True)
+    assert copied.getlist('a')[0] is not early
+    assert copied['a'] is copied['b']
+    assert copied['a'] is not shared
+    copied.getlist('a')[0].append(2)
+    copied['b']['nested'].append(3)
+    assert early == [0]
+    assert shared == {'nested': [1]}
+
+
+def test_omd_deepcopy_keys():
+    key = object()
+    omd = OMD([(key, [key]), ('b', key), (key, 2)])
+    copied = copy.deepcopy(omd)
+
+    copied_key = copied.keys(multi=True)[0]
+    assert copied_key is not key
+    assert copied.keys(multi=True)[2] is copied_key
+    assert copied.getlist(copied_key)[0][0] is copied_key
+    assert copied['b'] is copied_key
+    assert copied.getlist(copied_key)[1] == 2
+
+
+def test_omd_deepcopy_cycles():
+    omd = OMD([('a', 0)])
+    cycle = [omd]
+    cycle.append(cycle)
+    omd.add('self', omd)
+    omd.add('a', cycle)
+    copied = copy.deepcopy(omd)
+
+    assert copied is not omd
+    assert copied['self'] is copied
+    assert copied.getlist('a')[0] == 0
+    assert copied['a'] is not cycle
+    assert copied['a'][0] is copied
+    assert copied['a'][1] is copied['a']
+
