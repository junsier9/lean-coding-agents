+@pytest.mark.parametrize('itemset', _ITEMSETS[1:])
+def test_omd_pickle_protocols(itemset):
+    import pickle
+
+    omd = OMD(itemset)
+    for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+        roundtripped = pickle.loads(pickle.dumps(omd, protocol=protocol))
+        assert roundtripped is not omd
+        assert roundtripped.items(multi=True) == itemset
+        for key in omd:
+            assert roundtripped.getlist(key) == omd.getlist(key)
+
+
+def test_omd_pickle_empty_protocols():
+    import pickle
+
+    # Protocols 0 and 1 do not initialize an empty OMD's linked list.
+    for protocol in range(2, pickle.HIGHEST_PROTOCOL + 1):
+        roundtripped = pickle.loads(pickle.dumps(OMD(), protocol=protocol))
+        assert roundtripped.items(multi=True) == []
+
