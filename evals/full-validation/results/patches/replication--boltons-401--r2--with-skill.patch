diff --git a/tests/test_tbutils_parsed_exc.py b/tests/test_tbutils_parsed_exc.py
index 6927832..fee6c4d 100644
--- a/tests/test_tbutils_parsed_exc.py
+++ b/tests/test_tbutils_parsed_exc.py
@@ -1,3 +1,5 @@
+import pytest
+
 from boltons.tbutils import ParsedException
 
 
@@ -20,6 +22,32 @@ NameError: name 'plarp' is not defined"""
     assert parsed_tb.to_string() == _tb_str
 
 
+@pytest.mark.parametrize('ending, source_line', [
+    ('', ''),
+    ('\n    return a + b', 'return a + b'),
+    ('\n    return a + b\n           ~~^~~', 'return a + b'),
+])
+@pytest.mark.parametrize('trailing_newline', ['', '\n'])
+def test_parsed_exc_truncated(ending, source_line, trailing_newline):
+    tb_str = '''\
+Traceback (most recent call last):
+  File "main.py", line 3, in <module>
+    print(add(1, "two"))
+          ^^^^^^^^^^^^^
+  File "add.py", line 2, in add'''
+
+    parsed_tb = ParsedException.from_string(tb_str + ending + trailing_newline)
+
+    assert parsed_tb.exc_type == ''
+    assert parsed_tb.exc_msg == ''
+    assert parsed_tb.frames == [
+        {'source_line': 'print(add(1, "two"))',
+         'filepath': 'main.py', 'lineno': '3', 'funcname': '<module>'},
+        {'source_line': source_line,
+         'filepath': 'add.py', 'lineno': '2', 'funcname': 'add'},
+    ]
+
+
 def test_parsed_exc_nosrcline():
     """just making sure that everything can be parsed even if there is
     a line without source and also if the exception has no message"""
