 from boltons.setutils import IndexedSet, _MISSING, complement
 
@@ -21,6 +21,51 @@ def test_indexed_set_basic():
     assert x[2:4:-1] == IndexedSet([8, 7])
 
 
+def test_indexed_set_slice_after_pop():
+    x = IndexedSet(range(10))
+    assert x.pop(2) == 2
+
+    assert x[1:4] == IndexedSet([1, 3, 4])
+    assert x[-3:] == IndexedSet([7, 8, 9])
+
+
+@mark.parametrize('removed', [(), (2,), (0, 1, 7, 10), tuple(range(6)), tuple(range(40))])
+@mark.parametrize('step', [None, 1, 2, 3, -1, -2, 10 ** 100])
+def test_indexed_set_slice_matches_contents(removed, step):
+    x = IndexedSet(range(40))
+    for item in removed:
+        x.remove(item)
+    contents = list(x)
+    fresh = IndexedSet(contents)
+
+    for start, stop in [(None, None), (1, 4), (-3, None), (None, -2),
+                        (-100, 100), (100, None), (None, -100), (5, 2)]:
+        window = slice(start, stop, step)
+        if step is not None and step < 0:
+            # Negative steps select a forward window of the reversed contents.
+            expected = contents[::-1][slice(start, stop, -step)]
+        else:
+            expected = contents[window]
+        assert list(x[window]) == expected, window
+        assert x[window] == fresh[window], window
+        assert list(x.iter_slice(start, stop, step)) == expected, window
+
+
+@mark.parametrize('start, stop, step, error', [
+    (None, None, 0, ValueError),
+    (1.5, None, 1, TypeError),
+    (None, 2.5, 1, TypeError),
+    (None, None, 1.5, TypeError),
+])
+def test_indexed_set_slice_invalid(start, stop, step, error):
+    x = IndexedSet(range(10))
+    x.pop(2)
+    with raises(error):
+        x[start:stop:step]
+    with raises(error):
+        x.iter_slice(start, stop, step)
+
+
