+@pytest.mark.parametrize('split_func', [split, split_iter])
+@pytest.mark.parametrize('src_factory', [list, iter])
+@pytest.mark.parametrize('values', [[], [None, 1, None, 2, None], [[1], [], [2]]])
+def test_split_maxsplit_zero(split_func, src_factory, values):
+    src = src_factory(values)
+
+    assert list(split_func(src, maxsplit=0)) == [values]
+
+
+def test_split_iter_maxsplit_zero_generator():
+    consumed = []
+
+    def source():
+        for value in [1, None, 2]:
+            consumed.append(value)
+            yield value
+
+    def sep(value):
+        pytest.fail('maxsplit=0 must not evaluate the separator')
+
+    src = source()
+    groups = split_iter(src, sep=sep, maxsplit=0)
+    assert consumed == []
+    assert next(groups) == [1, None, 2]
+    assert consumed == [1, None, 2]
+    assert list(src) == []
+    assert list(groups) == []
+
