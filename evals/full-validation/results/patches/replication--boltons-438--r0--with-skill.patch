+@mark.parametrize('set_type', [set, frozenset])
+@mark.parametrize('double_complement', [False, True])
+@mark.parametrize('left_values,right_values', [
+    ('', ''),
+    ('', 'a'),
+    ('a', 'a'),
+    ('a', 'ab'),
+    ('ab', 'cd'),
+    ('ab', 'bc'),
+])
+def test_complement_inclusion(set_type, double_complement, left_values, right_values):
+    left_values, right_values = set_type(left_values), set_type(right_values)
+    left, right = complement(left_values), complement(right_values)
+    if double_complement:
+        left, right = complement(left), complement(right)
+        expected_subset = left_values <= right_values
+        expected_superset = left_values >= right_values
+    else:
+        # Complementing reverses containment.
+        expected_subset = left_values >= right_values
+        expected_superset = left_values <= right_values
+
+    assert left <= left
+    assert left >= left
+    assert left.issubset(left)
+    assert left.issuperset(left)
+    assert (left <= right) == expected_subset
+    assert left.issubset(right) == expected_subset
+    assert (right >= left) == expected_subset
+    assert right.issuperset(left) == expected_subset
+    assert (left >= right) == expected_superset
+    assert left.issuperset(right) == expected_superset
+    assert (right <= left) == expected_superset
+    assert right.issubset(left) == expected_superset
+
+
