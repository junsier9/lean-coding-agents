+import pytest
+
 import click
 
 
@@ -162,6 +164,58 @@ def test_formatting_usage_error(runner):
     ]
 
 
+@pytest.mark.parametrize("options_metavar", ["", None, "[OPTIONS]", "<options>"])
+@pytest.mark.parametrize("args", [["--help"], []], ids=["help", "usage-error"])
+def test_formatting_options_metavar(runner, options_metavar, args):
+    @click.command(options_metavar=options_metavar)
+    @click.argument("required")
+    @click.argument("optional", required=False)
+    def cli(required, optional):
+        pass
+
+    result = runner.invoke(cli, args)
+    usage = "Usage: cli "
+
+    if options_metavar:
+        usage += f"{options_metavar} "
+
+    usage += "REQUIRED [OPTIONAL]"
+
+    if args:
+        assert result.exit_code == 0
+        assert result.output.splitlines() == [
+            usage,
+            "",
+            "Options:",
+            "  --help  Show this message and exit.",
+        ]
+    else:
+        assert result.exit_code == 2
+        assert result.output.splitlines() == [
+            usage,
+            "Try 'cli --help' for help.",
+            "",
+            "Error: Missing argument 'REQUIRED'.",
+        ]
+
+
+@pytest.mark.parametrize("options_metavar", ["", None])
+def test_formatting_group_without_options_metavar(runner, options_metavar):
+    @click.group(options_metavar=options_metavar)
+    @click.argument("arg")
+    def cli(arg):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines() == [
+        "Usage: cli ARG COMMAND [ARGS]...",
+        "",
+        "Options:",
+        "  --help  Show this message and exit.",
+    ]
+
+
