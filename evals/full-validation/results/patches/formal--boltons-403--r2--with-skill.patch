@@ -2,9 +2,47 @@ import re
 import uuid
 from unittest import TestCase
 
+import pytest
+
 from boltons import strutils
 
 
+@pytest.mark.parametrize('exponent, symbol', enumerate('KMGTPEZY', 1))
+@pytest.mark.parametrize('sign', [1, -1])
+def test_bytes2human_exact_boundaries(exponent, symbol, sign):
+    nbytes = sign * 1024 ** exponent
+    prefix = '-' if sign < 0 else ''
+    assert strutils.bytes2human(nbytes) == prefix + '1' + symbol
+    assert strutils.bytes2human(nbytes, ndigits=2) == prefix + '1.00' + symbol
+
+
+@pytest.mark.parametrize('exponent, symbol', enumerate('BKMGTPEZ', 1))
+@pytest.mark.parametrize('sign', [1, -1])
+def test_bytes2human_below_boundaries(exponent, symbol, sign):
+    nbytes = sign * (1024 ** exponent - 1)
+    prefix = '-' if sign < 0 else ''
+    number = '1023' if exponent == 1 else '1024'
+    assert strutils.bytes2human(nbytes) == prefix + number + symbol
+    assert strutils.bytes2human(nbytes, ndigits=2) == prefix + number + '.00' + symbol
+
+
+@pytest.mark.parametrize('nbytes, ndigits, expected', [
+    (0, 0, '0B'),
+    (0, 2, '0.00B'),
+    (1, 0, '1B'),
+    (-1, 0, '-1B'),
+    (128991, 0, '126K'),
+    (100001221, 0, '95M'),
+    (1536, 0, '2K'),
+    (1536, 2, '1.50K'),
+    (-1536, 2, '-1.50K'),
+    (1024 ** 8 * 2, 2, '2.00Y'),
+    (-1024 ** 8 * 2, 2, '-2.00Y'),
+])
+def test_bytes2human_values(nbytes, ndigits, expected):
+    assert strutils.bytes2human(nbytes, ndigits=ndigits) == expected
+
+
 def test_strip_ansi():
     assert strutils.strip_ansi(
         '\x1b[0m\x1b[1;36mart\x1b[46;34m\xdc') == 'art\xdc'
