+        factories = (list, iter, lambda values: (value for value in values))
+        for element_factory, pool_factory in product(factories, repeat=2):
+            with self.subTest(element=element_factory, pool=pool_factory):
+                actual = mi.product_index(
+                    element_factory(['i', 'a']),
