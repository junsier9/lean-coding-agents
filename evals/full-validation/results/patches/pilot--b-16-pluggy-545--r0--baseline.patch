+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize(
+    "old_wrapper_position, expected",
+    [
+        (None, ["inner", "outer"]),
+        (1, ["old", "inner", "outer"]),
+        (2, ["inner", "old", "outer"]),
+        (3, ["inner", "outer", "old"]),
+    ],
+    ids=["new-only", "old-inner", "old-between", "old-outer"],
+)
+def test_wrapper_stopiteration(
+    firstresult: bool, old_wrapper_position: Union[int, None], expected: List[str]
+) -> None:
+    out = []
+    exception = StopIteration("from hook")
+
+    @hookimpl
+    def m():
+        raise exception
+
+    @hookimpl(wrapper=True)
+    def inner():
+        try:
+            yield
+        finally:
+            out.append("inner")
+
+    @hookimpl(wrapper=True)
+    def outer():
+        try:
+            yield
+        except StopIteration as exc:
+            assert exc is exception
+            raise
+        finally:
+            out.append("outer")
+
+    @hookimpl(hookwrapper=True)
+    def old():
+        result = yield
+        try:
+            assert result.exception is exception
+            assert result.excinfo[0] is StopIteration
+        finally:
+            out.append("old")
+
+    methods = [m, inner, outer]
+    if old_wrapper_position is not None:
+        methods.insert(old_wrapper_position, old)
+
+    with pytest.raises(StopIteration) as excinfo:
+        try:
+            MC(methods, {}, firstresult=firstresult)
+        finally:
+            out.append("caller")
+    assert excinfo.value is exception
+    assert excinfo.value.value == "from hook"
+    assert out == expected + ["caller"]
+
+
+@pytest.mark.parametrize("old_style", [False, True])
+@pytest.mark.parametrize("replacement_type", [RuntimeError, StopIteration])
+def test_wrapper_stopiteration_replaced(
+    old_style: bool, replacement_type: Type[Exception]
+) -> None:
+    exception = StopIteration("from hook")
+    replacement = replacement_type("from wrapper")
+
+    @hookimpl
+    def m():
+        raise exception
+
+    @hookimpl(wrapper=True)
+    def wrapper():
+        try:
+            yield
+        except StopIteration:
+            raise replacement
+
+    @hookimpl(hookwrapper=True)
+    def old():
+        yield
+
+    methods = [m, wrapper]
+    if old_style:
+        methods.append(old)
+
+    with pytest.raises(RuntimeError) as excinfo:
+        MC(methods, {})
+    if replacement_type is RuntimeError:
+        assert excinfo.value is replacement
+    else:
+        # A StopIteration raised by the wrapper itself still follows PEP 479.
+        assert excinfo.value.__cause__ is replacement
+
+
