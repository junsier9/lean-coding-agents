diff --git a/tests/test_more.py b/tests/test_more.py
index 9757022..91b8428 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -3781,6 +3781,66 @@ class SeekableTest(PeekableMixinTests, TestCase):
         self.assertEqual(list(s), iterable)
         self.assertEqual(list(s.elements()), [])
 
+    def test_maxlen_zero_peek(self):
+        iterable = [10, 20, 30]
+        s = mi.seekable(iter(iterable), maxlen=0)
+        elements = s.elements()
+        self.assertEqual(s.peek(), 10)
+        self.assertEqual(s.peek(), 10)
+        self.assertEqual(list(elements), [])
+        self.assertEqual(list(s), iterable)
+        self.assertEqual(list(elements), [])
+
+    def test_maxlen_zero_truthiness(self):
+        iterable = [0, False, None, []]
+        s = mi.seekable(iter(iterable), maxlen=0)
+        self.assertTrue(s)
+        self.assertTrue(s)
+        self.assertEqual(list(s.elements()), [])
+        self.assertEqual(list(s), iterable)
+        self.assertFalse(s)
+        self.assertFalse(s)
+        self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_peek_next(self):
+        s = mi.seekable([0, False, None, []], maxlen=0)
+        elements = s.elements()
+        for expected in [0, False, None, []]:
+            self.assertTrue(s)
+            self.assertEqual(s.peek(), expected)
+            self.assertEqual(s.peek(), expected)
+            self.assertEqual(list(elements), [])
+            self.assertEqual(next(s), expected)
+            self.assertEqual(list(elements), [])
+
+        self.assertFalse(s)
+        self.assertRaises(StopIteration, s.peek)
+        self.assertEqual(s.peek(default='empty'), 'empty')
+        self.assertRaises(StopIteration, next, s)
+        self.assertEqual(list(elements), [])
+
+    def test_maxlen_zero_empty(self):
+        s = mi.seekable([], maxlen=0)
+        default = object()
+        for _ in range(2):
+            self.assertFalse(s)
+            self.assertIs(s.peek(default=default), default)
+            self.assertRaises(StopIteration, s.peek)
+            self.assertRaises(StopIteration, next, s)
+        self.assertEqual(list(s), [])
+        self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_seek_after_peek(self):
+        for method in ['seek', 'relative_seek']:
+            for index in [0, 1, 3, 4]:
+                with self.subTest(method=method, index=index):
+                    iterable = [10, 20, 30]
+                    s = mi.seekable(iterable, maxlen=0)
+                    self.assertEqual(s.peek(), 10)
+                    getattr(s, method)(index)
+                    self.assertEqual(list(s), iterable[index:])
+                    self.assertEqual(list(s.elements()), [])
+
     def test_relative_seek(self):
         iterable = [str(x) for x in range(5)]
         s = mi.seekable(iterable)
