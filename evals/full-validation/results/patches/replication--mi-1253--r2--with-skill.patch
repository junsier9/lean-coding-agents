+class SplitTests(TestCase):
+    def test_empty_iterable(self):
+        for split, expected in [
+            (mi.split_at, [[]]),
+            (mi.split_before, []),
+            (mi.split_after, []),
+            (mi.split_when, []),
+        ]:
+            for maxsplit in (-2, -1, 0, 1, 2):
+                for iterable in ([], (), '', iter(()), (x for x in ())):
+                    with self.subTest(
+                        split=split.__name__,
+                        maxsplit=maxsplit,
+                        iterable=type(iterable).__name__,
+                    ):
+                        pred = mock.Mock(side_effect=AssertionError)
+                        self.assertEqual(
+                            list(split(iterable, pred, maxsplit)), expected
+                        )
+                        pred.assert_not_called()
+
+    def test_zero_maxsplit(self):
+        for split in (
+            mi.split_at,
+            mi.split_before,
+            mi.split_after,
+            mi.split_when,
+        ):
+            for items in ('a,b,c', [None], [0, False, '']):
+                with self.subTest(split=split.__name__, items=items):
+                    pred = mock.Mock(side_effect=AssertionError)
+                    self.assertEqual(
+                        list(split(iter(items), pred, maxsplit=0)),
+                        [list(items)],
+                    )
+                    pred.assert_not_called()
