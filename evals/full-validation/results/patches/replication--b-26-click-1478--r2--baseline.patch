+    (60, [
+        '  --foo TEXT  This first paragraph has short source lines',
+        '              that should wrap normally.',
+        '',
+        '              This second paragraph also needs to wrap',
+        '              normally.',
+        '  --help      Show this message and exit.',
+    ]),
+])
+def test_multiline_help_wrapping(runner, terminal_width, expected):
+    @click.command()
+    @click.option('--foo', help="""
+        This first paragraph has
+        short source lines that should wrap normally.
+
+        This second paragraph also
+        needs to wrap normally.
+    """)
+    def cmd(foo):
+        pass
+
+    result = runner.invoke(cmd, ['--help'], terminal_width=terminal_width)
+    assert result.exit_code == 0
+    assert result.output.splitlines() == [
+        'Usage: cmd [OPTIONS]', '', 'Options:',
+    ] + expected
+    assert all(len(line) <= terminal_width
+               for line in result.output.splitlines())
+
