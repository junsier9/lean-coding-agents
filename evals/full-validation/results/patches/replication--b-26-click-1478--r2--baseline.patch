+@pytest.mark.parametrize('terminal_width, expected', [
+    (40, [
+        '  --foo TEXT  This first paragraph has',
+        '              short source lines that',
+        '              should wrap normally.',
+        '',
+        '              This second paragraph also',
+        '              needs to wrap normally.',
+        '  --help      Show this message and',
