 import click
 
 
@@ -13,6 +15,25 @@ def test_basic_defaults(runner):
     assert "FOO:[42.0]" in result.output
 
 
+@pytest.mark.parametrize("default", [False, True])
+@pytest.mark.parametrize("default_map", [{}, {"foo": False}, {"foo": True}])
+def test_boolean_flag_default_map(runner, default, default_map):
+    @click.command()
+    @click.option("--foo/--no-foo", default=default, show_default=True)
+    def cli(foo):
+        click.echo(foo)
+
+    expected = default_map.get("foo", default)
+    result = runner.invoke(cli, [], default_map=default_map)
+    assert result.exit_code == 0
+    assert result.output == f"{expected}\n"
+
+    result = runner.invoke(cli, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    expected_name = "foo" if expected else "no-foo"
+    assert f"[default: {expected_name}]" in result.output
+
+
 def test_multiple_defaults(runner):
     @click.command()
     @click.option("--foo", default=[23, 42], type=click.FLOAT, multiple=True)
