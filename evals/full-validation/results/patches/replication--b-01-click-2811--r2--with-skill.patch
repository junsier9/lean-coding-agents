diff --git a/tests/test_commands.py b/tests/test_commands.py
index ed9d96f..ff58de1 100644
--- a/tests/test_commands.py
+++ b/tests/test_commands.py
@@ -105,6 +105,67 @@ def test_no_args_is_help(runner):
     assert "Show this message and exit." in result.output
 
 
+@pytest.mark.parametrize(
+    ("help_option_names", "help_flag"),
+    [
+        (["--help"], "--help"),
+        (["-h", "--help"], "-h"),
+        (["-h", "--help"], "--help"),
+        (["--assist"], "--assist"),
+    ],
+)
+@pytest.mark.parametrize("args", [["help"], ["help", "--other"], ["--other", "help"]])
+def test_help_option_eager_order(runner, help_option_names, help_flag, args):
+    called = []
+
+    def other_callback(ctx, param, value):
+        called.append(value)
+        if value:
+            click.echo("other eager option")
+            ctx.exit()
+
+    @click.command(context_settings={"help_option_names": help_option_names})
+    @click.option(
+        "--other",
+        is_flag=True,
+        is_eager=True,
+        expose_value=False,
+        callback=other_callback,
+    )
+    @click.option("--required", required=True)
+    def cli(required):
+        pytest.fail("Command callback should not run.")
+
+    result = runner.invoke(cli, [help_flag if arg == "help" else arg for arg in args])
+    assert result.exit_code == 0
+    if args[0] == "--other":
+        assert called == [True]
+        assert result.output == "other eager option\n"
+    else:
+        assert called == []
+        assert result.output.startswith("Usage: cli [OPTIONS]")
+        assert "Show this message and exit." in result.output
+
+
+def test_help_option_context_names(runner):
+    @click.command()
+    @click.option("--required", required=True)
+    def cli(required):
+        pytest.fail("Command callback should not run.")
+
+    for names in [["--help"], ["--assist"], [], ["--help"]]:
+        result = runner.invoke(cli, names or ["--help"], help_option_names=names)
+        if names:
+            assert result.exit_code == 0
+            assert result.output.startswith("Usage: cli [OPTIONS]")
+            assert re.search(
+                rf"{re.escape(names[0])}\s+Show this message and exit\.", result.output
+            )
+        else:
+            assert result.exit_code == 2
+            assert "No such option: --help" in result.output
+
+
