diff --git a/tests/test_context.py b/tests/test_context.py
index c1be8f3..28b3391 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -6,6 +6,41 @@ import click
 from click.core import ParameterSource
 
 
+@pytest.mark.parametrize(
+    ("parent_show_default", "child_settings", "expected"),
+    [
+        (None, {}, False),
+        (False, {}, False),
+        (True, {}, True),
+        (True, {"show_default": None}, True),
+        (True, {"show_default": False}, False),
+        (False, {"show_default": True}, True),
+    ],
+)
+@pytest.mark.parametrize("args", [("child", "--help"), ("child", "leaf", "--help")])
+def test_show_default_inheritance(
+    runner, parent_show_default, child_settings, expected, args
+):
+    @click.group(context_settings={"show_default": parent_show_default})
+    def cli():
+        pass
+
+    @cli.group(context_settings=child_settings)
+    @click.option("--value", default=42)
+    def child(value):
+        pass
+
+    @child.command()
+    @click.option("--value", default=42)
+    def leaf(value):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0
+    assert "--value INTEGER" in result.output
+    assert ("[default: 42]" in result.output) is expected
+
+
