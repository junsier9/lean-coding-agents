diff --git a/tests/test_tableutils.py b/tests/test_tableutils.py
index 4524386..d5f12bb 100644
--- a/tests/test_tableutils.py
+++ b/tests/test_tableutils.py
@@ -1,3 +1,5 @@
+import pytest
+
 from boltons.tableutils import Table
 
 
@@ -52,3 +54,53 @@ def test_table_obj():
     t4 = Table.from_object(TestType())
     assert len(t4) == 1
     assert 'greeting' in t4.headers
+
+
+@pytest.mark.parametrize('data', [None, [], [[]]])
+def test_table_text_empty(data):
+    assert Table(data).to_text() == ''
+
+
+@pytest.mark.parametrize('headers', [None, []])
+@pytest.mark.parametrize('with_headers', [True, False])
+def test_table_text_without_headers(headers, with_headers):
+    table = Table([[1, 2], [3, 4]], headers=headers)
+    assert table.to_text(with_headers=with_headers) == '1 | 2\n3 | 4'
+
+
+def test_table_text_non_string_headers():
+    table = Table([[None, 1000]], headers=[None, 1000])
+    assert table.to_text() == 'None | 1000\n-----|-----\nNone | 1000'
+
+
+def test_table_text_maxlen():
+    table = Table([['long value', None]], headers=['long header', None])
+    assert table.to_text(maxlen=5) == 'lo... | None\n------|-----\nlo... | None'
+
+
+@pytest.mark.parametrize('headers', [['a'], ('a',)])
+def test_table_text_short_headers(headers):
+    table = Table([[1, 2]], headers=headers)
+    assert table.to_text() == 'a | None\n--|-----\n1 |  2  '
+    assert list(table.headers) == ['a']
+    assert '<th>a</th><th>None</th>' in table.to_html(orientation='horizontal')
+    assert '<tr><th>None</th><td>2</td></tr>' in table.to_html(orientation='vertical')
+
+
+def test_table_text_shortened_headers():
+    table = Table([['a', 'b'], [1, 2]])
+    table.headers.pop()
+    assert table.to_text() == 'a | None\n--|-----\n1 |  2  '
+    assert table.headers == ['a']
+
+
+@pytest.mark.parametrize('table', [Table([['a', 'b']]), Table(headers=['a', 'b'])])
+def test_table_text_headers_only(table):
+    assert table.to_text() == 'a | b\n--|--'
+    assert table.to_text(with_headers=False) == ''
+
+
+def test_table_text_wider_rows():
+    table = Table([[1]], headers=['a'])
+    table.extend([[2, 3]])
+    assert table.to_text(with_headers=False) == '1 | None\n2 |  3  '
