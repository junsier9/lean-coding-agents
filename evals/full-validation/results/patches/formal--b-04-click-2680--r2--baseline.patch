+@pytest.mark.parametrize("cleanup", [True, False])
+def test_exit_closes_before_raising(cleanup):
+    ctx = click.Context(click.Command("test"))
+    called = []
+
+    with ctx.scope(cleanup=cleanup):
+
+        @ctx.call_on_close
+        def close():
+            assert click.get_current_context() is ctx
+            called.append(True)
+
+        with pytest.raises(Exit) as exc_info:
+            ctx.exit(3)
+
+        assert exc_info.value.exit_code == 3
+        assert called == [True]
+        assert click.get_current_context() is ctx
+
+    assert called == [True]
+    assert click.get_current_context(silent=True) is None
+
+
+@pytest.mark.parametrize("standalone_mode", [True, False])
+@pytest.mark.parametrize(
+    ("exit_option", "exit_code"), [("--help", 0), ("--exit", 0), ("--exit", 7)]
+)
+def test_exit_closes_eager_resources(runner, standalone_mode, exit_option, exit_code):
+    resources = []
+    closed = []
+
+    class Resource:
+        def __init__(self, ctx):
+            self.ctx = ctx
+
+        def __enter__(self):
+            assert not resources
+            resources.append("open")
+
+        def __exit__(self, exc_type, exc_value, tb):
+            assert click.get_current_context() is self.ctx
+            resources.clear()
+            closed.append("resource")
+
+    def setup(ctx, param, value):
+        if not value:
+            return
+
+        @ctx.call_on_close
+        def close():
+            assert click.get_current_context() is ctx
+            assert not resources
+            closed.append("callback")
+
+        ctx.with_resource(Resource(ctx))
+
+    def exit_callback(ctx, param, value):
+        if value:
+            ctx.exit(exit_code)
+
+    @click.command()
+    @click.option(
+        "--setup", is_flag=True, is_eager=True, expose_value=False, callback=setup
+    )
+    @click.option("--exit", is_flag=True, expose_value=False, callback=exit_callback)
+    def cli():
+        pytest.fail("The command must not run after an early exit.")
+
+    with click.Context(click.Command("outer")) as outer:
+        for invocation in range(1, 3):
+            result = runner.invoke(
+                cli, ["--setup", exit_option], standalone_mode=standalone_mode
+            )
+            assert result.exit_code == (exit_code if standalone_mode else 0)
+            if standalone_mode and exit_code:
+                assert isinstance(result.exception, SystemExit)
+                assert result.exception.code == exit_code
+            else:
+                assert result.exception is None
+            if not standalone_mode:
+                assert result.return_value == exit_code
+            assert not resources
+            assert closed == ["resource", "callback"] * invocation
+            assert click.get_current_context() is outer
+
+    assert click.get_current_context(silent=True) is None
+
+
