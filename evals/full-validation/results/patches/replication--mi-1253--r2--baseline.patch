+class SplitEdgeCaseTests(TestCase):
+    splitters = (mi.split_before, mi.split_after, mi.split_when)
+
+    def test_empty_iterables(self):
+        for splitter in self.splitters:
+            for maxsplit in (-2, -1, 0, 1, 2):
+                for iterable in ([], (), '', iter(()), (x for x in ())):
+                    with self.subTest(
+                        splitter=splitter.__name__,
+                        maxsplit=maxsplit,
+                        iterable=type(iterable).__name__,
+                    ):
+                        pred = mock.Mock(side_effect=AssertionError)
+                        actual = list(splitter(iterable, pred, maxsplit))
+                        self.assertEqual(actual, [])
+                        pred.assert_not_called()
+
+    def test_maxsplit_zero(self):
+        for splitter in self.splitters:
+            for values in ([None], [False], [0], [1, 2, 3]):
+                with self.subTest(splitter=splitter.__name__, values=values):
+                    consumed = []
+
+                    def source():
+                        for item in values:
+                            consumed.append(item)
+                            yield item
+
+                    pred = mock.Mock(side_effect=AssertionError)
+                    result = splitter(source(), pred, maxsplit=0)
+                    self.assertEqual(consumed, [])
+                    self.assertEqual(list(result), [values])
+                    self.assertEqual(consumed, values)
+                    pred.assert_not_called()
+
+    def test_split_at_empty_iterable(self):
+        for maxsplit in (-2, -1, 0, 1, 2):
+            for keep_separator in (False, True):
+                with self.subTest(
+                    maxsplit=maxsplit, keep_separator=keep_separator
+                ):
+                    actual = list(
+                        mi.split_at(
+                            iter(''),
+                            lambda c: c == ',',
+                            maxsplit=maxsplit,
+                            keep_separator=keep_separator,
+                        )
+                    )
+                    self.assertEqual(actual, [[]])
+
+
