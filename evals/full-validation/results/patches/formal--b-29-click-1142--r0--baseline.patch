+def test_progressbar_hidden_update(runner, monkeypatch):
+    @click.command()
+    def cli():
+        with click.progressbar(length=5, label="first") as progress:
+            progress.render_progress()
+            progress.update(1)
+            progress.update(1)
+            progress.label = "second"
+            progress.update(1)
+            progress.render_progress()
+            progress.update(1)
+            progress.label = "first"
+            progress.update(1)
+
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: False)
+    result = runner.invoke(cli, [])
+    assert result.exception is None
+    assert result.output == "first\nsecond\nfirst\n"
+
+
+@pytest.mark.parametrize("styled", [False, True])
+def test_progressbar_hidden_file(tmp_path, styled):
+    path = tmp_path / "progress.txt"
+    label = "working"
+
+    if styled:
+        label = click.style(label, fg="green")
+
+    with path.open("w", encoding="utf-8") as output:
+        assert not output.isatty()
+
+        with click.progressbar(range(3), label=label, file=output, width=0) as progress:
+            assert path.read_text(encoding="utf-8") == "working\n"
+            assert list(progress) == [0, 1, 2]
+            progress.update(1)
+            progress.render_progress()
+
+    assert path.read_text(encoding="utf-8") == "working\n"
 
 
