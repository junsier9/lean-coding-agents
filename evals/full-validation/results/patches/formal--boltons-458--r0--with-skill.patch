+from boltons.dictutils import OMD, FastIterOrderedMultiDict, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
 
 
 _ITEMSETS = [[],
@@ -270,6 +270,58 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('dict_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [iter, lambda values: (v for v in values)],
+                         ids=['iterator', 'generator'])
+@pytest.mark.parametrize('key', ['a', 'c'])
+def test_addlist_one_shot_iterable(dict_type, make_values, key):
+    pairs = [('a', 0), ('b', 9)]
+    omd = dict_type(pairs)
+    assert omd.addlist(key, make_values([1, 2])) is None
+
+    assert omd.getlist(key) == ([0, 1, 2] if key == 'a' else [1, 2])
+    assert omd[key] == omd.get(key) == 2
+    assert omd.items(multi=True) == pairs + [(key, 1), (key, 2)]
+    assert omd.keys() == (['a', 'b'] if key == 'a' else ['a', 'b', 'c'])
+    assert len(omd) == len(omd.keys()) == len(omd.viewkeys())
+    assert omd.poplast(key) == 2
+    assert omd.popall(key) == ([0, 1] if key == 'a' else [1])
+    assert key not in omd
+
+
+@pytest.mark.parametrize('dict_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [iter, lambda values: (v for v in values)],
+                         ids=['iterator', 'generator'])
+def test_addlist_empty_one_shot_iterable(dict_type, make_values):
+    omd = dict_type()
+    assert omd.addlist('a', make_values([])) is None
+    assert 'a' not in omd
+    assert len(omd) == len(omd.keys()) == len(omd.viewkeys()) == 0
+    assert omd.getlist('a') == []
+    assert omd.get('a', 'missing') == 'missing'
+
+    omd.add('a', 0)
+    omd.addlist('a', make_values([]))
+    assert omd.getlist('a') == [0]
+    assert omd.items(multi=True) == [('a', 0)]
+    assert len(omd) == 1
+
+
+@pytest.mark.parametrize('key', ['a', 'c'])
+def test_addlist_failing_iterable(key):
+    def failing_values():
+        yield 1
+        raise ValueError('iteration failed')
+
+    pairs = [('a', 0), ('b', 9)]
+    omd = OMD(pairs)
+    with pytest.raises(ValueError, match='iteration failed'):
+        omd.addlist(key, failing_values())
+    assert omd.items(multi=True) == pairs
+    assert omd.todict(multi=True) == {'a': [0], 'b': [9]}
+    assert len(omd) == len(omd.keys()) == 2
+
+
