diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index d4f17a6..ecd1c07 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -1,3 +1,5 @@
+import runpy
+
 import pytest
 
 from boltons import urlutils
@@ -112,6 +114,50 @@ def test_query_param_dict_eq_with_dict():
     assert not (qpd == {'a': '999', 'b': '2'})
 
 
+@pytest.fixture(params=['package', 'standalone'])
+def query_param_dict_type(request):
+    if request.param == 'standalone':
+        return runpy.run_path(urlutils.__file__)['QueryParamDict']
+    return QueryParamDict
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda values: (v for v in values)],
+                         ids=['iterator', 'generator'])
+def test_query_param_addlist_one_shot_iterable(query_param_dict_type, make_values):
+    qp = query_param_dict_type.from_text('a=0&b=9')
+    qp.addlist('a', make_values(['1', '2']))
+    qp.addlist('c', make_values(['3', '4']))
+
+    assert qp.getlist('a') == ['0', '1', '2']
+    assert qp['a'] == qp.get('a') == '2'
+    assert qp.getlist('c') == ['3', '4']
+    assert qp['c'] == qp.get('c') == '4'
+    assert qp.keys() == ['a', 'b', 'c']
+    assert len(qp) == len(qp.keys()) == 3
+    text = 'a=0&b=9&a=1&a=2&c=3&c=4'
+    assert qp.to_text() == text
+    assert query_param_dict_type.from_text(text) == qp
+    assert qp.poplast('a') == '2'
+    assert qp.popall('c') == ['3', '4']
+    assert qp.to_text() == 'a=0&b=9&a=1'
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda values: (v for v in values)],
+                         ids=['iterator', 'generator'])
+def test_query_param_addlist_empty_iterable(query_param_dict_type, make_values):
+    qp = query_param_dict_type.from_text('a=0')
+    qp.addlist('a', make_values([]))
+    qp.addlist('missing', make_values([]))
+
+    assert qp.getlist('a') == ['0']
+    assert qp.get('a') == '0'
+    assert 'missing' not in qp
+    assert qp.get('missing', 'default') == 'default'
+    assert qp.keys() == ['a']
+    assert len(qp) == len(qp.keys()) == 1
+    assert qp.to_text() == 'a=0'
+
+
