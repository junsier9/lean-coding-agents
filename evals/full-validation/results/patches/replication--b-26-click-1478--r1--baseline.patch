@@ -88,6 +88,10 @@ The default behavior of Click is to rewrap text based on the width of the
 terminal.  In some circumstances, this can become a problem. The main issue
 is when showing code examples, where newlines are significant.
 
+.. versionchanged:: 7.1
+    Option help text preserves blank lines between paragraphs. Single
+    newlines within each paragraph are rewrapped to the terminal width.
+
 Rewrapping can be disabled on a per-paragraph basis by adding a line with
 solely the ``\b`` escape marker in it.  This line will be removed from the
 help text and rewrapping will be disabled.
diff --git a/tests/test_options.py b/tests/test_options.py
index bad4f42..aa070fc 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -422,8 +422,53 @@ def test_multiline_help(runner):
 
     result = runner.invoke(cmd, ['--help'])
     assert result.exit_code == 0
-    out = result.output.splitlines()
-    assert '  --foo TEXT  hello  i am  multiline' in out
+    assert result.output.splitlines() == [
+        'Usage: cmd [OPTIONS]',
+        '',
+        'Options:',
+        '  --foo TEXT  hello',
+        ' ' * 14,
+        '              i am',
+        ' ' * 14,
+        '              multiline',
+        '  --help      Show this message and exit.',
+    ]
+
+
+@pytest.mark.parametrize('terminal_width,expected', [
+    (44, [
+        'First paragraph is split',
+        'across source lines.',
+        '',
+        'Second paragraph also has',
+        'source line breaks.',
+    ]),
+    (60, [
+        'First paragraph is split across source lines.',
+        '',
+        'Second paragraph also has source line breaks.',
+    ]),
+])
+def test_multiline_help_wrapping(runner, terminal_width, expected):
+    @click.command()
+    @click.option('--foo', help="""
+        First paragraph is split
+        across source lines.
+
+        Second paragraph also has
+        source line breaks.
+    """)
+    def cmd(foo):
+        pass
+
+    result = runner.invoke(cmd, ['--help'], terminal_width=terminal_width)
+    assert result.exit_code == 0
+    lines = result.output.splitlines()
+    assert lines[3] == '  --foo TEXT  ' + expected[0]
+    assert lines[4:-1] == [' ' * 14 + line for line in expected[1:]]
+    assert lines[-1] == '  --help      Show this message and exit.'
+    assert all(len(line) <= terminal_width for line in lines)
+
 
