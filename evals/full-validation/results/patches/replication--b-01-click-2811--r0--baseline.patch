+@pytest.mark.parametrize("help_option_names", [None, ["--assist"], ["-h", "--help"]])
+@pytest.mark.parametrize("help_first", [True, False])
+def test_help_option_eager_order(runner, help_option_names, help_first):
+    called = []
+
+    def eager_callback(ctx, param, value):
+        if value:
+            called.append("eager")
+            click.echo("eager")
+            ctx.exit()
+
+    @click.command(context_settings={"help_option_names": help_option_names})
+    @click.option(
+        "--eager",
+        is_flag=True,
+        is_eager=True,
+        expose_value=False,
+        callback=eager_callback,
+    )
+    @click.argument("required")
+    def cli(required):
+        called.append("command")
+
+    help_names = help_option_names if help_option_names is not None else ["--help"]
+
+    for help_name in help_names:
+        args = [help_name, "--eager"] if help_first else ["--eager", help_name]
+        result = runner.invoke(cli, args)
+        assert result.exit_code == 0
+
+        if help_first:
+            assert result.output.startswith("Usage: cli ")
+            assert "Show this message and exit." in result.output
+            assert called == []
+        else:
+            assert result.output == "eager\n"
+            assert called == ["eager"]
+
+        called.clear()
+
+
+def test_help_option_names_per_context(runner):
+    @click.command()
+    @click.version_option("1.0")
+    def cli():
+        pytest.fail("The command callback should not run.")
+
+    for help_name in ["-h", "--assist", "--help"]:
+        result = runner.invoke(
+            cli, [help_name, "--version"], help_option_names=[help_name]
+        )
+        assert result.exit_code == 0
+        assert result.output.startswith("Usage: cli ")
+        assert f"{help_name} " in result.output
+        assert "Show this message and exit." in result.output
+
+
