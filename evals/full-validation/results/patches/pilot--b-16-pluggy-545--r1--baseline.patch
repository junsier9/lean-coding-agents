+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize("old_style_position", [None, "inner", "outer"])
+def test_wrapper_stopiteration_propagation(
+    firstresult: bool, old_style_position: Optional[str]
+) -> None:
+    class HookStopIteration(StopIteration):
+        pass
+
+    exception = HookStopIteration("hook stopped")
+    out = []
+
+    @hookimpl
+    def impl():
+        raise exception
+
+    def make_wrapper(name: str) -> Callable[..., object]:
+        @hookimpl(wrapper=True)
+        def wrapper():
+            try:
+                yield
+            except StopIteration as exc:
+                assert exc is exception
+                raise
+            finally:
+                out.append(name)
+
+        return wrapper
+
+    @hookimpl(hookwrapper=True)
+    def old_wrapper():
+        outcome = yield
+        assert outcome.exception is exception
+        out.append("old")
+
+    methods: List[Callable[..., object]] = [
+        impl,
+        make_wrapper("inner"),
+        make_wrapper("outer"),
+    ]
+    expected = ["inner", "outer"]
+    if old_style_position == "inner":
+        methods.insert(1, old_wrapper)
+        expected.insert(0, "old")
+    elif old_style_position == "outer":
+        methods.append(old_wrapper)
+        expected.append("old")
+
+    with pytest.raises(HookStopIteration) as excinfo:
+        try:
+            MC(methods, {}, firstresult=firstresult)
+        finally:
+            out.append("caller cleanup")
+    assert excinfo.value is exception
+    assert out == expected + ["caller cleanup"]
+
+
+@pytest.mark.parametrize("old_style", [False, True])
+@pytest.mark.parametrize("action", ["suppress", "stopiteration", "runtimeerror"])
+def test_wrapper_stopiteration_handling(old_style: bool, action: str) -> None:
+    exception = StopIteration("hook stopped")
+    replacement = StopIteration("wrapper stopped")
+    runtime_error = RuntimeError("wrapper failed")
+    out = []
+
+    @hookimpl
+    def impl():
+        raise exception
+
+    @hookimpl(wrapper=True)
+    def wrapper():
+        try:
+            yield
+        except StopIteration as exc:
+            assert exc is exception
+            if action == "suppress":
+                return "recovered"
+            if action == "stopiteration":
+                raise replacement
+            raise runtime_error
+        finally:
+            out.append("cleanup")
+
+    @hookimpl(hookwrapper=True)
+    def old_wrapper():
+        yield
+        out.append("old cleanup")
+
+    methods: List[Callable[..., object]] = [impl, wrapper]
+    if old_style:
+        methods.append(old_wrapper)
+
+    if action == "suppress":
+        assert MC(methods, {}) == "recovered"
+    else:
+        with pytest.raises(RuntimeError) as excinfo:
+            MC(methods, {})
+        if action == "stopiteration":
+            assert excinfo.value.__cause__ is replacement
+        else:
+            assert excinfo.value is runtime_error
+    assert out == ["cleanup"] + (["old cleanup"] if old_style else [])
+
+
