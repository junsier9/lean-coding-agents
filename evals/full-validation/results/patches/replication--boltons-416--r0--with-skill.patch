+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+def test_iter_find_files_pathlike(tmp_path, path_type):
+    root_file = tmp_path / 'root.txt'
+    root_file.touch()
+    ignored_file = tmp_path / 'skip.txt'
+    ignored_file.touch()
+    nested_dir = tmp_path / 'nested.txt'
+    nested_dir.mkdir()
+    nested_file = nested_dir / 'child.txt'
+    nested_file.touch()
+    (tmp_path / 'other.py').touch()
+
+    directory = path_type(tmp_path)
+    assert set(iter_find_files(directory, '*.txt')) == {
+        str(root_file), str(ignored_file), str(nested_file)}
+    assert set(iter_find_files(directory, ['*.txt'], ignored='skip*',
+                               include_dirs=True)) == {
+        str(root_file), str(nested_dir), str(nested_file)}
+    assert list(iter_find_files(directory, '*.txt', ignored='skip*',
+                                max_depth=0)) == [str(root_file)]
+
+
