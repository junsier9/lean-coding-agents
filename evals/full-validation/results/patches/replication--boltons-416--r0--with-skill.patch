+import pytest
 
 from boltons import fileutils
 from boltons.fileutils import FilePerms, iter_find_files
@@ -12,6 +11,56 @@ from boltons.strutils import removeprefix
 BOLTONS_PATH = os.path.dirname(os.path.abspath(fileutils.__file__))
 
 
+class _PathLike(os.PathLike):
+    def __init__(self, path):
+        self.path = str(path)
+
+    def __fspath__(self):
+        return self.path
+
+
+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+@pytest.mark.parametrize('saver', [fileutils.AtomicSaver, fileutils.atomic_save])
+def test_atomic_save_pathlike(tmp_path, path_type, saver):
+    dest = tmp_path / 'saved.txt'
+    part = tmp_path / 'saved.txt.part'
+    previous = None
+    for content in (b'first version', b'second version'):
+        with saver(path_type(dest)) as output:
+            output.write(content)
+            assert part.exists()
+            if previous is None:
+                assert not dest.exists()
+            else:
+                assert dest.read_bytes() == previous
+        assert output.closed
+        assert dest.read_bytes() == content
+        assert not part.exists()
+        previous = content
+
+
+def test_atomic_save_pathlike_exception(tmp_path):
+    dest = tmp_path / 'saved.txt'
+    dest.write_bytes(b'original')
+    with pytest.raises(RuntimeError, match='save failed'):
+        with fileutils.atomic_save(dest) as output:
+            output.write(b'incomplete')
+            raise RuntimeError('save failed')
+    assert output.closed
+    assert dest.read_bytes() == b'original'
+    assert not (tmp_path / 'saved.txt.part').exists()
+
+
+def test_atomic_save_pathlike_no_overwrite(tmp_path):
+    dest = tmp_path / 'saved.txt'
+    dest.write_bytes(b'original')
+    with pytest.raises(FileExistsError):
+        with fileutils.atomic_save(dest, overwrite=False):
+            pytest.fail('existing destination should prevent saving')
+    assert dest.read_bytes() == b'original'
+    assert not (tmp_path / 'saved.txt.part').exists()
+
+
