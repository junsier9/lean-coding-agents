+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('mapping_type', [dict, UserDict])
+@pytest.mark.parametrize('items, other, expected', [
+    ([], {}, True),
+    ([('a', 1)], {'a': 1}, True),
+    ([('a', 1)], {'a': 2}, False),
+    ([('a', 1)], {'b': 1}, False),
+    ([('a', 1)], {'a': 1, 'b': 2}, False),
+    ([('a', 1), ('b', 2)], {'a': 1}, False),
+    ([('a', 1), ('b', 2)], {'b': 2, 'a': 1}, True),
+    ([('a', 1), ('b', 2)], {'a': 1, 'b': 3}, False),
+    ([('a', 1), ('a', 2)], {'a': 2}, True),
+    ([('a', 1), ('a', 2)], {'a': 1}, False),
+    ([('a', [1, 2])], {'a': [1, 2]}, True),
+    ([('a', [1, 2])], {'a': [1, 3]}, False),
+])
+def test_eq_mapping(omd_type, mapping_type, items, other, expected):
+    omd = omd_type(items)
+    other = mapping_type(other)
+
+    assert (omd == other) is expected
+    assert (omd != other) is (not expected)
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('other_items, expected', [
+    ([('a', 1), ('b', 2), ('a', 3)], True),
+    ([('a', 0), ('b', 2), ('a', 3)], False),
+    ([('a', 1), ('b', 2), ('a', 4)], False),
+    ([('b', 2), ('a', 1), ('a', 3)], False),
+    ([('a', 3), ('b', 2)], False),
+    ([('a', 1), ('b', 2), ('a', 3), ('a', 3)], False),
+])
+def test_eq_multivalue(omd_type, other_items, expected):
+    omd = omd_type([('a', 1), ('b', 2), ('a', 3)])
+    other = omd_type(other_items)
+
+    assert (omd == other) is expected
+    assert (other == omd) is expected
+    assert (omd != other) is (not expected)
+    assert (other != omd) is (not expected)
+
+
 def test_copy():
     for itemset in _ITEMSETS:
         omd = OMD(itemset)
diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index d25701e..3627a2b 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -1,3 +1,5 @@
+from collections import UserDict
+
 import pytest
 
 from boltons import urlutils
@@ -95,6 +97,47 @@ def test_query_params(test_url):
     assert test_url.endswith(qp_text)
 
 
+@pytest.mark.parametrize('mapping_type', [dict, UserDict])
+@pytest.mark.parametrize('query, other, expected', [
+    ('', {}, True),
+    ('a=1', {'a': '1'}, True),
+    ('a=1', {'a': '2'}, False),
+    ('a=1', {'b': '1'}, False),
+    ('a=1', {'a': '1', 'b': '2'}, False),
+    ('a=1&b=2', {'a': '1'}, False),
+    ('a=1&b=2', {'b': '2', 'a': '1'}, True),
+    ('a=1&b=2', {'a': '1', 'b': '3'}, False),
+    ('a=1&a=2', {'a': '2'}, True),
+    ('a=1&a=2', {'a': '1'}, False),
+    ('a', {'a': None}, True),
+    ('a', {'a': ''}, False),
+])
+def test_query_params_eq_mapping(mapping_type, query, other, expected):
+    params = urlutils.QueryParamDict.from_text(query)
+    other = mapping_type(other)
+
+    assert (params == other) is expected
+    assert (params != other) is (not expected)
+
+
+@pytest.mark.parametrize('other_query, expected', [
+    ('a=1&b=2&a=3', True),
+    ('a=0&b=2&a=3', False),
+    ('a=1&b=2&a=4', False),
+    ('b=2&a=1&a=3', False),
+    ('a=3&b=2', False),
+    ('a=1&b=2&a=3&a=3', False),
+])
+def test_query_params_eq_multivalue(other_query, expected):
+    params = urlutils.QueryParamDict.from_text('a=1&b=2&a=3')
+    other = urlutils.QueryParamDict.from_text(other_query)
+
+    assert (params == other) is expected
+    assert (other == params) is expected
+    assert (params != other) is (not expected)
+    assert (other != params) is (not expected)
+
+
 def test_iri_query():
     url = URL('http://minerals.mountain.ore/?rock=\N{SHAMROCK}')
     assert url.query_params['rock'] == '\N{SHAMROCK}'
