diff --git a/more_itertools/more.py b/more_itertools/more.py
index c66c4cb..a6207d2 100644
--- a/more_itertools/more.py
+++ b/more_itertools/more.py
@@ -3073,10 +3073,14 @@ def exactly_n(iterable, n, predicate=bool):
         >>> exactly_n([0, 1, 2, 3, 4, 5], 3, lambda x: x < 3)
         True
 
+    If *n* is negative, return ``False`` without advancing the iterable.
+
     The iterable will be advanced until ``n + 1`` truthy items are encountered,
     so avoid calling it on infinite iterables.
 
     """
+    if n < 0:
+        return False
     return ilen(islice(filter(predicate, iterable), n + 1)) == n
 
 
diff --git a/tests/test_more.py b/tests/test_more.py
index 12033b8..637d0f4 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -3680,6 +3680,7 @@ class ExactlyNTests(TestCase):
         self.assertFalse(mi.exactly_n([True, False, False], 2))
         self.assertFalse(mi.exactly_n([True, True, False], 1))
         self.assertFalse(mi.exactly_n([False], 1))
+        self.assertFalse(mi.exactly_n([True], 0))
         self.assertFalse(mi.exactly_n([True], -1))
         self.assertFalse(mi.exactly_n(repeat(True), 100))
 
@@ -3688,6 +3689,34 @@ class ExactlyNTests(TestCase):
         self.assertTrue(mi.exactly_n([], 0))
         self.assertFalse(mi.exactly_n([], 1))
 
+    def test_negative(self):
+        for n, iterable in product((-1, -2, -10), ([], [True], [False])):
+            with self.subTest(n=n, iterable=iterable):
+                self.assertFalse(mi.exactly_n(iterable, n))
+
+    def test_negative_does_not_consume(self):
+        for n in (-1, -2, -10):
+            with self.subTest(n=n):
+                iterable = count()
+                predicate = mock.Mock()
+                self.assertFalse(mi.exactly_n(iterable, n, predicate))
+                predicate.assert_not_called()
+                self.assertEqual(next(iterable), 0)
+
+    def test_short_circuit_with_predicate(self):
+        for n in (0, 1, 5):
+            with self.subTest(n=n):
+                iterable = count()
+                self.assertFalse(
+                    mi.exactly_n(iterable, n, lambda x: x % 2 == 0)
+                )
+                self.assertEqual(next(iterable), 2 * n + 1)
+
+    def test_predicate_error(self):
+        predicate = mock.Mock(side_effect=ValueError('predicate failed'))
+        with self.assertRaisesRegex(ValueError, 'predicate failed'):
+            mi.exactly_n([True], 1, predicate)
+
 
