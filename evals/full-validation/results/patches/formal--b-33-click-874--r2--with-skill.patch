+@pytest.mark.parametrize('auto_envvar', [False, True])
+@pytest.mark.parametrize('args, env_count, mapped_count, expected', [
+    (['--count', '4'], '3', '2', '4\n'),
+    (['--count', '0'], '3', '2', '0\n'),
+    ([], '3', '2', '3\n'),
+    ([], '0', '2', '0\n'),
+    ([], None, '2', '2\n'),
+    ([], None, 0, '0\n'),
+    ([], None, None, '1\n'),
+])
+def test_default_map_precedence(runner, auto_envvar, args, env_count,
+                                mapped_count, expected):
+    envvar_name = 'TEST_FOO_COUNT' if auto_envvar else 'TEST_COUNT'
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option('--count', default=1,
+                  envvar=None if auto_envvar else envvar_name)
+    def foo(count):
+        click.echo(count)
+
+    result = runner.invoke(
+        cli, ['foo'] + args, env={envvar_name: env_count},
+        auto_envvar_prefix='TEST', default_map={'foo': {'count': mapped_count}})
+
+    assert not result.exception
+    assert result.output == expected
+
+
+@pytest.mark.parametrize('auto_envvar', [False, True])
+def test_default_map_invalid_envvar(runner, auto_envvar):
+    envvar_name = 'TEST_COUNT'
+
+    @click.command()
+    @click.option('--count', default=1,
+                  envvar=None if auto_envvar else envvar_name)
+    def cli(count):
+        click.echo(count)
+
+    result = runner.invoke(
+        cli, [], env={envvar_name: 'invalid'}, auto_envvar_prefix='TEST',
+        default_map={'count': 2})
+
+    assert result.exit_code == 2
+    assert 'Invalid value for "--count"' in result.output
+
+
