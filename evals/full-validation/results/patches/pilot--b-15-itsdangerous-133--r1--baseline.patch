+class TestTimedSerializerNegativeAge(FreezeMixin):
+    @pytest.mark.parametrize("serializer_class", (TimedSerializer, URLSafeTimedSerializer))
+    @pytest.mark.parametrize("value", ({"id": 42}, "a" * 1000))
+    @pytest.mark.parametrize("return_timestamp", (False, True))
+    def test_negative_age(self, serializer_class, value, ts, freeze, return_timestamp):
+        serializer = serializer_class("secret_key")
+        signed = serializer.dumps(value)
+        freeze.tick(timedelta(seconds=-1))
+
+        with pytest.raises(SignatureExpired) as exc_info:
+            serializer.loads(signed, max_age=10, return_timestamp=return_timestamp)
+
+        assert exc_info.value.date_signed == ts
+        assert serializer.load_payload(exc_info.value.payload) == value
+        assert serializer.loads_unsafe(signed, max_age=10) == (False, value)
+        assert serializer.loads(signed) == value
