         assert exc_info.value.date_signed == ts
 
+    @pytest.mark.parametrize("max_age", (0, 10))
+    def test_max_age_boundary(self, signer, max_age, freeze):
+        signed = signer.sign("value")
+        freeze.tick(timedelta(seconds=max_age))
+        assert signer.unsign(signed, max_age=max_age) == b"value"
+        assert signer.validate(signed, max_age=max_age)
+        freeze.tick()
+
+        with pytest.raises(SignatureExpired):
+            signer.unsign(signed, max_age=max_age)
+
+        assert not signer.validate(signed, max_age=max_age)
+
+    @pytest.mark.parametrize("age", (-1, -1293840000))
+    @pytest.mark.parametrize("max_age", (0, 10))
+    def test_negative_age(self, signer, ts, freeze, age, max_age):
+        signed = signer.sign("value")
+        # Cover clock rollback and the pre-1.0 timestamp epoch offset.
+        freeze.tick(timedelta(seconds=age))
+
+        with pytest.raises(SignatureExpired) as exc_info:
+            signer.unsign(signed, max_age=max_age, return_timestamp=True)
+
+        assert str(exc_info.value) == f"Signature age {age} < 0 seconds"
+        assert exc_info.value.date_signed == ts
+        assert exc_info.value.payload == b"value"
+        assert not signer.validate(signed, max_age=max_age)
+        assert signer.unsign(signed) == b"value"
+        assert signer.unsign(signed, return_timestamp=True) == (b"value", ts)
+        assert signer.validate(signed)
+
     def test_return_timestamp(self, signer, ts):
         signed = signer.sign("value")
         assert signer.unsign(signed, return_timestamp=True) == (b"value", ts)
