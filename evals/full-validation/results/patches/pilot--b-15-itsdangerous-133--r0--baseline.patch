+
+
+@pytest.mark.parametrize("serializer_cls", (TimedSerializer, URLSafeTimedSerializer))
+@pytest.mark.parametrize("value", ({"id": 42}, pytest.param("a" * 1000, id="zlib")))
+class TestTimedSerializerAge(FreezeMixin):
+    @pytest.fixture()
+    def serializer(self, serializer_cls):
+        return serializer_cls(secret_key="secret_key")
+
+    @pytest.mark.parametrize("max_age", (0, 10))
+    @pytest.mark.parametrize("return_timestamp", (False, True))
+    def test_future_timestamp(
+        self, serializer, value, ts, freeze, max_age, return_timestamp
+    ):
+        signed = serializer.dumps(value)
+        freeze.tick(timedelta(seconds=-1))
+
+        with pytest.raises(
+            SignatureExpired, match="Signature age -1 < 0 seconds"
+        ) as exc_info:
+            serializer.loads(signed, max_age=max_age, return_timestamp=return_timestamp)
+
+        assert exc_info.value.date_signed == ts
+        assert serializer.load_payload(exc_info.value.payload) == value
+        assert serializer.loads_unsafe(signed, max_age=max_age) == (False, value)
+
+    def test_future_timestamp_without_max_age(self, serializer, value, ts, freeze):
+        signed = serializer.dumps(value)
+        freeze.tick(timedelta(seconds=-1))
+        assert serializer.loads(signed, return_timestamp=True) == (value, ts)
+        assert serializer.loads_unsafe(signed) == (True, value)
