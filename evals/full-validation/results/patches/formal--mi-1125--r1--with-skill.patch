+    def test_repeat_iterators(self):
+        for iterables in [('abc',), ('abc', 'def'), ('ab', 'def')]:
+            for repeat in (1, 2, 3):
+                with self.subTest(iterables=iterables, repeat=repeat):
+                    self.assertEqual(
+                        list(
+                            mi.gray_product(
+                                *map(iter, iterables), repeat=repeat
+                            )
+                        ),
+                        list(mi.gray_product(*iterables, repeat=repeat)),
+                    )
+
+    def test_repeat_iterator_errors(self):
+        for iterable in ('', 'a'):
+            with self.subTest(iterable=iterable):
+                with self.assertRaises(ValueError):
+                    list(mi.gray_product(iter(iterable), repeat=2))
+
+    def test_nonpositive_repeat(self):
+        for repeat in (0, -1):
+            with self.subTest(repeat=repeat):
+                iterable = iter('abc')
+                self.assertEqual(
+                    list(mi.gray_product(iterable, repeat=repeat)), [()]
+                )
+                self.assertEqual(list(iterable), list('abc'))
