+    def test_get_item_by_slice_matches_range(self):
+        bounds = (None, -20, -5, -1, 0, 1, 5, 20)
+        steps = (None, -3, -2, -1, 1, 2, 3)
+        for args in [
+            (0, 10, 2),
+            (1, 10, 3),
+            (10, 0, -2),
+            (10, -1, -3),
+            (0, 0, 1),
+            (5, 0, 1),
+            (0, 5, -1),
+            (1, 2, 3),
+        ]:
+            r = mi.numeric_range(*args)
+            for start, stop, step in product(bounds, bounds, steps):
+                sl = slice(start, stop, step)
+                with self.subTest(args=args, sl=sl):
+                    actual = r[sl]
+                    expected = range(*args)[sl]
+                    self.assertIsInstance(actual, mi.numeric_range)
+                    self.assertEqual(list(actual), list(expected))
+                    self.assertEqual(len(actual), len(expected))
+
+    def test_get_item_by_slice_numeric_types(self):
+        slices = [
+            slice(None, None, -1),
+            slice(None, None, -2),
+            slice(-2, None, -1),
+            slice(None, -1, -1),
+            slice(20, -20, -3),
+            slice(1, None, 2),
+        ]
+        for args in [
+            (1.0, 9.0, 1.5),
+            (Decimal('1'), Decimal('9'), Decimal('1.5')),
+            (Fraction(1), Fraction(9), Fraction(3, 2)),
+            (
+                datetime(2019, 3, 29),
+                datetime(2019, 3, 30),
+                timedelta(hours=10),
+            ),
+        ]:
+            for r in [
+                mi.numeric_range(*args),
+                mi.numeric_range(args[1], args[0], -args[2]),
+            ]:
+                for sl in slices:
+                    with self.subTest(r=r, sl=sl):
+                        actual = r[sl]
+                        expected = list(r)[sl]
+                        self.assertIsInstance(actual, mi.numeric_range)
+                        self.assertEqual(list(actual), expected)
+                        self.assertEqual(len(actual), len(expected))
+                        self.assertTrue(
+                            all(
+                                type(a) is type(e)
+                                for a, e in zip(actual, expected)
+                            )
+                        )
+
+    def test_get_item_by_slice_invalid(self):
+        for r in [mi.numeric_range(10), mi.numeric_range(0)]:
+            for sl, error in [
+                (slice(None, None, 0), ValueError),
+                (slice(1.0, None), TypeError),
+                (slice(None, 1.0), TypeError),
+                (slice(None, None, 1.0), TypeError),
+            ]:
+                with self.subTest(r=r, sl=sl):
+                    with self.assertRaises(error):
+                        r[sl]
