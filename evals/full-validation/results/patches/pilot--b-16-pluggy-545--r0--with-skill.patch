+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize(
+    "old_wrapper_index, expected",
+    [
+        (None, ["inner", "outer"]),
+        (1, ["old", "inner", "outer"]),
+        (2, ["inner", "old", "outer"]),
+        (3, ["inner", "outer", "old"]),
+    ],
+)
+def test_wrapper_stopiteration(firstresult, old_wrapper_index, expected) -> None:
+    out = []
+    exception = StopIteration("from hook")
+
+    @hookimpl
+    def impl():
+        raise exception
+
+    @hookimpl(wrapper=True)
+    def inner():
+        try:
+            yield
+        finally:
+            out.append("inner")
+
+    @hookimpl(wrapper=True)
+    def outer():
+        try:
+            yield
+        except StopIteration as exc:
+            assert exc is exception
+            raise
+        finally:
+            out.append("outer")
+
+    @hookimpl(hookwrapper=True)
+    def old():
+        outcome = yield
+        assert outcome.exception is exception
+        out.append("old")
+
+    methods = [impl, inner, outer]
+    if old_wrapper_index is not None:
+        methods.insert(old_wrapper_index, old)
+
+    with pytest.raises(StopIteration) as excinfo:
+        try:
+            MC(methods, {}, firstresult=firstresult)
+        finally:
+            out.append("caller")
+    assert excinfo.value is exception
+    assert out == expected + ["caller"]
+
+
+@pytest.mark.parametrize("mixed", [False, True])
+@pytest.mark.parametrize("suppress", [False, True])
+def test_wrapper_handles_stopiteration(mixed: bool, suppress: bool) -> None:
+    exception = StopIteration("from hook")
+    replacement = RuntimeError("from wrapper")
+    out = []
+
+    @hookimpl
+    def impl():
+        raise exception
+
+    @hookimpl(wrapper=True)
+    def wrapper():
+        try:
+            yield
+        except StopIteration as exc:
+            assert exc is exception
+            if suppress:
+                return 42
+            raise replacement
+        finally:
+            out.append("cleanup")
+
+    @hookimpl(hookwrapper=True)
+    def old():
+        outcome = yield
+        if suppress:
+            assert outcome.get_result() == 42
+        else:
+            assert outcome.exception is replacement
+
+    methods = [impl, wrapper, old] if mixed else [impl, wrapper]
+    if suppress:
+        assert MC(methods, {}) == 42
+    else:
+        with pytest.raises(RuntimeError) as excinfo:
+            MC(methods, {})
+        assert excinfo.value is replacement
+    assert out == ["cleanup"]
+
+
 def test_wrapper_exception_chaining() -> None:
     @hookimpl
     def m1():
