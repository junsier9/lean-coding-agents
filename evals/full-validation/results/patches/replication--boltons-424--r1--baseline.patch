 from boltons.setutils import IndexedSet, _MISSING, complement
 
@@ -21,6 +21,46 @@ def test_indexed_set_basic():
     assert x[2:4:-1] == IndexedSet([8, 7])
 
 
+def test_indexed_set_slice_after_pop():
+    x = IndexedSet(range(10))
+    assert x.pop(2) == 2
+    assert x.dead_indices  # Exercise slicing before compaction removes the gap.
+
+    assert x[1:4] == IndexedSet([1, 3, 4])
+    assert x[-3:] == IndexedSet([7, 8, 9])
+    assert x[2:4:-1] == IndexedSet([7, 6])
+
+
+@mark.parametrize('removed', [(), (0,), (2, 3, 19), tuple(range(5)), tuple(range(32))])
+def test_indexed_set_slice_windows(removed):
+    x = IndexedSet(range(32))
+    for item in removed:
+        x.remove(item)
+    values = list(x)
+    fresh = IndexedSet(values)
+    bounds = [None, -10**100, -3, -1, 0, 1, 3, 31, 32, 10**100]
+    for start in bounds:
+        for stop in bounds:
+            for step in (None, 1, 2, 3, 10**100, -1, -2, -10**100):
+                window = slice(start, stop, step)
+                if step is not None and step < 0:
+                    # Negative steps take a forward window of the reversed set.
+                    expected = values[::-1][start:stop:-step]
+                else:
+                    expected = values[window]
+                assert list(x[window]) == expected, (removed, window)
+                assert list(x.iter_slice(start, stop, step)) == expected
+                assert x[window] == fresh[window]
+
+
+def test_indexed_set_slice_zero_step():
+    for x in (IndexedSet(), IndexedSet(range(10))):
+        with raises(ValueError):
+            x[::0]
+        with raises(ValueError):
+            x.iter_slice(None, None, 0)
+
+
