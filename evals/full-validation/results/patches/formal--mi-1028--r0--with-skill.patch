+    def test_mapping(self):
+        class Mapping(abc.Mapping):
+            def __init__(self, data):
+                self.data = data
+
+            def __getitem__(self, key):
+                return self.data[key]
+
+            def __iter__(self):
+                return iter(self.data)
+
+            def __len__(self):
+                return len(self.data)
+
+        mapping = Mapping({0: 'first', -1: 'middle', 2: 'last'})
+        self.assertEqual(mi.last(mapping), 2)
+        self.assertEqual(mi.last(mapping, default=None), 2)
+        with self.assertRaises(ValueError):
+            mi.last(Mapping({}))
+        default = object()
+        self.assertIs(mi.last(Mapping({}), default=default), default)
+
+    def test_reversed(self):
