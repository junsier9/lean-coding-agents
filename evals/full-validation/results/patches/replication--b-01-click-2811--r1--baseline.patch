+@pytest.mark.parametrize(
+    ("help_option_names", "help_name"),
+    [
+        (None, "--help"),
+        (["-h", "--help"], "-h"),
+        (["-h", "--help"], "--help"),
+        (["--assist"], "--assist"),
+    ],
+)
+@pytest.mark.parametrize("eager_first", [False, True])
+@pytest.mark.parametrize("eager_exits", [False, True])
+def test_help_option_eager_order(
+    runner, help_option_names, help_name, eager_first, eager_exits
+):
+    called = []
+
+    def eager_callback(ctx, param, value):
+        if value:
+            called.append("eager")
+            click.echo("eager")
+            if eager_exits:
+                ctx.exit(3)
+
+    @click.command(context_settings={"help_option_names": help_option_names})
+    @click.option(
+        "--eager",
+        is_flag=True,
+        is_eager=True,
+        expose_value=False,
+        callback=eager_callback,
+    )
+    @click.option("--required", required=True)
+    def cli(required):
+        """Command help."""
+        raise AssertionError("The command should not be invoked.")
+
+    args = ["--eager", help_name] if eager_first else [help_name, "--eager"]
+    result = runner.invoke(cli, args)
+
+    assert called == (["eager"] if eager_first else [])
+    if eager_first and eager_exits:
+        assert result.exit_code == 3
+        assert result.output == "eager\n"
+    else:
+        assert result.exit_code == 0
+        assert "Usage: cli" in result.output
+        assert "Command help." in result.output
+        assert result.output.startswith("eager\n") == eager_first
+
+
+def test_help_option_names_per_invocation(runner):
+    @click.command()
+    def cli():
+        click.echo("command")
+
+    for help_names in (["--first"], ["-h", "--help"], [], ["--second"]):
+        result = runner.invoke(cli, help_names[:1], help_option_names=help_names)
+        assert result.exit_code == 0
+        if help_names:
+            assert "Show this message and exit." in result.output
+            assert all(name in result.output for name in help_names)
+        else:
+            assert result.output == "command\n"
+
+        result = runner.invoke(cli, ["--first"], help_option_names=help_names)
+        assert result.exit_code == (0 if "--first" in help_names else 2)
+
+
