+def test_indexed_set_slice_after_pop():
+    x = IndexedSet(range(10))
+    x.pop(2)
+
+    assert x.dead_indices  # Exercise slicing before compaction.
+    assert x[1:4] == IndexedSet([1, 3, 4])
+    assert x[-3:] == IndexedSet([7, 8, 9])
+    assert x[2:4:-1] == IndexedSet([7, 6])
+
+
+@mark.parametrize('size, removed', [
+    (0, ()),
+    (1, ()),
+    (10, ()),
+    (10, (2,)),
+    (10, (0,)),
+    (32, (3, 4, 5)),
+    (32, (1, 15, 28)),
+    (32, tuple(range(8))),  # Compaction followed by more deletions.
+    (10, tuple(range(10))),
+])
+@mark.parametrize('step', [None, 1, 2, 3, -1, -2, -3, 10 ** 100, -10 ** 100])
+def test_indexed_set_slice_windows(size, removed, step):
+    x = IndexedSet(range(size))
+    for item in removed:
+        x.remove(item)
+    values = list(x)
+    fresh = IndexedSet(values)
+    original_items = list(x.item_list)
+    bounds = [None, -10 ** 100, -len(x), -3, -1, 0, 1, 2, 4, len(x), 10 ** 100]
+
+    for start, stop in product(bounds, repeat=2):
+        window = slice(start, stop, step)
+        if step is not None and step < 0:
+            # Negative steps select a window in the reversed sequence.
+            expected = values[::-1][slice(start, stop, -step)]
+        else:
+            expected = values[window]
+        assert list(x[window]) == expected, window
+        assert list(x.iter_slice(start, stop, step)) == expected, window
+        assert x[window] == fresh[window], window
+
+    assert x.item_list == original_items
+
+
+@mark.parametrize('window, error', [
+    (slice(None, None, 0), ValueError),
+    (slice(1.5, None), TypeError),
+    (slice(None, '3'), TypeError),
+    (slice(None, None, 1.5), TypeError),
+])
+def test_indexed_set_invalid_slice(window, error):
+    x = IndexedSet(range(10))
+    x.pop(2)
+    with raises(error):
+        x[window]
+    with raises(error):
+        list(x.iter_slice(window.start, window.stop, window.step))
+
+
+def test_indexed_set_slice_index_protocol():
+    class Index:
+        def __init__(self, value):
+            self.value = value
+
+        def __index__(self):
+            return self.value
+
+    x = IndexedSet(range(10))
+    x.pop(2)
+    assert x[Index(-8):Index(7):Index(2)] == IndexedSet([1, 4, 6])
+    assert x[Index(1):Index(5):Index(-2)] == IndexedSet([8, 6])
+
+
