 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
@@ -61,6 +63,41 @@ def test_eq():
     assert omd != omd3
 
 
+@pytest.mark.parametrize('mapping_type', [dict, UserDict])
+@pytest.mark.parametrize('items, other, equal', [
+    ([], {}, True),
+    ([('a', 1)], {'a': 1}, True),
+    ([('a', 1)], {'a': 2}, False),
+    ([('a', 1)], {'b': 1}, False),
+    ([('a', 1)], {}, False),
+    ([('a', [1, 2])], {'a': [1, 2]}, True),
+    ([('a', None)], {'a': 0}, False),
+    ([('a', 1), ('b', 2), ('a', 3)], {'b': 2, 'a': 3}, True),
+    ([('a', 1), ('b', 2), ('a', 3)], {'a': 1, 'b': 2}, False),
+    ([('a', 1), ('b', 2), ('a', 3)], {'a': 3, 'b': 4}, False),
+])
+def test_eq_mapping(mapping_type, items, other, equal):
+    omd = OMD(items)
+    mapping = mapping_type(other)
+    assert (omd == mapping) is equal
+    assert (mapping == omd) is equal
+    assert (omd != mapping) is not equal
+    assert (mapping != omd) is not equal
+
+
+@pytest.mark.parametrize('items, equal', [
+    ([('a', 1), ('b', 2), ('a', 3)], True),
+    ([('a', 9), ('b', 2), ('a', 3)], False),
+    ([('b', 2), ('a', 1), ('a', 3)], False),
+    ([('a', 3), ('b', 2)], False),
+])
+def test_eq_multivalue(items, equal):
+    omd = OMD([('a', 1), ('b', 2), ('a', 3)])
+    other = OMD(items)
+    assert (omd == other) is equal
+    assert (omd != other) is not equal
+
+
 def test_copy():
