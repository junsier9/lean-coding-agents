 import pytest
 
 from boltons import urlutils
@@ -95,6 +97,41 @@ def test_query_params(test_url):
     assert test_url.endswith(qp_text)
 
 
+@pytest.mark.parametrize('mapping_type', [dict, UserDict])
+@pytest.mark.parametrize('query, other, equal', [
+    ('', {}, True),
+    ('a=1', {'a': '1'}, True),
+    ('a=1', {'a': '2'}, False),
+    ('a=1', {'b': '1'}, False),
+    ('a=1', {}, False),
+    ('a', {'a': None}, True),
+    ('a', {'a': ''}, False),
+    ('a=1&b=2&a=3', {'b': '2', 'a': '3'}, True),
+    ('a=1&b=2&a=3', {'a': '1', 'b': '2'}, False),
+    ('a=1&b=2&a=3', {'a': '3', 'b': '4'}, False),
+])
+def test_query_param_dict_eq_mapping(mapping_type, query, other, equal):
+    qp = urlutils.QueryParamDict.from_text(query)
+    mapping = mapping_type(other)
+    assert (qp == mapping) is equal
+    assert (mapping == qp) is equal
+    assert (qp != mapping) is not equal
+    assert (mapping != qp) is not equal
+
+
+@pytest.mark.parametrize('query, equal', [
+    ('a=1&b=2&a=3', True),
+    ('a=9&b=2&a=3', False),
+    ('b=2&a=1&a=3', False),
+    ('a=3&b=2', False),
+])
+def test_query_param_dict_eq_multivalue(query, equal):
+    qp = urlutils.QueryParamDict.from_text('a=1&b=2&a=3')
+    other = urlutils.QueryParamDict.from_text(query)
+    assert (qp == other) is equal
+    assert (qp != other) is not equal
+
+
 def test_iri_query():
     url = URL('http://minerals.mountain.ore/?rock=\N{SHAMROCK}')
     assert url.query_params['rock'] == '\N{SHAMROCK}'
