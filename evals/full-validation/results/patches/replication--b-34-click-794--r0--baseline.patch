diff --git a/tests/test_options.py b/tests/test_options.py
index d196fe2..3abd90b 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -7,6 +7,37 @@ import pytest
 from click._compat import text_type
 
 
+@pytest.mark.parametrize('param_decls, expected_name', [
+    (['--foo', '--foobar'], 'foo'),
+    (['--foobar', '--foo'], 'foobar'),
+    (['-f', '--foo', '--foobar'], 'foo'),
+    (['-f', '--foobar', '--foo'], 'foobar'),
+    (['--foo', '-f', '--foobar'], 'foo'),
+    (['--foobar', '-f', '--foo'], 'foobar'),
+    (['--foo', '--foobar', '-f'], 'foo'),
+    (['--foobar', '--foo', '-f'], 'foobar'),
+    (['-f', '-b'], 'f'),
+    (['-b', '-f'], 'b'),
+    (['-f', '--Foo-Bar', '--foobar'], 'foo_bar'),
+    (['--foo', '--foobar', 'dest'], 'dest'),
+    (['dest', '-f', '--foo', '--foobar'], 'dest'),
+])
+def test_option_name(runner, param_decls, expected_name):
+    @click.command()
+    @click.option(*param_decls)
+    def cli(**params):
+        assert params == {expected_name: 'value'}
+        click.echo(params[expected_name])
+
+    option = cli.params[0]
+    assert option.name == expected_name
+
+    for alias in option.opts:
+        result = runner.invoke(cli, [alias, 'value'])
+        assert not result.exception
+        assert result.output == 'value\n'
+
+
