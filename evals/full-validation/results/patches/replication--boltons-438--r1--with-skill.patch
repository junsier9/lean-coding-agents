+@mark.parametrize('set_type', [set, frozenset])
+@mark.parametrize('complement_count', [1, 2])
+@mark.parametrize('left, right', [
+    ('', ''),
+    ('ab', 'ab'),
+    ('ab', 'a'),
+    ('a', 'ab'),
+    ('ab', 'bc'),
+    ('', 'ab'),
+    ('ab', ''),
+])
+def test_complement_containment(set_type, complement_count, left, right):
+    left, right = set_type(left), set_type(right)
+    if complement_count == 1:
+        # Taking complements reverses containment.
+        expected_subset = right <= left
+        expected_superset = right >= left
+    else:
+        expected_subset = left <= right
+        expected_superset = left >= right
+
+    for _ in range(complement_count):
+        left, right = complement(left), complement(right)
+
+    assert left <= left
+    assert left >= left
+    assert (left <= right) is expected_subset
+    assert (left >= right) is expected_superset
+    assert left.issubset(right) is expected_subset
+    assert left.issuperset(right) is expected_superset
+
+
