diff --git a/tests/test_options.py b/tests/test_options.py
index d196fe2..d557868 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -7,6 +7,35 @@ import pytest
 from click._compat import text_type
 
 
+@pytest.mark.parametrize('param_decls, expected_name', [
+    (('--foo', '--foobar'), 'foo'),
+    (('--foobar', '--foo'), 'foobar'),
+    (('-f', '--foo', '--foobar'), 'foo'),
+    (('-f', '--foobar', '--foo'), 'foobar'),
+    (('--foo', '-f', '--foobar'), 'foo'),
+    (('--foobar', '-f', '--foo'), 'foobar'),
+    (('--foo', '--foobar', '-f'), 'foo'),
+    (('--foobar', '--foo', '-f'), 'foobar'),
+    (('-f', '-b'), 'f'),
+    (('-b', '-f'), 'b'),
+    (('--Foo-Bar', '--fb'), 'foo_bar'),
+    (('-f', '--foo', '--foobar', 'dest'), 'dest'),
+])
+def test_option_name_inference(runner, param_decls, expected_name):
+    @click.command()
+    @click.option(*param_decls)
+    def cli(**params):
+        assert params == {expected_name: 'value'}
+        click.echo(params[expected_name])
+
+    for opt in param_decls:
+        if opt.startswith('-'):
+            result = runner.invoke(cli, [opt, 'value'])
+            assert not result.exception
+            assert result.exit_code == 0
+            assert result.output == 'value\n'
+
+
