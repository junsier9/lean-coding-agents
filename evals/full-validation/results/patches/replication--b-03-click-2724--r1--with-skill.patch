+@pytest.mark.parametrize(
+    ("show_default", "expect"),
+    [
+        (True, 'value  [default: ""]'),
+        (False, "value"),
+        ("empty", "value  [default: (empty)]"),
+    ],
+)
+def test_show_default_empty_string(runner, show_default, expect):
+    @click.command()
+    @click.option("--value", default="", show_default=show_default, help="value")
+    def cli(value):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert f"--value TEXT  {expect}\n" in result.output
+
