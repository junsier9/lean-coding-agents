+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize("old_style", ["none", "inner", "outer"])
+def test_wrapper_stopiteration(firstresult: bool, old_style: str) -> None:
+    out = []
+    exception = StopIteration("hook failed")
+
+    @hookimpl
+    def implementation():
+        raise exception
+
+    @hookimpl(wrapper=True)
+    def wrapper():
+        try:
+            yield
+        finally:
+            out.append("wrapper cleanup")
+
+    @hookimpl(wrapper=True)
+    def outer_wrapper():
+        try:
+            yield
+        except StopIteration as exc:
+            assert exc is exception
+            out.append("outer caught")
+            raise
+        finally:
+            out.append("outer cleanup")
+
+    @hookimpl(hookwrapper=True)
+    def old_wrapper():
+        outcome = yield
+        assert outcome.exception is exception
+        out.append("old cleanup")
+
+    methods = [implementation, wrapper, outer_wrapper]
+    expected = ["wrapper cleanup", "outer caught", "outer cleanup"]
+    if old_style == "inner":
+        methods.insert(2, old_wrapper)
+        expected.insert(1, "old cleanup")
+    elif old_style == "outer":
+        methods.append(old_wrapper)
+        expected.append("old cleanup")
+
+    with pytest.raises(StopIteration) as excinfo:
+        try:
+            MC(methods, {}, firstresult=firstresult)
+        finally:
+            out.append("caller cleanup")
+    assert excinfo.value is exception
+    assert out == expected + ["caller cleanup"]
+
+
+@pytest.mark.parametrize("old_style", [False, True])
+@pytest.mark.parametrize("replacement_type", [RuntimeError, StopIteration])
+def test_wrapper_stopiteration_replaced(
+    old_style: bool, replacement_type: "Type[Exception]"
+) -> None:
+    exception = StopIteration("hook failed")
+    replacement = replacement_type("wrapper failed")
+
+    @hookimpl
+    def implementation():
+        raise exception
+
+    @hookimpl(wrapper=True)
+    def wrapper():
+        try:
+            yield
+        except StopIteration:
+            raise replacement
+
+    @hookimpl(hookwrapper=True)
+    def old_wrapper():
+        yield
+
+    methods = [implementation, wrapper]
+    if old_style:
+        methods.append(old_wrapper)
+
+    with pytest.raises(RuntimeError) as excinfo:
+        MC(methods, {})
+    if replacement_type is StopIteration:
+        assert excinfo.value.__cause__ is replacement
+    else:
+        assert excinfo.value is replacement
+
+
