+@pytest.mark.parametrize('name, extra, expected', [
+    ('cli', {}, 'cli'),
+    (None, {}, 'root'),
+    ('cli', {'prog_name': 'custom-name'}, 'custom-name'),
+    (None, {'prog_name': 'custom-name'}, 'custom-name'),
+])
+def test_prog_name(runner, name, extra, expected):
+    @click.pass_context
+    def callback(ctx):
+        click.echo(ctx.info_name)
+
+    cli = click.Command(name, callback=callback)
+
+    result = runner.invoke(cli, **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output == expected + '\n'
+
+    result = runner.invoke(cli, ['--help'], **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output.startswith('Usage: %s [OPTIONS]\n' % expected)
+
+    result = runner.invoke(cli, ['--unknown'], **extra)
+    assert result.exit_code == 2
+    assert isinstance(result.exception, SystemExit)
+    assert result.output == 'Error: no such option: --unknown\n'
+
+
