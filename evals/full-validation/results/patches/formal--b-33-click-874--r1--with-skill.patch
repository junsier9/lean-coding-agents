+@pytest.mark.parametrize('envvar', [None, 'TEST_COUNT'])
+@pytest.mark.parametrize('args, env_value, default_map, expected', [
+    ([], None, None, '1\n'),
+    ([], None, {'count': 2}, '2\n'),
+    ([], None, {'count': 0}, '0\n'),
+    ([], '3', {'count': 2}, '3\n'),
+    ([], '0', {'count': 2}, '0\n'),
+    (['--count', '4'], '3', {'count': 2}, '4\n'),
+    (['--count', '0'], '3', {'count': 2}, '0\n'),
+])
+def test_default_map_precedence(runner, envvar, args, env_value,
+                                default_map, expected):
+    @click.command(context_settings=dict(
+        default_map=default_map, auto_envvar_prefix='TEST'))
+    @click.option('--count', default=1, envvar=envvar)
+    def cli(count):
+        click.echo(count)
+
+    result = runner.invoke(cli, args, env={'TEST_COUNT': env_value})
+
+    assert not result.exception
+    assert result.output == expected
+
+
+def test_default_map_invalid_envvar(runner):
+    @click.command(context_settings=dict(default_map={'count': 2}))
+    @click.option('--count', default=1, envvar='TEST_COUNT')
+    def cli(count):
+        click.echo(count)
+
+    result = runner.invoke(cli, [], env={'TEST_COUNT': 'invalid'})
+    assert result.exit_code == 2
+    assert 'Invalid value for "--count"' in result.output
+
+    result = runner.invoke(cli, ['--count', '4'],
+                           env={'TEST_COUNT': 'invalid'})
+    assert not result.exception
+    assert result.output == '4\n'
+
+
