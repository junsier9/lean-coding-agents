diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index 20c431f..1ff491e 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -391,6 +391,72 @@ def test_one_to_one():
     return
 
 
+_OTO_UPDATE_INPUT_FACTORIES = [
+    pytest.param(dict, id='dict'),
+    pytest.param(list, id='list'),
+    pytest.param(tuple, id='tuple'),
+    pytest.param(iter, id='iterator'),
+    pytest.param(lambda pairs: (pair for pair in pairs), id='generator'),
+]
+
+
+@pytest.mark.parametrize('input_factory', _OTO_UPDATE_INPUT_FACTORIES)
+@pytest.mark.parametrize('initial', [{}, {'a': 1}])
+def test_one_to_one_update_empty(input_factory, initial):
+    oto = OneToOne(initial)
+    inverse = oto.inv
+    expected_inverse = {v: k for k, v in initial.items()}
+
+    assert oto.update(input_factory([])) is None
+    assert oto == initial
+    assert inverse == expected_inverse
+    assert inverse.update(input_factory([])) is None
+    assert oto == initial
+    assert inverse == expected_inverse
+    assert oto.inv is inverse
+    assert inverse.inv is oto
+
+    oto.update({'b': 2})
+    oto.update([('b', 3), ('c', 3)], c=4)
+    expected = dict(initial, c=4)
+    assert oto == expected
+    assert inverse == {v: k for k, v in expected.items()}
+
+
+@pytest.mark.parametrize('input_factory', _OTO_UPDATE_INPUT_FACTORIES)
+def test_one_to_one_update_empty_with_keywords(input_factory):
+    oto = OneToOne({'a': 1, 'b': 2})
+    with pytest.raises(TypeError):
+        oto.update(input_factory([]), c=[])
+    assert oto == {'a': 1, 'b': 2}
+    assert oto.inv == {1: 'a', 2: 'b'}
+
+    assert oto.update(input_factory([]), a=2, c=3) is None
+    assert oto == {'a': 2, 'c': 3}
+    assert oto.inv == {2: 'a', 3: 'c'}
+
+    assert oto.inv.update(input_factory([]), replacement='a') is None
+    assert oto == {'a': 'replacement', 'c': 3}
+    assert oto.inv == {'replacement': 'a', 3: 'c'}
+
+
+@pytest.mark.parametrize('input_factory', _OTO_UPDATE_INPUT_FACTORIES)
+def test_one_to_one_update_with_keywords(input_factory):
+    oto = OneToOne({'a': 1, 'b': 2})
+    assert oto.update(input_factory([('a', 2), ('c', 3)]), a=4) is None
+    assert oto == {'a': 4, 'c': 3}
+    assert oto.inv == {4: 'a', 3: 'c'}
+
+
+@pytest.mark.parametrize('invalid_pair', [([], 3), ('c', [])])
+def test_one_to_one_update_invalid_iterator(invalid_pair):
+    oto = OneToOne({'a': 1})
+    with pytest.raises(TypeError):
+        oto.update(iter([('b', 2), invalid_pair]))
+    assert oto == {'a': 1}
+    assert oto.inv == {1: 'a'}
+
+
