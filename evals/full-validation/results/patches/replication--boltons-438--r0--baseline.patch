+@mark.parametrize('set_type', [set, frozenset])
+@mark.parametrize('values', ['', 'ab'])
+def test_complement_inclusion_reflexive(set_type, values):
+    complemented = complement(set_type(values))
+    for subject in (complemented, complement(complemented)):
+        assert subject <= subject
+        assert subject >= subject
+        assert subject.issubset(subject)
+        assert subject.issuperset(subject)
+
+
+@mark.parametrize('set_type', [set, frozenset])
+@mark.parametrize('left_values, right_values, subset, superset', [
+    ('', '', True, True),
+    ('ab', 'ab', True, True),
+    ('a', 'ab', True, False),
+    ('ab', 'a', False, True),
+    ('a', 'b', False, False),
+    ('ab', 'bc', False, False),
+    ('', 'ab', True, False),
+    ('ab', '', False, True),
+])
+def test_complement_inclusion_comparisons(set_type, left_values, right_values,
+                                          subset, superset):
+    left = complement(set_type(left_values))
+    right = complement(set_type(right_values))
+    # Complementing both sets reverses their inclusion relationship.
+    assert (left <= right) is superset
+    assert (right >= left) is superset
+    assert left.issubset(right) is superset
+    assert (left >= right) is subset
+    assert (right <= left) is subset
+    assert left.issuperset(right) is subset
+
+    # Double complements behave like the original finite sets, including
+    # comparisons with regular sets in either operand position.
+    left = complement(left)
+    right = complement(right)
+    for other in (right, set(right_values), frozenset(right_values)):
+        assert (left <= other) is subset
+        assert (other >= left) is subset
+        assert left.issubset(other) is subset
+        assert (left >= other) is superset
+        assert (other <= left) is superset
+        assert left.issuperset(other) is superset
+
+
