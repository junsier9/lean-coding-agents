@@ -2,9 +2,44 @@ import re
 import uuid
 from unittest import TestCase
 
+import pytest
+
 from boltons import strutils
 
 
+@pytest.mark.parametrize('exponent, symbol', enumerate('KMGTPEZY', 1))
+@pytest.mark.parametrize('sign', [1, -1])
+@pytest.mark.parametrize('ndigits', [0, 2])
+def test_bytes2human_exact_boundaries(exponent, symbol, sign, ndigits):
+    expected = ('-' if sign < 0 else '') + ('1.00' if ndigits else '1') + symbol
+    assert strutils.bytes2human(sign * 1024 ** exponent, ndigits) == expected
+
+
+@pytest.mark.parametrize('exponent, symbol', enumerate('BKMGTPEZ', 1))
+@pytest.mark.parametrize('sign', [1, -1])
+def test_bytes2human_below_boundaries(exponent, symbol, sign):
+    expected = ('-' if sign < 0 else '') + ('1023' if exponent == 1 else '1024') + symbol
+    assert strutils.bytes2human(sign * (1024 ** exponent - 1)) == expected
+
+
+@pytest.mark.parametrize('nbytes, ndigits, expected', [
+    (0, 0, '0B'),
+    (0, 2, '0.00B'),
+    (1, 0, '1B'),
+    (-1, 0, '-1B'),
+    (1023, 2, '1023.00B'),
+    (1025, 2, '1.00K'),
+    (1536, 0, '2K'),
+    (1536, 1, '1.5K'),
+    (-1536, 2, '-1.50K'),
+    (128991, 0, '126K'),
+    (100001221, 0, '95M'),
+    (1024 ** 8 + 1024 ** 7, 2, '1.00Y'),
+])
+def test_bytes2human_formatting(nbytes, ndigits, expected):
+    assert strutils.bytes2human(nbytes, ndigits) == expected
+
+
 def test_strip_ansi():
