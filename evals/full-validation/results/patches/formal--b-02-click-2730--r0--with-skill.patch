 import click
 
 
@@ -13,6 +15,31 @@ def test_basic_defaults(runner):
     assert "FOO:[42.0]" in result.output
 
 
+@pytest.mark.parametrize(
+    ("default", "override", "expected"),
+    [
+        (True, False, "no-cache"),
+        (False, True, "cache"),
+        (True, True, "cache"),
+        (False, False, "no-cache"),
+    ],
+)
+def test_boolean_flag_default_map_help(runner, default, override, expected):
+    @click.command()
+    @click.option("--cache/--no-cache", default=default, show_default=True)
+    def cli(cache):
+        return cache
+
+    default_map = {"cache": override}
+    result = runner.invoke(cli, [], default_map=default_map, standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value is override
+
+    result = runner.invoke(cli, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    assert f"[default: {expected}]" in result.output
+
+
 def test_multiple_defaults(runner):
     @click.command()
     @click.option("--foo", default=[23, 42], type=click.FLOAT, multiple=True)
