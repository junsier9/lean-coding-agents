+        '  --help      Show this message and exit.',
+    ]),
+])
+def test_multiline_help_wrapping(runner, terminal_width, expected):
+    @click.command()
+    @click.option('--foo', help="""
+        A first paragraph
+        that is rewrapped to the terminal width.
+
+        A second paragraph
+        that also wraps at the terminal width.
+    """)
+    def cmd(foo):
+        pass
+
+    result = runner.invoke(cmd, ['--help'], terminal_width=terminal_width)
+    assert result.exit_code == 0
+    assert [line.rstrip() for line in result.output.splitlines()] == [
+        'Usage: cmd [OPTIONS]',
+        '',
+        'Options:',
+    ] + expected
+    assert all(len(line) <= terminal_width for line in result.output.splitlines())
