diff --git a/more_itertools/more.py b/more_itertools/more.py
index c128bc9..125e3af 100644
--- a/more_itertools/more.py
+++ b/more_itertools/more.py
@@ -3702,6 +3702,9 @@ def ichunked(iterable, n):
     :func:`ichunked` is like :func:`chunked`, but it yields iterables
     instead of lists.
 
+    If *n* is zero, no sub-iterables are yielded and *iterable* is not consumed.
+    If *n* is negative, ``ValueError`` is raised.
+
     If the sub-iterables are read in order, the elements of *iterable*
     won't be stored in memory.
     If they are read out of order, :func:`itertools.tee` is used to cache
@@ -3718,6 +3721,11 @@ def ichunked(iterable, n):
     [8, 9, 10, 11]
 
     """
+    if n < 0:
+        raise ValueError('n must be at least 0')
+    elif n == 0:
+        return
+
     iterator = iter(iterable)
     for first in iterator:
         rest = islice(iterator, n - 1)
