+@pytest.mark.parametrize("name", [None, "other", ""])
+def test_add_completion_class(monkeypatch, name):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    class CustomComplete(ShellComplete):
+        name = "custom"
+
+    assert add_completion_class(CustomComplete, name) is CustomComplete
+    assert get_completion_class("custom" if name is None else name) is CustomComplete
+    assert CustomComplete.name == "custom"
+
+    if name is not None:
+        assert get_completion_class("custom") is None
+
+
+def test_add_completion_class_decorator(monkeypatch, runner):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    @add_completion_class
+    class CustomComplete(ShellComplete):
+        name = "custom"
+        source_template = "%(prog_name)s custom"
+
+        def get_completion_args(self):
+            return [], "a"
+
+        def format_completion(self, item):
+            return f"{item.type},{item.value}"
+
+    assert issubclass(CustomComplete, ShellComplete)
+    assert get_completion_class("custom") is CustomComplete
+
+    cli = Group("cli", commands=[Command("a"), Command("b")])
+    result = runner.invoke(cli, env={"_CLI_COMPLETE": "custom_source"})
+    assert result.exit_code == 0
+    assert result.output == "cli custom\n"
+
+    result = runner.invoke(cli, env={"_CLI_COMPLETE": "custom_complete"})
+    assert result.exit_code == 0
+    assert result.output == "plain,a\n"
+
+
