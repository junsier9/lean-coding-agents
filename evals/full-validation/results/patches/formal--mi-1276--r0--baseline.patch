+    def test_reversed_datetime_boundaries(self):
+        step = timedelta(microseconds=1)
+        for start, stop, delta, expected in [
+            (
+                datetime.min,
+                datetime.min + 3 * step,
+                step,
+                [datetime.min + i * step for i in range(3)],
+            ),
+            (
+                datetime.max,
+                datetime.max - 3 * step,
+                -step,
+                [datetime.max - i * step for i in range(3)],
+            ),
+            (datetime.min, datetime.min + step, 2 * step, [datetime.min]),
+            (datetime.max, datetime.max - step, -2 * step, [datetime.max]),
+            (
+                datetime.max - 3 * step,
+                datetime.max,
+                2 * step,
+                [datetime.max - 3 * step, datetime.max - step],
+            ),
+            (
+                datetime.min + 3 * step,
+                datetime.min,
+                -2 * step,
+                [datetime.min + 3 * step, datetime.min + step],
+            ),
+            (datetime.min, datetime.min, step, []),
+            (datetime.max, datetime.max, -step, []),
+            (datetime.min, datetime.max, -step, []),
+            (datetime.max, datetime.min, step, []),
+        ]:
+            with self.subTest(start=start, stop=stop, step=delta):
+                r = mi.numeric_range(start, stop, delta)
