diff --git a/tests/test_tableutils.py b/tests/test_tableutils.py
index 4524386..681d4c2 100644
--- a/tests/test_tableutils.py
+++ b/tests/test_tableutils.py
@@ -1,3 +1,5 @@
+import pytest
+
 from boltons.tableutils import Table
 
 
@@ -52,3 +54,47 @@ def test_table_obj():
     t4 = Table.from_object(TestType())
     assert len(t4) == 1
     assert 'greeting' in t4.headers
+
+
+@pytest.mark.parametrize('data', [None, [], [[]], [[], []]])
+@pytest.mark.parametrize('with_headers', [True, False])
+def test_table_text_empty(data, with_headers):
+    assert Table(data).to_text(with_headers=with_headers) == ''
+
+
+@pytest.mark.parametrize('headers', [None, []])
+@pytest.mark.parametrize('with_headers', [True, False])
+def test_table_text_without_headers(headers, with_headers):
+    table = Table([['alpha', 1], ['beta', None]], headers=headers)
+    assert table.to_text(with_headers=with_headers) == 'alpha |  1  \n beta | None'
+
+
+@pytest.mark.parametrize('maxlen, expected', [
+    (None, 'None\n----\nNone'),
+    (3, '...\n---\n...'),
+])
+def test_table_text_none_header(maxlen, expected):
+    table = Table([[None]], headers=[None])
+    assert table.to_text(maxlen=maxlen) == expected
+
+
+@pytest.mark.parametrize('shorten_headers', [False, True])
+@pytest.mark.parametrize('with_headers, maxlen', [(True, None), (False, None), (True, 3)])
+def test_table_text_short_headers(shorten_headers, with_headers, maxlen):
+    headers = ['id', 'name'] if shorten_headers else ['id']
+    table = Table([[1, 'Alice'], [2]], headers=headers)
+    if shorten_headers:
+        table.headers.pop()
+    expected = Table([[1, 'Alice'], [2, None]], headers=['id', None])
+
+    assert table.to_text(with_headers=with_headers, maxlen=maxlen) == expected.to_text(
+        with_headers=with_headers, maxlen=maxlen)
+    assert table.headers == ['id']
+    for orientation in ('horizontal', 'vertical'):
+        assert table.to_html(orientation=orientation) == expected.to_html(orientation=orientation)
+
+
+def test_table_text_header_only():
+    table = Table([['name']])
+    assert table.to_text() == 'name\n----'
+    assert table.to_text(with_headers=False) == ''
