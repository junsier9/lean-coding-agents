+    def test_reversed_none(self):
+        class NonReversibleRange(IterOnlyRange):
+            __reversed__ = None
+
+        class Mapping(abc.Mapping):
+            def __init__(self, data):
+                self.data = data
+
+            def __iter__(self):
+                return iter(self.data)
+
+            def __getitem__(self, key):
+                return self.data[key]
+
+            def __len__(self):
+                return len(self.data)
+
+        default = object()
+        cases = [
+            (NonReversibleRange(0), default),
+            (NonReversibleRange(1), 0),
+            (NonReversibleRange(5), 4),
+            (Mapping({}), default),
+            (Mapping({'only': 10}), 'only'),
+            (Mapping({0: 'zero', -1: 'minus one', 2: 'two'}), 2),
+        ]
+        for iterable, expected in cases:
+            with self.subTest(iterable=iterable):
+                if expected is default:
+                    with self.assertRaises(ValueError):
+                        mi.last(iterable)
+                else:
+                    self.assertEqual(mi.last(iterable), expected)
+                self.assertEqual(mi.last(iterable, default), expected)
+                self.assertEqual(mi.last(iterable, default=default), expected)
+
+    def test_reversed(self):
+        class ReversibleRange(IterOnlyRange):
+            def __iter__(self):
+                raise AssertionError('Forward iteration should not be used')
+
+            def __reversed__(self):
+                return reversed(range(self.n))
+
+        self.assertEqual(mi.last(ReversibleRange(5)), 4)
+        self.assertEqual(mi.last(ReversibleRange(5), None), 4)
+        with self.assertRaises(ValueError):
+            mi.last(ReversibleRange(0))
+        default = object()
+        self.assertIs(mi.last(ReversibleRange(0), default), default)
+
 
