+    def test_iterables(self):
+        for factories in product((list, iter), repeat=3):
+            with self.subTest(factories=factories):
+                element, *pools = (
+                    factory(values)
+                    for factory, values in zip(
+                        factories, (['i', 'a'], 'ghi', 'abcdef')
+                    )
+                )
+                self.assertEqual(mi.product_index(element, *pools), 12)
+
+    def test_iterators_multiplicity(self):
+        iterables = ['ab', 'bab', 'cab']
+        first_index = {}
+        for index, element in enumerate(product(*iterables)):
+            actual = mi.product_index(iter(element), *map(iter, iterables))
+            expected = first_index.setdefault(element, index)
+            self.assertEqual(actual, expected)
+
+    def test_empty(self):
+        for factory in (list, iter):
+            with self.subTest(factory=factory):
+                self.assertEqual(mi.product_index(factory([])), 0)
+
+    def test_invalid_iterables(self):
+        cases = [
+            ('', ['ab', 'cde', 'fghi']),
+            ('ac', ['ab', 'cde', 'fghi']),
+            ('achi', ['ab', 'cde', 'fghi']),
+            ('axf', ['ab', 'cde', 'fghi']),
+            ('acf', ['ab', '', 'fghi']),
+            ('a', []),
+        ]
+        for element, pools in cases:
+            for factory in (list, iter):
+                with self.subTest(
+                    element=element, pools=pools, factory=factory
+                ):
+                    with self.assertRaises(ValueError):
+                        mi.product_index(
+                            factory(element), *map(factory, pools)
+                        )
