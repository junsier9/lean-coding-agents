+        '',
+        '              multiline',
+        '  --help      Show this message and exit.',
+    ]
+
+
+@pytest.mark.parametrize('terminal_width, expected', [
+    (40, [
+        '  --foo TEXT  First paragraph has',
+        '              multiple source lines and',
+        '              wraps at terminal width.',
+        '',
+        '              Second paragraph also has',
+        '              multiple source lines and',
+        '              wraps independently.',
+        '  --help      Show this message and',
+        '              exit.',
+    ]),
+    (60, [
+        '  --foo TEXT  First paragraph has multiple source lines and',
+        '              wraps at terminal width.',
+        '',
+        '              Second paragraph also has multiple source',
+        '              lines and wraps independently.',
+        '  --help      Show this message and exit.',
+    ]),
+])
+def test_multiline_help_wrapping(runner, terminal_width, expected):
+    @click.command()
+    @click.option('--foo', help="""
+        First paragraph has
+        multiple source lines and wraps at terminal width.
+
+        Second paragraph also has
+        multiple source lines and wraps independently.
+    """)
+    def cmd(foo):
+        pass
+
+    result = runner.invoke(cmd, ['--help'], terminal_width=terminal_width)
+    assert result.exit_code == 0
+    assert result.output.splitlines() == [
+        'Usage: cmd [OPTIONS]',
+        '',
+        'Options:',
+    ] + expected
+
 
