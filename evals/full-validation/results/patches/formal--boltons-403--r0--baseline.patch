diff --git a/tests/test_strutils.py b/tests/test_strutils.py
index 1ffa916..c38e080 100644
--- a/tests/test_strutils.py
+++ b/tests/test_strutils.py
@@ -2,9 +2,45 @@ import re
 import uuid
 from unittest import TestCase
 
+import pytest
+
 from boltons import strutils
 
 
+@pytest.mark.parametrize(('power', 'symbol'), enumerate('KMGTPEZY', 1))
+@pytest.mark.parametrize(('sign', 'prefix'), [(1, ''), (-1, '-')])
+@pytest.mark.parametrize(('ndigits', 'value'), [(0, '1'), (2, '1.00')])
+def test_bytes2human_exact_boundaries(power, symbol, sign, prefix, ndigits, value):
+    assert strutils.bytes2human(sign * 1024 ** power, ndigits) == prefix + value + symbol
+
+
+@pytest.mark.parametrize(('power', 'symbol'), enumerate('BKMGTPEZ', 1))
+@pytest.mark.parametrize(('sign', 'prefix'), [(1, ''), (-1, '-')])
+def test_bytes2human_below_boundaries(power, symbol, sign, prefix):
+    value = '1023' if power == 1 else '1024'
+    assert strutils.bytes2human(sign * (1024 ** power - 1)) == prefix + value + symbol
+
+
+@pytest.mark.parametrize(('nbytes', 'ndigits', 'expected'), [
+    (0, 0, '0B'),
+    (0, 2, '0.00B'),
+    (1, 0, '1B'),
+    (512, 2, '512.00B'),
+    (-512, 0, '-512B'),
+    (1000, 0, '1000B'),
+    (1025, 0, '1K'),
+    (1536, 0, '2K'),
+    (1536, 1, '1.5K'),
+    (-1536, 2, '-1.50K'),
+    (128991, 0, '126K'),
+    (100001221, 0, '95M'),
+    (100001221, 3, '95.369M'),
+    (2 * 1024 ** 8, 2, '2.00Y'),
+])
+def test_bytes2human_formatting(nbytes, ndigits, expected):
+    assert strutils.bytes2human(nbytes, ndigits) == expected
+
+
 def test_strip_ansi():
     assert strutils.strip_ansi(
         '\x1b[0m\x1b[1;36mart\x1b[46;34m\xdc') == 'art\xdc'
