+@pytest.mark.parametrize('start', [0.5, 1, 5])
+@pytest.mark.parametrize('factor', [1.0, 2.0])
+def test_backoff_equal_endpoints(start, factor):
+    from boltons.iterutils import backoff, backoff_iter
+
+    for func in (backoff, backoff_iter):
+        assert list(func(start, start, factor=factor)) == [start]
+
+
+@pytest.mark.parametrize('start, stop', [(1, 16), (0.5, 2), (0, 16)])
+def test_backoff_factor_one_requires_count(start, stop):
+    from boltons.iterutils import backoff, backoff_iter
+
+    for func in (backoff, backoff_iter):
+        with pytest.raises(ValueError, match='count.*factor'):
+            list(func(start, stop, factor=1.0))
+
+
+@pytest.mark.parametrize('start, stop, expected', [
+    (1, 16, [1.0, 1.0, 1.0]),
+    (5, 5, [5.0, 5.0, 5.0]),
+    (0, 16, [0.0, 1.0, 1.0]),
+    (0, 0.5, [0.0, 0.5, 0.5]),
+])
+def test_backoff_factor_one_explicit_count(start, stop, expected):
+    from itertools import islice
+    from boltons.iterutils import backoff, backoff_iter
+
+    for func in (backoff, backoff_iter):
+        assert list(func(start, stop, count=3, factor=1.0)) == expected
+        assert list(func(start, stop, count=0, factor=1.0)) == []
+    repeated = backoff_iter(start, stop, count='repeat', factor=1.0)
+    assert list(islice(repeated, 3)) == expected
+
+
