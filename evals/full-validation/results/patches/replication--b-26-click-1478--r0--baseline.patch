+        'Options:',
+        '  --foo TEXT  hello',
+        '',
+        '              i am',
+        '',
+        '              multiline',
+        '  --help      Show this message and exit.',
+    ]
+
+
+@pytest.mark.parametrize(('terminal_width', 'paragraphs', 'help_lines'), [
+    (40, [
+        ['First paragraph has lines', 'that should be joined and', 'wrapped.'],
+        ['Second paragraph also', 'spans several source lines',
+         'and should wrap.'],
+    ], ['Show this message and', 'exit.']),
+    (60, [
+        ['First paragraph has lines that should be', 'joined and wrapped.'],
+        ['Second paragraph also spans several source', 'lines and should wrap.'],
+    ], ['Show this message and exit.']),
+])
+def test_multiline_help_rewrapping(runner, terminal_width, paragraphs,
+                                  help_lines):
+    @click.command()
+    @click.option('--foo', help="""
+        First paragraph has lines
+        that should be joined and wrapped.
+
+        Second paragraph also spans
+        several source lines and should wrap.
+    """)
+    def cmd(foo):
+        pass
+
+    result = runner.invoke(cmd, ['--help'], terminal_width=terminal_width)
+    assert result.exit_code == 0
+    first, second = paragraphs
+    assert result.output.splitlines() == [
+        'Usage: cmd [OPTIONS]',
+        '',
+        'Options:',
+        '  --foo TEXT  ' + first[0],
+    ] + ['              ' + line for line in first[1:]] + [
+        '',
+    ] + ['              ' + line for line in second] + [
+        '  --help      ' + help_lines[0],
+    ] + ['              ' + line for line in help_lines[1:]]
+    assert all(len(line) <= terminal_width
+               for line in result.output.splitlines())
+
+
+def test_multiline_help_long_option(runner):
+    @click.command()
