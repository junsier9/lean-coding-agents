+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+def test_iter_find_files_pathlike(tmp_path, path_type):
+    nested = tmp_path / 'nested.txt'
+    deeper = nested / 'deeper'
+    deeper.mkdir(parents=True)
+    files = [tmp_path / 'root.txt', nested / 'child.txt', deeper / 'leaf.txt']
+    for path in files + [tmp_path / 'skip.txt', tmp_path / 'other.py']:
+        path.touch()
+
+    directory = path_type(tmp_path)
+    assert set(iter_find_files(directory, '*.txt', ignored='skip*')) == {
+        str(path) for path in files}
+    assert set(iter_find_files(directory, '*.txt', ignored='skip*', max_depth=0)) == {
+        str(files[0])}
+    assert set(iter_find_files(directory, '*.txt', ignored='skip*', max_depth=1)) == {
+        str(path) for path in files[:2]}
+    assert set(iter_find_files(directory, '*.txt', ignored='skip*', include_dirs=True)) == {
+        str(path) for path in files + [nested]}
+
+
