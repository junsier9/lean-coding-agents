+import pytest
 
 from boltons import fileutils
 from boltons.fileutils import FilePerms, iter_find_files
@@ -12,6 +11,58 @@ from boltons.strutils import removeprefix
 BOLTONS_PATH = os.path.dirname(os.path.abspath(fileutils.__file__))
 
 
+class _PathLike(os.PathLike):
+    def __init__(self, path):
+        self.path = path
+
+    def __fspath__(self):
+        return os.fspath(self.path)
+
+
+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+@pytest.mark.parametrize('save', [fileutils.AtomicSaver, fileutils.atomic_save])
+@pytest.mark.parametrize('relative', [False, True])
+def test_atomic_save_pathlike(tmp_path, monkeypatch, path_type, save, relative):
+    monkeypatch.chdir(tmp_path)
+    dest = tmp_path / 'saved.txt'
+    part = tmp_path / 'saved.txt.part'
+    path = path_type(dest.name if relative else dest)
+
+    with save(path) as stream:
+        stream.write(b'first version')
+        assert part.exists()
+        assert not dest.exists()
+    assert dest.read_bytes() == b'first version'
+    assert not part.exists()
+
+    with save(path) as stream:
+        stream.write(b'second version')
+        assert dest.read_bytes() == b'first version'
+    assert dest.read_bytes() == b'second version'
+    assert not part.exists()
+
+
+def test_atomic_save_pathlike_exception(tmp_path):
+    dest = tmp_path / 'saved.txt'
+    dest.write_bytes(b'original')
+    with pytest.raises(ValueError, match='abort save'):
+        with fileutils.atomic_save(dest) as stream:
+            stream.write(b'incomplete')
+            raise ValueError('abort save')
+    assert dest.read_bytes() == b'original'
+    assert not (tmp_path / 'saved.txt.part').exists()
+
+
+def test_atomic_save_pathlike_no_overwrite(tmp_path):
+    dest = tmp_path / 'saved.txt'
+    dest.write_bytes(b'original')
+    with pytest.raises(FileExistsError):
+        with fileutils.atomic_save(dest, overwrite=False):
+            pytest.fail('existing destination should prevent entry')
+    assert dest.read_bytes() == b'original'
+    assert not (tmp_path / 'saved.txt.part').exists()
+
+
