+    def test_iterator_type_error(self):
+        for values in ([5], ['ab', 'cde', 5]):
+            with self.subTest(values=values):
+                actual = mi.value_chain(map(len, values), 'later')
+                for value in values[:-1]:
+                    self.assertEqual(next(actual), len(value))
+                with self.assertRaises(TypeError):
+                    next(actual)
+                with self.assertRaises(StopIteration):
+                    next(actual)
+
+    def test_sequence_iteration_error(self):
+        error = TypeError('sequence iteration failed')
+
+        class Sequence:
+            def __getitem__(self, index):
+                if index < 2:
+                    return index
+                raise error
+
+        actual = mi.value_chain(Sequence())
+        self.assertEqual(next(actual), 0)
+        self.assertEqual(next(actual), 1)
+        with self.assertRaises(TypeError) as caught:
+            next(actual)
+        self.assertIs(caught.exception, error)
+
+    def test_non_iterable(self):
+        class NonIterable:
+            __iter__ = None
+
+        obj = NonIterable()
+        self.assertEqual(list(mi.value_chain(None, obj)), [None, obj])
