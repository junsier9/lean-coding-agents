diff --git a/tests/test_options.py b/tests/test_options.py
index d196fe2..7bfa720 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -7,6 +7,37 @@ import pytest
 from click._compat import text_type
 
 
+@pytest.mark.parametrize('param_decls', [
+    ('--foo-bar', '--f'),
+    ('-f', '--foo-bar', '--filename'),
+    ('--foo-bar', '-f', '--filename'),
+    ('--foo-bar', '--filename', '-f'),
+    ('--FOO-BAR', '--filename'),
+])
+def test_name_from_first_long_option(runner, param_decls):
+    @click.command()
+    @click.option(*param_decls)
+    def cli(foo_bar):
+        click.echo(foo_bar)
+
+    for opt in param_decls:
+        result = runner.invoke(cli, [opt, '42'])
+        assert result.exit_code == 0
+        assert result.output == '42\n'
+
+
+@pytest.mark.parametrize('param_decls, name', [
+    (('--f', '--foo-bar'), 'f'),
+    (('-f', '-b'), 'f'),
+    (('-b', '-f'), 'b'),
+    (('-filename', '--f'), 'f'),
+    (('--foo', '--bar', 'dest'), 'dest'),
+    (('dest', '--foo', '--bar'), 'dest'),
+])
+def test_option_name(param_decls, name):
+    assert click.Option(param_decls).name == name
+
+
