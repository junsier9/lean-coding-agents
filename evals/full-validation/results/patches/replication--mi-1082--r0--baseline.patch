+    def test_iterators(self):
+        for target_type, pool_type in product((list, iter), repeat=2):
+            with self.subTest(target_type=target_type, pool_type=pool_type):
+                actual = mi.product_index(
+                    target_type(['i', 'a']),
+                    pool_type('ghi'),
+                    pool_type('abcdef'),
+                )
+                self.assertEqual(actual, 12)
+
+    def test_generator(self):
+        actual = mi.product_index(
+            (value for value in ['i', 'a']), iter('ghi'), iter('abcdef')
+        )
+        self.assertEqual(actual, 12)
+
+    def test_empty_iterator(self):
+        self.assertEqual(mi.product_index(iter(())), 0)
+
+    def test_iterator_multiplicity(self):
+        iterables = ['ab', 'bab', 'cab']
+        first_index = {}
+        for index, element in enumerate(product(*iterables)):
+            with self.subTest(element=element):
+                actual = mi.product_index(iter(element), *map(iter, iterables))
+                expected = first_index.setdefault(element, index)
+                self.assertEqual(actual, expected)
+
+    def test_invalid_iterators(self):
+        for element, iterables in (
+            ('', ('ab', 'cde', 'fghi')),
+            ('ac', ('ab', 'cde', 'fghi')),
+            ('achi', ('ab', 'cde', 'fghi')),
+            ('axf', ('ab', 'cde', 'fghi')),
+            ('a', ('',)),
+            ('a', ()),
+        ):
+            with self.subTest(element=element, iterables=iterables):
+                with self.assertRaises(ValueError):
+                    mi.product_index(iter(element), *map(iter, iterables))
