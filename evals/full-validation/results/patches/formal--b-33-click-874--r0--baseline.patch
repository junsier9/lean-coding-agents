+@pytest.mark.parametrize('auto_envvar', [False, True])
+@pytest.mark.parametrize('command_defaults', [False, True])
+@pytest.mark.parametrize('args, env_value, map_value, expected', [
+    ([], None, None, 'normal'),
+    ([], None, 'mapped', 'mapped'),
+    ([], 'environment', 'mapped', 'environment'),
+    (['--name', 'command-line'], 'environment', 'mapped', 'command-line'),
+    (['--name', ''], 'environment', 'mapped', ''),
+    ([], '', 'mapped', ''),
+    ([], None, '', ''),
+])
+def test_default_map_precedence(runner, auto_envvar, command_defaults,
+                               args, env_value, map_value, expected):
+    default_map = {'foo': {'name': map_value}}
+
+    @click.group(context_settings=(
+        {'default_map': default_map} if command_defaults else None))
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option('--name', default='normal',
+                  envvar=None if auto_envvar else 'CLICK_TEST_NAME')
+    def foo(name):
+        click.echo(name)
+
+    envvar = 'CLICK_TEST_FOO_NAME' if auto_envvar else 'CLICK_TEST_NAME'
+    kwargs = {}
+    if auto_envvar:
+        kwargs['auto_envvar_prefix'] = 'CLICK_TEST'
+    if not command_defaults:
+        kwargs['default_map'] = default_map
+    result = runner.invoke(cli, ['foo'] + args,
+                           env={envvar: env_value}, **kwargs)
+
+    assert not result.exception
+    assert result.output == expected + '\n'
+
+
