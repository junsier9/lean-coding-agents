+import pytest
+
 import click
 
 
@@ -49,6 +51,50 @@ def test_basic_functionality(runner):
     ]
 
 
+@pytest.mark.parametrize(
+    "options_metavar, usage",
+    [
+        ("", "ARG [OPTIONAL]"),
+        (None, "ARG [OPTIONAL]"),
+        ("[OPTIONS]", "[OPTIONS] ARG [OPTIONAL]"),
+        ("<options>", "<options> ARG [OPTIONAL]"),
+    ],
+)
+@pytest.mark.parametrize("args", [["--help"], []])
+def test_formatting_options_metavar(runner, options_metavar, usage, args):
+    @click.command(options_metavar=options_metavar)
+    @click.argument("arg")
+    @click.argument("optional", required=False)
+    def cli(arg, optional):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == (0 if args else 2)
+    assert result.output.splitlines() == [f"Usage: cli {usage}"] + (
+        ["", "Options:", "  --help  Show this message and exit."]
+        if args
+        else ["Try 'cli --help' for help.", "", "Error: Missing argument 'ARG'."]
+    )
+
+
+@pytest.mark.parametrize("options_metavar", ["", None])
+@pytest.mark.parametrize(
+    "chain, subcommand_metavar",
+    [(False, "COMMAND [ARGS]..."), (True, "COMMAND1 [ARGS]... [COMMAND2 [ARGS]...]...")],
+)
+def test_formatting_group_no_options_metavar(
+    runner, options_metavar, chain, subcommand_metavar
+):
+    @click.group(options_metavar=options_metavar, chain=chain)
+    @click.argument("arg")
+    def cli(arg):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines()[0] == f"Usage: cli ARG {subcommand_metavar}"
+
+
