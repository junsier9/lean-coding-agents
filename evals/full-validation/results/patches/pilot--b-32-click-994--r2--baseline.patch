+@pytest.mark.parametrize('decorate_command', [False, True])
+def test_option_custom_class_reuse(runner, decorate_command):
+    class CustomOption(click.Option):
+        def get_default(self, ctx):
+            return 'custom default'
+
+    shared_option = click.option(
+        '-t', '--testoption', cls=CustomOption, default='ordinary default',
+        help='''
+            Shared option.
+
+            More details.
+        ''')
+
+    commands = []
+    for _ in range(3):
+        def cmd(testoption):
+            click.echo(testoption)
+
+        if decorate_command:
+            cmd = shared_option(click.command()(cmd))
+        else:
+            cmd = click.command()(shared_option(cmd))
+        commands.append(cmd)
+
+        assert len(cmd.params) == 1
+        option = cmd.params[0]
+        assert isinstance(option, CustomOption)
+        assert option.opts == ['-t', '--testoption']
+        assert option.default == 'ordinary default'
+        assert option.help == 'Shared option.\n\nMore details.'
+
+        result = runner.invoke(cmd)
+        assert result.exit_code == 0
+        assert result.output == 'custom default\n'
+
+        for flag in ['-t', '--testoption']:
+            result = runner.invoke(cmd, [flag, 'explicit value'])
+            assert result.exit_code == 0
+            assert result.output == 'explicit value\n'
+
+        result = runner.invoke(cmd, ['--help'])
+        assert result.exit_code == 0
+        assert 'Shared option.' in result.output
+        assert 'More details.' in result.output
+
+    assert len(set(id(cmd.params[0]) for cmd in commands)) == 3
+    commands[0].params[0].help = 'Changed help.'
+    assert commands[1].params[0].help == 'Shared option.\n\nMore details.'
+    assert commands[2].params[0].help == 'Shared option.\n\nMore details.'
+
+
