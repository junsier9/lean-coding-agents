+@pytest.mark.parametrize('command_name, extra, expected_name', [
+    ('cli', {}, 'cli'),
+    (None, {}, 'root'),
+    ('cli', {'prog_name': 'custom-cli'}, 'custom-cli'),
+    (None, {'prog_name': 'custom-cli'}, 'custom-cli'),
+])
+def test_runner_prog_name(command_name, extra, expected_name):
+    @click.pass_context
+    def cli(ctx):
+        click.echo('name=%s' % ctx.info_name)
+
+    command = click.Command(command_name, callback=cli)
+    runner = CliRunner()
+
+    result = runner.invoke(command, **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output == 'name=%s\n' % expected_name
+
+    result = runner.invoke(command, ['--help'], **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output.startswith('Usage: %s [OPTIONS]\n' % expected_name)
+
+
