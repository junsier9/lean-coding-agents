+@pytest.mark.parametrize('start', [0.25, 1, 5])
+@pytest.mark.parametrize('factor', [1.0, 2.0, 10.0])
+def test_backoff_equal_endpoints(start, factor):
+    from boltons.iterutils import backoff, backoff_iter
+
+    for func in (backoff, backoff_iter):
+        assert list(func(start, start, factor=factor)) == [float(start)]
+
+
+@pytest.mark.parametrize('start', [0, 0.25, 1])
+def test_backoff_unit_factor_requires_count(start):
+    from boltons.iterutils import backoff, backoff_iter
+
+    for func in (backoff, backoff_iter):
+        with pytest.raises(ValueError, match='count.*factor'):
+            list(func(start, 5, factor=1.0))
+
+
+@pytest.mark.parametrize('start, stop, expected', [
+    (5, 5, [5.0, 5.0, 5.0, 5.0]),
+    (1, 5, [1.0, 1.0, 1.0, 1.0]),
+    (0, 5, [0.0, 1.0, 1.0, 1.0]),
+    (0, 0.5, [0.0, 0.5, 0.5, 0.5]),
+])
+@pytest.mark.parametrize('count', [0, 1, 4])
+def test_backoff_unit_factor_explicit_count(start, stop, expected, count):
+    from boltons.iterutils import backoff, backoff_iter
+
+    for func in (backoff, backoff_iter):
+        assert list(func(start, stop, count=count, factor=1.0)) == expected[:count]
+
+
+@pytest.mark.parametrize('start, stop, expected', [
+    (5, 5, [5.0, 5.0, 5.0, 5.0]),
+    (1, 5, [1.0, 1.0, 1.0, 1.0]),
+    (0, 5, [0.0, 1.0, 1.0, 1.0]),
+    (0, 0.5, [0.0, 0.5, 0.5, 0.5]),
+])
+def test_backoff_unit_factor_repeat(start, stop, expected):
+    from itertools import islice
+    from boltons.iterutils import backoff_iter
+
+    values = backoff_iter(start, stop, count='repeat', factor=1.0)
+    assert list(islice(values, len(expected))) == expected
+    assert next(values) == expected[-1]
+
+
+def test_backoff_repeat_requires_iterator():
+    from boltons.iterutils import backoff
+
+    with pytest.raises(ValueError, match="'repeat' supported in backoff_iter"):
+        backoff(1, 5, count='repeat', factor=1.0)
+
