diff --git a/tests/test_defaults.py b/tests/test_defaults.py
index 5ab05ed..fe52f19 100644
--- a/tests/test_defaults.py
+++ b/tests/test_defaults.py
@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -13,6 +15,26 @@ def test_basic_defaults(runner):
     assert "FOO:[42.0]" in result.output
 
 
+@pytest.mark.parametrize("default", [False, True])
+@pytest.mark.parametrize(
+    ("mapped_default", "expect"), [(False, "no-cache"), (True, "cache")]
+)
+def test_boolean_flag_default_map_help(runner, default, mapped_default, expect):
+    @click.command()
+    @click.option("--cache/--no-cache", default=default, show_default=True)
+    def cli(cache):
+        click.echo(cache)
+
+    default_map = {"cache": mapped_default}
+    result = runner.invoke(cli, [], default_map=default_map)
+    assert result.exit_code == 0
+    assert result.output == f"{mapped_default}\n"
+
+    result = runner.invoke(cli, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    assert f"[default: {expect}]" in result.output
+
+
 def test_multiple_defaults(runner):
     @click.command()
     @click.option("--foo", default=[23, 42], type=click.FLOAT, multiple=True)
