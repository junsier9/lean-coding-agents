+def test_progressbar_hidden_manual_update(tmp_path):
+    path = tmp_path / "progress.txt"
+    label = "    padded label  "
+
+    with path.open("w", encoding="utf-8") as file:
+        with click.progressbar(length=3, label=label, file=file, width=0) as progress:
+            for _ in range(3):
+                progress.update(1)
+
+    assert path.read_text(encoding="utf-8") == f"{label}\n"
+
+
+def test_progressbar_hidden_label_change(runner):
+    @click.command()
+    def cli():
+        with click.progressbar(length=4, label="Starting") as progress:
+            progress.update(1)
+            progress.label = "Working"
+            progress.update(1)
+            progress.update(1)
+            progress.label = "Starting"
+            progress.update(1)
+
+    result = runner.invoke(cli, [])
+    assert result.exception is None
+    assert result.output == "Starting\nWorking\nStarting\n"
 
 
