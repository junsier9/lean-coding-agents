@@ -2,9 +2,51 @@ import re
 import uuid
 from unittest import TestCase
 
+import pytest
+
 from boltons import strutils
 
 
+@pytest.mark.parametrize('word', [
+    'glass', 'boss', 'address', 'class', 'grass', 'mass', 'business',
+    'success', 'loss', 'ss', 'Glass', 'BOSS', 'Address', 'gLaSs',
+    ' glass ', '\tBOSS\n',
+])
+def test_singularize_preserves_double_s_singulars(word):
+    assert strutils.singularize(word) == word
+    assert strutils.singularize(strutils.singularize(word)) == word
+
+
+@pytest.mark.parametrize(('word', 'expected'), [
+    ('glasses', 'glass'),
+    ('bosses', 'boss'),
+    ('addresses', 'address'),
+    ('classes', 'class'),
+    ('grasses', 'grass'),
+    ('masses', 'mass'),
+    ('businesses', 'business'),
+    ('successes', 'success'),
+    ('losses', 'loss'),
+    ('Glasses', 'Glass'),
+    ('BOSSES', 'BOSS'),
+    ('Addresses', 'Address'),
+    ('cats', 'cat'),
+    ('chances', 'chance'),
+    ('Activities', 'Activity'),
+    ('boys', 'boy'),
+    ('FEET', 'FOOT'),
+    ('children', 'child'),
+    ('axes', 'axis'),
+    ('species', 'species'),
+    ('friend', 'friend'),
+    ('', ''),
+    ('   ', '   '),
+])
+def test_singularize(word, expected):
+    assert strutils.singularize(word) == expected
+    assert strutils.singularize(strutils.singularize(word)) == expected
+
+
 def test_strip_ansi():
