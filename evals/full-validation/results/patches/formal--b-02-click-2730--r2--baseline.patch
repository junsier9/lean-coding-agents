+@pytest.mark.parametrize("default", [True, False])
+@pytest.mark.parametrize("override", [None, True, False])
+def test_boolean_flag_default_map_help(runner, default, override):
+    @click.command()
+    @click.option("--cache/--no-cache", default=default, show_default=True)
+    def cli(cache):
+        return cache
+
+    default_map = {} if override is None else {"cache": override}
+    expected = default if override is None else override
+
+    result = runner.invoke(cli, [], default_map=default_map, standalone_mode=False)
+    assert not result.exception
+    assert result.return_value is expected
+
+    result = runner.invoke(cli, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    expected_option = "cache" if expected else "no-cache"
+    assert f"[default: {expected_option}]" in result.output
+
+
 def test_multiple_defaults(runner):
