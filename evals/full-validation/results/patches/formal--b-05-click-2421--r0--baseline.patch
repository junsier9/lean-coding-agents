+@pytest.mark.parametrize("name", [None, "custom-alias", ""])
+def test_add_completion_class(monkeypatch, runner, name):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    class CustomComplete(ShellComplete):
+        name = "custom"
+        source_template = "custom source for %(prog_name)s"
+
+    if name is None:
+        registered = add_completion_class(CustomComplete)
+        shell = CustomComplete.name
+    else:
+        registered = add_completion_class(CustomComplete, name=name)
+        shell = name
+
+    assert registered is CustomComplete
+    assert get_completion_class(shell) is CustomComplete
+    assert CustomComplete.name == "custom"
+
+    if name is not None:
+        assert get_completion_class(CustomComplete.name) is None
+
+    result = runner.invoke(Command("cli"), env={"_CLI_COMPLETE": f"{shell}_source"})
+    assert result.exit_code == 0
+    assert result.output == "custom source for cli\n"
+
+
+@pytest.mark.parametrize(
+    ("instruction", "expect"),
+    [("source", "custom source for cli\n"), ("complete", "a\n")],
+)
+def test_add_completion_class_decorator(monkeypatch, runner, instruction, expect):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    @add_completion_class
+    class CustomComplete(ShellComplete):
+        name = "custom"
+        source_template = "custom source for %(prog_name)s"
+
+        def get_completion_args(self):
+            return [], "a"
+
+        def format_completion(self, item):
+            return item.value
+
+    assert get_completion_class("custom") is CustomComplete
+    cli = Group("cli", commands=[Command("a"), Command("b")])
+    assert CustomComplete(cli, {}, "cli", "_CLI_COMPLETE").source() == (
+        "custom source for cli"
+    )
+    result = runner.invoke(cli, env={"_CLI_COMPLETE": f"custom_{instruction}"})
+    assert result.exit_code == 0
+    assert result.output == expect
+
+
 def test_command():
     cli = Command("cli", params=[Option(["-t", "--test"])])
     assert _get_words(cli, [], "") == []
