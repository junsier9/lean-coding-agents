+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+def test_iter_find_files_pathlike(tmp_path, path_type):
+    top = tmp_path / 'top.txt'
+    top.write_text('top')
+    (tmp_path / 'skip.txt').write_text('ignored')
+    (tmp_path / 'other.py').write_text('other')
+    subdir = tmp_path / 'nested.txt'
+    subdir.mkdir()
+    nested = subdir / 'child.txt'
+    nested.write_text('nested')
+    directory = path_type(tmp_path)
+
+    assert set(iter_find_files(directory, '*.txt', ignored='skip*')) == {str(top), str(nested)}
+    assert list(iter_find_files(directory, '*.txt', ignored='skip*', max_depth=0)) == [str(top)]
+    assert set(iter_find_files(directory, ['*.txt'], ignored=['skip*'], include_dirs=True)) == {
+        str(top), str(subdir), str(nested)}
+
+
