 import os.path
+from pathlib import Path
 
-
-
-
+import pytest
 
 from boltons import fileutils
 from boltons.fileutils import FilePerms, iter_find_files
@@ -12,6 +11,57 @@ from boltons.strutils import removeprefix
 BOLTONS_PATH = os.path.dirname(os.path.abspath(fileutils.__file__))
 
 
+class _PathLike(os.PathLike):
+    def __init__(self, path):
+        self.path = path
+
+    def __fspath__(self):
+        return str(self.path)
+
+
+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+@pytest.mark.parametrize('save', [fileutils.AtomicSaver, fileutils.atomic_save])
+@pytest.mark.parametrize('text_mode', [False, True])
+def test_atomic_save_pathlike(tmp_path, path_type, save, text_mode):
+    dest = tmp_path / 'saved.txt'
+    part = tmp_path / 'saved.txt.part'
+    previous = None
+    for content in ('first save', 'replacement'):
+        with save(path_type(dest), text_mode=text_mode) as output:
+            output.write(content if text_mode else content.encode('ascii'))
+            assert part.exists()
+            if previous is None:
+                assert not dest.exists()
+            else:
+                assert dest.read_text() == previous
+        assert dest.read_text() == content
+        assert not part.exists()
+        previous = content
+
+
+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+def test_atomic_save_pathlike_exception(tmp_path, path_type):
+    dest = tmp_path / 'saved.txt'
+    dest.write_bytes(b'original')
+    with pytest.raises(RuntimeError, match='abort save'):
+        with fileutils.atomic_save(path_type(dest)) as output:
+            output.write(b'incomplete')
+            raise RuntimeError('abort save')
+    assert dest.read_bytes() == b'original'
+    assert not (tmp_path / 'saved.txt.part').exists()
+
+
+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+def test_atomic_save_pathlike_no_overwrite(tmp_path, path_type):
+    dest = tmp_path / 'saved.txt'
+    dest.write_bytes(b'original')
+    with pytest.raises(OSError):
+        with fileutils.atomic_save(path_type(dest), overwrite=False):
+            pytest.fail('existing destination must not be overwritten')
+    assert dest.read_bytes() == b'original'
+    assert not (tmp_path / 'saved.txt.part').exists()
+
+
 def test_fileperms():
