diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index d4f6a67..5397f70 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -1,4 +1,6 @@
 import sys
+from collections import UserDict
+
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
@@ -61,6 +63,48 @@ def test_eq():
     assert omd != omd3
 
 
+@pytest.mark.parametrize('mapping_type', [dict, UserDict])
+@pytest.mark.parametrize('items, other, expected', [
+    ([], {}, True),
+    ([('a', 1)], {'a': 1}, True),
+    ([('a', 1)], {'a': 2}, False),
+    ([('a', 1), ('b', 2)], {'b': 2, 'a': 1}, True),
+    ([('a', 1), ('b', 2)], {'a': 1, 'b': 3}, False),
+    ([('a', 1)], {'b': 1}, False),
+    ([('a', 1)], {}, False),
+    ([], {'a': 1}, False),
+    ([('a', 1), ('a', 2)], {'a': 2}, True),
+    ([('a', 1), ('a', 2)], {'a': 1}, False),
+    ([('a', [1, 2])], {'a': [1, 2]}, True),
+    ([('a', [1, 2])], {'a': [2, 1]}, False),
+])
+def test_eq_mapping(mapping_type, items, other, expected):
+    omd = OMD(items)
+    other = mapping_type(other)
+
+    assert (omd == other) is expected
+    assert (omd != other) is not expected
+    assert (other == omd) is expected
+    assert (other != omd) is not expected
+
+
+@pytest.mark.parametrize('other_items, expected', [
+    ([('a', 1), ('b', 2), ('a', 3)], True),
+    ([('b', 2), ('a', 1), ('a', 3)], False),
+    ([('a', 0), ('b', 2), ('a', 3)], False),
+    ([('a', 3), ('b', 2)], False),
+    ([('a', 1), ('b', 2), ('a', 3), ('a', 3)], False),
+])
+def test_eq_multivalue(other_items, expected):
+    omd = OMD([('a', 1), ('b', 2), ('a', 3)])
+    other = OMD(other_items)
+
+    assert (omd == other) is expected
+    assert (omd != other) is not expected
+    assert (other == omd) is expected
+    assert (other != omd) is not expected
+
+
 def test_copy():
     for itemset in _ITEMSETS:
         omd = OMD(itemset)
diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index d25701e..c372f62 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -1,3 +1,5 @@
+import runpy
+
 import pytest
 
 from boltons import urlutils
@@ -95,6 +97,53 @@ def test_query_params(test_url):
     assert test_url.endswith(qp_text)
 
 
+@pytest.fixture(scope='module', params=['package', 'standalone'])
+def query_param_dict_type(request):
+    if request.param == 'standalone':
+        return runpy.run_path(urlutils.__file__)['QueryParamDict']
+    return urlutils.QueryParamDict
+
+
+@pytest.mark.parametrize('query, other, expected', [
+    ('', {}, True),
+    ('a=1', {'a': '1'}, True),
+    ('a=1', {'a': '2'}, False),
+    ('a=1&b=2', {'b': '2', 'a': '1'}, True),
+    ('a=1&b=2', {'a': '1', 'b': '3'}, False),
+    ('a=1', {'b': '1'}, False),
+    ('a=1', {}, False),
+    ('', {'a': '1'}, False),
+    ('a=1&a=2', {'a': '2'}, True),
+    ('a=1&a=2', {'a': '1'}, False),
+    ('a=', {'a': None}, True),
+    ('a=', {'a': ''}, False),
+])
+def test_query_param_eq_mapping(query_param_dict_type, query, other, expected):
+    params = query_param_dict_type.from_text(query)
+
+    assert (params == other) is expected
+    assert (params != other) is not expected
+    assert (other == params) is expected
+    assert (other != params) is not expected
+
+
+@pytest.mark.parametrize('other_query, expected', [
+    ('a=1&b=2&a=3', True),
+    ('b=2&a=1&a=3', False),
+    ('a=0&b=2&a=3', False),
+    ('a=3&b=2', False),
+    ('a=1&b=2&a=3&a=3', False),
+])
+def test_query_param_eq_multivalue(query_param_dict_type, other_query, expected):
+    params = query_param_dict_type.from_text('a=1&b=2&a=3')
+    other = query_param_dict_type.from_text(other_query)
+
+    assert (params == other) is expected
+    assert (params != other) is not expected
+    assert (other == params) is expected
+    assert (other != params) is not expected
+
+
 def test_iri_query():
     url = URL('http://minerals.mountain.ore/?rock=\N{SHAMROCK}')
     assert url.query_params['rock'] == '\N{SHAMROCK}'
