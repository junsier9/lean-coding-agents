     assert x[2:4:-1] == IndexedSet([8, 7])
 
 
+@mark.parametrize('iterable_type', [list, tuple, iter])
+def test_indexed_set_update_multiple_iterables(iterable_type):
+    thing = IndexedSet([3, 1])
+    first = iterable_type([1, 2, 3, 2])
+    second = iterable_type([4, 2, 1, 5])
+
+    assert thing.update(first, second) is None
+    assert list(thing) == [3, 1, 2, 4, 5]
+
+    assert thing.update(iterable_type([5, 6, 5])) is None
+    assert list(thing) == [3, 1, 2, 4, 5, 6]
+
+
+def test_indexed_set_update_empty():
+    thing = IndexedSet([2, 1])
+
+    assert thing.update() is None
+    assert list(thing) == [2, 1]
+    assert thing.update([]) is None
+    assert list(thing) == [2, 1]
+    assert thing.update([], (), iter(())) is None
+    assert list(thing) == [2, 1]
+
+    assert thing.update([], (1, 3), iter(()), [4, 3], ()) is None
+    assert list(thing) == [2, 1, 3, 4]
+
+
+def test_indexed_set_update_tuple_elements():
+    thing = IndexedSet([(1, 2)])
+
+    assert thing.update([(1, 2), (3, 4)],
+                        iter([(3, 4), (), (1, 2)]),
+                        [((5, 6),)]) is None
+    assert list(thing) == [(1, 2), (3, 4), (), ((5, 6),)]
+
+
