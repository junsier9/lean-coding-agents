+import importlib.util
+from collections import UserDict
+
 import pytest
 
 from boltons import urlutils
@@ -95,6 +98,34 @@ def test_query_params(test_url):
     assert test_url.endswith(qp_text)
 
 
+@pytest.mark.parametrize('standalone', [False, True], ids=['package', 'standalone'])
+def test_query_params_equality(standalone):
+    module = urlutils
+    if standalone:
+        spec = importlib.util.spec_from_file_location('standalone_urlutils', urlutils.__file__)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+    qp_type = module.QueryParamDict
+    qp = qp_type.from_text('a=first&b=other&a=last')
+
+    for other in ({'b': 'other', 'a': 'last'},
+                  UserDict({'a': 'last', 'b': 'other'}),
+                  qp_type.from_text('a=first&b=other&a=last')):
+        assert qp == other
+        assert not (qp != other)
+
+    for other in ({'a': 'first', 'b': 'other'},
+                  {'a': 'last', 'b': 'changed'},
+                  UserDict({'a': 'last', 'b': 'changed'}),
+                  {'a': 'last', 'c': 'other'},
+                  {'a': 'last'},
+                  qp_type.from_text('a=changed&b=other&a=last'),
+                  qp_type.from_text('a=first&a=last&b=other'),
+                  qp_type.from_text('b=other&a=last')):
+        assert not (qp == other)
+        assert qp != other
+
+
 def test_iri_query():
     url = URL('http://minerals.mountain.ore/?rock=\N{SHAMROCK}')
     assert url.query_params['rock'] == '\N{SHAMROCK}'
