 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
@@ -61,6 +63,37 @@ def test_eq():
     assert omd != omd3
 
 
+@pytest.mark.parametrize('mapping_type', [dict, UserDict])
+@pytest.mark.parametrize('other, expected', [
+    ({'b': 3, 'a': 2}, True),
+    ({'a': 1, 'b': 3}, False),
+    ({'a': 2, 'b': 4}, False),
+    ({'a': 2, 'c': 3}, False),
+    ({'a': 2}, False),
+    ({'a': 2, 'b': 3, 'c': 4}, False),
+])
+def test_eq_mapping(mapping_type, other, expected):
+    omd = OMD([('a', 1), ('b', 3), ('a', 2)])
+    other = mapping_type(other)
+
+    assert (omd == other) is expected
+    assert (omd != other) is (not expected)
+
+
+@pytest.mark.parametrize('items, expected', [
+    ([('a', 1), ('b', 3), ('a', 2)], True),
+    ([('a', 0), ('b', 3), ('a', 2)], False),
+    ([('a', 1), ('a', 2), ('b', 3)], False),
+    ([('b', 3), ('a', 2)], False),
+])
+def test_eq_multivalue(items, expected):
+    omd = OMD([('a', 1), ('b', 3), ('a', 2)])
+    other = OMD(items)
+
+    assert (omd == other) is expected
+    assert (omd != other) is (not expected)
+
+
