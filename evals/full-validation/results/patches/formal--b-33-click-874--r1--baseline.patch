+@pytest.mark.parametrize('auto_envvar_prefix', [None, 'TEST'])
+@pytest.mark.parametrize('args, env_value, mapped_value, expected', [
+    (['--count', '4'], '3', '2', '4'),
+    ([], '3', '2', '3'),
+    ([], None, '2', '2'),
+    ([], None, None, '1'),
+    (['--count', '0'], '3', '2', '0'),
+    ([], '0', '2', '0'),
+    ([], None, 0, '0'),
+])
+def test_default_map_precedence(runner, auto_envvar_prefix, args, env_value,
+                               mapped_value, expected):
+    envvar = 'TEST_FOO_COUNT' if auto_envvar_prefix else 'TEST_COUNT'
+
+    @click.group()
+    def cli():
+        pass
+
+    @cli.command()
+    @click.option('--count', type=int, default=1,
+                  envvar=None if auto_envvar_prefix else envvar)
+    def foo(count):
+        click.echo(count)
+
+    result = runner.invoke(
+        cli, ['foo'] + args, env={envvar: env_value},
+        auto_envvar_prefix=auto_envvar_prefix,
+        default_map={'foo': {'count': mapped_value}})
+
+    assert not result.exception
+    assert result.output == expected + '\n'
+
+
+@pytest.mark.parametrize('args, env_value, expected, default_calls', [
+    (['--count', '4'], '3', '4', 0),
+    ([], '3', '3', 0),
+    ([], None, '2', 1),
+])
+def test_default_map_callable_precedence(runner, args, env_value, expected,
+                                        default_calls):
+    calls = []
+
+    def mapped_default():
+        calls.append(True)
+        return '2'
+
+    @click.command(context_settings={
+        'default_map': {'count': mapped_default}
+    })
+    @click.option('--count', type=int, default=1, envvar='TEST_COUNT')
+    def cli(count):
+        click.echo(count)
+
+    result = runner.invoke(cli, args, env={'TEST_COUNT': env_value})
+
+    assert not result.exception
+    assert result.output == expected + '\n'
+    assert len(calls) == default_calls
+
+
