@@ -2,9 +2,50 @@ import re
 import uuid
 from unittest import TestCase
 
+import pytest
+
 from boltons import strutils
 
 
+@pytest.mark.parametrize(('plural', 'singular'), [
+    ('glasses', 'glass'),
+    ('bosses', 'boss'),
+    ('addresses', 'address'),
+    ('classes', 'class'),
+    ('businesses', 'business'),
+    ('successes', 'success'),
+])
+@pytest.mark.parametrize('case', [str.lower, str.title, str.upper])
+def test_singularize_double_s(plural, singular, case):
+    singular = case(singular)
+    result = strutils.singularize(case(plural))
+    assert result == singular
+    assert strutils.singularize(result) == singular
+
+
+@pytest.mark.parametrize('word', ['gLaSs', 'BoSs', 'AddreSS', ' glass ', '\tBOSS\n', 'ss'])
+def test_singularize_preserves_double_s_input(word):
+    assert strutils.singularize(word) == word
+
+
+@pytest.mark.parametrize(('word', 'singular'), [
+    ('', ''),
+    ('cat', 'cat'),
+    ('cats', 'cat'),
+    ('chances', 'chance'),
+    ('Activities', 'Activity'),
+    ('toys', 'toy'),
+    ('FEET', 'FOOT'),
+    ('children', 'child'),
+    ('sheep', 'sheep'),
+    ('analysis', 'analysis'),
+    ('analyses', 'analysis'),
+    ('series', 'series'),
+])
+def test_singularize_existing_forms(word, singular):
+    assert strutils.singularize(word) == singular
+
+
