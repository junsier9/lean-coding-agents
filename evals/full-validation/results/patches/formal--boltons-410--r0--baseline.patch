+def test_omd_deepcopy_values():
+    shared = {'nested': [1]}
+    last = {'nested': [3]}
+    omd = OMD([('a', shared), ('b', shared), ('a', last)])
+
+    omd_c = copy.deepcopy(omd)
+    assert omd_c.items(multi=True) == omd.items(multi=True)
+    first_c, last_c = omd_c.getlist('a')
+    assert first_c is omd_c['b']
+    assert first_c is not shared
+    assert last_c is not last
+
+    first_c['nested'].append(4)
+    last_c['nested'].append(5)
+    assert shared == {'nested': [1]}
+    assert last == {'nested': [3]}
+
 
