+def test_omd_shallow_copy_values():
+    first = {'nested': [1]}
+    last = {'nested': [3]}
+    omd = OMD([('a', first), ('b', [2]), ('a', last)])
+
+    omd_c = copy.copy(omd)
+    assert omd_c.getlist('a')[0] is first
+    assert omd_c['a'] is last
+    assert omd_c['b'] is omd['b']
+
+    omd_c.getlist('a')[0]['nested'].append(4)
+    assert first['nested'] == [1, 4]
+    assert omd_c.poplast('a') is last
+    omd_c.add('a', [])
+    assert omd.items(multi=True) == [('a', first), ('b', [2]), ('a', last)]
