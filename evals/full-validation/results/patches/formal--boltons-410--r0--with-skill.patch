+@pytest.mark.parametrize('dict_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('copier', [copy.copy, copy.deepcopy])
+@pytest.mark.parametrize('itemset', _ITEMSETS)
+def test_omd_copy_protocol(dict_type, copier, itemset):
+    omd = dict_type(itemset)
+    cloned = copier(omd)
+
+    assert type(cloned) is dict_type
+    assert cloned is not omd
+    assert cloned.items(multi=True) == itemset
+    for key in omd:
+        assert cloned.getlist(key) == omd.getlist(key)
+
+    if cloned:
+        cloned.poplast()
+    cloned.add('new', None)
+    cloned.clear()
+    assert omd.items(multi=True) == itemset
+
+
+def test_omd_shallow_copy_values():
+    first = {'nested': [1]}
+    last = {'nested': [2]}
+    omd = OMD([('a', first), ('b', None), ('a', last)])
+
+    cloned = copy.copy(omd)
+
+    assert cloned.getlist('a')[0] is first
+    assert cloned['a'] is last
+    cloned.getlist('a')[0]['nested'].append(3)
+    assert first['nested'] == [1, 3]
+
+
+def test_omd_deepcopy_values():
+    shared = {'nested': [1]}
+    last = {'nested': [2]}
+    omd = OMD([('a', shared), ('b', shared), ('a', last)])
+
+    cloned = copy.deepcopy(omd)
+
+    assert cloned.items(multi=True) == omd.items(multi=True)
+    assert cloned.getlist('a')[0] is cloned['b']
+    for original, copied in zip(omd.values(multi=True), cloned.values(multi=True)):
+        assert copied is not original
+        assert copied['nested'] is not original['nested']
+
+    cloned['b']['nested'].append(3)
+    cloned['a']['nested'].append(4)
+    assert shared == {'nested': [1]}
+    assert last == {'nested': [2]}
+
+
+def test_omd_deepcopy_recursive():
+    omd = OMD([('a', [])])
+    omd.add('a', omd)
+
+    cloned = copy.deepcopy(omd)
+
+    assert cloned is not omd
+    assert cloned.getlist('a')[0] == []
+    assert cloned.getlist('a')[0] is not omd.getlist('a')[0]
+    assert cloned['a'] is cloned
+
+
