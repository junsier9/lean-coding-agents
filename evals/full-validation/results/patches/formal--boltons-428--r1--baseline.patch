+@pytest.mark.parametrize('name', ['backoff', 'backoff_iter'])
+@pytest.mark.parametrize('endpoint', [0, 0.5, 1, 5])
+@pytest.mark.parametrize('factor', [1.0, 2.0])
+def test_backoff_same_endpoints(name, endpoint, factor):
+    from boltons import iterutils
+
+    func = getattr(iterutils, name)
+    assert list(func(endpoint, endpoint, factor=factor)) == [float(endpoint)]
+
+
+@pytest.mark.parametrize('name', ['backoff', 'backoff_iter'])
+@pytest.mark.parametrize('start, stop', [(0, 16), (0.5, 1), (1, 16)])
+def test_backoff_unit_factor_requires_count(name, start, stop):
+    from boltons import iterutils
+
+    func = getattr(iterutils, name)
+    with pytest.raises(ValueError, match='count'):
+        list(func(start, stop, factor=1.0))
+
+
+@pytest.mark.parametrize('name', ['backoff', 'backoff_iter'])
+@pytest.mark.parametrize('start, stop, expected', [
+    (0, 16, [0.0, 1.0, 1.0, 1.0]),
+    (1, 16, [1.0, 1.0, 1.0, 1.0]),
+    (5, 5, [5.0, 5.0, 5.0, 5.0]),
+])
+@pytest.mark.parametrize('count', [0, 1, 4])
+def test_backoff_unit_factor_explicit_count(name, start, stop, expected, count):
+    from boltons import iterutils
+
+    func = getattr(iterutils, name)
+    assert list(func(start, stop, count=count, factor=1.0)) == expected[:count]
+
+
+@pytest.mark.parametrize('start, stop, expected', [
+    (0, 16, [0.0, 1.0, 1.0, 1.0]),
+    (1, 16, [1.0, 1.0, 1.0, 1.0]),
+    (5, 5, [5.0, 5.0, 5.0, 5.0]),
+])
+def test_backoff_unit_factor_repeat(start, stop, expected):
+    from itertools import islice
+    from boltons.iterutils import backoff_iter
+
+    values = backoff_iter(start, stop, count='repeat', factor=1.0)
+    assert list(islice(values, len(expected))) == expected
+    assert next(values) == expected[-1]
+
+
