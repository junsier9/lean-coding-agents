+@pytest.mark.parametrize('skewness, kurtosis, precision, expected', [
+    (1.0, 6.0, 12, 4),
+    (1.5, 54 / 7, 12, 5),
+    (1.0, 4.75, 12, 6),
+    (2.0, 3.0, 12, 6),  # c0 = 0: infinite Pearson criterion
+    (-2.0, 3.0, 12, 6),
+    (2.0, 3.01, 12, 1),  # A small nonzero denominator still gives Type I.
+    (0.0, 0.0, 12, 2),  # Symmetric classification precedes c0 = 0.
+    (0.0, 3.0, 12, 0),  # Normal classification precedes c2 = 0.
+    (0.0, 4.0, 12, 7),
+    (2.0, 9.0, 12, 3),  # Gamma classification precedes c2 = 0.
+    (0.01, 3.01, 0, 0),  # Preserve rounded Normal and Gamma boundaries.
+    (2.0, 9.1, 0, 3),
+])
+def test_pearson_type_moment_boundaries(skewness, kurtosis, precision, expected):
+    stats = Stats([0])
+    # Supply exact moments directly to avoid sample-estimation noise.
+    stats._skewness = skewness
+    stats._kurtosis = kurtosis
+    stats._pearson_precision = precision
+    assert stats.pearson_type == expected
+
+
 def test_mode():
     assert Stats([2, 1, 3, 1]).mode == 1
