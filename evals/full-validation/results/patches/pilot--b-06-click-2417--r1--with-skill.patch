+def test_group_command_no_parens_custom_class(runner):
+    class CustomCommand(click.Command):
+        def invoke(self, ctx):
+            click.echo("custom command")
+            return super().invoke(ctx)
+
+    class CustomGroup(click.Group):
+        command_class = CustomCommand
+
+    @click.group(cls=CustomGroup)
+    def grp():
+        pass
+
+    @grp.command
+    @click.option("--name", default="world")
+    def cmd(name):
+        click.echo(f"hello {name}")
+
+    assert type(cmd) is CustomCommand
+    assert grp.commands["cmd"] is cmd
+    result = runner.invoke(grp, ["cmd", "--name", "test"])
+    assert result.exception is None
+    assert result.output == "custom command\nhello test\n"
+
+
+@pytest.mark.parametrize(
+    ("args", "kwargs"),
+    [((), {"cls": click.Command}), ((), {"help": "help"}), (("name",), {})],
+)
+def test_group_command_no_parens_rejects_arguments(args, kwargs):
+    grp = click.Group()
+    grp.command_class = click.Command
+
+    with pytest.raises(
+        AssertionError,
+        match=r"Use 'command\(\*\*kwargs\)\(callable\)' to provide arguments\.",
+    ):
+        grp.command(lambda: None, *args, **kwargs)
+
+    assert not grp.commands
+
+
