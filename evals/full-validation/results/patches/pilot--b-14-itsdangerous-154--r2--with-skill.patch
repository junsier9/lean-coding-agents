+@pytest.mark.parametrize("serializer_cls", (TimedSerializer, URLSafeTimedSerializer))
+def test_timed_serializer_bad_signature_date(serializer_cls):
+    serializer = serializer_cls("secret-key")
+    value = {"id": 42}
+    ts = datetime(2011, 6, 24, 0, 9, 5, tzinfo=timezone.utc)
+
+    with freeze_time(ts):
+        signed = serializer.dumps(value)[:-1]
+
+    with pytest.raises(BadTimeSignature) as exc_info:
+        serializer.loads(signed)
+
+    assert exc_info.value.date_signed == ts
+    assert exc_info.value.date_signed.tzinfo is timezone.utc
+    assert serializer.load_payload(exc_info.value.payload) == value
