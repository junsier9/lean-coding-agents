diff --git a/tests/test_context.py b/tests/test_context.py
index c1be8f3..1de3458 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -6,6 +6,39 @@ import click
 from click.core import ParameterSource
 
 
+@pytest.mark.parametrize(
+    "parent_show_default, child_show_default, expected",
+    [
+        (None, None, False),
+        (False, None, False),
+        (True, None, True),
+        (True, False, False),
+        (False, True, True),
+    ],
+)
+@pytest.mark.parametrize("args", [["sub", "--help"], ["sub", "cmd", "--help"]])
+def test_show_default_inheritance(
+    runner, parent_show_default, child_show_default, expected, args
+):
+    @click.group(context_settings={"show_default": parent_show_default})
+    def cli():
+        pass
+
+    @cli.group(context_settings={"show_default": child_show_default})
+    @click.option("--value", default="example")
+    def sub(value):
+        pass
+
+    @sub.command()
+    @click.option("--value", default="example")
+    def cmd(value):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0
+    assert ("[default: example]" in result.output) is expected
+
+
