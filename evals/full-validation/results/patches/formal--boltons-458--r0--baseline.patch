+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [list, tuple, iter, lambda v: (x for x in v)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+def test_addlist_iterables(omd_type, make_values):
+    omd = omd_type([('a', 0), ('b', 4)])
+    assert omd.addlist('a', make_values([1, 2, 1])) is None
+    omd.addlist('c', make_values([5, 6]))
+
+    assert omd.getlist('a') == [0, 1, 2, 1]
+    assert omd['a'] == omd.get('a') == 1
+    assert omd.getlist('c') == [5, 6]
+    assert omd['c'] == omd.get('c') == 6
+    assert omd.keys() == ['a', 'b', 'c']
+    assert len(omd) == len(omd.viewkeys()) == 3
+    assert omd.items(multi=True) == [
+        ('a', 0), ('b', 4), ('a', 1), ('a', 2), ('a', 1), ('c', 5), ('c', 6)]
+    assert omd.todict(multi=True) == {'a': [0, 1, 2, 1], 'b': [4], 'c': [5, 6]}
+
+    assert omd.poplast('a') == 1
+    assert omd.popall('a') == [0, 1, 2]
+    assert omd.pop('c') == 6
+    assert omd.items(multi=True) == [('b', 4)]
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [list, tuple, iter, lambda v: (x for x in v)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+@pytest.mark.parametrize('initial', [[], [('a', 0), ('b', 4)]])
+def test_addlist_empty_iterables(omd_type, make_values, initial):
+    omd = omd_type(initial)
+    before = repr(omd)
+    assert omd.addlist('a', make_values([])) is None
+    omd.addlist('missing', make_values([]))
+
+    assert repr(omd) == before
+    assert len(omd) == len(omd.keys()) == len(omd.viewkeys()) == len(initial)
+    assert bool(omd) == bool(initial)
+    assert omd.items(multi=True) == initial
+    assert omd.getlist('a') == ([0] if initial else [])
+    assert ('a' in omd) == bool(initial)
+    assert 'missing' not in omd
+    assert omd.get('missing', 'default') == 'default'
+    assert omd.getlist('missing', 'default') == 'default'
+    with pytest.raises(KeyError):
+        omd['missing']
+
+
