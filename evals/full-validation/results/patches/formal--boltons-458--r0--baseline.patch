+import runpy
+
 import pytest
 
 from boltons import urlutils
@@ -95,6 +97,61 @@ def test_query_params(test_url):
     assert test_url.endswith(qp_text)
 
 
+@pytest.fixture(scope='module', params=['package', 'standalone'])
+def addlist_url_type(request):
+    if request.param == 'package':
+        return URL
+    # Running outside the package exercises urlutils' embedded OMD fallback.
+    return runpy.run_path(urlutils.__file__)['URL']
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+def test_query_params_addlist_iterables(addlist_url_type, make_values):
+    url = addlist_url_type('https://example.com/?a=0&b=x')
+    qp = url.query_params
+    qp.addlist('a', make_values(['1', 'two words', '1']))
+    qp.addlist('c', make_values(['last']))
+
+    assert qp.getlist('a') == ['0', '1', 'two words', '1']
+    assert qp['a'] == qp.get('a') == '1'
+    assert qp.getlist('c') == ['last']
+    assert qp['c'] == qp.get('c') == 'last'
+    assert qp.keys() == ['a', 'b', 'c']
+    assert len(qp) == len(qp.viewkeys()) == 3
+    assert qp.items(multi=True) == [
+        ('a', '0'), ('b', 'x'), ('a', '1'), ('a', 'two words'),
+        ('a', '1'), ('c', 'last')]
+    expected = 'a=0&b=x&a=1&a=two%20words&a=1&c=last'
+    assert qp.to_text(full_quote=True) == expected
+    assert url.to_text(full_quote=True) == 'https://example.com/?' + expected
+    assert addlist_url_type(url.to_text(full_quote=True)).qp == qp
+
+    assert qp.poplast('a') == '1'
+    assert qp.popall('a') == ['0', '1', 'two words']
+    assert qp.to_text() == 'b=x&c=last'
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+@pytest.mark.parametrize('query', ['', 'a=0&b=x'])
+def test_query_params_addlist_empty_iterables(addlist_url_type, make_values, query):
+    url = addlist_url_type('https://example.com/?' + query)
+    qp = url.query_params
+    before = qp.items(multi=True)
+    qp.addlist('a', make_values([]))
+    qp.addlist('missing', make_values([]))
+
+    assert qp.items(multi=True) == before
+    assert len(qp) == len(qp.keys()) == len(qp.viewkeys()) == len(before)
+    assert bool(qp) == bool(before)
+    assert qp.getlist('a') == (['0'] if query else [])
+    assert ('a' in qp) == bool(query)
+    assert 'missing' not in qp
+    assert qp.get('missing', 'default') == 'default'
+    assert qp.to_text(full_quote=True) == query
+
+
