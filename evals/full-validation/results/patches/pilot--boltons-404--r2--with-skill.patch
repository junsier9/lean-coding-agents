diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index d4f6a67..80cce77 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -1,4 +1,6 @@
 import sys
+from collections import UserDict
+
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
@@ -61,6 +63,35 @@ def test_eq():
     assert omd != omd3
 
 
+@pytest.mark.parametrize('mapping_type', [dict, UserDict])
+@pytest.mark.parametrize('items, other, expected', [
+    ([], {}, True),
+    ([('a', 1)], {'a': 1}, True),
+    ([('a', 1)], {'a': 2}, False),
+    ([('a', 1), ('b', 2), ('a', 3)], {'b': 2, 'a': 3}, True),
+    ([('a', 1), ('b', 2), ('a', 3)], {'a': 1, 'b': 2}, False),
+    ([('a', 1), ('b', 2), ('a', 3)], {'a': 3, 'b': 4}, False),
+    ([('a', 1), ('b', 2), ('a', 3)], {'a': 3, 'c': 2}, False),
+    ([('a', 1), ('b', 2), ('a', 3)], {'a': 3}, False),
+])
+def test_eq_mapping(mapping_type, items, other, expected):
+    omd = OMD(items)
+    other = mapping_type(other)
+    assert (omd == other) is expected
+    assert (omd != other) is (not expected)
+
+
+@pytest.mark.parametrize('items', [
+    [('a', 0), ('b', 2), ('a', 3)],
+    [('b', 2), ('a', 1), ('a', 3)],
+])
+def test_eq_multidict_history_and_order(items):
+    omd = OMD([('a', 1), ('b', 2), ('a', 3)])
+    other = OMD(items)
+    assert not (omd == other)
+    assert omd != other
+
+
 def test_copy():
