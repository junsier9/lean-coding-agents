diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index d25701e..a070e3f 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -1,3 +1,5 @@
+import runpy
+
 import pytest
 
 from boltons import urlutils
@@ -95,6 +97,38 @@ def test_query_params(test_url):
     assert test_url.endswith(qp_text)
 
 
+@pytest.fixture(scope='module', params=['package', 'standalone'])
+def query_param_dict_type(request):
+    if request.param == 'package':
+        return urlutils.QueryParamDict
+    return runpy.run_path(urlutils.__file__)['QueryParamDict']
+
+
+@pytest.mark.parametrize('other, expected', [
+    ({'other': 'value', 'key': 'last'}, True),
+    ({'key': 'first', 'other': 'value'}, False),
+    ({'key': 'last', 'other': 'changed'}, False),
+    ({'key': 'last', 'missing': 'value'}, False),
+    ({'key': 'last'}, False),
+])
+def test_query_params_eq_mapping(query_param_dict_type, other, expected):
+    qp = query_param_dict_type.from_text('key=first&key=last&other=value')
+    assert (qp == other) is expected
+    assert (qp != other) is (not expected)
+
+
+def test_query_params_eq_multidict(query_param_dict_type):
+    qp = query_param_dict_type.from_text('key=first&key=last&other=value')
+    assert qp == qp.copy()
+    assert not (qp != qp.copy())
+    for text in ['key=changed&key=last&other=value',
+                 'other=value&key=first&key=last',
+                 'key=last&other=value']:
+        other = query_param_dict_type.from_text(text)
+        assert not (qp == other)
+        assert qp != other
+
+
 def test_iri_query():
     url = URL('http://minerals.mountain.ore/?rock=\N{SHAMROCK}')
     assert url.query_params['rock'] == '\N{SHAMROCK}'
