+    def test_reversed_matches_iteration_with_inexact_step(self):
+        for args in [
+            (0.0, 1.0, 0.1),
+            (0.0, 3.0, 0.7),
+            (1.0, 0.0, -0.1),
+            (3.0, 0.0, -0.7),
