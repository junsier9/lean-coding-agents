+            (4.51, 10.375, 0.255),
+            (-69.37276490678778, -29.8339073344664, 4.942357196540172),
+            (32.50227965239458, 9.003418351482358, -1.9582384417426848),
+        ]:
+            with self.subTest(args=args):
+                r = mi.numeric_range(*args)
+                self.assertEqual(list(r)[::-1], list(reversed(r)))
+
+    def test_reversed_at_datetime_boundaries(self):
+        hour = timedelta(hours=1)
+        for start, step in [(datetime.min, hour), (datetime.max, -hour)]:
+            for length in (0, 1, 3):
+                with self.subTest(start=start, step=step, length=length):
+                    r = mi.numeric_range(start, start + length * step, step)
+                    self.assertEqual(list(r)[::-1], list(reversed(r)))
+
+    def test_reversed_large_range(self):
+        stop = 10**30
+        r = mi.numeric_range(stop)
+        self.assertEqual([stop - 1, stop - 2], list(islice(reversed(r), 2)))
