@@ -2,9 +2,48 @@ import re
 import uuid
 from unittest import TestCase
 
+import pytest
+
 from boltons import strutils
 
 
+@pytest.mark.parametrize('exponent, symbol', enumerate('KMGTPEZY', 1))
+def test_bytes2human_exact_boundaries(exponent, symbol):
+    nbytes = 1024 ** exponent
+    assert strutils.bytes2human(nbytes) == '1' + symbol
+    assert strutils.bytes2human(-nbytes) == '-1' + symbol
+    assert strutils.bytes2human(nbytes, 2) == '1.00' + symbol
+    assert strutils.bytes2human(-nbytes, 2) == '-1.00' + symbol
+
+
+@pytest.mark.parametrize('exponent, symbol', enumerate('BKMGTPEZ', 1))
+def test_bytes2human_below_boundaries(exponent, symbol):
+    nbytes = 1024 ** exponent - 1
+    rounded = '1023' if exponent == 1 else '1024'
+    assert strutils.bytes2human(nbytes) == rounded + symbol
+    assert strutils.bytes2human(-nbytes) == '-' + rounded + symbol
+    assert strutils.bytes2human(nbytes, 2) == rounded + '.00' + symbol
+    assert strutils.bytes2human(-nbytes, 2) == '-' + rounded + '.00' + symbol
+
+
+@pytest.mark.parametrize('nbytes, ndigits, expected', [
+    (0, 0, '0B'),
+    (0, 2, '0.00B'),
+    (1, 0, '1B'),
+    (-1, 2, '-1.00B'),
+    (128991, 0, '126K'),
+    (100001221, 0, '95M'),
+    (1536, 0, '2K'),
+    (1536, 1, '1.5K'),
+    (1536, 3, '1.500K'),
+    (-1536, 2, '-1.50K'),
+    (1024 ** 8 + 1, 0, '1Y'),
+    (1024 ** 9, 0, '1024Y'),
+])
+def test_bytes2human_formatting(nbytes, ndigits, expected):
+    assert strutils.bytes2human(nbytes, ndigits) == expected
+
+
 def test_strip_ansi():
