+def test_group_command_class_no_parens(runner):
+    class CustomCommand(click.Command):
+        pass
+
+    class CustomGroup(click.Group):
+        command_class = CustomCommand
+
+    @click.group(cls=CustomGroup)
+    def grp():
+        click.echo("group")
+
+    @grp.command
+    @click.option("--name", default="world")
+    def cmd(name):
+        click.echo(f"hello {name}")
+
+    assert type(cmd) is CustomCommand
+    assert grp.commands["cmd"] is cmd
+
+    result = runner.invoke(grp, ["cmd", "--name", "Click"])
+    assert result.exception is None
+    assert result.output == "group\nhello Click\n"
+
+
