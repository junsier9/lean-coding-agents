+@pytest.mark.parametrize(
+    ("underline", "underline_code"),
+    [(None, ""), (False, "\x1b[24m"), (True, "\x1b[4m")],
+)
+@pytest.mark.parametrize(
+    ("overline", "overline_code"), [(False, "\x1b[55m"), (True, "\x1b[53m")]
+)
+@pytest.mark.parametrize(
+    ("italic", "italic_code"), [(False, "\x1b[23m"), (True, "\x1b[3m")]
+)
+@pytest.mark.parametrize(("reset", "reset_code"), [(False, ""), (True, "\x1b[0m")])
+def test_styling_independent_attributes(
+    underline,
+    underline_code,
+    overline,
+    overline_code,
+    italic,
+    italic_code,
+    reset,
+    reset_code,
+):
+    styled = click.style(
+        "x y", underline=underline, overline=overline, italic=italic, reset=reset
+    )
+    assert styled == f"{underline_code}{overline_code}{italic_code}x y{reset_code}"
+    assert click.unstyle(styled) == "x y"
+
+
 @pytest.mark.parametrize(("text", "expect"), [("\x1b[?25lx y\x1b[?25h", "x y")])
