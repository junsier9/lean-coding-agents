+@pytest.mark.parametrize("firstresult", [False, True])
+@pytest.mark.parametrize(
+    ("old_style_position", "cleanup"),
+    [
+        (None, ["wrapper", "wrapper"]),
+        (1, ["hookwrapper", "wrapper", "wrapper"]),
+        (2, ["wrapper", "hookwrapper", "wrapper"]),
+        (3, ["wrapper", "wrapper", "hookwrapper"]),
+    ],
+)
+def test_wrapper_stopiteration(
+    firstresult: bool, old_style_position: "Union[int, None]", cleanup: List[str]
+) -> None:
+    out = []
+    exception = StopIteration("from hook")
+
+    @hookimpl
+    def impl():
+        raise exception
+
+    @hookimpl(wrapper=True)
+    def wrapper():
+        try:
+            yield
+        except StopIteration as e:
+            assert e is exception
+            raise
+        finally:
+            out.append("wrapper")
+
+    @hookimpl(hookwrapper=True)
+    def old_wrapper():
+        result = yield
+        assert result.exception is exception
+        assert result.excinfo[0] is StopIteration
+        out.append("hookwrapper")
+
+    methods = [impl, wrapper, wrapper]
+    if old_style_position is not None:
+        methods.insert(old_style_position, old_wrapper)
+
+    with pytest.raises(StopIteration) as excinfo:
+        try:
+            MC(methods, {}, firstresult=firstresult)
+        finally:
+            out.append("caller")
+    assert excinfo.value is exception
+    assert excinfo.value.value == "from hook"
+    assert out == cleanup + ["caller"]
+
+
+@pytest.mark.parametrize("old_style", [False, True])
+@pytest.mark.parametrize("hook_raises", [False, True])
+def test_wrapper_raises_stopiteration(old_style: bool, hook_raises: bool) -> None:
+    exception = StopIteration("from wrapper")
+
+    @hookimpl
+    def impl():
+        if hook_raises:
+            raise StopIteration("from hook")
+
+    @hookimpl(wrapper=True)
+    def wrapper():
+        try:
+            yield
+        finally:
+            raise exception
+
+    @hookimpl(hookwrapper=True)
+    def old_wrapper():
+        yield
+
+    methods = [impl, wrapper]
+    if old_style:
+        methods.append(old_wrapper)
+
+    with pytest.raises(RuntimeError, match="generator raised StopIteration") as excinfo:
+        MC(methods, {})
+    assert excinfo.value.__cause__ is exception
+
+
