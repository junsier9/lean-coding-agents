+@pytest.mark.parametrize(
+    ("ctx_value", "opt_value", "expect"),
+    [
+        (None, True, 'value  [default: ""]'),
+        (True, None, 'value  [default: ""]'),
+        (False, True, 'value  [default: ""]'),
+        (True, False, "value"),
+        (None, False, "value"),
+        (None, None, "value"),
+        (True, "empty", "value  [default: (empty)]"),
+    ],
+)
+def test_show_default_empty_string(runner, ctx_value, opt_value, expect):
+    @click.command(context_settings={"show_default": ctx_value})
+    @click.option("--arg", default="", show_default=opt_value, help="value")
+    def cmd(arg):
+        pass
+
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    assert f"--arg TEXT  {expect}\n" in result.output
+
