+    def test_slice_matches_range(self):
+        bounds = (None, -(10**30), -6, -5, -1, 0, 1, 5, 6, 10**30)
+        steps = (None, -5, -2, -1, 1, 2, 5)
+        for args in [
+            (0,),
+            (5, 5),
+            (5, 0),
+            (0, 5, -1),
+            (0, 1),
+            (1, 0, -1),
+            (0, 10, 2),
+            (0, 11, 2),
+            (11, 0, -2),
+            (-8, 9, 3),
+            (8, -9, -3),
+        ]:
+            r = mi.numeric_range(*args)
+            reference = range(*args)
+            for start, stop, step in product(bounds, bounds, steps):
+                sl = slice(start, stop, step)
+                with self.subTest(args=args, sl=sl):
+                    actual = r[sl]
+                    expected = reference[sl]
+                    self.assertIsInstance(actual, mi.numeric_range)
+                    self.assertEqual(list(actual), list(expected))
+                    self.assertEqual(len(actual), len(expected))
+
+    def test_slice_numeric_types(self):
+        bounds = (None, -10, -1, 0, 1, 10)
+        steps = (None, -3, -1, 1, 3)
+        for start, stop, step in [
+            (1.0, 9.0, 1.5),
+            (Decimal('1.0'), Decimal('9.0'), Decimal('1.5')),
+            (Fraction(1, 2), Fraction(5), Fraction(3, 2)),
+            (datetime(2019, 3, 29), datetime(2019, 3, 30), timedelta(hours=10)),
+        ]:
+            for args in [(start, stop, step), (stop, start, -step)]:
+                r = mi.numeric_range(*args)
+                reference = list(r)
+                for i, j, k in product(bounds, bounds, steps):
+                    sl = slice(i, j, k)
+                    with self.subTest(args=args, sl=sl):
+                        actual = r[sl]
+                        expected = reference[sl]
+                        self.assertIsInstance(actual, mi.numeric_range)
+                        self.assertEqual(list(actual), expected)
+                        self.assertEqual(len(actual), len(expected))
+                        self.assertTrue(
+                            all(
+                                type(a) is type(e)
+                                for a, e in zip(actual, expected)
+                            )
+                        )
+
+    def test_slice_index_protocol(self):
+        class Index:
+            def __init__(self, value):
+                self.value = value
+
+            def __index__(self):
+                return self.value
+
+        for sl in [
+            slice(Index(4), Index(0), Index(-2)),
+            slice(None, None, Index(-1)),
+            slice(Index(-1), None, Index(-1)),
+        ]:
+            with self.subTest(sl=sl):
+                actual = mi.numeric_range(0, 10, 2)[sl]
+                self.assertIsInstance(actual, mi.numeric_range)
+                self.assertEqual(list(actual), list(range(0, 10, 2)[sl]))
+
+    def test_slice_errors(self):
+        for args in [(0,), (0, 10, 2)]:
+            for sl, error in [
+                (slice(None, None, 0), ValueError),
+                (slice(None, None, False), ValueError),
+                (slice(1.0, None), TypeError),
+                (slice(None, 1.0), TypeError),
+                (slice(None, None, 1.0), TypeError),
+            ]:
+                with self.subTest(args=args, sl=sl):
+                    with self.assertRaises(error):
+                        mi.numeric_range(*args)[sl]
+
+    def test_slice_large_range(self):
+        r = mi.numeric_range(0, 10**30, 2)[::-1]
