+    def test_slice_matches_range(self):
+        bounds = [None, -(10**30), -10, -5, -1, 0, 1, 5, 10, 10**30]
+        steps = [None, -3, -2, -1, 1, 2, 3]
+        for args in [
+            (0, 10, 2),
+            (10, 0, -2),
+            (1, 10, 3),
+            (10, 1, -3),
+            (0,),
+            (1,),
+            (5, 5),
+            (5, 1),
+            (1, 5, -1),
+        ]:
+            r = mi.numeric_range(*args)
+            expected = range(*args)
+            for start, stop, step in product(bounds, bounds, steps):
+                sl = slice(start, stop, step)
+                with self.subTest(args=args, sl=sl):
+                    actual = r[sl]
+                    self.assertIsInstance(actual, mi.numeric_range)
+                    self.assertEqual(list(actual), list(expected[sl]))
+                    self.assertEqual(len(actual), len(expected[sl]))
+
+    def test_negative_slice_numeric_types(self):
+        for start, stop, step in [
+            (1.0, 9.0, 1.5),
+            (Decimal('1.0'), Decimal('9.0'), Decimal('1.5')),
+            (Fraction(1, 1), Fraction(5, 1), Fraction(3, 2)),
+            (
+                datetime(2019, 3, 29),
+                datetime(2019, 3, 30),
+                timedelta(hours=10),
+            ),
+        ]:
+            for args in [(start, stop, step), (stop, start, -step)]:
+                r = mi.numeric_range(*args)
+                values = list(r)
+                for sl in [
+                    slice(None, None, -1),
+                    slice(None, None, -2),
+                    slice(-2, None, -1),
+                    slice(None, -1, -1),
+                    slice(2, 0, -1),
+                    slice(100, -100, -2),
+                ]:
+                    with self.subTest(args=args, sl=sl):
+                        actual = r[sl]
+                        self.assertIsInstance(actual, mi.numeric_range)
+                        self.assertEqual(list(actual), values[sl])
+                        self.assertTrue(
+                            all(type(v) is type(values[0]) for v in actual)
+                        )
+
