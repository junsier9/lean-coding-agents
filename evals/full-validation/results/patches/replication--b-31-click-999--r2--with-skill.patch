+@pytest.mark.parametrize('name, extra, expected_name', [
+    ('cli', {}, 'cli'),
+    (None, {}, 'root'),
+    ('cli', {'prog_name': 'custom-name'}, 'custom-name'),
+    (None, {'prog_name': 'custom-name'}, 'custom-name'),
+])
+def test_runner_prog_name(name, extra, expected_name):
+    @click.command()
+    @click.option('--count', type=int)
+    @click.pass_context
+    def cli(ctx, count):
+        click.echo(ctx.info_name)
+
+    cli.name = name
+    runner = CliRunner()
+
+    result = runner.invoke(cli, **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output == expected_name + '\n'
+
+    result = runner.invoke(cli, ['--help'], **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output.startswith('Usage: %s [OPTIONS]\n' % expected_name)
+
+    result = runner.invoke(cli, ['--count', 'invalid'], **extra)
+    assert result.exit_code == 2
+    assert isinstance(result.exception, SystemExit)
+    assert result.output.startswith('Usage: %s [OPTIONS]\n' % expected_name)
+    assert 'Error: Invalid value for "--count":' in result.output
+
+
