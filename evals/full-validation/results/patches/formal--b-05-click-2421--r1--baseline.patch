+@pytest.mark.parametrize("name", [None, "custom", ""])
+def test_add_completion_class(monkeypatch, name):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    class CustomComplete(ShellComplete):
+        name = "custom-shell"
+
+    registered = add_completion_class(CustomComplete, name=name)
+    registered_name = CustomComplete.name if name is None else name
+    assert registered is CustomComplete
+    assert get_completion_class(registered_name) is CustomComplete
+    assert CustomComplete.name == "custom-shell"
+
+    if name is not None:
+        assert get_completion_class(CustomComplete.name) is None
+
+
+def test_add_completion_class_decorator(monkeypatch):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    @add_completion_class
+    class CustomComplete(ShellComplete):
+        name = "custom-shell"
+        source_template = "custom shell source"
+
+    assert issubclass(CustomComplete, ShellComplete)
+    assert get_completion_class("custom-shell") is CustomComplete
+    comp = CustomComplete(Command("cli"), {}, "cli", "_CLI_COMPLETE")
+    assert comp.source() == "custom shell source"
+
