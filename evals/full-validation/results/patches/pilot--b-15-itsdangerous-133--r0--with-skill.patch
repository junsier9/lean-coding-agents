+    @pytest.mark.parametrize("max_age", (0, 10))
+    @pytest.mark.parametrize("return_timestamp", (False, True))
+    def test_negative_age(self, signer, ts, freeze, max_age, return_timestamp):
+        signed = signer.sign("value")
+        freeze.tick(timedelta(seconds=-1))
+
+        with pytest.raises(
+            SignatureExpired, match="Signature age -1 < 0 seconds"
+        ) as exc_info:
+            signer.unsign(signed, max_age=max_age, return_timestamp=return_timestamp)
+
+        assert exc_info.value.payload == b"value"
+        assert exc_info.value.date_signed == ts
+        assert not signer.validate(signed, max_age=max_age)
+        assert signer.validate(signed)
+        assert signer.unsign(signed, return_timestamp=True) == (b"value", ts)
+
+    @pytest.mark.parametrize("age, max_age", ((0, 0), (0, 10), (10, 10)))
+    def test_max_age_boundary(self, signer, ts, freeze, age, max_age):
+        signed = signer.sign("value")
+        freeze.tick(timedelta(seconds=age))
+        assert signer.unsign(signed, max_age=max_age) == b"value"
+        assert signer.unsign(signed, max_age=max_age, return_timestamp=True) == (
+            b"value",
+            ts,
+        )
+        assert signer.validate(signed, max_age=max_age)
+
     def test_return_timestamp(self, signer, ts):
         signed = signer.sign("value")
         assert signer.unsign(signed, return_timestamp=True) == (b"value", ts)
