@@ -1,5 +1,7 @@
 import os.path
+from pathlib import Path
 
+import pytest
 
 
 
@@ -12,6 +14,76 @@ from boltons.strutils import removeprefix
 BOLTONS_PATH = os.path.dirname(os.path.abspath(fileutils.__file__))
 
 
+class BytesPathLike(os.PathLike):
+    def __init__(self, path):
+        self.path = path
+
+    def __fspath__(self):
+        return os.fsencode(self.path)
+
+
+@pytest.mark.parametrize('path_type', [str, Path, BytesPathLike])
+@pytest.mark.parametrize('saver_type', [fileutils.AtomicSaver, fileutils.atomic_save])
+def test_atomic_save_pathlike(tmp_path, path_type, saver_type):
+    dest = tmp_path / 'saved.txt'
+    part = tmp_path / 'saved.txt.part'
+
+    for previous, content in [(None, b'first'), (b'first', b'second')]:
+        with saver_type(path_type(dest)) as output:
+            output.write(content)
+            assert part.exists()
+            if previous is None:
+                assert not dest.exists()
+            else:
+                assert dest.read_bytes() == previous
+
+        assert output.closed
+        assert dest.read_bytes() == content
+        assert not part.exists()
+
+
+@pytest.mark.parametrize('path_type', [str, Path, BytesPathLike])
+def test_atomic_save_pathlike_failure(tmp_path, path_type):
+    dest = tmp_path / 'saved.txt'
+    part = tmp_path / 'saved.txt.part'
+    dest.write_bytes(b'original')
+
+    with pytest.raises(RuntimeError, match='aborted'):
+        with fileutils.atomic_save(path_type(dest)) as output:
+            output.write(b'incomplete')
+            raise RuntimeError('aborted')
+
+    assert output.closed
+    assert dest.read_bytes() == b'original'
+    assert not part.exists()
+
+    with pytest.raises(OSError):
+        with fileutils.atomic_save(path_type(dest), overwrite=False):
+            pytest.fail('existing destination must not be opened')
+
+    assert dest.read_bytes() == b'original'
+    assert not part.exists()
+
+
+@pytest.mark.parametrize('path_type', [str, Path, BytesPathLike])
+def test_iter_find_files_pathlike(tmp_path, path_type):
+    nested = tmp_path / 'nested'
+    nested.mkdir()
+    matched_dir = tmp_path / 'folder.txt'
+    matched_dir.mkdir()
+    top_file = tmp_path / 'top.txt'
+    nested_file = nested / 'child.txt'
+    for path in (top_file, nested_file, tmp_path / 'ignored.txt', tmp_path / 'other.py'):
+        path.touch()
+
+    directory = path_type(tmp_path)
+    assert set(iter_find_files(directory, '*.txt', ignored='ignored*')) == {
+        str(top_file), str(nested_file)}
+    assert list(iter_find_files(directory, ['*.txt'], ignored=['ignored*'], max_depth=0)) == [str(top_file)]
+    assert set(iter_find_files(directory, '*.txt', ignored='ignored*', include_dirs=True)) == {
+        str(top_file), str(nested_file), str(matched_dir)}
+
+
