@@ -83,6 +83,37 @@ class TestTimestampSigner(FreezeMixin, TestSigner):
 
         assert isinstance(exc_info.value.date_signed, datetime)
 
+    @pytest.mark.parametrize("timestamp", (253402300800, 2**63 - 1, 2**64 - 1))
+    @pytest.mark.parametrize("max_age", (None, 10))
+    def test_sig_error_out_of_range_timestamp(
+        self, signer, monkeypatch, timestamp, max_age
+    ):
+        monkeypatch.setattr(signer, "get_timestamp", lambda: timestamp)
+        signed = signer.sign("my string").replace(b"my", b"other", 1)
+
+        with pytest.raises(BadTimeSignature, match="Malformed timestamp") as exc_info:
+            signer.unsign(signed, max_age=max_age)
+
+        assert exc_info.value.payload == b"other string"
+        assert exc_info.value.date_signed is None
+        assert not signer.validate(signed, max_age=max_age)
+
+    @pytest.mark.parametrize("error", (ValueError, OSError, OverflowError))
+    def test_sig_error_timestamp_conversion(self, signer, monkeypatch, error):
+        signed = signer.sign("my string").replace(b"my", b"other", 1)
+
+        def timestamp_to_datetime(ts):
+            raise error("timestamp out of range")
+
+        monkeypatch.setattr(signer, "timestamp_to_datetime", timestamp_to_datetime)
+
+        with pytest.raises(BadTimeSignature, match="Malformed timestamp") as exc_info:
+            signer.unsign(signed, return_timestamp=True)
+
+        assert exc_info.value.payload == b"other string"
+        assert exc_info.value.date_signed is None
+        assert isinstance(exc_info.value.__cause__, error)
+
 
