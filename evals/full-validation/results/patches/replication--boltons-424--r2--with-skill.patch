     assert x[2:4:-1] == IndexedSet([8, 7])
 
 
+def test_indexed_set_slice_after_pop():
+    x = IndexedSet(range(10))
+    x.pop(2)
+
+    assert list(x[1:4]) == [1, 3, 4]
+    assert list(x[-3:]) == [7, 8, 9]
+
+
+@mark.parametrize('method', ['pop', 'remove'])
+@mark.parametrize('size, removed', [
+    (0, ()),
+    (10, ()),
+    (10, (2,)),
+    (32, (0, 1, 2)),
+    (32, (2, 17, 25)),
+    (10, (0, 1)),
+    (10, tuple(range(10))),
+])
+def test_indexed_set_slice_windows(method, size, removed):
+    x = IndexedSet(range(size))
+    for item in removed:
+        if method == 'pop':
+            x.pop(x.index(item))
+        else:
+            x.remove(item)
+    contents = list(x)
+    fresh = IndexedSet(contents)
+    bounds = (None, -100, -3, -1, 0, 1, 2, 4, 100)
+    for start in bounds:
+        for stop in bounds:
+            for step in (None, 1, 2, 100, 10**100, -1, -2, -100, -10**100):
+                window = slice(start, stop, step)
+                if step is not None and step < 0:
+                    # Negative steps select a window of the reversed set.
+                    expected = contents[::-1][start:stop:-step]
+                else:
+                    expected = contents[window]
+                assert list(x[window]) == expected, window
+                assert x[window] == fresh[window], window
+                assert list(x.iter_slice(start, stop, step)) == expected, window
+
+
+@mark.parametrize('window, error', [
+    (slice(None, None, 0), ValueError),
+    (slice(1.5, None), TypeError),
+    (slice(None, '3'), TypeError),
+    (slice(None, None, 1.5), TypeError),
+])
+def test_indexed_set_invalid_slice(window, error):
+    x = IndexedSet(range(10))
+    x.pop(2)
+    with raises(error):
+        x[window]
+    with raises(error):
+        x.iter_slice(window.start, window.stop, window.step)
+
+
