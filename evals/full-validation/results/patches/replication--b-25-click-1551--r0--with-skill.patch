 import click
 
 
@@ -49,6 +51,39 @@ def test_basic_functionality(runner):
     ]
 
 
+@pytest.mark.parametrize(
+    ("options_metavar", "usage"),
+    [
+        ("", "Usage: cli SRC [DEST]"),
+        (None, "Usage: cli SRC [DEST]"),
+        ("[FLAGS]", "Usage: cli [FLAGS] SRC [DEST]"),
+    ],
+)
+@pytest.mark.parametrize(("args", "exit_code"), [(["--help"], 0), ([], 2)])
+def test_options_metavar(runner, options_metavar, usage, args, exit_code):
+    @click.command(options_metavar=options_metavar)
+    @click.argument("src")
+    @click.argument("dest", required=False)
+    def cli(src, dest):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == exit_code
+    assert result.output.splitlines()[0] == usage
+
+
+@pytest.mark.parametrize("options_metavar", ["", None])
+def test_group_no_options_metavar(runner, options_metavar):
+    @click.group(options_metavar=options_metavar)
+    @click.argument("src")
+    def cli(src):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines()[0] == "Usage: cli SRC COMMAND [ARGS]..."
+
+
