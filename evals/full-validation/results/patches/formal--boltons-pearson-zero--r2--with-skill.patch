 from boltons.statsutils import Stats, mode
 
 
@@ -20,6 +22,29 @@ def test_pearson_type_covers_kappa_ge_zero():
         assert Stats(data).pearson_type in (0, 1, 2, 3, 4, 5, 6, 7)
 
 
+@pytest.mark.parametrize('skewness, kurtosis, expected', [
+    (0.0, 3.0, 0),  # Normal takes precedence over the zero c2 boundary.
+    (0.0, 2.0, 2),
+    (0.0, 4.0, 7),
+    (1.0, 4.0, 1),
+    (1.0, 6.0, 4),
+    (8.0 / 3, 22.0, 5),  # kappa == 1 (inverse gamma).
+    (2.0, 12.0, 5),  # kappa rounds to 1 at the default precision.
+    (2.0, 10.0, 6),
+    (2.0, 3.0, 6),  # c0 == 0, c2 != 0: infinite kappa.
+    (-2.0, 3.0, 6),
+    (2.0, 9.0, 3),  # Gamma takes precedence over the zero denominator.
+    (0.01, 3.1, 0),  # Preserve the rounded Normal boundary.
+    (2.0, 9.1, 3),  # Preserve the rounded Gamma boundary.
+])
+def test_pearson_type_moment_boundaries(skewness, kurtosis, expected):
+    stats = Stats([0])
+    # Supply exact moments through the existing cache to isolate classification.
+    stats._skewness = skewness
+    stats._kurtosis = kurtosis
+    assert stats.pearson_type == expected
+
+
 def test_mode():
     assert Stats([2, 1, 3, 1]).mode == 1
