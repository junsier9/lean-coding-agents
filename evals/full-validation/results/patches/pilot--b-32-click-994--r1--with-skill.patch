+@pytest.mark.parametrize('decorate_command', [False, True])
+def test_option_custom_class_reusable(runner, decorate_command):
+    class CustomOption(click.Option):
+        def get_default(self, ctx):
+            return 42
+
+    shared_option = click.option('--value', cls=CustomOption, type=int,
+                                 default=1, help='A shared option.')
+    commands = []
+    for name in ('first', 'second'):
+        def cmd(value):
+            click.echo(value)
+
+        if decorate_command:
+            cmd = shared_option(click.command(name)(cmd))
+        else:
+            cmd = click.command(name)(shared_option(cmd))
+        commands.append(cmd)
+
+    assert commands[0].params[0] is not commands[1].params[0]
+    for cmd in commands:
+        assert isinstance(cmd.params[0], CustomOption)
+
+        result = runner.invoke(cmd)
+        assert result.exit_code == 0
+        assert result.output == '42\n'
+
+        result = runner.invoke(cmd, ['--value', '7'])
+        assert result.exit_code == 0
+        assert result.output == '7\n'
+
+        result = runner.invoke(cmd, ['--value', 'invalid'])
+        assert result.exit_code == 2
+        assert 'Invalid value for "--value"' in result.output
+
+        result = runner.invoke(cmd, ['--help'])
+        assert result.exit_code == 0
+        assert 'A shared option.' in result.output
+
+
