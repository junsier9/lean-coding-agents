@@ -1091,6 +1091,56 @@ class BucketTests(TestCase):
         self.assertNotIn(0, D._cache)  # Don't store non-valid entries
         self.assertEqual(list(D[0]), [])
 
+    def test_falsey_validator(self):
+        class CallableSet(set):
+            __call__ = set.__contains__
+
+        operations = [
+            ('getitem', lambda D: list(D[10]), []),
+            ('contains', lambda D: 10 in D, False),
+            ('iter', list, []),
+        ]
+        for name, operation, expected in operations:
+            with self.subTest(operation=name):
+                iterable = iter([10, 20, 11, 21])
+                D = mi.bucket(
+                    iterable,
+                    key=lambda x: 10 * (x // 10),
+                    validator=CallableSet(),
+                )
+                self.assertEqual(operation(D), expected)
+                if name != 'iter':
+                    # Rejected queries must leave the source untouched.
+                    self.assertEqual(list(iterable), [10, 20, 11, 21])
+
+    def test_falsey_validator_accepts_some_keys(self):
+        class Validator:
+            def __bool__(self):
+                return False
+
+            def __call__(self, value):
+                return value == 10
+
+        D = mi.bucket(
+            [20, 10, 21, 11],
+            key=lambda x: 10 * (x // 10),
+            validator=Validator(),
+        )
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertNotIn(20, D)
+        self.assertEqual(list(D[20]), [])
+        self.assertEqual(set(D), {10})
+
+    def test_none_validator(self):
+        D = mi.bucket(
+            [10, 20, 11], key=lambda x: 10 * (x // 10), validator=None
+        )
+        self.assertIn(10, D)
+        self.assertEqual(set(D), {10, 20})
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertEqual(list(D[20]), [20])
+        self.assertEqual(list(D[30]), [])
+
