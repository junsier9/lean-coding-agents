@@ -786,6 +786,36 @@ def test_show_default_string(runner):
     assert "[default: (unlimited)]" in message
 
 
+@pytest.mark.parametrize("default_map", [None, {"arg": ""}])
+@pytest.mark.parametrize(
+    ("show_default", "context_show_default", "expect"),
+    [
+        (True, None, 'Value.  [default: ""]'),
+        (True, False, 'Value.  [default: ""]'),
+        (None, True, 'Value.  [default: ""]'),
+        (False, True, "Value."),
+        (None, None, "Value."),
+        ("empty", None, "Value.  [default: (empty)]"),
+    ],
+)
+def test_show_default_empty_string(
+    runner, default_map, show_default, context_show_default, expect
+):
+    @click.command(context_settings={"show_default": context_show_default})
+    @click.option(
+        "--arg",
+        default="" if default_map is None else "fallback",
+        show_default=show_default,
+        help="Value.",
+    )
+    def cmd(arg):
+        pass
+
+    result = runner.invoke(cmd, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    assert f"--arg TEXT  {expect}\n" in result.output
+
+
 def test_do_not_show_no_default(runner):
     """When show_default is True and no default is set do not show None."""
     opt = click.Option(["--limit"], show_default=True)
