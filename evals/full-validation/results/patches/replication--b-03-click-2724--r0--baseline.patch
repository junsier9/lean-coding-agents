+@pytest.mark.parametrize(
+    ("show_default", "ctx_show_default", "expect"),
+    [
+        (True, None, '[default: ""]'),
+        (None, True, '[default: ""]'),
+        (True, False, '[default: ""]'),
+        (False, True, ""),
+        (None, None, ""),
+        ("empty", None, "[default: (empty)]"),
+    ],
+)
+def test_show_default_empty_string(runner, show_default, ctx_show_default, expect):
+    @click.command(context_settings={"show_default": ctx_show_default})
+    @click.option("--value", default="", show_default=show_default)
+    def cli(value):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    option_help = next(
+        line.strip() for line in result.output.splitlines() if "--value" in line
+    )
+    assert option_help == f"--value TEXT  {expect}".rstrip()
+
+
