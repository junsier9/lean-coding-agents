+def test_progressbar_hidden_updates(tmp_path, monkeypatch):
+    fake_clock = FakeClock()
+    monkeypatch.setattr(time, "time", fake_clock.time)
+    output = tmp_path / "progress.txt"
+
+    with output.open("w", encoding="utf-8") as file:
+        with click.progressbar(length=4, label="Starting", file=file) as progress:
+            assert output.read_text(encoding="utf-8") == "Starting\n"
+            progress.update(1)
+            progress.render_progress()
+            assert output.read_text(encoding="utf-8") == "Starting\n"
+
+            progress.label = "Finishing"
+            progress.update(1)
+            progress.update(1)
+            assert output.read_text(encoding="utf-8") == "Starting\nFinishing\n"
+
+            progress.label = "Starting"
+            progress.update(1)
+
+    assert output.read_text(encoding="utf-8") == "Starting\nFinishing\nStarting\n"
 
 
