 import click
 
 
@@ -13,6 +15,26 @@ def test_basic_defaults(runner):
     assert "FOO:[42.0]" in result.output
 
 
+@pytest.mark.parametrize("default", [True, False])
+@pytest.mark.parametrize(
+    ("map_default", "expected"), [(True, "cache"), (False, "no-cache")]
+)
+def test_boolean_flag_default_map_help(runner, default, map_default, expected):
+    @click.command()
+    @click.option("--cache/--no-cache", default=default, show_default=True)
+    def cli(cache):
+        click.echo(cache)
+
+    default_map = {"cache": map_default}
+    result = runner.invoke(cli, [], default_map=default_map)
+    assert result.exit_code == 0
+    assert result.output == f"{map_default}\n"
+
+    result = runner.invoke(cli, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    assert f"[default: {expected}]" in result.output
+
+
 def test_multiple_defaults(runner):
     @click.command()
     @click.option("--foo", default=[23, 42], type=click.FLOAT, multiple=True)
