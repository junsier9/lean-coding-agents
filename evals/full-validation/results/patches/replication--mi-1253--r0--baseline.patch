+
+    def test_maxsplit_zero(self):
+        items = [None, 0, False, '', (), []]
+        for splitter in (mi.split_before, mi.split_after, mi.split_when):
+            with self.subTest(splitter=splitter.__name__):
+                pred = mock.Mock(side_effect=AssertionError)
+                iterable = iter(items)
+                result = splitter(iterable, pred, maxsplit=0)
