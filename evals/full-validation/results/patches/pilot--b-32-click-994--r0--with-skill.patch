+@pytest.mark.parametrize('command_first', [False, True])
+def test_option_custom_class_reused(runner, command_first):
+    class CustomOption(click.Option):
+        def get_default(self, ctx):
+            return 'custom ' + click.Option.get_default(self, ctx)
+
+    shared_option = click.option('--value', cls=CustomOption, default='default')
+    options = []
+
+    for name in ('first', 'second', 'third'):
+        def callback(value):
+            click.echo(value)
+
+        if command_first:
+            cmd = shared_option(click.command(name)(callback))
+        else:
+            cmd = click.command(name)(shared_option(callback))
+
+        option = cmd.params[0]
+        assert isinstance(option, CustomOption)
+        assert all(option is not previous for previous in options)
+        options.append(option)
+
+        result = runner.invoke(cmd)
+        assert result.exit_code == 0
+        assert result.output == 'custom default\n'
+
+        result = runner.invoke(cmd, ['--value', 'explicit'])
+        assert result.exit_code == 0
+        assert result.output == 'explicit\n'
+
+
