diff --git a/tests/test_tableutils.py b/tests/test_tableutils.py
index 4524386..70007c2 100644
--- a/tests/test_tableutils.py
+++ b/tests/test_tableutils.py
@@ -1,3 +1,5 @@
+import pytest
+
 from boltons.tableutils import Table
 
 
@@ -52,3 +54,79 @@ def test_table_obj():
     t4 = Table.from_object(TestType())
     assert len(t4) == 1
     assert 'greeting' in t4.headers
+
+
+@pytest.mark.parametrize('data', [None, [], [[]]])
+@pytest.mark.parametrize('with_headers', [False, True])
+def test_table_to_text_empty(data, with_headers):
+    assert Table(data).to_text(with_headers=with_headers) == ''
+
+
+@pytest.mark.parametrize('headers', [None, [], ()])
+@pytest.mark.parametrize('with_headers', [False, True])
+def test_table_to_text_without_headers(headers, with_headers):
+    table = Table([['a', None], [123, 'b']], headers=headers)
+
+    assert table.to_text(with_headers=with_headers) == ' a  | None\n123 |  b  '
+
+
+@pytest.mark.parametrize('headers', [None, [], ()])
+def test_table_to_text_removed_headers(headers):
+    table = Table([['head'], ['data']])
+    table.headers = headers
+
+    assert table.to_text() == 'data'
+
+
+@pytest.mark.parametrize('header, expected', [
+    (None, 'None\n----\nNone\n 7  '),
+    (42, ' 42 \n----\nNone\n 7  '),
+])
+def test_table_to_text_non_string_headers(header, expected):
+    table = Table([[None], [7]], headers=[header])
+
+    assert table.to_text() == expected
+
+
+@pytest.mark.parametrize('initial_headers', [None, ['head']])
+def test_table_to_text_short_headers(initial_headers):
+    table = Table([['row1', 'data', 'last']], headers=initial_headers)
+    headers = ['head']
+    table.headers = headers
+
+    expected = ('head | None | None\n'
+                '-----|------|-----\n'
+                'row1 | data | last')
+    assert table.to_text() == expected
+    assert table.to_text() == expected
+    assert table.to_text(with_headers=False) == 'row1 | data | last'
+    assert table.to_text(maxlen=3) == ('... | ... | ...\n'
+                                      '----|-----|----\n'
+                                      '... | ... | ...')
+    assert headers == ['head']
+    assert table[0] == ['row1', 'data', 'last']
+
+
+@pytest.mark.parametrize('header', [None, 'long header'])
+def test_table_to_text_maxlen_headers(header):
+    table = Table([['long value']], headers=[header])
+
+    assert table.to_text(maxlen=3) == '...\n---\n...'
+    assert table.to_text(with_headers=False, maxlen=3) == '...'
+
+
+def test_table_to_text_headers_only():
+    table = Table(headers=['name', None])
+
+    assert table.to_text() == 'name | None\n-----|-----'
+    assert table.to_text(with_headers=False) == ''
+
+
+def test_table_to_text_regular():
+    table = Table([['name', 'city'], ['John', 'Rome'], ['Jane', 'Oslo']])
+
+    assert table.to_text() == ('name | city\n'
+                               '-----|-----\n'
+                               'John | Rome\n'
+                               'Jane | Oslo')
+    assert table.to_text(with_headers=False) == 'John | Rome\nJane | Oslo'
