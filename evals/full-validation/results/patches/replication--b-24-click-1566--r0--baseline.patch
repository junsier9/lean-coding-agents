diff --git a/tests/test_context.py b/tests/test_context.py
index c1be8f3..72cec80 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -6,6 +6,36 @@ import click
 from click.core import ParameterSource
 
 
+@pytest.mark.parametrize("parent_show_default", [None, False, True])
+@pytest.mark.parametrize("child_show_default", [None, False, True])
+@pytest.mark.parametrize("args", [["cmd", "--help"], ["group", "cmd", "--help"]])
+def test_show_default_inheritance(runner, parent_show_default, child_show_default, args):
+    @click.group(context_settings={"show_default": parent_show_default})
+    def cli():
+        pass
+
+    @cli.group()
+    def group():
+        pass
+
+    @cli.command(context_settings={"show_default": child_show_default})
+    @click.option("--value", default=42)
+    @click.option("--explicit", default="custom", show_default=True)
+    def cmd(value, explicit):
+        pass
+
+    group.add_command(cmd)
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0
+
+    expected = (
+        parent_show_default if child_show_default is None else child_show_default
+    )
+    assert ("[default: 42]" in result.output) == bool(expected)
+    assert "[default: custom]" in result.output
+
+
