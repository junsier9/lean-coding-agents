diff --git a/tests/test_tableutils.py b/tests/test_tableutils.py
index 4524386..a8026d2 100644
--- a/tests/test_tableutils.py
+++ b/tests/test_tableutils.py
@@ -1,3 +1,5 @@
+import pytest
+
 from boltons.tableutils import Table
 
 
@@ -52,3 +54,57 @@ def test_table_obj():
     t4 = Table.from_object(TestType())
     assert len(t4) == 1
     assert 'greeting' in t4.headers
+
+
+@pytest.mark.parametrize('data', [None, [], [[]], [[], []]])
+def test_table_text_empty(data):
+    table = Table(data)
+    assert table.to_text() == ''
+    assert table.to_text(with_headers=False) == ''
+
+
+@pytest.mark.parametrize('headers', [None, []])
+def test_table_text_without_headers(headers):
+    table = Table([[1, 2], [3]], headers=headers)
+    expected = '1 |  2  \n3 | None'
+    assert table.to_text() == expected
+    assert table.to_text(with_headers=False) == expected
+    assert table.headers == []
+
+
+def test_table_text_non_string_headers():
+    table = Table([[None, 7]], headers=[None, 7])
+    assert table.to_text() == 'None | 7\n-----|--\nNone | 7'
+    assert table.to_text(with_headers=False) == 'None | 7'
+    assert table.headers == [None, 7]
+
+
+def test_table_text_maxlen():
+    table = Table([['long value', None]], headers=['long header', None])
+    assert table.to_text(maxlen=4) == 'l... | None\n-----|-----\nl... | None'
+
+
+@pytest.mark.parametrize('shorten_headers', [False, True])
+def test_table_text_short_headers(shorten_headers):
+    headers = ['id', None] if shorten_headers else ['id']
+    table = Table([[1, 2], [3]], headers=headers)
+    if shorten_headers:
+        headers.pop()
+    expected = Table([[1, 2], [3]], headers=['id', None])
+    assert table.to_text() == expected.to_text()
+    assert table.to_text(with_headers=False) == '1 |  2  \n3 | None'
+    assert table.to_html(orientation='horizontal') == expected.to_html(orientation='horizontal')
+    assert table.headers == ['id']
+
+
+@pytest.mark.parametrize('data', [None, [], [['id', None]]])
+def test_table_text_headers_only(data):
+    table = Table(data) if data else Table(data, headers=['id', None])
+    assert table.to_text() == 'id | None\n---|-----'
+    assert table.to_text(with_headers=False) == ''
+
+
+def test_table_text_layout():
+    table = Table([[1, 2], [3, 4]], headers=['a', 'b'])
+    assert table.to_text() == 'a | b\n--|--\n1 | 2\n3 | 4'
+    assert table.to_text(with_headers=False) == '1 | 2\n3 | 4'
