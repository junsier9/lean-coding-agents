diff --git a/tests/test_context.py b/tests/test_context.py
index c1be8f3..d801e86 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -343,3 +343,46 @@ def test_parameter_source_environment_variable_specified(runner):
 def test_validate_parameter_source():
     with pytest.raises(ValueError):
         ParameterSource.validate("NOT_A_VALID_PARAMETER_SOURCE")
+
+
+@pytest.mark.parametrize(
+    ("parent_show_default", "child_settings", "expected"),
+    [
+        (None, {}, False),
+        (None, {"show_default": None}, False),
+        (None, {"show_default": False}, False),
+        (None, {"show_default": True}, True),
+        (False, {}, False),
+        (False, {"show_default": None}, False),
+        (False, {"show_default": False}, False),
+        (False, {"show_default": True}, True),
+        (True, {}, True),
+        (True, {"show_default": None}, True),
+        (True, {"show_default": False}, False),
+        (True, {"show_default": True}, True),
+    ],
+)
+def test_show_default_inheritance(runner, parent_show_default, child_settings, expected):
+    @click.group(context_settings={"show_default": parent_show_default})
+    @click.option("--value", default=42)
+    def cli(value):
+        pass
+
+    @cli.group(context_settings=child_settings)
+    @click.option("--value", default=42)
+    def child(value):
+        pass
+
+    @child.command()
+    @click.option("--value", default=42)
+    def command(value):
+        pass
+
+    for args, show_default in [
+        (["--help"], bool(parent_show_default)),
+        (["child", "--help"], expected),
+        (["child", "command", "--help"], expected),
+    ]:
+        result = runner.invoke(cli, args)
+        assert result.exit_code == 0
+        assert ("[default: 42]" in result.output) is show_default
