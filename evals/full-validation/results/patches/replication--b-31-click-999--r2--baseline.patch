+@pytest.mark.parametrize('command_name, extra, expected_name', [
+    ('cli', {}, 'cli'),
+    (None, {}, 'root'),
+    ('cli', {'prog_name': 'custom-cli'}, 'custom-cli'),
+    (None, {'prog_name': 'custom-cli'}, 'custom-cli'),
+])
+def test_runner_prog_name(runner, command_name, extra, expected_name):
+    @click.pass_context
+    def callback(ctx):
+        click.echo(ctx.info_name)
+
+    cli = click.Command(command_name, callback=callback)
+
+    result = runner.invoke(cli, **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output == expected_name + '\n'
+
+    result = runner.invoke(cli, ['--help'], **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output.startswith('Usage: %s [OPTIONS]\n' % expected_name)
+
+
