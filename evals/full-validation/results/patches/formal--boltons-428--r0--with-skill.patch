+@pytest.mark.parametrize('endpoint', [0.25, 1.0, 5.0])
+@pytest.mark.parametrize('factor', [1.0, 2.0])
+def test_backoff_equal_endpoints(endpoint, factor):
+    from boltons.iterutils import backoff, backoff_iter
+
+    assert backoff(endpoint, endpoint, factor=factor) == [endpoint]
+    assert list(backoff_iter(endpoint, endpoint, factor=factor)) == [endpoint]
+
+
+@pytest.mark.parametrize('start, stop', [(1, 16), (0, 16), (0.25, 1)])
+def test_backoff_unit_factor_requires_count(start, stop):
+    from boltons.iterutils import backoff, backoff_iter
+
+    with pytest.raises(ValueError, match='count.*factor'):
+        backoff(start, stop, factor=1.0)
+    with pytest.raises(ValueError, match='count.*factor'):
+        list(backoff_iter(start, stop, factor=1.0))
+
+
+@pytest.mark.parametrize('start, stop, expected', [
+    (2, 8, [2.0] * 4),
+    (0, 8, [0.0, 1.0, 1.0, 1.0]),
+    (0, 0.5, [0.0, 0.5, 0.5, 0.5]),
+    (5, 5, [5.0] * 4),
+])
+@pytest.mark.parametrize('count', [0, 1, 4])
+def test_backoff_unit_factor_count(start, stop, expected, count):
+    from boltons.iterutils import backoff, backoff_iter
+
+    assert backoff(start, stop, count=count, factor=1.0) == expected[:count]
+    assert list(backoff_iter(start, stop, count=count, factor=1.0)) == expected[:count]
+
+
+@pytest.mark.parametrize('start, stop, expected', [
+    (2, 8, [2.0] * 4),
+    (0, 8, [0.0, 1.0, 1.0, 1.0]),
+    (5, 5, [5.0] * 4),
+])
+def test_backoff_unit_factor_repeat(start, stop, expected):
+    from itertools import islice
+    from boltons.iterutils import backoff, backoff_iter
+
+    assert list(islice(backoff_iter(start, stop, count='repeat', factor=1.0), 4)) == expected
+    with pytest.raises(ValueError, match="'repeat' supported in backoff_iter, not backoff"):
+        backoff(start, stop, count='repeat', factor=1.0)
+
