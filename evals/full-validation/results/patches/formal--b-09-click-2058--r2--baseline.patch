+@pytest.mark.parametrize(
+    ("underline", "underline_code"),
+    [(None, ""), (True, "\x1b[4m"), (False, "\x1b[24m")],
+)
+@pytest.mark.parametrize(
+    ("overline", "overline_code"),
+    [(None, ""), (True, "\x1b[53m"), (False, "\x1b[55m")],
+)
+@pytest.mark.parametrize(
+    ("italic", "italic_code"),
+    [(None, ""), (True, "\x1b[3m"), (False, "\x1b[23m")],
+)
+@pytest.mark.parametrize("reset", [True, False])
+def test_style_independent_attributes(
+    underline, underline_code, overline, overline_code, italic, italic_code, reset
+):
+    styled = click.style(
+        "x y", underline=underline, overline=overline, italic=italic, reset=reset
+    )
+    expected = underline_code + overline_code + italic_code + "x y"
+
+    if reset:
+        expected += "\x1b[0m"
+
+    assert styled == expected
+    assert click.unstyle(styled) == "x y"
+
+
