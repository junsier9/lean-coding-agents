diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index d4f17a6..d442e8e 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -1,3 +1,5 @@
+import runpy
+
 import pytest
 
 from boltons import urlutils
@@ -112,6 +114,47 @@ def test_query_param_dict_eq_with_dict():
     assert not (qpd == {'a': '999', 'b': '2'})
 
 
+@pytest.fixture(scope='module', params=['package', 'standalone'])
+def query_param_dict_type(request):
+    if request.param == 'standalone':
+        # Loading by path exercises the embedded OrderedMultiDict fallback.
+        return runpy.run_path(urlutils.__file__)['QueryParamDict']
+    return QueryParamDict
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+def test_query_param_dict_addlist_iterables(query_param_dict_type, make_values):
+    qpd = query_param_dict_type.from_text('a=0&b=3')
+    qpd.addlist('a', make_values(['1', '2', '2']))
+    qpd.addlist('c', make_values(['x y', '&']))
+
+    assert qpd.getlist('a') == ['0', '1', '2', '2']
+    assert qpd['a'] == qpd.get('a') == '2'
+    assert qpd.getlist('c') == ['x y', '&']
+    assert qpd.keys() == ['a', 'b', 'c']
+    assert len(qpd) == 3
+    text = 'a=0&b=3&a=1&a=2&a=2&c=x%20y&c=%26'
+    assert qpd.to_text(full_quote=True) == text
+    assert query_param_dict_type.from_text(text) == qpd
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+def test_query_param_dict_addlist_empty_iterables(query_param_dict_type, make_values):
+    qpd = query_param_dict_type()
+    qpd.addlist('missing', make_values([]))
+    assert not qpd
+    assert qpd.keys() == []
+    assert qpd.get('missing') is None
+
+    qpd.add('a', '0')
+    qpd.addlist('a', make_values([]))
+    assert len(qpd) == 1
+    assert qpd.getlist('a') == ['0']
+    assert qpd.to_text() == 'a=0'
+
+
