index c82a4a2..f50d19f 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -2,6 +2,7 @@ import sys
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.dictutils import FastIterOrderedMultiDict
 
 
 _ITEMSETS = [[],
@@ -270,6 +271,63 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [list, tuple, iter, lambda v: (x for x in v)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+def test_addlist_iterables(omd_type, make_values):
+    omd = omd_type()
+    omd.addlist('a', make_values([1, 2, 2]))
+    omd.add('b', 3)
+    omd.addlist('a', make_values([4, 5]))
+
+    expected = [('a', 1), ('a', 2), ('a', 2), ('b', 3), ('a', 4), ('a', 5)]
+    assert omd.items(multi=True) == expected
+    assert repr(omd) == f'{omd_type.__name__}({expected!r})'
+    assert omd.getlist('a') == [1, 2, 2, 4, 5]
+    assert omd['a'] == omd.get('a') == 5
+    assert omd.keys() == list(omd.viewkeys()) == ['a', 'b']
+    assert len(omd) == 2
+    assert omd.poplast('a') == 5
+    assert omd.popall('a') == [1, 2, 2, 4]
+    assert omd.items(multi=True) == [('b', 3)]
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+@pytest.mark.parametrize('initial', [[], [('a', 0), ('b', 1)]])
+def test_addlist_empty_iterables(omd_type, make_values, initial):
+    omd = omd_type(initial)
+    omd.addlist('missing', make_values([]))
+    omd.addlist('a', make_values([]))
+
+    assert omd.items(multi=True) == initial
+    assert len(omd) == len(omd.keys()) == len(initial)
+    assert bool(omd) == bool(initial)
+    assert 'missing' not in omd
+    assert omd.get('missing', 'default') == 'default'
+    assert omd.getlist('missing') == []
+    assert omd.getlist('a') == ([0] if initial else [])
+    assert omd.popall('missing', None) is None
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('key', ['a', 'missing'])
+def test_addlist_iterable_error(omd_type, key):
+    def broken_values():
+        yield 1
+        raise ValueError('iteration failed')
+
+    omd = omd_type([('a', 0)])
+    with pytest.raises(ValueError, match='iteration failed'):
+        omd.addlist(key, broken_values())
+
+    assert omd.items(multi=True) == [('a', 0)]
+    assert omd.getlist('a') == [0]
+    assert omd.keys() == ['a']
+    assert len(omd) == 1
+
+
