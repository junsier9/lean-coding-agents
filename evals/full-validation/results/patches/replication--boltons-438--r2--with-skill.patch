+@mark.parametrize('set_type', [set, frozenset])
+@mark.parametrize('left, right', [
+    ('', ''), ('a', 'a'), ('ab', 'a'), ('a', 'ab'), ('ab', 'bc'),
+    ('', 'a'), ('a', ''),
+])
+def test_complement_set_inclusion(set_type, left, right):
+    left, right = set_type(left), set_type(right)
+    cleft, cright = complement(left), complement(right)
+
+    assert cleft <= cleft
+    assert cleft >= cleft
+    assert (cleft <= cright) is (right <= left)
+    assert (cleft >= cright) is (right >= left)
+    assert cleft.issubset(cright) is (right <= left)
+    assert cleft.issuperset(cright) is (right >= left)
+
+
+@mark.parametrize('set_type', [set, frozenset])
+@mark.parametrize('left, right', [
+    ('', ''), ('a', 'a'), ('ab', 'a'), ('a', 'ab'), ('ab', 'bc'),
+    ('', 'a'), ('a', ''),
+])
+def test_double_complement_set_inclusion(set_type, left, right):
+    left, right = set_type(left), set_type(right)
+    cleft = complement(complement(left))
+    cright = complement(complement(right))
+
+    assert cleft <= cleft
+    assert cleft >= cleft
+    for other in (right, cright):
+        assert (cleft <= other) is (left <= right)
+        assert (cleft >= other) is (left >= right)
+        assert cleft.issubset(other) is (left <= right)
+        assert cleft.issuperset(other) is (left >= right)
+        assert (other <= cleft) is (right <= left)
+        assert (other >= cleft) is (right >= left)
+
+
