+def test_group_command_class_no_parens(runner):
+    class CustomCommand(click.Command):
+        def invoke(self, ctx):
+            click.echo("custom command")
+            return super().invoke(ctx)
+
+    class CustomGroup(click.Group):
+        command_class = CustomCommand
+
+    @click.group(cls=CustomGroup)
+    def grp():
+        pass
+
+    @grp.command
+    @click.option("--name", default="world")
+    def say_hello(name):
+        """Say hello."""
+        click.echo(f"hello {name}")
+
+    assert type(say_hello) is CustomCommand
+    assert grp.commands["say-hello"] is say_hello
+    assert say_hello.help == "Say hello."
+
+    result = runner.invoke(grp, ["say-hello", "--name", "Click"])
+    assert result.exception is None
+    assert result.output == "custom command\nhello Click\n"
+
+
+@pytest.mark.parametrize(
+    ("args", "kwargs"),
+    [((), {"help": "help"}), ((), {"cls": click.Command}), (("name",), {})],
+)
+def test_group_command_no_parens_with_arguments(args, kwargs):
+    class CustomGroup(click.Group):
+        command_class = click.Command
+
+    grp = CustomGroup()
+
+    with pytest.raises(AssertionError, match="provide arguments"):
+        grp.command(lambda: None, *args, **kwargs)
+
+
