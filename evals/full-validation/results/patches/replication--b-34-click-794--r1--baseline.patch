diff --git a/tests/test_options.py b/tests/test_options.py
index d196fe2..a8fe972 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -7,6 +7,45 @@ import pytest
 from click._compat import text_type
 
 
+@pytest.mark.parametrize('decls, expected_name', [
+    (['--foo-bar', '--other'], 'foo_bar'),
+    (['--other', '--foo-bar'], 'other'),
+    (['-f', '--foo-bar', '--other'], 'foo_bar'),
+    (['--foo-bar', '-f', '--other'], 'foo_bar'),
+    (['--foo-bar', '--other', '-f'], 'foo_bar'),
+    (['-f', '--other', '--foo-bar'], 'other'),
+    (['--other', '-f', '--foo-bar'], 'other'),
+    (['--other', '--foo-bar', '-f'], 'other'),
+    (['-f', '-o'], 'f'),
+    (['-o', '-f'], 'o'),
+    (['--FOO-BAR', '--other'], 'foo_bar'),
+    (['--foo-bar', '--other', 'destination'], 'destination'),
+    (['destination', '-f', '--foo-bar', '--other'], 'destination'),
+    (['-f', '++foo-bar', '++other'], 'foo_bar'),
+])
+def test_option_name_from_aliases(decls, expected_name):
+    assert click.Option(decls).name == expected_name
+
+
+@pytest.mark.parametrize('decls', [
+    ['--foo-bar', '--other'],
+    ['-f', '--foo-bar', '--other'],
+    ['--foo-bar', '-f', '--other'],
+    ['--foo-bar', '--other', '-f'],
+])
+def test_option_aliases_callback(runner, decls):
+    @click.command()
+    @click.option(*decls)
+    def cli(foo_bar):
+        click.echo(foo_bar)
+
+    for alias in decls:
+        result = runner.invoke(cli, [alias, 'value'])
+        assert not result.exception
+        assert result.exit_code == 0
+        assert result.output == 'value\n'
+
+
