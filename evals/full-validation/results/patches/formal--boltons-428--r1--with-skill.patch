+@pytest.mark.parametrize('value', [0.25, 1, 5])
+@pytest.mark.parametrize('factor', [1.0, 2.0])
+def test_backoff_equal_endpoints(value, factor):
+    from boltons.iterutils import backoff, backoff_iter
+
+    assert backoff(value, value, factor=factor) == [float(value)]
+    assert list(backoff_iter(value, value, factor=factor)) == [float(value)]
+
+
+@pytest.mark.parametrize('start', [0, 1])
+def test_backoff_unit_factor_requires_count(start):
+    from boltons.iterutils import backoff, backoff_iter
+
+    for func in (backoff, backoff_iter):
+        with pytest.raises(ValueError, match='count'):
+            list(func(start, 16, factor=1.0))
+
+
+@pytest.mark.parametrize('start, stop, expected', [
+    (1, 16, [1.0, 1.0, 1.0, 1.0]),
+    (5, 5, [5.0, 5.0, 5.0, 5.0]),
+    (0, 16, [0.0, 1.0, 1.0, 1.0]),
+])
+@pytest.mark.parametrize('count', [0, 1, 4])
+def test_backoff_unit_factor_explicit_count(start, stop, expected, count):
+    from boltons.iterutils import backoff, backoff_iter
+
+    assert backoff(start, stop, count=count, factor=1.0) == expected[:count]
+    assert list(backoff_iter(start, stop, count=count, factor=1.0)) == expected[:count]
+
+
+@pytest.mark.parametrize('start, stop, expected', [
+    (1, 16, [1.0, 1.0, 1.0, 1.0]),
+    (5, 5, [5.0, 5.0, 5.0, 5.0]),
+    (0, 16, [0.0, 1.0, 1.0, 1.0]),
+])
+def test_backoff_unit_factor_repeat(start, stop, expected):
+    from itertools import islice
+    from boltons.iterutils import backoff_iter
+
+    assert list(islice(backoff_iter(start, stop, count='repeat', factor=1.0), 4)) == expected
+
+
+@pytest.mark.parametrize('kwargs', [{'factor': 0.5}, {'factor': 1.0, 'jitter': 20}])
+def test_backoff_equal_endpoints_validation(kwargs):
+    from boltons.iterutils import backoff, backoff_iter
+
+    for func in (backoff, backoff_iter):
+        with pytest.raises(ValueError):
+            list(func(5, 5, **kwargs))
+
