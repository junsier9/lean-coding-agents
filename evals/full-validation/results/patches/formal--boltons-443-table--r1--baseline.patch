diff --git a/tests/test_tableutils.py b/tests/test_tableutils.py
index 4524386..69109d8 100644
--- a/tests/test_tableutils.py
+++ b/tests/test_tableutils.py
@@ -1,3 +1,5 @@
+import pytest
+
 from boltons.tableutils import Table
 
 
@@ -52,3 +54,62 @@ def test_table_obj():
     t4 = Table.from_object(TestType())
     assert len(t4) == 1
     assert 'greeting' in t4.headers
+
+
+@pytest.mark.parametrize('data', [None, [], [[]], [[], []]])
+@pytest.mark.parametrize('with_headers', [True, False])
+def test_table_to_text_empty(data, with_headers):
+    assert Table(data).to_text(with_headers=with_headers) == ''
+
+
+@pytest.mark.parametrize('header, expected', [
+    (None, 'None'), (0, '0'), (False, 'False'), (3.5, '3.5'),
+])
+def test_table_to_text_non_string_headers(header, expected):
+    table = Table([[header]], headers=[header])
+    assert table.to_text() == '\n'.join([expected, '-' * len(expected), expected])
+
+
+@pytest.mark.parametrize('headers', [None, []])
+@pytest.mark.parametrize('with_headers', [True, False])
+def test_table_to_text_without_headers(headers, with_headers):
+    table = Table([[1, 2], [3, 4]], headers=headers)
+    assert table.to_text(with_headers=with_headers) == '1 | 2\n3 | 4'
+
+
+def test_table_to_text_hidden_headers():
+    table = Table([[1, 2]], headers=['long header', None])
+    assert table.to_text(with_headers=False) == '1 | 2'
+
+
+def test_table_to_text_short_headers():
+    table = Table([[1, 2]], headers=['a'])
+    assert table.to_text() == 'a | None\n--|-----\n1 |  2  '
+    assert table.to_text(with_headers=False) == '1 | 2'
+    assert table.headers == ['a']
+    assert table[0] == [1, 2]
+
+
+def test_table_to_text_short_headers_with_ragged_data():
+    table = Table([[1, 2], [3]], headers=['a'])
+    assert table.to_text() == 'a | None\n--|-----\n1 |  2  \n3 | None'
+    assert table[1] == [3]
+
+
+def test_table_to_text_shortened_headers_match_html():
+    table = Table([['a', 'b'], [1, 2]])
+    table.headers = ['a']
+    assert '<th>a</th><th>None</th>' in table.to_html(orientation='horizontal')
+    assert table.to_text() == 'a | None\n--|-----\n1 |  2  '
+    assert table.headers == ['a']
+
+
+def test_table_to_text_headers_only():
+    table = Table(headers=[None, 'name'])
+    assert table.to_text() == 'None | name\n-----|-----'
+    assert table.to_text(with_headers=False) == ''
+
+
+def test_table_to_text_maxlen():
+    table = Table([['abcdef', None]], headers=['long header', None])
+    assert table.to_text(maxlen=5) == 'lo... | None\n------|-----\nab... | None'
