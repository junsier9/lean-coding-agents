+@pytest.mark.parametrize('decorate_command', [False, True])
+def test_option_custom_class_reusable(runner, decorate_command):
+    class CustomOption(click.Option):
+        def get_default(self, ctx):
+            return 'custom default'
+
+    shared_option = click.option('-v', '--value', cls=CustomOption,
+                                 default='ordinary default', help="""
+        Value help.
+
+        More detail.
+    """)
+    commands = []
+
+    for name in ('first', 'second', 'third'):
+        def callback(value):
+            click.echo(value)
+
+        if decorate_command:
+            cmd = shared_option(click.command(name)(callback))
+        else:
+            cmd = click.command(name)(shared_option(callback))
+        commands.append(cmd)
+
+    assert len(set(id(cmd.params[0]) for cmd in commands)) == len(commands)
+
+    for cmd in commands:
+        assert isinstance(cmd.params[0], CustomOption)
+        assert cmd.params[0].help == 'Value help.\n\nMore detail.'
+
+        result = runner.invoke(cmd)
+        assert result.exit_code == 0
+        assert result.output == 'custom default\n'
+
+        for flag in ('-v', '--value'):
+            result = runner.invoke(cmd, [flag, 'explicit'])
+            assert result.exit_code == 0
+            assert result.output == 'explicit\n'
+
+        result = runner.invoke(cmd, ['--help'])
+        assert result.exit_code == 0
+        assert 'Value help.' in result.output
+        assert 'More detail.' in result.output
+
+
