 _ITEMSETS = [[],
@@ -270,6 +271,62 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [list, tuple, iter, lambda v: (x for x in v)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+def test_addlist_iterables(omd_type, make_values):
+    omd = omd_type([('a', 0), ('b', 4)])
+    omd.addlist('c', make_values([5, 6]))
+    omd.addlist('a', make_values([1, 2, 1]))
+
+    assert omd.getlist('a') == [0, 1, 2, 1]
+    assert omd.getlist('c') == [5, 6]
+    assert omd['a'] == omd.get('a') == 1
+    assert omd['c'] == omd.get('c') == 6
+    assert len(omd) == len(omd.keys()) == 3
+    assert omd.items(multi=True) == [('a', 0), ('b', 4), ('c', 5), ('c', 6),
+                                     ('a', 1), ('a', 2), ('a', 1)]
+    assert omd.poplast('a') == 1
+    assert omd.getlist('a') == [0, 1, 2]
+    assert omd.popall('c') == [5, 6]
+    assert omd.keys() == ['a', 'b']
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [list, tuple, iter, lambda v: (x for x in v)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+def test_addlist_empty_iterables(omd_type, make_values):
+    omd = omd_type()
+    omd.addlist('missing', make_values([]))
+    assert not omd
+    assert len(omd) == len(omd.keys()) == 0
+    assert 'missing' not in omd
+    assert omd.get('missing', 'default') == 'default'
+    assert omd.getlist('missing') == []
+
+    omd.add('a', 1)
+    omd.addlist('a', make_values([]))
+    assert omd.getlist('a') == [1]
+    assert omd.get('a') == 1
+    assert omd.items(multi=True) == [('a', 1)]
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('key', ['a', 'missing'])
+def test_addlist_iterator_error(omd_type, key):
+    def values():
+        yield 2
+        raise ValueError('iteration failed')
+
+    omd = omd_type([('a', 1)])
+    with pytest.raises(ValueError, match='iteration failed'):
+        omd.addlist(key, values())
+    assert omd.items(multi=True) == [('a', 1)]
+    assert omd.getlist('a') == [1]
+    assert len(omd) == len(omd.keys()) == 1
+    assert 'missing' not in omd
+
+
