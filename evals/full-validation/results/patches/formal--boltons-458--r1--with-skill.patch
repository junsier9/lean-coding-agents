diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index d4f17a6..6024291 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -1,3 +1,5 @@
+import runpy
+
 import pytest
 
 from boltons import urlutils
@@ -112,6 +114,47 @@ def test_query_param_dict_eq_with_dict():
     assert not (qpd == {'a': '999', 'b': '2'})
 
 
+@pytest.fixture(params=['package', 'standalone'])
+def query_param_dict_type(request):
+    if request.param == 'standalone':
+        return runpy.run_path(urlutils.__file__)['QueryParamDict']
+    return QueryParamDict
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+def test_query_param_dict_addlist(query_param_dict_type, make_values):
+    qp = query_param_dict_type.from_text('a=0&b=4')
+    qp.addlist('c', make_values(['5', '6']))
+    qp.addlist('a', make_values(['1', '2', '1']))
+    assert qp.getlist('a') == ['0', '1', '2', '1']
+    assert qp.getlist('c') == ['5', '6']
+    assert qp['a'] == qp.get('a') == '1'
+    assert qp['c'] == qp.get('c') == '6'
+    assert len(qp) == len(qp.keys()) == 3
+    assert qp.to_text() == 'a=0&b=4&c=5&c=6&a=1&a=2&a=1'
+    assert query_param_dict_type.from_text(qp.to_text()) == qp
+    assert qp.poplast('a') == '1'
+    assert qp.getlist('a') == ['0', '1', '2']
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+def test_query_param_dict_addlist_empty(query_param_dict_type, make_values):
+    qp = query_param_dict_type()
+    qp.addlist('missing', make_values([]))
+    assert not qp
+    assert len(qp) == len(qp.keys()) == 0
+    assert 'missing' not in qp
+    assert qp.get('missing', 'default') == 'default'
+    assert qp.to_text() == ''
+
+    qp.add('a', '1')
+    qp.addlist('a', make_values([]))
+    assert qp.getlist('a') == ['1']
+    assert qp.to_text() == 'a=1'
+
+
