index ed9d96f..f53543f 100644
--- a/tests/test_commands.py
+++ b/tests/test_commands.py
@@ -105,6 +105,69 @@ def test_no_args_is_help(runner):
     assert "Show this message and exit." in result.output
 
 
+@pytest.mark.parametrize(
+    ("help_option_names", "help_arg"),
+    [
+        (None, "--help"),
+        (["-h", "--help"], "-h"),
+        (["-h", "--help"], "--help"),
+        (["-?", "--how-to"], "-?"),
+        (["-?", "--how-to"], "--how-to"),
+    ],
+)
+@pytest.mark.parametrize("eager_first", [False, True])
+def test_help_option_eager_order(runner, help_option_names, help_arg, eager_first):
+    called = []
+
+    def eager_callback(ctx, param, value):
+        if value:
+            called.append(param.name)
+            click.echo("eager callback")
+            ctx.exit(42)
+
+    @click.command(context_settings={"help_option_names": help_option_names})
+    @click.option(
+        "--eager",
+        is_flag=True,
+        is_eager=True,
+        expose_value=False,
+        callback=eager_callback,
+    )
+    @click.option("--required", required=True)
+    def cli(required):
+        pytest.fail("The command callback should not run.")
+
+    args = ["--eager", help_arg] if eager_first else [help_arg, "--eager"]
+    result = runner.invoke(cli, args)
+
+    if eager_first:
+        assert result.exit_code == 42
+        assert result.output == "eager callback\n"
+        assert called == ["eager"]
+    else:
+        assert result.exit_code == 0
+        assert result.output.startswith("Usage: cli ")
+        assert "Show this message and exit." in result.output
+        assert called == []
+
+
+def test_help_option_names_per_invocation(runner):
+    @click.command()
+    @click.version_option("1.0")
+    def cli():
+        pytest.fail("The command callback should not run.")
+
+    for help_option_names in (["-h", "--help"], ["--man"], ["--help"]):
+        help_arg = help_option_names[0]
+        result = runner.invoke(
+            cli, [help_arg, "--version"], help_option_names=help_option_names
+        )
+        assert result.exit_code == 0
+        assert result.output.startswith("Usage: cli ")
+        assert "Show this message and exit." in result.output
+        assert help_arg in result.output
+
+
