+@pytest.mark.parametrize("default", [True, False])
+@pytest.mark.parametrize("default_map", [None, {"cache": True}, {"cache": False}])
+def test_boolean_flag_default_map(runner, default, default_map):
+    @click.command()
+    @click.option(
+        "--cache/--no-cache", "--c/--nc", default=default, show_default=True
+    )
+    def cli(cache):
+        return cache
+
+    expected_default = default if default_map is None else default_map["cache"]
+    expected_name = "cache" if expected_default else "no-cache"
+
+    result = runner.invoke(cli, [], default_map=default_map, standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value is expected_default
+
+    result = runner.invoke(cli, ["--help"], default_map=default_map)
+    assert result.exit_code == 0
+    assert f"[default: {expected_name}]" in result.output
+
+
