+def test_progressbar_hidden_file(tmp_path):
+    path = tmp_path / "progress.txt"
+
+    with path.open("w", encoding="utf-8") as file:
+        with click.progressbar(range(3), label="Processing", file=file) as progress:
+            assert path.read_text(encoding="utf-8") == "Processing\n"
