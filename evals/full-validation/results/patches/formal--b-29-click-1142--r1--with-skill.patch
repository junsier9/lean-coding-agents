+def test_progressbar_hidden_update(runner, monkeypatch):
+    @click.command()
+    def cli():
+        with click.progressbar(length=4, label="Processing") as progress:
+            progress.update(1)
+            progress.render_progress()
+            progress.label = "Finishing"
+            progress.update(1)
+            progress.update(2)
+            progress.render_progress()
+
