+@pytest.mark.parametrize('name, extra, expected', [
+    ('cli', {}, 'cli'),
+    (None, {}, 'root'),
+    ('cli', {'prog_name': 'custom'}, 'custom'),
+    (None, {'prog_name': 'custom'}, 'custom'),
+])
+def test_runner_prog_name(runner, name, extra, expected):
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        click.echo(ctx.info_name)
+
+    cli.name = name
+    result = runner.invoke(cli, **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output == expected + '\n'
+
+
+@pytest.mark.parametrize('args, exit_code', [
+    (['--help'], 0),
+    ([], 2),
+])
+def test_runner_custom_prog_name_usage(runner, args, exit_code):
+    @click.command()
+    @click.option('--value', required=True)
+    def cli(value):
+        pass
+
+    result = runner.invoke(cli, args, prog_name='custom')
+    assert result.exit_code == exit_code
+    assert result.output.startswith('Usage: custom [OPTIONS]\n')
+
