+@pytest.mark.parametrize('path_type', [str, Path, _PathLike])
+@pytest.mark.parametrize('max_depth', [None, 0, 1])
+@pytest.mark.parametrize('include_dirs', [False, True])
+def test_iter_find_files_pathlike(tmp_path, path_type, max_depth, include_dirs):
+    (tmp_path / 'root.txt').write_text('root')
+    (tmp_path / 'ignored.txt').write_text('ignored')
+    (tmp_path / 'other.py').write_text('other')
+    child = tmp_path / 'child.txt'
+    child.mkdir()
+    (child / 'nested.txt').write_text('nested')
+    deeper = child / 'deeper'
+    deeper.mkdir()
+    (deeper / 'deep.txt').write_text('deep')
+
+    found = set(iter_find_files(path_type(tmp_path), '*.txt', ignored='ignored*',
+                               include_dirs=include_dirs, max_depth=max_depth))
+    expected = {str(tmp_path / 'root.txt')}
+    if include_dirs:
+        expected.add(str(child))
+    if max_depth is None or max_depth >= 1:
+        expected.add(str(child / 'nested.txt'))
+    if max_depth is None:
+        expected.add(str(deeper / 'deep.txt'))
+    assert found == expected
+
+
