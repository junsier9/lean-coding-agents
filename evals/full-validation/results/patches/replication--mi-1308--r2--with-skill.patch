+    def test_falsey_validator(self):
+        class CallableSet(set):
+            __call__ = set.__contains__
+
+        validator = CallableSet()
+        for operation in ('getitem', 'contains', 'iter'):
+            with self.subTest(operation=operation):
+                iterable = iter([10, 20, 11, 21])
+                D = mi.bucket(
+                    iterable, key=lambda x: 10 * (x // 10), validator=validator
+                )
+                if operation == 'getitem':
+                    self.assertEqual(list(D[10]), [])
+                elif operation == 'contains':
+                    self.assertNotIn(10, D)
+                else:
+                    self.assertEqual(list(D), [])
+                    continue
+                self.assertEqual(list(iterable), [10, 20, 11, 21])
+
+    def test_none_validator(self):
+        D = mi.bucket([10, 20, 11, 21], key=lambda x: x // 10, validator=None)
+        self.assertIn(1, D)
+        self.assertEqual(set(D), {1, 2})
+        self.assertEqual(list(D[1]), [10, 11])
+        self.assertEqual(list(D[2]), [20, 21])
+
