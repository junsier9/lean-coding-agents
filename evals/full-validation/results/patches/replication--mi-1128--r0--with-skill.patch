+    def test_slice_matches_range(self):
+        bounds = (None, -10, -5, -1, 0, 1, 5, 10)
+        steps = (None, -3, -2, -1, 1, 2, 3)
+        for args in [
+            (0, 10, 2),
+            (10, 0, -2),
+            (0, 9, 2),
+            (9, 0, -2),
+            (3, 4, 2),
+            (3, 2, -2),
+            (0, 0, 1),
+            (0, 0, -1),
+            (0, 10, -2),
+            (10, 0, 2),
+        ]:
+            r = mi.numeric_range(*args)
+            for start, stop, step in product(bounds, bounds, steps):
+                sl = slice(start, stop, step)
+                with self.subTest(args=args, sl=sl):
+                    expected = range(*args)[sl]
+                    actual = r[sl]
+                    self.assertIsInstance(actual, mi.numeric_range)
+                    self.assertEqual(list(expected), list(actual))
+                    self.assertEqual(len(expected), len(actual))
+
+    def test_slice_numeric_types(self):
+        for start, stop, step in [
+            (1.0, 9.0, 1.5),
+            (Decimal('1.0'), Decimal('9.0'), Decimal('1.5')),
+            (Fraction(1, 2), Fraction(5, 2), Fraction(1, 2)),
+            (datetime(2019, 3, 29), datetime(2019, 3, 30), timedelta(hours=5)),
+        ]:
+            for args in [(start, stop, step), (stop, start, -step)]:
+                r = mi.numeric_range(*args)
+                values = list(r)
+                for sl in [
+                    slice(None, None, -1),
+                    slice(None, None, -2),
+                    slice(-2, None, -1),
+                    slice(None, -1, -1),
+                    slice(-1, 0, -2),
+                    slice(10, -10, -1),
+                    slice(-10, 10, 2),
+                ]:
+                    with self.subTest(args=args, sl=sl):
+                        actual = r[sl]
+                        expected = values[sl]
+                        self.assertIsInstance(actual, mi.numeric_range)
+                        self.assertEqual(expected, list(actual))
+                        self.assertTrue(
+                            all(type(v) is type(values[0]) for v in actual)
+                        )
+
