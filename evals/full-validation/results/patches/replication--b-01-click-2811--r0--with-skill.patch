+@pytest.mark.parametrize(
+    ("help_option_names", "help_flag"),
+    [
+        (None, "--help"),
+        (["--man"], "--man"),
+        (["-h", "--help"], "-h"),
+        (["-h", "--help"], "--help"),
+    ],
+)
+@pytest.mark.parametrize("help_first", [True, False])
+def test_help_option_eager_order(runner, help_option_names, help_flag, help_first):
+    def eager_callback(ctx, param, value):
+        if value:
+            click.echo("eager callback")
+            ctx.exit()
+
+    @click.command(context_settings={"help_option_names": help_option_names})
+    @click.option(
+        "--eager",
+        is_flag=True,
+        is_eager=True,
+        expose_value=False,
+        callback=eager_callback,
+    )
+    def cli():
+        pytest.fail("The command callback should not run.")
+
+    args = [help_flag, "--eager"] if help_first else ["--eager", help_flag]
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0
+
+    if help_first:
+        assert result.output.startswith("Usage: cli [OPTIONS]\n")
+        assert "Show this message and exit." in result.output
+        assert "eager callback" not in result.output
+    else:
+        assert result.output == "eager callback\n"
+
+
+def test_help_option_context_names(runner):
+    @click.command()
+    def cli():
+        pytest.fail("The command callback should not run.")
+
+    for help_flag in ("--help", "--man", "-h", "--help"):
+        result = runner.invoke(cli, [help_flag], help_option_names=[help_flag])
+        assert result.exit_code == 0
+        assert "Show this message and exit." in result.output
+
+
