+@pytest.mark.parametrize("help_name", ["--help", "-h", "--custom-help", "/?"])
+@pytest.mark.parametrize("help_first", [True, False])
+@pytest.mark.parametrize("eager_exit", [True, False])
+def test_help_option_eager_order(runner, help_name, help_first, eager_exit):
+    called = []
+
+    def eager_callback(ctx, param, value):
+        if value:
+            called.append("eager")
+            if eager_exit:
+                ctx.exit()
+
+    @click.command(context_settings={"help_option_names": [help_name]})
+    @click.option(
+        "--eager",
+        is_flag=True,
+        is_eager=True,
+        expose_value=False,
+        callback=eager_callback,
+    )
+    def cli():
+        pytest.fail("The command should not run when help is requested.")
+
+    args = [help_name, "--eager"] if help_first else ["--eager", help_name]
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 0
+    assert called == ([] if help_first else ["eager"])
+    if help_first or not eager_exit:
+        assert result.output.startswith("Usage: cli [OPTIONS]\n")
+    else:
+        assert result.output == ""
+
+
+def test_help_option_names_context_changes(runner):
+    @click.command()
+    def cli():
+        click.echo("command")
+
+    for help_names in (["--help"], ["--custom-help", "-h"], ["/?"], ["--help"]):
+        for help_name in help_names:
+            result = runner.invoke(cli, [help_name], help_option_names=help_names)
+            assert result.exit_code == 0
+            assert result.output.startswith("Usage: cli [OPTIONS]\n")
+            for name in help_names:
+                assert name in result.output
+
+    result = runner.invoke(cli, ["--help"], help_option_names=[])
+    assert result.exit_code == 2
+    assert "No such option: --help" in result.output
+
+
