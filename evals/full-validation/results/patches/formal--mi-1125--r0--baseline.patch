+
+    def test_iterators_consumed_lazily(self):
+        left = iter('abc')
+        right = iter('def')
+        result = mi.partial_product(left, right)
+        self.assertEqual(next(result), ('a', 'd'))
+        self.assertEqual(list(left), ['b', 'c'])
+        self.assertEqual(list(right), ['e', 'f'])
+
+    def test_repeat_empty_iterator(self):
+        self.assertEqual(
+            list(mi.partial_product(iter('abc'), iter(''), repeat=2)), []
+        )
+
+    def test_repeat_single_item(self):
+        self.assertEqual(
+            list(mi.partial_product(iter('a'), iter('b'), repeat=2)),
+            [('a', 'b', 'a', 'b')],
+        )
