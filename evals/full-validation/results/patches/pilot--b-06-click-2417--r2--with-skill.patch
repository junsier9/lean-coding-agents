+def test_group_no_parens_command_class(runner):
+    class CustomCommand(click.Command):
+        def invoke(self, ctx):
+            click.echo("custom command")
+            return super().invoke(ctx)
+
+    class CustomGroup(click.Group):
+        command_class = CustomCommand
+
+    @click.group(cls=CustomGroup)
+    def grp():
+        click.echo("group")
+
+    @grp.command
+    @click.option("--name", default="world")
+    def say_hello(name):
+        click.echo(f"Hello, {name}!")
+
+    assert type(say_hello) is CustomCommand
+    assert grp.commands["say-hello"] is say_hello
+
+    result = runner.invoke(grp, ["say-hello", "--name", "Click"])
+    assert result.exception is None
+    assert result.output == "group\ncustom command\nHello, Click!\n"
+
+
+@pytest.mark.parametrize(
+    ("args", "kwargs"),
+    [((), {"help": "test"}), (("name",), {}), ((), {"cls": click.Command})],
+)
+def test_group_command_no_parens_rejects_arguments(args, kwargs):
+    class CustomGroup(click.Group):
+        command_class = click.Command
+
+    def callback():
+        pass
+
+    with pytest.raises(AssertionError, match="to provide arguments"):
+        CustomGroup().command(callback, *args, **kwargs)
+
+
