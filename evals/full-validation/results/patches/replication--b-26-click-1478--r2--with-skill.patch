index bad4f42..4b677ce 100644
--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -422,8 +422,48 @@ def test_multiline_help(runner):
 
     result = runner.invoke(cmd, ['--help'])
     assert result.exit_code == 0
-    out = result.output.splitlines()
-    assert '  --foo TEXT  hello  i am  multiline' in out
+    assert result.output.splitlines() == [
+        'Usage: cmd [OPTIONS]',
+        '',
+        'Options:',
+        '  --foo TEXT  hello',
+        ' ' * 14,
+        '              i am',
+        ' ' * 14,
+        '              multiline',
+        '  --help      Show this message and exit.',
+    ]
+
+
+@pytest.mark.parametrize('terminal_width, expected', [
+    (44, [
+        'This is a paragraph with an',
+        'early line break.',
+        '',
+        'Another paragraph with more',
+        'words to wrap.',
+    ]),
+    (60, [
+        'This is a paragraph with an early line break.',
+        '',
+        'Another paragraph with more words to wrap.',
+    ]),
+])
+def test_multiline_help_rewrapping(runner, terminal_width, expected):
+    @click.command()
+    @click.option('--foo', help='This is a paragraph\nwith an early line break.'
+                  '\n\nAnother paragraph with\nmore words to wrap.')
+    def cmd(foo):
+        pass
+
+    result = runner.invoke(cmd, ['--help'], terminal_width=terminal_width)
+    assert result.exit_code == 0
+    lines = result.output.splitlines()
+    assert lines[3] == '  --foo TEXT  ' + expected[0]
+    assert lines[4:-1] == [' ' * 14 + line for line in expected[1:]]
+    assert lines[-1] == '  --help      Show this message and exit.'
+    assert all(len(line) <= terminal_width for line in lines)
+
 
