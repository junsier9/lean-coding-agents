+@pytest.mark.parametrize("options_metavar", ["", None])
+@pytest.mark.parametrize("args, exit_code", [(["--help"], 0), ([], 2)])
+def test_formatting_usage_without_options_metavar(
+    runner, options_metavar, args, exit_code
+):
+    @click.command(options_metavar=options_metavar)
+    @click.argument("arg")
+    def cli(arg):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == exit_code
+    assert result.output.splitlines()[0] == "Usage: cli ARG"
+    if exit_code == 2:
+        assert result.output.splitlines()[-1] == "Error: Missing argument 'ARG'."
+
+
+@pytest.mark.parametrize("options_metavar", ["", None])
+@pytest.mark.parametrize("terminal_width", [30, 80])
+def test_formatting_usage_without_options_metavar_no_arguments(
+    runner, options_metavar, terminal_width
+):
+    @click.command(options_metavar=options_metavar)
+    def cli():
+        pass
+
+    result = runner.invoke(cli, ["--help"], terminal_width=terminal_width)
+    assert result.exit_code == 0
+    assert result.output.splitlines()[:3] == [
+        "Usage: cli",
+        "",
+        "Options:",
+    ]
+    assert "  --help  Show this message" in result.output
+
+
