@@ -320,6 +320,76 @@ def test_exit_not_standalone():
     assert cli.main([], "test_exit_not_standalone", standalone_mode=False) == 0
 
 
+@pytest.mark.parametrize("standalone_mode", [True, False])
+@pytest.mark.parametrize("exit_code", [0, 7])
+@pytest.mark.parametrize("exit_from_option", [True, False])
+def test_exit_closes_eager_resources(runner, standalone_mode, exit_code, exit_from_option):
+    active = []
+    events = []
+
+    @contextmanager
+    def resource(ctx):
+        assert not active
+        active.append("resource")
+        events.append("enter")
+        yield
+        assert click.get_current_context() is ctx
+        active.clear()
+        events.append("resource closed")
+
+    def acquire(ctx, param, value):
+        if not value:
+            return
+
+        ctx.obj = "resource owner"
+        ctx.with_resource(resource(ctx))
+
+        @ctx.call_on_close
+        def cleanup():
+            assert click.get_current_context() is ctx
+            assert ctx.obj == "resource owner"
+            assert active == ["resource"]
+            events.append("callback")
+
+    def exit_callback(ctx, param, value):
+        if value:
+            ctx.exit(exit_code)
+
+    @click.command()
+    @click.option(
+        "--resource", is_flag=True, is_eager=True, expose_value=False, callback=acquire
+    )
+    @click.option(
+        "--exit", is_flag=True, is_eager=True, expose_value=False, callback=exit_callback
+    )
+    @click.pass_context
+    def cli(ctx):
+        events.append("command")
+        ctx.exit(exit_code)
+
+    args = ["--resource"]
+    expected = ["enter"]
+    if exit_from_option:
+        args.append("--exit")
+    else:
+        expected.append("command")
+    expected.extend(["callback", "resource closed"])
+
+    previous_context = click.get_current_context(silent=True)
+    for invocation in range(1, 3):
+        result = runner.invoke(cli, args, standalone_mode=standalone_mode)
+        assert result.exit_code == (exit_code if standalone_mode else 0)
+        assert result.return_value == (None if standalone_mode else exit_code)
+        if standalone_mode and exit_code:
+            assert isinstance(result.exception, SystemExit)
+            assert result.exception.code == exit_code
+        else:
+            assert result.exception is None
+        assert events == expected * invocation
+        assert not active
+        assert click.get_current_context(silent=True) is previous_context
+
+
