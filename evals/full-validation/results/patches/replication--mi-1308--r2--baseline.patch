         self.assertNotIn(0, D._cache)  # Don't store non-valid entries
         self.assertEqual(list(D[0]), [])
 
+    def test_falsey_validator(self):
+        class CallableSet(set):
+            __call__ = set.__contains__
+
+        for operation, query, expected in (
+            ('getitem', lambda D: list(D[10]), []),
+            ('contains', lambda D: 10 in D, False),
+            ('iter', list, []),
+        ):
+            with self.subTest(operation=operation):
+                values = [10, 20, 11, 21]
+                iterable = iter(values)
+                D = mi.bucket(
+                    iterable,
+                    key=lambda x: 10 * (x // 10),
+                    validator=CallableSet(),
+                )
+                self.assertEqual(query(D), expected)
+                if operation != 'iter':
+                    self.assertEqual(list(iterable), values)
+
+    def test_falsey_validator_with_accepted_keys(self):
+        class Validator:
+            def __bool__(self):
+                return False
+
+            def __call__(self, value):
+                return value != 20
+
+        iterable = [10, 20, 30, 11, 21, 31]
+        D = mi.bucket(
+            iterable, key=lambda x: 10 * (x // 10), validator=Validator()
+        )
+        self.assertNotIn(20, D)
+        self.assertEqual(list(D[20]), [])
+        self.assertIn(10, D)
+        self.assertEqual(set(D), {10, 30})
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertEqual(list(D[30]), [30, 31])
+
+    def test_none_validator(self):
+        iterable = [10, 20, 11, 21]
+        D = mi.bucket(iterable, key=lambda x: 10 * (x // 10), validator=None)
+        self.assertIn(10, D)
+        self.assertEqual(set(D), {10, 20})
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertEqual(list(D[20]), [20, 21])
+
