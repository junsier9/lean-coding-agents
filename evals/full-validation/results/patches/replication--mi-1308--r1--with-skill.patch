@@ -1091,6 +1091,54 @@ class BucketTests(TestCase):
         self.assertNotIn(0, D._cache)  # Don't store non-valid entries
         self.assertEqual(list(D[0]), [])
 
+    def test_falsy_validator(self):
+        class CallableSet(set):
+            def __call__(self, value):
+                return value in self
+
+        values = [10, 20, 11, 21]
+        for query, expected, remaining in (
+            (lambda D: list(D[10]), [], values),
+            (lambda D: 10 in D, False, values),
+            (list, [], []),
+        ):
+            with self.subTest(query=query):
+                iterable = iter(values)
+                D = mi.bucket(
+                    iterable,
+                    key=lambda x: 10 * (x // 10),
+                    validator=CallableSet(),
+                )
+                self.assertEqual(query(D), expected)
+                self.assertEqual(list(iterable), remaining)
+
+    def test_falsy_validator_accepts_keys(self):
+        class Validator:
+            def __bool__(self):
+                return False
+
+            def __call__(self, value):
+                return value == 20
+
+        D = mi.bucket(
+            [10, 20, 11, 21],
+            key=lambda x: 10 * (x // 10),
+            validator=Validator(),
+        )
+        self.assertIn(20, D)
+        self.assertEqual(set(D), {20})
+        self.assertEqual(list(D[20]), [20, 21])
+        self.assertEqual(list(D[10]), [])
+
+    def test_none_validator(self):
+        D = mi.bucket(
+            [10, 20, 11], key=lambda x: 10 * (x // 10), validator=None
+        )
+        self.assertIn(10, D)
+        self.assertEqual(set(D), {10, 20})
+        self.assertEqual(list(D[10]), [10, 11])
+        self.assertEqual(list(D[20]), [20])
+
