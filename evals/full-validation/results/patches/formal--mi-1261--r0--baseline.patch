 class CombinationWithReplacementIndexTests(TestCase):
+    def test_none(self):
+        self.assertEqual(
+            mi.combination_with_replacement_index((None,), [1, None, 2]),
+            1,
+        )
+
+    def test_exhaustive_with_iterators(self):
+        values = (None, 0, 1)
+        for n in range(4):
+            for pool in product(values, repeat=n):
+                for r in range(4):
+                    first_index = {}
+                    for index, element in enumerate(
+                        combinations_with_replacement(pool, r)
+                    ):
+                        first_index.setdefault(element, index)
+
+                    for element in product(values, repeat=r):
+                        with self.subTest(pool=pool, element=element):
+                            if element in first_index:
+                                self.assertEqual(
+                                    mi.combination_with_replacement_index(
+                                        iter(element), iter(pool)
+                                    ),
+                                    first_index[element],
+                                )
+                            else:
+                                with self.assertRaises(ValueError):
+                                    mi.combination_with_replacement_index(
+                                        iter(element), iter(pool)
+                                    )
+
+    def test_invalid_none(self):
+        cases = [
+            ((None,), []),
+            ((None,), [1, 2]),
+            ((1, None), [1, 2]),
+            ((1, None, 2), [1, 2]),
+            ((None, 1), [1, None]),
+            ((1, None, 1), [1, None, 2]),
+            ((None, 3), [None, 1, 2]),
+        ]
+        for element, pool in cases:
+            with self.subTest(element=element, pool=pool):
+                with self.assertRaises(ValueError):
+                    mi.combination_with_replacement_index(element, pool)
+
+    def test_empty_element_does_not_consume_iterable(self):
+        pool = iter([1, None, 2])
+        self.assertEqual(
+            mi.combination_with_replacement_index(iter(()), pool), 0
+        )
+        self.assertEqual(list(pool), [1, None, 2])
+
     def test_r_less_than_n(self):
