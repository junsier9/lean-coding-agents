+    def test_maxlen_zero_peek(self):
+        iterable = [10, 20, 30]
+        s = mi.seekable(iterable, maxlen=0)
+        elements = s.elements()
+        self.assertEqual(s.peek(), 10)
+        self.assertEqual(s.peek(), 10)
+        self.assertEqual(list(elements), [])
+        self.assertEqual(list(s), iterable)
+        self.assertEqual(list(elements), [])
+
+    def test_maxlen_zero_truthiness(self):
+        iterable = [10, 20, 30]
+        s = mi.seekable(iterable, maxlen=0)
+        self.assertTrue(s)
+        self.assertTrue(s)
+        self.assertEqual(list(s.elements()), [])
+        self.assertEqual(list(s), iterable)
+        self.assertFalse(s)
+        self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_observe_and_next(self):
+        iterable = [None, 0, False, [], object()]
+        s = mi.seekable(iterable, maxlen=0)
+        elements = s.elements()
+        for item in iterable:
+            self.assertIs(s.peek(), item)
+            self.assertTrue(s)
+            self.assertIs(s.peek(), item)
+            self.assertIs(next(s), item)
+            self.assertEqual(list(elements), [])
+        self.assertFalse(s)
+        self.assertRaises(StopIteration, s.peek)
+        self.assertRaises(StopIteration, next, s)
+
+    def test_maxlen_zero_empty(self):
+        s = mi.seekable([], maxlen=0)
+        default = object()
+        for _ in range(2):
+            self.assertFalse(s)
+            self.assertIs(s.peek(default), default)
+            self.assertRaises(StopIteration, s.peek)
+            self.assertRaises(StopIteration, next, s)
+        self.assertEqual(list(s), [])
+        self.assertEqual(list(s.elements()), [])
+
+    def test_maxlen_zero_seek_after_peek(self):
+        iterable = [10, 20, 30]
+        for method, index in product(('seek', 'relative_seek'), (0, 1, 10)):
+            with self.subTest(method=method, index=index):
+                s = mi.seekable(iterable, maxlen=0)
+                self.assertEqual(s.peek(), 10)
+                getattr(s, method)(index)
+                self.assertEqual(list(s), iterable[index:])
+                self.assertEqual(list(s.elements()), [])
+
