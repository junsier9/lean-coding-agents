+@pytest.mark.parametrize('make_empty', [dict, list, tuple,
+                                       lambda: iter(()),
+                                       lambda: (item for item in ())],
+                         ids=['dict', 'list', 'tuple', 'iterator', 'generator'])
+@pytest.mark.parametrize('initial', [{}, {'a': 1, 'b': 2}])
+def test_one_to_one_update_empty(make_empty, initial):
+    oto = OneToOne(initial)
+    inverse = oto.inv
+    expected_inverse = {val: key for key, val in initial.items()}
+
+    assert oto.update(make_empty()) is None
+    assert oto == initial
+    assert oto.inv == expected_inverse
+    assert oto.inv is inverse
+    assert inverse.inv is oto
+
+    assert oto.update({'c': 3}) is None
+    assert oto.update([('d', 4)]) is None
+    expected = dict(initial, c=3, d=4)
+    assert oto == expected
+    assert oto.inv == {val: key for key, val in expected.items()}
+
+
+@pytest.mark.parametrize('make_empty', [dict, list, tuple,
+                                       lambda: iter(()),
+                                       lambda: (item for item in ())],
+                         ids=['dict', 'list', 'tuple', 'iterator', 'generator'])
+def test_one_to_one_update_empty_with_keywords(make_empty):
+    oto = OneToOne({'a': 1, 'b': 2})
+
+    assert oto.update(make_empty(), a=2, c=3) is None
+    assert oto == {'a': 2, 'c': 3}
+    assert oto.inv == {2: 'a', 3: 'c'}
+    assert oto.inv.inv is oto
+
+
+@pytest.mark.parametrize('make_items', [list, tuple, iter])
+def test_one_to_one_update_iterable(make_items):
+    oto = OneToOne({'a': 1, 'b': 2})
+
+    assert oto.update(make_items([('a', 2), ('c', 3)]), c=4) is None
+    assert oto == {'a': 2, 'c': 4}
+    assert oto.inv == {2: 'a', 4: 'c'}
+
+
+@pytest.mark.parametrize('make_items', [dict, list, iter])
+def test_one_to_one_update_unhashable_value(make_items):
+    oto = OneToOne({'a': 1})
+
+    with pytest.raises(TypeError):
+        oto.update(make_items([('b', 2), ('c', [])]))
+    assert oto == {'a': 1}
+    assert oto.inv == {1: 'a'}
+
+    with pytest.raises(TypeError):
+        oto.update(make_items([]), b=[])
+    assert oto == {'a': 1}
+    assert oto.inv == {1: 'a'}
+
