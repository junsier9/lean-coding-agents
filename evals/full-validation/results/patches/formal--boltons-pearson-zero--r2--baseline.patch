+@pytest.mark.parametrize('precision', [0, 6])
+@pytest.mark.parametrize('skewness, kurtosis, expected', [
+    pytest.param(1.0, 6.0, 4, id='type-iv'),
+    pytest.param(1.5, 54.0 / 7, 5, id='type-v'),
+    pytest.param(2.0, 10.0, 6, id='type-vi'),
+    pytest.param(2.0, 3.0, 6, id='zero-denominator'),
+    pytest.param(-2.0, 3.0, 6, id='zero-denominator-negative-skew'),
+    pytest.param(0.0, 3.0, 0, id='normal-before-gamma'),
+    pytest.param(2.0, 9.0, 3, id='gamma-before-kappa'),
+    pytest.param(1.0, 3.0, 1, id='beta'),
+    pytest.param(0.0, 2.0, 2, id='symmetric-beta'),
+    pytest.param(0.0, 5.0, 7, id='type-vii'),
+    pytest.param(0.0, 0.0, 2, id='symmetric-zero-denominator'),
+])
+def test_pearson_type_exact_moments(skewness, kurtosis, expected, precision):
+    # Seed the moment cache to exercise exact boundaries without sampling noise.
+    stats = Stats([0.0])
+    stats._skewness = skewness
+    stats._kurtosis = kurtosis
+    stats._pearson_precision = precision
+    assert stats.pearson_type == expected
+
+
 def test_mode():
