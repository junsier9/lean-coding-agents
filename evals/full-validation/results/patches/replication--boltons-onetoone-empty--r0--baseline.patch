     return
 
 
+@pytest.mark.parametrize('make_items', [dict, list, tuple, iter,
+                                      lambda items: (item for item in items)],
+                         ids=['dict', 'list', 'tuple', 'iterator', 'generator'])
+@pytest.mark.parametrize('initial', [{}, {'a': 1, 'b': 2}])
+def test_one_to_one_update_empty(make_items, initial):
+    oto = OneToOne(initial)
+    inverse = oto.inv
+
+    assert oto.update(make_items(())) is None
+    assert inverse.update(make_items(())) is None
+    assert oto == initial
+    assert inverse == {value: key for key, value in initial.items()}
+    assert oto.inv is inverse
+    assert inverse.inv is oto
+
+    # Later updates must still replace old keys and conflicting values.
+    assert oto.update([('a', 3), ('c', 2)]) is None
+    assert oto == {'a': 3, 'c': 2}
+    assert inverse == {3: 'a', 2: 'c'}
+
+    # Empty positional input must not prevent keyword updates.
+    assert oto.update(make_items(()), a=4, d=2) is None
+    assert oto == {'a': 4, 'd': 2}
+    assert inverse == {4: 'a', 2: 'd'}
+    assert oto.inv is inverse
+    assert inverse.inv is oto
+
+
+@pytest.mark.parametrize('make_items', [list, tuple, iter,
+                                      lambda items: (item for item in items)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+def test_one_to_one_update_iterable(make_items):
+    oto = OneToOne({'a': 1, 'b': 2})
+    inverse = oto.inv
+
+    assert oto.update(make_items([('a', 3), ('c', 2)]), c=4, d=5) is None
+    assert oto == {'a': 3, 'c': 4, 'd': 5}
+    assert inverse == {3: 'a', 4: 'c', 5: 'd'}
+    assert inverse.inv is oto
+
