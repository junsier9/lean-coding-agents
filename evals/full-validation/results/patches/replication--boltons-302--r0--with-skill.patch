 from datetime import timedelta, date
+from itertools import islice
+
+import pytest
+
 from boltons.timeutils import total_seconds, daterange
 
 
@@ -62,6 +66,30 @@ def test_daterange_years_step():
     assert dates == expected
 
 
+@pytest.mark.parametrize('inclusive', [False, True])
+@pytest.mark.parametrize('step', [1, -1, timedelta(days=1), timedelta(days=-1),
+                                 (1, 0, 0), (-1, 0, 0),
+                                 (0, 1, 0), (0, -1, 0), 0])
+def test_daterange_equal_endpoints(step, inclusive):
+    day = date(2017, 5, 1)
+    dates = daterange(day, day, step=step, inclusive=inclusive)
+
+    assert list(islice(dates, 2)) == ([day] if inclusive else [])
+
+
+@pytest.mark.parametrize('inclusive', [False, True])
+@pytest.mark.parametrize('step', [1, -1, 2, -2])
+def test_daterange_days(step, inclusive):
+    start = date(2017, 5, 1) if step > 0 else date(2017, 5, 4)
+    stop = date(2017, 5, 4) if step > 0 else date(2017, 5, 1)
+    offsets = list(range(0, 3 if step > 0 else -3, step))
+    expected = [start + timedelta(days=offset) for offset in offsets]
+    if inclusive and abs(step) == 1:
+        expected.append(stop)
+
+    assert list(daterange(start, stop, step=step, inclusive=inclusive)) == expected
+
+
