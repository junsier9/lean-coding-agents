+    def test_reversed_datetime_boundaries(self):
+        for start, step in [
+            (datetime.min, timedelta(days=1)),
+            (datetime.max, timedelta(days=-1)),
+        ]:
+            for size in (0, 1, 3):
+                with self.subTest(start=start, step=step, size=size):
+                    r = mi.numeric_range(start, start + size * step, step)
+                    self.assertEqual(list(r)[::-1], list(reversed(r)))
+
+    def test_reversed_large_range(self):
