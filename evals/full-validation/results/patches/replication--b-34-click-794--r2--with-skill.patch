--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -7,6 +7,33 @@ import pytest
 from click._compat import text_type
 
 
+@pytest.mark.parametrize('param_decls, expected_name', [
+    (['--first-name', '--second'], 'first_name'),
+    (['--second', '--first-name'], 'second'),
+    (['-f', '--first-name', '--second'], 'first_name'),
+    (['--first-name', '-f', '--second'], 'first_name'),
+    (['--first-name', '--second', '-f'], 'first_name'),
+    (['-f', '--second', '--first-name'], 'second'),
+    (['-f', '-s'], 'f'),
+    (['-s', '-f'], 's'),
+    (['--Camel-Case', '--alias'], 'camel_case'),
+    (['destination', '-f', '--first-name', '--second'], 'destination'),
+    (['-f', '--first-name', '--second', 'destination'], 'destination'),
+])
+def test_option_name_inference(runner, param_decls, expected_name):
+    @click.command()
+    @click.option(*param_decls)
+    def cli(**params):
+        assert params == {expected_name: 'value'}
+        click.echo(params[expected_name])
+
+    for alias in cli.params[0].opts:
+        result = runner.invoke(cli, [alias, 'value'])
+        assert not result.exception
+        assert result.exit_code == 0
+        assert result.output == 'value\n'
+
+
