+@pytest.mark.parametrize('data, expected', [
+    ([0, 1, 1, 1, 2, 2, 2, 2, 2, 4], 5),
+    ([0] * 6 + [1] * 20 + [4], 6),
+])
+def test_pearson_type_v_and_vi(data, expected):
+    assert Stats(data).pearson_type == expected
+
+
+@pytest.mark.parametrize('skewness, kurtosis, expected', [
+    (2.0, 3.0, 6),  # c0 == 0
+    (-2.0, 3.0, 6),
+    (0.0, 3.0, 0),  # c1 == c2 == 0: Normal takes priority
+    (2.0, 9.0, 3),  # c2 == 0: Gamma takes priority
+    (0.01, 3.0, 0),  # Preserve rounded Normal and Gamma boundaries
+    (2.0, 9.1, 3),
+])
+def test_pearson_type_moment_boundaries(skewness, kurtosis, expected):
+    stats = Stats([0])
+    # Set cached moments directly to exercise exact classification boundaries.
+    stats._skewness = skewness
+    stats._kurtosis = kurtosis
+    assert stats.pearson_type == expected
+
+
 def test_mode():
