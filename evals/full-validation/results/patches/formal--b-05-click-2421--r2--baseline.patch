+@pytest.mark.parametrize("name", [None, "other", ""])
+def test_add_completion_class(monkeypatch, name):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    class CustomComplete(ShellComplete):
+        name = "custom"
+
+    assert add_completion_class(CustomComplete, name) is CustomComplete
+    assert get_completion_class("custom" if name is None else name) is CustomComplete
+    assert CustomComplete.name == "custom"
+
+    if name is not None:
+        assert get_completion_class("custom") is None
+
+
+def test_add_completion_class_decorator(monkeypatch):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    @add_completion_class
+    class CustomComplete(ShellComplete):
+        name = "custom"
+        source_template = "custom %(prog_name)s"
+
+    assert CustomComplete is not None
+    assert get_completion_class("custom") is CustomComplete
+    comp = CustomComplete(Command("cli"), {}, "cli", "_CLI_COMPLETE")
+    assert comp.source() == "custom cli"
+
+    class DerivedComplete(CustomComplete):
+        pass
+
+    assert issubclass(DerivedComplete, ShellComplete)
+
+
 def test_command():
     cli = Command("cli", params=[Option(["-t", "--test"])])
     assert _get_words(cli, [], "") == []
