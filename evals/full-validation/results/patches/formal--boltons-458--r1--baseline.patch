diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index d4f17a6..84dd555 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -1,3 +1,5 @@
+import importlib.util
+
 import pytest
 
 from boltons import urlutils
@@ -112,6 +114,59 @@ def test_query_param_dict_eq_with_dict():
     assert not (qpd == {'a': '999', 'b': '2'})
 
 
+@pytest.fixture(scope='module', params=['package', 'standalone'])
+def urlutils_module(request):
+    if request.param == 'package':
+        return urlutils
+    # Loading without a package exercises the embedded OrderedMultiDict.
+    spec = importlib.util.spec_from_file_location('standalone_urlutils', urlutils.__file__)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+def test_query_param_addlist_iterables(urlutils_module, make_values):
+    url = urlutils_module.URL('https://example.com/?a=0&b=keep&a=1')
+    qp = url.query_params
+    qp.addlist('a', make_values(['2', '3']))
+    qp.addlist('c', make_values(['4', '5']))
+
+    assert qp.getlist('a') == ['0', '1', '2', '3']
+    assert qp.getlist('c') == ['4', '5']
+    assert qp.get('a') == qp['a'] == '3'
+    assert qp.get('c') == qp['c'] == '5'
+    assert qp.keys() == list(qp.viewkeys()) == ['a', 'b', 'c']
+    assert len(qp) == 3
+    text = 'a=0&b=keep&a=1&a=2&a=3&c=4&c=5'
+    assert qp.to_text() == text
+    assert url.to_text() == 'https://example.com/?' + text
+    assert urlutils_module.QueryParamDict.from_text(text) == qp
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda v: (x for x in v)],
+                         ids=['iterator', 'generator'])
+def test_query_param_addlist_empty_iterables(urlutils_module, make_values):
+    qp = urlutils_module.QueryParamDict()
+    qp.addlist('missing', make_values([]))
+    assert len(qp) == 0
+    assert qp.keys() == list(qp.viewkeys()) == []
+    assert 'missing' not in qp
+    assert qp.get('missing', 'default') == 'default'
+    assert qp.to_text() == ''
+
+    qp.add('a', '0')
+    qp.addlist('a', make_values([]))
+    qp.addlist('missing', make_values([]))
+    assert len(qp) == 1
+    assert qp.keys() == ['a']
+    assert qp.getlist('a') == ['0']
+    assert qp.get('a') == '0'
+    assert 'missing' not in qp
+    assert qp.to_text() == 'a=0'
+
+
 def test_iri_query():
