@@ -2,6 +2,7 @@ import sys
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.dictutils import FastIterOrderedMultiDict
 
 
 _ITEMSETS = [[],
@@ -270,6 +271,52 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [list, tuple, iter, lambda v: (x for x in v)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+def test_addlist_iterables(omd_type, make_values):
+    omd = omd_type([('a', 0), ('b', 9)])
+    omd.addlist('a', make_values([1, 2, 1]))
+    omd.addlist('c', make_values([3, 4]))
+
+    assert omd.items(multi=True) == [('a', 0), ('b', 9), ('a', 1),
+                                     ('a', 2), ('a', 1), ('c', 3), ('c', 4)]
+    assert omd.keys() == list(omd.viewkeys()) == ['a', 'b', 'c']
+    assert len(omd) == 3
+    assert omd.getlist('a') == [0, 1, 2, 1]
+    assert omd.getlist('c') == [3, 4]
+    assert omd.get('a') == omd['a'] == 1
+    assert omd.get('c') == omd['c'] == 4
+    assert omd.todict(multi=True) == {'a': [0, 1, 2, 1], 'b': [9], 'c': [3, 4]}
+
+    assert omd.poplast('a') == 1
+    assert omd.getlist('a') == [0, 1, 2]
+    assert omd.popall('c') == [3, 4]
+    assert omd.items(multi=True) == [('a', 0), ('b', 9), ('a', 1), ('a', 2)]
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [list, tuple, iter, lambda v: (x for x in v)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+@pytest.mark.parametrize('items', [[], [('a', 0), ('b', 9)]])
+def test_addlist_empty_iterables(omd_type, make_values, items):
+    omd = omd_type(items)
+    omd.addlist('a', make_values([]))
+    omd.addlist('missing', make_values([]))
+
+    assert omd.items(multi=True) == items
+    assert omd.keys() == list(omd.viewkeys()) == [k for k, v in items]
+    assert len(omd) == len(items)
+    assert ('a' in omd) == bool(items)
+    assert omd.getlist('a') == ([0] if items else [])
+    assert omd.get('a', 'default') == (0 if items else 'default')
+    assert 'missing' not in omd
+    assert omd.getlist('missing') == []
+    assert omd.get('missing', 'default') == 'default'
+    with pytest.raises(KeyError):
+        omd['missing']
+
+
