+@pytest.mark.parametrize("name", [None, "custom", ""])
+def test_add_completion_class(monkeypatch, name):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    class CustomComplete(ShellComplete):
+        name = "custom-shell"
+
+    assert add_completion_class(CustomComplete, name) is CustomComplete
+    assert CustomComplete.name == "custom-shell"
+
+    if name is None:
+        assert get_completion_class("custom-shell") is CustomComplete
+    else:
+        assert get_completion_class(name) is CustomComplete
+        assert get_completion_class("custom-shell") is None
+
+
+def test_add_completion_class_decorator(monkeypatch, runner):
+    monkeypatch.setattr("click.shell_completion._available_shells", {})
+
+    @add_completion_class
+    class CustomComplete(ShellComplete):
+        name = "custom-shell"
+        source_template = "source for %(prog_name)s"
+
+    assert issubclass(CustomComplete, ShellComplete)
+    assert get_completion_class("custom-shell") is CustomComplete
+    comp = CustomComplete(Command("cli"), {}, "cli", "_CLI_COMPLETE")
+    assert comp.source() == "source for cli"
+
+    result = runner.invoke(Command("cli"), env={"_CLI_COMPLETE": "custom-shell_source"})
+    assert result.exit_code == 0
+    assert result.output == "source for cli\n"
+
+
