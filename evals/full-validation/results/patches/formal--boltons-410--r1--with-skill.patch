+@pytest.mark.parametrize('copier', [copy.copy, copy.deepcopy])
+@pytest.mark.parametrize('itemset', _ITEMSETS)
+def test_standard_copy(copier, itemset):
+    omd = OMD(itemset)
+    copied = copier(omd)
+
+    assert copied is not omd
+    assert type(copied) is type(omd)
+    assert copied.items(multi=True) == itemset
+    for key in omd:
+        assert copied.getlist(key) == omd.getlist(key)
+
+    copied.add('a', 99)
+    assert omd.items(multi=True) == itemset
+
+
+def test_standard_copy_shallow_values():
+    first = {'nested': [1]}
+    last = {'nested': [2]}
+    omd = OMD([('a', first), ('b', first), ('a', last)])
+    copied = copy.copy(omd)
+
+    assert copied.getlist('a')[0] is first
+    assert copied['b'] is first
+    assert copied['a'] is last
+    assert copied.poplast('a') is last
+    assert omd.getlist('a') == [first, last]
+    copied['a']['nested'].append(3)
+    assert first['nested'] == [1, 3]
+
+
+def test_deepcopy_nested_values():
+    first = {'nested': [1]}
+    shared = {'nested': [2]}
+    omd = OMD([('a', first), ('b', shared), ('a', shared)])
+    copied = copy.deepcopy(omd)
+
+    assert copied.items(multi=True) == omd.items(multi=True)
+    assert copied['a'] is copied['b']
+    assert copied['a'] is not shared
+    for value in copied.getlist('a'):
+        value['nested'].append(3)
+    assert first['nested'] == [1]
+    assert shared['nested'] == [2]
+    assert copied.getlist('a') == [{'nested': [1, 3]}, {'nested': [2, 3]}]
+
+
+def test_deepcopy_recursive_values():
+    omd = OMD([('a', 1)])
+    omd.add('self', omd)
+    omd.add('a', [omd])
+    copied = copy.deepcopy(omd)
+
+    assert copied is not omd
+    assert copied['self'] is copied
+    assert copied.getlist('a')[0] == 1
+    assert copied['a'][0] is copied
+    assert copied['a'] is not omd['a']
+
