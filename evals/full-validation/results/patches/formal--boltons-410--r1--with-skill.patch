+def test_omd_pickle_protocols():
+    import pickle
+
+    for protocol in range(pickle.HIGHEST_PROTOCOL + 1):
+        for itemset in _ITEMSETS[1:] + [[('a', [1]), ('b', [2]), ('a', [3])]]:
+            omd = OMD(itemset)
+            restored = pickle.loads(pickle.dumps(omd, protocol=protocol))
+            assert type(restored) is type(omd)
+            assert restored.items(multi=True) == itemset
+            for key in omd:
+                assert restored.getlist(key) == omd.getlist(key)
+
 
