+def test_progressbar_hidden_update(tmp_path):
+    path = tmp_path / "progress.txt"
+
+    with path.open("w", encoding="utf-8") as file:
+        with click.progressbar(
+            length=4, label=click.style("Starting", fg="green"), file=file, width=0
+        ) as progress:
+            assert path.read_text(encoding="utf-8") == "Starting\n"
+            progress.update(1)
+            progress.update(1)
+            progress.label = "Finishing"
+            progress.update(1)
+            progress.update(1)
+
+    assert path.read_text(encoding="utf-8") == "Starting\nFinishing\n"
 
 
