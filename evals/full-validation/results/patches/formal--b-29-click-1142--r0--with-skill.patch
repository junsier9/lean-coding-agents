+@pytest.mark.parametrize("label", [None, "", "    padded line"])
+def test_progressbar_hidden_empty(runner, label):
+    @click.command()
+    def cli():
+        with click.progressbar([], label=label) as progress:
+            assert list(progress) == []
+
+    result = runner.invoke(cli)
+    assert result.exception is None
+    assert result.output == f"{label or ''}\n"
+
