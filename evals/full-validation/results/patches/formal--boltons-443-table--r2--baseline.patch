diff --git a/tests/test_tableutils.py b/tests/test_tableutils.py
index 4524386..d46d71b 100644
--- a/tests/test_tableutils.py
+++ b/tests/test_tableutils.py
@@ -1,3 +1,5 @@
+import pytest
+
 from boltons.tableutils import Table
 
 
@@ -52,3 +54,66 @@ def test_table_obj():
     t4 = Table.from_object(TestType())
     assert len(t4) == 1
     assert 'greeting' in t4.headers
+
+
+@pytest.mark.parametrize('data', [[], [[]]])
+@pytest.mark.parametrize('with_headers', [False, True])
+def test_table_text_empty(data, with_headers):
+    assert Table(data).to_text(with_headers=with_headers) == ''
+
+
+@pytest.mark.parametrize('headers', [None, []])
+@pytest.mark.parametrize('with_headers', [False, True])
+def test_table_text_without_headers(headers, with_headers):
+    table = Table([[1, 2], [3, 4]], headers=headers)
+    assert table.to_text(with_headers=with_headers) == '1 | 2\n3 | 4'
+    assert table.headers == []
+
+
+@pytest.mark.parametrize('header', [None, 42])
+def test_table_text_non_string_header(header):
+    text = str(header)
+    table = Table([[header]], headers=[header])
+    assert table.to_text() == '\n'.join([text, '-' * len(text), text])
+
+
+@pytest.mark.parametrize('maxlen, expected', [
+    (None, 'None | None\n-----|-----\nNone | None'),
+    (3, '... | ...\n----|----\n... | ...'),
+])
+def test_table_text_short_headers(maxlen, expected):
+    table = Table([[None, None]], headers=[None])
+    assert table.to_text(maxlen=maxlen) == expected
+    assert table.headers == [None]
+
+
+def test_table_text_shortened_headers():
+    table = Table([[1, 2]], headers=['a', 'b'])
+    table.headers.pop()
+    assert table.to_text() == 'a | None\n--|-----\n1 |  2  '
+    assert table.headers == ['a']
+
+
+def test_table_text_short_headers_with_ragged_data():
+    table = Table([[1, 2], [3]], headers=['a'])
+    original_data = [list(row) for row in table]
+    assert table.to_text() == 'a | None\n--|-----\n1 |  2  \n3 | None'
+    assert table.to_text(with_headers=False) == '1 |  2  \n3 | None'
+    assert list(table) == original_data
+    assert table.headers == ['a']
+
+
+def test_table_text_header_maxlen():
+    table = Table([['long value']], headers=['long header'])
+    assert table.to_text(maxlen=6) == 'lon...\n------\nlon...'
+
+
+def test_table_text_headers_only():
+    table = Table(headers=['name', None])
+    assert table.to_text() == 'name | None\n-----|-----'
+    assert table.to_text(with_headers=False) == ''
+
+
+def test_table_text_hidden_headers():
+    table = Table([[1, 2]], headers=['long header', None])
+    assert table.to_text(with_headers=False) == '1 | 2'
