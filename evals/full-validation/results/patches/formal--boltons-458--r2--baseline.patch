diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index d4f17a6..06b506c 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -112,6 +112,38 @@ def test_query_param_dict_eq_with_dict():
     assert not (qpd == {'a': '999', 'b': '2'})
 
 
+@pytest.fixture(scope='module', params=['package', 'standalone'])
+def query_param_dict_type(request):
+    if request.param == 'package':
+        return QueryParamDict
+    # Loading without a package exercises urlutils' embedded OrderedMultiDict.
+    import runpy
+    return runpy.run_path(urlutils.__file__)['QueryParamDict']
+
+
+@pytest.mark.parametrize('make_values', [iter, lambda xs: (x for x in xs)],
+                         ids=['iterator', 'generator'])
+def test_query_param_dict_addlist_iterables(query_param_dict_type, make_values):
+    qpd = query_param_dict_type.from_text('tag=old&keep=x')
+    qpd.addlist('tag', make_values(['new value', 'new&value']))
+    qpd.addlist('extra', make_values(['', 'tail']))
+    qpd.addlist('missing', make_values([]))
+    qpd.addlist('tag', make_values([]))
+
+    assert qpd.getlist('tag') == ['old', 'new value', 'new&value']
+    assert qpd['tag'] == qpd.get('tag') == 'new&value'
+    assert qpd.getlist('extra') == ['', 'tail']
+    assert 'missing' not in qpd
+    assert qpd.get('missing', 'default') == 'default'
+    assert len(qpd) == len(qpd.keys()) == 3
+    assert list(qpd.viewkeys()) == ['tag', 'keep', 'extra']
+    assert qpd.to_text(full_quote=True) == (
+        'tag=old&keep=x&tag=new%20value&tag=new%26value&extra=&extra=tail')
+    roundtripped = query_param_dict_type.from_text(qpd.to_text(full_quote=True))
+    assert roundtripped.getlist('tag') == ['old', 'new value', 'new&value']
+    assert roundtripped.getlist('extra') == [None, 'tail']
+
+
 def test_iri_query():
     url = URL('http://minerals.mountain.ore/?rock=\N{SHAMROCK}')
     assert url.query_params['rock'] == '\N{SHAMROCK}'
