 import sys
 import pytest
 
-from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.dictutils import (OMD, FastIterOrderedMultiDict, OneToOne,
+                               ManyToMany, FrozenDict, subdict, FrozenHashError)
 
 
 _ITEMSETS = [[],
@@ -270,6 +271,64 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [list, tuple, iter, lambda xs: (x for x in xs)],
+                         ids=['list', 'tuple', 'iterator', 'generator'])
+def test_addlist_iterables(omd_type, make_values):
+    omd = omd_type([('a', 0), ('b', 9)])
+    omd.addlist('c', make_values([3, 4]))
+    omd.addlist('a', make_values([1, 2, 2]))
+
+    expected = [('a', 0), ('b', 9), ('c', 3), ('c', 4),
+                ('a', 1), ('a', 2), ('a', 2)]
+    assert omd.items(multi=True) == expected
+    assert repr(omd) == f'{omd_type.__name__}({expected!r})'
+    assert len(omd) == len(omd.keys()) == 3
+    assert list(omd.viewkeys()) == ['a', 'b', 'c']
+    assert omd.getlist('c') == [3, 4]
+    assert omd.getlist('a') == [0, 1, 2, 2]
+    assert omd['a'] == omd.get('a') == 2
+    assert omd.poplast('a') == 2
+    assert omd.getlist('a') == [0, 1, 2]
+    assert omd.popall('c') == [3, 4]
+    assert omd.items(multi=True) == [('a', 0), ('b', 9), ('a', 1), ('a', 2)]
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('make_values', [iter, lambda xs: (x for x in xs)],
+                         ids=['iterator', 'generator'])
+def test_addlist_empty_iterables(omd_type, make_values):
+    omd = omd_type()
+    omd.addlist('missing', make_values([]))
+    assert not omd
+    assert len(omd) == len(omd.keys()) == len(omd.viewkeys()) == 0
+    assert omd.items(multi=True) == []
+    assert 'missing' not in omd
+    assert omd.get('missing', 'default') == 'default'
+    assert omd.getlist('missing', 'default') == 'default'
+
+    omd.add('a', 1)
+    omd.addlist('a', make_values([]))
+    assert omd.items(multi=True) == [('a', 1)]
+    assert omd.getlist('a') == [1]
+    assert len(omd) == 1
+
+
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('key', ['a', 'missing'])
+def test_addlist_failing_iterator(omd_type, key):
+    def failing_values():
+        yield 1
+        raise ValueError('cannot finish iteration')
+
+    omd = omd_type([('a', 0), ('b', 9)])
+    with pytest.raises(ValueError, match='cannot finish iteration'):
+        omd.addlist(key, failing_values())
+    assert omd.items(multi=True) == [('a', 0), ('b', 9)]
+    assert omd.todict(multi=True) == {'a': [0], 'b': [9]}
+    assert len(omd) == 2
+
+
