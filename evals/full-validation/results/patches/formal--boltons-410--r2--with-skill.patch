+@pytest.mark.parametrize('protocol', range(pickle.HIGHEST_PROTOCOL + 1))
+@pytest.mark.parametrize('itemset', _ITEMSETS)
+def test_omd_pickle_protocols(protocol, itemset):
+    omd = OMD(itemset)
+    roundtripped = pickle.loads(pickle.dumps(omd, protocol=protocol))
+
+    assert type(roundtripped) is type(omd)
+    assert roundtripped.items(multi=True) == itemset
+    for key in omd:
+        assert roundtripped.getlist(key) == omd.getlist(key)
+
