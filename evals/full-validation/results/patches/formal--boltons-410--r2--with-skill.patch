+@pytest.mark.parametrize('copy_func', [copy.copy, copy.deepcopy])
+@pytest.mark.parametrize('itemset', _ITEMSETS)
+def test_copy_module(copy_func, itemset):
+    omd = OMD(itemset)
+    copied = copy_func(omd)
+
+    assert copied is not omd
+    assert type(copied) is type(omd)
+    assert copied.items(multi=True) == itemset
+    for key in omd:
+        assert copied.getlist(key) == omd.getlist(key)
+
+
+def test_shallow_copy_values():
+    items = [('a', {'nested': [1]}), ('b', []), ('a', {'nested': [2]})]
+    omd = OMD(items)
+    copied = copy.copy(omd)
+
+    assert copied.items(multi=True) == items
+    for (_, original), (_, value) in zip(items, copied.items(multi=True)):
+        assert value is original
+    copied.poplast('a')
+    copied.add('b', [3])
+    assert omd.items(multi=True) == items
+
+
+def test_deepcopy_values():
+    shared = {'nested': [1]}
+    items = [('a', shared), ('b', shared), ('a', {'nested': [2]})]
+    omd = OMD(items)
+    copied = copy.deepcopy(omd)
+
+    assert copied.items(multi=True) == items
+    assert copied.getlist('a')[0] is copied['b']
+    for (_, original), (_, value) in zip(items, copied.items(multi=True)):
+        assert value is not original
+        assert value['nested'] is not original['nested']
+        value['nested'].append(3)
+    assert omd.items(multi=True) == items
+    assert shared['nested'] == [1]
+    assert omd['a']['nested'] == [2]
+
+
+def test_deepcopy_recursive_value():
+    omd = OMD()
+    omd.add('a', omd)
+    omd.add('a', ['last'])
+
+    copied = copy.deepcopy(omd)
+
+    assert copied is not omd
+    assert copied.getlist('a')[0] is copied
+    assert copied['a'] == ['last']
+    assert copied['a'] is not omd['a']
+
+
