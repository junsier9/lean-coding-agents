@@ -1,3 +1,5 @@
+import pytest
+
 import click
 
 
@@ -49,6 +51,46 @@ def test_basic_functionality(runner):
     ]
 
 
+@pytest.mark.parametrize("options_metavar", [None, "", "[OPTIONS]", "<options>"])
+@pytest.mark.parametrize("args, exit_code", [(["--help"], 0), ([], 2)])
+def test_formatting_options_metavar(runner, options_metavar, args, exit_code):
+    @click.command(options_metavar=options_metavar)
+    @click.argument("first")
+    @click.argument("second", required=False)
+    def cli(first, second):
+        pass
+
+    result = runner.invoke(cli, args)
+    assert result.exit_code == exit_code
+    usage = "Usage: cli"
+
+    if options_metavar:
+        usage += f" {options_metavar}"
+
+    assert result.output.splitlines()[0] == f"{usage} FIRST [SECOND]"
+
+
+@pytest.mark.parametrize("options_metavar", [None, ""])
+@pytest.mark.parametrize(
+    "chain, subcommand_metavar",
+    [
+        (False, "COMMAND [ARGS]..."),
+        (True, "COMMAND1 [ARGS]... [COMMAND2 [ARGS]...]..."),
+    ],
+)
+def test_formatting_group_without_options_metavar(
+    runner, options_metavar, chain, subcommand_metavar
+):
+    @click.group(options_metavar=options_metavar, chain=chain)
+    @click.argument("arg")
+    def cli(arg):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines()[0] == f"Usage: cli ARG {subcommand_metavar}"
+
+
