+def test_group_no_parens_command_class(runner):
+    class CustomCommand(click.Command):
+        def invoke(self, ctx):
+            click.echo("custom command")
+            return super().invoke(ctx)
+
+    class CustomGroup(click.Group):
+        command_class = CustomCommand
+
+    @click.group(cls=CustomGroup)
+    def grp():
+        click.echo("group")
+
+    @grp.command
+    @click.option("--value", type=int)
+    def custom_cmd(value):
+        click.echo(value)
+
+    assert type(custom_cmd) is CustomCommand
+    assert grp.commands["custom-cmd"] is custom_cmd
+
+    result = runner.invoke(grp, ["custom-cmd", "--value", "42"])
+    assert result.exception is None
+    assert result.output == "group\ncustom command\n42\n"
+
+
+@pytest.mark.parametrize("kwargs", [{"cls": click.Command}, {"help": "help text"}])
+def test_group_command_no_parens_rejects_kwargs(kwargs):
+    grp = click.Group()
+    grp.command_class = click.Command
+
+    with pytest.raises(AssertionError, match="Use 'command"):
+        grp.command(lambda: None, **kwargs)
+
+
