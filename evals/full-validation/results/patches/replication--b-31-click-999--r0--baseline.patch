+@pytest.mark.parametrize('name', ['cli', None])
+@pytest.mark.parametrize('extra', [{}, {'prog_name': 'custom-name'}])
+def test_runner_prog_name(name, extra):
+    def cli():
+        click.echo(click.get_current_context().info_name)
+
+    cli = click.Command(name, callback=cli)
+    prog_name = extra.get('prog_name', name or 'root')
+    runner = CliRunner()
+
+    result = runner.invoke(cli, **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output == prog_name + '\n'
+
+    result = runner.invoke(cli, ['--help'], **extra)
+    assert result.exit_code == 0
+    assert result.exception is None
+    assert result.output.startswith('Usage: %s [OPTIONS]\n' % prog_name)
+
