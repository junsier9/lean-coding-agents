+@pytest.mark.parametrize('dict_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('protocol', range(pickle.HIGHEST_PROTOCOL + 1))
+def test_omd_pickle_protocols(dict_type, protocol):
+    itemset = [('a', [1]), ('b', {'nested': [2]}), ('a', [3])]
+    original = dict_type(itemset)
+
+    restored = pickle.loads(pickle.dumps(original, protocol=protocol))
+
+    assert type(restored) is dict_type
+    assert restored is not original
+    assert restored.items(multi=True) == itemset
+    assert restored.getlist('a') == original.getlist('a')
+
