+                    )
+
+    def test_repeat_iterator_is_lazy(self):
+        seen = []
+
+        def source():
+            for item in 'abc':
+                seen.append(item)
+                yield item
+
+        result = mi.partial_product(source(), repeat=2)
+        self.assertEqual(seen, [])
+        self.assertEqual(next(result), ('a', 'a'))
+        self.assertEqual(seen, ['a'])
+        self.assertEqual(
+            list(result),
+            [('b', 'a'), ('c', 'a'), ('c', 'b'), ('c', 'c')],
+        )
+        self.assertEqual(seen, ['a', 'b', 'c'])
+
 
