+        ]:
+            with self.subTest(args=args):
+                r = mi.numeric_range(*args)
+                values = list(r)
+                self.assertEqual(len(r), len(values))
+                for i, value in enumerate(values):
+                    self.assertEqual(r[i], value)
+                    self.assertEqual(r[i - len(values)], value)
+                for i in (len(values), -len(values) - 1):
+                    with self.assertRaises(IndexError):
+                        r[i]
+
+                candidates = [args[0], args[1], args[0] - args[2], 0.3]
+                for value in values:
+                    candidates.extend(
+                        (value, nextafter(value, -inf), nextafter(value, inf))
+                    )
+                for value in candidates:
+                    with self.subTest(value=value):
+                        self.assertEqual(value in r, value in values)
+                        self.assertEqual(r.count(value), values.count(value))
+                        if value in values:
+                            self.assertEqual(r.index(value), values.index(value))
+                        else:
