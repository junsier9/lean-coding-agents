+    def test_float_large_repeated_values(self):
+        repeats = 2**40
+        for start, stop, step in [
+            (1e16, 1e16 + 4, 2**-40),
+            (1e16 + 4, 1e16, -(2**-40)),
+        ]:
+            with self.subTest(start=start, stop=stop, step=step):
+                r = mi.numeric_range(start, stop, step)
+                self.assertEqual(len(r), 3 * repeats)
+                self.assertEqual(r.count(start), repeats + 1)
+                self.assertEqual(r.index(start), 0)
+                other = start + 2 * (1 if step > 0 else -1)
+                self.assertEqual(r.index(other), repeats + 1)
+                self.assertEqual(r.count(other), 2 * repeats - 1)
+                self.assertEqual(r[-1], other)
+                self.assertNotIn(stop, r)
+
