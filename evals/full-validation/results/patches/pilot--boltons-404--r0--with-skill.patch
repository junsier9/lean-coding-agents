+@pytest.fixture(scope='module', params=['package', 'standalone'])
+def query_param_dict_type(request):
+    if request.param == 'package':
+        return urlutils.QueryParamDict
+    return runpy.run_path(urlutils.__file__)['QueryParamDict']
+
+
+@pytest.mark.parametrize(('query', 'mapping', 'expected'), [
+    ('', {}, True),
+    ('a=1', {'a': '1'}, True),
+    ('a=1', {'a': '2'}, False),
+    ('a=1&b=2', {'a': '1', 'b': '3'}, False),
+    ('a=1', {'b': '1'}, False),
+    ('a=1', {}, False),
+    ('a=1', {'a': '1', 'b': '2'}, False),
+    ('a=1&b=2&a=3', {'b': '2', 'a': '3'}, True),
+    ('a=1&a=3', {'a': '1'}, False),
+    ('a', {'a': None}, True),
+    ('a', {'a': ''}, False),
+])
+def test_query_params_eq_mapping(query_param_dict_type, query, mapping, expected):
+    qp = query_param_dict_type.from_text(query)
+
+    assert (qp == mapping) is expected
+    assert (qp != mapping) is (not expected)
+    assert (mapping == qp) is expected
+    assert (mapping != qp) is (not expected)
+
+
+@pytest.mark.parametrize(('query', 'expected'), [
+    ('a=1&b=2&a=3', True),
+    ('a=0&b=2&a=3', False),
+    ('a=1&a=3&b=2', False),
+    ('a=3&b=2', False),
+])
+def test_query_params_eq_multi(query_param_dict_type, query, expected):
+    qp = query_param_dict_type.from_text('a=1&b=2&a=3')
+    other = query_param_dict_type.from_text(query)
+
+    assert qp == qp
+    assert not (qp != qp)
+    assert (qp == other) is expected
+    assert (qp != other) is (not expected)
+
+
