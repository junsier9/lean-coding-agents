+@pytest.mark.parametrize('envvar', [None, 'EXPLICIT_NAME'])
+@pytest.mark.parametrize('subcommand', [False, True])
+@pytest.mark.parametrize('args, env_value, default_value, expected', [
+    (['--name', 'command line'], 'environment', 'mapped', 'command line'),
+    ([], 'environment', 'mapped', 'environment'),
+    ([], None, 'mapped', 'mapped'),
+    ([], None, None, 'normal'),
+])
+def test_default_map_precedence(runner, envvar, subcommand, args, env_value,
+                               default_value, expected):
+    @click.command()
+    @click.option('--name', default='normal', envvar=envvar)
+    def foo(name):
+        click.echo(name)
+
+    cli = foo
+    default_map = {'name': default_value}
+    auto_envvar_name = 'TEST_NAME'
+    if subcommand:
+        cli = click.Group()
+        cli.add_command(foo)
+        args = ['foo'] + args
+        default_map = {'foo': default_map}
+        auto_envvar_name = 'TEST_FOO_NAME'
+
+    result = runner.invoke(
+        cli, args, default_map=default_map, auto_envvar_prefix='TEST',
+        env={envvar or auto_envvar_name: env_value})
+
+    assert not result.exception
+    assert result.output == expected + '\n'
+
+
