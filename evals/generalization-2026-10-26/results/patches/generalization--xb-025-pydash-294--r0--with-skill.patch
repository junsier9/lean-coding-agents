+@parametrize("function", [_.floor, _.ceil])
+@parametrize("collection_factory", [list, tuple, iter])
+def test_directed_rounding_collections(function, collection_factory):
+    values = [0.29, 0.07, -0.29, -0.07]
+    assert function(collection_factory(values), 2) == values
+
+
+@parametrize("function,value", [(_.floor, 0.29), (_.ceil, 0.07)])
+def test_directed_rounding_call_forms(function, value):
+    assert function(x=value, precision=2) == value
+    assert getattr(_.chain(value), function.__name__)(precision=2).value() == value
+
+
+@parametrize("function", [_.floor, _.ceil])
+@parametrize("precision", [-2, 0, 2])
+@parametrize(
+    "value,error",
+    [(math.nan, ValueError), (math.inf, OverflowError), (-math.inf, OverflowError)],
+)
+def test_directed_rounding_nonfinite(function, precision, value, error):
+    with pytest.raises(error):
+        function(value, precision)
+    with pytest.raises(error):
+        function([0.29, value], precision)
+
+
+@parametrize("function", [_.floor, _.ceil])
+@parametrize("precision", [-2, 0, 2])
+@parametrize("value", [0.0, -0.0])
+def test_directed_rounding_zero(function, precision, value):
+    result = function(value, precision)
+    assert type(result) is float
+    assert result == 0.0
+    assert math.copysign(1, result) == 1
+
+
+@parametrize("function", [_.floor, _.ceil])
+@parametrize("value", [None, "junk", [0.29, None]])
+def test_directed_rounding_invalid_values(function, value):
+    assert function(value, 2) is None
+
+
+@parametrize("function", [_.floor, _.ceil])
