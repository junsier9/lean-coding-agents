diff --git a/tests/test_listutils.py b/tests/test_listutils.py
index cf8d2f4..b51e829 100644
--- a/tests/test_listutils.py
+++ b/tests/test_listutils.py
@@ -1,5 +1,7 @@
 import sys
 
+import pytest
+
 from boltons.listutils import SplayList, BarrelList
 
 
@@ -220,3 +222,80 @@ def test_barrellist_slicing_matches_list():
             assert list(value[key]) == reference[key], key
         with pytest.raises(ValueError):
             value[::0]
+
+
+@pytest.mark.parametrize('size', (0, 1, 40))
+@pytest.mark.parametrize('key', (
+    slice(3, 35),
+    slice(2, 34),
+    slice(3, 5),
+    slice(0, 1),
+    slice(3, None),
+    slice(3, 40),
+    slice(3, 100),
+    slice(None, None),
+    slice(None, 35),
+    slice(-100, 100),
+    slice(-35, -3),
+    slice(100, 200),
+    slice(35, 3),
+    slice(3, 3),
+    slice(None, None, 1),
+    slice(None, None, 2),
+    slice(3, 35, 3),
+    slice(None, None, -1),
+    slice(35, 3, -1),
+    slice(35, 3, -3),
+    slice(None, -1, -1),
+))
+def test_barrel_list_slice_deletion_matches_list(size, key):
+    reference = list(range(size))
+    value = BarrelList(reference)
+    value._size_factor = 1
+    value._balance_list(0)
+    if size == 40:
+        assert len(value.lists) > 3
+
+    del reference[key]
+    del value[key]
+
+    assert list(value) == reference
+    assert len(value) == len(reference)
+    if reference:
+        assert value[0] == reference[0]
+        assert value[-1] == reference[-1]
+    value.append('after deletion')
+    assert value.pop() == 'after deletion'
+    assert list(value) == reference
+
+
+@pytest.mark.parametrize('method', ('del_slice', '__delslice__'))
+def test_barrel_list_del_slice_call_forms(method):
+    value = _multi_sublist_bl()
+    reference = list(value)
+    del reference[5:len(value) + 100]
+
+    assert getattr(value, method)(5, len(value) + 100) is None
+    assert list(value) == reference
+    assert len(value) == len(reference)
+
+    assert getattr(BarrelList, method)(self=value, start=None, stop=None) is None
+    assert list(value) == []
+    assert len(value) == 0
+
+
+@pytest.mark.parametrize('key, error', (
+    (slice(None, None, 0), ValueError),
+    (slice('start', None), TypeError),
+    (slice(None, 1.5), TypeError),
+    (slice(None, None, 'step'), TypeError),
+))
+def test_barrel_list_invalid_slice_deletion_preserves_contents(key, error):
+    value = _multi_sublist_bl()
+    reference = list(value)
+
+    with pytest.raises(error):
+        del value[key]
+
+    assert list(value) == reference
+    assert len(value) == len(reference)
