diff --git a/tests/test_arrays.py b/tests/test_arrays.py
index fe18641..8a0b715 100644
--- a/tests/test_arrays.py
+++ b/tests/test_arrays.py
@@ -1085,6 +1085,81 @@ def test_union_with(case, expected):
     assert _.union_with(*case) == expected
 
 
+@parametrize("union", [_.union, _.union_by, _.union_with])
+@parametrize(
+    "array,expected",
+    [
+        ([], []),
+        ([3, 1, 3, 2, 1], [3, 1, 2]),
+        ((3, 1, 3, 2, 1), [3, 1, 2]),
+        ([[1], [1], [2]], [[1], [2]]),
+        ([{"x": 1}, {"x": 1}, {"x": 2}], [{"x": 1}, {"x": 2}]),
+        ([None, "x", None, "x"], [None, "x"]),
+    ],
+)
+def test_union_single_array(union, array, expected):
+    original = array[:]
+    result = union(array)
+
+    assert result == expected
+    assert result is not array
+    assert union(array=array) == expected
+    assert union(array, []) == expected
+    assert union(array, [], []) == expected
+    assert getattr(_.chain(array), union.__name__)().value() == expected
+    assert array == original
+
+
+@parametrize(
+    "union,keyword,rule,array,expected",
+    [
+        (_.union_by, "iteratee", lambda x: x % 2, [3, 1, 4, 2, 3], [3, 4]),
+        (
+            _.union_by,
+            "iteratee",
+            "x",
+            [{"x": 2, "y": 1}, {"x": 1}, {"x": 2, "y": 3}],
+            [{"x": 2, "y": 1}, {"x": 1}],
+        ),
+        (
+            _.union_by,
+            "iteratee",
+            {"x": 1},
+            [{"x": 2}, {"x": 3}, {"x": 1}],
+            [{"x": 2}, {"x": 1}],
+        ),
+        (
+            _.union_with,
+            "comparator",
+            lambda a, b: a % 2 == b % 2,
+            [3, 1, 4, 2, 3],
+            [3, 4],
+        ),
+    ],
+)
+def test_union_single_array_rule(union, keyword, rule, array, expected):
+    kwargs = {keyword: rule}
+    assert union(array, **kwargs) == expected
+    assert union(array=array, **kwargs) == expected
+    assert union(array, [], **kwargs) == expected
+    assert union(array, rule) == expected
+    assert union(array, [], rule) == expected
+    assert getattr(_.chain(array), union.__name__)(**kwargs).value() == expected
+
+
+@parametrize("union,keyword", [(_.union_by, "iteratee"), (_.union_with, "comparator")])
+def test_union_single_array_rule_error(union, keyword):
+    error = RuntimeError("comparison failed")
+
+    def fail(*args):
+        raise error
+
+    with pytest.raises(RuntimeError) as exc_info:
+        union([1, 2], **{keyword: fail})
+
+    assert exc_info.value is error
+
+
