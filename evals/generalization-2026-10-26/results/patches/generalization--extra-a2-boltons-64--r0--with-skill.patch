diff --git a/tests/test_strutils.py b/tests/test_strutils.py
index bdc9993..014d065 100644
--- a/tests/test_strutils.py
+++ b/tests/test_strutils.py
@@ -1,5 +1,9 @@
 # -*- coding: utf-8 -*-
 
+import uuid
+
+import pytest
+
 from boltons import strutils
 
 
@@ -14,3 +18,27 @@ def test_indent():
     to_indent = '\nabc\ndef\n\nxyz\n'
     ref = '\n  abc\n  def\n\n  xyz\n'
     assert strutils.indent(to_indent, '  ') == ref
+
+
+@pytest.mark.parametrize('value', [
+    object(), 42, 3.5, False, None, [], {}, (), '', 'not-a-uuid', 'g' * 32,
+])
+def test_is_uuid_invalid(value):
+    assert strutils.is_uuid(value) is False
+    assert strutils.is_uuid(value, version=0) is False
+
+
+@pytest.mark.parametrize('value, version', [
+    ('e682ccca-5a4c-4ef2-9711-73f9ad1e15ea', 4),
+    ('e682ccca5a4c4ef2971173f9ad1e15ea', 4),
+    ('{e682ccca-5a4c-4ef2-9711-73f9ad1e15ea}', 4),
+    ('urn:uuid:e682ccca-5a4c-4ef2-9711-73f9ad1e15ea', 4),
+    ('0221f0d9-d4b9-11e5-a478-10ddb1c2feb9', 1),
+    (uuid.UUID('e682ccca-5a4c-4ef2-9711-73f9ad1e15ea'), 4),
+    (uuid.UUID('0221f0d9-d4b9-11e5-a478-10ddb1c2feb9'), 1),
+])
+def test_is_uuid_valid(value, version):
+    assert strutils.is_uuid(value) is (version == 4)
+    assert strutils.is_uuid(value, version=version) is True
+    assert strutils.is_uuid(value, version=0) is True
+    assert strutils.is_uuid(value, version=5) is False
