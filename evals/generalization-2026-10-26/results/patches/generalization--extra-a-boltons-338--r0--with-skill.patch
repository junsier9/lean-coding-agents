 # -*- coding: utf-8 -*-
 
 import sys
+import pickle
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.dictutils import FastIterOrderedMultiDict
 
 
 _ITEMSETS = [[],
@@ -74,6 +76,54 @@ def test_copy():
     return
 
 
+@pytest.mark.parametrize('dict_type', [OMD, FastIterOrderedMultiDict])
+@pytest.mark.parametrize('protocol', range(pickle.HIGHEST_PROTOCOL + 1))
+@pytest.mark.parametrize('items', _ITEMSETS)
+def test_pickle_roundtrip(dict_type, protocol, items):
+    omd = dict_type(items)
+    restored = pickle.loads(pickle.dumps(omd, protocol=protocol))
+
+    assert type(restored) is dict_type
+    assert restored.items(multi=True) == items
+    assert restored.todict(multi=True) == omd.todict(multi=True)
+    for key in omd:
+        assert restored[key] == omd[key]
+        assert restored.getlist(key) == omd.getlist(key)
+    assert list(reversed(restored)) == list(reversed(omd))
+
+    restored.add('a', 'new')
+    assert restored.items(multi=True) == items + [('a', 'new')]
+    assert restored.poplast() == 'new'
+    assert restored.items(multi=True) == items
+    assert omd.items(multi=True) == items
+
+    restored.clear()
+    restored.clear()
+    assert not restored
+    assert restored.items(multi=True) == []
+    restored['a'] = 1
+    restored.add('a', 2)
+    assert restored.items(multi=True) == [('a', 1), ('a', 2)]
+    assert restored.popall('a') == [1, 2]
+    with pytest.raises(KeyError):
+        restored.poplast()
+
+
+@pytest.mark.parametrize('protocol', range(pickle.HIGHEST_PROTOCOL + 1))
+def test_pickle_references(protocol):
+    shared = []
+    omd = OMD([('a', shared), ('b', shared)])
+    omd.add('self', omd)
+    omd.extra = shared
+
+    restored = pickle.loads(pickle.dumps(omd, protocol=protocol))
+
+    assert restored.keys(multi=True) == ['a', 'b', 'self']
+    assert restored['a'] is restored['b'] is restored.extra
+    assert restored['a'] is not shared
+    assert restored['self'] is restored
+
+
 def test_clear():
     for itemset in _ITEMSETS:
         omd = OMD(itemset)
