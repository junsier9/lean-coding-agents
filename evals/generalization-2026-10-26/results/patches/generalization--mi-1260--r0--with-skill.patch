+class RunningWindowTests(TestCase):
+    functions = (
+        mi.running_min,
+        mi.running_max,
+        mi.running_mean,
+        mi.running_median,
+        mi.running_statistics,
+    )
+
+    class WindowSize:
+        def __init__(self, value):
+            self.value = value
+            self.calls = 0
+
+        def __index__(self):
+            self.calls += 1
+            return self.value
+
+    def test_index_protocol(self):
+        data = [4, 3, 7, 0, 8, 1]
+        for function in self.functions:
+            for size in (1, 2, 20):
+                with self.subTest(function=function.__name__, size=size):
+                    maxlen = self.WindowSize(size)
+                    self.assertEqual(
+                        list(function(iter(data), maxlen=maxlen)),
+                        list(function(iter(data), maxlen=size)),
+                    )
+                    self.assertEqual(maxlen.calls, 1)
+
+    def test_non_integer_maxlen(self):
+        class IntOnly:
+            def __int__(self):
+                return 2
+
+        for function in self.functions:
+            for data in ([], [4, 3, 7]):
+                for maxlen in (
+                    2.5,
+                    2.0,
+                    -1.5,
+                    '2',
+                    Decimal(2),
+                    Fraction(2),
+                    IntOnly(),
+                    self.WindowSize(2.5),
+                ):
+                    with self.subTest(
+                        function=function.__name__, data=data, maxlen=maxlen
+                    ):
+                        iterator = iter(data)
+                        with self.assertRaises(TypeError):
+                            function(iterator, maxlen=maxlen)
+                        self.assertEqual(list(iterator), data)
+
+    def test_non_positive_maxlen(self):
+        for function in self.functions:
+            for data in ([], [4, 3, 7]):
+                for maxlen in (
+                    0,
+                    -1,
+                    False,
+                    self.WindowSize(0),
+                    self.WindowSize(-1),
+                ):
+                    with self.subTest(
+                        function=function.__name__, data=data, maxlen=maxlen
+                    ):
+                        with self.assertRaisesRegex(
+                            ValueError, 'Window size should be positive'
+                        ):
+                            function(iter(data), maxlen=maxlen)
+
+    def test_none_and_boolean_maxlen(self):
+        data = [4, 3, 7, 0, 8, 1]
+        for function in self.functions:
+            with self.subTest(function=function.__name__):
+                self.assertEqual(
+                    list(function(iter(data), maxlen=None)),
+                    list(function(iter(data))),
+                )
+                self.assertEqual(
+                    list(function(iter(data), maxlen=True)),
+                    list(function(iter(data), maxlen=1)),
+                )
+
+    def test_empty_input(self):
+        for function in self.functions:
+            for maxlen in (None, 1, self.WindowSize(2)):
+                with self.subTest(function=function.__name__, maxlen=maxlen):
+                    self.assertEqual(list(function([], maxlen=maxlen)), [])
+
+
