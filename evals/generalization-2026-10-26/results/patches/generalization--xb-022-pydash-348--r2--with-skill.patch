+def test_invoke_map_callable_arguments():
+    calls = []
+    collection = [{"value": 1}, {"value": 2}]
+
+    def invoke(value, *args, **kwargs):
+        calls.append((value, args, kwargs))
+        value["value"] += args[0]
+        return value["value"]
+
+    assert _.invoke_map(collection, invoke, 3, None, item="__class__", argcount=0) == [4, 5]
+    assert collection == [{"value": 4}, {"value": 5}]
+    assert calls == [
+        (collection[0], (3, None), {"item": "__class__", "argcount": 0}),
+        (collection[1], (3, None), {"item": "__class__", "argcount": 0}),
+    ]
+    assert calls[0][0] is collection[0]
+    assert calls[1][0] is collection[1]
+
+
+def test_invoke_map_callable_keyword_only_argument():
+    def scale(value, factor, *, offset):
+        return value * factor + offset
+
+    assert _.invoke_map([1, 2], scale, 3, offset=4) == [7, 10]
+    assert _.chain([1, 2]).invoke_map(scale, 3, offset=4).value() == [7, 10]
+
+
+def test_invoke_map_callable_error_propagates():
+    calls = []
+    error = ValueError("invalid value")
+
+    def invoke(value):
+        calls.append(value)
+        raise error
+
+    with pytest.raises(ValueError, match="invalid value") as exc_info:
+        _.invoke_map([1, 2], invoke)
+
+    assert exc_info.value is error
+    assert calls == [1]
+
+
+def test_invoke_map_callable_extra_arguments_raise():
+    with pytest.raises(TypeError):
+        _.invoke_map([[1]], len, "extra")
+
+
+def test_invoke_map_restricted_path_raises():
+    with pytest.raises(KeyError, match="access to restricted key"):
+        _.invoke_map([{}], "__class__")
+
+
+def test_invoke_map_noncallable_method_raises():
+    with pytest.raises(TypeError):
+        _.invoke_map([{"method": None}], "method")
+
+
