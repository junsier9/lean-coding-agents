+def test_multiple_flags(runner, attrs, flag_value, args, count):
+    @click.command()
+    @click.option("-f", "--flag", multiple=True, **attrs)
+    def cli(flag):
+        return flag
+
+    result = runner.invoke(cli, args, standalone_mode=False)
