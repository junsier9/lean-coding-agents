+    ],
+)
+def test_multiple_required_flag(runner, attrs, expected):
+    @click.command()
+    @click.option("--flag", multiple=True, required=True, **attrs)
+    def cli(flag):
+        return flag
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 2
+    assert "Error: Missing option '--flag'." in result.output
+
+    result = runner.invoke(cli, ["--flag", "--flag"], standalone_mode=False)
+    assert result.exit_code == 0
