+@pytest.mark.parametrize('has_wrapped', [False, True])
+def test_wraps_inner_required_kwarg_only(has_wrapped):
+    def g(a, b):
+        return a, b
+
+    def f(a, *, b):
+        return a, b
+
+    if has_wrapped:
+        f = functools.wraps(g)(f)
+
+    wrapped = wraps(g)(f)
+    assert wrapped(3, 4) == (3, 4)
+    assert wrapped(a=3, b=4) == (3, 4)
+    assert wraps(f)(g)(3, b=4) == (3, 4)
+    assert inspect.signature(wrapped, follow_wrapped=False) == inspect.signature(g)
+    assert wrapped.__wrapped__ is g
+
+    with pytest.raises(TypeError):
+        wrapped(3)
+    with pytest.raises(TypeError):
+        wrapped(3, 4, extra=5)
+
+
+@pytest.mark.parametrize('defaulted', [False, True])
+def test_wraps_inner_kwarg_only_with_varargs(defaulted):
+    def required(a, b, *rest, **kwargs):
+        return a, b, rest, kwargs
+
+    def optional(a, b=10, *rest, **kwargs):
+        return a, b, rest, kwargs
+
+    def target(a, *rest, b, **kwargs):
+        return a, b, rest, kwargs
+
+    source = optional if defaulted else required
+    wrapped = wraps(source)(target)
+    assert wrapped(3, 4, 5, 6, flag=True) == (3, 4, (5, 6), {'flag': True})
+    assert wrapped(3, b=4) == (3, 4, (), {})
+    if defaulted:
+        assert wrapped(3) == (3, 10, (), {})
+    else:
+        with pytest.raises(TypeError):
+            wrapped(3)
+
+
+def test_wraps_inner_kwarg_only_method():
+    class Example:
+        def original(this, value, self):
+            return this, value, self
+
+        @wraps(original)
+        def method(this, value, *, self):
+            return this, value, self
+
+    obj = Example()
+    assert obj.method(3, 4) == (obj, 3, 4)
+    assert Example.method(this=obj, value=3, self=4) == (obj, 3, 4)
+
+
+def test_update_wrapper_kwarg_only_expected_and_injected():
+    def source(a, injected, b):
+        return a, injected, b
+
+    def target(a, *, b, extra):
+        return a, b, extra
+
+    wrapped = update_wrapper(target, source, injected='injected',
+                             expected=[('extra', 'default')])
+    assert wrapped(3, 4) == (3, 4, 'default')
+    assert wrapped(3, 4, 'explicit') == (3, 4, 'explicit')
+
+
+@pytest.mark.parametrize('error', [TypeError, ValueError])
+@pytest.mark.parametrize('varargs', [False, True])
+def test_wraps_uninspectable_target(error, varargs):
+    class Target:
+        @property
+        def __signature__(self):
+            raise error('signature unavailable')
+
+        def __call__(self, *args, **kwargs):
+            return args, kwargs
+
+    def plain(a, b=10):
+        pass
+
+    def variadic(a, b=10, *rest):
+        pass
+
+    wrapped = wraps(variadic if varargs else plain)(Target())
+    if varargs:
+        assert wrapped(3) == ((3, 10), {})
+        assert wrapped(3, 4, 5) == ((3, 4, 5), {})
+    else:
+        assert wrapped(3) == ((3,), {'b': 10})
+        assert wrapped(3, b=4) == ((3,), {'b': 4})
+
+
+def test_wraps_uninspectable_builtin():
+    def source(*args, **kwargs):
+        pass
+
+    wrapped = wraps(source)(max)
+    assert wrapped(3, 4, 5) == 5
+    assert wrapped([], default=10) == 10
+
+
+def test_wraps_unexpected_signature_error():
+    error = RuntimeError('signature failed')
+
+    class Target:
+        @property
+        def __signature__(self):
+            raise error
+
+        def __call__(self):
+            pass
+
+    def source():
+        pass
+
+    with pytest.raises(RuntimeError) as exc_info:
+        wraps(source)(Target())
+    assert exc_info.value is error
+
+
+def test_wraps_inner_kwarg_only_target_error():
+    error = RuntimeError('target failed')
+
+    def source(a, b):
+        pass
+
+    def target(a, *, b):
+        raise error
+
+    with pytest.raises(RuntimeError) as exc_info:
+        wraps(source)(target)(3, 4)
+    assert exc_info.value is error
+
+
+def test_wraps_async_inner_kwarg_only():
+    import asyncio
+
+    async def source(a, b=10, *rest):
+        return a, b, rest
+
+    async def target(a, *rest, b):
+        return a, b, rest
+
+    wrapped = wraps(source)(target)
+    assert inspect.iscoroutinefunction(wrapped)
+    assert asyncio.run(wrapped(3)) == (3, 10, ())
+    assert asyncio.run(wrapped(3, 4, 5)) == (3, 4, (5,))
+
