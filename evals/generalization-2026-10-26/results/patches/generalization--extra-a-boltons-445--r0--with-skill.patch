         for i, arg in enumerate(args):
-            if (i >= n_positional and not self.varargs
-                    and arg not in self.posonlyargs):
+            if (arg in kwonlyargs or (i >= n_positional and not self.varargs
+                                     and arg not in self.posonlyargs)):
                 kw_parts.append(arg + '=' + arg)
             else:
                 parts.append(arg)
