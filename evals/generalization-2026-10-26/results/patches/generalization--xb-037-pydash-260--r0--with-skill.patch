+@parametrize("maximum", [1, Decimal("2.5")])
+def test_scale_decimal_iterator(maximum):
+    values = [Decimal("1"), Decimal("2"), Decimal("5")]
+    expected = [Decimal("0.2") * maximum, Decimal("0.4") * maximum, Decimal("1") * maximum]
+
+    result = _.scale(array=iter(values), maximum=maximum)
+
+    assert result == expected
+    assert all(isinstance(value, Decimal) for value in result)
