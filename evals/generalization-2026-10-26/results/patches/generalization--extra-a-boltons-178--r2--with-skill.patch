+@pytest.mark.parametrize('inclusive', [False, True])
+def test_daterange_unbounded(inclusive):
+    days = daterange(date(2020, 2, 28), None, inclusive=inclusive)
+    assert list(islice(days, 3)) == [date(2020, 2, 28), date(2020, 2, 29),
+                                   date(2020, 3, 1)]
+    assert next(days) == date(2020, 3, 2)
+
+
+@pytest.mark.parametrize('step, expected', [
+    (2, [date(2020, 1, 1), date(2020, 1, 3), date(2020, 1, 5)]),
+    (-1, [date(2020, 1, 1), date(2019, 12, 31), date(2019, 12, 30)]),
+    (timedelta(days=2),
+     [date(2020, 1, 1), date(2020, 1, 3), date(2020, 1, 5)]),
+    ((0, 1, 0), [date(2020, 1, 1), date(2020, 2, 1), date(2020, 3, 1)]),
+    ((1, 0, 0), [date(2020, 1, 1), date(2021, 1, 1), date(2022, 1, 1)]),
+])
+def test_daterange_unbounded_step(step, expected):
+    assert list(islice(daterange(date(2020, 1, 1), None, step=step), 3)) == expected
+
+
+@pytest.mark.parametrize('step', [2, timedelta(days=2), (0, 0, 2)])
+@pytest.mark.parametrize('reverse', [False, True])
+@pytest.mark.parametrize('inclusive', [False, True])
+def test_daterange_finite(step, reverse, inclusive):
+    start, stop = date(2020, 1, 1), date(2020, 1, 5)
+    expected = [date(2020, 1, 1), date(2020, 1, 3), date(2020, 1, 5)]
+    if reverse:
+        start, stop = stop, start
+        step = (0, 0, -2) if isinstance(step, tuple) else -step
+        expected.reverse()
+    if not inclusive:
+        expected.pop()
+    assert list(daterange(start, stop, step=step, inclusive=inclusive)) == expected
+
+
+def test_daterange_unbounded_overflow():
+    days = daterange(date.max, None)
+    assert next(days) == date.max
+    with pytest.raises(OverflowError):
+        next(days)
