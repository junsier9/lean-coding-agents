+def test_invoke_map_callable_arguments():
+    calls = []
+
+    def record(value, *args, **kwargs):
+        calls.append((value, args, kwargs))
+        return value * 2
+
+    assert _.chain(iter([1, 2])).invoke_map(record, 3, suffix=None).value() == [2, 4]
+    assert calls == [(1, (3,), {"suffix": None}), (2, (3,), {"suffix": None})]
+
+
+def test_invoke_map_bound_callable():
+    values = []
+    assert _.invoke_map([1, 2], values.append) == [None, None]
+    assert values == [1, 2]
+
+
+@parametrize("error", [TypeError, ValueError])
+def test_invoke_map_callable_error(error):
+    def fail(value):
+        raise error("callback failed")
+
+    with pytest.raises(error, match="callback failed"):
+        _.invoke_map([1], fail)
+
