+
+
+def test_barrel_list_del_slice_across_sublists():
+    value = _multi_sublist_bl(100000)
+    reference = list(value)
+    start = len(value.lists[0]) // 2
+    stop = len(value) - len(value.lists[-1]) // 2
+
+    del reference[start:stop]
+    del value[start:stop]
+
+    assert list(value) == reference
+    assert len(value) == len(reference)
+    assert value[0] == reference[0]
+    assert value[-1] == reference[-1]
+
+
+@pytest.mark.parametrize('size', [0, 1, 8, 20])
+@pytest.mark.parametrize('step', [None, 1, 2, -1, -3])
+def test_barrel_list_del_slice_matches_list(size, step):
+    from itertools import product
+
+    bounds = (None, -30, -2, 0, 2, 4, 12, 30)
+    for start, stop in product(bounds, repeat=2):
+        reference = list(range(size))
+        value = BarrelList(reference)
+        value._size_factor = 1
+        value._balance_list(0)
+        key = slice(start, stop, step)
+
+        del reference[key]
+        del value[key]
+
+        assert list(value) == reference, key
+        assert len(value) == len(reference), key
+        if reference:
+            assert value[0] == reference[0], key
+            assert value[-1] == reference[-1], key
+        value.append('tail')
+        assert value.pop() == 'tail'
+        assert list(value) == reference, key
+
+
+@pytest.mark.parametrize('method_name', ['del_slice', '__delslice__'])
+def test_barrel_list_del_slice_call_forms(method_name):
+    value = _multi_sublist_bl()
+    reference = list(value)
+
+    getattr(value, method_name)(start=2, stop=-2)
+    del reference[2:-2]
+    assert list(value) == reference
+    assert len(value) == len(reference)
+
+    getattr(BarrelList, method_name)(self=value, start=1, stop=None)
+    del reference[1:]
+    assert list(value) == reference
+    assert len(value) == len(reference)
+
+
+@pytest.mark.parametrize('key, error', [
+    (slice(None, None, 0), ValueError),
+    (slice(1.0, None), TypeError),
+    (slice(None, 1.0), TypeError),
+    (slice(None, None, 1.0), TypeError),
+])
+def test_barrel_list_del_slice_invalid(key, error):
+    value = _multi_sublist_bl()
+    reference = list(value)
+
+    with pytest.raises(error):
+        del reference[key]
+    with pytest.raises(error):
+        del value[key]
+    assert list(value) == reference
+    assert len(value) == len(reference)
