+@pytest.mark.parametrize("width", [24, 80])
+def test_formatting_usage_without_args(runner, width):
+    @click.command(add_help_option=False, options_metavar="")
+    def cli():
+        """Command help."""
+
+    ctx = click.Context(cli, info_name="cli", terminal_width=width)
+    assert ctx.get_usage() == "Usage: cli"
+    assert ctx.get_help() == "Usage: cli\n\n  Command help."
+
+    result = runner.invoke(cli, ["extra"], terminal_width=width)
+    assert result.exit_code == 2
+    assert result.output == (
+        "Usage: cli\n\nError: Got unexpected extra argument (extra)\n"
+    )
+
+
+@pytest.mark.parametrize("width", [24, 80])
+@pytest.mark.parametrize("prog", ["cli", "a-very-very-very-long-command-name"])
+@pytest.mark.parametrize(
+    ("prefix", "expected_prefix"),
+    [
+        (None, "Usage: "),
+        ("", ""),
+        ("Run:  ", "Run:  "),
+        ("\x1b[1mUsage:\x1b[0m ", "\x1b[1mUsage:\x1b[0m "),
+    ],
+)
+def test_write_usage_without_args(width, prog, prefix, expected_prefix):
+    formatter = click.HelpFormatter(width=width)
+    formatter.write_usage(prog, prefix=prefix)
+    assert formatter.getvalue() == f"{expected_prefix}{prog}\n"
+
+
