diff --git a/more_itertools/recipes.py b/more_itertools/recipes.py
index b984d86..fe9521e 100644
--- a/more_itertools/recipes.py
+++ b/more_itertools/recipes.py
@@ -875,6 +875,10 @@ def iter_index(iterable, value, start=0, stop=None):
     >>> list(iter_index('AABCADEAF', 'A', 1, 7))  # stop index is not inclusive
     [1, 4]
 
+    Negative *start* and *stop* values count from the end of *iterable*.
+    Iterables without an ``index`` method are fully consumed before yielding
+    results when either boundary is negative.
+
     The behavior for non-scalar *values* matches the built-in Python types.
 
     >>> list(iter_index('ABCDABCD', 'AB'))
@@ -891,7 +895,19 @@ def iter_index(iterable, value, start=0, stop=None):
     seq_index = getattr(iterable, 'index', None)
     if seq_index is None:
         # Slow path for general iterables
-        iterator = islice(iterable, start, stop)
+        try:
+            iterator = islice(iterable, start, stop)
+        except ValueError as error:
+            try:
+                start = _index(start)
+                stop = None if stop is None else _index(stop)
+            except TypeError:
+                raise error from None
+            if start >= 0 and (stop is None or stop >= 0):
+                raise
+            iterable = tuple(iterable)
+            start, stop, _ = slice(start, stop).indices(len(iterable))
+            iterator = islice(iterable, start, stop)
         for i, element in enumerate(iterator, start):
             if element is value or element == value:
                 yield i
