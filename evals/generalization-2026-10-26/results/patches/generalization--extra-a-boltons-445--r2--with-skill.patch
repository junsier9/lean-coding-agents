+def test_wraps_inner_kwarg_only_required():
+    def g(a, b):
+        return a * b
+
+    @functools.wraps(g)
+    def f(a, *, b):
+        return a * b
+
+    wrapped = wraps(g)(f)
+    assert wrapped(3, 4) == 12
+    assert wrapped(a=3, b=4) == 12
+    assert wrapped.__wrapped__ is g
+    assert inspect.signature(wrapped, follow_wrapped=False) == inspect.signature(g)
+    with pytest.raises(TypeError):
+        wrapped(3)
+
+    reverse = wraps(f)(g)
+    assert reverse(3, b=4) == 12
+    with pytest.raises(TypeError):
+        reverse(3, 4)
+
+
+@pytest.mark.parametrize('defaulted', [False, True])
+def test_wraps_inner_kwarg_only_varargs(defaulted):
+    if defaulted:
+        def g(a, b=10, *rest, **kwargs):
+            return a, b, rest, kwargs
+    else:
+        def g(a, b, *rest, **kwargs):
+            return a, b, rest, kwargs
+
+    def f(a, *rest, b=1, **kwargs):
+        return a, b, rest, kwargs
+
+    wrapped = wraps(g)(f)
+    assert wrapped(3, 4, 5, 6, extra=7) == (3, 4, (5, 6), {'extra': 7})
+    assert wrapped(3, b=4) == (3, 4, (), {})
+    if defaulted:
+        assert wrapped(3) == (3, 10, (), {})
+    else:
+        with pytest.raises(TypeError):
+            wrapped(3)
+
+
+def test_wraps_inner_kwarg_only_method():
+    def method_signature(receiver, a, b):
+        return receiver, a, b
+
+    class Example:
+        @wraps(method_signature)
+        def method(receiver, a, *, b):
+            return receiver, a, b
+
+    instance = Example()
+    value = funcutils.NO_DEFAULT
+    assert instance.method(3, value) == (instance, 3, value)
+    assert Example.method(receiver=instance, a=3, b=value) == (instance, 3, value)
+
+
+@pytest.mark.parametrize('error_type', [TypeError, ValueError])
+def test_wraps_uninspectable_wrapper(error_type):
+    class Wrapper:
+        @property
+        def __signature__(self):
+            raise error_type('signature unavailable')
+
+        def __call__(self, *args, **kwargs):
+            return args, kwargs
+
+    def g(a, b=10, *, c=20):
+        pass
+
+    wrapped = wraps(g)(Wrapper())
+    assert wrapped(3) == ((3,), {'b': 10, 'c': 20})
+    assert wrapped(3, b=4, c=5) == ((3,), {'b': 4, 'c': 5})
+
+
