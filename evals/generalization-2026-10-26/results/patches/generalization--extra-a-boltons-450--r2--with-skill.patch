+@mark.parametrize('value', ['0', '1', '10', '01', '0000100', '10101', '1111'])
+def test_bits_integer_indexing(value):
+    bits = Bits(value)
+    for index, digit in enumerate(value):
+        expected = digit == '1'
+        assert bits[index] is expected
+        assert bits[index - len(value)] is expected
+
+
+@mark.parametrize('value', ['', '0', '1', '10', '0000100'])
+def test_bits_index_out_of_range(value):
+    bits = Bits(value)
+    for index in (len(value), len(value) + 1, 10 ** 100,
+                  -len(value) - 1, -len(value) - 2, -(10 ** 100)):
+        with raises(IndexError) as exc_info:
+            bits[index]
+        assert exc_info.value.args == (index,)
+
+
+@mark.parametrize('key', [
+    slice(None), slice(-4, -1), slice(None, None, -1),
+    slice(None, None, 2), slice(2, 2), slice(20, 30),
+])
+def test_bits_slicing(key):
+    value = '0010110'
+    assert Bits(value)[key] == Bits(value[key])
+
+
