+@pytest.mark.parametrize("width", [10, 80])
+def test_formatting_without_usage_args(runner, width):
+    cli = click.Command("cli", options_metavar="")
+    result = runner.invoke(cli, ["--help"], terminal_width=width)
+    assert result.exit_code == 0
+    assert result.output.startswith("Usage: cli\n\nOptions:\n")
+
+
+@pytest.mark.parametrize("width", [10, 80])
+def test_write_usage_without_args(width):
+    formatter = click.HelpFormatter(width=width)
+    formatter.write_usage("cli")
+    assert formatter.getvalue() == "Usage: cli\n"
+
+
+@pytest.mark.parametrize("width", [10, 80])
+@pytest.mark.parametrize(
+    ("prefix", "indent", "expected"),
+    [
+        (None, 0, "Usage: cli\n"),
+        ("", 0, "cli\n"),
+        ("Run:  ", 0, "Run:  cli\n"),
+        ("\x1b[31mUsage: \x1b[0m", 0, "\x1b[31mUsage: \x1b[0mcli\n"),
+        (None, 12, "     Usage: cli\n"),
+        ("", 2, "  cli\n"),
+    ],
+)
+def test_write_usage_without_args_prefix(width, prefix, indent, expected):
+    formatter = click.HelpFormatter(width=width)
+    formatter.current_indent = indent
+    click.HelpFormatter.write_usage(self=formatter, prog="cli", args="", prefix=prefix)
+    assert formatter.getvalue() == expected
+
+
