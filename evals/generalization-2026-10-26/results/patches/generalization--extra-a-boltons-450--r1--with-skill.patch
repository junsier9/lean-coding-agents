+@mark.parametrize('binary', ['0', '1', '10', '01', '0000100', '10101'])
+def test_bits_integer_indexing(binary):
+    bits = Bits(binary)
+    for index, bit in enumerate(binary):
+        expected = bit == '1'
+        assert bits[index] is expected
+        assert bits[index - len(bits)] is expected
+        assert Bits.__getitem__(self=bits, k=index - len(bits)) is expected
+
+
+@mark.parametrize('binary', ['', '0', '1', '10', '01', '0000100', '10101'])
+def test_bits_index_out_of_range(binary):
+    bits = Bits(binary)
+    for index in (-len(bits) - 1, -len(bits) - 100, len(bits), len(bits) + 100):
+        with raises(IndexError) as exc_info:
+            bits[index]
+        assert exc_info.value.args == (index,)
+
+
+def test_bits_slicing():
+    bits = Bits('0010110')
+    assert bits[-4:-1] == Bits('011')
+    assert bits[::-1] == Bits('0110100')
+    assert bits[::2] == Bits('0110')
+    assert bits[-20:20] == bits
+
+
