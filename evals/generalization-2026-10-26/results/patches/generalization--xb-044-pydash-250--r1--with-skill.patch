+def test_to_list_dict(case, expected):
+    result = _.to_list(case)
+
+    assert isinstance(result, list)
+    assert result == expected
+
+
+def test_to_list_dict_snapshot():
+    value = []
+    obj = {"a": value, "b": 2}
+
