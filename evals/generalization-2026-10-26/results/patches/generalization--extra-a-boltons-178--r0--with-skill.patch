+@pytest.mark.parametrize('inclusive', [False, True])
+def test_daterange_unbounded(inclusive):
+    days = daterange(start=date(2016, 2, 28), stop=None,
+                     inclusive=inclusive)
+
+    assert list(islice(days, 4)) == [date(2016, 2, 28), date(2016, 2, 29),
+                                    date(2016, 3, 1), date(2016, 3, 2)]
+    assert next(days) == date(2016, 3, 3)
+
+
+@pytest.mark.parametrize('inclusive', [False, True])
+@pytest.mark.parametrize('step, day_step', [
+    (2, 2), (-2, -2),
+    (timedelta(days=2), 2), (timedelta(days=-2), -2),
+    ((0, 0, 2), 2), ((0, 0, -2), -2),
+])
+def test_daterange_steps(step, day_step, inclusive):
+    start = date(2016, 2, 27)
+    expected = [start, start + timedelta(days=day_step),
+                start + timedelta(days=2 * day_step)]
+
+    bounded = list(daterange(start, expected[-1], step=step,
+                             inclusive=inclusive))
+    assert bounded == (expected if inclusive else expected[:-1])
+
+    days = daterange(start, None, step=step, inclusive=inclusive)
+    assert list(islice(days, 3)) == expected
+    assert next(days) == start + timedelta(days=3 * day_step)
