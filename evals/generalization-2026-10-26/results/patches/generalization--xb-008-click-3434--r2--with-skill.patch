+@pytest.mark.parametrize("width", [10, 80])
+@pytest.mark.parametrize("prog", ["cli", "a-very-long-command-name" * 3])
+@pytest.mark.parametrize(
+    ("prefix", "expected_prefix"),
+    [
+        (None, "Usage: "),
+        ("", ""),
+        ("Run: ", "Run: "),
+        ("\x1b[31mUsage: \x1b[0m", "\x1b[31mUsage: \x1b[0m"),
+    ],
+)
+def test_write_usage_without_args(width, prog, prefix, expected_prefix):
+    formatter = click.HelpFormatter(width=width)
+    formatter.write_usage(prog, prefix=prefix)
+    assert formatter.getvalue() == f"{expected_prefix}{prog}\n"
+
+
+def test_write_usage_without_args_indented():
+    formatter = click.HelpFormatter(width=10)
+    formatter.current_indent = 12
+    click.HelpFormatter.write_usage(self=formatter, prog="cli", args="", prefix="Run: ")
+    assert formatter.getvalue() == "       Run: cli\n"
+
+
+@pytest.mark.parametrize("width", [10, 80])
+def test_formatting_usage_without_args(runner, width):
+    cli = click.Command("cli", options_metavar="", add_help_option=False)
+    with click.Context(cli, info_name="cli", terminal_width=width) as ctx:
+        assert ctx.get_usage() == "Usage: cli"
+        assert ctx.get_help() == "Usage: cli"
+
+    result = runner.invoke(cli, ["unexpected"], terminal_width=width)
+    assert result.exit_code == 2
+    assert result.output == (
+        "Usage: cli\n\nError: Got unexpected extra argument (unexpected)\n"
+    )
+
+
