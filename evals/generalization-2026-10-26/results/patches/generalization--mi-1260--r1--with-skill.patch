+class RunningWindowSizeTests(TestCase):
+    functions = (
+        mi.running_min,
+        mi.running_max,
+        mi.running_mean,
+        mi.running_median,
+        mi.running_statistics,
+    )
+
+    def test_non_integer(self):
+        class IntOnly:
+            def __int__(self):
+                return 3
+
+        for func in self.functions:
+            for maxlen in (2.5, 3.0, '3', Decimal(3), Fraction(3), IntOnly()):
+                for data in ([], [4, 3, 7]):
+                    with self.subTest(func=func, maxlen=maxlen, data=data):
+                        iterator = iter(data)
+                        with self.assertRaises(TypeError):
+                            func(iterator, maxlen=maxlen)
+                        self.assertEqual(list(iterator), data)
+
+    def test_non_positive(self):
+        for func in self.functions:
+            for maxlen in (0, -1, False):
+                for data in ([], [4, 3, 7]):
+                    with self.subTest(func=func, maxlen=maxlen, data=data):
+                        with self.assertRaisesRegex(
+                            ValueError, 'Window size should be positive'
+                        ):
+                            func(iter(data), maxlen=maxlen)
+
+    def test_index_protocol(self):
+        class Index:
+            def __init__(self, value):
+                self.value = value
+
+            def __index__(self):
+                return self.value
+
+        for func in self.functions:
+            for size in (1, 2, 3, 20):
+                for data in ([], [4, 3, 7, 0, 8, 1, 6, 2, 9, 5]):
+                    with self.subTest(func=func, size=size, data=data):
+                        self.assertEqual(
+                            list(func(iter(data), maxlen=Index(size))),
+                            list(func(iter(data), maxlen=size)),
+                        )
+            for size in (0, -1):
+                with self.subTest(func=func, size=size):
+                    with self.assertRaises(ValueError):
+                        func([], maxlen=Index(size))
+            with self.subTest(func=func, size=2.5):
+                with self.assertRaises(TypeError):
+                    func([], maxlen=Index(2.5))
+
+    def test_none(self):
+        for func in self.functions:
+            for data in ([], [4, 3, 7, 0, 8, 1]):
+                with self.subTest(func=func, data=data):
+                    self.assertEqual(
+                        list(func(iter(data), maxlen=None)),
+                        list(func(iter(data))),
+                    )
+
+
