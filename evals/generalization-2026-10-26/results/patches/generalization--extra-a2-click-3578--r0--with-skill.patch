@@ -483,6 +483,62 @@ def test_choice_argument(runner):
     assert "{foo|bar|baz}" in result.output
 
 
+@pytest.mark.parametrize(
+    ("type", "metavar"),
+    [
+        (click.Choice(["foo", "bar"]), "[foo|bar]"),
+        (click.DateTime(formats=["%Y-%m-%d", "%Y"]), "[%Y-%m-%d|%Y]"),
+        (int, "[VALUE]"),
+    ],
+)
+@pytest.mark.parametrize(
+    ("kwargs", "suffix"),
+    [
+        ({"required": False}, ""),
+        ({"nargs": -1}, "..."),
+        ({"required": False, "nargs": 2}, "..."),
+    ],
+)
+def test_optional_argument_type_metavar(runner, type, metavar, kwargs, suffix):
+    @click.command()
+    @click.argument("value", type=type, **kwargs)
+    def cli(value):
+        pass
+
+    usage = f"Usage: cli [OPTIONS] {metavar}{suffix}"
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines()[0] == usage
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0
+    assert result.output == ""
+
+    args = ["invalid", "invalid"] if kwargs.get("nargs") == 2 else ["invalid"]
+    result = runner.invoke(cli, args)
+    assert result.exit_code == 2
+    assert result.output.splitlines()[0] == usage
+    assert "Error:" in result.output
+
+
+@pytest.mark.parametrize(
+    ("type", "metavar"),
+    [
+        (click.Choice(["foo", "bar"]), "[foo|bar!]"),
+        (click.DateTime(formats=["%Y-%m-%d"]), "[%Y-%m-%d!]"),
+    ],
+)
+def test_deprecated_optional_argument_type_metavar(runner, type, metavar):
+    @click.command()
+    @click.argument("value", type=type, required=False, deprecated=True)
+    def cli(value):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {metavar}"
+
+
