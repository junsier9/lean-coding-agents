+    def __reduce_ex__(self, protocol):
+        state = self.__dict__.copy()
+        # Rebuild the linked list from all items, rather than pickling its links.
+        del state['_map'], state['root']
+        return self.__class__, (), (self.items(multi=True), state)
+
+    def __setstate__(self, state):
+        items, attributes = state
+        self.update_extend(items)
+        self.__dict__.update(attributes)
+
