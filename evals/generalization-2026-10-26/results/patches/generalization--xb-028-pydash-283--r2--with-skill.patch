+def test_union_with_single_array_keyword_comparator():
+    assert _.union_with([1, 2, 3], comparator=lambda a, b: (a % 2) == (b % 2)) == [1, 2]
+
+
+@parametrize(
+    "function,kwargs",
+    [
+        (_.union, {}),
+        (_.union_by, {}),
+        (_.union_by, {"iteratee": None}),
+        (_.union_by, {"iteratee": "x"}),
+        (_.union_with, {}),
+        (_.union_with, {"comparator": None}),
+        (_.union_with, {"comparator": lambda a, b: a["x"] == b["x"]}),
+    ],
+)
+def test_union_empty_arrays_preserve_result_and_references(function, kwargs):
+    first = {"x": 2}
+    second = {"x": 1}
+    array = [first, second, {"x": 2}]
+
+    result = function(array=array, **kwargs)
+
+    assert result == [first, second]
+    assert result is not array
+    assert result[0] is first
+    assert result[1] is second
+    assert function(array, [], **kwargs) == result
+    assert function([], array, **kwargs) == result
+    assert function(array, [], [], **kwargs) == result
+    assert array == [{"x": 2}, {"x": 1}, {"x": 2}]
+
+
+@parametrize("function,keyword", [(_.union_by, "iteratee"), (_.union_with, "comparator")])
+def test_union_single_array_propagates_callback_errors(function, keyword):
+    def fail(*args):
+        raise ValueError("comparison failed")
+
+    with pytest.raises(ValueError, match="comparison failed"):
+        function([1, 2], **{keyword: fail})
+
