+def test_wraps_inner_required_kwonly():
+    def outer(a, b):
+        return a, b
+
+    @functools.wraps(outer)
+    def inner(a, *, b):
+        return a, b
+
+    wrapped = wraps(outer)(inner)
+    assert wrapped(3, 4) == (3, 4)
+    assert wrapped(a=3, b=funcutils.NO_DEFAULT) == (3, funcutils.NO_DEFAULT)
+    assert wrapped(3, b='*args') == (3, '*args')
+    assert inspect.signature(wrapped, follow_wrapped=False) == inspect.signature(outer)
+    assert wrapped.__wrapped__ is outer
+    with pytest.raises(TypeError):
+        wrapped(3)
+    with pytest.raises(TypeError):
+        wrapped(3, 4, 5)
+
+    reverse = wraps(inner)(outer)
+    assert reverse(3, b=4) == (3, 4)
+    with pytest.raises(TypeError):
+        reverse(3, 4)
+
+
+@pytest.mark.parametrize('defaulted', [False, True])
+def test_wraps_inner_kwonly_with_varargs(defaulted):
+    if defaulted:
+        def outer(a, b=10, *rest, **extras):
+            return a, b, rest, extras
+    else:
+        def outer(a, b, *rest, **extras):
+            return a, b, rest, extras
+
+    def inner(a, *rest, b=1, **extras):
+        return a, b, rest, extras
+
+    wrapped = wraps(outer)(inner)
+    assert wrapped(3, 4, 5, 6, label='test') == (3, 4, (5, 6), {'label': 'test'})
+    assert wrapped(a=3, b=4) == (3, 4, (), {})
+    if defaulted:
+        assert wrapped(3) == (3, 10, (), {})
+    else:
+        with pytest.raises(TypeError):
+            wrapped(3)
+
+    reverse = wraps(inner)(outer)
+    assert reverse(3, 5, 6, b=4, label='test') == (3, 4, (5, 6), {'label': 'test'})
+    assert reverse(3) == (3, 1, (), {})
+
+
+def test_wraps_inner_kwonly_method():
+    def outer(receiver, a, b):
+        return receiver, a, b
+
+    def inner(receiver, a, *, b):
+        return receiver, a, b
+
+    class Example:
+        method = wraps(outer)(inner)
+
+    instance = Example()
+    assert instance.method(3, 4) == (instance, 3, 4)
+    assert Example.method(receiver=instance, a=3, b=4) == (instance, 3, 4)
+
+    def bound_outer(a, b):
+        pass
+
+    assert wraps(bound_outer)(instance.method)(3, 4) == (instance, 3, 4)
+
+
+@pytest.mark.parametrize('error', [TypeError, ValueError])
+def test_wraps_uninspectable_target(error):
+    class Uninspectable:
+        @property
+        def __signature__(self):
+            raise error('signature unavailable')
+
+        def __call__(self, *args, **kwargs):
+            return args, kwargs
+
+    def outer(a, b=10):
+        pass
+
+    wrapped = wraps(outer)(Uninspectable())
+    assert wrapped(3) == ((3,), {'b': 10})
+    assert wrapped(3, 4) == ((3,), {'b': 4})
+
+
+def test_wraps_inner_kwonly_failure():
+    def outer(a, b):
+        pass
+
+    calls = []
+    error = TypeError('target failed')
+
+    def inner(a, *, b):
+        calls.append((a, b))
+        raise error
+
+    with pytest.raises(TypeError) as exc_info:
+        wraps(outer)(inner)(3, 4)
+    assert exc_info.value is error
+    assert calls == [(3, 4)]
+
+
