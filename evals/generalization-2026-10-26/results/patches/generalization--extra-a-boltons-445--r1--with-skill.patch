+        # params (keywords are rejected outright), and regular args before
+        # *varargs. The target's keyword-only args override these rules.
+        target_params = target_sig.parameters.values() if target_sig is not None else ()
+        target_kwonlyargs = {p.name for p in target_params
+                             if p.kind == inspect.Parameter.KEYWORD_ONLY}
+        target_posargs = [p.name for p in target_params
+                          if p.kind in (inspect.Parameter.POSITIONAL_ONLY,
+                                        inspect.Parameter.POSITIONAL_OR_KEYWORD)]
         defaults = self.defaults or ()
