                 kw_parts.append(arg + '=' + arg)
             else:
                 parts.append(arg)
         if self.varargs:
+            # Reverse wrapping must fill the target's fixed positional
+            # slots before expanding *varargs to avoid duplicate binding.
+            for i, arg in enumerate(target_posargs):
+                if arg in kwonlyargs:
