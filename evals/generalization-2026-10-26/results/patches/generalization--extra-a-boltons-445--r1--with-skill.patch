-        parts += [arg + '=' + arg for arg in self.kwonlyargs or ()]
+        parts += [arg + '=' + arg for arg in kwonlyargs
+                  if not (self.varargs and arg in target_posargs)]
         if self.varkw:
             parts.append('**' + self.varkw)
         return ', '.join(parts)
