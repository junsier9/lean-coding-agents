+@pytest.mark.parametrize('protocol', range(pickle.HIGHEST_PROTOCOL + 1))
+@pytest.mark.parametrize('items', _ITEMSETS + [
+    [('a', []), ('b', {'x': 1}), ('a', [2, 3]), ('b', None)]])
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict])
+def test_pickle(omd_type, items, protocol):
+    omd = omd_type(items)
+    restored = pickle.loads(pickle.dumps(omd, protocol))
+
+    assert type(restored) is omd_type
+    assert restored.items(multi=True) == items
+    assert restored.todict(multi=True) == omd.todict(multi=True)
+    assert restored.items() == omd.items()
+    assert list(reversed(restored)) == list(reversed(omd))
+
+    restored.add('a', 'added')
+    assert restored.getlist('a') == omd.getlist('a') + ['added']
+    assert restored.poplast('a') == 'added'
+    assert restored.items(multi=True) == items
+
+    restored.clear()
+    restored.clear()
+    assert not restored
+    assert restored.items(multi=True) == []
+    restored.add('new', 1)
+    restored['new'] = 2
+    assert restored.items(multi=True) == [('new', 2)]
+    assert restored.getlist('new') == [2]
+    assert omd.items(multi=True) == items
+
+
+@pytest.mark.parametrize('protocol', range(pickle.HIGHEST_PROTOCOL + 1))
+def test_pickle_references(protocol):
+    shared = []
+    omd = OMD([('a', shared), ('b', shared)])
+    omd.add('self', omd)
+    omd.note = shared
+
+    restored = pickle.loads(pickle.dumps(omd, protocol))
+
+    assert restored['a'] is restored['b'] is restored.note
+    assert restored['self'] is restored
+    assert restored['a'] is not shared
+
+
 def test_clear():
