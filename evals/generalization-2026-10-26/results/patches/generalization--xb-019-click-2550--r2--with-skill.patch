+@pytest.mark.parametrize(
+    ("kwargs", "value"),
+    [
+        ({"is_flag": True}, True),
+        ({"flag_value": True}, True),
+        ({"flag_value": False}, False),
+        ({"flag_value": "value"}, "value"),
+        ({"flag_value": 42}, 42),
+    ],
+)
+@pytest.mark.parametrize(
+    ("args", "count"),
+    [(["--flag"], 1), (["--flag", "--flag"], 2), (["-fff"], 3)],
+)
+def test_multiple_flags(runner, kwargs, value, args, count):
+    @click.command()
+    @click.option("--flag", "-f", multiple=True, **kwargs)
+    def cli(flag):
+        return flag
+
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value == (value,) * count
+
+
+def test_multiple_boolean_flags(runner):
+    @click.command()
+    @click.option("--flag/--no-flag", multiple=True)
+    def cli(flag):
+        return flag
+
+    result = runner.invoke(
+        cli, ["--flag", "--no-flag", "--flag"], standalone_mode=False
+    )
+    assert result.exit_code == 0
+    assert result.return_value == (True, False, True)
+
+
+def test_multiple_flag_values(runner):
+    @click.command()
+    @click.option("--upper", "mode", flag_value="upper", multiple=True)
+    @click.option("--lower", "mode", flag_value="lower", multiple=True)
+    def cli(mode):
+        return mode
+
+    result = runner.invoke(
+        cli, ["--upper", "--lower", "--upper"], standalone_mode=False
+    )
+    assert result.exit_code == 0
+    assert result.return_value == ("upper", "lower", "upper")
+
+
+@pytest.mark.parametrize("kwargs", [{"is_flag": True}, {"flag_value": "value"}])
+def test_multiple_flags_required(runner, kwargs):
+    @click.command()
+    @click.option("--flag", multiple=True, required=True, **kwargs)
+    def cli(flag):
+        return flag
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 2
+    assert "Missing option '--flag'" in result.output
+
+    result = runner.invoke(cli, ["--flag", "--flag"], standalone_mode=False)
+    assert result.exit_code == 0
+    assert result.return_value == (cli.params[0].flag_value,) * 2
