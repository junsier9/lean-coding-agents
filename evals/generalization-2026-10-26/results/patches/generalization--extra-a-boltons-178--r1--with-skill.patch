+
+def test_daterange_unbounded():
+    days = daterange(date(2020, 2, 28), None)
+    assert list(islice(days, 3)) == [date(2020, 2, 28), date(2020, 2, 29),
+                                     date(2020, 3, 1)]
+    assert next(days) == date(2020, 3, 2)
+
+
+@pytest.mark.parametrize('inclusive', [False, True])
+@pytest.mark.parametrize('step, expected', [
+    (2, [date(2020, 2, 28), date(2020, 3, 1), date(2020, 3, 3)]),
+    (-2, [date(2020, 2, 28), date(2020, 2, 26), date(2020, 2, 24)]),
+    (timedelta(days=2),
+     [date(2020, 2, 28), date(2020, 3, 1), date(2020, 3, 3)]),
+    (timedelta(days=-2),
+     [date(2020, 2, 28), date(2020, 2, 26), date(2020, 2, 24)]),
+    ((0, 1, 0), [date(2020, 2, 28), date(2020, 3, 28), date(2020, 4, 28)]),
+    ((0, 0, -2), [date(2020, 2, 28), date(2020, 2, 26), date(2020, 2, 24)]),
+])
+def test_daterange_unbounded_steps(step, expected, inclusive):
+    days = daterange(date(2020, 2, 28), None, step=step, inclusive=inclusive)
+    assert list(islice(days, 3)) == expected
+
+
+@pytest.mark.parametrize('start, stop, step, inclusive, expected', [
+    (1, 5, 2, False, [1, 3]),
+    (1, 5, 2, True, [1, 3, 5]),
+    (5, 1, -2, False, [5, 3]),
+    (5, 1, -2, True, [5, 3, 1]),
+    (1, 1, 1, False, []),
+    (1, 1, -1, True, [1]),
+])
+def test_daterange_finite(start, stop, step, inclusive, expected):
+    days = daterange(date(2020, 1, start), date(2020, 1, stop),
+                     step=step, inclusive=inclusive)
+    assert list(days) == [date(2020, 1, day) for day in expected]
