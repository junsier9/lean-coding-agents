@@ -877,6 +877,34 @@ def test_to_integer(case, expected):
     assert _.to_integer(case) == expected
 
 
+@parametrize("split_strings", [True, False])
+@parametrize(
+    "case,expected",
+    [
+        ({}, []),
+        ({"b": 2, "a": 1, "c": 2}, [2, 1, 2]),
+        ({"nested": [], "none": None}, [[], None]),
+    ],
+)
+def test_to_list_dict(case, expected, split_strings):
+    result = _.to_list(obj=case, split_strings=split_strings)
+
+    assert isinstance(result, list)
+    assert result == expected
+
+
+def test_to_list_dict_is_shallow_snapshot():
+    value = []
+    case = {"a": value}
+    result = _.to_list(case)
+
+    case["a"] = "replacement"
+    case["b"] = "new"
+
+    assert result == [[]]
+    assert result[0] is value
+
+
