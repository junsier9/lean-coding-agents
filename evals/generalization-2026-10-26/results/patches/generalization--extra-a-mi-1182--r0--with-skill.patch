@@ -1026,6 +1026,67 @@ class IterIndexTests(TestCase):
         expected = [0, 1, 4]
         self.assertEqual(actual, expected)
 
+    def test_negative_bounds(self):
+        for start, stop, expected in (
+            (-4, None, [7]),
+            (-20, None, [0, 1, 4, 7]),
+            (0, -2, [0, 1, 4]),
+            (0, -20, []),
+            (-8, -2, [1, 4]),
+            (-20, -1, [0, 1, 4, 7]),
+            (-1, -4, []),
+            (-4, 20, [7]),
+            (-4, 7, []),
+            (8, -1, []),
+            (-9, -8, [0]),
+        ):
+            for wrapper in (list, tuple, iter):
+                with self.subTest(start=start, stop=stop, wrapper=wrapper):
+                    actual = list(
+                        mi.iter_index(wrapper('AABCADEAF'), 'A', start, stop)
+                    )
+                    self.assertEqual(actual, expected)
+
+    def test_no_matches(self):
+        for iterable in ('', 'BCDEF'):
+            for wrapper in (list, iter):
+                for start, stop in ((0, None), (1, 4), (-4, None), (0, -1)):
+                    with self.subTest(
+                        iterable=iterable,
+                        wrapper=wrapper,
+                        start=start,
+                        stop=stop,
+                    ):
+                        actual = list(
+                            mi.iter_index(wrapper(iterable), 'A', start, stop)
+                        )
+                        self.assertEqual(actual, [])
+
+    def test_positive_bounds_are_lazy(self):
+        iterable = iter('AABCADEAF')
+        indices = mi.iter_index(iterable, 'A', 1, 7)
+        self.assertEqual(next(indices), 1)
+        self.assertEqual(list(indices), [4])
+        self.assertEqual(next(iterable), 'A')
+
+    def test_negative_bounds_propagate_iteration_error(self):
+        def broken():
+            yield 'A'
+            raise RuntimeError('iteration failed')
+
+        with self.assertRaisesRegex(RuntimeError, 'iteration failed'):
+            list(mi.iter_index(broken(), 'A', -1))
+
+    def test_negative_bounds_preserve_identity_and_equality_errors(self):
+        class BadEquality:
+            def __eq__(self, other):
+                raise ValueError('comparison failed')
+
+        value = BadEquality()
+        self.assertEqual(list(mi.iter_index(iter([value]), value, -1)), [0])
+        with self.assertRaisesRegex(ValueError, 'comparison failed'):
+            list(mi.iter_index(iter([value]), 'A', -1))
+
 
