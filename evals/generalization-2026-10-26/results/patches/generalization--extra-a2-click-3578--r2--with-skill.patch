--- a/tests/test_basic.py
+++ b/tests/test_basic.py
@@ -483,6 +483,47 @@ def test_choice_argument(runner):
     assert "{foo|bar|baz}" in result.output
 
 
+@pytest.mark.parametrize("nargs", [1, 2, -1])
+@pytest.mark.parametrize(
+    ("kwargs", "metavar"),
+    [
+        ({"type": click.Choice(["foo", "bar"])}, "[foo|bar]"),
+        (
+            {"type": click.DateTime()},
+            "[%Y-%m-%d|%Y-%m-%dT%H:%M:%S|%Y-%m-%d %H:%M:%S]",
+        ),
+        ({"type": click.DateTime(["%Y-%m-%d"])}, "[%Y-%m-%d]"),
+        ({"type": str}, "[VALUE]"),
+        ({"type": int}, "[VALUE]"),
+        (
+            {"type": click.Choice(["foo", "bar"]), "deprecated": True},
+            "[foo|bar!]",
+        ),
+        (
+            {"type": click.DateTime(["%Y-%m-%d"]), "deprecated": True},
+            "[%Y-%m-%d!]",
+        ),
+    ],
+)
+def test_optional_argument_metavar(runner, kwargs, metavar, nargs):
+    @click.command()
+    @click.argument("value", required=False, nargs=nargs, **kwargs)
+    def cli(value):
+        return value
+
+    if nargs != 1:
+        metavar += "..."
+
+    for args, exit_code in [(["--help"], 0), (["--unknown"], 2)]:
+        result = runner.invoke(cli, args)
+        assert result.exit_code == exit_code
+        assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {metavar}"
+
+    result = runner.invoke(cli, [], standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == (() if nargs == -1 else None)
+
+
